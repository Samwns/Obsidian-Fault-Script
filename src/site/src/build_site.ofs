attach {F:../../../ofs/ofscc/fileio.ofs}
attach {F:sitekit.ofs}
attach {F:book.ofs}
attach {F:ref.ofs}

vein write_pages(prefix: obsidian) {
    write_file(prefix + "index.html", bk_page("pt"))
    rf_redirect(prefix + "language.html", "ref/Referencia_da_linguagem.html")
    rf_redirect(prefix + "getting-started.html", "index.html")
    rf_redirect(prefix + "compiler.html", "ref/Arquitetura_do_compilador.html")
    rf_redirect(prefix + "odl.html", "ref/ODL.html")
    rf_redirect(prefix + "oes.html", "ref/OES.html")
    rf_redirect(prefix + "playground.html", "ref/Interface_web.html")
    rf_redirect(prefix + "web.html", "ref/Interface_web.html")
    rf_redirect(prefix + "webserver.html", "ref/Interface_web.html")
    rf_redirect(prefix + "webui.html", "ref/Interface_web.html")
    rf_redirect(prefix + "stdlib.html", "ref/Biblioteca_padrao.html")
    rf_redirect(prefix + "packages.html", "ref/Biblioteca_padrao.html")
    rf_redirect(prefix + "downloads.html", "https://github.com/Samwns/Obsidian-Fault-Script/releases/latest")
    rf_redirect(prefix + "vscode.html", "ref/Ferramentas.html")
    rf_redirect(prefix + "commands.html", "ref/Ferramentas.html")
    rf_redirect(prefix + "design.html", "ref/index.html")
    rf_redirect(prefix + "oll.html", "ref/Interface_visual.html")
    rf_redirect(prefix + "oal.html", "ref/OAL.html")
    write_file(prefix + "benchmark.html", page_benchmark("pt"))
    rf_redirect(prefix + "github.html", "ref/Registro_no_GitHub.html")
    write_file(prefix + "site.css", site_css())
    write_file(prefix + "site.js", site_runtime_js())
    write_file(prefix + "benchmark.json", read_file("bench/results.json"))
}

vein write_english_pages(prefix: obsidian) {
    write_file(prefix + "en/index.html", bk_page("en"))
    rf_redirect(prefix + "en/language.html", "../ref/en/Language_reference.html")
    rf_redirect(prefix + "en/odl.html", "../ref/en/ODL.html")
    rf_redirect(prefix + "en/oes.html", "../ref/en/OES.html")
    rf_redirect(prefix + "en/web.html", "../ref/en/Web_UI.html")
    rf_redirect(prefix + "en/stdlib.html", "../ref/en/Standard_library.html")
    rf_redirect(prefix + "en/oll.html", "../ref/en/Visual_UI.html")
    rf_redirect(prefix + "en/oal.html", "../ref/en/OAL.html")
    rf_redirect(prefix + "en/downloads.html", "https://github.com/Samwns/Obsidian-Fault-Script/releases/latest")
    rf_redirect(prefix + "en/getting-started.html", "index.html")
    rf_redirect(prefix + "en/commands.html", "../ref/en/Tools.html")
    write_file(prefix + "en/benchmark.html", page_benchmark("en"))
}

vein write_spanish_pages(prefix: obsidian) {
    write_file(prefix + "es/index.html", bk_page("es"))
    rf_redirect(prefix + "es/language.html", "../ref/es/Referencia_del_lenguaje.html")
    rf_redirect(prefix + "es/web.html", "../ref/es/Interfaz_web.html")
    rf_redirect(prefix + "es/stdlib.html", "../ref/es/Biblioteca_estandar.html")
    rf_redirect(prefix + "es/downloads.html", "https://github.com/Samwns/Obsidian-Fault-Script/releases/latest")
    rf_redirect(prefix + "es/getting-started.html", "index.html")
    rf_redirect(prefix + "es/commands.html", "../ref/es/Herramientas.html")
    write_file(prefix + "es/benchmark.html", page_benchmark("es"))
}

core main() {
    system("mkdir -p src/site/public/assets src/site/public/en src/site/public/es docs/assets docs/en docs/es")
    write_pages("src/site/public/")
    write_english_pages("src/site/public/")
    write_spanish_pages("src/site/public/")
    write_file("src/site/public/.nojekyll", "")
    write_file("src/site/public/assets/site.css", site_css())
    write_file("src/site/public/assets/site.js", site_runtime_js())
    write_file("src/site/public/assets/book.css", read_file("src/site/book/book.css"))
    write_file("src/site/public/assets/book.js", read_file("src/site/book/book.js"))
    write_file("src/site/public/assets/benchmark.json", read_file("bench/results.json"))

    write_pages("docs/")
    write_english_pages("docs/")
    write_spanish_pages("docs/")
    write_file("docs/.nojekyll", "")
    write_file("docs/assets/site.css", site_css())
    write_file("docs/assets/site.js", site_runtime_js())
    write_file("docs/assets/book.css", read_file("src/site/book/book.css"))
    write_file("docs/assets/book.js", read_file("src/site/book/book.js"))
    write_file("docs/assets/benchmark.json", read_file("bench/results.json"))
    // Referencia (guia + API gerada do codigo + cobertura): docs/ref e copia no public
    rf_write_all("docs/")
    system("rm -rf src/site/public/ref src/site/public/wiki && cp -r docs/ref src/site/public/ref && cp -r docs/wiki src/site/public/wiki")

    echo("OFS site generated in src/site/public and docs")
}
