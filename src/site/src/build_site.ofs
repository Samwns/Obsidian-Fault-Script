attach {F:../../../ofs/ofscc/fileio.ofs}
attach {F:sitekit.ofs}

vein write_pages(prefix: obsidian) {
    write_file(prefix + "index.html", site_page_root())
    write_file(prefix + "language.html", page_language())
    write_file(prefix + "getting-started.html", page_getting_started())
    write_file(prefix + "compiler.html", page_compiler())
    write_file(prefix + "odl.html", page_odl())
    write_file(prefix + "oes.html", page_oes())
    write_file(prefix + "playground.html", page_playground())
    write_file(prefix + "web.html", page_web())
    write_file(prefix + "webserver.html", page_webserver())
    write_file(prefix + "webui.html", page_webui())
    write_file(prefix + "stdlib.html", page_stdlib())
    write_file(prefix + "packages.html", page_packages())
    write_file(prefix + "downloads.html", page_downloads())
    write_file(prefix + "vscode.html", page_vscode())
    write_file(prefix + "commands.html", page_commands())
    write_file(prefix + "design.html", page_design())
    write_file(prefix + "benchmark.html", page_benchmark())
    write_file(prefix + "github.html", page_github())
    write_file(prefix + "site.css", site_css())
    write_file(prefix + "site.js", site_runtime_js())
    write_file(prefix + "benchmark.json", read_file("src/site/benchmarks/results.json"))
}

vein write_english_pages(prefix: obsidian) {
    write_file(prefix + "en/index.html", page_en_index())
    write_file(prefix + "en/language.html", page_language_en())
    write_file(prefix + "en/odl.html", page_odl_en())
    write_file(prefix + "en/oes.html", page_oes_en())
    write_file(prefix + "en/web.html", page_web_en())
    write_file(prefix + "en/stdlib.html", page_stdlib_en())
    write_file(prefix + "en/downloads.html", page_downloads_en())
}

core main() {
    system("mkdir -p src/site/public/assets src/site/public/en docs/assets docs/en")
    write_pages("src/site/public/")
    write_english_pages("src/site/public/")
    write_file("src/site/public/.nojekyll", "")
    write_file("src/site/public/assets/site.css", site_css())
    write_file("src/site/public/assets/site.js", site_runtime_js())
    write_file("src/site/public/assets/benchmark.json", read_file("src/site/benchmarks/results.json"))

    write_pages("docs/")
    write_english_pages("docs/")
    write_file("docs/.nojekyll", "")
    write_file("docs/assets/site.css", site_css())
    write_file("docs/assets/site.js", site_runtime_js())
    write_file("docs/assets/benchmark.json", read_file("src/site/benchmarks/results.json"))

    echo("OFS site generated in src/site/public and docs")
}
