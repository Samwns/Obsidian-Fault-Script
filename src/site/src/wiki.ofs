// Gerador da versao "wiki antiga" (estilo MediaWiki 2005-2010). Reaproveita o
// conversor md -> HTML do book.ofs (modo bk_wiki). Saida: docs/wiki/{,en/,es/}.

forge wk_lang: obsidian = "pt"
forge wk_title: obsidian = ""
forge wk_toc: obsidian = ""
forge wk_secs: obsidian = ""
forge wk_n2: stone = 0
forge wk_n3: stone = 0
forge wk_edit: obsidian = ""
forge wk_ntoc: stone = 0
forge wk_idx: obsidian = ""
forge wk_json: obsidian = ""

forge wk_repo: obsidian = "https://github.com/Samwns/Obsidian-Fault-Script"

// KEY;categoria;nome pt;nome en;nome es
forge wk_docs: obsidian = ""

vein wk_init() -> void {
    wk_docs = "\n" +
    "GETTING_STARTED;0;Comecando;Getting_started;Primeros_pasos\n" +
    "BEGINNER_JOURNEY;0;Jornada_do_iniciante;Beginner_journey;Ruta_del_principiante\n" +
    "LANGUAGE_REFERENCE;1;Referencia_da_linguagem;Language_reference;Referencia_del_lenguaje\n" +
    "COMPILED_LANGUAGE;1;Linguagem_compilada;Compiled_language;Lenguaje_compilado\n" +
    "STANDARD_LIBRARY;2;Biblioteca_padrao;Standard_library;Biblioteca_estandar\n" +
    "COMPILER_ARCHITECTURE;3;Arquitetura_do_compilador;Compiler_architecture;Arquitectura_del_compilador\n" +
    "BOOTSTRAP;3;Bootstrap;Bootstrap;Bootstrap\n" +
    "PERFORMANCE;3;Desempenho;Performance;Rendimiento\n" +
    "IDLE_ARCHITECTURE;3;Arquitetura_do_IDLE;IDLE_architecture;Arquitectura_del_IDLE\n" +
    "ODL_REFERENCE;4;ODL;ODL;ODL\n" +
    "OES_REFERENCE;4;OES;OES;OES\n" +
    "VISUAL_UI;4;Interface_visual;Visual_UI;Interfaz_visual\n" +
    "OAL_REFERENCE;4;OAL;OAL;OAL\n" +
    "WEB_UI;4;Interface_web;Web_UI;Interfaz_web\n" +
    "ANDROID;5;Android;Android;Android\n" +
    "SITE_LANGUAGE;6;Linguagem_do_site;Site_language;Lenguaje_del_sitio\n" +
    "GITHUB_REGISTRATION;6;Registro_no_GitHub;GitHub_registration;Registro_en_GitHub\n" +
    "CHANGELOG;6;Mudancas_recentes;Recent_changes;Cambios_recientes\n"
}

vein wk_t(lang: obsidian, pt: obsidian, en: obsidian, es: obsidian) -> obsidian {
    if (ofs_str_eq(lang, "en")) { return en }
    if (ofs_str_eq(lang, "es")) { return es }
    return pt
}

vein wk_field(row: obsidian, n: stone) -> obsidian {
    forge st = 0
    forge k = 0
    forge res = ""
    forge len = ofs_str_len(row)
    cycle (forge i = 0; i <= len; i++) {
        if (i == len || ofs_str_eq(ofs_str_substr(row, i, 1), ";")) {
            if (k == n) { res = ofs_str_substr(row, st, i - st) }
            k = k + 1
            st = i + 1
        }
    }
    return res
}

vein wk_row(dk: obsidian) -> obsidian {
    forge s = bk_find(wk_docs, "\n" + dk + ";", 0)
    if (s < 0) { return "" }
    forge e = bk_find(wk_docs, "\n", s + 1)
    return ofs_str_substr(wk_docs, s + 1, e - s - 1)
}

vein wk_name(dk: obsidian, lang: obsidian) -> obsidian {
    forge r = wk_row(dk)
    if (ofs_str_len(r) == 0) { return "" }
    if (ofs_str_eq(lang, "en")) { return wk_field(r, 3) }
    if (ofs_str_eq(lang, "es")) { return wk_field(r, 4) }
    return wk_field(r, 2)
}

vein wk_cat_name(ct: stone, lang: obsidian) -> obsidian {
    if (ct == 0) { return wk_t(lang, "Começando", "Getting started", "Primeros pasos") }
    if (ct == 1) { return wk_t(lang, "Linguagem", "Language", "Lenguaje") }
    if (ct == 2) { return wk_t(lang, "Biblioteca padrão", "Standard library", "Biblioteca estándar") }
    if (ct == 3) { return wk_t(lang, "Compilador", "Compiler", "Compilador") }
    if (ct == 4) { return wk_t(lang, "Linguagens de domínio", "Domain languages", "Lenguajes de dominio") }
    if (ct == 5) { return "Android" }
    return wk_t(lang, "Projeto", "Project", "Proyecto")
}

vein wk_idx_name(lang: obsidian) -> obsidian {
    return wk_t(lang, "Indice_de_paginas", "All_pages", "Todas_las_paginas")
}

vein wk_base(u: obsidian) -> obsidian {
    forge q = u
    forge sl = bk_find(q, "/", 0)
    cycle (forge k = 0; k < 8; k++) {
        if (sl >= 0) {
            q = ofs_str_substr(q, sl + 1, ofs_str_len(q) - sl - 1)
            sl = bk_find(q, "/", 0)
        }
    }
    return q
}

vein wk_link(u: obsidian) -> obsidian {
    if (bk_find(u, "http", 0) == 0 || bk_find(u, "#", 0) == 0 || bk_find(u, "mailto:", 0) == 0) { return u }
    forge p = bk_find(u, ".md", 0)
    if (p > 0) {
        forge dk = wk_base(ofs_str_substr(u, 0, p))
        forge nm = wk_name(dk, wk_lang)
        if (ofs_str_len(nm) > 0) { return nm + ".html" }
        return "#red"
    }
    // outros caminhos relativos: arquivo no GitHub
    forge rest = u
    forge ups = 0
    cycle (forge k = 0; k < 6; k++) {
        if (ofs_str_eq(ofs_str_substr(rest, 0, 3), "../")) {
            rest = ofs_str_substr(rest, 3, ofs_str_len(rest) - 3)
            ups = ups + 1
        }
    }
    forge depth = 1
    if (ofs_str_eq(wk_lang, "pt") == false) { depth = 2 }
    forge pre = ""
    if (depth - ups == 1) { pre = "docs/" }
    if (depth - ups == 2) { pre = "docs/" + wk_lang + "/" }
    return wk_repo + "/blob/main/" + pre + rest
}

vein wk_heading(lvl: stone, title: obsidian) -> void {
    bk_close_blocks()
    if (lvl == 1) {
        if (ofs_str_len(wk_title) == 0) { wk_title = title }
        return
    }
    if (lvl == 2) {
        wk_n2 = wk_n2 + 1
        wk_n3 = 0
        forge num = ofs_stone_to_obsidian(wk_n2)
        wk_toc = wk_toc + "<li class=\"tl2\"><a href=\"#s" + num + "\"><span class=\"tn\">" + num + "</span> " + bk_inline(title) + "</a></li>\n"
        wk_ntoc = wk_ntoc + 1
        wk_secs = wk_secs + title + "\n"
        bk_cur = bk_cur + "<h2><span class=\"mw-h\" id=\"s" + num + "\">" + bk_inline(title) + "</span><span class=\"editsec\">[<a href=\"" + wk_edit + "\">" + wk_t(wk_lang, "editar", "edit", "editar") + "</a>]</span></h2>\n"
        return
    }
    if (lvl == 3) {
        wk_n3 = wk_n3 + 1
        forge num = ofs_stone_to_obsidian(wk_n2) + "." + ofs_stone_to_obsidian(wk_n3)
        wk_toc = wk_toc + "<li class=\"tl3\"><a href=\"#s" + num + "\"><span class=\"tn\">" + num + "</span> " + bk_inline(title) + "</a></li>\n"
        wk_ntoc = wk_ntoc + 1
        wk_secs = wk_secs + title + "\n"
        bk_cur = bk_cur + "<h3><span class=\"mw-h\" id=\"s" + num + "\">" + bk_inline(title) + "</span></h3>\n"
        return
    }
    forge h = ofs_stone_to_obsidian(lvl)
    bk_cur = bk_cur + "<h" + h + ">" + bk_inline(title) + "</h" + h + ">\n"
}

vein wk_sh(cmd: obsidian, fb: obsidian) -> obsidian {
    system(cmd + " > /tmp/ofs_wiki_sh.txt 2>/dev/null")
    forge r = bk_trim(read_file("/tmp/ofs_wiki_sh.txt"))
    forge rn = ofs_str_len(r)
    if (rn > 0 && ofs_str_char_at(r, rn - 1) == 10) { r = ofs_str_substr(r, 0, rn - 1) }
    if (ofs_str_len(r) == 0) { return fb }
    return r
}

vein wk_jesc(s: obsidian) -> obsidian {
    forge out = ""
    forge n = ofs_str_len(s)
    cycle (forge i = 0; i < n; i++) {
        forge c = ofs_str_substr(s, i, 1)
        if (ofs_str_eq(c, "\"")) { out = out + "\\\"" } else if (ofs_str_eq(c, "\\")) { out = out + "\\\\" } else { out = out + c }
    }
    return out
}

// prefixos: raiz da wiki e raiz do site (docs/)
vein wk_wroot(lang: obsidian) -> obsidian {
    if (ofs_str_eq(lang, "pt")) { return "" }
    return "../"
}

vein wk_droot(lang: obsidian) -> obsidian {
    if (ofs_str_eq(lang, "pt")) { return "../" }
    return "../../"
}

vein wk_langlink(lang: obsidian, target: obsidian, dk: obsidian) -> obsidian {
    forge pre = ""
    if (ofs_str_eq(lang, target) == false) {
        if (ofs_str_eq(lang, "pt")) { pre = target + "/" } else if (ofs_str_eq(target, "pt")) { pre = "../" } else { pre = "../" + target + "/" }
    }
    forge f = "index"
    if (ofs_str_len(dk) > 0) {
        if (ofs_str_eq(dk, "*")) { f = wk_idx_name(target) } else { f = wk_name(dk, target) }
    }
    return pre + f + ".html"
}

vein wk_pages_js(lang: obsidian) -> obsidian {
    forge out = "\"index.html\",\"" + wk_idx_name(lang) + ".html\""
    forge pos = 0
    cycle (forge g = 0; g < 40; g++) {
        forge s = bk_find(wk_docs, "\n", pos)
        if (s >= 0) {
            forge e = bk_find(wk_docs, "\n", s + 1)
            if (e > s + 1) {
                forge r = ofs_str_substr(wk_docs, s + 1, e - s - 1)
                if (ofs_str_len(bk_resolve(lang, wk_field(r, 0))) > 0) { out = out + ",\"" + wk_name(wk_field(r, 0), lang) + ".html\"" }
            }
            if (e > s) { pos = e }
            if (e < 0) { pos = ofs_str_len(wk_docs) }
        }
    }
    return out
}

vein wk_side(lang: obsidian, dk: obsidian) -> obsidian {
    forge wr = wk_wroot(lang)
    forge dr = wk_droot(lang)
    forge ob = wk_t(lang, "ODL", "ODL", "ODL")
    forge l = "<div id=\"wk-side\"><a class=\"wk-logo\" href=\"" + wr + "index.html\" title=\"" + wk_t(lang, "Página principal", "Main page", "Página principal") + "\"><img src=\"" + dr + "assets/ofs-256.png\" alt=\"OFS\" width=\"120\" height=\"120\"></a>"
    l = l + "<div class=\"portlet\"><h3>" + wk_t(lang, "Navegação", "Navigation", "Navegación") + "</h3><ul>"
    l = l + "<li><a href=\"" + wr + "index.html\">" + wk_t(lang, "Página principal", "Main page", "Página principal") + "</a></li>"
    l = l + "<li><a href=\"" + wk_idx_name(lang) + ".html\">" + wk_t(lang, "Índice de páginas", "All pages", "Índice de páginas") + "</a></li>"
    l = l + "<li><a href=\"" + wk_name("CHANGELOG", lang) + ".html\">" + wk_t(lang, "Mudanças recentes", "Recent changes", "Cambios recientes") + "</a></li>"
    l = l + "<li><a id=\"wk-random\" href=\"" + wk_name("GETTING_STARTED", lang) + ".html\">" + wk_t(lang, "Página aleatória", "Random page", "Página aleatoria") + "</a></li>"
    l = l + "<li><a href=\"" + dr + wk_t(lang, "", "en/", "es/") + "index.html\">" + wk_t(lang, "Versão livro", "Book version", "Versión libro") + "</a></li></ul></div>"
    l = l + "<div class=\"portlet\"><h3>" + wk_t(lang, "Buscar", "Search", "Buscar") + "</h3><form id=\"wk-search\" action=\"" + wk_idx_name(lang) + ".html\" method=\"get\"><input type=\"search\" name=\"q\" id=\"wk-q\" autocomplete=\"off\" aria-label=\"" + wk_t(lang, "Buscar", "Search", "Buscar") + "\"><button type=\"submit\">" + wk_t(lang, "Ir", "Go", "Ir") + "</button></form><ul id=\"wk-results\"></ul></div>"
    l = l + "<div class=\"portlet\"><h3>" + wk_t(lang, "Linguagens", "Languages", "Lenguajes") + "</h3><ul>"
    l = l + "<li><a href=\"" + wk_name("ODL_REFERENCE", lang) + ".html\">ODL</a></li><li><a href=\"" + wk_name("OES_REFERENCE", lang) + ".html\">OES</a></li>"
    l = l + "<li><a href=\"" + dr + wk_t(lang, "", "en/", "") + "oll.html\">OLL</a></li><li><a href=\"" + wk_name("OAL_REFERENCE", lang) + ".html\">OAL</a></li></ul></div>"
    l = l + "<div class=\"portlet\"><h3>" + wk_t(lang, "Ferramentas", "Tools", "Herramientas") + "</h3><ul>"
    l = l + "<li><a href=\"" + wk_repo + "\">" + wk_t(lang, "Código-fonte no GitHub", "Source code on GitHub", "Código fuente en GitHub") + "</a></li>"
    l = l + "<li><a href=\"" + wk_repo + "/releases\">" + wk_t(lang, "Baixar", "Download", "Descargar") + "</a></li></ul></div>"
    l = l + "<div class=\"portlet\"><h3>" + wk_t(lang, "Outros idiomas", "Other languages", "Otros idiomas") + "</h3><ul>"
    l = l + "<li><a href=\"" + wk_langlink(lang, "pt", dk) + "\" hreflang=\"pt\">Português</a></li><li><a href=\"" + wk_langlink(lang, "en", dk) + "\" hreflang=\"en\">English</a></li><li><a href=\"" + wk_langlink(lang, "es", dk) + "\" hreflang=\"es\">Español</a></li></ul></div></div>"
    return l
}

vein wk_shell(lang: obsidian, dk: obsidian, fname: obsidian, title: obsidian, body: obsidian, path: obsidian, cats: obsidian) -> obsidian {
    forge wr = wk_wroot(lang)
    forge dr = wk_droot(lang)
    forge tabs = "<div id=\"wk-tabs\"><ul><li class=\"sel\"><a href=\"" + fname + "\">" + wk_t(lang, "Artigo", "Article", "Artículo") + "</a></li>"
    forge mod = wk_sh("date +%Y-%m-%d", "")
    if (ofs_str_len(path) > 0) {
        tabs = tabs + "<li><a href=\"" + wk_repo + "/blob/main/" + path + "\">" + wk_t(lang, "Código-fonte", "Source", "Código fuente") + "</a></li><li><a href=\"" + wk_repo + "/commits/main/" + path + "\">" + wk_t(lang, "Histórico", "History", "Historial") + "</a></li>"
        mod = wk_sh("date -r '" + path + "' +%Y-%m-%d", mod)
    }
    tabs = tabs + "</ul></div>"
    forge catline = ""
    if (ofs_str_len(cats) > 0) { catline = "<div class=\"catlinks\"><b>" + wk_t(lang, "Categorias", "Categories", "Categorías") + ":</b> " + cats + "</div>" }
    forge legal = ""
    if (bk_exists("docs/legal/LICENSE")) { legal = "<li><a href=\"" + dr + "legal/LICENSE\">" + wk_t(lang, "Aviso legal", "Disclaimers", "Aviso legal") + "</a></li>" }
    forge foot = "<div id=\"wk-footer\"><ul><li>" + wk_t(lang, "Esta página foi modificada pela última vez em ", "This page was last modified on ", "Esta página fue modificada por última vez el ") + mod + ".</li><li>" + wk_t(lang, "Conteúdo disponível sob ", "Content is available under ", "Contenido disponible bajo ") + "<a href=\"" + dr + "legal/LICENSE\">Apache License 2.0</a>.</li><li><a href=\"" + wk_repo + "#readme\">" + wk_t(lang, "Sobre", "About", "Acerca de") + "</a></li>" + legal + "</ul></div>"
    forge head = "<!doctype html><html lang=\"" + lang + "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>" + bk_esc(title) + " - Obsidian Fault Script Wiki</title><link rel=\"icon\" href=\"" + dr + "assets/ofs-256.png\"><link rel=\"stylesheet\" href=\"" + wr + "wiki.css\"><script>document.documentElement.className='js';var WK_PAGES=[" + wk_pages_js(lang) + "];</script></head>"
    forge main = "<body><div id=\"wk-wrap\">" + wk_side(lang, dk) + "<div id=\"wk-main\">" + tabs + "<div id=\"wk-content\"><h1 class=\"firstHeading\">" + bk_inline(title) + "</h1><div class=\"wk-sub\">" + wk_t(lang, "Da Wiki do Obsidian Fault Script, a enciclopédia da linguagem OFS.", "From the Obsidian Fault Script Wiki, the OFS language encyclopedia.", "De la Wiki de Obsidian Fault Script, la enciclopedia del lenguaje OFS.") + "</div>" + body + catline + "</div>" + foot + "</div></div><script src=\"" + wr + "wiki.js\"></script></body></html>\n"
    return head + main
}

vein wk_infobox(lang: obsidian, ver: obsidian, first: obsidian) -> obsidian {
    forge r = "<table class=\"infobox\"><caption>Obsidian Fault Script</caption><tr><td colspan=\"2\" class=\"ib-img\"><img src=\"" + wk_droot(lang) + "assets/ofs-256.png\" alt=\"OFS\" width=\"96\" height=\"96\"></td></tr>"
    r = r + "<tr><th>" + wk_t(lang, "Paradigma", "Paradigm", "Paradigma") + "</th><td>" + wk_t(lang, "imperativo, procedural (<code>monolith</code>/<code>impl</code>), compilada e interpretada", "imperative, procedural (<code>monolith</code>/<code>impl</code>), compiled and interpreted", "imperativo, procedural (<code>monolith</code>/<code>impl</code>), compilado e interpretado") + "</td></tr>"
    r = r + "<tr><th>" + wk_t(lang, "Tipagem", "Typing", "Tipado") + "</th><td>" + wk_t(lang, "estática (<code>stone</code>, <code>crystal</code>, <code>obsidian</code>…)", "static (<code>stone</code>, <code>crystal</code>, <code>obsidian</code>…)", "estático (<code>stone</code>, <code>crystal</code>, <code>obsidian</code>…)") + "</td></tr>"
    r = r + "<tr><th>" + wk_t(lang, "Plataformas", "Platforms", "Plataformas") + "</th><td>Linux, Windows, macOS, Android</td></tr>"
    r = r + "<tr><th>" + wk_t(lang, "Primeira versão", "First release", "Primera versión") + "</th><td>" + first + " (v1.0.0)</td></tr>"
    r = r + "<tr><th>" + wk_t(lang, "Versão atual", "Current version", "Versión actual") + "</th><td>" + ver + "</td></tr>"
    r = r + "<tr><th>" + wk_t(lang, "Licença", "License", "Licencia") + "</th><td>Apache 2.0</td></tr>"
    r = r + "<tr><th>" + wk_t(lang, "Extensões", "Extensions", "Extensiones") + "</th><td><code>.ofs .odl .oes .oll .oal</code></td></tr></table>"
    return r
}

vein wk_portal(lang: obsidian, dk: obsidian, label: obsidian, desc: obsidian) -> obsidian {
    return "<div class=\"portal\"><h3><a href=\"" + wk_name(dk, lang) + ".html\">" + label + "</a></h3><p>" + desc + "</p></div>"
}

vein wk_main_page(lang: obsidian, ver: obsidian, first: obsidian) -> obsidian {
    forge b = wk_infobox(lang, ver, first)
    b = b + "<div class=\"mp-welcome\"><h2 class=\"mp-h\">" + wk_t(lang, "Bem-vindo à Wiki do Obsidian Fault Script", "Welcome to the Obsidian Fault Script Wiki", "Bienvenido a la Wiki de Obsidian Fault Script") + "</h2><p>" + wk_t(lang, "A enciclopédia livre da linguagem OFS: referência, biblioteca padrão, compilador, linguagens ODL/OES/OLL/OAL e Android. ", "The free encyclopedia of the OFS language: reference, standard library, compiler, the ODL/OES/OLL/OAL languages and Android. ", "La enciclopedia libre del lenguaje OFS: referencia, biblioteca estándar, compilador, lenguajes ODL/OES/OLL/OAL y Android. ") + wk_t(lang, "Versão em formato de livro: ", "Book-style version: ", "Versión en formato libro: ") + "<a href=\"" + wk_droot(lang) + wk_t(lang, "", "en/", "es/") + "index.html\">" + wk_t(lang, "Versão livro", "Book version", "Versión libro") + "</a>.</p></div>"
    b = b + "<div class=\"mp-box\"><h2 class=\"mp-h\">" + wk_t(lang, "Artigo em destaque", "Featured article", "Artículo destacado") + "</h2>"
    b = b + "<p>" + wk_t(lang, "<b>Obsidian Fault Script</b> (OFS) é uma linguagem de programação híbrida e auto-hospedada (o compilador é escrito em OFS), com um interpretador de AST para execução imediata (<code>ofs run</code>) e um backend LLVM para binários nativos de alto desempenho (<code>ofs build</code>). O ecossistema inclui o compilador, uma biblioteca padrão, ferramentas de linha de comando e linguagens específicas de domínio para a web (ODL e OES), janelas (OLL) e Android (OAL).", "<b>Obsidian Fault Script</b> (OFS) is a hybrid, self-hosted programming language (the compiler is written in OFS), featuring an AST interpreter for instant execution (<code>ofs run</code>) and an LLVM backend for high-performance native binaries (<code>ofs build</code>). The ecosystem includes the compiler, a standard library, command-line tools and domain-specific languages for the web (ODL and OES), windows (OLL) and Android (OAL).", "<b>Obsidian Fault Script</b> (OFS) es un lenguaje de programación híbrido y autoalojado (el compilador está escrito en OFS), con un intérprete de AST para ejecución inmediata (<code>ofs run</code>) y un backend LLVM para binarios nativos de alto rendimiento (<code>ofs build</code>). El ecosistema incluye el compilador, una biblioteca estándar, herramientas de línea de comandos y lenguajes de dominio para la web (ODL y OES), ventanas (OLL) y Android (OAL).") + " <a href=\"" + wk_name("GETTING_STARTED", lang) + ".html\">" + wk_t(lang, "Leia mais…", "Read more…", "Leer más…") + "</a></p></div>"
    b = b + "<div class=\"mp-box\"><h2 class=\"mp-h\">" + wk_t(lang, "Você sabia…?", "Did you know…?", "¿Sabías que…?") + "</h2><ul>"
    b = b + "<li>" + wk_t(lang, "…que o compilador do OFS compila a si mesmo, e o IR gerado pela 1ª e pela 2ª geração é idêntico (ponto fixo do self-host)? ", "…that the OFS compiler compiles itself, and the IR produced by generation 1 and generation 2 is identical (the self-host fixed point)? ", "…que el compilador de OFS se compila a sí mismo y el IR de la 1ª y la 2ª generación es idéntico (punto fijo del self-host)? ") + "(<a href=\"" + wk_name("CHANGELOG", lang) + ".html\">" + wk_t(lang, "Mudanças recentes", "Recent changes", "Cambios recientes") + "</a>)</li>"
    b = b + "<li>" + wk_t(lang, "…que no OFS as funções se chamam <code>vein</code>, as variáveis <code>forge</code>, o ponto de entrada é <code>core</code> e as strings são do tipo <code>obsidian</code>? ", "…that in OFS functions are called <code>vein</code>, variables are <code>forge</code>, the entry point is <code>core</code> and strings have the <code>obsidian</code> type? ", "…que en OFS las funciones se llaman <code>vein</code>, las variables <code>forge</code>, el punto de entrada es <code>core</code> y las cadenas son de tipo <code>obsidian</code>? ") + "(<a href=\"" + wk_name("LANGUAGE_REFERENCE", lang) + ".html\">" + wk_t(lang, "Referência da linguagem", "Language reference", "Referencia del lenguaje") + "</a>)</li>"
    b = b + "<li>" + wk_t(lang, "…que o teclado do sistema Android (Gboard) funciona nos campos de texto da OAL via JNI, sem nenhum código Java próprio? ", "…that the Android system keyboard (Gboard) works in OAL text fields through JNI, with no Java code of our own? ", "…que el teclado del sistema Android (Gboard) funciona en los campos de texto de OAL vía JNI, sin código Java propio? ") + "(<a href=\"" + wk_name("ANDROID", lang) + ".html\">Android</a>)</li></ul></div>"
    b = b + "<h2 class=\"mp-h\">" + wk_t(lang, "Portais", "Portals", "Portales") + "</h2><div class=\"portals\">"
    b = b + wk_portal(lang, "GETTING_STARTED", wk_t(lang, "Começando", "Getting started", "Primeros pasos"), wk_t(lang, "Instalação, primeiro programa e comandos.", "Installation, first program and commands.", "Instalación, primer programa y comandos."))
    b = b + wk_portal(lang, "LANGUAGE_REFERENCE", wk_t(lang, "Linguagem", "Language", "Lenguaje"), wk_t(lang, "Tipos, funções, controle de fluxo e mais.", "Types, functions, control flow and more.", "Tipos, funciones, control de flujo y más."))
    b = b + wk_portal(lang, "STANDARD_LIBRARY", wk_t(lang, "Biblioteca", "Library", "Biblioteca"), wk_t(lang, "A biblioteca padrão e seus módulos.", "The standard library and its modules.", "La biblioteca estándar y sus módulos."))
    b = b + wk_portal(lang, "COMPILER_ARCHITECTURE", wk_t(lang, "Ferramentas", "Tools", "Herramientas"), wk_t(lang, "Compilador, bootstrap e desempenho.", "Compiler, bootstrap and performance.", "Compilador, bootstrap y rendimiento."))
    b = b + wk_portal(lang, "ANDROID", "Android", wk_t(lang, "OAL, apps e o runtime no celular.", "OAL, apps and the on-device runtime.", "OAL, apps y el runtime en el móvil."))
    b = b + "</div>"
    return b
}

vein wk_write_doc(lang: obsidian, row: obsidian, outdir: obsidian) -> void {
    forge dk = wk_field(row, 0)
    forge path = bk_resolve(lang, dk)
    if (ofs_str_len(path) == 0) { return }
    forge nm = wk_name(dk, lang)
    wk_lang = lang
    bk_wiki = true
    bk_cur = ""
    bk_open = true
    bk_para = ""
    bk_list = ""
    bk_tab = 0
    bk_code = false
    bk_quote = false
    wk_title = ""
    wk_toc = ""
    wk_secs = ""
    wk_n2 = 0
    wk_n3 = 0
    wk_ntoc = 0
    wk_edit = wk_repo + "/edit/main/" + path
    forge src = read_file(path)
    forge n = ofs_str_len(src)
    forge st = 0
    cycle (forge i = 0; i <= n; i++) {
        if (i == n || ofs_str_char_at(src, i) == 10) {
            bk_line(ofs_str_substr(src, st, i - st))
            st = i + 1
        }
    }
    bk_close_blocks()
    bk_wiki = false
    forge body = bk_cur
    forge toc = ""
    if (wk_ntoc >= 3) {
        toc = "<div id=\"toc\" class=\"toc\"><div class=\"toctitle\"><b>" + wk_t(lang, "Índice", "Contents", "Índice") + "</b> <span class=\"tg\">[<a href=\"#\" id=\"toc-btn\" data-show=\"" + wk_t(lang, "mostrar", "show", "mostrar") + "\" data-hide=\"" + wk_t(lang, "esconder", "hide", "ocultar") + "\">" + wk_t(lang, "esconder", "hide", "ocultar") + "</a>]</span></div><ul>" + wk_toc + "</ul></div>"
        forge p = bk_find(body, "</p>", 0)
        if (p >= 0) {
            body = ofs_str_substr(body, 0, p + 4) + toc + ofs_str_substr(body, p + 4, ofs_str_len(body) - p - 4)
        } else {
            body = toc + body
        }
    }
    if (bk_find(path, "docs/" + lang + "/", 0) != 0 && ofs_str_eq(lang, "pt") == false) {
        body = "<div class=\"wk-note\">" + wk_t(lang, "", "This page has not been translated yet; showing the Portuguese text.", "Esta página aún no está traducida; se muestra el texto en portugués.") + "</div>" + body
    }
    forge title = wk_title
    if (ofs_str_len(title) == 0) { title = nm }
    forge ct = wk_cat_name(0 + stone_of(wk_field(row, 1)), lang)
    forge cats = "<a href=\"" + wk_idx_name(lang) + ".html\">" + ct + "</a>"
    write_file(outdir + nm + ".html", wk_shell(lang, dk, nm + ".html", title, body, path, cats))
    wk_idx = wk_idx + "<li><a href=\"" + nm + ".html\">" + bk_inline(title) + "</a> <small>(" + ct + ")</small></li>\n"
    if (ofs_str_len(wk_json) > 0) { wk_json = wk_json + "," }
    forge secs = ""
    forge pos = 0
    cycle (forge g = 0; g < 400; g++) {
        forge e = bk_find(wk_secs, "\n", pos)
        if (e >= 0) {
            if (ofs_str_len(secs) > 0) { secs = secs + "," }
            secs = secs + "\"" + wk_jesc(ofs_str_substr(wk_secs, pos, e - pos)) + "\""
            pos = e + 1
        }
    }
    wk_json = wk_json + "{\"t\":\"" + wk_jesc(title) + "\",\"u\":\"" + nm + ".html\",\"s\":[" + secs + "]}"
}

vein stone_of(s: obsidian) -> stone {
    forge v = 0
    cycle (forge i = 0; i < ofs_str_len(s); i++) { v = v * 10 + (ofs_str_char_at(s, i) - 48) }
    return v
}

vein wk_write_lang(lang: obsidian, outdir: obsidian) -> void {
    system("mkdir -p " + outdir)
    wk_lang = lang
    wk_idx = ""
    wk_json = ""
    forge ver = wk_sh("git tag | sort -V | tail -1", "v" + bk_version())
    forge first = wk_sh("git log -1 --format=%ad --date=short v1.0.0", "2026-04-01")
    forge pos = 0
    cycle (forge g = 0; g < 40; g++) {
        forge s = bk_find(wk_docs, "\n", pos)
        if (s >= 0) {
            forge e = bk_find(wk_docs, "\n", s + 1)
            if (e > s + 1) { wk_write_doc(lang, ofs_str_substr(wk_docs, s + 1, e - s - 1), outdir) }
            if (e > s) { pos = e }
            if (e < 0) { pos = ofs_str_len(wk_docs) }
        }
    }
    wk_lang = lang
    write_file(outdir + "index.html", wk_shell(lang, "", "index.html", wk_t(lang, "Página principal", "Main page", "Página principal"), wk_main_page(lang, ver, first), "", ""))
    forge ib = "<p>" + wk_t(lang, "Todas as páginas da wiki, em ordem de assunto. Digite na caixa de busca da lateral para filtrar por título ou seção.", "All wiki pages, by topic. Type in the sidebar search box to filter by title or section.", "Todas las páginas de la wiki, por tema. Escribe en el cuadro de búsqueda lateral para filtrar por título o sección.") + "</p><ul class=\"allpages\">" + wk_idx + "</ul>"
    write_file(outdir + wk_idx_name(lang) + ".html", wk_shell(lang, "*", wk_idx_name(lang) + ".html", wk_t(lang, "Índice de páginas", "All pages", "Índice de páginas"), ib, "", ""))
    write_file(outdir + "search.json", "[" + wk_json + "]\n")
}

vein wk_write_all(root: obsidian) -> void {
    wk_init()
    wk_write_lang("pt", root + "wiki/")
    wk_write_lang("en", root + "wiki/en/")
    wk_write_lang("es", root + "wiki/es/")
    write_file(root + "wiki/wiki.css", read_file("src/site/wiki/wiki.css"))
    write_file(root + "wiki/wiki.js", read_file("src/site/wiki/wiki.js"))
}
