attach {F:../../../ofs/stdlib/odl.ofs}
attach {F:../../../ofs/stdlib/oes.ofs}

vein site_css() -> obsidian {
    forge s = ""
    s = s + oes.rule(":root", "color-scheme:dark;" + oes.var("ink", "#e9e4f5") + oes.var("muted", "#9d94b8") + oes.var("paper", "#0c0a12") + oes.var("surface", "#151224") + oes.var("line", "#262038") + oes.var("accent", "#a78bfa") + oes.var("accent2", "#c4b5fd") + oes.var("hot", "#c4b5fd") + oes.var("code", "#0a0810") + oes.var("code-ink", "#e9e4f5"))
    s = s + oes.rule("*", "box-sizing:border-box")
    s = s + oes.rule("html", "scroll-behavior:smooth")
    s = s + oes.rule("body", "margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;line-height:1.6")
    s = s + oes.rule("a", "color:inherit")
    s = s + oes.rule(".wrap", "width:min(1080px,calc(100% - 32px));margin:0 auto")
    s = s + oes.rule(".topbar", "position:sticky;top:0;z-index:10;background:var(--paper);border-bottom:1px solid var(--line)")
    s = s + oes.rule(".nav", "min-height:62px;display:flex;align-items:center;justify-content:space-between;gap:16px")
    s = s + oes.rule(".brand", "display:inline-flex;align-items:center;gap:10px;font-weight:700;text-decoration:none")
    s = s + oes.rule(".brand img", "width:32px;height:32px")
    s = s + oes.rule(".links", "display:flex;align-items:center;gap:18px;color:var(--muted);font-size:14px")
    s = s + oes.rule(".links a", "text-decoration:none")
    s = s + oes.rule(".links a:hover", "color:var(--ink)")
    s = s + oes.rule(".nav-tools", "display:inline-flex;align-items:center;gap:8px;position:relative")
    s = s + oes.rule(".lang", "display:inline-flex;gap:4px")
    s = s + oes.rule(".language-select,.search-box input", "min-height:36px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);padding:0 12px;font:inherit;outline:none")
    s = s + oes.rule(".language-select", "min-width:140px;cursor:pointer")
    s = s + oes.rule(".language-select:hover,.language-select:focus,.search-box input:focus", "border-color:var(--accent)")
    s = s + oes.rule(".language-select option", "background:var(--surface);color:var(--ink)")
    s = s + oes.rule(".search-button", "width:36px;height:36px;display:inline-grid;place-items:center;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);font-size:15px;cursor:pointer")
    s = s + oes.rule(".search-button:hover,.search-button[aria-expanded=\"true\"]", "border-color:var(--accent);color:var(--accent)")
    s = s + oes.rule(".search-box", "display:inline-flex;align-items:center;gap:6px")
    s = s + oes.rule(".search-box input", "width:0;padding:0;border-color:transparent;opacity:0;pointer-events:none;transition:width .15s ease,opacity .15s ease")
    s = s + oes.rule(".search-box.open input", "width:190px;padding:0 12px;border-color:var(--line);opacity:1;pointer-events:auto")
    s = s + oes.rule(".hidden-by-search", "display:none!important")
    s = s + oes.rule(".search-count", "color:var(--muted);font-size:12px")
    s = s + oes.rule(".hero", "padding:72px 0 48px")
    s = s + oes.rule(".hero-grid", "display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);gap:40px;align-items:center")
    s = s + oes.rule(".kicker", "margin:0 0 12px;color:var(--accent);font-weight:600;text-transform:uppercase;font-size:12px;letter-spacing:.08em")
    s = s + oes.rule("h1", "margin:0;font-size:clamp(32px,5vw,52px);line-height:1.08;font-weight:700;letter-spacing:-.01em")
    s = s + oes.rule(".lead", "max-width:640px;margin:18px 0 0;color:var(--muted);font-size:17px")
    s = s + oes.rule(".actions", "display:flex;flex-wrap:wrap;gap:10px;margin-top:26px")
    s = s + oes.rule(".btn", "display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border-radius:6px;background:var(--accent);color:#14101f;text-decoration:none;font-weight:600;border:1px solid var(--accent)")
    s = s + oes.rule(".btn:hover", "background:var(--accent2);border-color:var(--accent2)")
    s = s + oes.rule(".btn.secondary", "background:transparent;color:var(--ink);border-color:var(--line)")
    s = s + oes.rule(".btn.secondary:hover", "border-color:var(--accent);color:var(--accent)")
    s = s + oes.rule(".terminal,.showcase", "background:var(--code);color:var(--code-ink);border-radius:8px;overflow:hidden;border:1px solid var(--line)")
    s = s + oes.rule(".terminal-head", "height:36px;display:flex;align-items:center;padding:0 14px;border-bottom:1px solid var(--line);color:var(--muted);font-size:12px")
    s = s + oes.rule("pre", "margin:0;padding:16px;overflow:auto;font-size:13px;line-height:1.6")
    s = s + oes.rule("code", "font-family:SFMono-Regular,Consolas,Liberation Mono,monospace")
    s = s + oes.rule(".band", "padding:52px 0;border-top:1px solid var(--line)")
    s = s + oes.rule(".section-head", "display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:22px")
    s = s + oes.rule("h2", "margin:0;font-size:clamp(24px,3vw,32px);line-height:1.15;font-weight:700")
    s = s + oes.rule(".section-head p", "max-width:620px;margin:0;color:var(--muted)")
    s = s + oes.rule(".grid", "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px")
    s = s + oes.rule(".card,.doc-link,.mini-page", "background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:18px")
    s = s + oes.rule(".card:hover,.doc-link:hover", "border-color:var(--accent)")
    s = s + oes.rule(".card h3", "margin:0 0 6px;font-size:16px")
    s = s + oes.rule(".card p", "margin:0;color:var(--muted)")
    s = s + oes.rule(".table-wrap", "overflow:auto;border:1px solid var(--line);border-radius:8px")
    s = s + oes.rule("table", "width:100%;border-collapse:collapse;min-width:680px")
    s = s + oes.rule("th,td", "padding:12px 14px;border-bottom:1px solid var(--line);text-align:left")
    s = s + oes.rule("th", "font-size:13px;color:var(--muted);background:var(--surface)")
    s = s + oes.rule("tr:last-child td", "border-bottom:0")
    s = s + oes.rule(".bars", "display:grid;gap:10px")
    s = s + oes.rule(".bar-row", "display:grid;grid-template-columns:132px 1fr 150px;align-items:center;gap:12px")
    s = s + oes.rule(".bar-row .bench-fail", "color:var(--muted);font-size:13px")
    s = s + oes.rule(".bench-subtitle", "margin:22px 0 10px;font-size:16px")
    s = s + oes.rule(".bar", "height:12px;background:var(--surface);border-radius:999px;overflow:hidden")
    s = s + oes.rule(".bar span", "display:block;height:100%;background:var(--accent);border-radius:999px")
    s = s + oes.rule(".metric-tabs", "display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px")
    s = s + oes.rule(".metric-tabs button", "min-height:36px;padding:0 14px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--muted);font-weight:600;cursor:pointer")
    s = s + oes.rule(".metric-tabs button.active", "background:var(--accent);border-color:var(--accent);color:#14101f")
    s = s + oes.rule(".benchmark-note", "margin:0 0 18px;color:var(--muted)")
    s = s + oes.rule(".metric-summary", "display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:18px")
    s = s + oes.rule(".metric-stat", "padding:14px;border:1px solid var(--line);border-radius:8px;background:var(--surface)")
    s = s + oes.rule(".metric-stat strong", "display:block;font-size:20px")
    s = s + oes.rule(".metric-stat span", "color:var(--muted);font-size:13px")
    s = s + oes.rule(".download-grid", "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px")
    s = s + oes.rule(".download-card", "display:flex;flex-direction:column;gap:6px;min-height:120px;text-decoration:none;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:16px")
    s = s + oes.rule(".download-card:hover", "border-color:var(--accent)")
    s = s + oes.rule(".download-card strong", "font-size:16px")
    s = s + oes.rule(".download-card span", "color:var(--muted)")
    s = s + oes.rule(".tool-layout", "display:grid;grid-template-columns:1fr 1fr;gap:16px")
    s = s + oes.rule(".tool-pane", "display:grid;gap:10px")
    s = s + oes.rule(".tool-pane label", "font-weight:600")
    s = s + oes.rule("textarea", "width:100%;min-height:380px;resize:vertical;border:1px solid var(--line);border-radius:8px;background:var(--code);color:var(--code-ink);padding:14px;font:13px/1.55 SFMono-Regular,Consolas,monospace")
    s = s + oes.rule(".tool-controls", "display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px")
    s = s + oes.rule(".tool-controls select", "min-height:40px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);padding:0 12px")
    s = s + oes.rule(".preview-frame", "width:100%;min-height:320px;border:1px solid var(--line);border-radius:8px;background:white")
    s = s + oes.rule(".docs-list", "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px")
    s = s + oes.rule(".doc-link", "text-decoration:none")
    s = s + oes.rule(".doc-link strong", "display:block")
    s = s + oes.rule(".doc-link span", "color:var(--muted);font-size:14px")
    s = s + oes.rule(".doc-layout", "display:grid;grid-template-columns:240px minmax(0,1fr);gap:24px;align-items:start")
    s = s + oes.rule(".toc", "position:sticky;top:84px;border:1px solid var(--line);border-radius:8px;padding:14px")
    s = s + oes.rule(".toc strong", "display:block;margin-bottom:8px")
    s = s + oes.rule(".toc a", "display:block;color:var(--muted);text-decoration:none;padding:6px 0;border-top:1px solid var(--line)")
    s = s + oes.rule(".toc a:hover", "color:var(--ink)")
    s = s + oes.rule(".doc-main", "display:grid;gap:16px")
    s = s + oes.rule(".doc-section", "border:1px solid var(--line);border-radius:8px;background:var(--surface);padding:20px")
    s = s + oes.rule(".doc-section h2", "font-size:24px;margin:0 0 10px")
    s = s + oes.rule(".doc-section h3", "margin:16px 0 8px")
    s = s + oes.rule(".doc-section p", "color:var(--muted);margin:0 0 12px")
    s = s + oes.rule(".dual", "display:grid;grid-template-columns:1fr 1fr;gap:14px")
    s = s + oes.rule(".doc-intro", "margin-bottom:14px")
    s = s + oes.rule(".doc-intro p", "font-size:16px;line-height:1.65")
    s = s + oes.rule(".callout", "border:1px solid var(--line);background:var(--paper);padding:12px 14px;border-radius:8px;color:var(--muted)")
    s = s + oes.rule(".callout strong", "color:var(--ink)")
    s = s + oes.rule(".pill-row", "display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0")
    s = s + oes.rule(".pill", "display:inline-flex;align-items:center;min-height:28px;border:1px solid var(--line);border-radius:999px;padding:0 10px;color:var(--muted);font-size:13px")
    s = s + oes.rule(".module-grid", "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px")
    s = s + oes.rule(".module", "border:1px solid var(--line);border-radius:8px;padding:14px;background:var(--paper)")
    s = s + oes.rule(".module code", "display:inline-block;margin-bottom:8px;color:var(--hot)")
    s = s + oes.rule(".module p", "margin:0 0 10px;color:var(--muted)")
    s = s + oes.rule(".module ul", "margin:8px 0 0;padding-left:18px;color:var(--muted)")
    s = s + oes.rule(".module li", "margin:4px 0")
    s = s + oes.rule(".api-table code", "color:var(--hot)")
    s = s + oes.rule(".workflow", "display:grid;grid-template-columns:repeat(4,1fr);gap:12px")
    s = s + oes.rule(".step", "padding:16px;border:1px solid var(--line);border-radius:8px;background:var(--surface)")
    s = s + oes.rule(".footer", "padding:28px 0;color:var(--muted);border-top:1px solid var(--line)")
    s = s + oes.media("(max-width:900px)", ".links>a{display:none}.links{margin-left:auto}.nav-tools{margin-left:auto}.language-select{min-width:128px}.search-box.open{position:fixed;left:16px;right:16px;top:72px;z-index:30;padding:10px;background:var(--paper);border:1px solid var(--line);border-radius:8px}.search-box.open .search-button{flex:0 0 36px}.search-box.open input{width:100%;min-width:0;flex:1}.search-box.open .search-count{white-space:nowrap}.hero-grid,.grid,.docs-list,.workflow,.metric-summary,.tool-layout,.download-grid,.doc-layout,.dual,.module-grid{grid-template-columns:1fr}.toc{position:static}.section-head{display:block}.section-head p{margin-top:10px}.bar-row{grid-template-columns:100px 1fr 112px}")
    s = s + oes.media("(max-width:520px)", ".wrap{width:min(100% - 24px,1080px)}.nav{min-height:56px}.brand span{display:none}.language-select{min-width:112px;max-width:112px}.nav-tools{gap:6px}.band{padding:40px 0}.doc-section{padding:16px}.doc-section h2{font-size:22px}h1{font-size:30px}.search-box.open{top:64px}.search-count{display:none}.bar-row{grid-template-columns:84px 1fr 96px;gap:8px;font-size:13px}")
    return s
}

vein site_js() -> obsidian {
    forge s = ""
    s = s + "const translations={pt:{navDocs:'Documentação',navBench:'Benchmark',navRelease:'Downloads',kicker:'Linguagem compilada híbrida',title:'OFS compila, roda nativo e constrói a Web.',lead:'Uma linguagem self-hosted com LLVM, runtime nativo, ODL para documentos e OES para estilo, efeitos e movimento.',ctaStart:'Começar',ctaGitHub:'GitHub',terminalTitle:'exemplo.ofs',pillarsTitle:'O que é a OFS',pillarsLead:'Uma linguagem para aprender, compilar e descer perto do sistema quando precisar.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker e geração LLVM vivem no compilador OFS.',p2Title:'Nativa',p2Body:'A saída é LLVM IR linkada com runtime OFS para gerar executáveis.',p3Title:'Híbrida',p3Body:'Console, canvas/window nativo e sites via webserver/webui no mesmo ecossistema.',webTitle:'ODL + OES',webLead:'ODL descreve documentos; OES define estilo, efeitos, responsividade e animações.',benchTitle:'Benchmark reproduzível',benchLead:'Tempo de parede, memória (RSS) e tamanho do binário de seis programas em OFS, C, Rust e Python.',docsTitle:'Documentação',docsLead:'Guias técnicos para linguagem, compilador, bootstrap, UI e publicação.',releaseTitle:'Downloads',releaseLead:'Baixe instaladores oficiais, pacote VS Code e checksums publicados na release.',footer:'OFS é um projeto experimental de linguagem compilada. Site gerado pela própria OFS para GitHub Pages.'},en:{navDocs:'Documentation',navBench:'Benchmark',navRelease:'Downloads',kicker:'Hybrid compiled language',title:'OFS compiles, runs native, and builds the Web.',lead:'Obsidian Fault Script is a self-hosted language with an LLVM pipeline, modular standard library, low-level modes, and an experimental Web UI layer for building sites with OFS.',ctaStart:'Get started',ctaGitHub:'GitHub',terminalTitle:'example.ofs',pillarsTitle:'What OFS is',pillarsLead:'A language for learning, compiling, and moving close to the system when needed.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker, and LLVM generation live in the OFS compiler.',p2Title:'Native',p2Body:'The output is LLVM IR linked with runtime OFS to produce executables.',p3Title:'Hybrid',p3Body:'Console apps, native canvas/window apps, and sites via webserver/webui in one ecosystem.',webTitle:'ODL + OES',webLead:'Web files are explicit: the extension only uses Go Live when it sees attach {webui} or web calls.',benchTitle:'Reproducible benchmark',benchLead:'Wall time, memory (RSS), and binary size of six small programs in OFS, C, Rust, and Python. Local measurement, not a complete performance study.',docsTitle:'Documentation',docsLead:'Technical guides for the language, compiler, bootstrap, UI, and publishing.',releaseTitle:'Downloads',releaseLead:'Download official installers, the VS Code package, and release checksums.',footer:'OFS is an experimental compiled language project. Site generated by OFS itself for GitHub Pages.'},es:{navDocs:'Documentación',navBench:'Benchmark',navRelease:'Downloads',kicker:'Lenguaje compilado híbrido',title:'OFS compila, ejecuta nativo y construye la Web.',lead:'Obsidian Fault Script es un lenguaje self-hosted con pipeline LLVM, librería estándar modular, modos low-level y una capa Web UI experimental para crear sitios con OFS.',ctaStart:'Empezar',ctaGitHub:'GitHub',terminalTitle:'ejemplo.ofs',pillarsTitle:'Qué es OFS',pillarsLead:'Un lenguaje para aprender, compilar y acercarse al sistema cuando haga falta.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker y generación LLVM viven en el compilador OFS.',p2Title:'Nativo',p2Body:'La salida es LLVM IR enlazada con runtime OFS para generar ejecutables.',p3Title:'Híbrido',p3Body:'Consola, canvas/window nativo y sitios via webserver/webui en el mismo ecosistema.',webTitle:'ODL + OES',webLead:'Los archivos web son explícitos: la extensión solo usa Go Live cuando ve attach {webui} o llamadas web.',benchTitle:'Benchmark reproducible',benchLead:'Tiempo de pared, memoria (RSS) y tamaño del binario de seis programas pequeños en OFS, C, Rust y Python. Medición local, no un estudio completo de rendimiento.',docsTitle:'Documentación',docsLead:'Guías técnicas para lenguaje, compilador, bootstrap, UI y publicación.',releaseTitle:'Downloads',releaseLead:'La release publica assets Linux, macOS, Windows, VS Code y checksums.',footer:'OFS es un proyecto experimental de lenguaje compilado. Sitio generado por la propia OFS para GitHub Pages.'}};"
    s = s + "Object.assign(translations.pt,{title:'OFS: linguagem compilada, runtime nativo e DSLs web próprias.',lead:'Obsidian Fault Script usa um compilador self-hosted, gera LLVM IR, linka uma runtime nativa e inclui ODL/OES como linguagens fonte para sites.',pillarsTitle:'Componentes técnicos',pillarsLead:'O ecossistema separa compilador, runtime, biblioteca padrão, ferramentas web e empacotamento.',p1Title:'Compilador',p2Title:'Runtime',p3Title:'Web',p2Body:'Executáveis linkam runtime OFS para strings, arrays, IO, webserver e UI nativa.',p3Body:'ODL e OES são fontes próprias; HTML/CSS são targets de hospedagem.',webLead:'ODL define documento; OES define efeitos, tokens, layout e movimento. Ambos são fontes OFS, não HTML/CSS renomeados.',docsLead:'Referência técnica da linguagem, stdlib, compilador, ODL/OES, extensão e publicação.',footer:'Site gerado pela própria OFS para GitHub Pages.'});"
    s = s + "Object.assign(translations.en,{title:'OFS: compiled language, native runtime, and first-class web DSLs.',lead:'Obsidian Fault Script uses a self-hosted compiler, emits LLVM IR, links a native runtime, and ships ODL/OES as authored source languages for sites.',pillarsTitle:'Technical components',pillarsLead:'The ecosystem separates compiler, runtime, standard library, web tooling, and packaging.',p1Title:'Compiler',p2Title:'Runtime',p3Title:'Web',p2Body:'Executables link runtime OFS for strings, arrays, IO, webserver, and native UI.',p3Body:'ODL and OES are authored sources; HTML/CSS are hosting targets.',webLead:'ODL defines documents; OES defines effects, tokens, layout, and motion. They are OFS sources, not renamed HTML/CSS.',docsLead:'Technical reference for the language, stdlib, compiler, ODL/OES, extension, and publishing.',footer:'Site generated by OFS itself for GitHub Pages.'});"
    s = s + "Object.assign(translations.es,{title:'OFS: lenguaje compilado, runtime nativo y DSLs web propias.',lead:'Obsidian Fault Script usa un compilador self-hosted, genera LLVM IR, enlaza un runtime nativo e incluye ODL/OES como fuentes para sitios.',pillarsTitle:'Componentes técnicos',pillarsLead:'El ecosistema separa compilador, runtime, biblioteca estándar, herramientas web y empaquetado.',p1Title:'Compilador',p2Title:'Runtime',p3Title:'Web',p2Body:'Los ejecutables enlazan runtime OFS para strings, arrays, IO, webserver y UI nativa.',p3Body:'ODL y OES son fuentes propias; HTML/CSS son targets de alojamiento.',webLead:'ODL define documentos; OES define efectos, tokens, layout y movimiento.',docsLead:'Referencia técnica del lenguaje, stdlib, compilador, ODL/OES, extensión y publicación.',footer:'Sitio generado por OFS para GitHub Pages.'});"
    s = s + "function applyLanguage(lang){const dict=translations[lang]||translations.pt;document.documentElement.lang=lang;document.querySelectorAll('[data-i18n]').forEach((node)=>{const key=node.getAttribute('data-i18n');if(dict[key])node.textContent=dict[key];});document.querySelectorAll('[data-lang]').forEach((button)=>button.classList.toggle('active',button.getAttribute('data-lang')===lang));localStorage.setItem('ofs-lang',lang)}"
    s = s + "async function setupReleaseDownloads(){const links=[...document.querySelectorAll('[data-release-asset]')];if(!links.length)return;try{const response=await fetch('https://api.github.com/repos/Samwns/Obsidian-Fault-Script/releases/latest');if(!response.ok)return;const data=await response.json();links.forEach((link)=>{const key=link.getAttribute('data-release-asset');const asset=(data.assets||[]).find((item)=>item.name.includes(key));if(asset)link.href=asset.browser_download_url;const version=link.querySelector('[data-release-version]');if(version)version.textContent=data.tag_name||'latest'})}catch(e){}}"
    s = s + "function setupLanguageSelect(){const select=document.querySelector('[data-language-select]');if(!select)return;select.addEventListener('change',()=>{const target=select.options[select.selectedIndex].dataset.href;if(target)location.href=target})}"
    s = s + "function setupSearch(){const box=document.querySelector('.search-box'),button=document.querySelector('.search-button'),input=document.querySelector('[data-site-search]'),count=document.querySelector('.search-count');if(!box||!button||!input)return;const nodes=[...document.querySelectorAll('.doc-section,.doc-link,.card,.module,.download-card,.step')];const close=()=>{box.classList.remove('open');button.setAttribute('aria-expanded','false');input.value='';run()};const run=()=>{const q=input.value.trim().toLowerCase();let shown=0;nodes.forEach((node)=>{const ok=!q||node.textContent.toLowerCase().includes(q);node.classList.toggle('hidden-by-search',!ok);if(ok)shown++});if(count)count.textContent=q?`${shown} resultados`:''};button.addEventListener('click',()=>{const open=!box.classList.contains('open');if(open){box.classList.add('open');button.setAttribute('aria-expanded','true');input.focus()}else close()});input.addEventListener('input',run);document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&box.classList.contains('open')){close();button.focus()}});document.addEventListener('click',(event)=>{if(box.classList.contains('open')&&!box.contains(event.target))close()})}"
    s = s + "setupLanguageSelect();setupSearch();setupReleaseDownloads();if(document.getElementById('benchmark-bars'))loadBenchmark().catch(()=>{const meta=document.getElementById('benchmark-meta');if(meta)meta.textContent=(typeof bt!=='undefined'?bt.unavailable:'Dados de benchmark indisponíveis.')});"
    return s
}

vein site_runtime_js() -> obsidian {
    forge s = site_js()
    s = s + "const benchBlang=((document.getElementById('benchmark-meta')||{dataset:{}}).dataset.blang)||'pt';const benchT={pt:{loc:'pt-BR',info:{empty:'Inicialização: programa que só imprime ok',fib:'fib(35) recursivo',loop:'Laço de 10^8 iterações',strings:'Strings: 1 MB de texto',sort:'Quicksort de 100 mil inteiros',alloc:'1 milhão de alocações'},status:{ok:'ok',differs:'saída difere',memory:'memória',timeout:'timeout',failure:'falha'},na:'n/d',fail:'falha',memLimit:'memória',relC:'Relativo a C',relFast:'Relativo ao mais rápido',wall:'Tempo de parede, menor é melhor.',lang:'Linguagem',empty:'Binário vazio',interp:'n/a (interpretador)',unavailable:'Dados de benchmark indisponíveis.',note:(m,versions)=>`Mediana de ${m.runs} execuções (tempo de parede). OFS interpretado: ${m.interp_runs} execução, limite de ${m.interp_timeout_s}s. Limite de ${m.mem_limit_mb} MB de memória por processo. ${versions}. Medições locais desta máquina, não um ranking universal.`},en:{loc:'en-US',info:{empty:'Startup: program that only prints ok',fib:'recursive fib(35)',loop:'Loop of 10^8 iterations',strings:'Strings: 1 MB of text',sort:'Quicksort of 100 thousand integers',alloc:'1 million allocations'},status:{ok:'ok',differs:'output differs',memory:'memory',timeout:'timeout',failure:'failure'},na:'n/a',fail:'failure',memLimit:'memory',relC:'Relative to C',relFast:'Relative to the fastest',wall:'Wall time, lower is better.',lang:'Language',empty:'Empty binary',interp:'n/a (interpreter)',unavailable:'Benchmark data unavailable.',note:(m,versions)=>`Median of ${m.runs} runs (wall time). Interpreted OFS: ${m.interp_runs} run, ${m.interp_timeout_s}s limit. ${m.mem_limit_mb} MB memory limit per process. ${versions}. Local measurements from this machine, not a universal ranking.`},es:{loc:'es-ES',info:{empty:'Inicio: programa que solo imprime ok',fib:'fib(35) recursivo',loop:'Bucle de 10^8 iteraciones',strings:'Strings: 1 MB de texto',sort:'Quicksort de 100 mil enteros',alloc:'1 millón de asignaciones'},status:{ok:'ok',differs:'salida difiere',memory:'memoria',timeout:'timeout',failure:'fallo'},na:'n/d',fail:'fallo',memLimit:'memoria',relC:'Relativo a C',relFast:'Relativo al más rápido',wall:'Tiempo de pared, menor es mejor.',lang:'Lenguaje',empty:'Binario vacío',interp:'n/a (intérprete)',unavailable:'Datos de benchmark no disponibles.',note:(m,versions)=>`Mediana de ${m.runs} ejecuciones (tiempo de pared). OFS interpretado: ${m.interp_runs} ejecución, límite de ${m.interp_timeout_s}s. Límite de ${m.mem_limit_mb} MB de memoria por proceso. ${versions}. Mediciones locales de esta máquina, no un ranking universal.`}};const bt=benchT[benchBlang]||benchT.pt;const benchInfo=bt.info;const benchStatus=bt.status;const benchLoc=bt.loc;function benchEsc(v){return String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')}function benchLabel(data,l){return (data.language_labels&&data.language_labels[l])||l}function benchHas(r){return !!r&&typeof r.ms==='number'}function benchText(data,r){if(!r)return bt.na;if(benchHas(r))return `${r.ms.toLocaleString(benchLoc)} ms`+(r.status==='differs'?` (${bt.status.differs})`:'');if(r.text)return r.text;const m=data.method||{};if(r.status==='memory')return `${bt.memLimit} (>${m.mem_limit_mb} MB)`;return benchStatus[r.status]||bt.fail}function renderBench(data,b){const res=(data.results||{})[b]||{};const langs=(data.languages||Object.keys(res)).filter((l)=>res[l]);const times=langs.map((l)=>res[l]).filter(benchHas).map((r)=>r.ms);const max=Math.max(1,...times);const ref=res.c&&benchHas(res.c)&&res.c.ms>0?res.c.ms:Math.min(...times.filter((v)=>v>0));const bars=document.getElementById('benchmark-bars');const rows=document.getElementById('benchmark-rows');bars.innerHTML='';rows.innerHTML='';const head=document.getElementById('bench-rel-head');if(head)head.textContent=res.c&&benchHas(res.c)?bt.relC:bt.relFast;langs.forEach((l)=>{const r=res[l];const has=benchHas(r);const width=has?Math.max(2,r.ms/max*100):0;const text=benchEsc(benchText(data,r));const rel=has&&isFinite(ref)&&ref>0?`${(r.ms/ref).toFixed(1)}x`:'-';bars.insertAdjacentHTML('beforeend',`<div class=\"bar-row\"><strong>${benchEsc(benchLabel(data,l))}</strong><div class=\"bar\"><span style=\"width:${width}%\"></span></div><span${has?'':' class=\"bench-fail\"'}>${text}</span></div>`);rows.insertAdjacentHTML('beforeend',`<tr><td>${benchEsc(benchLabel(data,l))}</td><td>${text}</td><td>${rel}</td><td>${benchEsc(benchStatus[r.status]||r.status)}</td></tr>`)});document.getElementById('metric-label').textContent=`${benchInfo[b]||b}. ${bt.wall}`;document.querySelectorAll('[data-bench]').forEach((button)=>button.classList.toggle('active',button.dataset.bench===b))}function benchBytes(n){if(typeof n!=='number')return bt.na;const f=(x)=>x.toLocaleString(benchLoc,{minimumFractionDigits:1,maximumFractionDigits:1});return n>=1048576?`${f(n/1048576)} MB`:`${f(n/1024)} KB`}function renderBenchMemory(data){const head=document.getElementById('benchmark-rss-head');const body=document.getElementById('benchmark-rss-rows');if(!head||!body)return;const rss=data.rss_mb||{};const size=data.binary_size_bytes||{};const benches=data.benchmarks||[];head.innerHTML=`<tr><th>${bt.lang}</th><th>${bt.empty}</th>${benches.map((b)=>`<th>RSS ${benchEsc(b)} (MB)</th>`).join('')}</tr>`;body.innerHTML='';Object.keys(rss).forEach((l)=>{const sz=size[l];const szText=typeof sz==='number'?`<span title=\"${sz} bytes\">${benchBytes(sz)}</span>`:(l==='python'?bt.interp:bt.na);body.insertAdjacentHTML('beforeend',`<tr><td>${benchEsc(benchLabel(data,l))}</td><td>${szText}</td>${benches.map((b)=>{const v=rss[l][b];return `<td>${typeof v==='number'?v.toLocaleString(benchLoc,{minimumFractionDigits:1,maximumFractionDigits:1}):bt.na}</td>`}).join('')}</tr>`)})}async function loadBenchmark(){const bp=benchBlang==='pt'?'':'../';let response=await fetch(bp+'benchmark.json');if(!response.ok)response=await fetch(bp+'assets/benchmark.json');const data=await response.json();if(!data.results||!data.benchmarks)throw new Error('formato antigo');const mc=data.machine||{},m=data.method||{},v=data.versions||{};document.getElementById('benchmark-meta').textContent=`${mc.cpu} - ${mc.threads} threads - ${mc.os} - ${data.date}`;const versions=[v.ofs&&`OFS ${v.ofs}`,v.clang,v.rustc,v.go,v.python].filter(Boolean).join(' / ');document.getElementById('benchmark-note').textContent=bt.note(m,versions);document.querySelectorAll('[data-bench]').forEach((button)=>button.addEventListener('click',()=>renderBench(data,button.dataset.bench)));renderBench(data,data.results.fib?'fib':data.benchmarks[0]);renderBenchMemory(data)}"
    s = s + "document.querySelectorAll('[data-copy]').forEach((b)=>b.addEventListener('click',()=>navigator.clipboard&&navigator.clipboard.writeText(b.getAttribute('data-copy'))));"
    s = s + "const toolEscape=(v)=>v.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');const toolQuote=(v,n=0)=>{const m=[...v.matchAll(/\"((?:\\\\.|[^\"])*)\"/g)];return m[n]?m[n][1].replaceAll('\\\\n','\\n').replaceAll('\\\\\"','\"'):''};"
    s = s + "function browserMarkdown(v){return v.replace(/^### (.*)$/gm,'<h3>$1</h3>').replace(/^## (.*)$/gm,'<h2>$1</h2>').replace(/^# (.*)$/gm,'<h1>$1</h1>').replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>').replace(/`(.+?)`/g,'<code>$1</code>').replace(/^- (.*)$/gm,'<li>$1</li>')}"
    s = s + "function odlToHtml(src){let title='ODL Document',lang='pt',head='<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">',body='',stack=[];const tagAliases={deck:'nav',stage:'main',band:'section',tile:'article',text:'p',title1:'h1',title2:'h2',title3:'h3',link:'a',asset:'img'};for(const raw of src.split(/\\r?\\n/)){const clean=raw.trim();if(!clean||clean.startsWith('//'))continue;const indent=raw.search(/\\S|$/);while(stack.length&&stack.at(-1).indent>=indent)body+=`</${stack.pop().tag}>`;const cmd=clean.split(/\\s+/)[0],text=toolQuote(clean);if(cmd==='document'||cmd==='page'){title=text||title;lang=toolQuote(clean,1)||lang;continue}if(cmd==='style'||cmd==='skin'){head+=`<link rel=\"stylesheet\" href=\"${toolEscape(text)}\">`;continue}if(cmd==='body'||cmd==='flow'||cmd==='head')continue;if(cmd==='markdown'||cmd==='md'||cmd==='mark'){body+=browserMarkdown(text);continue}if(cmd==='html'||cmd==='raw'){body+=text;continue}if(cmd==='script'||cmd==='wire'||cmd==='module'||cmd==='node'||cmd==='spark'){body+=`<script${cmd==='script'||cmd==='wire'?'': ' type=\"module\"'} src=\"${toolEscape(text)}\"><\\/script>`;continue}if(cmd==='js'||cmd==='pulse'){body+=`<script>${text}<\\/script>`;continue}if(cmd==='php'||cmd==='server'){body+=`<?php ${text} ?>`;continue}if(cmd==='image'||cmd==='img'||cmd==='asset'){body+=`<img src=\"${toolEscape(text)}\" alt=\"${toolEscape(toolQuote(clean,1))}\">`;continue}let rawTag=(cmd.match(/^[^.#]+/)||['div'])[0],tag=tagAliases[rawTag]||rawTag,id=(cmd.match(/#([\\w-]+)/)||[])[1],classes=[...cmd.matchAll(/\\.([\\w-]+)/g)].map(x=>x[1]).join(' ');let attrs=(id?` id=\"${id}\"`:'')+(classes?` class=\"${classes}\"`:'');if((tag==='a'||rawTag==='link')&&toolQuote(clean,1))attrs+=` href=\"${toolEscape(toolQuote(clean,1))}\"`;if(text)body+=`<${tag}${attrs}>${toolEscape(text)}</${tag}>`;else{body+=`<${tag}${attrs}>`;stack.push({tag,indent})}}while(stack.length)body+=`</${stack.pop().tag}>`;return `<!doctype html><html lang=\"${lang}\"><head>${head}<title>${toolEscape(title)}</title></head><body>${body}</body></html>`}"
    s = s + "function oesToCss(src){const aliases={bg:'background',fill:'background',radius:'border-radius',curve:'border-radius',columns:'grid-template-columns','grid-cols':'grid-template-columns',rows:'grid-template-rows','grid-rows':'grid-template-rows',size:'font-size','type-size':'font-size',weight:'font-weight',align:'align-items',justify:'justify-content',space:'gap',edge:'border',ink:'color',flow:'display'};let out='/* Generated by OES */',stack=[];for(const raw of src.split(/\\r?\\n/)){const clean=raw.trim();if(!clean||clean.startsWith('//'))continue;const indent=raw.search(/\\S|$/);while(stack.length&&stack.at(-1)>=indent){out+='}';stack.pop()}const cmd=clean.split(/\\s+/)[0],text=toolQuote(clean).replace(/\\$([\\w-]+)/g,'var(--$1)');if(cmd==='raw'||cmd==='css'){out+=text;continue}if(cmd==='token'||cmd==='gem'||cmd==='tone'){out+=`:root{--${clean.split(/\\s+/)[1]}:${text};}`;continue}if(cmd==='media'||cmd==='veil'||cmd==='supports'||cmd==='guard'||cmd==='layer'||cmd==='strata'){const at={veil:'media',guard:'supports',strata:'layer'}[cmd]||cmd;out+=`@${at} ${text}{`;stack.push(indent);continue}if(cmd==='keyframes'||cmd==='motion'||cmd==='pulse'){out+=`@keyframes ${text}{`;stack.push(indent);continue}if(cmd==='from'||cmd==='rise'||cmd==='to'||cmd==='rest'||cmd.startsWith('at')){out+=(cmd==='rise'?'from':cmd==='rest'?'to':cmd.startsWith('at')?cmd.slice(2)+'%':cmd)+'{';stack.push(indent);continue}if(cmd==='paint'){out+=clean.slice(5).trim()+'{';stack.push(indent);continue}if(text)out+=`${aliases[cmd]||cmd}:${text};`;else{out+=cmd+'{';stack.push(indent)}}while(stack.length){out+='}';stack.pop()}return out}"
    s = s + "function setupPlayground(){const input=document.getElementById('translator-input'),output=document.getElementById('translator-output'),mode=document.getElementById('translator-mode'),preview=document.getElementById('translator-preview'),run=document.getElementById('translator-run');if(!input)return;const convert=()=>{let value='';if(mode.value==='odl-html')value=odlToHtml(input.value);else if(mode.value==='oes-css')value=oesToCss(input.value);else if(mode.value==='html-odl')value='page \"Documento importado\" \"pt\"\\nflow\\n  raw \"'+input.value.replaceAll('\\\\','\\\\\\\\').replaceAll('\"','\\\\\"').replaceAll('\\n','\\\\n')+'\"';else value='raw \"'+input.value.replaceAll('\\\\','\\\\\\\\').replaceAll('\"','\\\\\"').replaceAll('\\n','\\\\n')+'\"';output.value=value;if(mode.value==='odl-html')preview.srcdoc=value;else if(mode.value==='oes-css')preview.srcdoc=`<!doctype html><style>${value}</style><main class=\"demo\"><h1>Prévia OES</h1><button class=\"button\">Componente estilizado</button></main>`};run.addEventListener('click',convert);mode.addEventListener('change',convert);convert()}setupPlayground();"
    s = s + "const reveal=new IntersectionObserver((items)=>items.forEach((i)=>{if(i.isIntersecting)i.target.classList.add('seen')}),{threshold:.15});document.querySelectorAll('.card,.step,.terminal,.doc-link').forEach((n)=>reveal.observe(n));"
    return s
}

vein site_section_head(title_key: obsidian, title: obsidian, lead_key: obsidian, lead: obsidian) -> obsidian {
    return odl.div("section-head", "<h2 data-i18n=\"" + title_key + "\">" + title + "</h2>" + "<p data-i18n=\"" + lead_key + "\">" + lead + "</p>")
}

vein doc_dual(pt: obsidian, en: obsidian) -> obsidian {
    return odl.div("doc-intro", odl.p("", pt))
}

vein doc_section(id: obsidian, title: obsidian, pt: obsidian, en: obsidian, extra: obsidian) -> obsidian {
    return odl.section(id, "doc-section", odl.h2(title) + doc_dual(pt, en) + extra)
}

vein doc_toc(items: obsidian) -> obsidian {
    return "<aside class=\"toc\">" + odl.strong("Nesta página") + items + "</aside>"
}

vein doc_link(id: obsidian, title: obsidian) -> obsidian {
    return "<a href=\"#" + id + "\">" + title + "</a>"
}

vein doc_page(title: obsidian, subtitle: obsidian, toc: obsidian, body: obsidian) -> obsidian {
    return odl.section("", "band", odl.div("wrap doc-layout", doc_toc(toc) + odl.div("doc-main", body)))
}

vein site_language_select(current: obsidian, pt_href: obsidian, en_href: obsidian, es_href: obsidian) -> obsidian {
    forge pt_selected = ""
    forge en_selected = ""
    forge es_selected = ""
    if (current == "pt") { pt_selected = " selected" }
    if (current == "en") { en_selected = " selected" }
    if (current == "es") { es_selected = " selected" }
    return "<select class=\"language-select\" data-language-select aria-label=\"Idioma\"><option data-href=\"" + pt_href + "\" value=\"pt\"" + pt_selected + ">Português</option><option data-href=\"" + en_href + "\" value=\"en\"" + en_selected + ">English</option><option data-href=\"" + es_href + "\" value=\"es\"" + es_selected + ">Español</option></select>"
}

vein site_search(label: obsidian) -> obsidian {
    return "<span class=\"search-box\"><button class=\"search-button\" type=\"button\" title=\"" + label + "\" aria-label=\"" + label + "\" aria-expanded=\"false\">&#128269;</button><input data-site-search type=\"search\" placeholder=\"" + label + "\" aria-label=\"" + label + "\"><span class=\"search-count\" aria-live=\"polite\"></span></span>"
}

vein bn_t(lang: obsidian, pt: obsidian, en: obsidian, es: obsidian) -> obsidian {
    if (ofs_str_eq(lang, "en")) { return en }
    if (ofs_str_eq(lang, "es")) { return es }
    return pt
}

vein site_benchmark(lang: obsidian) -> obsidian {
    forge body = site_section_head("benchTitle", bn_t(lang, "Benchmark reproduzível", "Reproducible benchmark", "Benchmark reproducible"), "benchLead", bn_t(lang, "Tempo de parede, memória (RSS) e tamanho do binário de seis programas em OFS, C, Rust e Python.", "Wall time, memory (RSS), and binary size of six programs in OFS, C, Rust, and Python.", "Tiempo de pared, memoria (RSS) y tamaño del binario de seis programas en OFS, C, Rust y Python."))
    body = body + "<div class=\"metric-tabs\" id=\"benchmark-tabs\"><button type=\"button\" data-bench=\"empty\">empty</button><button type=\"button\" data-bench=\"fib\">fib</button><button type=\"button\" data-bench=\"loop\">loop</button><button type=\"button\" data-bench=\"strings\">strings</button><button type=\"button\" data-bench=\"sort\">sort</button><button type=\"button\" data-bench=\"alloc\">alloc</button></div>"
    body = body + odl.div("card", "<p id=\"benchmark-meta\" class=\"kicker\" data-blang=\"" + lang + "\">" + bn_t(lang, "Carregando benchmark...", "Loading benchmark...", "Cargando benchmark...") + "</p><p id=\"benchmark-note\" class=\"benchmark-note\"></p><strong id=\"metric-label\">" + bn_t(lang, "fib(35) recursivo", "recursive fib(35)", "fib(35) recursivo") + "</strong><div class=\"bars\" id=\"benchmark-bars\"></div>")
    body = body + odl.div("table-wrap", odl.table("<tr><th>" + bn_t(lang, "Linguagem", "Language", "Lenguaje") + "</th><th>" + bn_t(lang, "Tempo", "Time", "Tiempo") + "</th><th id=\"bench-rel-head\">" + bn_t(lang, "Relativo a C", "Relative to C", "Relativo a C") + "</th><th>Status</th></tr>", ""))
    body = body + "<h3 class=\"bench-subtitle\">" + bn_t(lang, "Memória máxima (RSS) e tamanho do binário vazio", "Peak memory (RSS) and empty binary size", "Memoria máxima (RSS) y tamaño del binario vacío") + "</h3>"
    body = body + odl.div("table-wrap", "<table class=\"api-table\"><thead id=\"benchmark-rss-head\"></thead><tbody id=\"benchmark-rss-rows\"></tbody></table>")
    return odl.section("benchmark", "band", odl.div("wrap", body))
}

vein page_nav(lang: obsidian) -> obsidian {
    forge pre = ""
    forge book = "index.html"
    forge ref = "ref/index.html"
    forge bench = "benchmark.html"
    forge pt_href = "benchmark.html"
    forge en_href = "en/benchmark.html"
    forge es_href = "es/benchmark.html"
    if (ofs_str_eq(lang, "pt") == false) {
        pre = "../"
        ref = "../ref/" + lang + "/index.html"
        pt_href = "../benchmark.html"
        en_href = "../en/benchmark.html"
        es_href = "../es/benchmark.html"
        if (ofs_str_eq(lang, "en")) { en_href = "benchmark.html" }
        if (ofs_str_eq(lang, "es")) { es_href = "benchmark.html" }
    }
    forge brand = odl.a("brand", book, odl.img(pre + "ofs-256.png", "OFS logo") + odl.span("", "OFS"))
    forge tools = odl.div("nav-tools", site_language_select(lang, pt_href, en_href, es_href) + site_search(bn_t(lang, "Buscar", "Search", "Buscar")))
    forge links = odl.div("links", "<a href=\"" + book + "\">" + bn_t(lang, "Livro", "Book", "Libro") + "</a><a href=\"" + ref + "\">" + bn_t(lang, "Referência", "Reference", "Referencia") + "</a><a href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\">Downloads</a><a href=\"" + bench + "\">Benchmark</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein page_shell(lang: obsidian, title: obsidian, subtitle: obsidian, content: obsidian) -> obsidian {
    forge pre = ""
    if (ofs_str_eq(lang, "pt") == false) { pre = "../" }
    forge head = odl.icon(pre + "ofs-256.png") + odl.css(pre + "site.css")
    forge hero = odl.section("", "band", odl.div("wrap", odl.h1(title) + odl.p("lead", subtitle)))
    forge body = page_nav(lang) + odl.main("top", hero + content) + odl.footer("footer", "<div class=\"wrap\">" + bn_t(lang, "Gerado por ODL e OES em OFS.", "Generated by ODL and OES in OFS.", "Generado por ODL y OES en OFS.") + "</div>") + odl.script(pre + "site.js")
    return odl.document(lang, title + " - OFS", subtitle, head, body)
}

vein page_benchmark(lang: obsidian) -> obsidian {
    forge sub = bn_t(lang, "Tempo, memória (RSS) e tamanho do binário de OFS, C, Rust e Python em seis programas.", "Time, memory (RSS), and binary size of OFS, C, Rust, and Python across six programs.", "Tiempo, memoria (RSS) y tamaño del binario de OFS, C, Rust y Python en seis programas.")
    forge summary = "<div class=\"metric-summary\"><div class=\"metric-stat\"><strong>" + bn_t(lang, "6 programas", "6 programs", "6 programas") + "</strong><span>empty, fib, loop, strings, sort, alloc</span></div><div class=\"metric-stat\"><strong>" + bn_t(lang, "Mediana", "Median", "Mediana") + "</strong><span>" + bn_t(lang, "Tempo de parede de várias execuções", "Wall time over several runs", "Tiempo de pared de varias ejecuciones") + "</span></div><div class=\"metric-stat\"><strong>ulimit -v</strong><span>" + bn_t(lang, "Limite de memória por processo", "Memory limit per process", "Límite de memoria por proceso") + "</span></div><div class=\"metric-stat\"><strong>bench/expected</strong><span>" + bn_t(lang, "Saída validada em toda linguagem", "Output validated in every language", "Salida validada en todo lenguaje") + "</span></div></div>"
    forge toc = doc_link("method", bn_t(lang, "Método", "Method", "Método")) + doc_link("metrics", bn_t(lang, "Programas", "Programs", "Programas")) + doc_link("results", bn_t(lang, "Resultados", "Results", "Resultados")) + doc_link("limits", bn_t(lang, "Interpretação", "Interpretation", "Interpretación"))
    forge mrows = ""
    if (ofs_str_eq(lang, "en")) {
        mrows = "<tr><td><code>empty</code></td><td>Startup: the program only prints <code>ok</code>. Also gives the empty binary size.</td></tr><tr><td><code>fib</code></td><td>Function calls: recursive <code>fib(35)</code>.</td></tr><tr><td><code>loop</code></td><td>Integer arithmetic in a loop of 10^8 iterations.</td></tr><tr><td><code>strings</code></td><td>Building and reading 1 MB of text.</td></tr><tr><td><code>sort</code></td><td>Quicksort of 100 thousand integers in an array (<code>a[i] = v</code>).</td></tr><tr><td><code>alloc</code></td><td>1 million small allocations.</td></tr><tr><td>RSS</td><td>Peak resident memory of each program (<code>/usr/bin/time -v</code>).</td></tr>"
    }
    if (ofs_str_eq(lang, "es")) {
        mrows = "<tr><td><code>empty</code></td><td>Inicio: el programa solo imprime <code>ok</code>. También da el tamaño del binario vacío.</td></tr><tr><td><code>fib</code></td><td>Llamadas a funciones: <code>fib(35)</code> recursivo.</td></tr><tr><td><code>loop</code></td><td>Aritmética entera en un bucle de 10^8 iteraciones.</td></tr><tr><td><code>strings</code></td><td>Construcción y lectura de 1 MB de texto.</td></tr><tr><td><code>sort</code></td><td>Quicksort de 100 mil enteros en un array (<code>a[i] = v</code>).</td></tr><tr><td><code>alloc</code></td><td>1 millón de asignaciones pequeñas.</td></tr><tr><td>RSS</td><td>Pico de memoria residente de cada programa (<code>/usr/bin/time -v</code>).</td></tr>"
    }
    if (ofs_str_eq(lang, "pt")) {
        mrows = "<tr><td><code>empty</code></td><td>Inicialização: o programa só imprime <code>ok</code>. Também dá o tamanho do binário vazio.</td></tr><tr><td><code>fib</code></td><td>Chamadas de função: <code>fib(35)</code> recursivo.</td></tr><tr><td><code>loop</code></td><td>Aritmética inteira em um laço de 10^8 iterações.</td></tr><tr><td><code>strings</code></td><td>Montagem e leitura de 1 MB de texto.</td></tr><tr><td><code>sort</code></td><td>Quicksort de 100 mil inteiros em array (<code>a[i] = v</code>).</td></tr><tr><td><code>alloc</code></td><td>1 milhão de alocações pequenas.</td></tr><tr><td>RSS</td><td>Pico de memória residente de cada programa (<code>/usr/bin/time -v</code>).</td></tr>"
    }
    forge metrics = "<table class=\"api-table\"><thead><tr><th>" + bn_t(lang, "Programa", "Program", "Programa") + "</th><th>" + bn_t(lang, "O que mede", "What it measures", "Qué mide") + "</th></tr></thead><tbody>" + mrows + "</tbody></table>"
    forge body = doc_section("method", bn_t(lang, "Metodologia dos testes", "Test methodology", "Metodología de las pruebas"), bn_t(lang, "O script `bash bench/run.sh` compila cada implementação (OFS com o compilador e o runtime do repositório, C com `clang -O2`, Rust com `rustc -O`), roda processos reais, compara a saída com `bench/expected/` e guarda a mediana do tempo de parede. Cada processo roda com limite de memória (`ulimit -v`) e de tempo.", "The `bash bench/run.sh` script compiles each implementation (OFS with the repository compiler and runtime, C with `clang -O2`, Rust with `rustc -O`), runs real processes, compares the output with `bench/expected/`, and keeps the median wall time. Each process runs with a memory limit (`ulimit -v`) and a time limit.", "El script `bash bench/run.sh` compila cada implementación (OFS con el compilador y el runtime del repositorio, C con `clang -O2`, Rust con `rustc -O`), ejecuta procesos reales, compara la salida con `bench/expected/` y guarda la mediana del tiempo de pared. Cada proceso corre con límite de memoria (`ulimit -v`) y de tiempo."), "", summary)
    body = body + doc_section("metrics", bn_t(lang, "Programas medidos", "Measured programs", "Programas medidos"), bn_t(lang, "Seis programas pequenos e equivalentes em todas as linguagens, cada um exercitando uma parte diferente do runtime.", "Six small, equivalent programs in every language, each exercising a different part of the runtime.", "Seis programas pequeños y equivalentes en todos los lenguajes, cada uno ejercitando una parte distinta del runtime."), "", odl.div("table-wrap", metrics))
    body = body + doc_section("results", bn_t(lang, "Resultados medidos", "Measured results", "Resultados medidos"), bn_t(lang, "Os dados vêm de `bench/results.json`, gerado por `bash bench/run.sh` e copiado para `benchmark.json` no build do site. Escolha o programa nas abas.", "The data comes from `bench/results.json`, produced by `bash bench/run.sh` and copied to `benchmark.json` in the site build. Pick the program in the tabs.", "Los datos vienen de `bench/results.json`, generado por `bash bench/run.sh` y copiado a `benchmark.json` en el build del sitio. Elija el programa en las pestañas."), "", site_benchmark(lang))
    forge callout = bn_t(lang, "<strong>memória</strong>: o processo passou do limite de memória e foi encerrado. <strong>timeout</strong>: passou do limite de tempo. <strong>falha</strong>: saiu com erro por outro motivo. A máquina, a data e as versões aparecem acima dos gráficos.", "<strong>memory</strong>: the process exceeded the memory limit and was terminated. <strong>timeout</strong>: it exceeded the time limit. <strong>failure</strong>: it exited with an error for another reason. The machine, date, and versions appear above the charts.", "<strong>memoria</strong>: el proceso superó el límite de memoria y fue terminado. <strong>timeout</strong>: superó el límite de tiempo. <strong>fallo</strong>: terminó con error por otro motivo. La máquina, la fecha y las versiones aparecen sobre los gráficos.")
    body = body + doc_section("limits", bn_t(lang, "Como interpretar os dados", "How to read the data", "Cómo interpretar los datos"), bn_t(lang, "Resultados dependem do hardware, sistema operacional e configurações de compilação. Medições pontuais refletem o workload testado, não afirmações universais de velocidade.", "Results depend on hardware, operating system, and build settings. Individual measurements reflect the tested workload, not universal speed claims.", "Los resultados dependen del hardware, el sistema operativo y la configuración de compilación. Las mediciones puntuales reflejan la carga probada, no afirmaciones universales de velocidad."), "", odl.div("callout", callout))
    forge side = "<aside class=\"toc\">" + odl.strong(bn_t(lang, "Nesta página", "On this page", "En esta página")) + toc + "</aside>"
    forge content = odl.section("", "band", odl.div("wrap doc-layout", side + odl.div("doc-main", body)))
    return page_shell(lang, "Benchmark", sub, content)
}

