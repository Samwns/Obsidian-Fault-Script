attach {F:../../../ofs/stdlib/odl.ofs}
attach {F:../../../ofs/stdlib/oes.ofs}

vein site_css() -> obsidian {
    forge s = ""
    s = s + oes.rule(":root", "color-scheme:dark;" + oes.var("ink", "#f4edff") + oes.var("muted", "#b8a9d6") + oes.var("paper", "#05030a") + oes.var("surface", "#120d1f") + oes.var("line", "#34234f") + oes.var("accent", "#a978ff") + oes.var("accent2", "#f06cff") + oes.var("hot", "#d8b4fe") + oes.var("code", "#05030a") + oes.var("code-ink", "#efe5ff"))
    s = s + oes.rule("*", "box-sizing:border-box")
    s = s + oes.rule("html", "scroll-behavior:smooth")
    s = s + oes.rule("body", "margin:0;background:linear-gradient(180deg,#05030a 0%,#0b0613 44%,#05030a 100%);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;line-height:1.55;overflow-x:hidden")
    s = s + oes.rule("body:before", "content:\"\";position:fixed;inset:0;background:linear-gradient(transparent 0 23px,rgba(255,255,255,.035) 24px),linear-gradient(90deg,transparent 0 23px,rgba(255,255,255,.03) 24px);background-size:24px 24px;mask-image:linear-gradient(to bottom,black,transparent 72%);pointer-events:none")
    s = s + oes.rule("a", "color:inherit")
    s = s + oes.rule(".wrap", "width:min(1180px,calc(100% - 32px));margin:0 auto")
    s = s + oes.rule(".topbar", "position:sticky;top:0;z-index:10;background:rgba(7,10,15,.76);border-bottom:1px solid var(--line);backdrop-filter:blur(18px)")
    s = s + oes.rule(".nav", "min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:16px")
    s = s + oes.rule(".brand", "display:inline-flex;align-items:center;gap:10px;font-weight:900;text-decoration:none")
    s = s + oes.rule(".brand img", "width:36px;height:36px")
    s = s + oes.rule(".links", "display:flex;align-items:center;gap:18px;color:var(--muted);font-size:14px")
    s = s + oes.rule(".links a", "text-decoration:none")
    s = s + oes.rule(".links a:hover", "color:var(--accent)")
    s = s + oes.rule(".nav-tools", "display:inline-flex;align-items:center;gap:8px;position:relative")
    s = s + oes.rule(".lang", "display:inline-flex;gap:4px")
    s = s + oes.rule(".language-select,.search-box input", "min-height:38px;border:1px solid var(--line);border-radius:8px;background:#111722;color:var(--ink);padding:0 12px;font:inherit;outline:none")
    s = s + oes.rule(".language-select", "min-width:148px;appearance:none;-webkit-appearance:none;padding-right:34px;cursor:pointer;background-color:#111722;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 16px) 16px,calc(100% - 11px) 16px;background-size:5px 5px,5px 5px;background-repeat:no-repeat")
    s = s + oes.rule(".language-select:hover,.language-select:focus,.search-box input:focus", "border-color:var(--accent)")
    s = s + oes.rule(".language-select option", "background:#111722;color:var(--ink)")
    s = s + oes.rule(".search-button", "width:38px;height:38px;display:inline-grid;place-items:center;border:1px solid var(--line);border-radius:8px;background:#111722;color:var(--ink);font-size:16px;cursor:pointer")
    s = s + oes.rule(".search-button:hover,.search-button[aria-expanded=\"true\"]", "border-color:var(--accent);color:var(--accent)")
    s = s + oes.rule(".search-box", "display:inline-flex;align-items:center;gap:6px")
    s = s + oes.rule(".search-box input", "width:0;padding:0;border-color:transparent;opacity:0;pointer-events:none;transition:width .2s ease,opacity .2s ease,border-color .2s ease")
    s = s + oes.rule(".search-box.open input", "width:190px;padding:0 12px;border-color:var(--line);opacity:1;pointer-events:auto")
    s = s + oes.rule(".hidden-by-search", "display:none!important")
    s = s + oes.rule(".search-count", "color:var(--muted);font-size:12px")
    s = s + oes.rule(".hero", "min-height:82vh;display:grid;align-items:center;padding:58px 0 36px")
    s = s + oes.rule(".hero-grid", "display:grid;grid-template-columns:minmax(0,1.08fr) minmax(340px,.92fr);gap:44px;align-items:center")
    s = s + oes.rule(".kicker", "margin:0 0 14px;color:var(--accent);font-weight:900;text-transform:uppercase;font-size:13px;letter-spacing:.12em")
    s = s + oes.rule("h1", "margin:0;font-size:clamp(50px,8vw,104px);line-height:.88;letter-spacing:0")
    s = s + oes.rule(".lead", "max-width:760px;margin:24px 0 0;color:var(--muted);font-size:clamp(18px,2.2vw,22px)")
    s = s + oes.rule(".actions", "display:flex;flex-wrap:wrap;gap:12px;margin-top:30px")
    s = s + oes.rule(".btn", "min-height:46px;display:inline-flex;align-items:center;justify-content:center;padding:0 18px;border-radius:8px;border:1px solid rgba(169,120,255,.55);background:linear-gradient(135deg,var(--accent),#f0b6ff);color:#08040f;text-decoration:none;font-weight:900;box-shadow:0 12px 34px rgba(169,120,255,.18)")
    s = s + oes.rule(".btn.secondary", "background:rgba(255,255,255,.04);color:var(--ink);border-color:var(--line);box-shadow:none")
    s = s + oes.rule(".terminal,.showcase", "background:linear-gradient(180deg,rgba(16,23,34,.96),rgba(8,12,18,.96));color:var(--code-ink);border-radius:8px;box-shadow:0 24px 70px rgba(0,0,0,.36);overflow:hidden;border:1px solid var(--line)")
    s = s + oes.rule(".terminal-head", "height:40px;display:flex;align-items:center;padding:0 14px;border-bottom:1px solid var(--line);color:#9fb0c0;font-size:13px")
    s = s + oes.rule("pre", "margin:0;padding:18px;overflow:auto;font-size:13px;line-height:1.6")
    s = s + oes.rule("code", "font-family:SFMono-Regular,Consolas,Liberation Mono,monospace")
    s = s + oes.rule(".band", "padding:76px 0;border-top:1px solid var(--line);position:relative")
    s = s + oes.rule(".section-head", "display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:26px")
    s = s + oes.rule("h2", "margin:0;font-size:clamp(32px,4vw,54px);line-height:1;letter-spacing:0")
    s = s + oes.rule(".section-head p", "max-width:650px;margin:0;color:var(--muted)")
    s = s + oes.rule(".grid", "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px")
    s = s + oes.rule(".card,.doc-link,.mini-page", "background:rgba(255,255,255,.055);border:1px solid var(--line);border-radius:8px;padding:20px;backdrop-filter:blur(8px)")
    s = s + oes.rule(".card,.step,.terminal,.doc-link", "opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease,border-color .2s ease")
    s = s + oes.rule(".card.seen,.step.seen,.terminal.seen,.doc-link.seen", "opacity:1;transform:translateY(0)")
    s = s + oes.rule(".card:hover,.doc-link:hover", "border-color:rgba(169,120,255,.55);transform:translateY(-2px)")
    s = s + oes.rule(".card h3", "margin:0 0 8px;font-size:18px")
    s = s + oes.rule(".card p", "margin:0;color:var(--muted)")
    s = s + oes.rule(".table-wrap", "overflow:auto;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.045)")
    s = s + oes.rule("table", "width:100%;border-collapse:collapse;min-width:760px")
    s = s + oes.rule("th,td", "padding:13px 14px;border-bottom:1px solid var(--line);text-align:left")
    s = s + oes.rule("th", "font-size:13px;color:var(--muted);background:rgba(255,255,255,.06)")
    s = s + oes.rule("tr:last-child td", "border-bottom:0")
    s = s + oes.rule(".bars", "display:grid;gap:10px")
    s = s + oes.rule(".bar-row", "display:grid;grid-template-columns:82px 1fr 88px;align-items:center;gap:12px")
    s = s + oes.rule(".bar", "height:15px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden")
    s = s + oes.rule(".bar span", "display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:999px;animation:grow .85s ease both")
    s = s + oes.rule(".metric-tabs", "display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px")
    s = s + oes.rule(".metric-tabs button", "min-height:38px;padding:0 14px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.04);color:var(--muted);font-weight:800;cursor:pointer")
    s = s + oes.rule(".metric-tabs button.active", "background:var(--accent);border-color:var(--accent);color:#08040f")
    s = s + oes.rule(".benchmark-note", "margin:0 0 18px;color:var(--muted)")
    s = s + oes.rule(".metric-summary", "display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:18px")
    s = s + oes.rule(".metric-stat", "padding:16px;border-left:3px solid var(--accent);background:rgba(255,255,255,.04)")
    s = s + oes.rule(".metric-stat strong", "display:block;font-size:22px")
    s = s + oes.rule(".metric-stat span", "color:var(--muted);font-size:13px")
    s = s + oes.rule(".download-grid", "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px")
    s = s + oes.rule(".download-card", "display:flex;flex-direction:column;gap:8px;min-height:150px;text-decoration:none;background:rgba(255,255,255,.055);border:1px solid var(--line);border-radius:8px;padding:18px;transition:transform .2s ease,border-color .2s ease")
    s = s + oes.rule(".download-card:hover", "border-color:var(--accent);transform:translateY(-2px)")
    s = s + oes.rule(".download-card strong", "font-size:18px")
    s = s + oes.rule(".download-card span", "color:var(--muted)")
    s = s + oes.rule(".tool-layout", "display:grid;grid-template-columns:1fr 1fr;gap:16px")
    s = s + oes.rule(".tool-pane", "display:grid;gap:10px")
    s = s + oes.rule(".tool-pane label", "font-weight:900")
    s = s + oes.rule("textarea", "width:100%;min-height:430px;resize:vertical;border:1px solid var(--line);border-radius:8px;background:#05080d;color:var(--code-ink);padding:16px;font:13px/1.55 SFMono-Regular,Consolas,monospace")
    s = s + oes.rule(".tool-controls", "display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px")
    s = s + oes.rule(".tool-controls select", "min-height:42px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);padding:0 12px")
    s = s + oes.rule(".preview-frame", "width:100%;min-height:360px;border:1px solid var(--line);border-radius:8px;background:white")
    s = s + oes.rule(".docs-list", "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px")
    s = s + oes.rule(".doc-link", "text-decoration:none")
    s = s + oes.rule(".doc-link strong", "display:block")
    s = s + oes.rule(".doc-link span", "color:var(--muted);font-size:14px")
    s = s + oes.rule(".doc-layout", "display:grid;grid-template-columns:260px minmax(0,1fr);gap:26px;align-items:start")
    s = s + oes.rule(".toc", "position:sticky;top:94px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.045);padding:14px")
    s = s + oes.rule(".toc strong", "display:block;margin-bottom:10px")
    s = s + oes.rule(".toc a", "display:block;color:var(--muted);text-decoration:none;padding:7px 0;border-top:1px solid rgba(255,255,255,.05)")
    s = s + oes.rule(".toc a:hover", "color:var(--accent)")
    s = s + oes.rule(".doc-main", "display:grid;gap:18px")
    s = s + oes.rule(".doc-section", "border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.04);padding:22px")
    s = s + oes.rule(".doc-section h2", "font-size:30px;margin-bottom:12px")
    s = s + oes.rule(".doc-section h3", "margin:18px 0 8px")
    s = s + oes.rule(".doc-section p", "color:var(--muted);margin:0 0 12px")
    s = s + oes.rule(".dual", "display:grid;grid-template-columns:1fr 1fr;gap:14px")
    s = s + oes.rule(".doc-intro", "margin-bottom:16px")
    s = s + oes.rule(".doc-intro p", "font-size:17px;line-height:1.7")
    s = s + oes.rule(".callout", "border:1px solid var(--line);background:rgba(255,255,255,.035);padding:14px 16px;border-radius:8px;color:var(--muted)")
    s = s + oes.rule(".callout strong", "color:var(--ink)")
    s = s + oes.rule(".pill-row", "display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0")
    s = s + oes.rule(".pill", "display:inline-flex;align-items:center;min-height:30px;border:1px solid var(--line);border-radius:999px;padding:0 10px;color:var(--muted);background:rgba(255,255,255,.04);font-size:13px")
    s = s + oes.rule(".module-grid", "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px")
    s = s + oes.rule(".module", "border:1px solid var(--line);border-radius:8px;padding:16px;background:rgba(255,255,255,.045)")
    s = s + oes.rule(".module code", "display:inline-block;margin-bottom:8px;color:var(--hot)")
    s = s + oes.rule(".module p", "margin:0 0 10px;color:var(--muted)")
    s = s + oes.rule(".module ul", "margin:8px 0 0;padding-left:18px;color:var(--muted)")
    s = s + oes.rule(".module li", "margin:4px 0")
    s = s + oes.rule(".api-table code", "color:var(--hot)")
    s = s + oes.rule(".workflow", "display:grid;grid-template-columns:repeat(4,1fr);gap:12px")
    s = s + oes.rule(".step", "padding:18px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.04)")
    s = s + oes.rule(".footer", "padding:34px 0;color:var(--muted);border-top:1px solid var(--line)")
    s = s + oes.keyframes("grow", oes.frame("from", "width:0") + oes.frame("to", ""))
    s = s + oes.keyframes("float", oes.frame("0%,100%", "transform:translateY(0)") + oes.frame("50%", "transform:translateY(-10px)"))
    s = s + oes.rule(".showcase", "animation:float 6s ease-in-out infinite")
    s = s + oes.media("(max-width:900px)", ".links>a{display:none}.links{margin-left:auto}.nav-tools{margin-left:auto}.language-select{min-width:132px}.search-box.open{position:fixed;left:16px;right:16px;top:78px;z-index:30;padding:10px;background:#0b1018;border:1px solid var(--line);border-radius:8px;box-shadow:0 18px 50px rgba(0,0,0,.5)}.search-box.open .search-button{flex:0 0 38px}.search-box.open input{width:100%;min-width:0;flex:1}.search-box.open .search-count{white-space:nowrap}.hero-grid,.grid,.docs-list,.workflow,.metric-summary,.tool-layout,.download-grid,.doc-layout,.dual,.module-grid{grid-template-columns:1fr}.toc{position:static}.hero{min-height:auto;padding-top:36px}.section-head{display:block}.section-head p{margin-top:12px}.bar-row{grid-template-columns:72px 1fr 76px}")
    s = s + oes.media("(max-width:520px)", ".wrap{width:min(100% - 24px,1180px)}.nav{min-height:64px}.brand span{display:none}.brand img{width:32px;height:32px}.language-select{min-width:118px;max-width:118px}.nav-tools{gap:6px}.band{padding:52px 0}.doc-section{padding:18px}.doc-section h2{font-size:26px}h1{font-size:44px}.search-box.open{top:70px;left:12px;right:12px}.search-count{display:none}")
    return s
}

vein site_js() -> obsidian {
    forge s = ""
    s = s + "const translations={pt:{navDocs:'Documentação',navBench:'Benchmark',navRelease:'Downloads',kicker:'Linguagem compilada híbrida',title:'OFS compila, roda nativo e constrói a Web.',lead:'Uma linguagem self-hosted com LLVM, runtime nativo, ODL para documentos e OES para estilo, efeitos e movimento.',ctaStart:'Começar',ctaGitHub:'GitHub',terminalTitle:'exemplo.ofs',pillarsTitle:'O que é a OFS',pillarsLead:'Uma linguagem para aprender, compilar e descer perto do sistema quando precisar.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker e geração LLVM vivem no compilador OFS.',p2Title:'Nativa',p2Body:'A saída é LLVM IR linkada com libofs_runtime.a para gerar executáveis.',p3Title:'Híbrida',p3Body:'Console, canvas/window nativo e sites via webserver/webui no mesmo ecossistema.',webTitle:'ODL + OES',webLead:'ODL descreve documentos; OES define estilo, efeitos, responsividade e animações.',benchTitle:'Benchmark reproduzível',benchLead:'CPU, memória, inicialização, compilação e tamanho de artefato medidos com processos reais.',docsTitle:'Documentação',docsLead:'Guias técnicos para linguagem, compilador, bootstrap, UI e publicação.',releaseTitle:'Downloads',releaseLead:'Baixe instaladores oficiais, pacote VS Code e checksums publicados na release.',footer:'OFS é um projeto experimental de linguagem compilada. Site gerado pela própria OFS para GitHub Pages.'},en:{navDocs:'Documentation',navBench:'Benchmark',navRelease:'Downloads',kicker:'Hybrid compiled language',title:'OFS compiles, runs native, and builds the Web.',lead:'Obsidian Fault Script is a self-hosted language with an LLVM pipeline, modular standard library, low-level modes, and an experimental Web UI layer for building sites with OFS.',ctaStart:'Get started',ctaGitHub:'GitHub',terminalTitle:'example.ofs',pillarsTitle:'What OFS is',pillarsLead:'A language for learning, compiling, and moving close to the system when needed.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker, and LLVM generation live in the OFS compiler.',p2Title:'Native',p2Body:'The output is LLVM IR linked with libofs_runtime.a to produce executables.',p3Title:'Hybrid',p3Body:'Console apps, native canvas/window apps, and sites via webserver/webui in one ecosystem.',webTitle:'ODL + OES',webLead:'Web files are explicit: the extension only uses Go Live when it sees attach {webui} or web calls.',benchTitle:'Reproducible benchmark',benchLead:'Iterative fib(25..32) repeated 5,000,000 times. Local measurement, not a complete performance study.',docsTitle:'Documentation',docsLead:'Technical guides for the language, compiler, bootstrap, UI, and publishing.',releaseTitle:'Downloads',releaseLead:'Download official installers, the VS Code package, and release checksums.',footer:'OFS is an experimental compiled language project. Site generated by OFS itself for GitHub Pages.'},es:{navDocs:'Documentación',navBench:'Benchmark',navRelease:'Downloads',kicker:'Lenguaje compilado híbrido',title:'OFS compila, ejecuta nativo y construye la Web.',lead:'Obsidian Fault Script es un lenguaje self-hosted con pipeline LLVM, librería estándar modular, modos low-level y una capa Web UI experimental para crear sitios con OFS.',ctaStart:'Empezar',ctaGitHub:'GitHub',terminalTitle:'ejemplo.ofs',pillarsTitle:'Qué es OFS',pillarsLead:'Un lenguaje para aprender, compilar y acercarse al sistema cuando haga falta.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker y generación LLVM viven en el compilador OFS.',p2Title:'Nativo',p2Body:'La salida es LLVM IR enlazada con libofs_runtime.a para generar ejecutables.',p3Title:'Híbrido',p3Body:'Consola, canvas/window nativo y sitios via webserver/webui en el mismo ecosistema.',webTitle:'ODL + OES',webLead:'Los archivos web son explícitos: la extensión solo usa Go Live cuando ve attach {webui} o llamadas web.',benchTitle:'Benchmark reproducible',benchLead:'fib(25..32) iterativo repetido 5.000.000 veces. Medición local, no un estudio completo de rendimiento.',docsTitle:'Documentación',docsLead:'Guías técnicas para lenguaje, compilador, bootstrap, UI y publicación.',releaseTitle:'Downloads',releaseLead:'La release publica assets Linux, macOS, Windows, VS Code y checksums.',footer:'OFS es un proyecto experimental de lenguaje compilado. Sitio generado por la propia OFS para GitHub Pages.'}};"
    s = s + "Object.assign(translations.pt,{title:'OFS: linguagem compilada, runtime nativo e DSLs web próprias.',lead:'Obsidian Fault Script usa um compilador self-hosted, gera LLVM IR, linka uma runtime nativa e inclui ODL/OES como linguagens fonte para sites.',pillarsTitle:'Componentes técnicos',pillarsLead:'O ecossistema separa compilador, runtime, biblioteca padrão, ferramentas web e empacotamento.',p1Title:'Compilador',p2Title:'Runtime',p3Title:'Web',p2Body:'Executáveis linkam libofs_runtime.a para strings, arrays, IO, webserver e UI nativa.',p3Body:'ODL e OES são fontes próprias; HTML/CSS são targets de hospedagem.',webLead:'ODL define documento; OES define efeitos, tokens, layout e movimento. Ambos são fontes OFS, não HTML/CSS renomeados.',docsLead:'Referência técnica da linguagem, stdlib, compilador, ODL/OES, extensão e publicação.',footer:'Site gerado pela própria OFS para GitHub Pages.'});"
    s = s + "Object.assign(translations.en,{title:'OFS: compiled language, native runtime, and first-class web DSLs.',lead:'Obsidian Fault Script uses a self-hosted compiler, emits LLVM IR, links a native runtime, and ships ODL/OES as authored source languages for sites.',pillarsTitle:'Technical components',pillarsLead:'The ecosystem separates compiler, runtime, standard library, web tooling, and packaging.',p1Title:'Compiler',p2Title:'Runtime',p3Title:'Web',p2Body:'Executables link libofs_runtime.a for strings, arrays, IO, webserver, and native UI.',p3Body:'ODL and OES are authored sources; HTML/CSS are hosting targets.',webLead:'ODL defines documents; OES defines effects, tokens, layout, and motion. They are OFS sources, not renamed HTML/CSS.',docsLead:'Technical reference for the language, stdlib, compiler, ODL/OES, extension, and publishing.',footer:'Site generated by OFS itself for GitHub Pages.'});"
    s = s + "Object.assign(translations.es,{title:'OFS: lenguaje compilado, runtime nativo y DSLs web propias.',lead:'Obsidian Fault Script usa un compilador self-hosted, genera LLVM IR, enlaza un runtime nativo e incluye ODL/OES como fuentes para sitios.',pillarsTitle:'Componentes técnicos',pillarsLead:'El ecosistema separa compilador, runtime, biblioteca estándar, herramientas web y empaquetado.',p1Title:'Compilador',p2Title:'Runtime',p3Title:'Web',p2Body:'Los ejecutables enlazan libofs_runtime.a para strings, arrays, IO, webserver y UI nativa.',p3Body:'ODL y OES son fuentes propias; HTML/CSS son targets de alojamiento.',webLead:'ODL define documentos; OES define efectos, tokens, layout y movimiento.',docsLead:'Referencia técnica del lenguaje, stdlib, compilador, ODL/OES, extensión y publicación.',footer:'Sitio generado por OFS para GitHub Pages.'});"
    s = s + "function applyLanguage(lang){const dict=translations[lang]||translations.pt;document.documentElement.lang=lang;document.querySelectorAll('[data-i18n]').forEach((node)=>{const key=node.getAttribute('data-i18n');if(dict[key])node.textContent=dict[key];});document.querySelectorAll('[data-lang]').forEach((button)=>button.classList.toggle('active',button.getAttribute('data-lang')===lang));localStorage.setItem('ofs-lang',lang)}"
    s = s + "async function loadLegacyBenchmark(){let response=await fetch('assets/benchmark.json');if(!response.ok){response=await fetch('benchmark.json')}const data=await response.json();const results=data.results.filter((r)=>r.best_seconds!==null);const max=Math.max(...results.map((r)=>r.best_seconds));const bars=document.getElementById('benchmark-bars');const rows=document.getElementById('benchmark-rows');const suites=document.getElementById('benchmark-suites');bars.innerHTML='';rows.innerHTML='';if(suites)suites.innerHTML='';data.results.forEach((result)=>{const value=result.best_seconds;const width=value===null?0:Math.max(4,(value/max)*100);const label=value===null?'n/a':`${value.toFixed(4)}s`;const factor=value===null?'n/a':`${(value/data.results[0].best_seconds).toFixed(1)}x`;bars.insertAdjacentHTML('beforeend',`<div class=\"bar-row\"><strong>${result.language}</strong><div class=\"bar\"><span style=\"width:${width}%\"></span></div><span>${label}</span></div>`);rows.insertAdjacentHTML('beforeend',`<tr><td>${result.language}</td><td>${label}</td><td>${factor}</td><td>${result.output}</td></tr>`)});if(suites&&data.suites){data.suites.forEach((suite)=>{suites.insertAdjacentHTML('beforeend',`<article class=\"card\"><h3>${suite.name}</h3><p>${suite.summary}</p><p><strong>${suite.best_seconds}s</strong> best - ${suite.status}</p></article>`)})}document.getElementById('benchmark-meta').textContent=`${data.benchmark} - menor é melhor - ${data.runs_per_language} runs - ${data.date_utc}`}"
    s = s + "async function setupReleaseDownloads(){const links=[...document.querySelectorAll('[data-release-asset]')];if(!links.length)return;try{const response=await fetch('https://api.github.com/repos/Samwns/Obsidian-Fault-Script/releases/latest');if(!response.ok)return;const data=await response.json();links.forEach((link)=>{const key=link.getAttribute('data-release-asset');const asset=(data.assets||[]).find((item)=>item.name.includes(key));if(asset)link.href=asset.browser_download_url;const version=link.querySelector('[data-release-version]');if(version)version.textContent=data.tag_name||'latest'})}catch(e){}}"
    s = s + "function setupLanguageSelect(){const select=document.querySelector('[data-language-select]');if(!select)return;select.addEventListener('change',()=>{const target=select.options[select.selectedIndex].dataset.href;if(target)location.href=target})}"
    s = s + "function setupSearch(){const box=document.querySelector('.search-box'),button=document.querySelector('.search-button'),input=document.querySelector('[data-site-search]'),count=document.querySelector('.search-count');if(!box||!button||!input)return;const nodes=[...document.querySelectorAll('.doc-section,.doc-link,.card,.module,.download-card,.step')];const close=()=>{box.classList.remove('open');button.setAttribute('aria-expanded','false');input.value='';run()};const run=()=>{const q=input.value.trim().toLowerCase();let shown=0;nodes.forEach((node)=>{const ok=!q||node.textContent.toLowerCase().includes(q);node.classList.toggle('hidden-by-search',!ok);if(ok)shown++});if(count)count.textContent=q?`${shown} resultados`:''};button.addEventListener('click',()=>{const open=!box.classList.contains('open');if(open){box.classList.add('open');button.setAttribute('aria-expanded','true');input.focus()}else close()});input.addEventListener('input',run);document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&box.classList.contains('open')){close();button.focus()}});document.addEventListener('click',(event)=>{if(box.classList.contains('open')&&!box.contains(event.target))close()})}"
    s = s + "setupLanguageSelect();setupSearch();setupReleaseDownloads();if(document.getElementById('benchmark-bars'))loadBenchmark().catch(()=>{const meta=document.getElementById('benchmark-meta');if(meta)meta.textContent='Benchmark data unavailable.'});"
    return s
}

vein site_runtime_js() -> obsidian {
    forge s = site_js()
    s = s + "const benchmarkMetrics={cpu:{field:'cpu_ms',unit:'ms',label:'CPU mediana'},memory:{field:'memory_rss_kb',unit:'KiB',label:'Memória RSS'},startup:{field:'startup_ms',unit:'ms',label:'Inicialização'},compiler:{field:'frontend_ms',unit:'ms',label:'Compilador OFS'},compile:{field:'compile_ms',unit:'ms',label:'Build completo'},artifact:{field:'artifact_bytes',unit:'bytes',label:'Tamanho do artefato'}};"
    s = s + "function metricValue(result,metric){const raw=result[metric.field];return raw&&typeof raw==='object'?raw.median:raw}function metricNumber(value){return value>=1000?value.toLocaleString(undefined,{maximumFractionDigits:1}):value.toFixed(value<10?2:1)}"
    s = s + "function renderMetric(data,key){const metric=benchmarkMetrics[key];const values=data.results.filter((r)=>r.available&&r.correct&&metricValue(r,metric)!==null);const max=Math.max(...values.map((r)=>metricValue(r,metric)));const min=Math.min(...values.map((r)=>metricValue(r,metric)));const bars=document.getElementById('benchmark-bars');const rows=document.getElementById('benchmark-rows');bars.innerHTML='';rows.innerHTML='';values.forEach((result)=>{const value=metricValue(result,metric);const width=Math.max(4,value/max*100);bars.insertAdjacentHTML('beforeend',`<div class=\"bar-row\"><strong>${result.language}</strong><div class=\"bar\"><span style=\"width:${width}%\"></span></div><span>${metricNumber(value)} ${metric.unit}</span></div>`);rows.insertAdjacentHTML('beforeend',`<tr><td>${result.language}</td><td>${metricNumber(value)} ${metric.unit}</td><td>${(value/min).toFixed(2)}x</td><td>${result.correct?'ok':'falhou'}</td></tr>`)});document.getElementById('metric-label').textContent=`${metric.label}. Menor é melhor.`;document.querySelectorAll('[data-metric]').forEach((button)=>button.classList.toggle('active',button.dataset.metric===key))}"
    s = s + "function renderWebBenchmark(data){const body=document.getElementById('web-benchmark-rows');if(!body||!data.web)return;const web=data.web;body.innerHTML=`<tr><td>ODL para HTML</td><td>${metricNumber(web.odl_html_ms.median)} ms</td><td>${web.html_bytes.toLocaleString()} bytes</td></tr><tr><td>OES para CSS</td><td>${metricNumber(web.oes_css_ms.median)} ms</td><td>${web.css_bytes.toLocaleString()} bytes</td></tr><tr><td>Build web total</td><td>${metricNumber(web.total_ms.median)} ms</td><td>${web.source_bytes.toLocaleString()} bytes de fonte</td></tr>`}"
    s = s + "async function loadBenchmark(){let response=await fetch('benchmark.json');if(!response.ok)response=await fetch('assets/benchmark.json');const data=await response.json();document.getElementById('benchmark-meta').textContent=`${data.machine.cpu} - ${data.machine.logical_cores} núcleos lógicos - ${data.generated_at_utc}`;document.getElementById('benchmark-note').textContent='Medições locais desta máquina e deste workload. Não são rankings universais de linguagens.';document.querySelectorAll('[data-metric]').forEach((button)=>button.addEventListener('click',()=>renderMetric(data,button.dataset.metric)));renderMetric(data,'cpu');renderWebBenchmark(data)}"
    s = s + "document.querySelectorAll('[data-copy]').forEach((b)=>b.addEventListener('click',()=>navigator.clipboard&&navigator.clipboard.writeText(b.getAttribute('data-copy'))));"
    s = s + "const toolEscape=(v)=>v.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');const toolQuote=(v,n=0)=>{const m=[...v.matchAll(/\"((?:\\\\.|[^\"])*)\"/g)];return m[n]?m[n][1].replaceAll('\\\\n','\\n').replaceAll('\\\\\"','\"'):''};"
    s = s + "function browserMarkdown(v){return v.replace(/^### (.*)$/gm,'<h3>$1</h3>').replace(/^## (.*)$/gm,'<h2>$1</h2>').replace(/^# (.*)$/gm,'<h1>$1</h1>').replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>').replace(/`(.+?)`/g,'<code>$1</code>').replace(/^- (.*)$/gm,'<li>$1</li>')}"
    s = s + "function odlToHtml(src){let title='ODL Document',lang='pt',head='<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">',body='',stack=[];const tagAliases={deck:'nav',stage:'main',band:'section',tile:'article',text:'p',title1:'h1',title2:'h2',title3:'h3',link:'a',asset:'img'};for(const raw of src.split(/\\r?\\n/)){const clean=raw.trim();if(!clean||clean.startsWith('//'))continue;const indent=raw.search(/\\S|$/);while(stack.length&&stack.at(-1).indent>=indent)body+=`</${stack.pop().tag}>`;const cmd=clean.split(/\\s+/)[0],text=toolQuote(clean);if(cmd==='document'||cmd==='page'){title=text||title;lang=toolQuote(clean,1)||lang;continue}if(cmd==='style'||cmd==='skin'){head+=`<link rel=\"stylesheet\" href=\"${toolEscape(text)}\">`;continue}if(cmd==='body'||cmd==='flow'||cmd==='head')continue;if(cmd==='markdown'||cmd==='md'||cmd==='mark'){body+=browserMarkdown(text);continue}if(cmd==='html'||cmd==='raw'){body+=text;continue}if(cmd==='script'||cmd==='wire'||cmd==='module'||cmd==='node'||cmd==='spark'){body+=`<script${cmd==='script'||cmd==='wire'?'': ' type=\"module\"'} src=\"${toolEscape(text)}\"><\\/script>`;continue}if(cmd==='js'||cmd==='pulse'){body+=`<script>${text}<\\/script>`;continue}if(cmd==='php'||cmd==='server'){body+=`<?php ${text} ?>`;continue}if(cmd==='image'||cmd==='img'||cmd==='asset'){body+=`<img src=\"${toolEscape(text)}\" alt=\"${toolEscape(toolQuote(clean,1))}\">`;continue}let rawTag=(cmd.match(/^[^.#]+/)||['div'])[0],tag=tagAliases[rawTag]||rawTag,id=(cmd.match(/#([\\w-]+)/)||[])[1],classes=[...cmd.matchAll(/\\.([\\w-]+)/g)].map(x=>x[1]).join(' ');let attrs=(id?` id=\"${id}\"`:'')+(classes?` class=\"${classes}\"`:'');if((tag==='a'||rawTag==='link')&&toolQuote(clean,1))attrs+=` href=\"${toolEscape(toolQuote(clean,1))}\"`;if(text)body+=`<${tag}${attrs}>${toolEscape(text)}</${tag}>`;else{body+=`<${tag}${attrs}>`;stack.push({tag,indent})}}while(stack.length)body+=`</${stack.pop().tag}>`;return `<!doctype html><html lang=\"${lang}\"><head>${head}<title>${toolEscape(title)}</title></head><body>${body}</body></html>`}"
    s = s + "function oesToCss(src){const aliases={bg:'background',fill:'background',radius:'border-radius',curve:'border-radius',columns:'grid-template-columns','grid-cols':'grid-template-columns',rows:'grid-template-rows','grid-rows':'grid-template-rows',size:'font-size','type-size':'font-size',weight:'font-weight',align:'align-items',justify:'justify-content',space:'gap',edge:'border',ink:'color',flow:'display'};let out='/* Generated by OES */',stack=[];for(const raw of src.split(/\\r?\\n/)){const clean=raw.trim();if(!clean||clean.startsWith('//'))continue;const indent=raw.search(/\\S|$/);while(stack.length&&stack.at(-1)>=indent){out+='}';stack.pop()}const cmd=clean.split(/\\s+/)[0],text=toolQuote(clean).replace(/\\$([\\w-]+)/g,'var(--$1)');if(cmd==='raw'||cmd==='css'){out+=text;continue}if(cmd==='token'||cmd==='gem'||cmd==='tone'){out+=`:root{--${clean.split(/\\s+/)[1]}:${text};}`;continue}if(cmd==='media'||cmd==='veil'||cmd==='supports'||cmd==='guard'||cmd==='layer'||cmd==='strata'){const at={veil:'media',guard:'supports',strata:'layer'}[cmd]||cmd;out+=`@${at} ${text}{`;stack.push(indent);continue}if(cmd==='keyframes'||cmd==='motion'||cmd==='pulse'){out+=`@keyframes ${text}{`;stack.push(indent);continue}if(cmd==='from'||cmd==='rise'||cmd==='to'||cmd==='rest'||cmd.startsWith('at')){out+=(cmd==='rise'?'from':cmd==='rest'?'to':cmd.startsWith('at')?cmd.slice(2)+'%':cmd)+'{';stack.push(indent);continue}if(cmd==='paint'){out+=clean.slice(5).trim()+'{';stack.push(indent);continue}if(text)out+=`${aliases[cmd]||cmd}:${text};`;else{out+=cmd+'{';stack.push(indent)}}while(stack.length){out+='}';stack.pop()}return out}"
    s = s + "function setupPlayground(){const input=document.getElementById('translator-input'),output=document.getElementById('translator-output'),mode=document.getElementById('translator-mode'),preview=document.getElementById('translator-preview'),run=document.getElementById('translator-run');if(!input)return;const convert=()=>{let value='';if(mode.value==='odl-html')value=odlToHtml(input.value);else if(mode.value==='oes-css')value=oesToCss(input.value);else if(mode.value==='html-odl')value='page \"Documento importado\" \"pt\"\\nflow\\n  raw \"'+input.value.replaceAll('\\\\','\\\\\\\\').replaceAll('\"','\\\\\"').replaceAll('\\n','\\\\n')+'\"';else value='raw \"'+input.value.replaceAll('\\\\','\\\\\\\\').replaceAll('\"','\\\\\"').replaceAll('\\n','\\\\n')+'\"';output.value=value;if(mode.value==='odl-html')preview.srcdoc=value;else if(mode.value==='oes-css')preview.srcdoc=`<!doctype html><style>${value}</style><main class=\"demo\"><h1>Prévia OES</h1><button class=\"button\">Componente estilizado</button></main>`};run.addEventListener('click',convert);mode.addEventListener('change',convert);convert()}setupPlayground();"
    s = s + "const reveal=new IntersectionObserver((items)=>items.forEach((i)=>{if(i.isIntersecting)i.target.classList.add('seen')}),{threshold:.15});document.querySelectorAll('.card,.step,.terminal,.doc-link').forEach((n)=>reveal.observe(n));"
    return s
}

vein site_button(label: obsidian, href: obsidian, secondary: bool) -> obsidian {
    if (secondary) {
        return odl.a("btn secondary", href, label)
    }
    return odl.a("btn", href, label)
}

vein site_terminal(title: obsidian, code: obsidian) -> obsidian {
    return odl.div("terminal", odl.div("terminal-head", title) + odl.code_block(code))
}

vein site_card(title: obsidian, body: obsidian, key: obsidian) -> obsidian {
    forge h = odl.h3(title)
    forge p = odl.p("", body)
    if (key != "") {
        h = "<h3 data-i18n=\"" + key + "Title\">" + title + "</h3>"
        p = "<p data-i18n=\"" + key + "Body\">" + body + "</p>"
    }
    return odl.article("card", h + p)
}

vein site_section_head(title_key: obsidian, title: obsidian, lead_key: obsidian, lead: obsidian) -> obsidian {
    return odl.div("section-head", "<h2 data-i18n=\"" + title_key + "\">" + title + "</h2>" + "<p data-i18n=\"" + lead_key + "\">" + lead + "</p>")
}

vein site_doc_link(href: obsidian, title: obsidian, text: obsidian) -> obsidian {
    return odl.a("doc-link", href, odl.strong(title) + odl.span("", text))
}

vein doc_dual(pt: obsidian, en: obsidian) -> obsidian {
    return odl.div("doc-intro", odl.p("", pt))
}

vein doc_section(id: obsidian, title: obsidian, pt: obsidian, en: obsidian, extra: obsidian) -> obsidian {
    return odl.section(id, "doc-section", odl.h2(title) + doc_dual(pt, en) + extra)
}

vein doc_toc(items: obsidian) -> obsidian {
    return "<aside class=\"toc\">" + odl.strong("Nesta página") + items + "</aside>"
}

vein doc_link(id: obsidian, title: obsidian) -> obsidian {
    return "<a href=\"#" + id + "\">" + title + "</a>"
}

vein doc_page(title: obsidian, subtitle: obsidian, toc: obsidian, body: obsidian) -> obsidian {
    return odl.section("", "band", odl.div("wrap doc-layout", doc_toc(toc) + odl.div("doc-main", body)))
}

vein module_card(name: obsidian, text: obsidian) -> obsidian {
    return odl.div("module", "<code>" + name + "</code>" + odl.p("", text))
}

vein site_language_select(current: obsidian, pt_href: obsidian, en_href: obsidian, es_href: obsidian) -> obsidian {
    forge pt_selected = ""
    forge en_selected = ""
    forge es_selected = ""
    if (current == "pt") { pt_selected = " selected" }
    if (current == "en") { en_selected = " selected" }
    if (current == "es") { es_selected = " selected" }
    return "<select class=\"language-select\" data-language-select aria-label=\"Idioma\"><option data-href=\"" + pt_href + "\" value=\"pt\"" + pt_selected + ">Português</option><option data-href=\"" + en_href + "\" value=\"en\"" + en_selected + ">English</option><option data-href=\"" + es_href + "\" value=\"es\"" + es_selected + ">Español</option></select>"
}

vein site_search(label: obsidian) -> obsidian {
    return "<span class=\"search-box\"><button class=\"search-button\" type=\"button\" title=\"" + label + "\" aria-label=\"" + label + "\" aria-expanded=\"false\">&#128269;</button><input data-site-search type=\"search\" placeholder=\"" + label + "\" aria-label=\"" + label + "\"><span class=\"search-count\" aria-live=\"polite\"></span></span>"
}

vein site_topbar() -> obsidian {
    forge brand = odl.a("brand", "#top", odl.img("assets/ofs-256.png", "OFS logo") + odl.span("", "Obsidian Fault Script"))
    forge tools = odl.div("nav-tools", site_language_select("pt", "index.html", "en/index.html", "es/index.html") + site_search("Buscar"))
    forge links = odl.div("links", "<a href=\"#docs\" data-i18n=\"navDocs\">Documentação</a><a href=\"web.html\">Web</a><a href=\"benchmark.html\" data-i18n=\"navBench\">Benchmark</a><a href=\"downloads.html\" data-i18n=\"navRelease\">Downloads</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein site_hero() -> obsidian {
    forge left = "<h1 data-i18n=\"title\">OFS: linguagem compilada, runtime nativo e DSLs web próprias.</h1>"
    left = left + "<p class=\"lead\" data-i18n=\"lead\">Obsidian Fault Script usa um compilador self-hosted, gera LLVM IR, linka uma runtime nativa e inclui ODL/OES como linguagens fonte para sites.</p>"
    left = left + odl.div("actions", site_button("Começar", "getting-started.html", false) + site_button("Downloads", "downloads.html", true) + site_button("GitHub", "https://github.com/Samwns/Obsidian-Fault-Script", true))
    forge code = "attach {webui}\n\ncore main() {\n    forge body = webui.hero(\n        \"OFS Web\",\n        \"site oficial em OFS\",\n        webui.button(\"Docs\", \"#docs\")\n    )\n\n    webui.serve(8080, \"OFS\", body)\n}"
    return odl.section("", "hero", odl.div("wrap hero-grid", odl.div("", left) + site_terminal("exemplo.ofs", code)))
}

vein site_pillars() -> obsidian {
    forge cards = site_card("Self-hosted", "Lexer, parser, type checker e geração LLVM vivem no compilador OFS.", "p1")
    cards = cards + site_card("Nativa", "A saída é LLVM IR linkada com libofs_runtime.a para gerar executáveis.", "p2")
    cards = cards + site_card("Híbrida", "Console, canvas/window nativo e sites via webserver/webui no mesmo ecossistema.", "p3")
    forge body = site_section_head("pillarsTitle", "Componentes técnicos", "pillarsLead", "O ecossistema separa compilador, runtime, biblioteca padrão, ferramentas web e empacotamento.") + odl.div("grid", cards)
    return odl.section("", "band", odl.div("wrap", body))
}

vein site_web() -> obsidian {
    forge code = "attach {odl}\nattach {oes}\nattach {webserver}\n\ncore main() {\n    forge head = odl.css(\"site.css\")\n    forge body = odl.main(\"app\", odl.h1(\"OFS Web\"))\n    webserver.serve_html_forever(8080, odl.document(\"pt\", \"OFS\", \"site\", head, body))\n}"
    forge body = site_section_head("webTitle", "ODL + OES", "webLead", "ODL descreve documentos; OES define estilo, efeitos, responsividade e animações.") + site_terminal("site.ofs", code)
    return odl.section("web", "band", odl.div("wrap", body))
}

vein site_benchmark() -> obsidian {
    forge body = site_section_head("benchTitle", "Benchmark reproduzível", "benchLead", "CPU, memória, inicialização, compilação e tamanho de artefato medidos com processos reais.")
    body = body + "<div class=\"metric-tabs\"><button type=\"button\" data-metric=\"cpu\">CPU</button><button type=\"button\" data-metric=\"memory\">Memória</button><button type=\"button\" data-metric=\"startup\">Inicialização</button><button type=\"button\" data-metric=\"compiler\">Compilador OFS</button><button type=\"button\" data-metric=\"compile\">Build completo</button><button type=\"button\" data-metric=\"artifact\">Artefato</button></div>"
    body = body + odl.div("card", "<p id=\"benchmark-meta\" class=\"kicker\">Carregando benchmark...</p><p id=\"benchmark-note\" class=\"benchmark-note\"></p><strong id=\"metric-label\">CPU mediana</strong><div class=\"bars\" id=\"benchmark-bars\"></div>")
    body = body + odl.div("table-wrap", odl.table("<tr><th>Linguagem</th><th>Mediana</th><th>Relativo</th><th>Checksum</th></tr>", ""))
    return odl.section("benchmark", "band", odl.div("wrap", body))
}

vein site_docs() -> obsidian {
    forge links = site_doc_link("getting-started.html", "Começando", "Instale, execute, compile e verifique arquivos OFS.")
    links = links + site_doc_link("language.html", "Referência da Linguagem", "Sintaxe, tipos, controle de fluxo e módulos.")
    links = links + site_doc_link("compiler.html", "Arquitetura do Compilador", "Compilador self-hosted e backend LLVM.")
    links = links + site_doc_link("webui.html", "Web UI", "Construa páginas web estáticas e componentes.")
    links = links + site_doc_link("oll.html", "OLL", "Obsidian Layout Language: UI declarativa nativa com janela, canvas e componentes.")
    links = links + site_doc_link("github.html", "Registro no GitHub", "Linguist e reconhecimento de sintaxe no repositório.")
    forge body = site_section_head("docsTitle", "Documentação", "docsLead", "Guias técnicos para linguagem, compilador, bootstrap, UI e publicação.") + odl.div("docs-list", links)
    return odl.section("docs", "band", odl.div("wrap", body))
}

vein site_release() -> obsidian {
    forge cards = "<a class=\"download-card\" data-release-asset=\"debian-ubuntu\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Debian / Ubuntu</strong><span>.deb x64 com OFS, ODL, OES e stdlib.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"fedora\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Fedora / RHEL / openSUSE</strong><span>.rpm x64 para distros da família Red Hat e compatíveis.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"arch\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Arch / Manjaro</strong><span>Pacote pacman com ferramentas nativas.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"macos-arm64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>macOS ARM64</strong><span>Instalador para Apple Silicon.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"windows-x64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Windows x64</strong><span>Instalador com launcher e runtime.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\".vsix\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>VS Code</strong><span>Extensão com OFS, ODL, OES, Go Live e tradutor.</span><code data-release-version>latest</code></a>"
    forge body = site_section_head("releaseTitle", "Downloads", "releaseLead", "Baixe instaladores oficiais, o pacote para VS Code e os checksums publicados na release.")
    body = body + odl.div("download-grid", cards)
    body = body + odl.div("actions", "<a class=\"btn\" data-release-asset=\"CHECKSUMS\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\">Checksums</a>" + site_button("Todas as releases", "https://github.com/Samwns/Obsidian-Fault-Script/releases", true))
    return odl.section("release", "band", odl.div("wrap", body))
}

vein site_release_en() -> obsidian {
    forge cards = "<a class=\"download-card\" data-release-asset=\"debian-ubuntu\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Debian / Ubuntu</strong><span>.deb x64 package with OFS, ODL, OES, and stdlib.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"fedora\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Fedora / RHEL / openSUSE</strong><span>.rpm x64 package for Red Hat-family and compatible distributions.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"arch\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Arch / Manjaro</strong><span>Pacman package with native tools.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"macos-arm64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>macOS ARM64</strong><span>Installer for Apple Silicon.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"windows-x64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Windows x64</strong><span>Installer with launcher and runtime.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\".vsix\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>VS Code</strong><span>Extension with OFS, ODL, OES, Go Live, and translator tools.</span><code data-release-version>latest</code></a>"
    forge body = odl.div("download-grid", cards)
    body = body + odl.div("actions", "<a class=\"btn\" data-release-asset=\"CHECKSUMS\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\">Checksums</a>" + site_button("All releases", "https://github.com/Samwns/Obsidian-Fault-Script/releases", true))
    return body
}

vein site_page() -> obsidian {
    forge head = odl.icon("assets/ofs-256.png") + odl.css("assets/site.css")
    forge body = site_topbar()
    body = body + odl.main("top", site_hero() + site_pillars() + site_web() + site_docs() + site_release())
    body = body + odl.footer("footer", "<div class=\"wrap\" data-i18n=\"footer\">OFS é um projeto experimental de linguagem compilada. Site gerado pela própria OFS para GitHub Pages.</div>") + odl.script("assets/site.js")
    return odl.document("pt", "Obsidian Fault Script", "Official site and documentation for Obsidian Fault Script.", head, body)
}

vein site_page_root() -> obsidian {
    forge head = odl.icon("ofs-256.png") + odl.css("site.css")
    forge body = site_topbar_root()
    body = body + odl.main("top", site_hero_root() + site_pillars() + site_web() + site_docs_root() + site_release())
    body = body + odl.footer("footer", "<div class=\"wrap\" data-i18n=\"footer\">OFS é um projeto experimental de linguagem compilada. Site gerado pela própria OFS para GitHub Pages.</div>") + odl.script("site.js")
    return odl.document("pt", "Obsidian Fault Script", "Official site and documentation for Obsidian Fault Script.", head, body)
}

vein site_topbar_root() -> obsidian {
    forge brand = odl.a("brand", "#top", odl.img("ofs-256.png", "OFS logo") + odl.span("", "Obsidian Fault Script"))
    forge tools = odl.div("nav-tools", site_language_select("pt", "index.html", "en/index.html", "es/index.html") + site_search("Buscar"))
    forge links = odl.div("links", "<a href=\"#docs\" data-i18n=\"navDocs\">Documentação</a><a href=\"web.html\">Web</a><a href=\"benchmark.html\" data-i18n=\"navBench\">Benchmark</a><a href=\"downloads.html\" data-i18n=\"navRelease\">Downloads</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein site_hero_root() -> obsidian {
    forge left = "<h1 data-i18n=\"title\">OFS: linguagem compilada, runtime nativo e DSLs web próprias.</h1>"
    left = left + "<p class=\"lead\" data-i18n=\"lead\">Obsidian Fault Script usa um compilador self-hosted, gera LLVM IR, linka uma runtime nativa e inclui ODL/OES como linguagens fonte para sites.</p>"
    left = left + odl.div("actions", site_button("Começar", "getting-started.html", false) + site_button("Downloads", "downloads.html", true) + site_button("GitHub", "https://github.com/Samwns/Obsidian-Fault-Script", true))
    forge code = "attach {odl}\nattach {oes}\n\nvein page() -> obsidian {\n    forge head = odl.css(\"site.css\")\n    forge body = odl.h1(\"OFS Web\")\n    return odl.document(\"pt\", \"OFS\", \"site oficial\", head, body)\n}"
    return odl.section("", "hero", odl.div("wrap hero-grid", odl.div("", left) + site_terminal("exemplo.ofs", code)))
}

vein site_docs_root() -> obsidian {
    forge links = site_doc_link("getting-started.html", "Começando", "Instale, verifique, execute, compile e publique.")
    links = links + site_doc_link("language.html", "Linguagem OFS", "Sintaxe, tipos, módulos e modos de baixo nível.")
    links = links + site_doc_link("compiler.html", "Compilador", "Pipeline self-hosted, LLVM IR e linkagem nativa.")
    links = links + site_doc_link("odl.html", "ODL", "Referência da Obsidian Document Language.")
    links = links + site_doc_link("oes.html", "OES", "Referência da Obsidian Effect Scripts.")
    links = links + site_doc_link("playground.html", "Tradutor Web", "Traduza ODL, OES, HTML e CSS no navegador.")
    links = links + site_doc_link("webserver.html", "Web Server", "Sirva sites gerados por OFS via HTTP.")
    links = links + site_doc_link("webui.html", "Web UI", "Componentes, páginas e composição de sites.")
    links = links + site_doc_link("web.html", "Web", "ODL, OES, targets gerados, webserver e interoperabilidade.")
    links = links + site_doc_link("stdlib.html", "Biblioteca Padrão", "Módulos distribuídos com OFS.")
    links = links + site_doc_link("packages.html", "Pacotes", "Registro, instalação e fluxo de publicação.")
    links = links + site_doc_link("vscode.html", "VS Code", "Sintaxe, comandos e Go Live.")
    links = links + site_doc_link("commands.html", "Comandos CLI", "Check, run, build, IR e assembly.")
    links = links + site_doc_link("benchmark.html", "Benchmark", "CPU, memória, inicialização, build e tamanho.")
    links = links + site_doc_link("github.html", "Reconhecimento GitHub", "Linguist, gramática, exemplos e registro.")
    forge body = site_section_head("docsTitle", "Documentação", "docsLead", "Guias técnicos para linguagem, compilador, bootstrap, UI e publicação.") + odl.div("docs-list", links)
    return odl.section("docs", "band", odl.div("wrap", body))
}

vein page_nav() -> obsidian {
    forge brand = odl.a("brand", "index.html", odl.img("ofs-256.png", "OFS logo") + odl.span("", "OFS"))
    forge tools = odl.div("nav-tools", site_language_select("pt", "index.html", "en/index.html", "es/index.html") + site_search("Buscar"))
    forge links = odl.div("links", "<a href=\"language.html\">Linguagem</a><a href=\"odl.html\">ODL</a><a href=\"oes.html\">OES</a><a href=\"web.html\">Web</a><a href=\"downloads.html\">Downloads</a><a href=\"playground.html\">Tradutor</a><a href=\"commands.html\">CLI</a><a href=\"benchmark.html\">Benchmark</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein page_shell(title: obsidian, subtitle: obsidian, content: obsidian) -> obsidian {
    forge head = odl.icon("ofs-256.png") + odl.css("site.css")
    forge hero = odl.section("", "band", odl.div("wrap", odl.h1(title) + odl.p("lead", subtitle)))
    forge body = page_nav() + odl.main("top", hero + content) + odl.footer("footer", "<div class=\"wrap\">Gerado por ODL e OES em OFS.</div>") + odl.script("site.js")
    return odl.document("pt", title + " - OFS", subtitle, head, body)
}

vein page_language() -> obsidian {
    forge toc = doc_link("overview", "Visão geral") + doc_link("types", "Tipos") + doc_link("bindings", "Variáveis") + doc_link("operators", "Operadores") + doc_link("functions", "Funções") + doc_link("flow", "Controle") + doc_link("collections", "Coleções") + doc_link("structures", "Estruturas") + doc_link("errors", "Falhas") + doc_link("modules", "Módulos") + doc_link("low", "Baixo nível") + doc_link("build", "Compilação")
    forge syntax = site_terminal("hello.ofs", "attach {math}\n\nvein add(a: stone, b: stone) -> stone {\n    return a + b\n}\n\ncore main() {\n    forge result: stone = add(20, 2)\n    echo(result)\n}")
    forge types = "<table class=\"api-table\"><thead><tr><th>Tipo</th><th>Representação e uso</th><th>Exemplo</th></tr></thead><tbody><tr><td><code>stone</code></td><td>Inteiro principal de 64 bits com sinal.</td><td><code>forge n: stone = 42</code></td></tr><tr><td><code>crystal</code></td><td>Ponto flutuante de 64 bits (IEEE 754).</td><td><code>forge pi: crystal = 3.14</code></td></tr><tr><td><code>obsidian</code></td><td>Texto imutável terminado em zero no runtime.</td><td><code>forge name = \"OFS\"</code></td></tr><tr><td><code>bool</code></td><td>Valor lógico booleano (true ou false).</td><td><code>forge ready = true</code></td></tr><tr><td><code>u8..u64 / i8..i32</code></td><td>Inteiros com largura explícita de bits.</td><td><code>forge channel: u8 = 255</code></td></tr><tr><td><code>Array&lt;T&gt;</code></td><td>Coleção dinâmica homogênea.</td><td><code>forge values = [1, 2, 3]</code></td></tr><tr><td><code>monolith</code></td><td>Estrutura nomeada de campos tipados.</td><td><code>monolith Point { x: stone }</code></td></tr></tbody></table>"
    forge bindings = "<table class=\"api-table\"><thead><tr><th>Forma</th><th>Comportamento</th></tr></thead><tbody><tr><td><code>forge name = value</code></td><td>Cria variável local com tipo inferido.</td></tr><tr><td><code>forge name: Type = value</code></td><td>Cria variável com tipo explicitamente declarado.</td></tr><tr><td><code>const name: Type = value</code></td><td>Declara valor constante imutável.</td></tr><tr><td><code>=, +=, -=, *=, /=</code></td><td>Atribuição simples e composta.</td></tr><tr><td><code>++ / --</code></td><td>Incremento e decremento inteiros.</td></tr></tbody></table>"
    forge operators = "<table class=\"api-table\"><thead><tr><th>Grupo</th><th>Operadores</th><th>Resultado</th></tr></thead><tbody><tr><td>Aritmética</td><td><code>+ - * / %</code></td><td>Opera números; <code>+</code> também concatena texto.</td></tr><tr><td>Comparação</td><td><code>== != &lt; &lt;= &gt; &gt;=</code></td><td>Produz <code>bool</code>.</td></tr><tr><td>Lógica</td><td><code>&amp;&amp; || !</code></td><td>Combina ou inverte condições.</td></tr><tr><td>Bits</td><td><code>&amp; | ^ &lt;&lt; &gt;&gt;</code></td><td>Opera sobre representação binária de inteiros.</td></tr><tr><td>Ponteiro</td><td><code>&amp;value *pointer</code></td><td>Obtém endereço e acessa o valor apontado em contexto de baixo nível.</td></tr><tr><td>Conversão</td><td><code>value as Type</code></td><td>Conversão explícita validada pelo verificador de tipos.</td></tr></tbody></table>"
    forge functions = site_terminal("functions.ofs", "vein square(x: stone) -> stone intent pure {\n    return x * x\n}\n\nvein apply(x: stone, fn: vein(stone) -> stone) -> stone {\n    return fn(x)\n}\n\ncore main() {\n    forge double = vein(x: stone) -> stone {\n        return x * 2\n    }\n    echo(apply(5, double))\n}")
    forge flow = site_terminal("flow.ofs", "if (score >= 10) {\n    echo(\"ok\")\n} else {\n    echo(\"retry\")\n}\n\nwhile (running) {\n    tick()\n}\n\ncycle (forge i = 0; i < 10; i++) {\n    echo(i)\n}")
    forge structures = site_terminal("point.ofs", "monolith Point {\n    x: stone\n    y: stone\n}\n\nimpl Point {\n    vein sum(self) -> stone {\n        return self.x + self.y\n    }\n}")
    forge collections = site_terminal("collections.ofs", "forge values = [10, 20, 30]\nvalues[1] = 25\n\ncycle (forge i: stone = 0; i < ofs_array_len(values); i++) {\n    echo(values[i])\n}")
    forge errors = site_terminal("errors.ofs", "vein require_positive(value: stone) -> stone {\n    if (value < 0) {\n        throw \"negative value\"\n    }\n    return value\n}\n\ncore main() {\n    tremor {\n        echo(require_positive(-1))\n    } catch (message: obsidian) {\n        echo(message)\n    }\n}")
    forge module_grid = odl.div("module-grid", module_card("attach {math}", "Importa funções da biblioteca padrão por nome.") + module_card("attach {F:path/file.ofs}", "Importa um arquivo OFS local explicitamente.") + module_card("extern vein", "Declara símbolos oferecidos pelo runtime ou por C.") + module_card("core main()", "Define o ponto de entrada do programa nativo."))
    forge body = doc_section("overview", "Modelo da linguagem", "OFS é uma linguagem compilada e estaticamente tipada. O compilador self-hosted expande imports, analisa tokens, monta AST, valida tipos e gera LLVM IR nativo. `core main()` define o ponto de entrada do executável.", "", syntax)
    body = body + doc_section("types", "Sistema de tipos", "Tipos primitivos cobrem números, texto e lógica. Inteiros com largura explícita auxiliam FFI e dados binários. Arrays armazenam elementos homogêneos, e monoliths definem registros de dados.", "", odl.div("table-wrap", types))
    body = body + doc_section("bindings", "Variáveis, constantes e atribuição", "`forge` aloca variáveis locais ou globais, com tipo inferido ou explícito. `const` expressa valores que não podem ser reatribuídos.", "", odl.div("table-wrap", bindings))
    body = body + doc_section("operators", "Operadores e conversões", "A precedência segue o padrão de linguagens modernas: aritmética antes de comparação e lógica. Conversões de tipo usam `as` de forma explícita.", "", odl.div("table-wrap", operators))
    body = body + doc_section("functions", "Funções, intents e lambdas", "`vein` declara funções nomeadas ou anônimas. Parâmetros e retornos possuem tipos explícitos. Intents como `intent pure` documentam contratos de função.", "", functions)
    body = body + doc_section("flow", "Controle de fluxo", "`if/else` controla bifurcações condicionais, `while` repete enquanto uma condição for verdadeira e `cycle` fornece laço estruturado com contador.", "", flow)
    body = body + doc_section("collections", "Arrays e indexação", "Literais de array criam coleções homogêneas indexadas a partir de zero. Leitura e escrita usam colchetes, e `ofs_array_len` retorna a quantidade de itens.", "", collections)
    body = body + doc_section("structures", "Monolith, impl, namespace e strata", "`monolith` declara o layout de dados, `impl` agrupa métodos associados, `namespace` organiza símbolos e `strata` define variantes etiquetadas.", "", structures)
    body = body + doc_section("errors", "Tremor, catch e throw", "`throw` interrompe a execução com um valor de erro. `tremor` delimita o bloco monitorado e `catch` intercepta a falha capturada.", "", errors)
    body = body + doc_section("modules", "Módulos e importação", "`attach {nome}` busca módulos da biblioteca padrão e pacotes; `attach {F:caminho}` inclui arquivos locais. `extern vein` declara chamadas externas de runtime ou C.", "", module_grid)
    forge low_modes = "<div class=\"module-grid\"><div class=\"module\"><code>fracture { ... }</code><p>Abre o contexto tipado de ponteiros. Nele, <code>shard p: *stone = &amp;x</code> cria um ponteiro e <code>*p</code> lê ou escreve o valor apontado. O compilador continua verificando os tipos, mantendo a responsabilidade de tempo de vida no código.</p></div><div class=\"module\"><code>abyss { ... }</code><p>Marca operações cruas e irrestritas. Serve como demarcação explícita no código-fonte para operações de baixo nível que assumem risco manual de memória.</p></div><div class=\"module\"><code>bedrock { ... }</code><p>Contexto tipado para intrinsics de máquina e gerenciamento direto de memória: regiões lineares, alinhamento, barreiras e funções <code>fault_*</code>.</p></div><div class=\"module\"><code>intent fractal</code><p>Qualificador de efeito posicionado na assinatura de funções para registrar intenção funcional sem alterar o parser estrutural.</p></div><div class=\"module\"><code>tectonic fracture</code><p>Prefixo sintático aceito antes de blocos de baixo nível para demarcar limites de isolamento sem alterar a geração do backend LLVM.</p></div><div class=\"module\"><code>fault_*</code><p>Intrinsics de máquina para manipulação de bits, contagem de zeros, rotações, swap de bytes, barreiras de memória e prefetch.</p></div></div>"
    forge low_example = site_terminal("low-level.ofs", "attach {bedrock}\n\ncore main() {\n    forge region: *stone = bedrock_region_new(4)\n    bedrock_region_write(region, 0, 10)\n    bedrock_region_add(region, 0, 5)\n    echo(bedrock_region_read(region, 0))\n    bedrock_region_drop(region)\n}")
    body = body + doc_section("low", "Baixo nível: ponteiros, memória e intrinsics", "Recursos de baixo nível na OFS são explícitos e opt-in. Eles permitem controle preciso de registradores e memória sem comprometer a clareza da linguagem padrão.", "", low_modes + low_example + odl.div("callout", "<strong>Regra de segurança:</strong> ponteiros e regiões manuais não possuem coleta automática; desalocações devem ocorrer exatamente uma vez através de funções apropriadas como <code>bedrock_region_drop</code>."))
    body = body + doc_section("build", "Comandos de compilação", "`check` valida sintaxe e tipos; `run` compila e executa temporariamente; `build` gera o executável nativo; `ir` emite o LLVM IR; `asm` emite assembly.", "", site_terminal("terminal", "ofs check app.ofs\nofs run app.ofs\nofs build app.ofs -o app\nofs ir app.ofs -o app.ll\nofs asm app.ofs -o app.s"))
    forge content = doc_page("Linguagem", "O núcleo técnico da Obsidian Fault Script.", toc, body)
    return page_shell("Linguagem", "O núcleo técnico da Obsidian Fault Script.", content)
}

vein page_getting_started() -> obsidian {
    forge code = "ofs check app.ofs\nofs run app.ofs\nofs build app.ofs -o app\n./app\n\nofs odl page.odl -o index.html\nofs oes site.oes -o site.css"
    forge toc = doc_link("install", "Instalação") + doc_link("native", "Programa nativo") + doc_link("web", "Site OFS")
    forge cards = site_card("1. Instalar", "Obtenha o pacote para o seu sistema operacional e use o comando `ofs`.", "")
    cards = cards + site_card("2. Criar", "Escreva lógica em .ofs, documentos em .odl e estilos visuais em .oes.", "")
    cards = cards + site_card("3. Validar", "Execute `ofs check` para verificar sintaxe e tipos antes da compilação.", "")
    forge body = doc_section("install", "Instalação", "Consulte a página de downloads para pacotes Linux, macOS, Windows e a extensão do VS Code.", "Consult the downloads page for Linux, macOS, Windows packages, and the VS Code extension.", odl.div("actions", site_button("Abrir downloads", "downloads.html", false) + site_button("Comandos CLI", "commands.html", true)))
    body = body + doc_section("native", "Primeiro executável", "Crie `app.ofs`, verifique com `check`, execute com `run` e gere um executável nativo com `build`.", "Create `app.ofs`, verify with `check`, run with `run`, and generate a native binary with `build`.", site_terminal("terminal", code))
    body = body + doc_section("web", "Primeiro documento web", "Crie `page.odl` e `site.oes`. O compilador emite HTML e CSS prontos para qualquer hospedagem estática.", "Create `page.odl` and `site.oes`. The compiler emits HTML and CSS ready for any static hosting.", odl.div("grid", cards))
    forge content = doc_page("Começando", "Da instalação ao primeiro executável e site nativo em OFS.", toc, body)
    return page_shell("Começando", "Da instalação ao primeiro executável e site nativo em OFS.", content)
}

vein page_downloads() -> obsidian {
    forge toc = doc_link("assets", "Pacotes") + doc_link("linux", "Linux") + doc_link("editor", "VS Code") + doc_link("checks", "Checksums")
    forge body = doc_section("assets", "Downloads oficiais", "Os pacotes são compilados automaticamente para cada release oficial no repositório.", "Release packages are compiled automatically for each official GitHub release.", site_release())
    body = body + doc_section("linux", "Instalação no Linux", "Debian e Ubuntu utilizam .deb, Fedora, RHEL e openSUSE utilizam .rpm e Arch/Manjaro utilizam pacman.", "Debian and Ubuntu use .deb, Fedora, RHEL, and openSUSE use .rpm, while Arch and Manjaro use pacman.", site_terminal("install", "# Debian / Ubuntu\nsudo dpkg -i ofs-debian-ubuntu-x64-installer-v*.deb\n\n# Fedora / RHEL / openSUSE\nsudo rpm -Uvh ofs-fedora-x64-installer-v*.rpm\n\n# Arch / Manjaro\nsudo pacman -U ofs-arch-x64-installer-v*.pkg.tar.zst"))
    body = body + doc_section("editor", "Extensão do VS Code", "Inclui realce de sintaxe, diagnósticos em tempo real, comandos integrados e suporte a Go Live para ODL e OES.", "Includes syntax highlighting, real-time diagnostics, integrated commands, and Go Live preview for ODL and OES.", site_terminal("extension", "code --install-extension obsidian-fault-script-*.vsix"))
    body = body + doc_section("checks", "Verificação de integridade", "Utilize o arquivo CHECKSUMS.sha256 publicado na release para conferir os arquivos baixados.", "Use the CHECKSUMS.sha256 file published with the release to verify downloaded packages.", odl.div("callout", "Todas as releases oficiais publicam hashes SHA-256 para verificação criptográfica de integridade antes da instalação."))
    forge content = doc_page("Downloads", "Instaladores oficiais, pacote para VS Code, checksums e comandos de instalação.", toc, body)
    return page_shell("Downloads", "Instaladores oficiais, pacote para VS Code, checksums e comandos de instalação.", content)
}

vein page_compiler() -> obsidian {
    forge flow = odl.div("workflow", odl.div("step", "<strong>Lexer</strong><br>Fonte para tokens.") + odl.div("step", "<strong>Parser</strong><br>Tokens para AST.") + odl.div("step", "<strong>Semântica</strong><br>Tipos e símbolos.") + odl.div("step", "<strong>LLVM</strong><br>IR e linkagem nativa."))
    forge toc = doc_link("pipeline", "Pipeline") + doc_link("self", "Self-hosted") + doc_link("artifacts", "Artefatos")
    forge body = doc_section("pipeline", "Pipeline de compilação", "O compilador processa o código-fonte, gera tokens, constrói a árvore sintática (AST), verifica tipos, emite LLVM IR e linka o runtime nativo.", "The compiler processes source code, tokenizes, constructs an AST, verifies types, emits LLVM IR, and links the native runtime.", flow + site_terminal("pipeline", "source.ofs -> tokens -> AST -> semantic check -> LLVM IR -> native binary"))
    body = body + doc_section("self", "Arquitetura self-hosted", "O compilador principal é implementado em OFS em `ofs/ofscc`. Isso permite que a linguagem evolua através do seu próprio código.", "The main compiler is written in OFS in `ofs/ofscc`. This allows the language to evolve using itself.", odl.div("callout", "O pipeline gera código intermediário LLVM em formato SSA e linka contra a biblioteca de runtime nativa da linguagem."))
    body = body + doc_section("artifacts", "Artefatos gerados", "`check` valida tipos, `ir` exibe o código LLVM IR intermediário, `asm` gera código assembly e `build` gera o executável nativo.", "`check` validates types, `ir` displays intermediate LLVM IR, `asm` emits assembly, and `build` produces the native executable.", site_terminal("commands", "ofs check app.ofs\nofs ir app.ofs\nofs asm app.ofs -o app.s\nofs build app.ofs -o app"))
    forge content = doc_page("Compilador", "O compilador self-hosted da OFS e o backend nativo LLVM.", toc, body)
    return page_shell("Compilador", "O compilador self-hosted da OFS e o backend nativo LLVM.", content)
}

vein page_odl() -> obsidian {
    forge code = "page \"OFS Web\" \"pt\"\nskin \"theme.oes\"\nflow\n  deck.topbar\n    title1 \"OFS Web\"\n    link.button \"Documentação\" \"#docs\"\n  stage#content\n    band.docs\n      mark \"## Documento ODL\\nConteúdo formatado com **Markdown**.\"\n      tile.status\n        text \"Componente estrutural reutilizável\"\n  spark \"app.js\""
    forge api = "<table class=\"api-table\"><thead><tr><th>Forma</th><th>Semântica ODL</th><th>Target web gerado</th></tr></thead><tbody><tr><td><code>page</code></td><td>Metadados, título e idioma do documento.</td><td>Documento HTML raiz.</td></tr><tr><td><code>skin</code></td><td>Vincula uma folha de efeitos OES ou CSS.</td><td>Tag link rel=stylesheet.</td></tr><tr><td><code>flow</code></td><td>Fluxo principal do documento.</td><td>Elemento body.</td></tr><tr><td><code>deck / stage / band / tile</code></td><td>Navegação, área principal, seção e bloco de conteúdo.</td><td>Tags semânticas correspondentes (nav, main, section, article).</td></tr><tr><td><code>mark</code></td><td>Bloco de Markdown compilado nativamente.</td><td>Nós semânticos de texto formatado.</td></tr><tr><td><code>component / use</code></td><td>Declaração e uso de componentes estruturais.</td><td>Templates e nós de montagem.</td></tr><tr><td><code>wire / spark / pulse</code></td><td>Scripts clássicos, módulos ES e código inline.</td><td>Tags script correspondentes.</td></tr><tr><td><code>raw</code></td><td>Escape de marcação bruta para interoperabilidade.</td><td>Conteúdo textual preservado diretamente.</td></tr><tr><td><code>studio / move</code></td><td>Ferramentas de inspeção e edição visual local.</td><td>Ativo apenas em ambiente local com ofs-studio.</td></tr></tbody></table>"
    forge toc = doc_link("identity", "Identidade") + doc_link("grammar", "Gramática") + doc_link("components", "Componentes") + doc_link("behavior", "Comportamento") + doc_link("targets", "Targets") + doc_link("api", "Referência")
    forge body = doc_section("identity", "ODL não é HTML", "ODL (Obsidian Document Language) é uma linguagem declarativa para estruturação de documentos com indentação limpa, suporte a Markdown nativo e nós semânticos. HTML é o target de compilação para navegadores, mantendo ODL como o código-fonte autoral do projeto.", "", odl.div("callout", "Arquivos .odl são a fonte oficial de documentos web no ecossistema OFS, compilados para HTML no momento do build."))
    body = body + doc_section("grammar", "Gramática e estrutura", "Cada linha define um nó estrutural, com classes opcionais via `.classe` e IDs via `#id`. A indentação determina a hierarquia de descendência dos elementos.", "", site_terminal("page.odl", code))
    body = body + doc_section("components", "Componentes ODL", "`component nome` define uma unidade estrutural reutilizável e `use nome` instancia o componente dentro da árvore do documento.", "", site_terminal("components.odl", "component notice\n  tile.notice\n    title2 \"Aviso\"\n    text \"Conteúdo reutilizável\"\n\nflow\n  use notice"))
    body = body + doc_section("behavior", "Scripts e integração", "`wire` carrega scripts JavaScript tradicionais, `spark` importa módulos ES, e `pulse` insere rotinas inline. O backend OFS pode servir o documento via HTTP nativo através de `webserver.ofs`.", "", odl.div("grid", site_card("Navegador", "`wire`, `spark` e `pulse` integram scripts.", "") + site_card("Servidor", "`webserver.ofs` provê execução HTTP nativa.", "") + site_card("Conteúdo", "`mark` processa Markdown diretamente na estrutura.", "")))
    body = body + doc_section("targets", "Formatos de distribuição", "O compilador emite arquivos HTML e CSS estáticos prontos para hospedagem no GitHub Pages, servidores Nginx, Apache ou CDNs. Os fontes originais permanecem em ODL e OES.", "", odl.div("callout", "A separação entre fonte declarativo e artefato de distribuição permite adicionar novos alvos de renderização no futuro sem alterar os documentos existentes."))
    body = body + doc_section("api", "Referência de sintaxe ODL", "A tabela detalha os nós estruturais e como eles são traduzidos para a saída web correspondente.", "", odl.div("table-wrap", api))
    forge content = doc_page("ODL", "Linguagem de documentos da OFS, independente do formato usado para hospedagem.", toc, body)
    return page_shell("ODL", "Linguagem de documentos da OFS, independente do formato usado para hospedagem.", content)
}

vein page_oes() -> obsidian {
    forge code = "gem accent: Color = #a978ff\ngem surface: Color = #120d1f\npaint .button\n  fill: $accent\n  curve: 8px\n  transition: transform .2s ease\nveil \"(max-width: 700px)\"\n  paint .grid\n    grid-cols: 1fr\npulse \"enter\"\n  rise\n    opacity: 0%\n  rest\n    opacity: 100%"
    forge api = "<table class=\"api-table\"><thead><tr><th>Forma</th><th>Semântica OES</th><th>Target web gerado</th></tr></thead><tbody><tr><td><code>gem</code></td><td>Token de design nomeado (cor, tamanho, tempo).</td><td>Variável CSS (--nome).</td></tr><tr><td><code>paint</code></td><td>Bloco de regras visuais aplicadas a seletores.</td><td>Regra de estilo com seletor CSS.</td></tr><tr><td><code>fill / ink / curve / space</code></td><td>Fundo, cor de texto, raio de borda e espaçamento.</td><td>Propriedades visuais equivalentes (background, color, border-radius, gap).</td></tr><tr><td><code>veil</code></td><td>Bloco condicional de responsividade.</td><td>Consulta de mídia (@media).</td></tr><tr><td><code>guard</code></td><td>Bloco condicional de capacidade.</td><td>Consulta de suporte (@supports).</td></tr><tr><td><code>strata</code></td><td>Camada visual explícita no sistema.</td><td>Camada de cascata (@layer).</td></tr><tr><td><code>pulse / rise / rest / atNN</code></td><td>Definição de animação por quadros-chave.</td><td>Regra @keyframes.</td></tr><tr><td><code>raw</code></td><td>Trecho de CSS direto para interoperabilidade.</td><td>Propriedade ou bloco preservado textualmente.</td></tr></tbody></table>"
    forge toc = doc_link("identity", "Identidade") + doc_link("tokens", "Tokens") + doc_link("layout", "Layout") + doc_link("motion", "Movimento") + doc_link("safety", "Segurança") + doc_link("targets", "Targets") + doc_link("api", "Referência")
    forge body = doc_section("identity", "OES não é CSS", "OES (Obsidian Effect Scripts) é uma linguagem declarativa para design systems, regras de estilo, contextos responsivos e animações. Ela é compilada para CSS padrão pelo ecossistema OFS.", "", odl.div("callout", "OES mantém a semântica de tokens, camadas e animações consistente, atuando como o código-fonte visual primário."))
    body = body + doc_section("tokens", "Gemas e tokens de estilo", "`gem` declara valores de estilo reutilizáveis. No código, `$nome` referencia o token com resolução de variáveis nativa.", "", site_terminal("tokens.oes", "gem accent: Color = #a978ff\ngem spacing: Size = 16px\n\npaint .action\n  fill: $accent\n  space: $spacing"))
    body = body + doc_section("layout", "Regras e contextos responsivos", "`paint` associa estilos a classes e elementos. `veil` encapsula regras para resoluções específicas, enquanto `guard` condiciona estilos a recursos do navegador.", "", site_terminal("theme.oes", code))
    body = body + doc_section("motion", "Animações e quadros", "`pulse` declara a animação, e `rise`, `rest` e `atNN` determinam os quadros da linha do tempo. As regras `paint` aplicam os pulsos através de propriedades de transição e animação.", "", site_terminal("motion.oes", "pulse \"enter\"\n  rise\n    opacity: 0%\n  at50\n    opacity: 60%\n  rest\n    opacity: 100%\n\npaint .panel\n  animation: enter .24s ease"))
    body = body + doc_section("safety", "Edição visual segura", "O modo Studio só é ativado em ambiente de desenvolvimento local (`localhost`) com o parâmetro `ofs-studio=1`. Ele permite ajustar propriedades visualmente sem sobrescrever código de produção.", "", odl.div("callout", "As regras geradas no modo Studio podem ser inspecionadas e revisadas como código regular antes de serem commitadas."))
    body = body + doc_section("targets", "Compilação para CSS", "O compilador converte os arquivos `.oes` para folhas de estilo `.css` otimizadas, sem dependência de pré-processadores externos.", "", "")
    body = body + doc_section("api", "Referência de sintaxe OES", "Tabela comparativa entre a linguagem OES e as regras CSS geradas na compilação.", "", odl.div("table-wrap", api))
    forge content = doc_page("OES", "Linguagem de efeitos, layout e movimento da OFS.", toc, body)
    return page_shell("OES", "Linguagem de efeitos, layout e movimento da OFS.", content)
}

vein page_playground() -> obsidian {
    forge sample = "page \"OFS Playground\" \"pt\"\nskin \"theme.css\"\nflow\n  stage.demo\n    title1 \"ODL no navegador\"\n    mark \"Escreva **documentos** sem autorar HTML manual.\"\n    link.button \"Abrir documentação\" \"odl.html\""
    forge controls = "<div class=\"tool-controls\"><select id=\"translator-mode\" aria-label=\"Direção da tradução\"><option value=\"odl-html\">ODL para HTML</option><option value=\"oes-css\">OES para CSS</option><option value=\"html-odl\">HTML para ODL</option><option value=\"css-oes\">CSS para OES</option></select><button id=\"translator-run\" class=\"btn\" type=\"button\">Traduzir</button></div>"
    forge editors = "<div class=\"tool-layout\"><div class=\"tool-pane\"><label for=\"translator-input\">Código-fonte</label><textarea id=\"translator-input\">" + sample + "</textarea></div><div class=\"tool-pane\"><label for=\"translator-output\">Artefato gerado</label><textarea id=\"translator-output\" readonly></textarea></div></div><h2>Prévia no navegador</h2><iframe id=\"translator-preview\" class=\"preview-frame\" title=\"Prévia da página gerada\" sandbox=\"allow-scripts\"></iframe>"
    forge content = odl.section("", "band", odl.div("wrap", controls + editors))
    return page_shell("Tradutor ODL/OES", "Um tradutor no navegador que acompanha o pipeline nativo das linguagens web da OFS.", content)
}

vein page_webserver() -> obsidian {
    forge code = "attach {odl}\nattach {webserver}\n\ncore main() {\n    forge body = odl.h1(\"Servidor OFS\") + odl.p(\"\", \"Resposta gerada pela linguagem\")\n    forge html = odl.document(\"pt\", \"Servidor OFS\", \"Exemplo HTTP\", \"\", body)\n    webserver.serve_html_forever(8080, html)\n}"
    forge toc = doc_link("purpose", "Funcionamento") + doc_link("constants", "Constantes") + doc_link("responses", "Respostas") + doc_link("serve", "Servidor") + doc_link("deploy", "Publicação")
    forge constants = "<table class=\"api-table\"><thead><tr><th>Grupo</th><th>Valores</th><th>Finalidade</th></tr></thead><tbody><tr><td>Métodos HTTP</td><td><code>HTTP_GET</code>, <code>HTTP_POST</code>, <code>HTTP_PUT</code>, <code>HTTP_DELETE</code>, <code>HTTP_PATCH</code></td><td>Identificação dos verbos HTTP padrão.</td></tr><tr><td>Status</td><td><code>HTTP_200</code>, <code>HTTP_201</code>, <code>HTTP_400</code>, <code>HTTP_404</code>, <code>HTTP_500</code></td><td>Códigos de resposta HTTP padrão.</td></tr><tr><td>Tipos MIME</td><td><code>MIME_JSON</code>, <code>MIME_HTML</code>, <code>MIME_TEXT</code>, <code>MIME_CSS</code>, <code>MIME_JS</code>, <code>MIME_ODL</code>, <code>MIME_OES</code></td><td>Cabeçalhos Content-Type de resposta.</td></tr></tbody></table>"
    forge api = "<table class=\"api-table\"><thead><tr><th>Função</th><th>Parâmetros</th><th>Retorno e efeito</th></tr></thead><tbody><tr><td><code>status_text</code></td><td>código</td><td>Retorna o texto padrão associado ao status HTTP.</td></tr><tr><td><code>http_response</code></td><td>status, content_type, body</td><td>Monta resposta HTTP completa com headers e corpo.</td></tr><tr><td><code>json_string</code></td><td>chave, valor</td><td>Gera um fragmento de string JSON formatado.</td></tr><tr><td><code>json_number</code></td><td>chave, número</td><td>Gera um fragmento numérico JSON formatado.</td></tr><tr><td><code>get_mime_type</code></td><td>nome de arquivo</td><td>Detecta o MIME type a partir da extensão do arquivo.</td></tr><tr><td><code>log_request</code></td><td>método, caminho, status</td><td>Exibe linha de log de requisição no terminal.</td></tr><tr><td><code>serve_once</code></td><td>porta, tipo, corpo</td><td>Atende uma única conexão HTTP e retorna.</td></tr><tr><td><code>serve_forever</code></td><td>porta, tipo, corpo</td><td>Inicia o loop contínuo de atendimento HTTP.</td></tr></tbody></table>"
    forge body = doc_section("purpose", "Servidor HTTP nativo", "O módulo `webserver.ofs` interage diretamente com as funções de socket do runtime nativo. Permite servir respostas HTML, JSON e arquivos locais sem dependências externas.", "", site_terminal("server.ofs", code))
    body = body + doc_section("constants", "Constantes e cabeçalhos", "Constantes de métodos, códigos de status e tipos MIME facilitam a escrita de servidores HTTP seguros e padronizados.", "", odl.div("table-wrap", constants))
    body = body + doc_section("responses", "Construção de respostas", "A função `http_response` gera as linhas de status HTTP, headers `Content-Type` e `Content-Length`, encerrando com o corpo da mensagem.", "", odl.div("table-wrap", api))
    body = body + doc_section("serve", "Loops de execução", "Use `serve_once` para verificações pontuais e testes automatizados. Use `serve_forever` ou `serve_html_forever` para manter o servidor ativo atendendo requisições.", "", site_terminal("json_server.ofs", "attach {webserver}\n\ncore main() {\n    forge body = \"{\" + json_string(\"language\", \"OFS\") + \",\" + json_number(\"version\", 1) + \"}\"\n    webserver.serve_forever(8080, MIME_JSON, body)\n}"))
    body = body + doc_section("deploy", "Hospedagem estática vs processo nativo", "Para documentações e sites institucionais, compile ODL e OES diretamente para HTML e CSS estáticos. Para APIs e páginas dinâmicas, execute o binário nativo compilado com `webserver.ofs`.", "", "")
    forge content = doc_page("Web Server", "Servidor HTTP nativo a partir de um executável OFS.", toc, body)
    return page_shell("Web Server", "Servidor HTTP nativo a partir de um executável OFS.", content)
}

vein page_webui() -> obsidian {
    forge code = "attach {webui}\n\ncore main() {\n    forge body = webui.nav(\"OFS\", webui.button(\"Docs\", \"#docs\"))\n    body = body + webui.grid(webui.card(\"ODL\", \"Documentos\") + webui.card(\"OES\", \"Efeitos\"))\n    webui.serve(8080, \"OFS Web\", body)\n}"
    forge toc = doc_link("theme", "Tema") + doc_link("components", "Componentes") + doc_link("composition", "Composição") + doc_link("live", "Go Live")
    forge api = "<table class=\"api-table\"><thead><tr><th>Função</th><th>Descrição do componente</th></tr></thead><tbody><tr><td><code>theme_dark / theme_light</code></td><td>Estrutura WebTheme com paleta de cores, tipografia, bordas e espaçamentos.</td></tr><tr><td><code>stylesheet</code></td><td>Gera o bloco CSS baseado na configuração do tema ativo.</td></tr><tr><td><code>page</code></td><td>Gera o documento HTML completo com viewport e folha de estilo embutida.</td></tr><tr><td><code>nav</code></td><td>Barra de navegação superior com logotipo e links.</td></tr><tr><td><code>hero</code></td><td>Seção de destaque com título, texto de apoio e botões de chamada.</td></tr><tr><td><code>button</code></td><td>Botão de ação estilizado com link de navegação.</td></tr><tr><td><code>panel / grid / card / stack</code></td><td>Contêineres estruturais para layout em grade e colunas flexíveis.</td></tr><tr><td><code>serve</code></td><td>Constrói a página e inicia o servidor HTTP nativo.</td></tr></tbody></table>"
    forge body = doc_section("theme", "Configuração de WebTheme", "`WebTheme` centraliza definições de paleta de cores (`bg`, `surface`, `text`, `accent`), bordas e espaçamentos. Alterações no tema refletem diretamente na folha de estilo emitida.", "", site_terminal("theme.ofs", "forge theme = webui.theme_light()\ntheme.accent = \"#a978ff\"\ntheme.radius = 4"))
    body = body + doc_section("components", "Componentes reutilizáveis", "As funções do módulo `webui` retornam strings `obsidian`, permitindo composição funcional direta sem estados ocultos.", "", odl.div("table-wrap", api))
    body = body + doc_section("composition", "Composição de páginas", "O exemplo abaixo demonstra a criação de uma barra de navegação, seção de destaque e grade de cartões atendidos via servidor nativo.", "", site_terminal("webui.ofs", code))
    body = body + doc_section("live", "Recarga automática com Go Live", "A extensão do VS Code reconhece arquivos com `attach {webui}`, compila o projeto nativo e abre o servidor com recarga automática durante edições.", "", "")
    forge content = doc_page("Web UI", "A camada de componentes sobre ODL, OES e o servidor web nativo.", toc, body)
    return page_shell("Web UI", "A camada de componentes sobre ODL, OES e o servidor web nativo.", content)
}

vein page_stdlib() -> obsidian {
    forge toc = doc_link("base", "Núcleo") + doc_link("web", "Web") + doc_link("native-ui", "UI Nativa") + doc_link("system", "Sistema") + doc_link("testing", "Testes")
    forge base_modules = odl.div("module-grid",
        module_card("math.ofs", "Funções numéricas em OFS puro: `square`, `cube`, `sum_range`, `is_prime`, `count_digits`, `sum_digits`, `reverse_number` e `is_palindrome_number`.")
        + module_card("string.ofs", "Utilitários sobre o runtime de strings: `repeat_str`, `starts_with_char` e `is_empty` para manipulação de texto.")
        + module_card("io.ofs", "Entrada e saída em terminal: `prompt`, `print_separator` e `print_header` para CLIs e ferramentas de console.")
        + module_card("terminal_colors.ofs", "Constantes ANSI e funções de formatação para saída de texto colorido no terminal."))
    forge web_modules = odl.div("module-grid",
        module_card("odl.ofs", "Construtor de documentos e nós semânticos para geração de HTML a partir de funções tipadas em OFS.")
        + module_card("oes.ofs", "Construtor de regras visuais, media queries, variáveis de estilo, keyframes e animações.")
        + module_card("webserver.ofs", "Servidor HTTP nativo com constantes de protocolo, montagem de respostas e detecção de tipos MIME.")
        + module_card("webui.ofs", "Biblioteca de temas e componentes visuais prontos para composição de páginas web completas."))
    forge ui_modules = odl.div("module-grid",
        module_card("canvas.ofs", "API experimental de desenho 2D em buffer de pixels nativo (pontos, linhas, retângulos e formas).")
        + module_card("window.ofs", "Controle de ciclo de vida de janelas nativas e recepção de eventos de entrada.")
        + module_card("ui.ofs", "Primitivas de interface de modo imediato para texto, caixas e medições.")
        + module_card("ofshtml.ofs", "Helpers legados de HTML mantidos para compatibilidade com versões anteriores."))
    forge system_modules = odl.div("module-grid",
        module_card("bedrock.ofs", "Primitivas de baixo nível para alocação direta de memória, regiões lineares e ponteiros manuais.")
        + module_card("bedrock_packet.ofs", "Estruturas de pacote binário para comunicação e protocolos de rede.")
        + module_card("memory_modes.ofs", "Definições e testes dos modos explícitos de gerenciamento de memória da linguagem.")
        + module_card("rift.ofs", "Superfície de interoperabilidade FFI com código nativo e bibliotecas compiladas em C."))
    forge testing_modules = odl.div("module-grid",
        module_card("core.ofs", "Módulo de convenções fundamentais e definições de tipos centrais.")
        + module_card("test_lib.ofs", "Estrutura auxiliar de asserções para suítes de testes automatizados da linguagem.")
        + module_card("attach {F:...}", "Sintaxe para importação direta de arquivos por caminho relativo ou absoluto.")
        + module_card("attach {nome}", "Sintaxe para importação de módulos instalados ou membros da biblioteca padrão."))
    forge body = doc_section("base", "Módulos de núcleo", "Os módulos fundamentais cobrem operações matemáticas, texto, entrada/saída de dados e terminal, disponíveis para qualquer executável OFS.", "", base_modules + site_terminal("base.ofs", "attach {math}\nattach {string}\nattach {io}\n\ncore main() {\n    print_header(\"Demo\")\n    echo(square(9))\n    echo(repeat_str(\"OFS\", 2))\n}"))
    body = body + doc_section("web", "Módulos para web", "A biblioteca padrão inclui suporte nativo à stack web através de ODL, OES, webserver e webui sem dependências de pacotes externos.", "", web_modules + site_terminal("site.ofs", "attach {odl}\nattach {oes}\nattach {webserver}\n\ncore main() {\n    forge page = odl.document(\"pt\", \"Site\", \"feito em OFS\", odl.css(\"site.css\"), odl.h1(\"OFS Web\"))\n    webserver.serve_html_forever(8080, page)\n}"))
    body = body + doc_section("native-ui", "Interfaces nativas e desenho", "Módulos dedicados à criação de janelas, renderização gráfica 2D direta e interfaces imediatas no sistema operacional.", "", ui_modules)
    body = body + doc_section("system", "Sistema, baixo nível e FFI", "Camadas avançadas para acesso direto à memória e integração com bibliotecas C através do sistema FFI.", "", system_modules)
    body = body + doc_section("testing", "Testes e módulos", "Estruturas de convenção para organização de módulos, suítes de verificação e testes automatizados.", "", testing_modules)
    forge content = doc_page("Biblioteca Padrão", "Módulos distribuídos com o compilador e instaladores OFS.", toc, body)
    return page_shell("Biblioteca Padrão", "Módulos distribuídos com o compilador e instaladores OFS.", content)
}

vein page_packages() -> obsidian {
    forge code = "bash src/packages/install_library.sh odl\nbash src/packages/install_library.sh oes\nbash src/packages/build_packages.sh"
    forge toc = doc_link("registry", "Registro") + doc_link("install", "Instalação") + doc_link("publish", "Publicação")
    forge body = doc_section("registry", "Registro de pacotes", "`src/packages/registry.json` cataloga bibliotecas OFS publicadas e seus canais de distribuição.", "`src/packages/registry.json` indexes published OFS libraries and their release channels.", odl.div("grid", site_card("Registro", "Nome, versão, URL e checksum.", "") + site_card("Artefatos", "Arquivos versionados para reprodução exata.", "") + site_card("Canais", "Canais alpha, stable e latest.", "")))
    body = body + doc_section("install", "Instalação", "O instalador posiciona as bibliotecas no diretório acessível pelo launcher do compilador e extensão.", "The installer places libraries into the directory accessed by the compiler launcher and extension.", site_terminal("src/packages", code))
    body = body + doc_section("publish", "Publicação", "Pacotes publicados possuem nome, versão, URL e hash criptográfico SHA-256 para verificação.", "Published packages specify name, version, URL, and a SHA-256 cryptographic hash.", odl.div("callout", "O formato de pacotes OFS é padronizado e gerenciado pelas ferramentas integradas do ecossistema."))
    forge content = doc_page("Pacotes", "Instale, compile, publique e versione bibliotecas OFS.", toc, body)
    return page_shell("Pacotes", "Instale, compile, publique e versione bibliotecas OFS.", content)
}

vein page_vscode() -> obsidian {
    forge toc = doc_link("features", "Recursos") + doc_link("live", "Go Live") + doc_link("settings", "Configuração")
    forge body = doc_section("features", "Recursos da extensão", "Suporte completo para arquivos `.ofs`, `.odl` e `.oes` com gramáticas TextMate, diagnósticos e comandos do compilador.", "Full support for `.ofs`, `.odl`, and `.oes` files with TextMate grammars, diagnostics, and integrated compiler commands.", odl.div("grid", site_card("Sintaxe", "Realce de sintaxe para OFS, ODL e OES.", "") + site_card("Comandos", "Build, run, check, IR, assembly e tradutor.", "") + site_card("Diagnósticos", "Erros de compilação exibidos no painel Problems.", "")))
    body = body + doc_section("live", "Go Live integrado", "Arquivos `.odl` são visualizados diretamente no navegador com servidor local e recarga automática em alterações.", "Files with `.odl` extension are previewed in the browser with local HTTP serving and live reload.", odl.div("callout", "O servidor interno detecta modificações em fontes ODL, OES e assets e atualiza a exibição automaticamente."))
    body = body + doc_section("settings", "Configurações", "Permite definir a porta do servidor de desenvolvimento e o executável customizado do compilador.", "Configure the development server port and custom compiler executable path.", site_terminal("settings.json", "\"ofs.goLivePort\": 8080\n\"ofs.compilerPath\": \"ofs/dist/ofs\""))
    forge content = doc_page("VS Code", "Suporte de linguagem, diagnósticos, comandos, snippets e Go Live.", toc, body)
    return page_shell("VS Code", "Suporte de linguagem, diagnósticos, comandos, snippets e Go Live.", content)
}

vein page_github() -> obsidian {
    forge toc = doc_link("local", "Local") + doc_link("global", "Global") + doc_link("pages", "Pages")
    forge body = doc_section("local", "Reconhecimento no repositório", "O arquivo `.gitattributes` mapeia as extensões `.ofs`, `.odl` e `.oes` para as definições de linguagem do projeto.", "The `.gitattributes` file maps `.ofs`, `.odl`, and `.oes` extensions to project language definitions.", odl.div("grid", site_card("OFS", "*.ofs linguist-language=OFS.", "") + site_card("ODL", "*.odl linguist-language=ODL.", "") + site_card("OES", "*.oes linguist-language=OES.", "")))
    body = body + doc_section("global", "GitHub Linguist", "Para reconhecimento nativo em todos os repositórios, a linguagem utiliza as definições do Linguist com gramática, escopo e cores.", "For global recognition, the language specifies Linguist definitions with grammar, scope, and colors.", site_terminal("languages.yml", "OFS:\n  type: programming\n  color: \"#2A0845\"\n  extensions:\n    - \".ofs\"\n  tm_scope: source.ofs\nODL:\n  type: markup\n  extensions:\n    - \".odl\"\nOES:\n  type: markup\n  extensions:\n    - \".oes\""))
    body = body + doc_section("pages", "Publicação no GitHub Pages", "O GitHub Pages hospeda diretamente os artefatos compilados HTML, CSS e JavaScript gerados no diretório `docs/`.", "GitHub Pages directly serves the compiled HTML, CSS, and JavaScript artifacts output in `docs/`.", odl.div("callout", "A fonte canônica permanece em arquivos .odl e .oes; os arquivos HTML e CSS são os artefatos de entrega."))
    forge content = doc_page("Reconhecimento GitHub", "Como detecção de fonte e syntax highlighting são registrados.", toc, body)
    return page_shell("Reconhecimento GitHub", "Como detecção de fonte e syntax highlighting são registrados.", content)
}

vein page_web() -> obsidian {
    forge flow = odl.div("workflow", odl.div("step", "<strong>1. ODL</strong><br>Declare estrutura de documento em OFS.") + odl.div("step", "<strong>2. OES</strong><br>Gere tokens, regras e animação.") + odl.div("step", "<strong>3. Webserver</strong><br>Sirva a saída gerada localmente.") + odl.div("step", "<strong>4. Pages</strong><br>Publique os artefatos gerados."))
    forge code = "attach {odl}\nattach {oes}\n\nvein page() -> obsidian {\n    return odl.document(\"pt\", \"Site\", \"feito em OFS\", \"\", odl.h1(\"OFS Web\"))\n}"
    forge toc = doc_link("stack", "Stack") + doc_link("hosting", "Hospedagem") + doc_link("backend", "Backend") + doc_link("interop", "Interoperabilidade")
    forge body = doc_section("stack", "A stack web da OFS", "A arquitetura separa lógica nativa em OFS, estrutura em ODL, estilos em OES e servidor HTTP em `webserver.ofs`.", "The architecture separates native logic in OFS, structure in ODL, styles in OES, and HTTP serving in `webserver.ofs`.", flow + site_terminal("odl.ofs", code))
    body = body + doc_section("hosting", "Compilação para navegadores", "Navegadores executam HTML, CSS e JavaScript padrão. O compilador traduz as fontes ODL e OES para esses formatos.", "Browsers execute standard HTML, CSS, and JavaScript. The compiler translates ODL and OES sources to these formats.", odl.div("callout", "Fontes ODL e OES podem ser servidos para ferramentas de desenvolvimento enquanto navegadores processam os artefatos compilados."))
    body = body + doc_section("backend", "Backend desacoplado", "O módulo `webserver.ofs` executa como processo nativo, gerenciando requisições, cabeçalhos e fluxos de dados sem misturar lógica de negócio na marcação.", "", odl.div("grid", site_card("Lógica", ".ofs para processos e dados.", "") + site_card("Documento", ".odl para estrutura semântica.", "") + site_card("Estilos", ".oes para tokens e movimento.", "")))
    body = body + doc_section("interop", "Interoperabilidade web", "ODL oferece suporte integrado a Markdown, scripts modulares e marcação bruta quando necessária para migrações.", "ODL provides integrated support for Markdown, modular scripts, and raw markup when needed for migrations.", "")
    forge content = doc_page("Web", "ODL, OES, backend OFS e targets de navegador.", toc, body)
    return page_shell("Web", "ODL, OES, backend OFS e targets de navegador.", content)
}

vein page_frontend() -> obsidian {
    forge toc = doc_link("position", "Posição") + doc_link("comparison", "Comparação") + doc_link("missing", "Evolução") + doc_link("runtime", "Runtime") + doc_link("build", "Build")
    forge table = "<table class=\"api-table\"><thead><tr><th>Sistema</th><th>Fonte principal</th><th>Execução</th><th>O que ODL/OES cobrem hoje</th><th>Evolução futura</th></tr></thead><tbody><tr><td>HTML/CSS</td><td>Marcação e folha de estilo do navegador.</td><td>Navegador executa diretamente.</td><td>ODL/OES compilam para artefatos aceitos pelo navegador.</td><td>Mecanismo nativo direto sem transpilação.</td></tr><tr><td>React</td><td>Componentes JS/TS com estado.</td><td>Runtime JS e hidratação.</td><td>Componentes por funções OFS/ODL, scripts via <code>spark</code> e servidor OFS.</td><td>Estado reativo tipado e reconciliação nativa.</td></tr><tr><td>Vue/Svelte</td><td>Componentes compilados com template.</td><td>Runtime pequeno ou output compilado.</td><td>ODL oferece fonte declarativa e OES separa efeitos.</td><td>Compilador de componentes com escopo de estado.</td></tr><tr><td>TypeScript</td><td>JS tipado no build.</td><td>JS emitido.</td><td>OFS cobre tipagem estática no lado nativo e pode emitir/usar JS via <code>spark</code>.</td><td>Target nativo completo para ecossistemas JS.</td></tr><tr><td>Node.js</td><td>JavaScript no servidor.</td><td>V8 + bibliotecas Node.</td><td><code>webserver.ofs</code> cobre servidor HTTP simples e lógica nativa em código de máquina.</td><td>Roteador dinâmico avançado e middlewares.</td></tr><tr><td>PHP</td><td>Template executado no servidor.</td><td>Interpretador PHP.</td><td><code>server</code>/<code>raw</code> preservam blocos para interoperabilidade.</td><td>Mecanismo de templates com filtros e escopo dinâmico.</td></tr></tbody></table>"
    forge position = odl.div("module-grid", module_card("Código-fonte", "O autor escreve .odl e .oes. Esses arquivos constituem o código-fonte canônico.") + module_card("Target", "HTML, CSS e JS são emitidos para compatibilidade total com navegadores atuais.") + module_card("Servidor", "Nginx, GitHub Pages ou webserver.ofs servem os artefatos estáticos ou dinâmicos.") + module_card("Inspeção", "Arquivos ODL e OES podem ser servidos com seus tipos MIME próprios para tooling."))
    forge missing = odl.div("module-grid", module_card("Componentes tipados", "Adição de propriedades com verificação de contrato estático entre componentes.") + module_card("Hidratação", "Geração de pontos de montagem para comportamento reativo sem perda de estrutura.") + module_card("Roteamento", "Mapeamento declarativo de rotas ODL e endpoints nativos em um único arquivo.") + module_card("Build incremental", "Recompilação focada em módulos alterados para máxima velocidade de ciclo de vida."))
    forge runtime = site_terminal("site.ofs", "attach {odl}\nattach {oes}\nattach {webserver}\n\ncore main() {\n    forge head = odl.css(\"site.css\")\n    forge body = odl.main(\"app\", odl.h1(\"Documento ODL\"))\n    forge html = odl.document(\"pt\", \"OFS\", \"site\", head, body)\n    webserver.serve_html_forever(8080, html)\n}")
    forge build = site_terminal("build", "ofs odl page.odl -o index.html\nofs oes theme.oes -o site.css\nofs translate legacy.html --to odl\nofs translate legacy.css --to oes")
    forge body = doc_section("position", "Posição técnica", "ODL e OES foram criadas para que a linguagem OFS possua linguagens web próprias e integradas, compilando para os padrões abertos da web.", "", position)
    body = body + doc_section("comparison", "Comparação com stacks de desenvolvimento", "Comparativo técnico de responsabilidades e escopo entre as abordagens consolidadas e o modelo OFS.", "", odl.div("table-wrap", table))
    body = body + doc_section("missing", "Roteiro de evolução técnica", "Áreas em desenvolvimento no compilador para suporte a componentes com estado, roteamento e hidratação.", "", missing)
    body = body + doc_section("runtime", "Execução atual", "A linguagem permite gerar páginas estáticas ou executar como servidor HTTP nativo compilado.", "", runtime)
    body = body + doc_section("build", "Tradução e interoperabilidade", "Comandos de conversão que auxiliam a migração de bases legadas HTML e CSS para ODL e OES.", "", build)
    forge content = doc_page("Comparação Frontend", "ODL/OES comparados com HTML/CSS, React, Vue, Svelte, TypeScript, Node e PHP.", toc, body)
    return page_shell("Comparação Frontend", "ODL/OES comparados com HTML/CSS, React, Vue, Svelte, TypeScript, Node e PHP.", content)
}

vein page_commands() -> obsidian {
    forge code = "ofs check app.ofs\nofs run app.ofs\nofs build app.ofs -o app\nofs odl page.odl -o index.html\nofs oes theme.oes -o theme.css\nofs translate legacy.html --to odl\nofs translate legacy.css --to oes"
    forge toc = doc_link("native", "Nativo") + doc_link("web", "Web") + doc_link("translate", "Tradutor")
    forge table = "<table class=\"api-table\"><thead><tr><th>Comando</th><th>Finalidade</th></tr></thead><tbody><tr><td><code>check</code></td><td>Valida sintaxe e faz verificação estática de tipos.</td></tr><tr><td><code>run</code></td><td>Compila temporariamente e executa o programa imediatamente.</td></tr><tr><td><code>build</code></td><td>Compila o arquivo-fonte para um executável nativo.</td></tr><tr><td><code>ir</code></td><td>Emite o código intermediário LLVM IR gerado.</td></tr><tr><td><code>asm</code></td><td>Emite o código assembly nativo do arquivo.</td></tr><tr><td><code>odl</code></td><td>Compila arquivos .odl para documentos HTML estruturados.</td></tr><tr><td><code>oes</code></td><td>Compila arquivos .oes para folhas de estilo CSS.</td></tr><tr><td><code>translate</code></td><td>Traduz arquivos HTML e CSS para sintaxe ODL e OES.</td></tr></tbody></table>"
    forge body = doc_section("native", "Comandos do compilador nativo", "Comandos do CLI oficial para validação, inspeção e compilação de código OFS.", "Official CLI commands for validation, inspection, and compilation of OFS code.", site_terminal("commands", code))
    body = body + doc_section("web", "Comandos das linguagens web", "`odl` e `oes` compilam documentos estruturais e estilos para a web padrão.", "`odl` and `oes` compile structural documents and styles to standard web formats.", odl.div("table-wrap", table))
    body = body + doc_section("translate", "Tradutor de código web", "Auxilia a conversão de arquivos legados HTML e CSS para a sintaxe ODL e OES.", "Assists in converting legacy HTML and CSS into ODL and OES syntax.", odl.div("callout", "O tradutor agiliza a migração inicial de componentes e páginas para a sintaxe da OFS."))
    forge content = doc_page("Comandos", "Comandos do compilador e ferramentas do ecossistema OFS.", toc, body)
    return page_shell("Comandos", "Comandos do compilador e ferramentas do ecossistema OFS.", content)
}

vein page_design() -> obsidian {
    forge toc = doc_link("tokens", "Tokens") + doc_link("components", "Componentes") + doc_link("motion", "Movimento")
    forge body = doc_section("tokens", "Design tokens em OES", "OES expressa tokens de cor, espaçamento, tipografia e transições de forma declarativa e versionável.", "OES expresses tokens of color, spacing, typography, and transitions declaratively.", site_terminal("design.oes", "gem accent \"#a978ff\"\npaint .btn\n  fill \"$accent\"\n  curve \"8px\""))
    body = body + doc_section("components", "Componentes funcionais", "As páginas do site são construídas a partir de funções OFS que retornam marcação ODL estruturada.", "The site pages are constructed from OFS functions returning structured ODL markup.", odl.div("grid", site_card("Clareza", "Design focado em conteúdo técnico objetivo e legível.", "") + site_card("Responsivo", "Layouts flexíveis com adaptação fluida para dispositivos móveis.", "") + site_card("Acessível", "Contraste adequado e hierarquia semântica rigorosa.", "")))
    body = body + doc_section("motion", "Diretrizes de movimento", "Animações discretas em transições de elementos e gráficos de medições técnicas.", "Restrained animations in element transitions and benchmark charts.", odl.div("callout", "As transições visuais têm como objetivo aprimorar a legibilidade das informações técnicas."))
    forge content = doc_page("Design System", "Como o site oficial é estruturado sem autorar CSS puro como fonte.", toc, body)
    return page_shell("Design System", "Como o site oficial é estruturado sem autorar CSS puro como fonte.", content)
}

vein page_oll() -> obsidian {
    forge toc = doc_link("modes", "Modos visuais") + doc_link("oll", "Sintaxe OLL") + doc_link("run", "Execução") + doc_link("caps", "Recursos")
    forge imm_code = "attach {ui}\n\ncore main() {\n    forge cv = canvas.create(96, 64)\n    forge style = ui.dark()\n    forge btn = ui.rect(12, 14, 22, 16)\n    window.create(\"OFS UI\", 96, 64)\n    while (window.poll()) {\n        canvas.clear(cv, style.bg)\n        ui.draw_button(cv, btn, style, false, false)\n        ui.draw_text(cv, 12, 36, \"OFS\", style.text, 1)\n        canvas.present(cv)\n    }\n    window.destroy()\n    canvas.destroy(cv)\n}"
    forge decl_code = "window \"Painel\" {\n    width: 640\n    height: 480\n    bg_color: #1e1e2e\n    padding: 24\n\n    column {\n        gap: 16\n        header \"Monitor\" { fg_color: #cba6f7 }\n        card {\n            bg_color: #313244\n            border_color: #45475a\n            padding: 16\n            row {\n                label \"CPU\" { fg_color: #89b4fa }\n                badge \"45%\" { fg_color: #a6e3a1 }\n            }\n            progress { value: 45 bg_color: #45475a fg_color: #a6e3a1 }\n        }\n        row {\n            gap: 12\n            button \"Atualizar\" { bg_color: #89b4fa fg_color: #11111b on_click: \"refresh\" }\n            button \"Fechar\" { bg_color: #f38ba8 fg_color: #11111b on_click: \"close\" }\n        }\n    }\n}"
    forge run_code = "ofs-ui arquivo.oll\n\nofs ui arquivo.oll -o preview.ppm"
    forge modes = odl.div("grid", site_card("Modo imediato", "Renderização direta sobre buffers de pixel via `canvas`, `window` e `ui`. Controle total do loop de eventos.", "") + site_card("Modo declarativo (OLL)", "Árvore hierárquica de componentes definida em `.oll`. Taxa de quadros gerida pelo runtime.", ""))
    forge caps = odl.div("module-grid",
        module_card("window, column, row", "Nós de layout: janela raiz, empilhamento vertical e horizontal.")
        + module_card("card, header, badge", "Contenedor com borda, título de seção e etiqueta de valor.")
        + module_card("button, label, input", "Controles interativos com estado: idle, hover, active, disabled.")
        + module_card("progress, checkbox", "Barra de progresso e caixa de seleção com valor numérico."))
    forge body = doc_section("modes", "Modos visuais nativos", "O OFS disponibiliza dois modos de UI nativa: imediato, com controle procedural do loop; e declarativo, com arquivo OLL que descreve a hierarquia de componentes.", "", modes)
    body = body + doc_section("oll", "OLL — Obsidian Layout Language", "Arquivo `.oll` descreve a árvore de interface. O runtime interpreta e renderiza em janela X11 ou Win32 com taxa de quadros estável.", "", site_terminal("painel.oll", decl_code))
    body = body + doc_section("run", "Execução", "Use `ofs-ui` para abrir a janela interativa ou `ofs ui ... -o preview.ppm` para exportar um raster estático.", "", site_terminal("run", run_code))
    body = body + doc_section("caps", "Recursos suportados", "Conjunto de nós, estilos e capacidades disponíveis no runtime OLL atual.", "", caps)
    forge content = doc_page("OLL", "Obsidian Layout Language: UI declarativa nativa para janelas OFS.", toc, body)
    return page_shell("OLL", "Obsidian Layout Language: UI declarativa nativa para janelas OFS.", content)
}

vein page_benchmark() -> obsidian {
    forge summary = "<div class=\"metric-summary\"><div class=\"metric-stat\"><strong>5 medições</strong><span>CPU, RSS e build</span></div><div class=\"metric-stat\"><strong>15 medições</strong><span>Inicialização do processo</span></div><div class=\"metric-stat\"><strong>wait4</strong><span>Medição real de processo SO</span></div><div class=\"metric-stat\"><strong>checksum</strong><span>Validação estrita de saída</span></div></div>"
    forge toc = doc_link("method", "Método") + doc_link("metrics", "Métricas") + doc_link("results", "Resultados") + doc_link("web-bench", "Web") + doc_link("limits", "Interpretação")
    forge metrics = "<table class=\"api-table\"><thead><tr><th>Métrica</th><th>O que o executor mede</th><th>Limitações da medição</th></tr></thead><tbody><tr><td>CPU</td><td>Tempo de execução do workload específico após início do programa.</td><td>Não mede tempo de desenvolvimento ou dependências de terceiros.</td></tr><tr><td>Memória</td><td>Pico de memória residente (RSS) observado pelo processo no SO.</td><td>Não segmenta alocações de heap, pilha ou páginas compartilhadas.</td></tr><tr><td>Inicialização</td><td>Tempo total para iniciar e finalizar um processo mínimo.</td><td>Não se aplica ao comportamento de serviços de longa duração.</td></tr><tr><td>Compilador OFS</td><td>Tempo do compilador self-hosted até a emissão do LLVM IR.</td><td>Não inclui otimização e geração de código de máquina do linker.</td></tr><tr><td>Build completo</td><td>Tempo total incluindo frontend OFS, otimizações e linkagem nativa.</td><td>Não contabiliza caches de build de ambientes de desenvolvimento.</td></tr><tr><td>Artefato</td><td>Tamanho em bytes do executável binário final gerado.</td><td>Não inclui bibliotecas dinâmicas do sistema operacional.</td></tr></tbody></table>"
    forge body = doc_section("method", "Metodologia dos testes", "O script de benchmark compila cada implementação, executa processos reais no sistema, valida a exatidão das respostas e calcula a mediana estatística.", "", summary)
    body = body + doc_section("metrics", "Significado das métricas", "Cada métrica avalia uma característica distinta do sistema: velocidade computacional, consumo de memória, tempo de bootstrap e tamanho de binário.", "", odl.div("table-wrap", metrics))
    body = body + doc_section("results", "Resultados medidos", "Os dados são carregados a partir do arquivo `benchmark.json` gerado pelo conjunto de testes em `src/site/benchmarks`.", "", site_benchmark())
    body = body + doc_section("web-bench", "Benchmark da stack web", "Medições do tempo de emissão dos arquivos HTML e CSS gerados a partir de ODL e OES no exemplo `ofs/examples/native_site`.", "", "<div class=\"table-wrap\"><table class=\"api-table\"><thead><tr><th>Etapa</th><th>Mediana</th><th>Tamanho do artefato</th></tr></thead><tbody id=\"web-benchmark-rows\"></tbody></table></div>")
    body = body + doc_section("limits", "Como interpretar os dados", "Resultados dependem do hardware, sistema operacional e configurações de compilação. Medições pontuais refletem o workload testado, não afirmações universais de velocidade.", "", odl.div("callout", "As medições são executadas em ambientes controlados e acompanhadas das informações de máquina e data de geração."))
    forge content = doc_page("Benchmark", "Medições reproduzíveis de CPU, memória, inicialização, compilação e tamanho de artefato.", toc, body)
    return page_shell("Benchmark", "Medições reproduzíveis de CPU, memória, inicialização, compilação e tamanho de artefato.", content)
}

vein page_nav_en() -> obsidian {
    forge brand = odl.a("brand", "../index.html", odl.img("../ofs-256.png", "OFS logo") + odl.span("", "OFS"))
    forge tools = odl.div("nav-tools", site_language_select("en", "../index.html", "index.html", "../es/index.html") + site_search("Search"))
    forge links = odl.div("links", "<a href=\"language.html\">Language</a><a href=\"odl.html\">ODL</a><a href=\"oes.html\">OES</a><a href=\"web.html\">Web</a><a href=\"downloads.html\">Downloads</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein page_shell_en(title: obsidian, subtitle: obsidian, content: obsidian) -> obsidian {
    forge head = odl.icon("../ofs-256.png") + odl.css("../site.css")
    forge hero = odl.section("", "band", odl.div("wrap", odl.h1(title) + odl.p("lead", subtitle)))
    forge body = page_nav_en() + odl.main("top", hero + content) + odl.footer("footer", "<div class=\"wrap\">Generated by ODL and OES in OFS.</div>") + odl.script("../site.js")
    return odl.document("en", title + " - OFS", subtitle, head, body)
}

vein doc_toc_en(items: obsidian) -> obsidian {
    return "<aside class=\"toc\">" + odl.strong("On this page") + items + "</aside>"
}

vein doc_section_en(id: obsidian, title: obsidian, text: obsidian, extra: obsidian) -> obsidian {
    return odl.section(id, "doc-section", odl.h2(title) + odl.div("doc-intro", odl.p("", text)) + extra)
}

vein doc_page_en(title: obsidian, subtitle: obsidian, toc: obsidian, body: obsidian) -> obsidian {
    return odl.section("", "band", odl.div("wrap doc-layout", doc_toc_en(toc) + odl.div("doc-main", body)))
}

vein page_en_index() -> obsidian {
    forge links = site_doc_link("language.html", "Language", "Syntax, types, modules, compiler modes, and program structure.")
    links = links + site_doc_link("odl.html", "ODL", "The OFS document language for browser documents.")
    links = links + site_doc_link("oes.html", "OES", "The OFS effect language for visual rules and motion.")
    links = links + site_doc_link("web.html", "Web stack", "How OFS, ODL, OES, webui, and webserver work together.")
    links = links + site_doc_link("oll.html", "OLL", "Obsidian Layout Language: declarative native UI with window, canvas, and components.")
    links = links + site_doc_link("stdlib.html", "Standard library", "Modules shipped with the compiler and installers.")
    links = links + site_doc_link("downloads.html", "Downloads", "Installers, VS Code package, and checksums.")
    links = links + site_doc_link("../benchmark.html", "Performance", "Measured CPU, memory, startup, compiler, build, and web output.")
    forge content = odl.section("", "band", odl.div("wrap", site_section_head("", "Documentation", "", "Technical documentation for the OFS language and its web stack.") + odl.div("docs-list", links)))
    return page_shell_en("OFS Documentation", "English documentation pages for Obsidian Fault Script.", content)
}

vein page_language_en() -> obsidian {
    forge toc = doc_link("overview", "Overview") + doc_link("syntax", "Syntax") + doc_link("types", "Types") + doc_link("modules", "Modules") + doc_link("low", "Low level")
    forge syntax = site_terminal("hello.ofs", "vein add(a: stone, b: stone) -> stone {\n    return a + b\n}\n\ncore main() {\n    forge result: stone = add(20, 2)\n    echo(result)\n}")
    forge modules = odl.div("module-grid", module_card("attach {math}", "Import a standard library module.") + module_card("attach {F:path/file.ofs}", "Import a local OFS file explicitly.") + module_card("extern vein", "Declare runtime or C symbols.") + module_card("core main()", "Define the native entry point."))
    forge body = doc_section_en("overview", "What OFS is", "OFS is a self-hosted compiled language. The compiler is written in OFS, emits LLVM IR, and links against a native runtime.", "")
    body = body + doc_section_en("syntax", "Syntax", "Programs use `vein` functions, `forge` bindings, explicit returns, and `core main()` as the entry point.", syntax)
    body = body + doc_section_en("types", "Types", "The base types include `stone`, `crystal`, `obsidian`, `bool`, integer widths, arrays, and `monolith` structures.", "<div class=\"pill-row\"><span class=\"pill\">stone</span><span class=\"pill\">crystal</span><span class=\"pill\">obsidian</span><span class=\"pill\">bool</span><span class=\"pill\">arrays</span><span class=\"pill\">monolith</span></div>")
    body = body + doc_section_en("modules", "Modules", "Libraries are attached with `attach`, keeping native code, standard library modules, and web DSLs in the same model.", modules)
    forge low = odl.div("module-grid", module_card("fracture { ... }", "Typed pointer context. Pointer element types are checked, while address validity and lifetime remain the program's responsibility.") + module_card("abyss { ... }", "Explicit raw-work boundary. It does not disable the current parser or type checker and adds no memory-safety guarantee.") + module_card("bedrock { ... }", "Typed machine-adjacent context for regions, lanes, endian helpers, barriers, prefetch, and fault_* intrinsics.") + module_card("intent fractal", "Function intent metadata. The current parser does not implement fractal as a block keyword.") + module_card("tectonic", "Accepted before fracture, abyss, or bedrock. It currently preserves the same block semantics.") + module_card("Manual lifetime", "Cells and regions allocated by bedrock must be released once and must not be read after release."))
    body = body + doc_section_en("low", "Low-level modes", "Low-level work is opt-in and visible in source. These forms do not make an invalid pointer valid, add garbage collection, or automatically manage an allocation's lifetime.", low)
    forge content = doc_page_en("Language", "The technical core of Obsidian Fault Script.", toc, body)
    return page_shell_en("Language", "The technical core of Obsidian Fault Script.", content)
}

vein page_odl_en() -> obsidian {
    forge toc = doc_link("model", "Model") + doc_link("syntax", "Syntax") + doc_link("interop", "Interop")
    forge code = "page \"OFS Web\" \"en\"\nskin \"theme.css\"\nflow\n  deck.topbar\n    title1 \"OFS Web\"\n    link.button \"Documentation\" \"#docs\"\n  stage#content\n    band.docs\n      mark \"## Native documents\\nWrite **ODL**, generate HTML.\"\n  spark \"app.js\""
    forge body = doc_section_en("model", "ODL is not HTML", "ODL is the OFS document language. HTML is only the current web target for browsers and static hosts; it is not the authored language and does not define ODL syntax.", "")
    body = body + doc_section_en("syntax", "Native syntax", "ODL uses its own document forms: `page`, `skin`, `flow`, `deck`, `stage`, `band`, `tile`, `mark`, `raw`, `wire`, `spark`, `pulse`, and `server`.", site_terminal("page.odl", code))
    body = body + doc_section_en("interop", "Interop", "`mark` accepts Markdown, `raw` preserves explicit legacy markup, `spark` imports JS modules, `pulse` injects inline behavior, and `server` can preserve template blocks.", odl.div("callout", "The source remains ODL. Browser artifacts are generated for hosting."))
    forge content = doc_page_en("ODL", "Obsidian Document Language: the structural document layer for OFS sites.", toc, body)
    return page_shell_en("ODL", "Obsidian Document Language: the structural document layer for OFS sites.", content)
}

vein page_oes_en() -> obsidian {
    forge toc = doc_link("model", "Model") + doc_link("syntax", "Syntax") + doc_link("motion", "Motion")
    forge code = "gem accent \"#a978ff\"\npaint .button\n  fill \"$accent\"\n  curve \"8px\"\nveil \"(max-width: 700px)\"\n  paint .grid\n    grid-cols \"1fr\"\npulse \"enter\"\n  rise\n    opacity \"0\"\n  rest\n    opacity \"1\""
    forge body = doc_section_en("model", "OES is not CSS", "OES is the OFS effect language. It defines tokens, visual rules, responsive contexts, capabilities, layers, and motion. CSS is only the current browser target.", "")
    body = body + doc_section_en("syntax", "Native syntax", "OES authors visual systems with forms such as `gem`, `paint`, `fill`, `ink`, `curve`, `space`, `veil`, `guard`, `strata`, and `pulse`.", site_terminal("theme.oes", code))
    body = body + doc_section_en("motion", "Motion", "`pulse`, `rise`, `rest`, and `atNN` organize timelines. A browser build maps those effects to CSS keyframes.", odl.div("callout", "OES is the source of truth; CSS is the web target artifact."))
    forge content = doc_page_en("OES", "Obsidian Effect Scripts: styles, responsiveness, and motion for ODL documents.", toc, body)
    return page_shell_en("OES", "Obsidian Effect Scripts: styles, responsiveness, and motion for ODL documents.", content)
}

vein page_web_en() -> obsidian {
    forge toc = doc_link("stack", "Stack") + doc_link("hosting", "Hosting") + doc_link("live", "Live reload")
    forge flow = odl.div("workflow", odl.div("step", "<strong>1. OFS</strong><br>Native logic.") + odl.div("step", "<strong>2. ODL</strong><br>Document source.") + odl.div("step", "<strong>3. OES</strong><br>Visual effects.") + odl.div("step", "<strong>4. Host</strong><br>Generated artifacts."))
    forge body = doc_section_en("stack", "OFS web stack", "OFS separates program logic, ODL document structure, OES effects, webserver hosting, and generated browser artifacts.", flow)
    body = body + doc_section_en("hosting", "Real hosting", "Browsers accept HTML, CSS, and JavaScript. OFS can target those formats from ODL/OES for GitHub Pages, CDNs, and common servers.", odl.div("callout", "ODL/OES sources can also be published for inspection, but browsers execute the generated artifacts."))
    body = body + doc_section_en("live", "Go Live", "The VS Code extension compiles ODL/OES, watches neighboring assets, and reloads the browser automatically.", "")
    forge content = doc_page_en("Web stack", "How OFS builds sites with native source languages.", toc, body)
    return page_shell_en("Web stack", "How OFS builds sites with native source languages.", content)
}

vein page_stdlib_en() -> obsidian {
    forge toc = doc_link("core", "Core") + doc_link("web", "Web") + doc_link("visual", "Visual") + doc_link("system", "System") + doc_link("usage", "Usage")
    forge core_modules = odl.div("module-grid", module_card("math.ofs", "Implements square, cube, range sums, prime checks, digit counting, digit sums, number reversal, and numeric palindrome checks.") + module_card("string.ofs", "Wraps runtime text operations and provides repetition, first-character checks, and empty-string checks.") + module_card("io.ofs", "Provides prompt, separator, and header helpers for terminal programs.") + module_card("terminal_colors.ofs", "Defines ANSI colors and colored terminal output helpers."))
    forge web_modules = odl.div("module-grid", module_card("odl.ofs", "Builds complete documents and semantic HTML nodes from typed OFS functions.") + module_card("oes.ofs", "Builds properties, rules, media queries, layers, variables, transitions, and keyframes.") + module_card("webserver.ofs", "Defines HTTP constants, response builders, MIME detection, JSON fragments, logging, and native serving loops.") + module_card("webui.ofs", "Provides themes and ready-made nav, hero, button, panel, grid, card, stack, page, and serve helpers."))
    forge visual_modules = odl.div("module-grid", module_card("canvas.ofs", "Experimental native 2D drawing API.") + module_card("window.ofs", "Native window lifecycle helpers.") + module_card("ui.ofs", "Immediate-mode UI measurements, text, boxes, and basic controls.") + module_card("ofshtml.ofs", "Legacy HTML helpers kept for migration to ODL."))
    forge system_modules = odl.div("module-grid", module_card("bedrock.ofs", "Low-level regions and pointer-oriented primitives.") + module_card("bedrock_packet.ofs", "Experimental packet structures for binary and protocol work.") + module_card("memory_modes.ofs", "Experiments around explicit memory modes.") + module_card("rift.ofs", "Experimental C ABI and FFI surface."))
    forge body = doc_section_en("core", "Core modules", "Core modules cover math, text, terminal input/output, and terminal presentation.", core_modules + site_terminal("core.ofs", "attach {math}\nattach {string}\nattach {io}\n\ncore main() {\n    print_header(\"Demo\")\n    echo(square(9))\n    echo(repeat_str(\"OFS\", 2))\n}"))
    body = body + doc_section_en("web", "Web modules", "The web stack ships with the standard library: ODL owns documents, OES owns effects, webserver owns HTTP, and webui provides components.", web_modules)
    body = body + doc_section_en("visual", "Native visual modules", "Canvas, window, and UI target local native interfaces rather than browsers. They remain experimental and platform-dependent.", visual_modules)
    body = body + doc_section_en("system", "System and FFI modules", "Bedrock, memory modes, and rift are explicit advanced layers for code that must move below the normal safe language surface.", system_modules)
    body = body + doc_section_en("usage", "Importing", "Use `attach {name}` for installed libraries or `attach {F:path}` for local files. Prefer named imports in distributed projects.", site_terminal("attach", "attach {math}\nattach {odl}\nattach {oes}\nattach {webui}"))
    forge content = doc_page_en("Standard library", "Modules distributed with the OFS compiler and installers.", toc, body)
    return page_shell_en("Standard library", "Modules distributed with the OFS compiler and installers.", content)
}

vein page_downloads_en() -> obsidian {
    forge toc = doc_link("assets", "Assets") + doc_link("linux", "Linux") + doc_link("checks", "Checksums")
    forge body = doc_section_en("assets", "Official downloads", "The download cards resolve the latest GitHub release assets dynamically.", site_release_en())
    body = body + doc_section_en("linux", "Linux", "Debian/Ubuntu use .deb, Fedora/RHEL/openSUSE use .rpm, and Arch/Manjaro use the pacman package.", site_terminal("install", "sudo dpkg -i ofs-debian-ubuntu-x64-installer-v*.deb\nsudo rpm -Uvh ofs-fedora-x64-installer-v*.rpm\nsudo pacman -U ofs-arch-x64-installer-v*.pkg.tar.zst"))
    body = body + doc_section_en("checks", "Integrity", "Use CHECKSUMS.sha256 from the release before installing downloaded artifacts.", odl.div("callout", "The current release is published by the Auto Release workflow."))
    forge content = doc_page_en("Downloads", "Installers, VS Code package, and checksums.", toc, body)
    return page_shell_en("Downloads", "Installers, VS Code package, and checksums.", content)
}

vein page_oll_en() -> obsidian {
    forge toc = doc_link("modes", "Visual modes") + doc_link("oll", "OLL syntax") + doc_link("run", "Running") + doc_link("caps", "Capabilities")
    forge decl_code = "window \"Panel\" {\n    width: 640\n    height: 480\n    bg_color: #1e1e2e\n    padding: 24\n\n    column {\n        gap: 16\n        header \"Monitor\" { fg_color: #cba6f7 }\n        card {\n            bg_color: #313244\n            border_color: #45475a\n            padding: 16\n            row {\n                label \"CPU\" { fg_color: #89b4fa }\n                badge \"45%\" { fg_color: #a6e3a1 }\n            }\n            progress { value: 45 bg_color: #45475a fg_color: #a6e3a1 }\n        }\n        row {\n            gap: 12\n            button \"Refresh\" { bg_color: #89b4fa fg_color: #11111b on_click: \"refresh\" }\n            button \"Close\" { bg_color: #f38ba8 fg_color: #11111b on_click: \"close\" }\n        }\n    }\n}"
    forge run_code = "ofs-ui app.oll\n\nofs ui app.oll -o preview.ppm"
    forge modes = odl.div("grid", site_card("Immediate mode", "Procedural rendering onto pixel buffers via `canvas`, `window`, and `ui`. Full event loop control.", "") + site_card("Declarative mode (OLL)", "Component tree defined in `.oll`. Frame timing managed by the runtime.", ""))
    forge caps = odl.div("module-grid",
        module_card("window, column, row", "Layout nodes: root window, vertical stack, horizontal stack.")
        + module_card("card, header, badge", "Container with border, section heading, and value label.")
        + module_card("button, label, input", "Interactive controls with states: idle, hover, active, disabled.")
        + module_card("progress, checkbox", "Progress bar and checkbox with numeric value."))
    forge body = doc_section_en("modes", "Native visual modes", "OFS provides two native UI modes: immediate, with procedural event loop control; and declarative, with an OLL file describing the component hierarchy.", modes)
    body = body + doc_section_en("oll", "OLL — Obsidian Layout Language", "An `.oll` file describes the interface tree. The runtime interprets and renders it in an X11 or Win32 window at a stable frame rate.", site_terminal("panel.oll", decl_code))
    body = body + doc_section_en("run", "Running", "Use `ofs-ui` to open the interactive window or `ofs ui ... -o preview.ppm` to export a static raster image.", site_terminal("run", run_code))
    body = body + doc_section_en("caps", "Supported capabilities", "Nodes, styling tokens, and runtime capabilities available in the current OLL runtime.", caps)
    forge content = doc_page_en("OLL", "Obsidian Layout Language: declarative native UI for OFS windows.", toc, body)
    return page_shell_en("OLL", "Obsidian Layout Language: declarative native UI for OFS windows.", content)
}

vein page_nav_es() -> obsidian {
    forge brand = odl.a("brand", "../index.html", odl.img("../ofs-256.png", "OFS logo") + odl.span("", "OFS"))
    forge tools = odl.div("nav-tools", site_language_select("es", "../index.html", "../en/index.html", "index.html") + site_search("Buscar"))
    forge links = odl.div("links", "<a href=\"language.html\">Lenguaje</a><a href=\"web.html\">Web</a><a href=\"stdlib.html\">Bibliotecas</a><a href=\"downloads.html\">Descargas</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein page_shell_es(title: obsidian, subtitle: obsidian, content: obsidian) -> obsidian {
    forge head = odl.icon("../ofs-256.png") + odl.css("../site.css")
    forge hero = odl.section("", "band", odl.div("wrap", odl.h1(title) + odl.p("lead", subtitle)))
    forge body = page_nav_es() + odl.main("top", hero + content) + odl.footer("footer", "<div class=\"wrap\">Generado por ODL y OES en OFS.</div>") + odl.script("../site.js")
    return odl.document("es", title + " - OFS", subtitle, head, body)
}

vein doc_section_es(id: obsidian, title: obsidian, text: obsidian, extra: obsidian) -> obsidian {
    return odl.section(id, "doc-section", odl.h2(title) + odl.div("doc-intro", odl.p("", text)) + extra)
}

vein page_es_index() -> obsidian {
    forge links = site_doc_link("language.html", "Lenguaje", "Sintaxis, tipos, funciones, modulos y compilacion.")
    links = links + site_doc_link("web.html", "Web", "OFS, ODL, OES, servidor y alojamiento.")
    links = links + site_doc_link("stdlib.html", "Biblioteca estandar", "Modulos incluidos con el compilador.")
    links = links + site_doc_link("downloads.html", "Descargas", "Instaladores, extension y checksums.")
    forge content = odl.section("", "band", odl.div("wrap", odl.div("docs-list", links)))
    return page_shell_es("Documentacion OFS", "Documentacion tecnica en espanol.", content)
}

vein page_language_es() -> obsidian {
    forge body = doc_section_es("overview", "Que es OFS", "OFS es un lenguaje compilado self-hosted. El compilador esta escrito en OFS, genera LLVM IR y enlaza un runtime nativo.", site_terminal("hola.ofs", "vein sumar(a: stone, b: stone) -> stone {\n    return a + b\n}\n\ncore main() {\n    echo(sumar(20, 2))\n}"))
    body = body + doc_section_es("syntax", "Elementos principales", "`vein` declara funciones, `forge` crea variables, `core main()` es la entrada, `attach` importa bibliotecas y `monolith` define estructuras.", "")
    body = body + doc_section_es("build", "Compilacion", "`check` valida, `run` compila y ejecuta, `build` crea un ejecutable, `ir` muestra LLVM IR y `asm` genera assembly.", site_terminal("terminal", "ofs check app.ofs\nofs run app.ofs\nofs build app.ofs -o app"))
    forge content = odl.section("", "band", odl.div("wrap doc-main", body))
    return page_shell_es("Lenguaje", "Conceptos fundamentales de Obsidian Fault Script.", content)
}

vein page_web_es() -> obsidian {
    forge body = doc_section_es("layers", "Capas web", "OFS contiene la logica nativa, ODL describe documentos, OES define diseno y movimiento, webserver sirve HTTP y webui ofrece componentes.", site_terminal("site.ofs", "attach {odl}\nattach {webserver}\n\ncore main() {\n    forge html = odl.document(\"es\", \"Sitio\", \"OFS Web\", \"\", odl.h1(\"Hola\"))\n    webserver.serve_html_forever(8080, html)\n}"))
    body = body + doc_section_es("browser", "Navegador", "El navegador recibe HTML, CSS y JavaScript generados. Los archivos ODL y OES permanecen como fuente del proyecto.", "")
    forge content = odl.section("", "band", odl.div("wrap doc-main", body))
    return page_shell_es("Web", "La stack web nativa de OFS.", content)
}

vein page_stdlib_es() -> obsidian {
    forge modules = odl.div("module-grid", module_card("math", "Funciones numericas, primos, digitos y rangos.") + module_card("string", "Longitud, caracteres, repeticion y pruebas de texto.") + module_card("io", "Entrada y salida de terminal.") + module_card("odl / oes", "Generacion de documentos y estilos.") + module_card("webserver / webui", "Servidor HTTP y componentes web.") + module_card("canvas / window / ui", "Interfaz visual nativa experimental.") + module_card("bedrock / rift", "Memoria, bajo nivel y FFI experimental.") + module_card("test_lib", "Apoyo para pruebas y ejemplos."))
    forge content = odl.section("", "band", odl.div("wrap doc-main", doc_section_es("modules", "Modulos", "La biblioteca estandar se instala junto con el compilador y se importa con `attach {nombre}`.", modules)))
    return page_shell_es("Biblioteca estandar", "Modulos distribuidos con OFS.", content)
}

vein page_downloads_es() -> obsidian {
    forge content = odl.section("", "band", odl.div("wrap doc-main", doc_section_es("install", "Descargas", "La release incluye paquetes para Debian/Ubuntu, Fedora/RHEL/openSUSE, Arch/Manjaro, macOS ARM64, Windows x64 y VS Code.", site_terminal("terminal", "sudo dpkg -i ofs-debian-ubuntu-x64-installer-v*.deb\nsudo rpm -Uvh ofs-fedora-x64-installer-v*.rpm\nsudo pacman -U ofs-arch-x64-installer-v*.pkg.tar.zst"))))
    return page_shell_es("Descargas", "Instaladores oficiales y checksums.", content)
}
