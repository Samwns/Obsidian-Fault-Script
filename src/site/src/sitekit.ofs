attach {F:../../../ofs/stdlib/odl.ofs}
attach {F:../../../ofs/stdlib/oes.ofs}

vein site_css() -> obsidian {
    forge s = ""
    s = s + oes.rule(":root", "color-scheme:dark;" + oes.var("ink", "#eef6ff") + oes.var("muted", "#9fb1c8") + oes.var("paper", "#070a0f") + oes.var("surface", "#101722") + oes.var("line", "#263244") + oes.var("accent", "#29e0bd") + oes.var("accent2", "#7c5cff") + oes.var("hot", "#ffcc66") + oes.var("code", "#070a0f") + oes.var("code-ink", "#dff8ff"))
    s = s + oes.rule("*", "box-sizing:border-box")
    s = s + oes.rule("html", "scroll-behavior:smooth")
    s = s + oes.rule("body", "margin:0;background:radial-gradient(circle at 20% 0%,rgba(41,224,189,.18),transparent 32%),radial-gradient(circle at 86% 12%,rgba(124,92,255,.22),transparent 34%),var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;line-height:1.55;overflow-x:hidden")
    s = s + oes.rule("body:before", "content:\"\";position:fixed;inset:0;background:linear-gradient(transparent 0 23px,rgba(255,255,255,.035) 24px),linear-gradient(90deg,transparent 0 23px,rgba(255,255,255,.03) 24px);background-size:24px 24px;mask-image:linear-gradient(to bottom,black,transparent 72%);pointer-events:none")
    s = s + oes.rule("a", "color:inherit")
    s = s + oes.rule(".wrap", "width:min(1180px,calc(100% - 32px));margin:0 auto")
    s = s + oes.rule(".topbar", "position:sticky;top:0;z-index:10;background:rgba(7,10,15,.76);border-bottom:1px solid var(--line);backdrop-filter:blur(18px)")
    s = s + oes.rule(".nav", "min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:16px")
    s = s + oes.rule(".brand", "display:inline-flex;align-items:center;gap:10px;font-weight:900;text-decoration:none")
    s = s + oes.rule(".brand img", "width:36px;height:36px")
    s = s + oes.rule(".links", "display:flex;align-items:center;gap:18px;color:var(--muted);font-size:14px")
    s = s + oes.rule(".links a", "text-decoration:none")
    s = s + oes.rule(".links a:hover", "color:var(--accent)")
    s = s + oes.rule(".nav-tools", "display:inline-flex;align-items:center;gap:8px;position:relative")
    s = s + oes.rule(".lang", "display:inline-flex;gap:4px")
    s = s + oes.rule(".language-select,.search-box input", "min-height:38px;border:1px solid var(--line);border-radius:8px;background:#111722;color:var(--ink);padding:0 12px;font:inherit;outline:none")
    s = s + oes.rule(".language-select", "min-width:148px;appearance:none;-webkit-appearance:none;padding-right:34px;cursor:pointer;background-color:#111722;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 16px) 16px,calc(100% - 11px) 16px;background-size:5px 5px,5px 5px;background-repeat:no-repeat")
    s = s + oes.rule(".language-select:hover,.language-select:focus,.search-box input:focus", "border-color:var(--accent)")
    s = s + oes.rule(".language-select option", "background:#111722;color:var(--ink)")
    s = s + oes.rule(".search-button", "width:38px;height:38px;display:inline-grid;place-items:center;border:1px solid var(--line);border-radius:8px;background:#111722;color:var(--ink);font-size:16px;cursor:pointer")
    s = s + oes.rule(".search-button:hover,.search-button[aria-expanded=\"true\"]", "border-color:var(--accent);color:var(--accent)")
    s = s + oes.rule(".search-box", "display:inline-flex;align-items:center;gap:6px")
    s = s + oes.rule(".search-box input", "width:0;padding:0;border-color:transparent;opacity:0;pointer-events:none;transition:width .2s ease,opacity .2s ease,border-color .2s ease")
    s = s + oes.rule(".search-box.open input", "width:190px;padding:0 12px;border-color:var(--line);opacity:1;pointer-events:auto")
    s = s + oes.rule(".hidden-by-search", "display:none!important")
    s = s + oes.rule(".search-count", "color:var(--muted);font-size:12px")
    s = s + oes.rule(".hero", "min-height:82vh;display:grid;align-items:center;padding:58px 0 36px")
    s = s + oes.rule(".hero-grid", "display:grid;grid-template-columns:minmax(0,1.08fr) minmax(340px,.92fr);gap:44px;align-items:center")
    s = s + oes.rule(".kicker", "margin:0 0 14px;color:var(--accent);font-weight:900;text-transform:uppercase;font-size:13px;letter-spacing:.12em")
    s = s + oes.rule("h1", "margin:0;font-size:clamp(50px,8vw,104px);line-height:.88;letter-spacing:0")
    s = s + oes.rule(".lead", "max-width:760px;margin:24px 0 0;color:var(--muted);font-size:clamp(18px,2.2vw,22px)")
    s = s + oes.rule(".actions", "display:flex;flex-wrap:wrap;gap:12px;margin-top:30px")
    s = s + oes.rule(".btn", "min-height:46px;display:inline-flex;align-items:center;justify-content:center;padding:0 18px;border-radius:8px;border:1px solid rgba(41,224,189,.55);background:linear-gradient(135deg,var(--accent),#7fffe4);color:#06100e;text-decoration:none;font-weight:900;box-shadow:0 12px 34px rgba(41,224,189,.18)")
    s = s + oes.rule(".btn.secondary", "background:rgba(255,255,255,.04);color:var(--ink);border-color:var(--line);box-shadow:none")
    s = s + oes.rule(".terminal,.showcase", "background:linear-gradient(180deg,rgba(16,23,34,.96),rgba(8,12,18,.96));color:var(--code-ink);border-radius:8px;box-shadow:0 24px 70px rgba(0,0,0,.36);overflow:hidden;border:1px solid var(--line)")
    s = s + oes.rule(".terminal-head", "height:40px;display:flex;align-items:center;padding:0 14px;border-bottom:1px solid var(--line);color:#9fb0c0;font-size:13px")
    s = s + oes.rule("pre", "margin:0;padding:18px;overflow:auto;font-size:13px;line-height:1.6")
    s = s + oes.rule("code", "font-family:SFMono-Regular,Consolas,Liberation Mono,monospace")
    s = s + oes.rule(".band", "padding:76px 0;border-top:1px solid var(--line);position:relative")
    s = s + oes.rule(".section-head", "display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:26px")
    s = s + oes.rule("h2", "margin:0;font-size:clamp(32px,4vw,54px);line-height:1;letter-spacing:0")
    s = s + oes.rule(".section-head p", "max-width:650px;margin:0;color:var(--muted)")
    s = s + oes.rule(".grid", "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px")
    s = s + oes.rule(".card,.doc-link,.mini-page", "background:rgba(255,255,255,.055);border:1px solid var(--line);border-radius:8px;padding:20px;backdrop-filter:blur(8px)")
    s = s + oes.rule(".card,.step,.terminal,.doc-link", "opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease,border-color .2s ease")
    s = s + oes.rule(".card.seen,.step.seen,.terminal.seen,.doc-link.seen", "opacity:1;transform:translateY(0)")
    s = s + oes.rule(".card:hover,.doc-link:hover", "border-color:rgba(41,224,189,.55);transform:translateY(-2px)")
    s = s + oes.rule(".card h3", "margin:0 0 8px;font-size:18px")
    s = s + oes.rule(".card p", "margin:0;color:var(--muted)")
    s = s + oes.rule(".table-wrap", "overflow:auto;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.045)")
    s = s + oes.rule("table", "width:100%;border-collapse:collapse;min-width:760px")
    s = s + oes.rule("th,td", "padding:13px 14px;border-bottom:1px solid var(--line);text-align:left")
    s = s + oes.rule("th", "font-size:13px;color:var(--muted);background:rgba(255,255,255,.06)")
    s = s + oes.rule("tr:last-child td", "border-bottom:0")
    s = s + oes.rule(".bars", "display:grid;gap:10px")
    s = s + oes.rule(".bar-row", "display:grid;grid-template-columns:82px 1fr 88px;align-items:center;gap:12px")
    s = s + oes.rule(".bar", "height:15px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden")
    s = s + oes.rule(".bar span", "display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:999px;animation:grow .85s ease both")
    s = s + oes.rule(".metric-tabs", "display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px")
    s = s + oes.rule(".metric-tabs button", "min-height:38px;padding:0 14px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.04);color:var(--muted);font-weight:800;cursor:pointer")
    s = s + oes.rule(".metric-tabs button.active", "background:var(--accent);border-color:var(--accent);color:#06100e")
    s = s + oes.rule(".benchmark-note", "margin:0 0 18px;color:var(--muted)")
    s = s + oes.rule(".metric-summary", "display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:18px")
    s = s + oes.rule(".metric-stat", "padding:16px;border-left:3px solid var(--accent);background:rgba(255,255,255,.04)")
    s = s + oes.rule(".metric-stat strong", "display:block;font-size:22px")
    s = s + oes.rule(".metric-stat span", "color:var(--muted);font-size:13px")
    s = s + oes.rule(".download-grid", "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px")
    s = s + oes.rule(".download-card", "display:flex;flex-direction:column;gap:8px;min-height:150px;text-decoration:none;background:rgba(255,255,255,.055);border:1px solid var(--line);border-radius:8px;padding:18px;transition:transform .2s ease,border-color .2s ease")
    s = s + oes.rule(".download-card:hover", "border-color:var(--accent);transform:translateY(-2px)")
    s = s + oes.rule(".download-card strong", "font-size:18px")
    s = s + oes.rule(".download-card span", "color:var(--muted)")
    s = s + oes.rule(".tool-layout", "display:grid;grid-template-columns:1fr 1fr;gap:16px")
    s = s + oes.rule(".tool-pane", "display:grid;gap:10px")
    s = s + oes.rule(".tool-pane label", "font-weight:900")
    s = s + oes.rule("textarea", "width:100%;min-height:430px;resize:vertical;border:1px solid var(--line);border-radius:8px;background:#05080d;color:var(--code-ink);padding:16px;font:13px/1.55 SFMono-Regular,Consolas,monospace")
    s = s + oes.rule(".tool-controls", "display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px")
    s = s + oes.rule(".tool-controls select", "min-height:42px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);padding:0 12px")
    s = s + oes.rule(".preview-frame", "width:100%;min-height:360px;border:1px solid var(--line);border-radius:8px;background:white")
    s = s + oes.rule(".docs-list", "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px")
    s = s + oes.rule(".doc-link", "text-decoration:none")
    s = s + oes.rule(".doc-link strong", "display:block")
    s = s + oes.rule(".doc-link span", "color:var(--muted);font-size:14px")
    s = s + oes.rule(".doc-layout", "display:grid;grid-template-columns:260px minmax(0,1fr);gap:26px;align-items:start")
    s = s + oes.rule(".toc", "position:sticky;top:94px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.045);padding:14px")
    s = s + oes.rule(".toc strong", "display:block;margin-bottom:10px")
    s = s + oes.rule(".toc a", "display:block;color:var(--muted);text-decoration:none;padding:7px 0;border-top:1px solid rgba(255,255,255,.05)")
    s = s + oes.rule(".toc a:hover", "color:var(--accent)")
    s = s + oes.rule(".doc-main", "display:grid;gap:18px")
    s = s + oes.rule(".doc-section", "border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.04);padding:22px")
    s = s + oes.rule(".doc-section h2", "font-size:30px;margin-bottom:12px")
    s = s + oes.rule(".doc-section h3", "margin:18px 0 8px")
    s = s + oes.rule(".doc-section p", "color:var(--muted);margin:0 0 12px")
    s = s + oes.rule(".dual", "display:grid;grid-template-columns:1fr 1fr;gap:14px")
    s = s + oes.rule(".doc-intro", "margin-bottom:16px")
    s = s + oes.rule(".doc-intro p", "font-size:17px;line-height:1.7")
    s = s + oes.rule(".callout", "border:1px solid var(--line);background:rgba(255,255,255,.035);padding:14px 16px;border-radius:8px;color:var(--muted)")
    s = s + oes.rule(".callout strong", "color:var(--ink)")
    s = s + oes.rule(".pill-row", "display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0")
    s = s + oes.rule(".pill", "display:inline-flex;align-items:center;min-height:30px;border:1px solid var(--line);border-radius:999px;padding:0 10px;color:var(--muted);background:rgba(255,255,255,.04);font-size:13px")
    s = s + oes.rule(".module-grid", "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px")
    s = s + oes.rule(".module", "border:1px solid var(--line);border-radius:8px;padding:16px;background:rgba(255,255,255,.045)")
    s = s + oes.rule(".module code", "display:inline-block;margin-bottom:8px;color:var(--hot)")
    s = s + oes.rule(".module p", "margin:0 0 10px;color:var(--muted)")
    s = s + oes.rule(".module ul", "margin:8px 0 0;padding-left:18px;color:var(--muted)")
    s = s + oes.rule(".module li", "margin:4px 0")
    s = s + oes.rule(".api-table code", "color:var(--hot)")
    s = s + oes.rule(".workflow", "display:grid;grid-template-columns:repeat(4,1fr);gap:12px")
    s = s + oes.rule(".step", "padding:18px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.04)")
    s = s + oes.rule(".footer", "padding:34px 0;color:var(--muted);border-top:1px solid var(--line)")
    s = s + oes.keyframes("grow", oes.frame("from", "width:0") + oes.frame("to", ""))
    s = s + oes.keyframes("float", oes.frame("0%,100%", "transform:translateY(0)") + oes.frame("50%", "transform:translateY(-10px)"))
    s = s + oes.rule(".showcase", "animation:float 6s ease-in-out infinite")
    s = s + oes.media("(max-width:900px)", ".links>a{display:none}.links{margin-left:auto}.nav-tools{margin-left:auto}.language-select{min-width:132px}.search-box.open{position:fixed;left:16px;right:16px;top:78px;z-index:30;padding:10px;background:#0b1018;border:1px solid var(--line);border-radius:8px;box-shadow:0 18px 50px rgba(0,0,0,.5)}.search-box.open .search-button{flex:0 0 38px}.search-box.open input{width:100%;min-width:0;flex:1}.search-box.open .search-count{white-space:nowrap}.hero-grid,.grid,.docs-list,.workflow,.metric-summary,.tool-layout,.download-grid,.doc-layout,.dual,.module-grid{grid-template-columns:1fr}.toc{position:static}.hero{min-height:auto;padding-top:36px}.section-head{display:block}.section-head p{margin-top:12px}.bar-row{grid-template-columns:72px 1fr 76px}")
    s = s + oes.media("(max-width:520px)", ".wrap{width:min(100% - 24px,1180px)}.nav{min-height:64px}.brand span{display:none}.brand img{width:32px;height:32px}.language-select{min-width:118px;max-width:118px}.nav-tools{gap:6px}.band{padding:52px 0}.doc-section{padding:18px}.doc-section h2{font-size:26px}h1{font-size:44px}.search-box.open{top:70px;left:12px;right:12px}.search-count{display:none}")
    return s
}

vein site_js() -> obsidian {
    forge s = ""
    s = s + "const translations={pt:{navDocs:'Documentacao',navBench:'Benchmark',navRelease:'Downloads',kicker:'Linguagem compilada hibrida',title:'OFS compila, roda nativo e constroi a Web.',lead:'Uma linguagem self-hosted com LLVM, runtime nativo, ODL para documentos e OES para estilo, efeitos e movimento.',ctaStart:'Comecar',ctaGitHub:'GitHub',terminalTitle:'exemplo.ofs',pillarsTitle:'O que e a OFS',pillarsLead:'Uma linguagem para aprender, compilar e descer perto do sistema quando precisar.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker e geracao LLVM vivem no compilador OFS.',p2Title:'Nativa',p2Body:'A saida e LLVM IR linkada com libofs_runtime.a para gerar executaveis.',p3Title:'Hibrida',p3Body:'Console, canvas/window nativo e sites via webserver/webui no mesmo ecossistema.',webTitle:'ODL + OES',webLead:'ODL descreve documentos; OES define estilo, efeitos, responsividade e animacoes.',benchTitle:'Benchmark reproduzivel',benchLead:'CPU, memoria, startup, compilacao e tamanho de artefato medidos com processos reais.',docsTitle:'Documentacao',docsLead:'Guias tecnicos para linguagem, compilador, bootstrap, UI e publicacao.',releaseTitle:'Downloads',releaseLead:'Baixe instaladores oficiais, pacote VS Code e checksums gerados pelo GitHub Actions.',footer:'OFS e um projeto experimental de linguagem compilada. Site gerado pela propria OFS para GitHub Pages.'},en:{navDocs:'Documentation',navBench:'Benchmark',navRelease:'Downloads',kicker:'Hybrid compiled language',title:'OFS compiles, runs native, and builds the Web.',lead:'Obsidian Fault Script is a self-hosted language with an LLVM pipeline, modular standard library, low-level modes, and an experimental Web UI layer for building sites with OFS.',ctaStart:'Get started',ctaGitHub:'GitHub',terminalTitle:'example.ofs',pillarsTitle:'What OFS is',pillarsLead:'A language for learning, compiling, and moving close to the system when needed.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker, and LLVM generation live in the OFS compiler.',p2Title:'Native',p2Body:'The output is LLVM IR linked with libofs_runtime.a to produce executables.',p3Title:'Hybrid',p3Body:'Console apps, native canvas/window apps, and sites via webserver/webui in one ecosystem.',webTitle:'ODL + OES',webLead:'Web files are explicit: the extension only uses Go Live when it sees attach {webui} or web calls.',benchTitle:'Reproducible benchmark',benchLead:'Iterative fib(25..32) repeated 5,000,000 times. Local measurement, not a complete performance study.',docsTitle:'Documentation',docsLead:'Technical guides for the language, compiler, bootstrap, UI, and publishing.',releaseTitle:'Downloads',releaseLead:'Download official installers, the VS Code package, and checksums generated by GitHub Actions.',footer:'OFS is an experimental compiled language project. Site generated by OFS itself for GitHub Pages.'},es:{navDocs:'Documentacion',navBench:'Benchmark',navRelease:'Downloads',kicker:'Lenguaje compilado hibrido',title:'OFS compila, ejecuta nativo y construye la Web.',lead:'Obsidian Fault Script es un lenguaje self-hosted con pipeline LLVM, libreria estandar modular, modos low-level y una capa Web UI experimental para crear sitios con OFS.',ctaStart:'Empezar',ctaGitHub:'GitHub',terminalTitle:'ejemplo.ofs',pillarsTitle:'Que es OFS',pillarsLead:'Un lenguaje para aprender, compilar y acercarse al sistema cuando haga falta.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker y generacion LLVM viven en el compilador OFS.',p2Title:'Nativo',p2Body:'La salida es LLVM IR enlazada con libofs_runtime.a para generar ejecutables.',p3Title:'Hibrido',p3Body:'Consola, canvas/window nativo y sitios via webserver/webui en el mismo ecosistema.',webTitle:'ODL + OES',webLead:'Los archivos web son explicitos: la extension solo usa Go Live cuando ve attach {webui} o llamadas web.',benchTitle:'Benchmark reproduzivel',benchLead:'fib(25..32) iterativo repetido 5.000.000 veces. Medicion local, no un estudio completo de rendimiento.',docsTitle:'Documentacion',docsLead:'Guias tecnicas para lenguaje, compilador, bootstrap, UI y publicacion.',releaseTitle:'Downloads',releaseLead:'La release publica mas reciente esta en /releases/latest y se genera por GitHub Actions con assets Linux, macOS, Windows, VS Code y checksums.',footer:'OFS es un proyecto experimental de lenguaje compilado. Sitio generado por la propia OFS para GitHub Pages.'}};"
    s = s + "function applyLanguage(lang){const dict=translations[lang]||translations.pt;document.documentElement.lang=lang;document.querySelectorAll('[data-i18n]').forEach((node)=>{const key=node.getAttribute('data-i18n');if(dict[key])node.textContent=dict[key];});document.querySelectorAll('[data-lang]').forEach((button)=>button.classList.toggle('active',button.getAttribute('data-lang')===lang));localStorage.setItem('ofs-lang',lang)}"
    s = s + "async function loadLegacyBenchmark(){let response=await fetch('assets/benchmark.json');if(!response.ok){response=await fetch('benchmark.json')}const data=await response.json();const results=data.results.filter((r)=>r.best_seconds!==null);const max=Math.max(...results.map((r)=>r.best_seconds));const bars=document.getElementById('benchmark-bars');const rows=document.getElementById('benchmark-rows');const suites=document.getElementById('benchmark-suites');bars.innerHTML='';rows.innerHTML='';if(suites)suites.innerHTML='';data.results.forEach((result)=>{const value=result.best_seconds;const width=value===null?0:Math.max(4,(value/max)*100);const label=value===null?'n/a':`${value.toFixed(4)}s`;const factor=value===null?'n/a':`${(value/data.results[0].best_seconds).toFixed(1)}x`;bars.insertAdjacentHTML('beforeend',`<div class=\"bar-row\"><strong>${result.language}</strong><div class=\"bar\"><span style=\"width:${width}%\"></span></div><span>${label}</span></div>`);rows.insertAdjacentHTML('beforeend',`<tr><td>${result.language}</td><td>${label}</td><td>${factor}</td><td>${result.output}</td></tr>`)});if(suites&&data.suites){data.suites.forEach((suite)=>{suites.insertAdjacentHTML('beforeend',`<article class=\"card\"><h3>${suite.name}</h3><p>${suite.summary}</p><p><strong>${suite.best_seconds}s</strong> best - ${suite.status}</p></article>`)})}document.getElementById('benchmark-meta').textContent=`${data.benchmark} - menor e melhor - ${data.runs_per_language} runs - ${data.date_utc}`}"
    s = s + "async function setupReleaseDownloads(){const links=[...document.querySelectorAll('[data-release-asset]')];if(!links.length)return;try{const response=await fetch('https://api.github.com/repos/Samwns/Obsidian-Fault-Script/releases/latest');if(!response.ok)return;const data=await response.json();links.forEach((link)=>{const key=link.getAttribute('data-release-asset');const asset=(data.assets||[]).find((item)=>item.name.includes(key));if(asset)link.href=asset.browser_download_url;const version=link.querySelector('[data-release-version]');if(version)version.textContent=data.tag_name||'latest'})}catch(e){}}"
    s = s + "function setupLanguageSelect(){const select=document.querySelector('[data-language-select]');if(!select)return;select.addEventListener('change',()=>{const target=select.options[select.selectedIndex].dataset.href;if(target)location.href=target})}"
    s = s + "function setupSearch(){const box=document.querySelector('.search-box'),button=document.querySelector('.search-button'),input=document.querySelector('[data-site-search]'),count=document.querySelector('.search-count');if(!box||!button||!input)return;const nodes=[...document.querySelectorAll('.doc-section,.doc-link,.card,.module,.download-card,.step')];const close=()=>{box.classList.remove('open');button.setAttribute('aria-expanded','false');input.value='';run()};const run=()=>{const q=input.value.trim().toLowerCase();let shown=0;nodes.forEach((node)=>{const ok=!q||node.textContent.toLowerCase().includes(q);node.classList.toggle('hidden-by-search',!ok);if(ok)shown++});if(count)count.textContent=q?`${shown} resultados`:''};button.addEventListener('click',()=>{const open=!box.classList.contains('open');if(open){box.classList.add('open');button.setAttribute('aria-expanded','true');input.focus()}else close()});input.addEventListener('input',run);document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&box.classList.contains('open')){close();button.focus()}});document.addEventListener('click',(event)=>{if(box.classList.contains('open')&&!box.contains(event.target))close()})}"
    s = s + "setupLanguageSelect();setupSearch();setupReleaseDownloads();if(document.getElementById('benchmark-bars'))loadBenchmark().catch(()=>{const meta=document.getElementById('benchmark-meta');if(meta)meta.textContent='Benchmark data unavailable.'});"
    return s
}

vein site_runtime_js() -> obsidian {
    forge s = site_js()
    s = s + "const benchmarkMetrics={cpu:{field:'cpu_ms',unit:'ms',label:'CPU mediana'},memory:{field:'memory_rss_kb',unit:'KiB',label:'Memoria RSS'},startup:{field:'startup_ms',unit:'ms',label:'Inicializacao'},compile:{field:'compile_ms',unit:'ms',label:'Compilacao'},artifact:{field:'artifact_bytes',unit:'bytes',label:'Tamanho do artefato'}};"
    s = s + "function metricValue(result,metric){const raw=result[metric.field];return raw&&typeof raw==='object'?raw.median:raw}function metricNumber(value){return value>=1000?value.toLocaleString(undefined,{maximumFractionDigits:1}):value.toFixed(value<10?2:1)}"
    s = s + "function renderMetric(data,key){const metric=benchmarkMetrics[key];const values=data.results.filter((r)=>r.available&&r.correct&&metricValue(r,metric)!==null);const max=Math.max(...values.map((r)=>metricValue(r,metric)));const min=Math.min(...values.map((r)=>metricValue(r,metric)));const bars=document.getElementById('benchmark-bars');const rows=document.getElementById('benchmark-rows');bars.innerHTML='';rows.innerHTML='';values.forEach((result)=>{const value=metricValue(result,metric);const width=Math.max(4,value/max*100);bars.insertAdjacentHTML('beforeend',`<div class=\"bar-row\"><strong>${result.language}</strong><div class=\"bar\"><span style=\"width:${width}%\"></span></div><span>${metricNumber(value)} ${metric.unit}</span></div>`);rows.insertAdjacentHTML('beforeend',`<tr><td>${result.language}</td><td>${metricNumber(value)} ${metric.unit}</td><td>${(value/min).toFixed(2)}x</td><td>${result.correct?'ok':'falhou'}</td></tr>`)});document.getElementById('metric-label').textContent=`${metric.label}. Menor e melhor.`;document.querySelectorAll('[data-metric]').forEach((button)=>button.classList.toggle('active',button.dataset.metric===key))}"
    s = s + "async function loadBenchmark(){let response=await fetch('benchmark.json');if(!response.ok)response=await fetch('assets/benchmark.json');const data=await response.json();document.getElementById('benchmark-meta').textContent=`${data.machine.cpu} - ${data.machine.logical_cores} nucleos logicos - ${data.generated_at_utc}`;document.getElementById('benchmark-note').textContent='Medicoes locais desta maquina e deste workload. Nao sao rankings universais de linguagens.';document.querySelectorAll('[data-metric]').forEach((button)=>button.addEventListener('click',()=>renderMetric(data,button.dataset.metric)));renderMetric(data,'cpu')}"
    s = s + "document.querySelectorAll('[data-copy]').forEach((b)=>b.addEventListener('click',()=>navigator.clipboard&&navigator.clipboard.writeText(b.getAttribute('data-copy'))));"
    s = s + "const toolEscape=(v)=>v.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');const toolQuote=(v,n=0)=>{const m=[...v.matchAll(/\"((?:\\\\.|[^\"])*)\"/g)];return m[n]?m[n][1].replaceAll('\\\\n','\\n').replaceAll('\\\\\"','\"'):''};"
    s = s + "function browserMarkdown(v){return v.replace(/^### (.*)$/gm,'<h3>$1</h3>').replace(/^## (.*)$/gm,'<h2>$1</h2>').replace(/^# (.*)$/gm,'<h1>$1</h1>').replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>').replace(/`(.+?)`/g,'<code>$1</code>').replace(/^- (.*)$/gm,'<li>$1</li>')}"
    s = s + "function odlToHtml(src){let title='ODL Document',lang='pt',head='<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">',body='',stack=[];const tagAliases={deck:'nav',stage:'main',band:'section',tile:'article',text:'p',title1:'h1',title2:'h2',title3:'h3',link:'a',asset:'img'};for(const raw of src.split(/\\r?\\n/)){const clean=raw.trim();if(!clean||clean.startsWith('//'))continue;const indent=raw.search(/\\S|$/);while(stack.length&&stack.at(-1).indent>=indent)body+=`</${stack.pop().tag}>`;const cmd=clean.split(/\\s+/)[0],text=toolQuote(clean);if(cmd==='document'||cmd==='page'){title=text||title;lang=toolQuote(clean,1)||lang;continue}if(cmd==='style'||cmd==='skin'){head+=`<link rel=\"stylesheet\" href=\"${toolEscape(text)}\">`;continue}if(cmd==='body'||cmd==='flow'||cmd==='head')continue;if(cmd==='markdown'||cmd==='md'||cmd==='mark'){body+=browserMarkdown(text);continue}if(cmd==='html'||cmd==='raw'){body+=text;continue}if(cmd==='script'||cmd==='wire'||cmd==='module'||cmd==='node'||cmd==='spark'){body+=`<script${cmd==='script'||cmd==='wire'?'': ' type=\"module\"'} src=\"${toolEscape(text)}\"><\\/script>`;continue}if(cmd==='js'||cmd==='pulse'){body+=`<script>${text}<\\/script>`;continue}if(cmd==='php'||cmd==='server'){body+=`<?php ${text} ?>`;continue}if(cmd==='image'||cmd==='img'||cmd==='asset'){body+=`<img src=\"${toolEscape(text)}\" alt=\"${toolEscape(toolQuote(clean,1))}\">`;continue}let rawTag=(cmd.match(/^[^.#]+/)||['div'])[0],tag=tagAliases[rawTag]||rawTag,id=(cmd.match(/#([\\w-]+)/)||[])[1],classes=[...cmd.matchAll(/\\.([\\w-]+)/g)].map(x=>x[1]).join(' ');let attrs=(id?` id=\"${id}\"`:'')+(classes?` class=\"${classes}\"`:'');if((tag==='a'||rawTag==='link')&&toolQuote(clean,1))attrs+=` href=\"${toolEscape(toolQuote(clean,1))}\"`;if(text)body+=`<${tag}${attrs}>${toolEscape(text)}</${tag}>`;else{body+=`<${tag}${attrs}>`;stack.push({tag,indent})}}while(stack.length)body+=`</${stack.pop().tag}>`;return `<!doctype html><html lang=\"${lang}\"><head>${head}<title>${toolEscape(title)}</title></head><body>${body}</body></html>`}"
    s = s + "function oesToCss(src){const aliases={bg:'background',fill:'background',radius:'border-radius',curve:'border-radius',columns:'grid-template-columns','grid-cols':'grid-template-columns',rows:'grid-template-rows','grid-rows':'grid-template-rows',size:'font-size','type-size':'font-size',weight:'font-weight',align:'align-items',justify:'justify-content',space:'gap',edge:'border',ink:'color',flow:'display'};let out='/* Generated by OES */',stack=[];for(const raw of src.split(/\\r?\\n/)){const clean=raw.trim();if(!clean||clean.startsWith('//'))continue;const indent=raw.search(/\\S|$/);while(stack.length&&stack.at(-1)>=indent){out+='}';stack.pop()}const cmd=clean.split(/\\s+/)[0],text=toolQuote(clean).replace(/\\$([\\w-]+)/g,'var(--$1)');if(cmd==='raw'||cmd==='css'){out+=text;continue}if(cmd==='token'||cmd==='gem'||cmd==='tone'){out+=`:root{--${clean.split(/\\s+/)[1]}:${text};}`;continue}if(cmd==='media'||cmd==='veil'||cmd==='supports'||cmd==='guard'||cmd==='layer'||cmd==='strata'){const at={veil:'media',guard:'supports',strata:'layer'}[cmd]||cmd;out+=`@${at} ${text}{`;stack.push(indent);continue}if(cmd==='keyframes'||cmd==='motion'||cmd==='pulse'){out+=`@keyframes ${text}{`;stack.push(indent);continue}if(cmd==='from'||cmd==='rise'||cmd==='to'||cmd==='rest'||cmd.startsWith('at')){out+=(cmd==='rise'?'from':cmd==='rest'?'to':cmd.startsWith('at')?cmd.slice(2)+'%':cmd)+'{';stack.push(indent);continue}if(cmd==='paint'){out+=clean.slice(5).trim()+'{';stack.push(indent);continue}if(text)out+=`${aliases[cmd]||cmd}:${text};`;else{out+=cmd+'{';stack.push(indent)}}while(stack.length){out+='}';stack.pop()}return out}"
    s = s + "function setupPlayground(){const input=document.getElementById('translator-input'),output=document.getElementById('translator-output'),mode=document.getElementById('translator-mode'),preview=document.getElementById('translator-preview'),run=document.getElementById('translator-run');if(!input)return;const convert=()=>{let value='';if(mode.value==='odl-html')value=odlToHtml(input.value);else if(mode.value==='oes-css')value=oesToCss(input.value);else if(mode.value==='html-odl')value='page \"Documento importado\" \"pt\"\\nflow\\n  raw \"'+input.value.replaceAll('\\\\','\\\\\\\\').replaceAll('\"','\\\\\"').replaceAll('\\n','\\\\n')+'\"';else value='raw \"'+input.value.replaceAll('\\\\','\\\\\\\\').replaceAll('\"','\\\\\"').replaceAll('\\n','\\\\n')+'\"';output.value=value;if(mode.value==='odl-html')preview.srcdoc=value;else if(mode.value==='oes-css')preview.srcdoc=`<!doctype html><style>${value}</style><main class=\"demo\"><h1>Previa OES</h1><button class=\"button\">Componente estilizado</button></main>`};run.addEventListener('click',convert);mode.addEventListener('change',convert);convert()}setupPlayground();"
    s = s + "const reveal=new IntersectionObserver((items)=>items.forEach((i)=>{if(i.isIntersecting)i.target.classList.add('seen')}),{threshold:.15});document.querySelectorAll('.card,.step,.terminal,.doc-link').forEach((n)=>reveal.observe(n));"
    return s
}

vein site_button(label: obsidian, href: obsidian, secondary: bool) -> obsidian {
    if (secondary) {
        return odl.a("btn secondary", href, label)
    }
    return odl.a("btn", href, label)
}

vein site_terminal(title: obsidian, code: obsidian) -> obsidian {
    return odl.div("terminal", odl.div("terminal-head", title) + odl.code_block(code))
}

vein site_card(title: obsidian, body: obsidian, key: obsidian) -> obsidian {
    forge h = odl.h3(title)
    forge p = odl.p("", body)
    if (key != "") {
        h = "<h3 data-i18n=\"" + key + "Title\">" + title + "</h3>"
        p = "<p data-i18n=\"" + key + "Body\">" + body + "</p>"
    }
    return odl.article("card", h + p)
}

vein site_section_head(title_key: obsidian, title: obsidian, lead_key: obsidian, lead: obsidian) -> obsidian {
    return odl.div("section-head", "<h2 data-i18n=\"" + title_key + "\">" + title + "</h2>" + "<p data-i18n=\"" + lead_key + "\">" + lead + "</p>")
}

vein site_doc_link(href: obsidian, title: obsidian, text: obsidian) -> obsidian {
    return odl.a("doc-link", href, odl.strong(title) + odl.span("", text))
}

vein doc_dual(pt: obsidian, en: obsidian) -> obsidian {
    return odl.div("doc-intro", odl.p("", pt))
}

vein doc_section(id: obsidian, title: obsidian, pt: obsidian, en: obsidian, extra: obsidian) -> obsidian {
    return odl.section(id, "doc-section", odl.h2(title) + doc_dual(pt, en) + extra)
}

vein doc_toc(items: obsidian) -> obsidian {
    return "<aside class=\"toc\">" + odl.strong("Nesta pagina") + items + "</aside>"
}

vein doc_link(id: obsidian, title: obsidian) -> obsidian {
    return "<a href=\"#" + id + "\">" + title + "</a>"
}

vein doc_page(title: obsidian, subtitle: obsidian, toc: obsidian, body: obsidian) -> obsidian {
    return odl.section("", "band", odl.div("wrap doc-layout", doc_toc(toc) + odl.div("doc-main", body)))
}

vein module_card(name: obsidian, text: obsidian) -> obsidian {
    return odl.div("module", "<code>" + name + "</code>" + odl.p("", text))
}

vein site_language_select(current: obsidian, pt_href: obsidian, en_href: obsidian, es_href: obsidian) -> obsidian {
    forge pt_selected = ""
    forge en_selected = ""
    forge es_selected = ""
    if (current == "pt") { pt_selected = " selected" }
    if (current == "en") { en_selected = " selected" }
    if (current == "es") { es_selected = " selected" }
    return "<select class=\"language-select\" data-language-select aria-label=\"Idioma\"><option data-href=\"" + pt_href + "\" value=\"pt\"" + pt_selected + ">Portugues</option><option data-href=\"" + en_href + "\" value=\"en\"" + en_selected + ">English</option><option data-href=\"" + es_href + "\" value=\"es\"" + es_selected + ">Espanol</option></select>"
}

vein site_search(label: obsidian) -> obsidian {
    return "<span class=\"search-box\"><button class=\"search-button\" type=\"button\" title=\"" + label + "\" aria-label=\"" + label + "\" aria-expanded=\"false\">&#128269;</button><input data-site-search type=\"search\" placeholder=\"" + label + "\" aria-label=\"" + label + "\"><span class=\"search-count\" aria-live=\"polite\"></span></span>"
}

vein site_topbar() -> obsidian {
    forge brand = odl.a("brand", "#top", odl.img("assets/ofs-256.png", "OFS logo") + odl.span("", "Obsidian Fault Script"))
    forge tools = odl.div("nav-tools", site_language_select("pt", "index.html", "en/index.html", "es/index.html") + site_search("Buscar"))
    forge links = odl.div("links", "<a href=\"#docs\" data-i18n=\"navDocs\">Documentacao</a><a href=\"downloads.html\" data-i18n=\"navRelease\">Downloads</a><a href=\"#benchmark\" data-i18n=\"navBench\">Benchmark</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein site_hero() -> obsidian {
    forge left = "<h1 data-i18n=\"title\">OFS compila, roda nativo e constroi a Web.</h1>"
    left = left + "<p class=\"lead\" data-i18n=\"lead\">Uma linguagem self-hosted com LLVM, runtime nativo, ODL para documentos e OES para estilo, efeitos e movimento.</p>"
    left = left + odl.div("actions", site_button("Comecar", "GETTING_STARTED.md", false) + site_button("Downloads", "downloads.html", true) + site_button("GitHub", "https://github.com/Samwns/Obsidian-Fault-Script", true))
    forge code = "attach {webui}\n\ncore main() {\n    forge body = webui.hero(\n        \"OFS Web\",\n        \"site oficial em OFS\",\n        webui.button(\"Docs\", \"#docs\")\n    )\n\n    webui.serve(8080, \"OFS\", body)\n}"
    return odl.section("", "hero", odl.div("wrap hero-grid", odl.div("", left) + site_terminal("exemplo.ofs", code)))
}

vein site_pillars() -> obsidian {
    forge cards = site_card("Self-hosted", "Lexer, parser, type checker e geracao LLVM vivem no compilador OFS.", "p1")
    cards = cards + site_card("Nativa", "A saida e LLVM IR linkada com libofs_runtime.a para gerar executaveis.", "p2")
    cards = cards + site_card("Hibrida", "Console, canvas/window nativo e sites via webserver/webui no mesmo ecossistema.", "p3")
    forge body = site_section_head("pillarsTitle", "O que e a OFS", "pillarsLead", "Uma linguagem para aprender, compilar e descer perto do sistema quando precisar.") + odl.div("grid", cards)
    return odl.section("", "band", odl.div("wrap", body))
}

vein site_web() -> obsidian {
    forge code = "attach {odl}\nattach {oes}\nattach {webserver}\n\ncore main() {\n    forge head = odl.css(\"site.css\")\n    forge body = odl.main(\"app\", odl.h1(\"OFS Web\"))\n    webserver.serve_html_forever(8080, odl.document(\"pt\", \"OFS\", \"site\", head, body))\n}"
    forge body = site_section_head("webTitle", "ODL + OES", "webLead", "ODL descreve documentos; OES define estilo, efeitos, responsividade e animacoes.") + site_terminal("site.ofs", code)
    return odl.section("web", "band", odl.div("wrap", body))
}

vein site_benchmark() -> obsidian {
    forge body = site_section_head("benchTitle", "Benchmark reproduzivel", "benchLead", "CPU, memoria, startup, compilacao e tamanho de artefato medidos com processos reais.")
    body = body + "<div class=\"metric-tabs\"><button type=\"button\" data-metric=\"cpu\">CPU</button><button type=\"button\" data-metric=\"memory\">Memoria</button><button type=\"button\" data-metric=\"startup\">Inicializacao</button><button type=\"button\" data-metric=\"compile\">Compilacao</button><button type=\"button\" data-metric=\"artifact\">Artefato</button></div>"
    body = body + odl.div("card", "<p id=\"benchmark-meta\" class=\"kicker\">Carregando benchmark...</p><p id=\"benchmark-note\" class=\"benchmark-note\"></p><strong id=\"metric-label\">CPU mediana</strong><div class=\"bars\" id=\"benchmark-bars\"></div>")
    body = body + odl.div("table-wrap", odl.table("<tr><th>Linguagem</th><th>Mediana</th><th>Relativo</th><th>Checksum</th></tr>", ""))
    return odl.section("benchmark", "band", odl.div("wrap", body))
}

vein site_docs() -> obsidian {
    forge links = site_doc_link("GETTING_STARTED.md", "Getting Started", "Install, run, build and check OFS files.")
    links = links + site_doc_link("LANGUAGE_REFERENCE.md", "Language Reference", "Syntax, types, control flow and modules.")
    links = links + site_doc_link("COMPILER_ARCHITECTURE.md", "Compiler Architecture", "Self-hosted frontend and LLVM backend.")
    links = links + site_doc_link("WEB_UI.md", "Web UI", "Build OFS-powered static web pages.")
    links = links + site_doc_link("VISUAL_UI.md", "Native Visual UI", "Canvas, window and immediate UI helpers.")
    links = links + site_doc_link("GITHUB_REGISTRATION.md", "GitHub Registration", "Linguist and repository language recognition.")
    forge body = site_section_head("docsTitle", "Documentacao", "docsLead", "Guias tecnicos para linguagem, compilador, bootstrap, UI e publicacao.") + odl.div("docs-list", links)
    return odl.section("docs", "band", odl.div("wrap", body))
}

vein site_release() -> obsidian {
    forge cards = "<a class=\"download-card\" data-release-asset=\"debian-ubuntu\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Debian / Ubuntu</strong><span>.deb x64 com OFS, ODL, OES e stdlib.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"fedora\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Fedora / RHEL / openSUSE</strong><span>.rpm x64 para distros da familia Red Hat e compativeis.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"arch\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Arch / Manjaro</strong><span>Pacote pacman com ferramentas nativas.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"macos-arm64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>macOS ARM64</strong><span>Instalador para Apple Silicon.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"windows-x64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Windows x64</strong><span>Instalador com launcher e runtime.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\".vsix\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>VS Code</strong><span>Extensao com OFS, ODL, OES, Go Live e tradutor.</span><code data-release-version>latest</code></a>"
    forge body = site_section_head("releaseTitle", "Downloads", "releaseLead", "Baixe instaladores oficiais, pacote VS Code e checksums gerados pelo GitHub Actions.")
    body = body + odl.div("download-grid", cards)
    body = body + odl.div("actions", "<a class=\"btn\" data-release-asset=\"CHECKSUMS\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\">Checksums</a>" + site_button("Todas as releases", "https://github.com/Samwns/Obsidian-Fault-Script/releases", true))
    return odl.section("release", "band", odl.div("wrap", body))
}

vein site_release_en() -> obsidian {
    forge cards = "<a class=\"download-card\" data-release-asset=\"debian-ubuntu\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Debian / Ubuntu</strong><span>.deb x64 package with OFS, ODL, OES, and stdlib.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"fedora\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Fedora / RHEL / openSUSE</strong><span>.rpm x64 package for Red Hat-family and compatible distributions.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"arch\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Arch / Manjaro</strong><span>Pacman package with native tools.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"macos-arm64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>macOS ARM64</strong><span>Installer for Apple Silicon.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\"windows-x64\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>Windows x64</strong><span>Installer with launcher and runtime.</span><code data-release-version>latest</code></a>"
    cards = cards + "<a class=\"download-card\" data-release-asset=\".vsix\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\"><strong>VS Code</strong><span>Extension with OFS, ODL, OES, Go Live, and translator tools.</span><code data-release-version>latest</code></a>"
    forge body = odl.div("download-grid", cards)
    body = body + odl.div("actions", "<a class=\"btn\" data-release-asset=\"CHECKSUMS\" href=\"https://github.com/Samwns/Obsidian-Fault-Script/releases/latest\">Checksums</a>" + site_button("All releases", "https://github.com/Samwns/Obsidian-Fault-Script/releases", true))
    return body
}

vein site_page() -> obsidian {
    forge head = odl.icon("assets/ofs-256.png") + odl.css("assets/site.css")
    forge body = site_topbar()
    body = body + odl.main("top", site_hero() + site_pillars() + site_web() + site_benchmark() + site_docs() + site_release())
    body = body + odl.footer("footer", "<div class=\"wrap\" data-i18n=\"footer\">OFS e um projeto experimental de linguagem compilada. Site gerado pela propria OFS para GitHub Pages.</div>") + odl.script("assets/site.js")
    return odl.document("pt", "Obsidian Fault Script", "Official site and documentation for Obsidian Fault Script.", head, body)
}

vein site_page_root() -> obsidian {
    forge head = odl.icon("ofs-256.png") + odl.css("site.css")
    forge body = site_topbar_root()
    body = body + odl.main("top", site_hero_root() + site_pillars() + site_web() + site_benchmark() + site_docs_root() + site_release())
    body = body + odl.footer("footer", "<div class=\"wrap\" data-i18n=\"footer\">OFS e um projeto experimental de linguagem compilada. Site gerado pela propria OFS para GitHub Pages.</div>") + odl.script("site.js")
    return odl.document("pt", "Obsidian Fault Script", "Official site and documentation for Obsidian Fault Script.", head, body)
}

vein site_topbar_root() -> obsidian {
    forge brand = odl.a("brand", "#top", odl.img("ofs-256.png", "OFS logo") + odl.span("", "Obsidian Fault Script"))
    forge tools = odl.div("nav-tools", site_language_select("pt", "index.html", "en/index.html", "es/index.html") + site_search("Buscar"))
    forge links = odl.div("links", "<a href=\"#docs\" data-i18n=\"navDocs\">Documentacao</a><a href=\"downloads.html\" data-i18n=\"navRelease\">Downloads</a><a href=\"#benchmark\" data-i18n=\"navBench\">Benchmark</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein site_hero_root() -> obsidian {
    forge left = "<h1 data-i18n=\"title\">OFS compila, roda nativo e constroi a Web.</h1>"
    left = left + "<p class=\"lead\" data-i18n=\"lead\">Uma linguagem self-hosted com LLVM, runtime nativo, ODL para documentos e OES para estilo, efeitos e movimento.</p>"
    left = left + odl.div("actions", site_button("Comecar", "getting-started.html", false) + site_button("Downloads", "downloads.html", true) + site_button("GitHub", "https://github.com/Samwns/Obsidian-Fault-Script", true))
    forge code = "attach {odl}\nattach {oes}\n\nvein page() -> obsidian {\n    forge head = odl.css(\"site.css\")\n    forge body = odl.h1(\"OFS Web\")\n    return odl.document(\"pt\", \"OFS\", \"site oficial\", head, body)\n}"
    return odl.section("", "hero", odl.div("wrap hero-grid", odl.div("", left) + site_terminal("exemplo.ofs", code)))
}

vein site_docs_root() -> obsidian {
    forge links = site_doc_link("getting-started.html", "Comecando", "Instale, verifique, rode, compile e publique.")
    links = links + site_doc_link("language.html", "Linguagem OFS", "Sintaxe, tipos, modulos e modos de baixo nivel.")
    links = links + site_doc_link("compiler.html", "Compilador", "Pipeline self-hosted, LLVM IR e linkagem nativa.")
    links = links + site_doc_link("odl.html", "ODL", "Referencia da Obsidian Document Language.")
    links = links + site_doc_link("oes.html", "OES", "Referencia da Obsidian Effect Scripts.")
    links = links + site_doc_link("playground.html", "Tradutor Web", "Traduza ODL, OES, HTML e CSS no navegador.")
    links = links + site_doc_link("webserver.html", "Web Server", "Sirva sites gerados por OFS via HTTP.")
    links = links + site_doc_link("webui.html", "Web UI", "Componentes, paginas e composicao de sites.")
    links = links + site_doc_link("stdlib.html", "Biblioteca Padrao", "Modulos distribuidos com OFS.")
    links = links + site_doc_link("packages.html", "Pacotes", "Registro, instalacao e fluxo de publicacao.")
    links = links + site_doc_link("vscode.html", "VS Code", "Sintaxe, comandos e Go Live.")
    links = links + site_doc_link("commands.html", "Comandos CLI", "Check, run, build, IR e assembly.")
    links = links + site_doc_link("benchmark.html", "Benchmark", "CPU, memoria, startup, build e tamanho.")
    links = links + site_doc_link("benchmark.html#hotspots", "Otimizacao", "Gargalos medidos e ordem segura de trabalho.")
    links = links + site_doc_link("github.html", "Reconhecimento GitHub", "Linguist, gramatica, exemplos e registro.")
    forge body = site_section_head("docsTitle", "Documentacao", "docsLead", "Guias tecnicos para linguagem, compilador, bootstrap, UI e publicacao.") + odl.div("docs-list", links)
    return odl.section("docs", "band", odl.div("wrap", body))
}

vein page_nav() -> obsidian {
    forge brand = odl.a("brand", "index.html", odl.img("ofs-256.png", "OFS logo") + odl.span("", "OFS"))
    forge tools = odl.div("nav-tools", site_language_select("pt", "index.html", "en/index.html", "es/index.html") + site_search("Buscar"))
    forge links = odl.div("links", "<a href=\"language.html\">Linguagem</a><a href=\"odl.html\">ODL</a><a href=\"oes.html\">OES</a><a href=\"downloads.html\">Downloads</a><a href=\"playground.html\">Tradutor</a><a href=\"commands.html\">CLI</a><a href=\"benchmark.html\">Benchmark</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein page_shell(title: obsidian, subtitle: obsidian, content: obsidian) -> obsidian {
    forge head = odl.icon("ofs-256.png") + odl.css("site.css")
    forge hero = odl.section("", "band", odl.div("wrap", odl.h1(title) + odl.p("lead", subtitle)))
    forge body = page_nav() + odl.main("top", hero + content) + odl.footer("footer", "<div class=\"wrap\">Gerado por ODL e OES em OFS.</div>") + odl.script("site.js")
    return odl.document("pt", title + " - OFS", subtitle, head, body)
}

vein page_language() -> obsidian {
    forge toc = doc_link("overview", "Visao geral") + doc_link("types", "Tipos") + doc_link("bindings", "Variaveis") + doc_link("operators", "Operadores") + doc_link("functions", "Funcoes") + doc_link("flow", "Controle") + doc_link("collections", "Colecoes") + doc_link("structures", "Estruturas") + doc_link("errors", "Falhas") + doc_link("modules", "Modulos") + doc_link("low", "Baixo nivel") + doc_link("build", "Compilacao")
    forge syntax = site_terminal("hello.ofs", "// OFS source\nvein add(a: stone, b: stone) -> stone {\n    return a + b\n}\n\ncore main() {\n    forge result: stone = add(20, 2)\n    echo(result)\n}")
    forge types = "<table class=\"api-table\"><thead><tr><th>Tipo</th><th>Representacao/uso</th><th>Exemplo</th></tr></thead><tbody><tr><td><code>stone</code></td><td>Inteiro principal de 64 bits.</td><td><code>forge n: stone = 42</code></td></tr><tr><td><code>crystal</code></td><td>Ponto flutuante de 64 bits.</td><td><code>forge pi: crystal = 3.14</code></td></tr><tr><td><code>obsidian</code></td><td>Texto terminado em zero no runtime atual.</td><td><code>forge name = \"OFS\"</code></td></tr><tr><td><code>bool</code></td><td>Valor logico.</td><td><code>forge ready = true</code></td></tr><tr><td><code>u8..u64 / i8..i32</code></td><td>Inteiros com largura explicita.</td><td><code>forge channel: u8 = 255</code></td></tr><tr><td><code>Array&lt;T&gt;</code></td><td>Colecao dinamica homogenea.</td><td><code>forge values = [1, 2, 3]</code></td></tr><tr><td><code>monolith</code></td><td>Estrutura nomeada com campos.</td><td><code>monolith Point { x: stone }</code></td></tr></tbody></table>"
    forge bindings = "<table class=\"api-table\"><thead><tr><th>Forma</th><th>Comportamento</th></tr></thead><tbody><tr><td><code>forge name = value</code></td><td>Cria variavel com tipo inferido.</td></tr><tr><td><code>forge name: Type = value</code></td><td>Cria variavel com tipo declarado.</td></tr><tr><td><code>const name: Type = value</code></td><td>Declara valor constante.</td></tr><tr><td><code>=, +=, -=, *=, /=</code></td><td>Atribuicao simples e composta.</td></tr><tr><td><code>++ / --</code></td><td>Incremento e decremento de inteiros.</td></tr></tbody></table>"
    forge operators = "<table class=\"api-table\"><thead><tr><th>Grupo</th><th>Operadores</th><th>Resultado</th></tr></thead><tbody><tr><td>Aritmetica</td><td><code>+ - * / %</code></td><td>Opera numeros; <code>+</code> tambem concatena texto.</td></tr><tr><td>Comparacao</td><td><code>== != &lt; &lt;= &gt; &gt;=</code></td><td>Produz <code>bool</code>.</td></tr><tr><td>Logica</td><td><code>&amp;&amp; || !</code></td><td>Combina ou inverte condicoes.</td></tr><tr><td>Bits</td><td><code>&amp; | ^ &lt;&lt; &gt;&gt;</code></td><td>Opera a representacao inteira.</td></tr><tr><td>Ponteiro</td><td><code>&amp;value *pointer</code></td><td>Obtem endereco e acessa o valor apontado dentro de contexto baixo nivel.</td></tr><tr><td>Conversao</td><td><code>value as Type</code></td><td>Solicita conversao explicita validada pelo type checker.</td></tr></tbody></table>"
    forge functions = site_terminal("functions.ofs", "vein square(x: stone) -> stone intent pure {\n    return x * x\n}\n\nvein apply(x: stone, fn: vein(stone) -> stone) -> stone {\n    return fn(x)\n}\n\ncore main() {\n    forge double = vein(x: stone) -> stone {\n        return x * 2\n    }\n    echo(apply(5, double))\n}")
    forge flow = site_terminal("flow.ofs", "if (score >= 10) {\n    echo(\"ok\")\n} else {\n    echo(\"retry\")\n}\n\nwhile (running) {\n    tick()\n}\n\ncycle (forge i = 0; i < 10; i++) {\n    echo(i)\n}")
    forge structures = site_terminal("point.ofs", "monolith Point {\n    x: stone\n    y: stone\n}\n\nimpl Point {\n    vein sum(self) -> stone {\n        return self.x + self.y\n    }\n}")
    forge collections = site_terminal("collections.ofs", "forge values = [10, 20, 30]\nvalues[1] = 25\n\ncycle (forge i: stone = 0; i < ofs_array_len(values); i++) {\n    echo(values[i])\n}")
    forge errors = site_terminal("errors.ofs", "vein require_positive(value: stone) -> stone {\n    if (value < 0) {\n        throw \"negative value\"\n    }\n    return value\n}\n\ncore main() {\n    tremor {\n        echo(require_positive(-1))\n    } catch (message: obsidian) {\n        echo(message)\n    }\n}")
    forge module_grid = odl.div("module-grid", module_card("attach {math}", "Importa funcoes da biblioteca padrao por nome.") + module_card("attach {F:path/file.ofs}", "Importa um arquivo OFS local explicitamente.") + module_card("extern vein", "Declara simbolos oferecidos pelo runtime ou por C.") + module_card("core main()", "Define o ponto de entrada do programa nativo."))
    forge body = doc_section("overview", "Modelo da linguagem", "OFS e compilada e estaticamente tipada. O frontend self-hosted expande imports, cria tokens, monta AST, verifica tipos e gera LLVM IR. `core main()` define o executavel; bibliotecas podem conter apenas funcoes, tipos e constantes.", "", syntax)
    body = body + doc_section("types", "Sistema de tipos", "Tipos primitivos cobrem numeros, texto e logica. Inteiros de largura explicita ajudam FFI e dados binarios. Arrays guardam elementos do mesmo tipo, e monoliths agrupam campos nomeados.", "", odl.div("table-wrap", types))
    body = body + doc_section("bindings", "Variaveis, constantes e atribuicao", "`forge` cria armazenamento local ou global. O tipo pode ser inferido pelo inicializador ou escrito explicitamente. `const` expressa valor que nao deve ser reatribuido.", "", odl.div("table-wrap", bindings))
    body = body + doc_section("operators", "Operadores e conversoes", "A precedencia segue a ordem comum: multiplicacao antes de soma, comparacoes antes de logica e atribuicao por ultimo. Use parenteses quando a ordem fizer parte da intencao do codigo. Casts com `as` sao explicitos; ponteiros exigem um contexto de baixo nivel.", "", odl.div("table-wrap", operators))
    body = body + doc_section("functions", "Funcoes, intents e lambdas", "`vein` declara uma funcao. Parametros e retorno recebem tipos. `intent pure`, `impure` e `fractal` registram intencao sem substituir a verificacao de tipos. Funcoes podem ser valores e lambdas usam a mesma palavra `vein`.", "", functions)
    body = body + doc_section("flow", "Controle de fluxo", "`if/else` escolhe caminhos, `while` repete enquanto a condicao for verdadeira e `cycle` oferece inicializacao, condicao e passo. `break` e `continue` atuam sobre o loop atual; `return` encerra a funcao.", "", flow)
    body = body + doc_section("collections", "Arrays e indexacao", "Literais de array inferem um tipo homogeneo. O indice comeca em zero, leitura e escrita usam colchetes e `ofs_array_len` informa o numero de elementos. O runtime verifica limites; acessar uma posicao inexistente e erro de execucao.", "", collections)
    body = body + doc_section("structures", "Monolith, impl, namespace e strata", "`monolith` define layout de dados; `impl` agrupa metodos; `namespace` organiza nomes; `strata` representa variantes etiquetadas em evolucao. Layout `packed` existe para integracao binaria explicita.", "", structures)
    body = body + doc_section("errors", "Tremor, catch e throw", "`throw` interrompe o caminho atual com um valor de falha. `tremor` delimita o codigo observado e `catch` recebe a falha. O tipo escrito no catch documenta o contrato esperado; recursos manuais alocados antes da falha continuam sob responsabilidade do programa.", "", errors)
    body = body + doc_section("modules", "Imports e fronteira externa", "`attach {nome}` procura stdlib/pacotes; `attach {F:caminho}` inclui fonte local. `extern vein` declara simbolo do runtime ou biblioteca C. `rift vein` registra ABI externa experimental.", "", module_grid)
    forge low_modes = "<div class=\"module-grid\"><div class=\"module\"><code>fracture { ... }</code><p>Abre o contexto tipado de ponteiros. Nele, <code>shard p: *stone = &amp;x</code> cria um ponteiro e <code>*p</code> le ou escreve o valor apontado. O compilador continua verificando o tipo do ponteiro, mas validade de endereco e tempo de vida continuam sendo responsabilidade do programa.</p></div><div class=\"module\"><code>abyss { ... }</code><p>Marca trabalho cru e irrestrito. A sintaxe ainda passa pelo mesmo parser e type checker atual, portanto nao desliga magicamente toda verificacao. O nome serve como fronteira explicita para codigo que aceita maior risco e nao oferece garantia adicional de memoria.</p></div><div class=\"module\"><code>bedrock { ... }</code><p>Contexto tipado para os intrinsics de maquina e para a biblioteca <code>bedrock</code>: regioes, views, lanes, endian, prefetch e barreiras. Memoria criada por <code>bedrock_cell_new</code> ou <code>bedrock_region_new</code> deve ser liberada exatamente uma vez.</p></div><div class=\"module\"><code>intent fractal</code><p><code>fractal</code> e um intent de funcao, escrito depois do retorno. Ele registra a intencao de efeito da funcao; nao existe token de bloco <code>fractal {}</code> no parser atual. Intents ainda nao formam um sistema de efeitos com garantias estaticas completas.</p></div><div class=\"module\"><code>tectonic fracture</code><p><code>tectonic</code> e um prefixo aceito antes de <code>fracture</code>, <code>abyss</code> ou <code>bedrock</code>. Hoje ele preserva o mesmo bloco sem alterar a geracao LLVM. Nomes como <code>tectonic safe</code> e <code>tectonic fractal</code> nao sao formas suportadas.</p></div><div class=\"module\"><code>fault_*</code><p>Intrinsics incluem contagem de bits, leading/trailing zeros, byte swap, rotacoes, stepping de ponteiro, corte e patch de campos, weave, fence e prefetch. Eles baixam diretamente para operacoes LLVM e exigem tipos e larguras validos.</p></div></div>"
    forge low_example = site_terminal("low-level.ofs", "attach {bedrock}\n\ncore main() {\n    forge region: *stone = bedrock_region_new(4)\n    bedrock_region_write(region, 0, 10)\n    bedrock_region_add(region, 0, 5)\n    echo(bedrock_region_read(region, 0))\n    bedrock_region_drop(region)\n}")
    body = body + doc_section("low", "Baixo nivel: ponteiros, memoria e intrinsics", "O baixo nivel da OFS e opt-in e aparece no fonte. Esses blocos nao tornam um endereco valido, nao adicionam coleta de lixo e nao substituem liberacao de memoria. Use-os quando o contrato de tipos comum nao representa a operacao necessaria.", "", low_modes + low_example + odl.div("callout", "<strong>Responsabilidade:</strong> nao desreferencie ponteiro nulo ou expirado, nao acesse fora de uma regiao, nao use uma regiao depois de <code>bedrock_region_drop</code> e nao libere a mesma alocacao duas vezes."))
    body = body + doc_section("build", "Do fonte ao executavel", "`check` para apos analise; `run` gera binario temporario e executa; `build` grava o executavel; `ir` preserva LLVM IR; `asm` solicita assembly ao toolchain.", "", site_terminal("terminal", "ofs check app.ofs\nofs run app.ofs\nofs build app.ofs -o app\nofs ir app.ofs -o app.ll\nofs asm app.ofs -o app.s"))
    forge content = doc_page("Linguagem", "O nucleo tecnico da Obsidian Fault Script.", toc, body)
    return page_shell("Linguagem", "O nucleo tecnico da Obsidian Fault Script.", content)
}

vein page_getting_started() -> obsidian {
    forge code = "ofs/dist/ofs check app.ofs\nofs/dist/ofs run app.ofs\nofs/dist/ofs build app.ofs -o app\n./app\n\nofs/dist/ofs odl page.odl -o index.html\nofs/dist/ofs oes site.oes -o site.css"
    forge toc = doc_link("install", "Instalar") + doc_link("native", "Programa nativo") + doc_link("web", "Site OFS") + doc_link("verify", "Verificar")
    forge cards = site_card("1. Install", "Escolha o pacote da sua plataforma e instale o launcher `ofs`.", "")
    cards = cards + site_card("2. Create", "Use .ofs para logica, .odl para documento e .oes para efeito visual.", "")
    cards = cards + site_card("3. Verify", "Rode `check` antes de compilar ou publicar.", "")
    forge body = doc_section("install", "Instalacao / Installation", "Use a pagina de downloads para Linux, macOS, Windows e VS Code.", "Use the downloads page for Linux, macOS, Windows, and VS Code.", odl.div("actions", site_button("Abrir downloads", "downloads.html", false) + site_button("CLI", "commands.html", true)))
    body = body + doc_section("native", "Primeiro executavel", "Crie `app.ofs`, valide com `check`, rode com `run` e gere um binario com `build`.", "Create `app.ofs`, validate with `check`, run with `run`, and build a native binary with `build`.", site_terminal("terminal", code))
    body = body + doc_section("web", "Primeiro site", "Crie `page.odl` e `site.oes`. A OFS gera HTML/CSS para qualquer hospedagem estatica.", "Create `page.odl` and `site.oes`. OFS generates HTML/CSS for any static host.", odl.div("grid", cards))
    body = body + doc_section("verify", "Checklist", "Sempre teste sintaxe, geracao web, assets e release antes de publicar.", "Always test syntax, web generation, assets, and release packaging before publishing.", odl.div("callout", "O fluxo oficial usa GitHub Actions para Build & Test, Auto Release e GitHub Pages."))
    forge content = doc_page("Comecando", "Da instalacao ao primeiro executavel e site nativo em OFS.", toc, body)
    return page_shell("Comecando", "Da instalacao ao primeiro executavel e site nativo em OFS.", content)
}

vein page_downloads() -> obsidian {
    forge toc = doc_link("assets", "Assets") + doc_link("linux", "Linux") + doc_link("editor", "Editor") + doc_link("checks", "Checksums")
    forge body = doc_section("assets", "Downloads oficiais", "Os cards buscam a ultima release no GitHub e apontam para os assets publicados.", "The cards fetch the latest GitHub release and point to published assets.", site_release())
    body = body + doc_section("linux", "Linux", "Debian/Ubuntu usam .deb, Fedora/RHEL/openSUSE usam .rpm e Arch/Manjaro usam pacote pacman.", "Debian/Ubuntu use .deb, Fedora/RHEL/openSUSE use .rpm, and Arch/Manjaro use a pacman package.", site_terminal("install", "# Debian / Ubuntu\nsudo dpkg -i ofs-debian-ubuntu-x64-installer-v*.deb\n\n# Fedora / RHEL / openSUSE\nsudo rpm -Uvh ofs-fedora-x64-installer-v*.rpm\n\n# Arch / Manjaro\nsudo pacman -U ofs-arch-x64-installer-v*.pkg.tar.zst"))
    body = body + doc_section("editor", "VS Code", "A extensao inclui syntax highlighting, diagnosticos, comandos, Go Live, ODL e OES.", "The extension includes syntax highlighting, diagnostics, commands, Go Live, ODL, and OES.", site_terminal("extension", "code --install-extension obsidian-fault-script-*.vsix"))
    body = body + doc_section("checks", "Integridade", "Use o arquivo CHECKSUMS para conferir o download antes de instalar.", "Use the CHECKSUMS file to verify downloads before installing.", odl.div("callout", "Toda release oficial e produzida pelo workflow Auto Release."))
    forge content = doc_page("Downloads", "Instaladores oficiais, pacote VS Code, checksums e comandos de instalacao.", toc, body)
    return page_shell("Downloads", "Instaladores oficiais, pacote VS Code, checksums e comandos de instalacao.", content)
}

vein page_compiler() -> obsidian {
    forge flow = odl.div("workflow", odl.div("step", "<strong>Lexer</strong><br>Fonte para tokens.") + odl.div("step", "<strong>Parser</strong><br>Tokens para AST.") + odl.div("step", "<strong>Semantica</strong><br>Tipos e simbolos.") + odl.div("step", "<strong>LLVM</strong><br>IR e linkagem nativa."))
    forge toc = doc_link("pipeline", "Pipeline") + doc_link("self", "Self-hosted") + doc_link("artifacts", "Artefatos")
    forge body = doc_section("pipeline", "Pipeline", "O compilador le o fonte, tokeniza, monta AST, valida semantica, gera LLVM IR e linka com runtime.", "The compiler reads source, tokenizes, builds an AST, validates semantics, emits LLVM IR, and links with the runtime.", flow + site_terminal("pipeline", "source.ofs -> tokens -> AST -> semantic model -> LLVM IR -> native executable"))
    body = body + doc_section("self", "Self-hosted", "O compilador principal fica em `ofs/ofscc`. Isso permite evoluir a linguagem usando a propria linguagem.", "The main compiler lives in `ofs/ofscc`. This lets the language evolve using itself.", odl.div("callout", "O bootstrap ainda preserva ferramentas de distribuicao para gerar instaladores limpos."))
    body = body + doc_section("artifacts", "Artefatos", "`check` valida, `ir` mostra LLVM IR, `asm` gera assembly, `build` produz executavel.", "`check` validates, `ir` shows LLVM IR, `asm` emits assembly, and `build` produces an executable.", site_terminal("commands", "ofs check app.ofs\nofs ir app.ofs\nofs asm app.ofs -o app.s\nofs build app.ofs -o app"))
    forge content = doc_page("Compilador", "O frontend self-hosted da OFS e o backend nativo LLVM.", toc, body)
    return page_shell("Compilador", "O frontend self-hosted da OFS e o backend nativo LLVM.", content)
}

vein page_odl() -> obsidian {
    forge code = "page \"OFS Web\" \"pt\"\nskin \"theme.css\"\nflow\n  deck.topbar\n    title1 \"OFS Web\"\n    link.button \"Documentacao\" \"#docs\"\n  stage#content\n    band.docs\n      mark \"## Documentos nativos\\nEscreva **ODL**, gere HTML.\"\n      raw \"<custom-element></custom-element>\"\n  spark \"app.js\""
    forge api = "<table class=\"api-table\"><thead><tr><th>Forma</th><th>Uso</th></tr></thead><tbody><tr><td><code>page / skin / flow</code></td><td>Documento, estilo e corpo com nomes proprios do OFS.</td></tr><tr><td><code>deck / stage / band / tile</code></td><td>Estrutura semantica gerada como nav, main, section e article.</td></tr><tr><td><code>mark</code></td><td>Markdown nativo dentro do documento.</td></tr><tr><td><code>raw</code></td><td>Interop explicita com HTML quando precisar.</td></tr><tr><td><code>wire / spark / pulse / server</code></td><td>Scripts de browser, modulo estilo Node, inline JS e templates PHP.</td></tr><tr><td><code>studio</code></td><td>Modo local para editar posicionamento visual e exportar OES.</td></tr></tbody></table>"
    forge toc = doc_link("model", "Modelo") + doc_link("syntax", "Sintaxe") + doc_link("interop", "Interop") + doc_link("api", "Referencia")
    forge body = doc_section("model", "Modelo ODL", "ODL e a linguagem de documentos da OFS. Ela nao substitui o navegador: ela gera HTML padrao como artefato.", "ODL is the OFS document language. It does not replace the browser: it generates standard HTML as an artifact.", odl.div("grid", site_card("Documentos", "Fonte .odl compilada pelo launcher OFS.", "") + site_card("Componentes", "Blocos indentados podem virar funcoes reutilizaveis.", "") + site_card("Hospedagem", "HTML gerado roda em GitHub Pages, nginx, CDN ou webserver OFS.", "")))
    body = body + doc_section("syntax", "Sintaxe propria", "ODL usa `page`, `skin`, `flow`, `deck`, `stage`, `band`, `tile`, `mark` e `raw` para ficar mais perto da tematica OFS.", "ODL uses `page`, `skin`, `flow`, `deck`, `stage`, `band`, `tile`, `mark`, and `raw` so the source feels native to OFS.", site_terminal("page.odl", code))
    body = body + doc_section("interop", "Markdown, HTML, JS, PHP e Node", "`mark` aceita Markdown, `raw` aceita HTML, `spark` importa JS module, `pulse` injeta JS inline e `server` pode preservar templates PHP.", "`mark` accepts Markdown, `raw` accepts HTML, `spark` imports JS modules, `pulse` injects inline JS, and `server` can preserve PHP templates.", odl.div("callout", "O objetivo e autorar em ODL sem perder interoperabilidade quando um projeto precisar de codigo legado."))
    body = body + doc_section("api", "Tabela de formas", "A tabela abaixo resume a superficie atual da linguagem.", "The table below summarizes the current language surface.", odl.div("table-wrap", api))
    forge content = doc_page("ODL", "Obsidian Document Language: a camada estrutural de documentos para sites OFS.", toc, body)
    return page_shell("ODL", "Obsidian Document Language: a camada estrutural de documentos para sites OFS.", content)
}

vein page_oes() -> obsidian {
    forge code = "gem accent \"#29e0bd\"\ngem surface \"#101722\"\npaint .button\n  fill \"$accent\"\n  curve \"8px\"\n  transition \"transform .2s ease\"\nveil \"(max-width: 700px)\"\n  paint .grid\n    grid-cols \"1fr\"\npulse \"enter\"\n  rise\n    opacity \"0\"\n  rest\n    opacity \"1\""
    forge api = "<table class=\"api-table\"><thead><tr><th>Forma</th><th>Uso</th></tr></thead><tbody><tr><td><code>gem nome valor</code></td><td>Token de design compilado para variavel CSS.</td></tr><tr><td><code>paint seletor</code></td><td>Bloco indentado de declaracoes visuais.</td></tr><tr><td><code>veil / guard / strata</code></td><td>Responsividade, suporte de plataforma e camadas.</td></tr><tr><td><code>pulse / rise / rest / atNN</code></td><td>Linha do tempo de animacao.</td></tr><tr><td><code>fill / ink / curve / space</code></td><td>Vocabulario OES para propriedades comuns sem perder compatibilidade.</td></tr></tbody></table>"
    forge toc = doc_link("model", "Modelo") + doc_link("syntax", "Sintaxe") + doc_link("motion", "Motion") + doc_link("api", "Referencia")
    forge body = doc_section("model", "Modelo OES", "OES e a camada de efeito: tokens, regras visuais, responsividade, animacao e comportamento visual seguro.", "OES is the effect layer: tokens, visual rules, responsiveness, animation, and safer visual behavior.", odl.div("grid", site_card("Gemas", "Tokens de design versionaveis.", "") + site_card("Pintura", "Blocos `paint` geram regras visuais.", "") + site_card("Veus", "`veil` e `guard` controlam responsividade e suporte.", "")))
    body = body + doc_section("syntax", "Sintaxe propria", "OES preserva o poder do CSS, mas usa nomes como `gem`, `paint`, `fill`, `ink`, `curve`, `space`, `veil` e `pulse`.", "OES preserves CSS power while using names such as `gem`, `paint`, `fill`, `ink`, `curve`, `space`, `veil`, and `pulse`.", site_terminal("theme.oes", code))
    body = body + doc_section("motion", "Motion e layout", "`pulse`, `rise`, `rest` e `atNN` organizam animacoes. O editor pode usar essa fonte para ajustes visuais e exportar OES.", "`pulse`, `rise`, `rest`, and `atNN` organize animations. The editor can use this source for visual adjustments and export OES.", odl.div("callout", "A saida continua CSS padrao para o navegador, mas a fonte oficial do projeto fica em OES."))
    body = body + doc_section("api", "Tabela de formas", "A tabela abaixo mostra os blocos e aliases principais.", "The table below shows the main blocks and aliases.", odl.div("table-wrap", api))
    forge content = doc_page("OES", "Obsidian Effect Scripts: estilo, responsividade e movimento para documentos ODL.", toc, body)
    return page_shell("OES", "Obsidian Effect Scripts: estilo, responsividade e movimento para documentos ODL.", content)
}

vein page_playground() -> obsidian {
    forge sample = "page \"OFS Playground\" \"pt\"\nskin \"theme.css\"\nflow\n  stage.demo\n    title1 \"ODL roda aqui\"\n    mark \"Escreva **documentos** sem autorar HTML.\"\n    link.button \"Abrir documentacao\" \"odl.html\""
    forge controls = "<div class=\"tool-controls\"><select id=\"translator-mode\" aria-label=\"Direcao da traducao\"><option value=\"odl-html\">ODL para HTML</option><option value=\"oes-css\">OES para CSS</option><option value=\"html-odl\">HTML para ODL</option><option value=\"css-oes\">CSS para OES</option></select><button id=\"translator-run\" class=\"btn\" type=\"button\">Traduzir</button></div>"
    forge editors = "<div class=\"tool-layout\"><div class=\"tool-pane\"><label for=\"translator-input\">Fonte</label><textarea id=\"translator-input\">" + sample + "</textarea></div><div class=\"tool-pane\"><label for=\"translator-output\">Artefato gerado</label><textarea id=\"translator-output\" readonly></textarea></div></div><h2>Previa no navegador</h2><iframe id=\"translator-preview\" class=\"preview-frame\" title=\"Previa da pagina gerada\" sandbox=\"allow-scripts\"></iframe>"
    forge content = odl.section("", "band", odl.div("wrap", controls + editors))
    return page_shell("Tradutor ODL/OES", "Um tradutor no navegador que acompanha o pipeline nativo das linguagens web da OFS.", content)
}

vein page_webserver() -> obsidian {
    forge code = "attach {odl}\nattach {webserver}\n\ncore main() {\n    forge body = odl.h1(\"Servidor OFS\") + odl.p(\"\", \"Resposta gerada pela linguagem\")\n    forge html = odl.document(\"pt\", \"Servidor OFS\", \"Exemplo HTTP\", \"\", body)\n    webserver.serve_html_forever(8080, html)\n}"
    forge toc = doc_link("purpose", "Funcionamento") + doc_link("constants", "Constantes") + doc_link("responses", "Respostas") + doc_link("serve", "Servidor") + doc_link("deploy", "Publicacao")
    forge constants = "<table class=\"api-table\"><thead><tr><th>Grupo</th><th>Valores</th><th>Uso</th></tr></thead><tbody><tr><td>Metodos</td><td><code>HTTP_GET</code>, <code>HTTP_POST</code>, <code>HTTP_PUT</code>, <code>HTTP_DELETE</code>, <code>HTTP_PATCH</code></td><td>Padronizam nomes de metodos.</td></tr><tr><td>Status</td><td><code>HTTP_200</code>, <code>HTTP_201</code>, <code>HTTP_400</code>, <code>HTTP_404</code>, <code>HTTP_500</code></td><td>Codigos usados por helpers de resposta.</td></tr><tr><td>MIME</td><td><code>MIME_JSON</code>, <code>MIME_HTML</code>, <code>MIME_TEXT</code>, <code>MIME_CSS</code>, <code>MIME_JS</code>, <code>MIME_ODL</code>, <code>MIME_OES</code></td><td>Content-Type de respostas e fontes.</td></tr></tbody></table>"
    forge api = "<table class=\"api-table\"><thead><tr><th>Funcao</th><th>Parametros</th><th>Retorno e efeito</th></tr></thead><tbody><tr><td><code>status_text</code></td><td>codigo</td><td>Converte status conhecido em texto HTTP.</td></tr><tr><td><code>http_response</code></td><td>status, content_type, body</td><td>Monta cabecalhos, Content-Length e corpo.</td></tr><tr><td><code>json_string</code></td><td>chave, valor</td><td>Cria um par JSON textual.</td></tr><tr><td><code>json_number</code></td><td>chave, numero</td><td>Cria um par JSON numerico.</td></tr><tr><td><code>get_mime_type</code></td><td>nome de arquivo</td><td>Detecta MIME por extensao comum.</td></tr><tr><td><code>log_request</code></td><td>metodo, caminho, status</td><td>Imprime uma linha de log.</td></tr><tr><td><code>serve_once</code></td><td>porta, tipo, corpo</td><td>Atende uma conexao e retorna.</td></tr><tr><td><code>serve_forever</code></td><td>porta, tipo, corpo</td><td>Atende conexoes ate o processo parar.</td></tr></tbody></table>"
    forge body = doc_section("purpose", "Como o servidor funciona", "O modulo chama funcoes de socket do runtime nativo. O programa prepara um corpo imutavel, escolhe o MIME type e inicia um loop de atendimento. A implementacao atual e adequada para desenvolvimento, exemplos e respostas estaticas; roteamento dinamico completo ainda e uma etapa futura.", "", site_terminal("server.ofs", code))
    body = body + doc_section("constants", "Metodos, status e MIME types", "As constantes evitam repetir strings e numeros HTTP no programa. ODL e OES tambem recebem MIME proprio para servir o fonte durante inspecao e ferramentas locais.", "", odl.div("table-wrap", constants))
    body = body + doc_section("responses", "Construcao de respostas", "`http_response` monta a linha de status, Content-Type, Content-Length, Connection e corpo. Os helpers JSON atuais criam fragmentos; objetos completos ainda precisam concatenar chaves e delimitadores.", "", odl.div("table-wrap", api))
    body = body + doc_section("serve", "Escolha entre once e forever", "Use `serve_once` em teste automatizado ou quando uma unica requisicao basta. Use `serve_forever` para um processo local persistente. As variantes `serve_html_*` preenchem `MIME_HTML` automaticamente.", "", site_terminal("json_server.ofs", "attach {webserver}\n\ncore main() {\n    forge body = \"{\" + json_string(\"language\", \"OFS\") + \",\" + json_number(\"version\", 1) + \"}\"\n    webserver.serve_forever(8080, MIME_JSON, body)\n}"))
    body = body + doc_section("deploy", "Quando usar hospedagem estatica", "Para documentacao, portfolio e arquivos que nao mudam por requisicao, compile ODL/OES e publique HTML/CSS. Para um processo local OFS, compile o programa servidor e execute o binario. O servidor atual nao substitui um proxy de producao com TLS, cache e limites de conexao.", "", "")
    forge content = doc_page("Web Server", "Servidor HTTP nativo a partir de um executavel OFS.", toc, body)
    return page_shell("Web Server", "Servidor HTTP nativo a partir de um executavel OFS.", content)
}

vein page_webui() -> obsidian {
    forge code = "attach {webui}\n\ncore main() {\n    forge body = webui.nav(\"OFS\", webui.button(\"Docs\", \"#docs\"))\n    body = body + webui.grid(webui.card(\"ODL\", \"Documents\") + webui.card(\"OES\", \"Effects\"))\n    webui.serve(8080, \"OFS Web\", body)\n}"
    forge toc = doc_link("theme", "Tema") + doc_link("components", "Componentes") + doc_link("composition", "Composicao") + doc_link("live", "Go Live")
    forge api = "<table class=\"api-table\"><thead><tr><th>Funcao</th><th>O que gera</th></tr></thead><tbody><tr><td><code>theme_dark / theme_light</code></td><td>WebTheme com cor, superficie, texto, borda, raio e gap.</td></tr><tr><td><code>stylesheet</code></td><td>Bloco style completo baseado no tema.</td></tr><tr><td><code>page</code></td><td>Documento HTML completo com viewport e tema.</td></tr><tr><td><code>nav</code></td><td>Barra de navegacao.</td></tr><tr><td><code>hero</code></td><td>Area principal com titulo, subtitulo e acao.</td></tr><tr><td><code>button</code></td><td>Link visual de comando.</td></tr><tr><td><code>panel / grid / card / stack</code></td><td>Containers de composicao.</td></tr><tr><td><code>serve</code></td><td>Cria pagina e inicia servidor HTML.</td></tr></tbody></table>"
    forge body = doc_section("theme", "WebTheme", "`WebTheme` concentra `bg`, `surface`, `text`, `muted`, `accent`, `border`, `radius` e `gap`. Alterar um tema muda o stylesheet gerado por uma unica funcao. `theme_light` e `theme_dark` fornecem valores iniciais, mas o programa pode preencher sua propria estrutura.", "", site_terminal("theme.ofs", "forge theme = webui.theme_light()\ntheme.accent = \"#29e0bd\"\ntheme.radius = 4"))
    body = body + doc_section("components", "Referencia de componentes", "Os componentes retornam `obsidian`, portanto podem ser concatenados, retornados por funcoes e guardados em variaveis. Eles nao mantem estado interno: a composicao ocorre durante a geracao da pagina.", "", odl.div("table-wrap", api))
    body = body + doc_section("composition", "Exemplo completo", "O exemplo cria navegacao, hero, grid de cards e inicia o servidor. Cada parte pode ser movida para uma `vein` reutilizavel.", "", site_terminal("webui.ofs", code))
    body = body + doc_section("live", "Go Live e recarga", "A extensao reconhece `attach {webui}` ou chamadas web explicitas, compila o programa e abre a URL local. Para `.odl`, ela tambem observa `.oes`, JavaScript e CSS vizinhos e injeta o cliente de recarga.", "", "")
    forge content = doc_page("Web UI", "A camada de componentes sobre ODL, OES e o servidor web nativo.", toc, body)
    return page_shell("Web UI", "A camada de componentes sobre ODL, OES e o servidor web nativo.", content)
}

vein page_stdlib() -> obsidian {
    forge toc = doc_link("base", "Base") + doc_link("web", "Web") + doc_link("native-ui", "UI nativa") + doc_link("system", "Sistema") + doc_link("testing", "Testes")
    forge base_modules = odl.div("module-grid",
        module_card("math.ofs", "Funcoes numericas escritas em OFS: `square`, `cube`, `sum_range`, `is_prime`, `count_digits`, `sum_digits`, `reverse_number` e `is_palindrome_number`. Use quando quiser logica matematica comum sem depender direto do runtime.")
        + module_card("string.ofs", "Utilitarios de texto sobre os builtins do runtime: `repeat_str`, `starts_with_char` e `is_empty`. Use para manipulacao simples de `obsidian` em ferramentas, parsers e exemplos.")
        + module_card("io.ofs", "Entrada e saida de terminal: `prompt`, `print_separator` e `print_header`. Use em CLIs pequenas e exemplos interativos.")
        + module_card("terminal_colors.ofs", "Constantes ANSI e helpers para imprimir texto colorido no terminal. Use para mensagens de status, erros e ferramentas de desenvolvimento."))
    forge web_modules = odl.div("module-grid",
        module_card("odl.ofs", "Construtor de documentos. Expoe `document`, `tag`, `void_tag`, `section`, `article`, `nav`, `main`, `a`, `img`, `code_block`, `table` e helpers semanticos. Use para gerar HTML a partir de OFS.")
        + module_card("oes.ofs", "Construtor de efeito visual. Expoe `prop`, `rule`, `media`, `supports`, `layer`, `keyframes`, `frame`, `var`, `use`, `transition` e `animation`. Use para gerar CSS sem manter CSS como fonte principal.")
        + module_card("webserver.ofs", "Servidor HTTP nativo e helpers de resposta. Define MIME types, status HTTP, `http_response`, `json_string`, `json_number`, `get_mime_type`, `serve_once`, `serve_forever`, `serve_html_once` e `serve_html_forever`.")
        + module_card("webui.ofs", "Componentes web prontos: tema, stylesheet, page, nav, hero, button, panel, grid, card, stack e `serve`. Use para criar uma pagina OFS rapidamente sem escrever toda a estrutura ODL."))
    forge ui_modules = odl.div("module-grid",
        module_card("canvas.ofs", "API de desenho 2D ligada ao runtime: abre area visual, desenha pontos, linhas, retangulos e formas simples. Use para demos, jogos pequenos e visualizacao.")
        + module_card("window.ofs", "Janela nativa experimental. Centraliza abertura, atualizacao e fechamento de janela quando o runtime oferece suporte.")
        + module_card("ui.ofs", "Helpers de UI imediata: medidas, texto, caixas e controles simples para prototipos nativos.")
        + module_card("ofshtml.ofs", "Helpers legados de HTML usados durante a transicao para ODL. Use apenas quando estiver migrando codigo antigo."))
    forge system_modules = odl.div("module-grid",
        module_card("bedrock.ofs", "Primitivos de baixo nivel para regioes e ponteiros. Use somente quando precisar trabalhar perto da representacao de memoria.")
        + module_card("bedrock_packet.ofs", "Estruturas de pacote para comunicacao experimental. Serve para organizar dados binarios/protocolares em camadas futuras.")
        + module_card("memory_modes.ofs", "Experimentos de modos de memoria da linguagem. Ajuda a testar limites entre codigo seguro e codigo explicitamente baixo nivel.")
        + module_card("rift.ofs", "Superficie experimental de FFI com ABI C. Use para declarar chamadas externas quando a stdlib comum nao cobre o caso."))
    forge testing_modules = odl.div("module-grid",
        module_card("core.ofs", "Modulo base reservado para convencoes de nucleo. Ele existe para estabilizar imports e organizar futuras funcoes comuns.")
        + module_card("test_lib.ofs", "Helpers para exemplos e testes. Use para criar verificacoes pequenas que rodam pelo launcher `ofs`.")
        + module_card("attach {F:...}", "Importacao direta por caminho. Use quando a biblioteca ainda nao esta instalada como pacote.")
        + module_card("attach {nome}", "Importacao por nome a partir da stdlib ou de bibliotecas instaladas. Use no codigo final distribuido."))
    forge body = doc_section("base", "Bibliotecas base", "A base cobre matematica, texto, entrada/saida e terminal. Esses modulos aparecem em exemplos, ferramentas do compilador e pequenos programas de linha de comando.", "", base_modules + site_terminal("base.ofs", "attach {math}\nattach {string}\nattach {io}\n\ncore main() {\n    print_header(\"Demo\")\n    echo(square(9))\n    echo(repeat_str(\"OFS\", 2))\n}"))
    body = body + doc_section("web", "Bibliotecas web", "A stack web nao e externa: ODL, OES, webserver e webui fazem parte da biblioteca padrao. ODL gera documento, OES gera visual, webserver serve HTTP e webui entrega componentes prontos.", "", web_modules + site_terminal("site.ofs", "attach {odl}\nattach {oes}\nattach {webserver}\n\ncore main() {\n    forge page = odl.document(\"pt\", \"Site\", \"feito em OFS\", odl.css(\"site.css\"), odl.h1(\"OFS Web\"))\n    webserver.serve_html_forever(8080, page)\n}"))
    body = body + doc_section("native-ui", "UI nativa e visual", "Canvas, window e ui existem para interfaces nativas experimentais. Eles nao substituem ODL/OES: sao para janela local, desenho e prototipos interativos fora do navegador.", "", ui_modules)
    body = body + doc_section("system", "Sistema, memoria e FFI", "bedrock, bedrock_packet, memory_modes e rift sao camadas avancadas. Elas existem para experimentar baixo nivel com nomes explicitos, sem esconder risco dentro da sintaxe comum.", "", system_modules)
    body = body + doc_section("testing", "Teste e importacao", "A stdlib tambem define convencoes de importacao e apoio a testes. Use imports por nome para codigo instalado e imports por caminho durante desenvolvimento local.", "", testing_modules)
    forge content = doc_page("Biblioteca Padrao", "Modulos distribuidos com o compilador e instaladores OFS.", toc, body)
    return page_shell("Biblioteca Padrao", "Modulos distribuidos com o compilador e instaladores OFS.", content)
}

vein page_packages() -> obsidian {
    forge code = "bash src/packages/install_library.sh odl\nbash src/packages/install_library.sh oes\nbash src/packages/build_packages.sh"
    forge toc = doc_link("registry", "Registro") + doc_link("install", "Instalar") + doc_link("publish", "Publicar")
    forge body = doc_section("registry", "Registro", "`src/packages/registry.json` indexa bibliotecas OFS publicadas e seus canais.", "`src/packages/registry.json` indexes published OFS libraries and their channels.", odl.div("grid", site_card("Registro", "Nome, versao, URL e checksum.", "") + site_card("Artefatos", "Pacotes versionados para reproducao.", "") + site_card("Canais", "alpha, stable e latest.", "")))
    body = body + doc_section("install", "Instalacao", "O instalador copia bibliotecas para o local esperado pelo launcher e pela extensao.", "The installer copies libraries into the location expected by the launcher and extension.", site_terminal("src/packages", code))
    body = body + doc_section("publish", "Publicacao", "Ao reorganizar o repositorio, mantenha os caminhos dos workflows atualizados antes de publicar release.", "When reorganizing the repository, keep workflow paths updated before publishing a release.", odl.div("callout", "A validacao final deve testar checkout, pacote limpo e instaladores."))
    forge content = doc_page("Pacotes", "Instale, compile, publique e versione bibliotecas OFS.", toc, body)
    return page_shell("Pacotes", "Instale, compile, publique e versione bibliotecas OFS.", content)
}

vein page_vscode() -> obsidian {
    forge toc = doc_link("features", "Recursos") + doc_link("live", "Go Live") + doc_link("settings", "Configuracao")
    forge body = doc_section("features", "Recursos da extensao", "A extensao reconhece .ofs, .odl e .oes com gramaticas, diagnosticos, comandos, icones e empacotamento do compilador.", "The extension recognizes .ofs, .odl, and .oes with grammars, diagnostics, commands, icons, and packaged compiler binaries.", odl.div("grid", site_card("Sintaxe", "TextMate para OFS, ODL e OES.", "") + site_card("Comandos", "Check, run, build, IR, asm, ODL, OES e tradutor.", "") + site_card("Diagnosticos", "Erros de compilacao aparecem no painel Problems.", "")))
    body = body + doc_section("live", "Go Live seguro", ".odl e sempre documento web. .ofs so abre como site quando contem webui/webserver explicito.", ".odl is always a web document. .ofs opens as a site only when it contains explicit webui/webserver usage.", odl.div("callout", "O servidor interno recompila ODL/OES e recarrega a pagina ao vivo."))
    body = body + doc_section("settings", "Configuracao", "Aponte para um launcher customizado quando estiver testando uma build local.", "Point to a custom launcher when testing a local build.", site_terminal("settings.json", "\"ofs.goLivePort\": 8080\n\"ofs.compilerPath\": \"ofs/dist/ofs\""))
    forge content = doc_page("VS Code", "Suporte de linguagem, diagnosticos, comandos, snippets e Go Live.", toc, body)
    return page_shell("VS Code", "Suporte de linguagem, diagnosticos, comandos, snippets e Go Live.", content)
}

vein page_github() -> obsidian {
    forge toc = doc_link("local", "Local") + doc_link("global", "Global") + doc_link("pages", "Pages")
    forge body = doc_section("local", "Reconhecimento neste repositorio", "`.gitattributes` marca .ofs, .odl e .oes como fontes da linguagem para este projeto.", "`.gitattributes` marks .ofs, .odl, and .oes as language sources for this project.", odl.div("grid", site_card("Override local", "*.ofs linguist-language=OFS.", "") + site_card("ODL", "*.odl linguist-language=ODL.", "") + site_card("OES", "*.oes linguist-language=OES.", "")))
    body = body + doc_section("global", "GitHub Linguist", "Para reconhecimento global, a linguagem precisa de PR no Linguist com extensoes, escopos, cor, exemplos publicos e gramatica.", "For global recognition, the language needs a Linguist PR with extensions, scopes, color, public examples, and grammar.", site_terminal("languages.yml", "OFS:\n  type: programming\n  color: \"#2A0845\"\n  extensions:\n    - \".ofs\"\n  tm_scope: source.ofs\nODL:\n  type: markup\n  extensions:\n    - \".odl\"\nOES:\n  type: markup\n  extensions:\n    - \".oes\""))
    body = body + doc_section("pages", "GitHub Pages", "GitHub Pages nao executa ODL/OES diretamente. O fluxo correto e gerar HTML/CSS em `docs/` e publicar o artefato.", "GitHub Pages does not execute ODL/OES directly. The correct flow is to generate HTML/CSS into `docs/` and publish the artifact.", odl.div("callout", "A fonte oficial continua ODL/OES; HTML e CSS sao artefatos de hospedagem."))
    forge content = doc_page("Reconhecimento GitHub", "Como deteccao de fonte e syntax highlighting sao registrados.", toc, body)
    return page_shell("Reconhecimento GitHub", "Como deteccao de fonte e syntax highlighting sao registrados.", content)
}

vein page_web() -> obsidian {
    forge flow = odl.div("workflow", odl.div("step", "<strong>1. ODL</strong><br>Declare estrutura de documento em OFS.") + odl.div("step", "<strong>2. OES</strong><br>Gere tokens, regras e animacao.") + odl.div("step", "<strong>3. Webserver</strong><br>Sirva a saida gerada localmente.") + odl.div("step", "<strong>4. Pages</strong><br>Publique os artefatos gerados."))
    forge code = "attach {odl}\nattach {oes}\n\nvein page() -> obsidian {\n    return odl.document(\"pt\", \"Site\", \"feito em OFS\", \"\", odl.h1(\"OFS Web\"))\n}"
    forge toc = doc_link("stack", "Stack") + doc_link("hosting", "Hospedagem") + doc_link("interop", "Interop")
    forge body = doc_section("stack", "Stack web OFS", "A stack separa logica OFS, documento ODL, efeito OES, servidor web e artefato gerado.", "The stack separates OFS logic, ODL document, OES effects, web server, and generated artifact.", flow + site_terminal("odl.ofs", code))
    body = body + doc_section("hosting", "Hospedagem real", "Browsers aceitam HTML/CSS/JS. OFS gera esses arquivos para GitHub Pages, CDN e servidores comuns.", "Browsers accept HTML/CSS/JS. OFS generates those files for GitHub Pages, CDNs, and common servers.", odl.div("callout", "ODL/OES podem ser hospedados como fonte tambem, mas quem executa no navegador e o artefato gerado."))
    body = body + doc_section("interop", "O que vem de React, Node, PHP e HTML", "ODL permite componentes, scripts modulares, Markdown e HTML bruto. OES organiza tokens e efeitos. webserver cobre a parte servidor local.", "ODL allows components, module scripts, Markdown, and raw HTML. OES organizes tokens and effects. webserver covers the local server layer.", odl.div("grid", site_card("React-like", "Componentes como funcoes retornando texto/ODL.", "") + site_card("Node-like", "Modulo JS por `spark` quando precisar.", "") + site_card("PHP-like", "Templates preservados por `server`/raw em hospedagem compativel.", "")))
    forge content = doc_page("ODL + OES", "A resposta nativa da OFS para HTML, CSS, templates PHP e componentes estilo React.", toc, body)
    return page_shell("ODL + OES", "A resposta nativa da OFS para HTML, CSS, templates PHP e componentes estilo React.", content)
}

vein page_commands() -> obsidian {
    forge code = "ofs/dist/ofs check app.ofs\nofs/dist/ofs run app.ofs\nofs/dist/ofs build app.ofs -o app\nofs/dist/ofs odl page.odl -o index.html\nofs/dist/ofs oes theme.oes -o theme.css\nofs/dist/ofs translate legacy.html --to odl\nofs/dist/ofs translate legacy.css --to oes"
    forge toc = doc_link("native", "Nativo") + doc_link("web", "Web") + doc_link("translate", "Tradutor")
    forge table = "<table class=\"api-table\"><thead><tr><th>Comando</th><th>Finalidade</th></tr></thead><tbody><tr><td><code>check</code></td><td>Valida sintaxe e semantica.</td></tr><tr><td><code>run</code></td><td>Compila e executa.</td></tr><tr><td><code>build</code></td><td>Gera executavel nativo.</td></tr><tr><td><code>ir</code></td><td>Mostra LLVM IR.</td></tr><tr><td><code>asm</code></td><td>Gera assembly.</td></tr><tr><td><code>odl</code></td><td>Compila .odl para HTML.</td></tr><tr><td><code>oes</code></td><td>Compila .oes para CSS.</td></tr><tr><td><code>translate</code></td><td>Traduz HTML/CSS para ODL/OES quando possivel.</td></tr></tbody></table>"
    forge body = doc_section("native", "Comandos nativos", "Use check, run, build, ir e asm no ciclo diario da linguagem.", "Use check, run, build, ir, and asm in the daily language cycle.", site_terminal("commands", code))
    body = body + doc_section("web", "Comandos web", "`odl` e `oes` geram artefatos de navegador a partir das linguagens web da OFS.", "`odl` and `oes` generate browser artifacts from OFS web languages.", odl.div("table-wrap", table))
    body = body + doc_section("translate", "Tradutor", "O tradutor ajuda a trazer HTML/CSS legado para ODL/OES sem impedir hospedagem padrao.", "The translator helps bring legacy HTML/CSS into ODL/OES without blocking standard hosting.", odl.div("callout", "O tradutor e util para migracao, mas o codigo final deve ser revisado como qualquer conversao."))
    forge content = doc_page("Comandos", "Comandos diarios para desenvolvimento OFS.", toc, body)
    return page_shell("Comandos", "Comandos diarios para desenvolvimento OFS.", content)
}

vein page_design() -> obsidian {
    forge toc = doc_link("tokens", "Tokens") + doc_link("components", "Componentes") + doc_link("motion", "Motion")
    forge body = doc_section("tokens", "Tokens", "OES guarda cor, espaco, raio, motion e layout como fonte versionavel.", "OES keeps color, spacing, radius, motion, and layout as versionable source.", site_terminal("design.oes", "gem accent \"#29e0bd\"\npaint .btn\n  fill \"$accent\"\n  curve \"8px\""))
    body = body + doc_section("components", "Componentes", "O site oficial e composto por funcoes OFS que retornam ODL. Isso evita editar HTML gerado.", "The official site is composed from OFS functions returning ODL. This avoids editing generated HTML.", odl.div("grid", site_card("Nao poluido", "Sections grandes, cards so onde ajudam.", "") + site_card("Responsivo", "Dimensoes estaveis e grids que colapsam.", "") + site_card("Acessivel", "Contraste alto e texto tecnico direto.", "")))
    body = body + doc_section("motion", "Motion", "Animacoes sao discretas: revelacao de cards, barras de benchmark e transicoes de hover.", "Motion is restrained: card reveal, benchmark bars, and hover transitions.", odl.div("callout", "A meta e demonstrar poder sem transformar documentacao em vitrine confusa."))
    forge content = doc_page("Design System", "Como o site oficial e estilizado sem autorar CSS puro como fonte.", toc, body)
    return page_shell("Design System", "Como o site oficial e estilizado sem autorar CSS puro como fonte.", content)
}

vein page_benchmark() -> obsidian {
    forge summary = "<div class=\"metric-summary\"><div class=\"metric-stat\"><strong>5 runs</strong><span>CPU, RSS e build</span></div><div class=\"metric-stat\"><strong>15 runs</strong><span>Startup de processo</span></div><div class=\"metric-stat\"><strong>wait4</strong><span>Medicao de processo real</span></div><div class=\"metric-stat\"><strong>checksum</strong><span>Saida identica obrigatoria</span></div></div>"
    forge toc = doc_link("method", "Metodo") + doc_link("metrics", "Metricas") + doc_link("results", "Resultados") + doc_link("hotspots", "Gargalos") + doc_link("limits", "Interpretacao")
    forge metrics = "<table class=\"api-table\"><thead><tr><th>Metrica</th><th>O que o runner mede</th><th>O que ela nao mede</th></tr></thead><tbody><tr><td>CPU</td><td>Tempo do workload depois do programa iniciar.</td><td>Nao inclui desenvolvimento, bibliotecas externas ou workloads diferentes.</td></tr><tr><td>Memoria</td><td>Pico RSS observado pelo processo.</td><td>Nao separa heap, stack e paginas compartilhadas.</td></tr><tr><td>Startup</td><td>Tempo para iniciar e encerrar um programa minimo.</td><td>Nao representa servidor persistente.</td></tr><tr><td>Build</td><td>Tempo do comando de compilacao para o exemplo.</td><td>Nao mede edicao, cache de IDE ou projeto grande.</td></tr><tr><td>Artefato</td><td>Tamanho do executavel gerado.</td><td>Nao soma dependencias instaladas no sistema.</td></tr></tbody></table>"
    forge hotspots = odl.div("module-grid", module_card("Leitura de string no lexer", "`ofs_str_char_at` valida indice com `strlen`. Como o lexer chama essa funcao para quase todo caractere, fontes grandes podem repetir varreduras da mesma string.") + module_card("Substrings e alocacoes", "Tokens e escapes criam novas strings com `ofs_str_substr` e concatenacao. Cada resultado aloca memoria; reduzir copias exige slices ou arena.") + module_card("Buscas lineares", "Tabelas de simbolos, nomes de strings, campos e variaveis usam arrays com busca linear. Projetos grandes aumentam o custo dessas consultas.") + module_card("Chamadas de tamanho em loops", "Existem loops que consultam `ofs_array_len`, `node_extra_len` ou `ofs_str_len` em cada iteracao. Alguns podem guardar o tamanho uma vez quando a colecao nao muda."))
    forge body = doc_section("method", "Metodo executado", "O runner compila cada implementacao com a configuracao registrada, executa processos reais, valida a saida e calcula medianas. Uma linguagem so entra no grafico quando o executavel produz o checksum esperado.", "", summary)
    body = body + doc_section("metrics", "O que cada metrica significa", "As cinco abas respondem perguntas diferentes. Nao e correto usar somente CPU para concluir que toda a linguagem e mais rapida, nem usar tamanho para concluir que um runtime e mais eficiente.", "", odl.div("table-wrap", metrics))
    body = body + doc_section("results", "Resultados medidos", "Os graficos carregam `benchmark.json` produzido em `src/site/benchmarks`. O seletor troca a coluna comparada sem misturar unidades.", "", site_benchmark())
    body = body + doc_section("hotspots", "Onde a OFS perde tempo hoje", "A leitura do compilador encontrou quatro areas concretas para medir antes de otimizar. A primeira tentativa de caminho rapido no lexer nao foi publicada porque o teste self-hosted do lexer ja cai no pipeline atual; primeiro esse teste precisa voltar a ser confiavel.", "", hotspots)
    body = body + doc_section("limits", "Como interpretar", "CPU mede o tempo do workload; memoria mostra o pico RSS do processo; inicializacao mede abrir e encerrar um programa minimo; compilacao mede a geracao do executavel; artefato mostra o tamanho do arquivo final. Um numero menor e melhor apenas dentro da mesma coluna e deste teste.", "", odl.div("callout", "Os resultados mudam com processador, sistema operacional, compilador, flags e codigo medido. Por isso o site mostra a maquina e a data junto dos valores."))
    forge content = doc_page("Benchmark", "Medicoes reproduziveis de CPU, memoria, inicializacao, compilacao e tamanho de artefato.", toc, body)
    return page_shell("Benchmark", "Medicoes reproduziveis de CPU, memoria, inicializacao, compilacao e tamanho de artefato.", content)
}

vein page_nav_en() -> obsidian {
    forge brand = odl.a("brand", "../index.html", odl.img("../ofs-256.png", "OFS logo") + odl.span("", "OFS"))
    forge tools = odl.div("nav-tools", site_language_select("en", "../index.html", "index.html", "../es/index.html") + site_search("Search"))
    forge links = odl.div("links", "<a href=\"language.html\">Language</a><a href=\"odl.html\">ODL</a><a href=\"oes.html\">OES</a><a href=\"web.html\">Web</a><a href=\"downloads.html\">Downloads</a>" + tools)
    return odl.header("topbar", odl.nav("wrap nav", brand + links))
}

vein page_shell_en(title: obsidian, subtitle: obsidian, content: obsidian) -> obsidian {
    forge head = odl.icon("../ofs-256.png") + odl.css("../site.css")
    forge hero = odl.section("", "band", odl.div("wrap", odl.h1(title) + odl.p("lead", subtitle)))
    forge body = page_nav_en() + odl.main("top", hero + content) + odl.footer("footer", "<div class=\"wrap\">Generated by ODL and OES in OFS.</div>") + odl.script("../site.js")
    return odl.document("en", title + " - OFS", subtitle, head, body)
}

vein doc_toc_en(items: obsidian) -> obsidian {
    return "<aside class=\"toc\">" + odl.strong("On this page") + items + "</aside>"
}

vein doc_section_en(id: obsidian, title: obsidian, text: obsidian, extra: obsidian) -> obsidian {
    return odl.section(id, "doc-section", odl.h2(title) + odl.div("doc-intro", odl.p("", text)) + extra)
}

vein doc_page_en(title: obsidian, subtitle: obsidian, toc: obsidian, body: obsidian) -> obsidian {
    return odl.section("", "band", odl.div("wrap doc-layout", doc_toc_en(toc) + odl.div("doc-main", body)))
}

vein page_en_index() -> obsidian {
    forge links = site_doc_link("language.html", "Language", "Syntax, types, modules, compiler modes, and program structure.")
    links = links + site_doc_link("odl.html", "ODL", "The OFS document language for browser documents.")
    links = links + site_doc_link("oes.html", "OES", "The OFS effect language for visual rules and motion.")
    links = links + site_doc_link("web.html", "Web stack", "How OFS, ODL, OES, webui, and webserver work together.")
    links = links + site_doc_link("stdlib.html", "Standard library", "Modules shipped with the compiler and installers.")
    links = links + site_doc_link("downloads.html", "Downloads", "Installers, VS Code package, and checksums.")
    links = links + site_doc_link("../benchmark.html#hotspots", "Performance", "Current compiler hotspots and optimization gates.")
    forge content = odl.section("", "band", odl.div("wrap", site_section_head("", "Documentation", "", "Technical documentation for the OFS language and its web stack.") + odl.div("docs-list", links)))
    return page_shell_en("OFS Documentation", "English documentation pages for Obsidian Fault Script.", content)
}

vein page_language_en() -> obsidian {
    forge toc = doc_link("overview", "Overview") + doc_link("syntax", "Syntax") + doc_link("types", "Types") + doc_link("modules", "Modules") + doc_link("low", "Low level")
    forge syntax = site_terminal("hello.ofs", "vein add(a: stone, b: stone) -> stone {\n    return a + b\n}\n\ncore main() {\n    forge result: stone = add(20, 2)\n    echo(result)\n}")
    forge modules = odl.div("module-grid", module_card("attach {math}", "Import a standard library module.") + module_card("attach {F:path/file.ofs}", "Import a local OFS file explicitly.") + module_card("extern vein", "Declare runtime or C symbols.") + module_card("core main()", "Define the native entry point."))
    forge body = doc_section_en("overview", "What OFS is", "OFS is a self-hosted compiled language. The compiler is written in OFS, emits LLVM IR, and links against a native runtime.", "")
    body = body + doc_section_en("syntax", "Syntax", "Programs use `vein` functions, `forge` bindings, explicit returns, and `core main()` as the entry point.", syntax)
    body = body + doc_section_en("types", "Types", "The base types include `stone`, `crystal`, `obsidian`, `bool`, integer widths, arrays, and `monolith` structures.", "<div class=\"pill-row\"><span class=\"pill\">stone</span><span class=\"pill\">crystal</span><span class=\"pill\">obsidian</span><span class=\"pill\">bool</span><span class=\"pill\">arrays</span><span class=\"pill\">monolith</span></div>")
    body = body + doc_section_en("modules", "Modules", "Libraries are attached with `attach`, keeping native code, standard library modules, and web DSLs in the same model.", modules)
    forge low = odl.div("module-grid", module_card("fracture { ... }", "Typed pointer context. Pointer element types are checked, while address validity and lifetime remain the program's responsibility.") + module_card("abyss { ... }", "Explicit raw-work boundary. It does not disable the current parser or type checker and adds no memory-safety guarantee.") + module_card("bedrock { ... }", "Typed machine-adjacent context for regions, lanes, endian helpers, barriers, prefetch, and fault_* intrinsics.") + module_card("intent fractal", "Function intent metadata. The current parser does not implement fractal as a block keyword.") + module_card("tectonic", "Accepted before fracture, abyss, or bedrock. It currently preserves the same block semantics.") + module_card("Manual lifetime", "Cells and regions allocated by bedrock must be released once and must not be read after release."))
    body = body + doc_section_en("low", "Low-level modes", "Low-level work is opt-in and visible in source. These forms do not make an invalid pointer valid, add garbage collection, or automatically manage an allocation's lifetime.", low)
    forge content = doc_page_en("Language", "The technical core of Obsidian Fault Script.", toc, body)
    return page_shell_en("Language", "The technical core of Obsidian Fault Script.", content)
}

vein page_odl_en() -> obsidian {
    forge toc = doc_link("model", "Model") + doc_link("syntax", "Syntax") + doc_link("interop", "Interop")
    forge code = "page \"OFS Web\" \"en\"\nskin \"theme.css\"\nflow\n  deck.topbar\n    title1 \"OFS Web\"\n    link.button \"Documentation\" \"#docs\"\n  stage#content\n    band.docs\n      mark \"## Native documents\\nWrite **ODL**, generate HTML.\"\n  spark \"app.js\""
    forge body = doc_section_en("model", "ODL model", "ODL is the OFS document language. It generates standard HTML for browsers, GitHub Pages, and static hosts.", "")
    body = body + doc_section_en("syntax", "Native syntax", "ODL uses words such as `page`, `skin`, `flow`, `deck`, `stage`, `band`, `tile`, `mark`, `raw`, `wire`, `spark`, `pulse`, and `server`.", site_terminal("page.odl", code))
    body = body + doc_section_en("interop", "Interop", "`mark` accepts Markdown, `raw` accepts HTML, `spark` imports JS modules, `pulse` injects inline JS, and `server` can preserve PHP template blocks.", odl.div("callout", "The source remains ODL. HTML is a generated hosting artifact."))
    forge content = doc_page_en("ODL", "Obsidian Document Language: the structural document layer for OFS sites.", toc, body)
    return page_shell_en("ODL", "Obsidian Document Language: the structural document layer for OFS sites.", content)
}

vein page_oes_en() -> obsidian {
    forge toc = doc_link("model", "Model") + doc_link("syntax", "Syntax") + doc_link("motion", "Motion")
    forge code = "gem accent \"#29e0bd\"\npaint .button\n  fill \"$accent\"\n  curve \"8px\"\nveil \"(max-width: 700px)\"\n  paint .grid\n    grid-cols \"1fr\"\npulse \"enter\"\n  rise\n    opacity \"0\"\n  rest\n    opacity \"1\""
    forge body = doc_section_en("model", "OES model", "OES is the visual and effect language: tokens, visual rules, responsiveness, animation, and safe layout behavior.", "")
    body = body + doc_section_en("syntax", "Native syntax", "OES keeps CSS power but authors it with OFS-flavored words such as `gem`, `paint`, `fill`, `ink`, `curve`, `space`, `veil`, and `pulse`.", site_terminal("theme.oes", code))
    body = body + doc_section_en("motion", "Motion", "`pulse`, `rise`, `rest`, and `atNN` organize keyframes. The generated artifact is normal CSS.", odl.div("callout", "OES is the source of truth; CSS is the browser artifact."))
    forge content = doc_page_en("OES", "Obsidian Effect Scripts: styles, responsiveness, and motion for ODL documents.", toc, body)
    return page_shell_en("OES", "Obsidian Effect Scripts: styles, responsiveness, and motion for ODL documents.", content)
}

vein page_web_en() -> obsidian {
    forge toc = doc_link("stack", "Stack") + doc_link("hosting", "Hosting") + doc_link("live", "Live reload")
    forge flow = odl.div("workflow", odl.div("step", "<strong>1. OFS</strong><br>Native logic.") + odl.div("step", "<strong>2. ODL</strong><br>Document source.") + odl.div("step", "<strong>3. OES</strong><br>Visual effects.") + odl.div("step", "<strong>4. Host</strong><br>Generated artifacts."))
    forge body = doc_section_en("stack", "OFS web stack", "OFS separates program logic, ODL document structure, OES effects, webserver hosting, and generated browser artifacts.", flow)
    body = body + doc_section_en("hosting", "Real hosting", "Browsers accept HTML, CSS, and JavaScript. OFS generates those files from ODL/OES for GitHub Pages, CDNs, and common servers.", odl.div("callout", "ODL/OES sources can also be published for inspection, but browsers execute the generated artifacts."))
    body = body + doc_section_en("live", "Go Live", "The VS Code extension compiles ODL/OES, watches neighboring assets, and reloads the browser automatically.", "")
    forge content = doc_page_en("Web stack", "How OFS builds sites with native source languages.", toc, body)
    return page_shell_en("Web stack", "How OFS builds sites with native source languages.", content)
}

vein page_stdlib_en() -> obsidian {
    forge toc = doc_link("core", "Core") + doc_link("web", "Web") + doc_link("visual", "Visual") + doc_link("system", "System") + doc_link("usage", "Usage")
    forge core_modules = odl.div("module-grid", module_card("math.ofs", "Implements square, cube, range sums, prime checks, digit counting, digit sums, number reversal, and numeric palindrome checks.") + module_card("string.ofs", "Wraps runtime text operations and provides repetition, first-character checks, and empty-string checks.") + module_card("io.ofs", "Provides prompt, separator, and header helpers for terminal programs.") + module_card("terminal_colors.ofs", "Defines ANSI colors and colored terminal output helpers."))
    forge web_modules = odl.div("module-grid", module_card("odl.ofs", "Builds complete documents and semantic HTML nodes from typed OFS functions.") + module_card("oes.ofs", "Builds properties, rules, media queries, layers, variables, transitions, and keyframes.") + module_card("webserver.ofs", "Defines HTTP constants, response builders, MIME detection, JSON fragments, logging, and native serving loops.") + module_card("webui.ofs", "Provides themes and ready-made nav, hero, button, panel, grid, card, stack, page, and serve helpers."))
    forge visual_modules = odl.div("module-grid", module_card("canvas.ofs", "Experimental native 2D drawing API.") + module_card("window.ofs", "Native window lifecycle helpers.") + module_card("ui.ofs", "Immediate-mode UI measurements, text, boxes, and basic controls.") + module_card("ofshtml.ofs", "Legacy HTML helpers kept for migration to ODL."))
    forge system_modules = odl.div("module-grid", module_card("bedrock.ofs", "Low-level regions and pointer-oriented primitives.") + module_card("bedrock_packet.ofs", "Experimental packet structures for binary and protocol work.") + module_card("memory_modes.ofs", "Experiments around explicit memory modes.") + module_card("rift.ofs", "Experimental C ABI and FFI surface."))
    forge body = doc_section_en("core", "Core modules", "Core modules cover math, text, terminal input/output, and terminal presentation.", core_modules + site_terminal("core.ofs", "attach {math}\nattach {string}\nattach {io}\n\ncore main() {\n    print_header(\"Demo\")\n    echo(square(9))\n    echo(repeat_str(\"OFS\", 2))\n}"))
    body = body + doc_section_en("web", "Web modules", "The web stack ships with the standard library: ODL owns documents, OES owns effects, webserver owns HTTP, and webui provides components.", web_modules)
    body = body + doc_section_en("visual", "Native visual modules", "Canvas, window, and UI target local native interfaces rather than browsers. They remain experimental and platform-dependent.", visual_modules)
    body = body + doc_section_en("system", "System and FFI modules", "Bedrock, memory modes, and rift are explicit advanced layers for code that must move below the normal safe language surface.", system_modules)
    body = body + doc_section_en("usage", "Importing", "Use `attach {name}` for installed libraries or `attach {F:path}` for local files. Prefer named imports in distributed projects.", site_terminal("attach", "attach {math}\nattach {odl}\nattach {oes}\nattach {webui}"))
    forge content = doc_page_en("Standard library", "Modules distributed with the OFS compiler and installers.", toc, body)
    return page_shell_en("Standard library", "Modules distributed with the OFS compiler and installers.", content)
}

vein page_downloads_en() -> obsidian {
    forge toc = doc_link("assets", "Assets") + doc_link("linux", "Linux") + doc_link("checks", "Checksums")
    forge body = doc_section_en("assets", "Official downloads", "The download cards resolve the latest GitHub release assets dynamically.", site_release_en())
    body = body + doc_section_en("linux", "Linux", "Debian/Ubuntu use .deb, Fedora/RHEL/openSUSE use .rpm, and Arch/Manjaro use the pacman package.", site_terminal("install", "sudo dpkg -i ofs-debian-ubuntu-x64-installer-v*.deb\nsudo rpm -Uvh ofs-fedora-x64-installer-v*.rpm\nsudo pacman -U ofs-arch-x64-installer-v*.pkg.tar.zst"))
    body = body + doc_section_en("checks", "Integrity", "Use CHECKSUMS.sha256 from the release before installing downloaded artifacts.", odl.div("callout", "The current release is published by the Auto Release workflow."))
    forge content = doc_page_en("Downloads", "Installers, VS Code package, and checksums.", toc, body)
    return page_shell_en("Downloads", "Installers, VS Code package, and checksums.", content)
}

