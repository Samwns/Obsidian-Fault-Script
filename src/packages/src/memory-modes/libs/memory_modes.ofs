// memory-modes package for OFS
// Install with src/packages/install_library.sh or install_library.ps1
// Use with: attach "memory_modes.ofs"

vein memory_mode_safe_name() -> obsidian {
    return "fracture"
}

vein memory_mode_unsafe_name() -> obsidian {
    return "abyss"
}

vein memory_mode_mid_name() -> obsidian {
    return "fractal"
}

vein explain_memory_modes() -> void {
    echo("fracture/bedrock/abyss/tectonic = blocos comuns (marcadores de baixo nivel, sem GC)")
    echo("memoria: liberada pelo compilador no fim do escopo (se nao escapa) ou a mao")
    echo("fractal = modo intermediario (so o nome)")
}
