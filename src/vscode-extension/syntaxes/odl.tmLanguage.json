{
  "name": "Obsidian Document Language",
  "scopeName": "source.odl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#tags" },
    { "include": "#attributes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.odl",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.odl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.odl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "entity.name.tag.odl",
          "match": "\\b(doc|section|title|p|heading|list|code|quote|meta|author|date)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.odl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*(?=\\s*=)"
        }
      ]
    }
  }
}
