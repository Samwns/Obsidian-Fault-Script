{
  "name": "Obsidian Fault Script",
  "scopeName": "source.ofs",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#intrinsics"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ofs",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ofs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ofs",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ofs",
          "match": "\\b(?:0[xX][0-9A-Fa-f]+|[0-9]+(?:\\.[0-9]+)?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "attach {name} — highlight library name inside braces",
          "name": "meta.attach.ofs",
          "match": "\\battach\\s*\\{\\s*([A-Za-z_][A-Za-z0-9_.\\-]*)\\s*\\}",
          "captures": {
            "1": {
              "name": "entity.name.module.ofs"
            }
          }
        },
        {
          "comment": "attach {F:path} — highlight file path prefix",
          "name": "meta.attach.file.ofs",
          "match": "\\battach\\s*\\{\\s*([Ff](?:ile)?):([^}]+)\\}",
          "captures": {
            "1": {
              "name": "keyword.operator.ofs"
            },
            "2": {
              "name": "string.unquoted.ofs"
            }
          }
        },
        {
          "name": "keyword.control.ofs",
          "match": "\\b(core|vein|forge|const|monolith|impl|namespace|strata|if|else|while|cycle|mine|match|assay|case|default|return|break|shatter|continue|erode|throw|tremor|catch|anchor|seal|fracture|abyss|bedrock|tectonic|quartz|attach|extern|rift|as|in|echo|shard)\\b"
        },
        {
          "comment": "geode: vein que captura (closure); palavra de contexto antes de `(`",
          "name": "keyword.other.geode.ofs",
          "match": "\\bgeode\\b(?=\\s*\\()"
        },
        {
          "comment": "A5.4 + Ideia 4: cabecalho do modulo `stratum crust|fault|abyss`, `claim rift, abyss, quartz, magma`, `caprock ...` (tambem `//! claim rift`)",
          "match": "^\\s*(?:(//!)\\s*)?(stratum|claim|caprock)\\b((?:\\s*,?\\s*\\b(?:crust|fault|abyss|rift|quartz|magma)\\b)+)\\s*(?=//|$)",
          "captures": {
            "1": { "name": "comment.line.double-slash.ofs" },
            "2": { "name": "keyword.other.stratum.ofs" },
            "3": { "name": "constant.language.stratum.ofs" }
          }
        },
        {
          "comment": "A5.1: `mineral Nome =` (tipo com regra; palavra de contexto)",
          "name": "keyword.other.contract.ofs",
          "match": "\\bmineral\\b(?=\\s+[A-Za-z_]\\w*\\s*=)"
        },
        {
          "comment": "A5.1: clausula grain/bearing/settle ate o fim da linha ou o `{`; dentro dela `value` e `result` sao do contrato",
          "begin": "\\b(grain|bearing|settle)\\b(?=\\s+[^=\\s(.:])",
          "beginCaptures": { "1": { "name": "keyword.other.contract.ofs" } },
          "end": "(?=\\{|$|\\b(?:grain|bearing|settle)\\b)",
          "patterns": [
            { "name": "variable.language.contract.ofs", "match": "\\b(value|result)\\b" },
            { "include": "$self" }
          ]
        },
        {
          "comment": "bind/abi: metadados de extern/rift vein",
          "name": "keyword.other.contextual.ofs",
          "match": "\\b(bind|abi)\\b(?=\\s+(?:\\\"|[a-z]))"
        },
        {
          "comment": "reservadas, ainda sem sintaxe aceita pelo compilador",
          "name": "invalid.deprecated.reserved.ofs",
          "match": "\\b(layout|intent)\\b(?=\\s)"
        },
        {
          "name": "constant.language.boolean.ofs",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.array.ofs",
          "match": "\\bArray\\s*<\\s*[A-Za-z_][A-Za-z0-9_]*\\s*>"
        },
        {
          "name": "storage.type.ofs",
          "match": "\\b(Array|stone|crystal|obsidian|bool|void|u8|u16|u32|u64|i8|i16|i32|i64|f32|f64)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ofs",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "intrinsics": {
      "patterns": [
        {
          "name": "support.function.intrinsic.ofs",
          "match": "\\bfault_(?:count|lead|trail|spin_left|spin_right|weave|swap|cut|patch|memcpy|memset|unreachable|trap|fence|prefetch|addr|call|step)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ofs",
          "match": "(\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||<<|>>|->|\\+\\+|--|[+\\-*/%=&|^!~<>?])"
        }
      ]
    }
  }
}
