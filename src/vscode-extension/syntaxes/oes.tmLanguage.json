{
  "name": "Obsidian Element Styling",
  "scopeName": "source.oes",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#hex_colors" },
    { "include": "#numbers" },
    { "include": "#selectors" },
    { "include": "#properties" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.oes",
          "match": "//.*$"
        },
        {
          "name": "comment.block.oes",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oes",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oes",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "hex_colors": {
      "patterns": [
        {
          "name": "constant.other.color.hex.oes",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.oes",
          "match": "\\b[0-9]+(?:px|%|rem|em|ms|s)?\\b"
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "name": "entity.name.tag.oes",
          "match": "\\b[.#]?[a-zA-Z_][a-zA-Z0-9_-]*(?=\\s*\\{)"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "support.type.property-name.oes",
          "match": "\\b[a-zA-Z_-]+(?=\\s*:)"
        }
      ]
    }
  }
}
