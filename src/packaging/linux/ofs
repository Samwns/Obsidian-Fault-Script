#!/usr/bin/env bash
set -euo pipefail

OFS_VERSION="__OFS_VERSION__"
case "$OFS_VERSION" in
  __*__) OFS_VERSION="1.0.169" ;;
esac
OFS_REPO="Samwns/Obsidian-Fault-Script"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OFSCC="${OFSCC:-$ROOT/ofscc}"
RUNTIME="${OFS_RUNTIME:-}"
if [ -z "$RUNTIME" ]; then
  for runtime_candidate in "$ROOT/magma.o" "$ROOT/libofs_runtime.a" "$HOME/.local/lib/ofs/magma.o" "$HOME/.local/lib/ofs/libofs_runtime.a" \
    "/usr/local/lib/ofs/magma.o" "/usr/local/lib/ofs/libofs_runtime.a" "/usr/lib/ofs/magma.o" "/usr/lib/ofs/libofs_runtime.a"; do
    if [ -f "$runtime_candidate" ]; then
      RUNTIME="$runtime_candidate"
      break
    fi
  done
fi

# Keep bootstrap resource use bounded while allowing callers to tighten the
# limits. OFSCC_MAX_MEM is bytes (4 GiB by default); CPU time is seconds.
OFSCC_MAX_MEM="${OFSCC_MAX_MEM:-4294967296}"
OFSCC_MAX_CPU_SECONDS="${OFSCC_MAX_CPU_SECONDS:-60}"
case "$OFSCC_MAX_MEM" in
  ''|*[!0-9]*) echo "ofs: OFSCC_MAX_MEM must be a byte count" >&2; exit 2 ;;
esac
case "$OFSCC_MAX_CPU_SECONDS" in
  ''|*[!0-9]*) echo "ofs: OFSCC_MAX_CPU_SECONDS must be a whole number of seconds" >&2; exit 2 ;;
esac
# ulimit -v (RLIMIT_AS) não é suportado no builtin de alguns shells não-Linux
# (macOS, *BSD). Tenta e silenciosamente pula caso retorne "Invalid argument".
ulimit -Sv "$((OFSCC_MAX_MEM / 1024))" 2>/dev/null || true
ulimit -St "$OFSCC_MAX_CPU_SECONDS" 2>/dev/null || true
current_file_limit="$(ulimit -Sf 2>/dev/null || echo unlimited)"
if [[ "$current_file_limit" == "unlimited" || "$current_file_limit" -gt 524288 ]]; then
  ulimit -Sf 524288 2>/dev/null || true
fi
ulimit -Sc 0 2>/dev/null || true
export OFS_RUNTIME="$RUNTIME"

if [ -z "${OFS_STDLIB_PATH:-}" ] && [ -n "${OFS_STDLIB:-}" ]; then
  export OFS_STDLIB_PATH="$OFS_STDLIB"
fi
if [ -z "${OFS_STDLIB:-}" ] && [ -n "${OFS_STDLIB_PATH:-}" ]; then
  export OFS_STDLIB="$OFS_STDLIB_PATH"
fi

if [ -z "${OFS_STDLIB_PATH:-}" ]; then
  if [ -d "$ROOT/stdlib" ]; then
    export OFS_STDLIB_PATH="$ROOT/stdlib"
  elif [ -d "$ROOT/../ofs/stdlib" ]; then
    export OFS_STDLIB_PATH="$ROOT/../ofs/stdlib"
  elif [ -f "$ROOT/../../../ofs/stdlib/core.ofs" ]; then
    # wrapper rodando direto do repo (src/packaging/linux/ofs)
    export OFS_STDLIB_PATH="$(cd "$ROOT/../../../ofs/stdlib" && pwd)"
  elif [ -d "$HOME/.local/lib/ofs/stdlib" ]; then
    export OFS_STDLIB_PATH="$HOME/.local/lib/ofs/stdlib"
  elif [ -d "$HOME/.local/share/ofs/stdlib" ]; then
    export OFS_STDLIB_PATH="$HOME/.local/share/ofs/stdlib"
  elif [ -d "/usr/local/share/ofs/stdlib" ]; then
    export OFS_STDLIB_PATH="/usr/local/share/ofs/stdlib"
  elif [ -d "/usr/lib/ofs/stdlib" ]; then
    export OFS_STDLIB_PATH="/usr/lib/ofs/stdlib"
  elif [ -d "/usr/share/ofs/stdlib" ]; then
    export OFS_STDLIB_PATH="/usr/share/ofs/stdlib"
  fi
  export OFS_STDLIB="${OFS_STDLIB_PATH:-}"
fi

env_llvm_ir_flags="${OFS_LLVM_IR_FLAGS:-${LLVM_IR_FLAGS:-}}"
detect_llvm_ir_flags() {
  if [ -n "${env_llvm_ir_flags:-}" ]; then
    printf '%s\n' "$env_llvm_ir_flags"
    return
  fi
  if clang --version 2>/dev/null | grep -Eq 'version 14\.|clang-1400\.'; then
    printf '%s\n' "-mllvm -opaque-pointers"
    return
  fi
  if ! echo 'define void @__test_ptr(ptr %p) { ret void }' | clang -Wno-override-module -x ir -c - -o /dev/null 2>/dev/null; then
    if echo 'define void @__test_ptr(ptr %p) { ret void }' | clang -Wno-override-module -mllvm -opaque-pointers -x ir -c - -o /dev/null 2>/dev/null; then
      printf '%s\n' "-mllvm -opaque-pointers"
      return
    fi
  fi
}

OFS_LLVM_IR_FLAGS=()
detected_llvm_ir_flags="$(detect_llvm_ir_flags)"
if [ -n "$detected_llvm_ir_flags" ]; then
  read -r -a OFS_LLVM_IR_FLAGS <<< "$detected_llvm_ir_flags"
fi

detect_crt_paths() {
  CRT_DIR=""
  DYN_LINKER=""
  for p in /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib; do
    if [ -f "$p/crt1.o" ]; then
      CRT_DIR="$p"
      break
    fi
  done
  for dl in /lib64/ld-linux-x86-64.so.2 /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /usr/lib64/ld-linux-x86-64.so.2; do
    if [ -f "$dl" ]; then
      DYN_LINKER="$dl"
      break
    fi
  done
}

native_link() {
  local in_ll="$1"
  local out_bin="$2"
  local target_os="${3:-linux}"
  local obj="${in_ll%.*}.o"

  local runtime_file=""
  if [ -n "${OFS_RUNTIME:-}" ] && [ -f "${OFS_RUNTIME}" ]; then
    runtime_file="${OFS_RUNTIME}"
  elif [ -n "${RUNTIME:-}" ] && [ -f "${RUNTIME}" ]; then
    runtime_file="${RUNTIME}"
  else
    for candidate in \
      "$ROOT/magma.o" \
      "$ROOT/../ofs/dist/magma.o" \
      "$HOME/.local/lib/ofs/magma.o" \
      "/usr/local/lib/ofs/magma.o" \
      "/usr/lib/ofs/magma.o"; do
      if [ -f "$candidate" ]; then
        runtime_file="$candidate"
        break
      fi
    done
  fi

  local magma_objs=()
  if [ -n "$runtime_file" ]; then
    magma_objs+=("$runtime_file")
  fi

  extra_libs=(-lm)
  if [ "$(uname -s)" != "Darwin" ]; then
    if pkg-config --exists x11 2>/dev/null; then
      extra_libs+=(-lX11)
    elif [ -f /usr/lib64/libX11.so ] || [ -f /usr/lib/x86_64-linux-gnu/libX11.so ]; then
      extra_libs+=(-lX11)
    fi
    if pkg-config --exists xft 2>/dev/null; then
      extra_libs+=(-lXft)
    elif [ -f /usr/lib64/libXft.so ] || [ -f /usr/lib/x86_64-linux-gnu/libXft.so ]; then
      extra_libs+=(-lXft)
    fi
  fi

  if [ "$target_os" = "windows" ] || [ "$target_os" = "win64" ]; then
    llc -filetype=obj -mtriple=x86_64-pc-windows-gnu "$in_ll" -o "$obj"
    local win_lib_dir="/opt/wine-staging/lib64/wine/x86_64-windows"
    local linker_win="/usr/lib64/rocm/llvm/bin/ld.lld"
    local win_shims=()
    if [ -f "$ROOT/win_shim.o" ]; then
      win_shims+=("$ROOT/win_shim.o")
    elif [ -f "$HOME/.local/lib/ofs/win_shim.o" ]; then
      win_shims+=("$HOME/.local/lib/ofs/win_shim.o")
    fi
    if [ -d "$win_lib_dir" ] && [ -x "$linker_win" ]; then
      local win_cmd=("$linker_win" -m i386pep --allow-multiple-definition "$obj")
      if [ "${#win_shims[@]}" -gt 0 ]; then
        win_cmd+=("${win_shims[@]}")
      fi
      win_cmd+=(-L"$win_lib_dir" -lmsvcrt -luser32 -lgdi32 -lkernel32 -lcomctl32 -e main -o "$out_bin")
      "${win_cmd[@]}"
    elif [ -x /usr/lib64/rocm/llvm/bin/lld-link ]; then
      local win_cmd=(/usr/lib64/rocm/llvm/bin/lld-link /entry:main /subsystem:windows "$obj")
      if [ "${#win_shims[@]}" -gt 0 ]; then
        win_cmd+=("${win_shims[@]}")
      fi
      win_cmd+=(/out:"$out_bin")
      "${win_cmd[@]}"
    fi
    rm -f "$obj"
    return 0
  fi

  detect_crt_paths
  if command -v llc >/dev/null 2>&1 && [ -n "$CRT_DIR" ] && [ -n "$DYN_LINKER" ]; then
    llc -filetype=obj "$in_ll" -o "$obj"
    local linker_bin="ld"
    local ld_cmd=()
    if [ -x /usr/lib64/rocm/llvm/bin/ld.lld ]; then
      linker_bin="/usr/lib64/rocm/llvm/bin/ld.lld"
      ld_cmd=("$linker_bin" --allow-multiple-definition -L/usr/lib64 -dynamic-linker "$DYN_LINKER" "$CRT_DIR/crt1.o" "$CRT_DIR/crti.o" "$obj")
    else
      ld_cmd=("$linker_bin" --allow-multiple-definition -dynamic-linker "$DYN_LINKER" "$CRT_DIR/crt1.o" "$CRT_DIR/crti.o" "$obj")
    fi
    if [ "${#magma_objs[@]}" -gt 0 ]; then
      ld_cmd+=("${magma_objs[@]}")
    fi
    ld_cmd+=(-lc)
    if [ "${#extra_libs[@]}" -gt 0 ]; then
      ld_cmd+=("${extra_libs[@]}")
    fi
    ld_cmd+=("$CRT_DIR/crtn.o" -o "$out_bin")
    "${ld_cmd[@]}"
    rm -f "$obj"
    return 0
  fi

  if command -v clang >/dev/null 2>&1; then
    local clang_cmd=(clang -Wno-override-module)
    if [ "${#OFS_LLVM_IR_FLAGS[@]}" -gt 0 ]; then
      clang_cmd+=("${OFS_LLVM_IR_FLAGS[@]}")
    fi
    if [ "$(uname -s)" != "Darwin" ]; then
      clang_cmd+=(-Wl,--allow-multiple-definition)
    fi
    clang_cmd+=("$in_ll")
    if [ "${#magma_objs[@]}" -gt 0 ]; then
      clang_cmd+=("${magma_objs[@]}")
    fi
    if [ "${#extra_libs[@]}" -gt 0 ]; then
      clang_cmd+=("${extra_libs[@]}")
    fi
    clang_cmd+=(-o "$out_bin")
    "${clang_cmd[@]}"
    return 0
  fi

  echo "ofs: erro: nenhum linker nativo ou assembler encontrado" >&2
  return 1
}

native_asm() {
  local in_ll="$1"
  local out_s="$2"
  if command -v llc >/dev/null 2>&1; then
    llc "$in_ll" -o "$out_s"
  else
    local clang_asm=(clang -S -Wno-override-module)
    if [ "${#OFS_LLVM_IR_FLAGS[@]}" -gt 0 ]; then
      clang_asm+=("${OFS_LLVM_IR_FLAGS[@]}")
    fi
    clang_asm+=("$in_ll" -o "$out_s")
    "${clang_asm[@]}"
  fi
}

if [ ! -x "$OFSCC" ] && [ -x "$HOME/.local/lib/ofs/ofscc" ]; then
  OFSCC="$HOME/.local/lib/ofs/ofscc"
fi
if [ ! -x "$OFSCC" ] && command -v ofscc >/dev/null 2>&1; then
  OFSCC="$(command -v ofscc)"
fi
if [ ! -x "$OFSCC" ] && [ -x /usr/local/bin/ofscc ]; then
  OFSCC="/usr/local/bin/ofscc"
fi
if [ ! -x "$OFSCC" ] && [ -x /usr/lib/ofs/ofscc ]; then
  OFSCC="/usr/lib/ofs/ofscc"
fi

banner() {
  # Logo em roxo quando ha cor (mesma regra de ofs_color_on).
  local c_logo='' c_off=''
  if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ] && [ -n "${TERM:-}" ]; then
    c_logo=$'\033[35m'
    c_off=$'\033[0m'
  fi
  printf '%s\n' "$c_logo"
  cat <<'BANNER'
 ______        ______      ______
/\  __ \      /\  ___\    /\  ___\
\ \ \/\ \     \ \  __\    \ \___  \
 \ \_____\     \ \_\       \/\_____\
  \/_____/      \/_/        \/_____/
BANNER
  printf '%s\n' "$c_off"
}

show_version() {
  banner
  printf 'ofs %s - Obsidian Fault Script\n' "$OFS_VERSION"
  printf 'status: stable\n'
}

# Cores do help: ativadas por padrao; NO_COLOR (qualquer valor) ou TERM=dumb
# desligam. Espelha reporter_detect_color() do ofscc.ofs.
ofs_color_on() {
  [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ] && [ -n "${TERM:-}" ]
}

usage() {
  banner
  local c_cmd='' c_head='' c_dim='' c_off=''
  if ofs_color_on; then
    c_cmd=$'\033[36m'
    c_head=$'\033[32m'
    c_dim=$'\033[2m'
    c_off=$'\033[0m'
  fi
  case "${OFS_LANG:-en}" in
  pt*)
    cat <<EOF
${c_head}ofs${c_off} - compilador Obsidian Fault Script v$OFS_VERSION

${c_head}Uso:${c_off} ofs <arquivo.ofs>   (equivale a 'ofs run')

${c_head}Subcomandos:${c_off}
  ${c_cmd}run <arq.ofs>${c_off}       Executa interpretado (--native compila temporario)
  ${c_cmd}build <arq.ofs>${c_off}     Compila para executavel nativo (-o saida)
  ${c_cmd}check <arq.ofs>${c_off}     Somente verificacao de tipos
  ${c_cmd}test <arq.ofs>${c_off}      Executa os testes (assay) do arquivo
  ${c_cmd}twin <arq.ofs>${c_off}      Roda interpretado + nativo e compara saidas
  ${c_cmd}polish <arq.ofs>${c_off}    Verifica estilo e padroes do codigo
  ${c_cmd}language [en|pt|es]${c_off} Mostra/altera o idioma da CLI
  ${c_cmd}ir|asm|tokens|ast${c_off}   Artefatos de depuracao do compilador
  ${c_cmd}ui <arq.oll>${c_off}        Renderiza layout OLL nativo (-o saida.ppm)
  ${c_cmd}build --target android${c_off} APK Android de um .ofs ou .oal (--install, --serial, --manifest)
  ${c_cmd}run <app.oal>${c_off}       Abre o app OAL numa janela de celular (X11)
  ${c_cmd}clean${c_off}               Limpa artefatos temporarios de build
  ${c_cmd}version${c_off}             Mostra a versao
  ${c_cmd}update${c_off}              Atualiza para a ultima release
  ${c_cmd}help${c_off}                Mostra esta ajuda

${c_dim}Env: OFS_LANG, OFS_PROGRESS, OFS_VERBOSE, OFS_RUNTIME, OFS_STDLIB_PATH${c_off}
EOF
    ;;
  es*)
    cat <<EOF
${c_head}ofs${c_off} - compilador Obsidian Fault Script v$OFS_VERSION

${c_head}Uso:${c_off} ofs <archivo.ofs>   (equivale a 'ofs run')

${c_head}Subcomandos:${c_off}
  ${c_cmd}run <arq.ofs>${c_off}       Ejecuta interpretado (--native compila temporal)
  ${c_cmd}build <arq.ofs>${c_off}     Compila a ejecutable nativo (-o salida)
  ${c_cmd}check <arq.ofs>${c_off}     Solo verificacion de tipos
  ${c_cmd}test <arq.ofs>${c_off}      Ejecuta las pruebas (assay) del archivo
  ${c_cmd}twin <arq.ofs>${c_off}      Ejecuta interpretado + nativo y compara salidas
  ${c_cmd}polish <arq.ofs>${c_off}    Verifica estilo y patrones del codigo
  ${c_cmd}language [en|pt|es]${c_off} Muestra/cambia el idioma de la CLI
  ${c_cmd}ir|asm|tokens|ast${c_off}   Artefactos de depuracion del compilador
  ${c_cmd}ui <arq.oll>${c_off}        Renderiza layout OLL nativo (-o salida.ppm)
  ${c_cmd}build --target android${c_off} APK Android de un .ofs o .oal (--install, --serial, --manifest)
  ${c_cmd}run <app.oal>${c_off}       Abre la app OAL en una ventana de movil (X11)
  ${c_cmd}clean${c_off}               Limpia artefactos temporales de build
  ${c_cmd}version${c_off}             Muestra la version
  ${c_cmd}update${c_off}              Actualiza a la ultima release
  ${c_cmd}help${c_off}                Muestra esta ayuda

${c_dim}Env: OFS_LANG, OFS_PROGRESS, OFS_VERBOSE, OFS_RUNTIME, OFS_STDLIB_PATH${c_off}
EOF
    ;;
  *)
    cat <<EOF
${c_head}ofs${c_off} - Obsidian Fault Script compiler v$OFS_VERSION

${c_head}Usage:${c_off} ofs <file.ofs>   (same as 'ofs run')

${c_head}Subcommands:${c_off}
  ${c_cmd}run <file.ofs>${c_off}      Run interpreted (--native builds a temp binary)
  ${c_cmd}build <file.ofs>${c_off}    Compile to a native executable (-o output)
  ${c_cmd}check <file.ofs>${c_off}    Type-check only (no output)
  ${c_cmd}test <file.ofs>${c_off}     Run file tests (assay)
  ${c_cmd}twin <file.ofs>${c_off}     Run interpreted + native and diff outputs
  ${c_cmd}polish <file.ofs>${c_off}   Style and pattern checks
  ${c_cmd}language [en|pt|es]${c_off} Show/change the CLI language
  ${c_cmd}ir|asm|tokens|ast${c_off}   Compiler debug artifacts
  ${c_cmd}ui <file.oll>${c_off}       Render native OLL layout (-o output.ppm)
  ${c_cmd}build --target android${c_off} Android APK from a .ofs or .oal (--install, --serial, --manifest)
  ${c_cmd}run <app.oal>${c_off}       Open an OAL app in a phone-sized X11 window
  ${c_cmd}clean${c_off}               Clean temporary build artifacts
  ${c_cmd}version${c_off}             Print compiler version
  ${c_cmd}update${c_off}              Update to the latest release
  ${c_cmd}help${c_off}                Show this help message

${c_dim}Env: OFS_LANG, OFS_PROGRESS, OFS_VERBOSE, OFS_RUNTIME, OFS_STDLIB_PATH${c_off}
EOF
    ;;
  esac
}

# Persistencia de idioma da CLI: $XDG_CONFIG_HOME/ofs/lang ou ~/.config/ofs/lang.
ofs_lang_file() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ofs"
  printf '%s\n' "$cfg/lang"
}

cmd_language() {
  local cfg_dir cfg_file current
  cfg_dir="$(dirname "$(ofs_lang_file)")"
  cfg_file="$(ofs_lang_file)"
  current="${OFS_LANG:-}"
  if [ -z "$current" ] && [ -f "$cfg_file" ]; then
    current="$(head -n 1 "$cfg_file")"
  fi
  [ -z "$current" ] && current="en"
  local want="${1:-}"
  if [ -z "$want" ]; then
    printf 'ofs language: %s\n' "$current"
    printf 'available: en pt es\n'
    printf 'usage: ofs language <en|pt|es>\n'
    return 0
  fi
  case "$want" in
    en|pt|es) ;;
    *) echo "ofs language: idioma invalido '$want' (use en, pt ou es)" >&2; return 2 ;;
  esac
  mkdir -p "$cfg_dir"
  printf '%s\n' "$want" > "$cfg_file"
  echo "ofs language: $want"
}

latest_tag() {
  curl -fsSIL -o /dev/null -w '%{url_effective}' "https://github.com/$OFS_REPO/releases/latest" |
    sed 's#.*/tag/##'
}

run_update() {
  local latest asset tmp platform os_id os_like package
  latest="$(latest_tag)"
  if [ -z "$latest" ]; then
    echo "ofs update: failed to fetch latest release tag" >&2
    return 1
  fi
  if [ "v$OFS_VERSION" = "$latest" ]; then
    echo "OFS is already up to date ($latest)"
    return 0
  fi

  tmp="$(mktemp -d)"
  platform="$(uname -s)"
  if [ "$platform" = "Darwin" ]; then
    asset="ofs-macos-arm64-installer-$latest.pkg"
    echo "Downloading $asset..."
    curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$tmp/ofs.pkg"
    sudo installer -pkg "$tmp/ofs.pkg" -target /
    rm -rf "$tmp"
    local mac_ofs="ofs"
    if [ -x "/usr/local/bin/ofs" ]; then
      mac_ofs="/usr/local/bin/ofs"
    fi
    if [ -f "$HOME/.local/bin/ofs" ] && [ "$mac_ofs" != "$HOME/.local/bin/ofs" ]; then
      cp -f "$mac_ofs" "$HOME/.local/bin/ofs" 2>/dev/null || true
    fi
    if ! "$mac_ofs" version | grep -F "ofs ${latest#v} - Obsidian Fault Script" >/dev/null; then
      echo "ofs update: installed version did not match $latest" >&2
      return 1
    fi
    echo "Update completed to $latest"
    return 0
  fi

  os_id=""
  os_like=""
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    os_id="${ID:-}"
    os_like="${ID_LIKE:-}"
  fi

  case " $os_id $os_like " in
    *" arch "*)
      asset="ofs-arch-x64-installer-$latest.pkg.tar.zst"
      package="$tmp/$asset"
      echo "Downloading $asset..."
      curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$package"
      sudo pacman -U --noconfirm "$package"
      ;;
    *" fedora "*|*" rhel "*|*" centos "*)
      asset="ofs-fedora-x64-installer-$latest.rpm"
      package="$tmp/$asset"
      echo "Downloading $asset..."
      curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$package"
      if command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y "$package"
      else
        sudo rpm -Uvh "$package"
      fi
      ;;
    *" debian "*|*" ubuntu "*)
      asset="ofs-debian-ubuntu-x64-installer-$latest.deb"
      package="$tmp/$asset"
      echo "Downloading $asset..."
      curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$package"
      if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get install -y "$package"
      else
        sudo dpkg -i "$package"
      fi
      ;;
    *)
      echo "ofs update: unsupported Linux distribution ($os_id $os_like)." >&2
      echo "Download the .deb, .rpm, or .pkg.tar.zst release manually." >&2
      return 1
      ;;
  esac

  rm -rf "$tmp"
  local target_ofs="ofs"
  if [ -x "/usr/bin/ofs" ]; then
    target_ofs="/usr/bin/ofs"
  fi
  if [ -f "$HOME/.local/bin/ofs" ] && [ "$target_ofs" != "$HOME/.local/bin/ofs" ]; then
    cp -f "$target_ofs" "$HOME/.local/bin/ofs" 2>/dev/null || true
  fi
  if ! "$target_ofs" version | grep -F "ofs ${latest#v} - Obsidian Fault Script" >/dev/null; then
    echo "ofs update: installed version did not match $latest" >&2
    return 1
  fi
  echo "Update completed to $latest"
}

# ---------------------------------------------------------------------------
# Alvo Android (aarch64, API 26+): `ofs build --target android app.ofs|app.oal`
# gera um APK sem Gradle/Java: NativeActivity + lib<nome>.so feita so de OFS
# (stdlib android.ofs exporta ANativeActivity_onCreate; nenhum .c).
#   --manifest <AndroidManifest.xml>  manifesto (padrao: o do .oal, o que esta
#                                     ao lado do fonte, ou um gerado)
#   --install                         adb install -r + abre a activity
#   --serial <id>                     adb -s <id> (ou ANDROID_SERIAL)
# Env: ANDROID_SDK/ANDROID_HOME/ANDROID_SDK_ROOT, OFS_SOURCE (pasta ofs/ do
#      repo, para compilar ofscc/oalc do fonte), OFS_ANDROID_KEYSTORE.
# ---------------------------------------------------------------------------
android_die() { echo "ofs android: $*" >&2; exit 1; }
android_step() { echo "==> $*" >&2; }

android_src_dir() {
  local c
  for c in "${OFS_SOURCE:-}" "$ROOT/../../../ofs" "$ROOT/../ofs" "$ROOT/.." "$HOME/.local/lib/ofs/src"; do
    if [ -n "$c" ] && [ -f "$c/ofscc/ofscc.ofs" ]; then
      (cd "$c" && pwd)
      return 0
    fi
  done
  return 1
}

# ofscc com suporte a OFSCC_TARGET (o instalado pode ser anterior a isso).
android_ofscc() {
  local probe="$ANDROID_CACHE/probe.ofs"
  printf 'core main() { echo("x") }\n' > "$probe"
  if OFSCC_TARGET=android OFSCC_INPUT="$probe" OFSCC_MODE=ir OFSCC_C_OUT="$ANDROID_CACHE/probe.ll" "$OFSCC" >/dev/null 2>&1 \
     && grep -q 'aarch64' "$ANDROID_CACHE/probe.ll" 2>/dev/null; then
    A_OFSCC="$OFSCC"
    return
  fi
  local src
  src="$(android_src_dir)" || android_die "o ofscc instalado nao tem OFSCC_TARGET e o fonte do OFS nao foi achado (defina OFS_SOURCE=<repo>/ofs)"
  A_OFSCC="$ANDROID_CACHE/ofscc"
  if [ -x "$A_OFSCC" ] && [ -z "$(find "$src/ofscc" -name '*.ofs' -newer "$A_OFSCC" -print -quit)" ]; then
    return
  fi
  android_step "compilando ofscc do fonte ($src/ofscc)"
  local ll="$ANDROID_CACHE/ofscc.ll"
  ( ulimit -St 300 2>/dev/null || true
    OFSCC_INPUT="$src/ofscc/ofscc.ofs" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$OFSCC" >"$ANDROID_CACHE/ofscc.log" 2>&1 ) \
    || { tail -20 "$ANDROID_CACHE/ofscc.log" >&2; android_die "falha ao compilar o ofscc"; }
  native_link "$ll" "$A_OFSCC" linux
  chmod +x "$A_OFSCC"
  rm -f "$ll"
}

# Compila uma ferramenta .ofs do repo (ex.: tools/oalc.ofs) para o host.
android_tool() {
  local name="$1" src
  src="$(android_src_dir)" || android_die "fonte do OFS nao encontrado para $name (defina OFS_SOURCE)"
  local tool_src="$src/tools/$name.ofs"
  [ -f "$tool_src" ] || android_die "$tool_src nao existe"
  local bin="$ANDROID_CACHE/$name"
  if [ ! -x "$bin" ] || [ -n "$(find "$src/tools" "$OFS_STDLIB_PATH" -name '*.ofs' -newer "$bin" -print -quit)" ]; then
    android_step "compilando $name"
    local ll="$ANDROID_CACHE/$name.ll"
    OFSCC_INPUT="$tool_src" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$A_OFSCC" >"$ANDROID_CACHE/$name.log" 2>&1 \
      || { tail -20 "$ANDROID_CACHE/$name.log" >&2; android_die "falha ao compilar $name"; }
    native_link "$ll" "$bin" linux
    chmod +x "$bin"
    rm -f "$ll"
  fi
  printf '%s\n' "$bin"
}

android_ir() {
  OFSCC_TARGET=android OFSCC_INPUT="$1" OFSCC_MODE=ir OFSCC_C_OUT="$2" "$A_OFSCC" >"$2.log" 2>&1 \
    || { cat "$2.log" >&2; android_die "ofscc falhou em $1"; }
  [ -s "$2" ] || { cat "$2.log" >&2; android_die "ofscc nao gerou $2"; }
}

android_build() {
  local input="$1" output="$2"
  local SDK="${ANDROID_SDK:-${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Android/Sdk}}}"
  [ -d "$SDK" ] || android_die "Android SDK nao encontrado (defina ANDROID_SDK); precisa de ndk/, build-tools/ e platforms/"
  local NDK BT PLAT
  NDK="$(ls -d "$SDK"/ndk/* 2>/dev/null | sort -V | tail -1)"
  BT="$(ls -d "$SDK"/build-tools/* 2>/dev/null | sort -V | tail -1)"
  PLAT="$(ls -d "$SDK"/platforms/android-* 2>/dev/null | sort -V | tail -1)"
  [ -n "$NDK" ] && [ -d "$NDK" ] || android_die "NDK nao encontrado em $SDK/ndk"
  [ -x "$BT/aapt2" ] || android_die "build-tools (aapt2/zipalign/apksigner) nao encontrado em $SDK/build-tools"
  [ -f "$PLAT/android.jar" ] || android_die "android.jar nao encontrado em $SDK/platforms"
  local TRIPLE="aarch64-linux-android26"
  local CC="$NDK/toolchains/llvm/prebuilt/linux-x86_64/bin/clang"
  [ -x "$CC" ] || android_die "clang do NDK nao encontrado: $CC"

  ANDROID_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ofs/android"
  mkdir -p "$ANDROID_CACHE"
  android_ofscc

  local abs_input
  abs_input="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
  local in_dir; in_dir="$(dirname "$abs_input")"
  local base="${abs_input##*/}"; local app="${base%.*}"
  local OUT="${OFS_ANDROID_BUILD:-$in_dir/build/android/$app}"
  rm -rf "$OUT/obj" "$OUT/apk"
  mkdir -p "$OUT/obj" "$OUT/apk/lib/arm64-v8a"
  local entry="$abs_input"
  local manifest="$android_manifest"

  case "$abs_input" in
    *.oal)
      local oalc; oalc="$(android_tool oalc)"
      android_step "oalc: $base -> AndroidManifest.xml + ${app}_oal.ofs"
      OALC_INPUT="$abs_input" OALC_OUT_DIR="$OUT" OALC_TARGET=android "$oalc" \
        || android_die "oalc falhou em $abs_input"
      entry="$OUT/${app}_oal.ofs"
      [ -n "$manifest" ] || manifest="$OUT/AndroidManifest.xml"
      # icone (app icon "x.png") -> res/mipmap/ic_launcher.png; assets "dir" -> assets/
      rm -rf "$OUT/res" "$OUT/assets"
      if [ -f "$OUT/oal_icon.txt" ]; then
        mkdir -p "$OUT/res/mipmap"
        cp "$(cat "$OUT/oal_icon.txt")" "$OUT/res/mipmap/ic_launcher.png" || android_die "icone nao encontrado"
      fi
      if [ -f "$OUT/oal_assets.txt" ]; then
        mkdir -p "$OUT/assets"
        cp -r "$(cat "$OUT/oal_assets.txt")"/. "$OUT/assets/" || android_die "pasta de assets nao encontrada"
      fi
      ;;
  esac
  if [ -z "$manifest" ]; then
    if [ -f "$in_dir/AndroidManifest.xml" ]; then
      manifest="$in_dir/AndroidManifest.xml"
    elif [ -f "$in_dir/android/AndroidManifest.xml" ]; then
      manifest="$in_dir/android/AndroidManifest.xml"
    else
      manifest="$OUT/AndroidManifest.xml"
      local pkgname; pkgname="$(printf '%s' "$app" | tr -c 'a-zA-Z0-9\n' '_' | tr 'A-Z' 'a-z')"
      cat > "$manifest" <<MAN
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ofs.$pkgname" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application android:label="$app" android:hasCode="false" android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity android:name="android.app.NativeActivity" android:label="$app" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="$pkgname" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
MAN
    fi
  fi
  [ -f "$manifest" ] || android_die "manifesto nao encontrado: $manifest"
  local libname pkg
  libname="$(sed -n 's/.*android.app.lib_name"[^>]*android:value="\([^"]*\)".*/\1/p' "$manifest" | head -1)"
  [ -n "$libname" ] || libname="main"
  pkg="$(sed -n 's/.*package="\([^"]*\)".*/\1/p' "$manifest" | head -1)"
  [ -n "$output" ] || output="$OUT/$app-debug.apk"
  case "$output" in /*) ;; *) output="$PWD/$output" ;; esac

  android_step "IR aarch64: runtime magma"
  local magma_src="$OFS_STDLIB_PATH/runtime/magma.ofs"
  [ -f "$magma_src" ] || android_die "runtime nao encontrado: $magma_src"
  local magma_o="$ANDROID_CACHE/magma-aarch64.o"
  if [ ! -f "$magma_o" ] || [ "$magma_src" -nt "$magma_o" ] || [ "$A_OFSCC" -nt "$magma_o" ]; then
    android_ir "$magma_src" "$ANDROID_CACHE/magma.ll"
    "$CC" --target="$TRIPLE" -O2 -fPIC -Wno-override-module -c "$ANDROID_CACHE/magma.ll" -o "$magma_o"
  fi
  android_step "IR aarch64: $(basename "$entry")"
  android_ir "$entry" "$OUT/obj/app.ll"

  android_step "clang do NDK ($TRIPLE) -> lib$libname.so"
  "$CC" --target="$TRIPLE" -O2 -fPIC -Wno-override-module -c "$OUT/obj/app.ll" -o "$OUT/obj/app.o"
  # -init: o loader roda __ofs_init_globals (numa .so nao ha main()).
  # app.o antes do magma.o: com --allow-multiple-definition vale o do app.
  # 16 KB de pagina (Android 15+; inofensivo antes).
  "$CC" --target="$TRIPLE" -shared -o "$OUT/apk/lib/arm64-v8a/lib$libname.so" \
    "$OUT/obj/app.o" "$magma_o" \
    -Wl,--allow-multiple-definition -Wl,-init,__ofs_init_globals \
    -u ANativeActivity_onCreate -Wl,-z,max-page-size=16384 \
    -landroid -llog -laaudio -lm

  android_step "APK: aapt2 + zip + zipalign + apksigner"
  local res_args=()
  if [ -d "$OUT/res" ]; then
    "$BT/aapt2" compile --dir "$OUT/res" -o "$OUT/res.zip"
    res_args=("$OUT/res.zip")
  fi
  rm -f "$OUT/unsigned.apk" "$OUT/aligned.apk"
  "$BT/aapt2" link -o "$OUT/unsigned.apk" --manifest "$manifest" -I "$PLAT/android.jar" "${res_args[@]}"
  if [ -d "$OUT/assets" ]; then
    (cd "$OUT" && zip -q -r "$OUT/unsigned.apk" assets)
  fi
  (cd "$OUT/apk" && zip -q -0 -r "$OUT/unsigned.apk" lib)
  "$BT/zipalign" -f -P 16 4 "$OUT/unsigned.apk" "$OUT/aligned.apk"
  local KS="${OFS_ANDROID_KEYSTORE:-$HOME/.android/debug.keystore}"
  if [ ! -f "$KS" ]; then
    KS="$ANDROID_CACHE/debug.keystore"
    if [ ! -f "$KS" ]; then
      android_step "gerando keystore de debug ($KS)"
      keytool -genkeypair -keystore "$KS" -storepass android -keypass android \
        -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 \
        -dname "CN=Android Debug,O=Android,C=US" >/dev/null 2>&1
    fi
  fi
  mkdir -p "$(dirname "$output")"
  "$BT/apksigner" sign --ks "$KS" --ks-pass pass:android --key-pass pass:android \
    --ks-key-alias androiddebugkey --out "$output" "$OUT/aligned.apk"
  rm -f "$OUT/unsigned.apk" "$OUT/aligned.apk" "$output.idsig"
  echo "APK: $output"

  if [ "$android_install" = true ]; then
    local ADB="$SDK/platform-tools/adb"
    [ -x "$ADB" ] || ADB="$(command -v adb || true)"
    [ -n "$ADB" ] || android_die "adb nao encontrado"
    local ADBS=("$ADB")
    local serial="${android_serial:-${ANDROID_SERIAL:-}}"
    [ -n "$serial" ] && ADBS+=(-s "$serial")
    android_step "instalando e abrindo $pkg"
    "${ADBS[@]}" install -r "$output"
    "${ADBS[@]}" shell am start -n "$pkg/android.app.NativeActivity"
  fi
}

# .oal no desktop: oalc (OALC_TARGET=desktop) gera <nome>_oal.ofs com main()
# que abre a janela X11 do tamanho de um celular (backend oal_x11.ofs).
oal_desktop_entry() {
  local in="$1" dir="$2"
  ANDROID_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ofs/android"
  mkdir -p "$ANDROID_CACHE" "$dir"
  android_ofscc
  local oalc; oalc="$(android_tool oalc)"
  local abs; abs="$(cd "$(dirname "$in")" && pwd)/$(basename "$in")"
  OALC_INPUT="$abs" OALC_OUT_DIR="$dir" OALC_TARGET=desktop "$oalc" >&2 || android_die "oalc falhou em $in"
  local b="${abs##*/}"
  OAL_ENTRY="$dir/${b%.*}_oal.ofs"
  OFSCC="$A_OFSCC"
}

need_ofscc() {
  if [ ! -x "$OFSCC" ]; then
    echo "ofs: self-hosted compiler not found next to wrapper: $OFSCC" >&2
    exit 1
  fi
}

# Idioma persistido via 'ofs language' alimenta OFS_LANG quando a env nao
# estiver definida (o reporter faz OFS_LANG > LANG > en).
if [ -z "${OFS_LANG:-}" ] && [ -f "$(ofs_lang_file)" ]; then
  export OFS_LANG="$(head -n 1 "$(ofs_lang_file)")"
fi

cmd="${1:-help}"
case "$cmd" in
  version|--version|-v)
    show_version
    exit 0
    ;;
  help|--help|-h)
    usage
    exit 0
    ;;
  update)
    run_update
    exit $?
    ;;
  language)
    shift || true
    cmd_language "${1:-}"
    exit $?
    ;;
esac

need_ofscc
shift || true

mode="$cmd"
input=""
output=""
target_os="linux"
run_native=false
android_manifest=""
android_install=false
android_serial=""

case "$mode" in
  check|tokens|ast|ir|asm|build|run|clean|ui|test|twin|polish) ;;
  *)
    input="$mode"
    mode="run"
    ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    -o|--output)
      output="${2:-}"
      shift 2
      ;;
    --target|-t)
      target_os="${2:-linux}"
      shift 2
      ;;
    --target=*)
      target_os="${1#*=}"
      shift
      ;;
    --native)
      run_native=true
      shift
      ;;
    --manifest)
      android_manifest="${2:-}"
      shift 2
      ;;
    --install)
      android_install=true
      shift
      ;;
    --serial)
      android_serial="${2:-}"
      shift 2
      ;;
    *)
      if [ -z "$input" ]; then
        input="$1"
      fi
      shift
      ;;
  esac
done

if [ "$mode" = "clean" ]; then
  rm -f ./*.ll ./*.bc ./*.s
  rm -rf "${TMPDIR:-/tmp}/ofs-"*
  echo "Clean complete."
  exit 0
fi

if [ -z "$input" ]; then
  usage
  exit 2
fi

base="${input##*/}"
name="${base%.*}"
work="${TMPDIR:-/tmp}/ofs-${name}-$$"
ll="$work.ll"
bc="$work.bc"

case "$mode" in
  check|tokens|ast)
    OFSCC_INPUT="$input" OFSCC_MODE="$mode" "$OFSCC"
    ;;
  test|twin|polish)
    # Subcomandos reservados: o ofscc reconhece o stub via OFSCC_MODE e emite
    # o diagnostico i18n (twin tambem emite twin_start/twin_result em NDJSON).
    if [ -z "$input" ]; then
      usage
      exit 2
    fi
    OFSCC_INPUT="$mode" OFSCC_MODE="$mode" OFSCC_TWIN_TARGET="$input" "$OFSCC"
    ;;
  ir)
    [ -n "$output" ] || output="$name.ll"
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$output" "$OFSCC"
    ;;
  asm)
    [ -n "$output" ] || output="$name.s"
    case "$output" in *.s) ;; *) output="$output.s" ;; esac
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$OFSCC"
    native_asm "$ll" "$output"
    rm -f "$ll"
    echo "ASM: $output"
    ;;
  clean)
    rm -f ./*.ll ./*.bc ./*.s
    rm -rf "${TMPDIR:-/tmp}/ofs-"*
    echo "Clean complete."
    ;;
  build)
    if [ "$target_os" = "android" ]; then
      android_build "$input" "$output"
      exit 0
    fi
    if [ "$target_os" = "windows" ] || [ "$target_os" = "win64" ]; then
      case "${output:-$name}" in *.exe) output="${output:-$name}" ;; *) output="${output:-$name}.exe" ;; esac
    else
      [ -n "$output" ] || output="$name"
    fi
    case "$input" in
      *.oll)
        abs_input="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
        oll_src="${TMPDIR:-/tmp}/ofs-oll-build-$$.ofs"
        cat <<EOF > "$oll_src"
attach {F:oll_x11.ofs}
core main() {
    oll_x11.run_window("$abs_input")
}
EOF
        OFSCC_INPUT="$oll_src" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$OFSCC"
        rm -f "$oll_src"
        ;;
      *.oal)
        oal_desktop_entry "$input" "$work-oal"
        OFSCC_INPUT="$OAL_ENTRY" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$OFSCC"
        ;;
      *)
        OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$OFSCC"
        ;;
    esac
    native_link "$ll" "$output" "$target_os"
    chmod +x "$output" 2>/dev/null || true
    rm -f "$ll"
    rm -rf "$work-oal"
    echo "Built: $output"
    ;;
  run)
    case "$input" in
      *.oll|*.oal)
        run_native=true
        ;;
    esac
    if [ "$run_native" = true ]; then
      run_tmp="$(mktemp -d "${TMPDIR:-/tmp}/ofs-run-XXXXXX")"
      run_bin="$run_tmp/$name"
      run_ll="$run_tmp/$name.ll"
      trap 'rm -rf "$run_tmp"' EXIT INT TERM
      case "$input" in
        *.oll)
          abs_input="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
          oll_src="$run_tmp/oll_runner.ofs"
          cat <<EOF > "$oll_src"
attach {F:oll_x11.ofs}
core main() {
    oll_x11.run_window("$abs_input")
}
EOF
          OFSCC_INPUT="$oll_src" OFSCC_MODE=ir OFSCC_C_OUT="$run_ll" "$OFSCC" >&2
          ;;
        *.oal)
          oal_desktop_entry "$input" "$run_tmp/oal"
          OFSCC_INPUT="$OAL_ENTRY" OFSCC_MODE=ir OFSCC_C_OUT="$run_ll" "$OFSCC" >&2
          ;;
        *)
          OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$run_ll" "$OFSCC" >&2
          ;;
      esac
      native_link "$run_ll" "$run_bin" "linux"
      chmod +x "$run_bin"
      rm -f "$run_ll"
      "$run_bin"
    else
      OFSCC_INPUT="$input" OFSCC_MODE="run" "$OFSCC"
    fi
    ;;
  ui)
    [ -n "$output" ] || output="${name}_preview.ppm"
    ui_tmp="$(mktemp -d "${TMPDIR:-/tmp}/ofs-ui-XXXXXX")"
    ui_ofs="$ui_tmp/runner.ofs"
    ui_ll="$ui_tmp/runner.ll"
    ui_bin="$ui_tmp/runner"
    trap 'rm -rf "$ui_tmp"' EXIT INT TERM
    abs_input="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
    abs_out_dir="$(cd "$(dirname "$output")" 2>/dev/null && pwd || pwd)"
    abs_output="$abs_out_dir/$(basename "$output")"
    cat <<EOF > "$ui_ofs"
attach {F:oll.ofs}
vein main() -> void {
    forge root_id = oll.load("$abs_input")
    if (root_id < 0) {
        echo("Error: failed to parse OLL layout: $abs_input")
        exit(1)
    }
    oll.compute_layout(root_id)
    forge root_n = oll.get_node(root_id)
    forge w = root_n.box_w
    if (w <= 0) { w = 1024 }
    forge h = root_n.box_h
    if (h <= 0) { h = 768 }
    echo("OLL UI: $input (" + ofs_stone_to_obsidian(w) + "x" + ofs_stone_to_obsidian(h) + ")")
    echo("Total nodes: " + ofs_stone_to_obsidian(oll.node_count()))
    forge cv = canvas.create(w, h)
    oll.render(cv)
    canvas.save_ppm(cv, "$abs_output")
    echo("Rendered layout preview saved to: $output")
}
EOF
    OFSCC_INPUT="$ui_ofs" OFSCC_MODE=ir OFSCC_C_OUT="$ui_ll" "$OFSCC"
    native_link "$ui_ll" "$ui_bin" "linux"
    chmod +x "$ui_bin"
    "$ui_bin"
    ;;
esac
