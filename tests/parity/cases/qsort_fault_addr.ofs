// qsort da libc com comparador OFS via fault_addr.
rift vein c_qsort(base: *stone, count: stone, size: stone, cmp: stone) -> void bind "qsort" abi c
extern vein ofs_alloc(size: stone) -> *stone

vein cmp(a: *stone, b: *stone) -> stone {
    forge x = 0
    forge y = 0
    fracture { x = *a; y = *b; }
    if (x < y) { return -1 }
    if (x > y) { return 1 }
    return 0
}

core main() {
    forge buf: *stone = ofs_alloc(40)
    forge vals: Array<stone> = [9, 4, 7, 1, 5]
    forge i = 0
    while (i < 5) {
        forge p: *stone = fault_step(buf, i)
        forge v: stone = ofs_array_get(vals, i)
        fracture { *p = v; }
        i++
    }
    c_qsort(buf, 5, 8, fault_addr(cmp))
    forge line = ""
    i = 0
    while (i < 5) {
        forge p: *stone = fault_step(buf, i)
        forge v = 0
        fracture { v = *p; }
        line = line + ofs_stone_to_obsidian(v) + " "
        i++
    }
    echo(line)
}
