#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OFSCC="$ROOT/ofscc"
RUNTIME="$ROOT/libofs_runtime.a"

cmd="${1:-help}"
if [[ "$cmd" == "--help" || "$cmd" == "-h" || "$cmd" == "help" ]]; then
  cat <<'USAGE'
Usage: ofs <command> <file.ofs> [options]

Commands:
  check      Validate source
  tokens     Print token stream
  ast        Print AST summary
  ir         Emit LLVM IR
  asm        Emit native assembly
  build      Build executable
  run        Build and run executable

Options:
  -o <path>  Output path for build/asm/ir
USAGE
  exit 0
fi

shift || true

mode="$cmd"
input=""
output=""

if [[ "$mode" != "check" && "$mode" != "tokens" && "$mode" != "ast" && "$mode" != "ir" && "$mode" != "asm" && "$mode" != "build" && "$mode" != "run" ]]; then
  input="$mode"
  mode="run"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output)
      output="${2:-}"
      shift 2
      ;;
    *)
      if [[ -z "$input" ]]; then
        input="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$input" ]]; then
  echo "ofs: missing input .ofs file" >&2
  exit 2
fi

base="${input##*/}"
name="${base%.*}"
work="${TMPDIR:-/tmp}/ofs-${name}-$$"
ll="$work.ll"

case "$mode" in
  check|tokens|ast)
    OFSCC_INPUT="$input" OFSCC_MODE="$mode" "$OFSCC"
    ;;
  ir)
    if [[ -z "$output" ]]; then
      output="$name.ll"
    fi
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$output" "$OFSCC"
    ;;
  asm)
    if [[ -z "$output" ]]; then
      output="$name.s"
    elif [[ "$output" != *.s ]]; then
      output="$output.s"
    fi
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$OFSCC"
    clang -Wno-override-module -S "$ll" -o "$output"
    rm -f "$ll"
    echo "ASM: $output"
    ;;
  build|run)
    if [[ -z "$output" ]]; then
      output="$name"
    fi
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$ll" "$OFSCC"
    clang -Wno-override-module -O2 "$ll" "$RUNTIME" -lm -o "$output"
    chmod +x "$output"
    rm -f "$ll"
    if [[ "$mode" == "run" ]]; then
      "$output"
    else
      echo "Built: $output"
    fi
    ;;
esac
