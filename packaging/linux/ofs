#!/usr/bin/env bash
set -euo pipefail

OFS_VERSION="__OFS_VERSION__"
OFS_REPO="Samwns/Obsidian-Fault-Script"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OFSCC="${OFSCC:-$ROOT/ofscc}"
RUNTIME="${OFS_RUNTIME:-$ROOT/libofs_runtime.a}"
STDLIB="${OFS_STDLIB:-}"

if [ -z "$STDLIB" ]; then
  for candidate in "$ROOT/stdlib" "$ROOT/../share/ofs/stdlib" /usr/local/share/ofs/stdlib /usr/share/ofs/stdlib; do
    if [ -d "$candidate" ]; then
      STDLIB="$candidate"
      break
    fi
  done
fi
if [ -n "$STDLIB" ]; then
  export OFS_STDLIB="$STDLIB"
fi

detect_llvm_ir_flags() {
  if [ -n "${OFS_LLVM_IR_FLAGS:-}" ]; then
    printf '%s\n' "$OFS_LLVM_IR_FLAGS"
    return
  fi
  if clang --version 2>/dev/null | grep -Eq 'version 14\.|clang-1400\.'; then
    printf '%s\n' "-mllvm -opaque-pointers"
  fi
}

detect_clang_opt_level() {
  if [ -n "${OFS_CLANG_OPT:-}" ]; then
    printf '%s\n' "$OFS_CLANG_OPT"
    return
  fi
  if clang --version 2>/dev/null | grep -Eq 'version 14\.|clang-1400\.'; then
    printf '%s\n' "-O0"
  else
    printf '%s\n' "-O3"
  fi
}

OFS_LLVM_IR_FLAGS=()
detected_llvm_ir_flags="$(detect_llvm_ir_flags)"
if [ -n "$detected_llvm_ir_flags" ]; then
  read -r -a OFS_LLVM_IR_FLAGS <<< "$detected_llvm_ir_flags"
fi
OFS_CLANG_OPT_LEVEL="$(detect_clang_opt_level)"

clang_ir() {
  if [ "${#OFS_LLVM_IR_FLAGS[@]}" -gt 0 ]; then
    clang -Wno-override-module "$@" "${OFS_LLVM_IR_FLAGS[@]}"
  else
    clang -Wno-override-module "$@"
  fi
}

if [ ! -x "$OFSCC" ] && command -v ofscc >/dev/null 2>&1; then
  OFSCC="$(command -v ofscc)"
fi
if [ ! -x "$OFSCC" ] && [ -x /usr/lib/ofs/ofscc ]; then
  OFSCC="/usr/lib/ofs/ofscc"
fi
if [ ! -f "$RUNTIME" ] && [ -f /usr/local/lib/libofs_runtime.a ]; then
  RUNTIME="/usr/local/lib/libofs_runtime.a"
fi
if [ ! -f "$RUNTIME" ] && [ -f /usr/lib/ofs/libofs_runtime.a ]; then
  RUNTIME="/usr/lib/ofs/libofs_runtime.a"
fi

banner() {
  cat <<'BANNER'

 ______        ______      ______
/\  __ \      /\  ___\    /\  ___\
\ \ \/\ \     \ \  __\    \ \___  \
 \ \_____\     \ \_\       \/\_____\
  \/_____/      \/_/        \/_____/

BANNER
}

show_version() {
  banner
  printf 'ofs %s - Obsidian Fault Script\n' "$OFS_VERSION"
  printf 'status: stable\n'
}

usage() {
  banner
  cat <<EOF
ofs - Obsidian Fault Script compiler v$OFS_VERSION

Usage:
  ofs <file.ofs>                        Run a script directly
  ofs run    <file.ofs>                 Compile and run immediately
  ofs build  <file.ofs> [-o output]     Compile to native executable
  ofs check  <file.ofs>                 Type-check only (no output)
  ofs tokens <file.ofs>                 Print token stream (debug)
  ofs ast    <file.ofs>                 Print AST (debug)
  ofs ir     <file.ofs>                 Emit LLVM IR (debug)
  ofs asm    <file.ofs>                 Emit target-native assembly
  ofs odl    <file.odl> [-o page.html]  Compile ODL to HTML
  ofs oes    <file.oes> [-o style.css]  Compile OES to CSS
  ofs translate <file> --to odl|oes     Import HTML or CSS
  ofs version                           Print compiler version
  ofs update                            Update to the latest release
  ofs help                              Show this help message
EOF
}

latest_tag() {
  curl -fsSIL -o /dev/null -w '%{url_effective}' "https://github.com/$OFS_REPO/releases/latest" |
    sed 's#.*/tag/##'
}

run_update() {
  local latest asset tmp platform os_id os_like package
  latest="$(latest_tag)"
  if [ -z "$latest" ]; then
    echo "ofs update: failed to fetch latest release tag" >&2
    return 1
  fi
  if [ "v$OFS_VERSION" = "$latest" ]; then
    echo "OFS is already up to date ($latest)"
    return 0
  fi

  tmp="$(mktemp -d)"
  platform="$(uname -s)"
  if [ "$platform" = "Darwin" ]; then
    asset="ofs-macos-arm64-installer-$latest.pkg"
    echo "Downloading $asset..."
    curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$tmp/ofs.pkg"
    sudo installer -pkg "$tmp/ofs.pkg" -target /
    rm -rf "$tmp"
    if ! ofs version | grep -F "ofs ${latest#v} - Obsidian Fault Script" >/dev/null; then
      echo "ofs update: installed version did not match $latest" >&2
      return 1
    fi
    echo "Update completed to $latest"
    return 0
  fi

  os_id=""
  os_like=""
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    os_id="${ID:-}"
    os_like="${ID_LIKE:-}"
  fi

  case " $os_id $os_like " in
    *" arch "*)
      asset="ofs-arch-x64-installer-$latest.pkg.tar.zst"
      package="$tmp/$asset"
      echo "Downloading $asset..."
      curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$package"
      sudo pacman -U --noconfirm "$package"
      ;;
    *" fedora "*|*" rhel "*|*" centos "*)
      asset="ofs-fedora-x64-installer-$latest.rpm"
      package="$tmp/$asset"
      echo "Downloading $asset..."
      curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$package"
      if command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y "$package"
      else
        sudo rpm -Uvh "$package"
      fi
      ;;
    *" debian "*|*" ubuntu "*)
      asset="ofs-debian-ubuntu-x64-installer-$latest.deb"
      package="$tmp/$asset"
      echo "Downloading $asset..."
      curl -fL "https://github.com/$OFS_REPO/releases/download/$latest/$asset" -o "$package"
      if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get install -y "$package"
      else
        sudo dpkg -i "$package"
      fi
      ;;
    *)
      echo "ofs update: unsupported Linux distribution ($os_id $os_like)." >&2
      echo "Download the .deb, .rpm, or .pkg.tar.zst release manually." >&2
      return 1
      ;;
  esac

  rm -rf "$tmp"
  if ! ofs version | grep -F "ofs ${latest#v} - Obsidian Fault Script" >/dev/null; then
    echo "ofs update: installed version did not match $latest" >&2
    return 1
  fi
  echo "Update completed to $latest"
}

need_ofscc() {
  if [ ! -x "$OFSCC" ]; then
    echo "ofs: self-hosted compiler not found next to wrapper: $OFSCC" >&2
    exit 1
  fi
}

find_web_tool() {
  local name="$1"
  for candidate in \
    "$ROOT/../share/ofs/tools/$name.ofs" \
    "$ROOT/../lib/ofs/tools/$name.ofs" \
    "$ROOT/../ofs/tools/$name.ofs" \
    "$ROOT/../../ofs/tools/$name.ofs" \
    "ofs/tools/$name.ofs"; do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

run_web_tool() {
  local tool="$1" input="$2" output="$3" direction="${4:-}"
  local source tool_ll tool_bin
  source="$(find_web_tool "$tool")" || {
    echo "ofs: web language compiler source not found: $tool.ofs" >&2
    exit 1
  }
  tool_ll="${TMPDIR:-/tmp}/ofs-${tool}-$$.ll"
  tool_bin="${TMPDIR:-/tmp}/ofs-${tool}-$$"
  OFSCC_INPUT="$source" OFSCC_MODE=ir OFSCC_C_OUT="$tool_ll" run_ofscc_quiet "$OFSCC"
  clang_ir "$OFS_CLANG_OPT_LEVEL" "$tool_ll" "$RUNTIME" -lm -o "$tool_bin"
  chmod +x "$tool_bin"
  if [ "$tool" = "odlc" ]; then
    ODLC_INPUT="$input" ODLC_OUTPUT="$output" ODLC_DIRECTION="$direction" "$tool_bin"
  else
    OESC_INPUT="$input" OESC_OUTPUT="$output" OESC_DIRECTION="$direction" "$tool_bin"
  fi
  rm -f "$tool_ll" "$tool_bin"
}

cmd="${1:-help}"
case "$cmd" in
  version|--version|-v)
    show_version
    exit 0
    ;;
  help|--help|-h)
    usage
    exit 0
    ;;
  update)
    run_update
    exit $?
    ;;
esac

need_ofscc
shift || true

mode="$cmd"
input=""
output=""

case "$mode" in
  check|tokens|ast|ir|asm|build|run|odl|oes|translate) ;;
  *)
    input="$mode"
    case "$input" in
      *.odl) mode="odl" ;;
      *.oes) mode="oes" ;;
      *) mode="run" ;;
    esac
    ;;
esac

translate_to=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o|--output)
      output="${2:-}"
      shift 2
      ;;
    --to)
      translate_to="${2:-}"
      shift 2
      ;;
    *)
      if [ -z "$input" ]; then
        input="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$input" ]; then
  usage
  exit 2
fi

base="${input##*/}"
name="${base%.*}"
work="${TMPDIR:-/tmp}/ofs-${name}-$$"
ll="$work.ll"
bc="$work.bc"

run_ofscc_quiet() {
  local log
  log="$(mktemp "${TMPDIR:-/tmp}/ofscc-log-XXXXXX")"
  if "$@" >"$log" 2>&1; then
    rm -f "$log"
    return 0
  fi
  cat "$log" >&2
  rm -f "$log"
  return 1
}

run_executable() {
  case "$1" in
    */*|/*) "$1" ;;
    *) "./$1" ;;
  esac
}

case "$mode" in
  odl)
    [ -n "$output" ] || output="${input%.*}.html"
    run_web_tool odlc "$input" "$output"
    ;;
  oes)
    [ -n "$output" ] || output="${input%.*}.css"
    run_web_tool oesc "$input" "$output"
    ;;
  translate)
    if [ "$translate_to" = "odl" ]; then
      [ -n "$output" ] || output="${input%.*}.odl"
      run_web_tool odlc "$input" "$output" from-html
    elif [ "$translate_to" = "oes" ]; then
      [ -n "$output" ] || output="${input%.*}.oes"
      run_web_tool oesc "$input" "$output" from-css
    else
      echo "ofs translate: use --to odl or --to oes" >&2
      exit 2
    fi
    ;;
  check)
    OFSCC_INPUT="$input" OFSCC_MODE="$mode" run_ofscc_quiet "$OFSCC"
    ;;
  tokens|ast)
    OFSCC_INPUT="$input" OFSCC_MODE="$mode" "$OFSCC"
    ;;
  ir)
    [ -n "$output" ] || output="$name.ll"
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$output" run_ofscc_quiet "$OFSCC"
    ;;
  asm)
    [ -n "$output" ] || output="$name.s"
    case "$output" in *.s) ;; *) output="$output.s" ;; esac
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$ll" run_ofscc_quiet "$OFSCC"
    clang_ir -S "$ll" -o "$output"
    rm -f "$ll"
    echo "ASM: $output"
    ;;
  build|run)
    if [ -z "$output" ]; then
      if [ "$mode" = "run" ]; then
        output="$work"
      else
        output="$name"
      fi
    fi
    OFSCC_INPUT="$input" OFSCC_MODE=ir OFSCC_C_OUT="$ll" run_ofscc_quiet "$OFSCC"
    if [ "$mode" = "run" ] && ! grep -q '^define i32 @main(' "$ll"; then
      rm -f "$ll"
      exit 0
    fi
    clang_ir "$OFS_CLANG_OPT_LEVEL" "$ll" "$RUNTIME" -lm -o "$output"
    chmod +x "$output"
    rm -f "$ll"
    if [ "$mode" = "run" ]; then
      run_executable "$output"
      rm -f "$output"
    else
      echo "Built: $output"
    fi
    ;;
esac
