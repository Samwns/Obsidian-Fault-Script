vein quick(a: Array<stone>, lo: stone, hi: stone) -> void {
    if (lo >= hi) { return }
    forge m: stone = (lo + hi) / 2
    forge p: stone = a[m]
    a[m] = a[hi]
    a[hi] = p
    forge s: stone = lo
    forge i: stone = lo
    while (i < hi) {
        if (a[i] < p) {
            forge t: stone = a[i]
            a[i] = a[s]
            a[s] = t
            s += 1
        }
        i += 1
    }
    a[hi] = a[s]
    a[s] = p
    quick(a, lo, s - 1)
    quick(a, s + 1, hi)
}
core main() {
    forge n: stone = 100000
    forge a: Array<stone> = []
    forge x: stone = 12345
    forge k: stone = 0
    while (k < n) {
        x = (x * 1103515245 + 12345) % 2147483648
        ofs_array_push(a, x)
        k += 1
    }
    quick(a, 0, n - 1)
    forge c: stone = 0
    forge i: stone = 0
    while (i < n) {
        c = (c + a[i] % 1000003 * (i + 1)) % 1000000007
        i += 1
    }
    echo(a[0])
    echo(a[n - 1])
    echo(c)
}
