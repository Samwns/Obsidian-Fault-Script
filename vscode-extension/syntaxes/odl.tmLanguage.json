{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Obsidian Document Language",
  "scopeName": "source.odl",
  "patterns": [
    {
      "name": "comment.line.double-slash.odl",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.odl",
      "match": "\\b(document|page|body|flow|head|style|skin|meta|title|component|vein|use|mount|markdown|mark|md|html|raw|script|wire|module|node|spark|js|pulse|php|image|asset|img|studio|move)\\b"
    },
    {
      "name": "entity.name.tag.odl",
      "match": "^\\s*[a-zA-Z][\\w-]*(?=[.#\\s]|$)"
    },
    {
      "name": "entity.other.attribute-name.class.odl",
      "match": "\\.[a-zA-Z_][\\w-]*"
    },
    {
      "name": "entity.other.attribute-name.id.odl",
      "match": "#[a-zA-Z_][\\w-]*"
    },
    {
      "name": "string.quoted.double.odl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.odl",
          "match": "\\\\."
        }
      ]
    }
  ]
}
