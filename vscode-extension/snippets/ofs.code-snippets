{
  "Core Main": {
    "prefix": "main",
    "body": [
      "core main() {",
      "    $0",
      "}"
    ]
  },
  "If Else": {
    "prefix": "if",
    "body": [
      "if ($1) {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ]
  },
  "Function": {
    "prefix": "vein",
    "body": [
      "vein ${1:name}(${2}) -> ${3:void} {",
      "    $0",
      "}"
    ]
  },
  "Extern Function": {
    "prefix": "extern",
    "body": [
      "extern vein ${1:name}(${2:arg: obsidian}) -> ${3:stone}"
    ]
  },
  "Monolith": {
    "prefix": "monolith",
    "body": [
      "monolith ${1:TypeName} {",
      "    ${2:field}: ${3:stone}",
      "}",
      "",
      "$0"
    ]
  },
  "Array Stone": {
    "prefix": "array",
    "body": [
      "forge ${1:items}: Array<${2:stone}> = [${3:1, 2, 3}]"
    ]
  },
  "Cycle C Style": {
    "prefix": "cycle-c",
    "body": [
      "cycle (forge ${1:i} = ${2:0}; ${1:i} < ${3:10}; ${1:i}++) {",
      "    $0",
      "}"
    ]
  },
  "Cycle In Array": {
    "prefix": "cycle-in",
    "body": [
      "cycle (${1:item} in ${2:items}) {",
      "    $0",
      "}"
    ]
  },
  "Else If": {
    "prefix": "elseif",
    "body": [
      "else if (${1:condition}) {",
      "    $0",
      "}"
    ]
  },
  "Attach": {
    "prefix": "attach",
    "body": [
      "attach {$1}"
    ]
  },
  "Attach Stdlib": {
    "prefix": "attach-stdlib",
    "body": [
      "attach {${1|core,math,string,io,benitoite,serpentine,ofshtml,webserver,webui,bedrock,bedrock-packet,terminal-colors,memory-modes,rift,canvas,window,fmt,test-lib|}}"
    ]
  },
  "Web UI Site": {
    "prefix": "webui-site",
    "body": [
      "attach {webui}",
      "",
      "core main() {",
      "    forge body = webui.nav(${1:\"OFS Web\"}, webui.button(${2:\"Docs\"}, ${3:\"#docs\"}))",
      "    body = body + webui.hero(${4:\"Meu site OFS\"}, ${5:\"UI declarativa em OFS, servida pela propria linguagem.\"}, webui.button(${6:\"Comecar\"}, ${7:\"#docs\"}))",
      "    body = body + webui.grid(",
      "        webui.card(${8:\"Componente\"}, ${9:\"HTML e estilo gerados por biblioteca OFS.\"})",
      "        + webui.card(${10:\"Servidor\"}, ${11:\"Use Go Live para subir o arquivo como site local.\"})",
      "    )",
      "    body = body + webui.panel(${12:\"<h2 id=\\\"docs\\\">Site OFS</h2><p class=\\\"ofs-muted\\\">Pronto para editar.</p>\"})",
      "",
      "    webui.serve(${13:8080}, ${14:\"OFS Web\"}, body)",
      "}"
    ]
  },
  "Attach File": {
    "prefix": "attach-file",
    "body": [
      "attach {F:${1:module.ofs}}"
    ]
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "vein(${1:x: stone}) -> ${2:stone} {",
      "    $0",
      "}"
    ]
  },
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:name} {",
      "    $0",
      "}"
    ]
  },
  "Impl Block": {
    "prefix": "impl",
    "body": [
      "impl ${1:TypeName} {",
      "    vein ${2:method}(self) -> ${3:void} {",
      "        $0",
      "    }",
      "}"
    ]
  },
  "Bedrock Counter": {
    "prefix": "bedrock",
    "body": [
      "attach {bedrock}",
      "",
      "core main() {",
      "    forge counter = bedrock_cell_new(${1:0})",
      "    bedrock_cell_add(counter, ${2:1})",
      "    echo(bedrock_cell_read(counter))",
      "    bedrock_cell_drop(counter)",
      "}"
    ]
  },
  "Bedrock Block": {
    "prefix": "bedrock-block",
    "body": [
      "bedrock {",
      "    $0",
      "}"
    ]
  },
  "Rift Declaration": {
    "prefix": "rift",
    "body": [
      "rift vein ${1:symbol}(${2:arg: obsidian}) -> ${3:stone}"
    ]
  },
  "Small Int Pixel": {
    "prefix": "pixel-u32",
    "body": [
      "forge ${1:r}: u8 = ${2:255}",
      "forge ${3:g}: u8 = ${4:128}",
      "forge ${5:b}: u8 = ${6:0}",
      "forge ${7:pixel}: u32 = (${1:r} as u32 << 16) | (${3:g} as u32 << 8) | (${5:b} as u32)"
    ]
  },
  "Cast": {
    "prefix": "cast",
    "body": [
      "${1:value} as ${2|stone,crystal,obsidian,bool,u8,u16,u32,u64,i8,i16,i32|}"
    ]
  },
  "Bedrock Region": {
    "prefix": "bedrock-region",
    "body": [
      "attach {bedrock}",
      "",
      "core main() {",
      "    forge region = bedrock_region_new(${1:4})",
      "    bedrock_region_write(region, 0, ${2:10})",
      "    echo(bedrock_region_read(region, 0))",
      "    bedrock_region_drop(region)",
      "}"
    ]
  },
  "Rift Module": {
    "prefix": "rift-module",
    "body": [
      "attach {rift}",
      "",
      "core main() {",
      "    echo(rift_text_size(${1:\"fault\"}))",
      "}"
    ]
  },
  "Fault Field": {
    "prefix": "fault-field",
    "body": [
      "bedrock {",
      "    forge ${1:field}: stone = fault_cut(${2:header}, ${3:8}, ${4:8})",
      "    forge ${5:patched}: stone = fault_patch(${2:header}, ${6:40}, ${7:8}, ${8:0x2A})",
      "}"
    ]
  },
  "Fault Packet Header": {
    "prefix": "fault-packet",
    "body": [
      "bedrock {",
      "    forge ${1:opcode}: stone = fault_cut(${2:header}, ${3:8}, ${4:8})",
      "    forge ${5:lane}: stone = fault_cut(${2:header}, ${6:24}, ${7:8})",
      "    forge ${8:patched}: stone = fault_patch(${2:header}, ${9:40}, ${10:8}, ${11:0x2A})",
      "    forge ${12:mixed}: stone = fault_weave(${13:0x00FF00FF00FF00FF}, fault_swap(${2:header}), fault_spin_left(${2:header}, ${14:5}))",
      "    $0",
      "}"
    ]
  },
  "Fault Barrier": {
    "prefix": "fault-fence",
    "body": [
      "bedrock {",
      "    fault_fence()",
      "}"
    ]
  },
  "Rift ABI": {
    "prefix": "rift-abi",
    "body": [
      "rift vein ${1:name}(${2:text: obsidian}) -> ${3:stone} bind \"${4:symbol}\" abi ${5:c}"
    ]
  },
  "Fracture Block": {
    "prefix": "fracture",
    "body": [
      "fracture {",
      "    shard ${1:p}: *${2:stone} = &${3:x}",
      "    $0",
      "}"
    ]
  },
  "Pointer Update": {
    "prefix": "ptr-update",
    "body": [
      "fracture {",
      "    shard ${1:p}: *${2:stone} = &${3:value};",
      "    *${1:p} = *${1:p} + ${4:1}",
      "}"
    ]
  },
  "Abyss Block": {
    "prefix": "abyss",
    "body": [
      "abyss {",
      "    $0",
      "}"
    ]
  },
  "Inline Assembly": {
    "prefix": "asm",
    "body": [
      "bedrock {",
      "    asm \"${1:nop}\"",
      "}"
    ]
  },
  "Packed Monolith": {
    "prefix": "monolith-packed",
    "body": [
      "monolith ${1:Header} layout packed {",
      "    ${2:tag}: stone",
      "    ${3:flags}: stone",
      "}"
    ]
  },
  "Canvas Demo": {
    "prefix": "canvas-demo",
    "body": [
      "attach {canvas}",
      "",
      "core main() {",
      "    forge cv = canvas.create(${1:64}, ${2:48})",
      "    window.create(${3:\"Canvas Demo\"}, ${1:64}, ${2:48})",
      "",
      "    while (window.poll()) {",
      "        canvas.clear(cv, ${4:0x1A1A2E})",
      "        canvas.set_pixel(cv, input.mouse_x(), input.mouse_y(), ${5:0xFF0000})",
      "        canvas.present(cv)",
      "    }",
      "",
      "    window.destroy()",
      "    canvas.destroy(cv)",
      "}"
    ]
  }
  ,
  "Library Smoke": {
    "prefix": "lib-smoke",
    "body": [
      "attach {${1:bedrock}}",
      "",
      "core main() {",
      "    $0",
      "}"
    ]
  }
}
