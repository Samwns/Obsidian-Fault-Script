// F4: operacoes de baixo nivel dentro dos blocos que as liberam. Roda igual
// no nativo e no interpretador, sem nenhum [AVISO DE FALHA]:
//   fracture / bedrock / tectonic: *p, &x, `as` com ponteiro, fault_step,
//     fault_memcpy, fault_memset;
//   abyss: tudo isso + fault_call e fault_addr;
//   `fracture vein` / `abyss vein`: o corpo inteiro vale como o bloco.
extern vein ofs_alloc(size: stone) -> *u8

vein dobro(x: stone) -> stone {
    return x * 2
}

// a vein inteira marcada: ler e escrever por ponteiro sem bloco interno
fracture vein soma_em(p: *stone, v: stone) -> stone {
    *p = *p + v
    return *p
}

namespace mina {
    abyss vein chama(f: stone, v: stone) -> stone {
        return fault_call(f, v)
    }
}

core main() {
    forge x: stone = 10
    fracture {
        shard p: *stone = &x
        *p = 42
        echo(x)
        echo(soma_em(&x, 8))
    }

    forge buf: *u8 = ofs_alloc(32)
    bedrock {
        fault_memset(buf, 7, 16)
        forge q: *u8 = fault_step(buf, 3)
        echo(*q)
        forge base: stone = buf as stone
        forge r: *u8 = (base + 20) as *u8
        *r = 99 as u8
        fault_memcpy(buf, r, 1)
        echo(*buf)
    }

    tectonic fracture {
        forge s: *u8 = fault_step(buf, 1)
        echo(*s)
    }

    abyss {
        forge f = fault_addr(dobro)
        echo(fault_call(f, 21))
        echo(mina.chama(f, 5))
    }

    tectonic abyss {
        echo(fault_call(fault_addr(dobro), 50))
    }

    // fracture dentro de abyss e vice-versa: vale o mais forte
    abyss {
        fracture {
            echo(fault_call(fault_addr(dobro), 1))
        }
    }
}
