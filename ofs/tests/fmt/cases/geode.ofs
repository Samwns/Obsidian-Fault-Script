// geode (closure) como expressao e como argumento; bedrock com arena

claim rift

extern vein ofs_alloc(size: stone) -> *stone
extern vein qsort(base: *stone, n: stone, size: stone, cmp: vein(*stone, *stone) -> i32) -> void

core main() {
forge base = 3
  forge g = geode(x: stone) -> stone {
return x + base
      }
    forge v: *stone = ofs_alloc(16)
  qsort(v, 2, 8, geode(a: *stone, b: *stone) -> i32 {
      forge r = 0
  fracture { r = *a - *b }
          return r as i32
  })
bedrock {
  forge s = "a" + ofs_stone_to_obsidian(g(1))
      echo(s)
}
}
