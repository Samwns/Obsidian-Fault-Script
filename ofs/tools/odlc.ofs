attach {F:web_language_common.ofs}
attach {F:fileio.ofs}

extern vein getenv(name: obsidian) -> obsidian

vein odl_tag_name(token: obsidian) -> obsidian {
    forge i = 0
    while (i < ofs_str_len(token)) {
        forge c = ofs_str_char_at(token, i)
        if (c == 46 || c == 35) { break }
        i++
    }
    if (i == 0) { return "div" }
    forge name = ofs_str_substr(token, 0, i)
    if (ofs_str_eq(name, "deck")) { return "nav" }
    if (ofs_str_eq(name, "stage")) { return "main" }
    if (ofs_str_eq(name, "band")) { return "section" }
    if (ofs_str_eq(name, "tile")) { return "article" }
    if (ofs_str_eq(name, "text")) { return "p" }
    if (ofs_str_eq(name, "title1")) { return "h1" }
    if (ofs_str_eq(name, "title2")) { return "h2" }
    if (ofs_str_eq(name, "title3")) { return "h3" }
    if (ofs_str_eq(name, "link")) { return "a" }
    if (ofs_str_eq(name, "asset")) { return "img" }
    return name
}

vein odl_tag_attrs(token: obsidian) -> obsidian {
    forge id = ""
    forge classes = ""
    forge i = 0
    while (i < ofs_str_len(token)) {
        forge c = ofs_str_char_at(token, i)
        if (c == 46 || c == 35) {
            forge marker = c
            forge start = i + 1
            i++
            while (i < ofs_str_len(token)) {
                forge next = ofs_str_char_at(token, i)
                if (next == 46 || next == 35) { break }
                i++
            }
            forge name = ofs_str_substr(token, start, i - start)
            if (marker == 35) {
                id = name
            } else {
                if (!ofs_str_eq(classes, "")) { classes = classes + " " }
                classes = classes + name
            }
        } else {
            i++
        }
    }
    forge attrs = ""
    if (!ofs_str_eq(id, "")) { attrs = attrs + " id=\"" + id + "\"" }
    if (!ofs_str_eq(classes, "")) { attrs = attrs + " class=\"" + classes + "\"" }
    return attrs
}

vein odl_tag_classes(token: obsidian) -> obsidian {
    forge classes = ""
    forge i = 0
    while (i < ofs_str_len(token)) {
        forge c = ofs_str_char_at(token, i)
        if (c == 46) {
            forge start = i + 1
            i++
            while (i < ofs_str_len(token)) {
                forge next = ofs_str_char_at(token, i)
                if (next == 46 || next == 35) { break }
                i++
            }
            if (!ofs_str_eq(classes, "")) { classes = classes + " " }
            classes = classes + ofs_str_substr(token, start, i - start)
        } else {
            i++
        }
    }
    return classes
}

vein odl_studio_script() -> obsidian {
    return "<script>(function(){if(!/^(localhost|127\\.0\\.0\\.1)$/.test(location.hostname)||!location.search.includes('ofs-studio=1'))return;let box=document.createElement('div');box.style.cssText='position:fixed;right:12px;bottom:12px;z-index:2147483647;background:#071018;color:#dff8ff;border:1px solid #29e0bd;border-radius:8px;padding:10px;font:12px system-ui;box-shadow:0 12px 40px #0008';let out=document.createElement('textarea');out.style.cssText='width:280px;height:120px;background:#05080d;color:#dff8ff;border:1px solid #263244;margin-top:8px';box.innerHTML='<strong>OFS Studio</strong><br>Drag [data-odl-move]. Export copies OES.';let btn=document.createElement('button');btn.textContent='Export OES';btn.style.cssText='display:block;margin-top:8px';box.appendChild(btn);box.appendChild(out);document.body.appendChild(box);let rules={};document.querySelectorAll('[data-odl-move]').forEach(function(el){el.style.outline='1px dashed #29e0bd';el.style.cursor='move';let sx=0,sy=0,ox=0,oy=0;el.addEventListener('pointerdown',function(e){sx=e.clientX;sy=e.clientY;let m=(el.style.transform||'').match(/translate\\(([-0-9.]+)px,\\s*([-0-9.]+)px\\)/);ox=m?Number(m[1]):0;oy=m?Number(m[2]):0;el.setPointerCapture(e.pointerId)});el.addEventListener('pointermove',function(e){if(!el.hasPointerCapture(e.pointerId))return;let x=ox+e.clientX-sx,y=oy+e.clientY-sy;el.style.transform='translate('+x+'px, '+y+'px)';rules[el.dataset.odlMove]='  transform \"translate('+x+'px, '+y+'px)\"'});});btn.onclick=function(){out.value=Object.keys(rules).map(function(k){return k+'\\n'+rules[k]}).join('\\n\\n');out.select();navigator.clipboard&&navigator.clipboard.writeText(out.value)}})();</script>"
}

vein odl_compile(source: obsidian) -> obsidian {
    forge lines = wl_lines(source)
    forge tags: Array<obsidian> = []
    forge indents: Array<stone> = []
    forge title = "ODL Document"
    forge lang = "en"
    forge head = "<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
    forge body = ""
    forge i = 0

    while (i < ofs_array_len(lines)) {
        forge raw: obsidian = ofs_array_get(lines, i)
        forge clean = wl_trim(raw)
        forge indent = wl_indent(raw)
        if (ofs_str_eq(clean, "") || wl_starts_with(clean, "//")) {
            i++
            continue
        }
        forge command = wl_first_word(clean)
        if (ofs_str_eq(command, "document") || ofs_str_eq(command, "page")) {
            forge parsed_title = wl_quoted_at(clean, 0)
            forge parsed_lang = wl_quoted_at(clean, 1)
            if (!ofs_str_eq(parsed_title, "")) { title = parsed_title }
            if (!ofs_str_eq(parsed_lang, "")) { lang = parsed_lang }
            i++
            continue
        }

        body = body + wl_close_stack(tags, indents, indent, true)
        forge content = wl_quoted_at(clean, 0)

        if (ofs_str_eq(command, "style") || ofs_str_eq(command, "skin")) {
            head = head + "<link rel=\"stylesheet\" href=\"" + wl_escape_html(content) + "\">"
        } else if (ofs_str_eq(command, "meta")) {
            head = head + "<meta name=\"" + wl_escape_html(content) + "\" content=\"" + wl_escape_html(wl_quoted_at(clean, 1)) + "\">"
        } else if (ofs_str_eq(command, "title")) {
            title = content
        } else if (ofs_str_eq(command, "markdown") || ofs_str_eq(command, "md") || ofs_str_eq(command, "mark")) {
            body = body + wl_markdown(content)
        } else if (ofs_str_eq(command, "html") || ofs_str_eq(command, "raw")) {
            body = body + wl_unescape(content)
        } else if (ofs_str_eq(command, "script") || ofs_str_eq(command, "wire")) {
            body = body + "<script src=\"" + wl_escape_html(content) + "\"></script>"
        } else if (ofs_str_eq(command, "module") || ofs_str_eq(command, "node") || ofs_str_eq(command, "spark")) {
            body = body + "<script type=\"module\" src=\"" + wl_escape_html(content) + "\"></script>"
        } else if (ofs_str_eq(command, "js") || ofs_str_eq(command, "pulse")) {
            body = body + "<script>" + wl_unescape(content) + "</script>"
        } else if (ofs_str_eq(command, "php")) {
            body = body + "<?php " + wl_unescape(content) + " ?>"
        } else if (ofs_str_eq(command, "studio")) {
            body = body + odl_studio_script()
        } else if (ofs_str_eq(command, "image") || ofs_str_eq(command, "img")) {
            body = body + "<img src=\"" + wl_escape_html(content) + "\" alt=\"" + wl_escape_html(wl_quoted_at(clean, 1)) + "\">"
        } else if (ofs_str_eq(command, "component") || ofs_str_eq(command, "vein")) {
            forge name = wl_after_first_word(clean)
            body = body + "<template data-odl-component=\"" + wl_escape_html(name) + "\">"
            ofs_array_push(tags, "template")
            ofs_array_push(indents, indent)
        } else if (ofs_str_eq(command, "use") || ofs_str_eq(command, "mount")) {
            body = body + "<odl-use data-component=\"" + wl_escape_html(wl_after_first_word(clean)) + "\"></odl-use>"
        } else if (ofs_str_eq(command, "body") || ofs_str_eq(command, "head") || ofs_str_eq(command, "flow")) {
            // Structural sections are represented by the generated document shell.
        } else {
            forge tag = odl_tag_name(command)
            forge attrs = odl_tag_attrs(command)
            if (ofs_str_eq(tag, "move")) {
                forge classes = odl_tag_classes(command)
                tag = "div"
                attrs = attrs + " data-odl-move=\"." + wl_replace(classes, " ", ".") + "\""
            }
            if ((ofs_str_eq(tag, "a") || ofs_str_eq(command, "link")) && !ofs_str_eq(wl_quoted_at(clean, 1), "")) {
                attrs = attrs + " href=\"" + wl_escape_html(wl_quoted_at(clean, 1)) + "\""
            }
            if (ofs_str_eq(tag, "img")) {
                body = body + "<img" + attrs + " src=\"" + wl_escape_html(content) + "\" alt=\"" + wl_escape_html(wl_quoted_at(clean, 1)) + "\">"
                i++
                continue
            }
            if (!ofs_str_eq(content, "")) {
                body = body + "<" + tag + attrs + ">" + wl_escape_html(wl_unescape(content)) + "</" + tag + ">"
            } else {
                body = body + "<" + tag + attrs + ">"
                ofs_array_push(tags, tag)
                ofs_array_push(indents, indent)
            }
        }
        i++
    }
    body = body + wl_close_stack(tags, indents, 0, true)
    return "<!doctype html><html lang=\"" + wl_escape_html(lang) + "\"><head>" + head + "<title>" + wl_escape_html(title) + "</title></head><body>" + body + "</body></html>"
}

vein html_to_odl(source: obsidian) -> obsidian {
    forge out = "// Imported HTML. Raw blocks preserve unsupported constructs.\n"
    out = out + "document \"Imported document\" \"en\"\n"
    out = out + "body\n"
    out = out + "  html \"" + wl_replace(wl_replace(source, "\\", "\\\\"), "\"", "\\\"") + "\"\n"
    return out
}

core main() {
    forge input = getenv("ODLC_INPUT")
    forge output = getenv("ODLC_OUTPUT")
    forge direction = getenv("ODLC_DIRECTION")
    if (ofs_str_len(input) == 0) {
        echo("odlc: set ODLC_INPUT and ODLC_OUTPUT")
        return
    }
    forge source = read_file(input)
    forge result = odl_compile(source)
    if (ofs_str_eq(direction, "from-html")) {
        result = html_to_odl(source)
    }
    if (ofs_str_len(output) == 0) { output = "index.html" }
    write_file(output, result)
    echo("ODL: " + output)
}
