        t.btn_bg = 2434342
        t.btn_hover = 3618621
        t.btn_active = 1973790
        t.btn_border = 3947580
        t.btn_radius = 5
        t.card_radius = 8
        t.fg_primary = 13489908
        t.fg_secondary = 11252415
        t.fg_muted = 8750469
        t.border_subtle = 2829099
        t.border_focus = 8141549
        t.shadow_col = 986895
        return t
    }

