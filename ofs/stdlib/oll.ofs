        t.bg_statusbar = 440020
        t.accent = 440020
        t.accent_hover = 11032055
        t.accent_fg = 16777215
        t.btn_bg = 1448738
        t.btn_hover = 2172461
        t.btn_active = 3159613
        t.btn_border = 440020
        t.btn_radius = 6
