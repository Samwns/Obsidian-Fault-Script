        t.name = "dark_modern"
        t.style = 0
        t.bg_window = 1579032
        t.bg_header = 1579032
        t.bg_surface = 1973790
        t.bg_sidebar = 2039583
        t.bg_editor = 1973790
        t.bg_panel = 1579032
        t.bg_statusbar = 7153881
        t.accent = 8141549
        t.accent_hover = 7153881
