attach {F:canvas.ofs}
attach {F:fs.ofs}

extern vein ofs_str_len(s: obsidian) -> stone
extern vein ofs_str_char_at(s: obsidian, idx: stone) -> stone
extern vein ofs_str_substr(s: obsidian, start: stone, len: stone) -> obsidian
extern vein ofs_str_eq(a: obsidian, b: obsidian) -> bool
extern vein ofs_stone_to_obsidian(v: stone) -> obsidian
extern vein ofs_array_len(a: Array) -> stone
extern vein ofs_array_get(a: Array, index: stone) -> stone
extern vein ofs_array_push(a: Array, value: stone) -> void
extern vein ofs_array_set(a: Array, index: stone, value: stone) -> void

monolith OllTheme {
    name: obsidian
    style: stone
    bg_window: stone
    bg_header: stone
    bg_surface: stone
    bg_sidebar: stone
    bg_editor: stone
    bg_panel: stone
    bg_statusbar: stone
    accent: stone
    accent_hover: stone
    accent_fg: stone
    btn_bg: stone
    btn_hover: stone
    btn_active: stone
    btn_border: stone
    btn_radius: stone
    card_radius: stone
    fg_primary: stone
    fg_secondary: stone
    fg_muted: stone
    border_subtle: stone
    border_focus: stone
    shadow_col: stone
}

monolith OllNode {
    kind: stone
    name: obsidian
    text: obsidian
    bind_var: obsidian
    on_click: obsidian
    on_change: obsidian
    parent: stone
    box_x: stone
    box_y: stone
    box_w: stone
    box_h: stone
    width: stone
    height: stone
    padding: stone
    margin: stone
    gap: stone
    bg_color: stone
    fg_color: stone
    border_color: stone
    border_width: stone
    active: bool
    hover_bg_color: stone
    hover_fg_color: stone
    hover_border_color: stone
    state: stone
    auto_center: bool
    resizable: bool
    variant: obsidian
    icon: obsidian
    radius: stone
    elevation: stone
}

namespace oll {
    forge _nodes: Array<OllNode> = []
    forge _children_parent: Array<stone> = []
    forge _children_child: Array<stone> = []
    forge _root_id: stone = -1
    forge _current_theme_id: stone = 0

