attach {F:reservoir.ofs}

extern vein strlen(s: obsidian) -> stone
extern vein strcmp(a: obsidian, b: obsidian) -> stone
extern vein strstr(haystack: obsidian, needle: obsidian) -> obsidian
extern vein snprintf(buf: obsidian, size: stone, fmt: obsidian, v: stone) -> stone
extern vein strtoll(s: obsidian, endptr: *stone, base: stone) -> stone
extern vein strtod(s: obsidian, endptr: *stone) -> crystal
rift vein ofs_facet_snprintf_double(buf: obsidian, size: stone, fmt: obsidian, v: crystal) -> stone bind "snprintf" abi c

vein ofs_str_len(s: obsidian) -> stone {
    if (s == null) { return 0 }
    return strlen(s)
}

// Cache (ponteiro, comprimento) da ultima string consultada: laços que
// percorrem a mesma string deixam de chamar strlen a cada caractere (O(n^2)).
// O cache so e usado se s[n] ainda for o terminador NUL.
// Espelhado a mao em ofs/dist/magma.ll (que tem ajustes manuais).
// O indice e de BYTE (nao de caractere UTF-8): O(1) amortizado para varrer a
// mesma string. A comparacao do cache e de PONTEIRO: `s == __ofs_charat_s`
// entre `obsidian` vira strcmp (O(n) por chamada; laco sobre 1 MB = ANR no
// Android, onde o runtime e compilado deste fonte).
forge __ofs_charat_s: obsidian = null
forge __ofs_charat_n: stone = 0

vein ofs_str_char_at(s: obsidian, idx: stone) -> stone {
    fracture {
        if (s == null || idx < 0) { return -1 }
        forge slen = 0
        forge cached = false
        if ((s as stone) == (__ofs_charat_s as stone)) {
            forge tp: *u8 = (s as stone + __ofs_charat_n) as *u8
            forge tb: u8 = 1 as u8
            fracture {
                tb = *tp;
            }
            if ((tb as stone) == 0) {
                slen = __ofs_charat_n
                cached = true
            }
        }
        if (!cached) {
            slen = ofs_str_len(s)
            __ofs_charat_s = s
            __ofs_charat_n = slen
        }
        if (idx >= slen) { return -1 }
        forge p: *u8 = (s as stone + idx) as *u8
        forge b: u8 = 0 as u8
        fracture {
            b = *p
        }
        return b as stone
    }
}

vein ofs_str_char_at_known(s: obsidian, idx: stone) -> stone {
    fracture {
        forge p: *u8 = (s as stone + idx) as *u8
        forge b: u8 = 0 as u8
        fracture { b = *p }
        return b as stone
    }
}

vein ofs_str_eq(a: obsidian, b: obsidian) -> bool {
    if (a == null && b == null) { return true }
    if (a == null || b == null) { return false }
    if (strcmp(a, b) == 0) { return true }
    return false
}

vein ofs_str_concat(a: obsidian, b: obsidian) -> obsidian {
    fracture {
        forge la = ofs_str_len(a)
        forge lb = ofs_str_len(b)
        forge total = la + lb
        forge res: obsidian = ofs_alloc(total + 1)
        if (la > 0) {
            memcpy(res as *stone, a as *stone, la)
        }
        if (lb > 0) {
            forge resp = res as stone + la
            memcpy(resp as *stone, b as *stone, lb)
        }
        return res
    }
}

// ── Concatenacao sem lixo (A6) ──────────────────────────────────────────
// Strings nao tem GC nem contagem de referencia: `t = s` faz t e s
// apontarem para o mesmo buffer. Por isso o runtime NUNCA decide sozinho
// crescer ou liberar um buffer; quem decide e o compilador (llvmgen), que so
// passa as flags abaixo quando provou que o buffer e exclusivo:
//   1 = `a` e exclusivo (temporario de uma concatenacao anterior da mesma
//       expressao, ou o valor proprio de uma variavel local que nunca foi
//       copiada para outro lugar): pode crescer no lugar com realloc.
//   2 = `b` e um temporario exclusivo: e liberado depois da copia.
// Sem flags, igual a ofs_str_concat (sempre copia).

// O cache de ofs_str_char_at guarda (ponteiro, comprimento): um buffer
// liberado ou realocado pode voltar no mesmo endereco com outro texto.
vein __ofs_str_forget(p: obsidian) -> void {
    if ((p as stone) == (__ofs_charat_s as stone)) {
        __ofs_charat_s = null
        __ofs_charat_n = 0
    }
}

vein ofs_str_concat_ex(a: obsidian, b: obsidian, flags: stone) -> obsidian {
    fracture {
        forge la = ofs_str_len(a)
        forge lb = ofs_str_len(b)
        forge total = la + lb
        forge res: obsidian = null
        forge src: stone = b as stone
        if ((flags & 1) != 0 && a != null) {
            forge ab: stone = a as stone
            // `s = s + s`: b aponta para dentro do proprio buffer de a
            forge inside = false
            if (src >= ab && src <= ab + la) { inside = true }
            __ofs_str_forget(a)
            res = ofs_realloc(a as *stone, total + 1)
            if (inside) { src = res as stone + (src - ab) }
            if (lb > 0) {
                forge rp = res as stone + la
                memmove(rp as *stone, src as *stone, lb)
            }
        } else {
            res = ofs_alloc(total + 1)
            if (la > 0) {
                memcpy(res as *stone, a as *stone, la)
            }
            if (lb > 0) {
                forge rp2 = res as stone + la
                memcpy(rp2 as *stone, src as *stone, lb)
            }
        }
        forge term: *u8 = (res as stone + total) as *u8
        fracture { *term = 0 as u8 }
        if ((flags & 2) != 0 && b != null) {
            __ofs_str_forget(b)
            free(b as *stone)
        }
        return res
    }
}

// Libera `s` se `own` != 0 (o compilador provou que s e exclusivo).
vein ofs_str_release(s: obsidian, own: stone) -> void {
    fracture {
        if (own != 0 && s != null) {
            __ofs_str_forget(s)
            free(s as *stone)
        }
    }
}

vein ofs_str_substr(s: obsidian, start: stone, len: stone) -> obsidian {
    fracture {
        if (s == null) { return "" }
        forge slen = ofs_str_len(s)
        if (start < 0) { start = 0 }
        if (start >= slen) { return "" }
        if (len < 0 || start + len > slen) { len = slen - start }
        forge res: obsidian = ofs_alloc(len + 1)
        if (len > 0) {
            forge sp = s as stone + start
            memcpy(res as *stone, sp as *stone, len)
        }
        // ofs_alloc does NOT zero memory; ensure NUL terminator otherwise
        // strlen/ofs_str_len see trailing garbage (caused attach-boundary bytes).
        forge term: *u8 = (res as stone + len) as *u8
        fracture { *term = 0 as u8 }
        return res
    }
}

vein ofs_str_contains(haystack: obsidian, needle: obsidian) -> bool {
    if (haystack == null || needle == null) { return false }
    forge p = strstr(haystack, needle)
    if (p != null) { return true }
    return false
}

vein ofs_str_upper(s: obsidian) -> obsidian {
    fracture {
        if (s == null) { return "" }
        forge slen = ofs_str_len(s)
        forge res: obsidian = ofs_alloc(slen + 1)
        forge i = 0
        while (i < slen) {
            forge c = ofs_str_char_at(s, i)
            if (c >= 97 && c <= 122) { c = c - 32 }
            forge p: *u8 = (res as stone + i) as *u8
            fracture {
                *p = c as u8
            }
            i++
        }
        return res
    }
}

vein ofs_str_lower(s: obsidian) -> obsidian {
    fracture {
        if (s == null) { return "" }
        forge slen = ofs_str_len(s)
        forge res: obsidian = ofs_alloc(slen + 1)
        forge i = 0
        while (i < slen) {
            forge c = ofs_str_char_at(s, i)
            if (c >= 65 && c <= 90) { c = c + 32 }
            forge p: *u8 = (res as stone + i) as *u8
            fracture {
                *p = c as u8
            }
            i++
        }
        return res
    }
}

// Implementação portátil (sem sprintf — ausente no MSVC puro):
// escreve os dígitos em ordem reversa no fim do buffer e devolve
// um ponteiro para o primeiro dígito. Suficiente para i64.
vein ofs_stone_to_obsidian(v: stone) -> obsidian {
    fracture {
        forge buf: obsidian = ofs_alloc(32)
        forge base: stone = buf as stone
        forge pos: stone = base + 31
        forge pz: *u8 = pos as *u8
        fracture { *pz = 0 as u8 }
        forge n = v
        forge neg = false
        // n fica com o sinal original e cada digito sai com `% 10` em modulo:
        // negar MIN_I64 estoura (antes `echo` de MIN_I64 imprimia so "-").
        if (n < 0) { neg = true }
        if (n == 0) {
            pos = pos - 1
            forge p0: *u8 = pos as *u8
            fracture { *p0 = 48 as u8 }
        } else {
            while (n != 0) {
                forge d = n % 10
                if (d < 0) { d = 0 - d }
                pos = pos - 1
                forge pd: *u8 = pos as *u8
                fracture { *pd = (48 + d) as u8 }
                n = n / 10
            }
        }
        if (neg) {
            pos = pos - 1
            forge pm: *u8 = pos as *u8
            fracture { *pm = 45 as u8 }
        }
        return pos as obsidian
    }
}

vein ofs_crystal_to_obsidian(v: crystal) -> obsidian {
    fracture {
        forge buf: obsidian = ofs_alloc(64)
        // snprintf existe em POSIX e em MSVC a partir do VS2015 (via UCRT).
        ofs_facet_snprintf_double(buf, 64, "%.15g", v)
        // Paridade intérprete × nativo: inteiro precisa mostrar ".0".
        // Só anexa se não houver '.', 'e'/'E' (expoente), nem 'n'/'N' (nan/inf).
        forge slen: stone = ofs_str_len(buf)
        if (slen < 61) {
            forge has_special = false
            forge i: stone = 0
            while (i < slen) {
                forge c: stone = ofs_str_char_at_known(buf, i)
                if (c == 46) { has_special = true }
                if (c == 101) { has_special = true }
                if (c == 69) { has_special = true }
                if (c == 110) { has_special = true }
                if (c == 78) { has_special = true }
                i++
            }
            if (!has_special) {
                forge pd: *u8 = (buf as stone + slen) as *u8
                fracture { *pd = 46 as u8 }
                forge pz: *u8 = (buf as stone + slen + 1) as *u8
                fracture { *pz = 48 as u8 }
                forge pn: *u8 = (buf as stone + slen + 2) as *u8
                fracture { *pn = 0 as u8 }
            }
        }
        return buf
    }
}

vein ofs_obsidian_to_stone(s: obsidian) -> stone {
    if (s == null) { return 0 }
    return strtoll(s, null, 10)
}

vein ofs_obsidian_to_crystal(s: obsidian) -> crystal {
    if (s == null) { return 0.0 }
    return strtod(s, null)
}

namespace facet {
    vein len(s: obsidian) -> stone {
        return ofs_str_len(s)
    }

    vein char_at(s: obsidian, idx: stone) -> stone {
        return ofs_str_char_at(s, idx)
    }

    vein eq(a: obsidian, b: obsidian) -> bool {
        return ofs_str_eq(a, b)
    }

    vein concat(a: obsidian, b: obsidian) -> obsidian {
        return ofs_str_concat(a, b)
    }

    vein substr(s: obsidian, start: stone, count: stone) -> obsidian {
        return ofs_str_substr(s, start, count)
    }

    vein contains(haystack: obsidian, needle: obsidian) -> bool {
        return ofs_str_contains(haystack, needle)
    }

    vein to_upper(s: obsidian) -> obsidian {
        return ofs_str_upper(s)
    }

    vein to_lower(s: obsidian) -> obsidian {
        return ofs_str_lower(s)
    }

    vein from_stone(v: stone) -> obsidian {
        return ofs_stone_to_obsidian(v)
    }

    vein to_stone(s: obsidian) -> stone {
        return ofs_obsidian_to_stone(s)
    }

    vein from_crystal(v: crystal) -> obsidian {
        return ofs_crystal_to_obsidian(v)
    }

    vein to_crystal(s: obsidian) -> crystal {
        return ofs_obsidian_to_crystal(s)
    }
}
