// OFS Standard Library — TLS Module
// Conexoes TLS (HTTPS) usando o OpenSSL do sistema (libssl/libcrypto 3).
// Linke com:  OFS_LINK_LIBS="-lssl -lcrypto" ofs build app.ofs
//
//   forge fd = net.tcp_connect(net.resolve("example.org"), 443)
//   forge s = tls.connect(fd, "example.org")      // null se falhar
//   tls.send(s, "GET / HTTP/1.0\r\nHost: example.org\r\n\r\n")
//   forge buf = tls.recv_all(s)                    // tls.last_len bytes
//   tls.close(s)
//
// Seguranca: o certificado e verificado contra as CAs do sistema e o nome
// do host e conferido (SSL_set1_host). Falhas ficam em tls.last_error.

extern vein TLS_client_method() -> *stone
extern vein SSL_CTX_new(method: *stone) -> *stone
extern vein SSL_CTX_set_default_verify_paths(ctx: *stone) -> stone
extern vein SSL_CTX_set_verify(ctx: *stone, mode: stone, cb: *stone) -> void
extern vein SSL_new(ctx: *stone) -> *stone
extern vein SSL_set_fd(ssl: *stone, fd: stone) -> stone
extern vein SSL_ctrl(ssl: *stone, cmd: stone, larg: stone, parg: obsidian) -> stone
extern vein SSL_set1_host(ssl: *stone, host: obsidian) -> stone
extern vein SSL_connect(ssl: *stone) -> stone
extern vein SSL_write(ssl: *stone, buf: obsidian, n: stone) -> stone
extern vein SSL_read(ssl: *stone, buf: obsidian, n: stone) -> stone
extern vein SSL_shutdown(ssl: *stone) -> stone
extern vein SSL_free(ssl: *stone) -> void
extern vein SSL_get_verify_result(ssl: *stone) -> stone
extern vein X509_verify_cert_error_string(n: stone) -> obsidian
extern vein ofs_alloc(size: stone) -> *stone
extern vein ofs_free(ptr: *stone) -> void
extern vein memcpy(dst: *stone, src: *stone, size: stone) -> *stone
extern vein ofs_str_len(s: obsidian) -> stone

namespace tls {
    forge _ctx: *stone = null
    forge last_error: obsidian = ""
    forge last_len: stone = 0

    vein _init() -> bool {
        if (_ctx != null) { return true }
        _ctx = SSL_CTX_new(TLS_client_method())
        if (_ctx == null) {
            last_error = "OpenSSL indisponivel"
            return false
        }
        SSL_CTX_set_default_verify_paths(_ctx)
        // SSL_VERIFY_PEER = 1: recusa certificados invalidos
        SSL_CTX_set_verify(_ctx, 1, null)
        return true
    }

    // Faz o handshake TLS sobre um socket TCP ja conectado.
    // Retorna o objeto SSL ou null (motivo em last_error).
    vein connect(fd: stone, host: obsidian) -> *stone {
        last_error = ""
        if (!_init()) { return null }
        forge ssl = SSL_new(_ctx)
        if (ssl == null) {
            last_error = "SSL_new falhou"
            return null
        }
        SSL_set_fd(ssl, fd)
        // SNI (SSL_CTRL_SET_TLSEXT_HOSTNAME = 55) e verificacao do nome
        SSL_ctrl(ssl, 55, 0, host)
        SSL_set1_host(ssl, host)
        if (SSL_connect(ssl) != 1) {
            forge vr = SSL_get_verify_result(ssl)
            if (vr != 0) {
                last_error = X509_verify_cert_error_string(vr)
            } else {
                last_error = "falha no handshake TLS"
            }
            SSL_free(ssl)
            return null
        }
        return ssl
    }

    vein send(ssl: *stone, data: obsidian) -> stone {
        return SSL_write(ssl, data, ofs_str_len(data))
    }

    // Le ate o servidor fechar; buffer binario com NUL extra (last_len bytes).
    vein recv_all(ssl: *stone) -> *stone {
        fracture {
            forge cap = 65536
            forge buf: *stone = ofs_alloc(cap + 1)
            forge len = 0
            while (true) {
                if (cap - len < 16384) {
                    forge ncap = cap * 2
                    forge nb: *stone = ofs_alloc(ncap + 1)
                    memcpy(nb, buf, len)
                    ofs_free(buf)
                    buf = nb
                    cap = ncap
                }
                forge n = SSL_read(ssl, (((buf as stone) + len) as obsidian), cap - len)
                if (n <= 0) { break }
                len = len + n
            }
            last_len = len
            return buf
        }
    }

    vein close(ssl: *stone) -> void {
        if (ssl == null) { return }
        SSL_shutdown(ssl)
        SSL_free(ssl)
    }
}
