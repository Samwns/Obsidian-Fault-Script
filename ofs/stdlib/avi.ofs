// OFS Standard Library — avi: leitor AVI (RIFF/OpenDML) e decodificador
// Microsoft Video 1 (CRAM/MSVC, 16 bits) em OFS puro.
//
//   forge v = avi.open("/.../op.avi")          // -1 se nao abrir
//   avi.codec(v)          // FourCC do video, ex.: "CRAM", "XVID"
//   avi.supported(v)      // true se o codec puder ser decodificado aqui
//   avi.width(v) / avi.height(v) / avi.frames(v) / avi.us_per_frame(v)
//   forge dst = ofs_alloc(avi.width(v) * avi.height(v) * 8)
//   avi.decode(v, i, dst) // quadro i em dst: 0xRRGGBB por pixel (stone)
//   avi.audio_format(v) / audio_channels / audio_rate / audio_bits
//   forge pcm = avi.read_audio(v)   // PCM do audio (formato 1), ou 0
//   avi.audio_bytes(v)              // tamanho de `pcm` em bytes
//   avi.close(v)
//
// O decodificador e sequencial: quadros delta dependem do anterior, entao
// decode(v, i) decodifica os quadros que faltam entre o ultimo e i (voltar
// no tempo recomeca do quadro 0). O arquivo fica aberto e cada quadro e
// lido do disco na hora (videos de 100 MB nao vao para a memoria).

extern vein fopen(path: obsidian, mode: obsidian) -> *stone
extern vein fclose(f: *stone) -> stone
extern vein fread(buf: *stone, sz: stone, n: stone, f: *stone) -> stone
extern vein fseek(f: *stone, offset: stone, whence: stone) -> stone
extern vein ftell(f: *stone) -> stone
extern vein ofs_alloc(size: stone) -> *stone
extern vein ofs_free(ptr: *stone) -> void
extern vein ofs_str_char_at_known(s: obsidian, idx: stone) -> stone
extern vein ofs_str_substr(s: obsidian, start: stone, len: stone) -> obsidian

namespace avi {
    forge _file: Array<stone> = []
    forge _w: Array<stone> = []
    forge _h: Array<stone> = []
    forge _usf: Array<stone> = []
    forge _fourcc: Array<stone> = []
    forge _bpp: Array<stone> = []
    forge _afmt: Array<stone> = []
    forge _ach: Array<stone> = []
    forge _arate: Array<stone> = []
    forge _abits: Array<stone> = []
    forge _abytes: Array<stone> = []
    // blocos de todos os arquivos, em listas planas; cada video guarda o
    // inicio e a quantidade dos seus
    forge _vo: Array<stone> = []
    forge _vl: Array<stone> = []
    forge _ao: Array<stone> = []
    forge _al: Array<stone> = []
    forge _v0: Array<stone> = []
    forge _vn: Array<stone> = []
    forge _a0: Array<stone> = []
    forge _an: Array<stone> = []
    forge _last: Array<stone> = []          // ultimo quadro decodificado
    forge _buf: *stone = null               // dados do quadro atual
    forge _buf_cap: stone = 0
    forge _lut: *stone = null               // RGB555 -> 0xRRGGBB
    forge last_error: obsidian = ""

    // ── bytes (little-endian) ────────────────────────────────────────────
    vein _gb(b: stone, i: stone) -> stone {
        fracture {
            forge p: *u8 = (b + i) as *u8
            forge v: u8 = 0 as u8
            fracture { v = *p; }
            return (v as stone) & 255
        }
    }
    vein _u16(b: stone, i: stone) -> stone { return _gb(b, i) | (_gb(b, i + 1) << 8) }
    vein _u32(b: stone, i: stone) -> stone { return _u16(b, i) | (_u16(b, i + 2) << 16) }
    vein _rd(p: *stone, i: stone) -> stone {
        fracture {
            forge q: *stone = fault_step(p, i)
            forge v = 0
            fracture { v = *q; }
            return v
        }
    }
    vein _wr(p: *stone, i: stone, v: stone) -> void {
        fracture {
            forge q: *stone = fault_step(p, i)
            fracture { *q = v; }
        }
    }

    vein _tag(s: obsidian) -> stone {
        return (ofs_str_char_at_known(s, 0) & 255) | ((ofs_str_char_at_known(s, 1) & 255) << 8) | ((ofs_str_char_at_known(s, 2) & 255) << 16) | ((ofs_str_char_at_known(s, 3) & 255) << 24)
    }

    vein _fourcc_str(t: stone) -> obsidian {
        forge s = ""
        forge k = 0
        while (k < 4) {
            forge c = (t >> (k * 8)) & 255
            if (c >= 48 && c < 123) { s = s + ofs_str_substr("0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[_]^_`abcdefghijklmnopqrstuvwxyz", c - 48, 1) }
            k++
        }
        return s
    }

    vein _read_at(f: *stone, pos: stone, n: stone) -> stone {
        fracture {
            if (_buf_cap < n + 16) {
                if (_buf != null) { ofs_free(_buf) }
                _buf_cap = n + 65536
                _buf = ofs_alloc(_buf_cap)
            }
            fseek(f, pos, 0)
            forge got = fread(_buf, 1, n, f)
            if (got < n) { return -1 }
            return _buf as stone
        }
    }

    vein _ensure_lut() -> void {
        if (_lut != null) { return }
        _lut = ofs_alloc(32768 * 8)
        forge c = 0
        while (c < 32768) {
            forge r = (c >> 10) & 31
            forge g = (c >> 5) & 31
            forge b = c & 31
            _wr(_lut, c, (((r << 3) | (r >> 2)) << 16) | (((g << 3) | (g >> 2)) << 8) | ((b << 3) | (b >> 2)))
            c++
        }
    }

    // ── abrir ────────────────────────────────────────────────────────────
    vein open(path: obsidian) -> stone {
        fracture {
            forge f = fopen(path, "rb")
            if (f == null) {
                last_error = "nao abriu " + path
                return -1
            }
            fseek(f, 0, 2)
            forge fsize = ftell(f)
            forge hb = _read_at(f, 0, 12)
            if (hb < 0 || _u32(hb, 0) != _tag("RIFF") || _u32(hb, 8) != _tag("AVI ")) {
                fclose(f)
                last_error = "nao e AVI"
                return -1
            }
            forge w = 0
            forge h = 0
            forge usf = 33333
            forge fcc = 0
            forge bpp = 0
            forge afmt = -1
            forge ach = 0
            forge arate = 0
            forge abits = 0
            forge vstream = -1
            forge astream = -1
            forge v0 = ofs_array_len(_vo)
            forge a0 = ofs_array_len(_ao)
            forge abytes = 0
            // pilha de fins de LIST/RIFF para descer em hdrl/strl/movi/rec
            forge pos = 12
            forge end = fsize
            forge stream = -1
            forge stype = 0
            while (pos + 8 <= end) {
                forge c = _read_at(f, pos, 12)
                if (c < 0) { break }
                forge id = _u32(c, 0)
                forge sz = _u32(c, 4)
                forge body = pos + 8
                if (id == _tag("RIFF") || id == _tag("LIST")) {
                    forge lt = _u32(c, 8)
                    if (lt == _tag("strl")) { stream++ }
                    // desce na lista: so pula o cabecalho
                    pos = body + 4
                    continue
                }
                if (id == _tag("avih") && sz >= 40) {
                    forge a = _read_at(f, body, 40)
                    usf = _u32(a, 0)
                    w = _u32(a, 32)
                    h = _u32(a, 36)
                } else if (id == _tag("strh") && sz >= 8) {
                    forge a = _read_at(f, body, 8)
                    stype = _u32(a, 0)
                    if (stype == _tag("vids") && vstream < 0) {
                        vstream = stream
                        fcc = _u32(a, 4)
                    }
                    if (stype == _tag("auds") && astream < 0) { astream = stream }
                } else if (id == _tag("strf")) {
                    if (stream == vstream && stype == _tag("vids") && sz >= 20) {
                        forge a = _read_at(f, body, 20)
                        bpp = _u16(a, 14)
                        forge comp = _u32(a, 16)
                        if (comp != 0) { fcc = comp }
                    } else if (stream == astream && stype == _tag("auds") && sz >= 16) {
                        forge a = _read_at(f, body, 16)
                        afmt = _u16(a, 0)
                        ach = _u16(a, 2)
                        arate = _u32(a, 4)
                        abits = _u16(a, 14)
                    }
                } else if (id != _tag("idx1") && id != _tag("JUNK")) {
                    // ##dc / ##db (video) e ##wb (audio) dentro do movi
                    forge d0 = (id & 255) - 48
                    forge d1 = ((id >> 8) & 255) - 48
                    forge kind = (id >> 16) & 65535
                    if (d0 >= 0 && d0 <= 9 && d1 >= 0 && d1 <= 9) {
                        forge sn = d0 * 10 + d1
                        if (sn == vstream && (kind == 25444 || kind == 25188)) {   // "dc" / "db"
                            ofs_array_push(_vo, body)
                            ofs_array_push(_vl, sz)
                        } else if (sn == astream && kind == 25207) {              // "wb"
                            ofs_array_push(_ao, body)
                            ofs_array_push(_al, sz)
                            abytes = abytes + sz
                        }
                    }
                }
                pos = body + sz + (sz & 1)
            }
            if (w <= 0 || h <= 0 || ofs_array_len(_vo) == v0) {
                fclose(f)
                last_error = "sem video"
                return -1
            }
            ofs_array_push(_file, f as stone)
            ofs_array_push(_w, w)
            ofs_array_push(_h, h)
            ofs_array_push(_usf, usf)
            ofs_array_push(_fourcc, fcc)
            ofs_array_push(_bpp, bpp)
            ofs_array_push(_afmt, afmt)
            ofs_array_push(_ach, ach)
            ofs_array_push(_arate, arate)
            ofs_array_push(_abits, abits)
            ofs_array_push(_abytes, abytes)
            ofs_array_push(_v0, v0)
            ofs_array_push(_vn, ofs_array_len(_vo) - v0)
            ofs_array_push(_a0, a0)
            ofs_array_push(_an, ofs_array_len(_ao) - a0)
            ofs_array_push(_last, -1)
            return ofs_array_len(_file) - 1
        }
    }

    vein close(v: stone) -> void {
        fracture {
            if (v < 0 || v >= ofs_array_len(_file)) { return }
            forge f = ofs_array_get(_file, v)
            if (f != 0) { fclose(f as *stone) }
            ofs_array_set(_file, v, 0)
            ofs_array_set(_vn, v, 0)
            ofs_array_set(_an, v, 0)
            // as listas planas so encolhem quando nao ha mais video aberto
            forge any = false
            forge k = 0
            while (k < ofs_array_len(_file)) {
                if (ofs_array_get(_file, k) != 0) { any = true }
                k++
            }
            if (!any) {
                _vo = []
                _vl = []
                _ao = []
                _al = []
            }
        }
    }

    vein width(v: stone) -> stone { return ofs_array_get(_w, v) }
    vein height(v: stone) -> stone { return ofs_array_get(_h, v) }
    vein us_per_frame(v: stone) -> stone { return ofs_array_get(_usf, v) }
    vein frames(v: stone) -> stone { return ofs_array_get(_vn, v) }
    vein fourcc(v: stone) -> stone { return ofs_array_get(_fourcc, v) }
    vein codec(v: stone) -> obsidian { return _fourcc_str(ofs_array_get(_fourcc, v)) }
    vein bits(v: stone) -> stone { return ofs_array_get(_bpp, v) }
    vein audio_format(v: stone) -> stone { return ofs_array_get(_afmt, v) }
    vein audio_channels(v: stone) -> stone { return ofs_array_get(_ach, v) }
    vein audio_rate(v: stone) -> stone { return ofs_array_get(_arate, v) }
    vein audio_bits(v: stone) -> stone { return ofs_array_get(_abits, v) }
    vein audio_bytes(v: stone) -> stone { return ofs_array_get(_abytes, v) }

    // Microsoft Video 1 (CRAM / MSVC / msvc / cram) com 16 bits por pixel.
    vein supported(v: stone) -> bool {
        forge t = ofs_array_get(_fourcc, v)
        forge msv1 = t == _tag("CRAM") || t == _tag("cram") || t == _tag("MSVC") || t == _tag("msvc") || t == _tag("WHAM") || t == _tag("wham")
        return msv1 && ofs_array_get(_bpp, v) == 16
    }

    // Todo o audio do arquivo (blocos ##wb em ordem) num bloco novo de
    // memoria; libere com ofs_free. 0 se nao houver audio.
    vein read_audio(v: stone) -> stone {
        fracture {
            forge total = ofs_array_get(_abytes, v)
            if (total <= 0) { return 0 }
            forge f = ofs_array_get(_file, v) as *stone
            forge a0 = ofs_array_get(_a0, v)
            forge an = ofs_array_get(_an, v)
            forge out: *stone = ofs_alloc(total + 16)
            forge pos = 0
            forge i = 0
            while (i < an) {
                forge n = ofs_array_get(_al, a0 + i)
                fseek(f, ofs_array_get(_ao, a0 + i), 0)
                fread(fault_step(out as *u8, pos) as *stone, 1, n, f)
                pos = pos + n
                i++
            }
            return out as stone
        }
    }

    // ── decodificacao ────────────────────────────────────────────────────
    // Decodifica ate o quadro i (inclusive) em dst (w*h stones, 0xRRGGBB,
    // de cima para baixo). Devolve false se o codec nao for suportado.
    vein decode(v: stone, i: stone, dst: *stone) -> bool {
        fracture {
            if (!supported(v)) { return false }
            forge n = frames(v)
            if (i >= n) { i = n - 1 }
            forge last = ofs_array_get(_last, v)
            if (i == last) { return true }
            if (i < last) { last = -1 }
            _ensure_lut()
            forge f = ofs_array_get(_file, v) as *stone
            forge v0 = ofs_array_get(_v0, v)
            forge k = last + 1
            while (k <= i) {
                forge len = ofs_array_get(_vl, v0 + k)
                if (len > 0) {
                    forge b = _read_at(f, ofs_array_get(_vo, v0 + k), len)
                    if (b >= 0) { _msv1_16(b, len, width(v), height(v), dst) }
                }
                k++
            }
            ofs_array_set(_last, v, i)
            return true
        }
    }

    // Quadro de Microsoft Video 1, 16 bits (RGB555). Blocos 4x4 a partir
    // do canto inferior esquerdo; dentro do bloco, linhas de baixo para cima.
    vein _msv1_16(b: stone, len: stone, w: stone, h: stone, dst: *stone) -> void {
        forge bw = w / 4
        forge bh = h / 4
        forge total = bw * bh
        forge skip = 0
        forge p = 0
        forge by = bh - 1
        while (by >= 0) {
            forge bx = 0
            while (bx < bw) {
                if (skip > 0) {
                    skip--
                    total--
                    bx++
                    continue
                }
                if (p + 2 > len) { return }
                forge ba = _gb(b, p)
                forge bb = _gb(b, p + 1)
                p = p + 2
                // linha de baixo do bloco no destino
                forge base = (by * 4 + 3) * w + bx * 4
                if (ba == 0 && bb == 0 && total == 0) { return }
                if ((bb & 252) == 132) {
                    skip = ((bb - 132) << 8) + ba - 1
                } else if (bb < 128) {
                    forge flags = (bb << 8) | ba
                    forge c0 = _u16(b, p)
                    forge c1 = _u16(b, p + 2)
                    if ((c0 & 32768) != 0) {
                        // 8 cores: um par por quadrante
                        if (p + 16 > len) { return }
                        forge q0 = _rd(_lut, c0 & 32767)
                        forge q1 = _rd(_lut, c1 & 32767)
                        forge q2 = _rd(_lut, _u16(b, p + 4) & 32767)
                        forge q3 = _rd(_lut, _u16(b, p + 6) & 32767)
                        forge q4 = _rd(_lut, _u16(b, p + 8) & 32767)
                        forge q5 = _rd(_lut, _u16(b, p + 10) & 32767)
                        forge q6 = _rd(_lut, _u16(b, p + 12) & 32767)
                        forge q7 = _rd(_lut, _u16(b, p + 14) & 32767)
                        p = p + 16
                        forge py = 0
                        while (py < 4) {
                            forge row = base - py * w
                            forge px = 0
                            while (px < 4) {
                                forge q = ((py & 2) << 1) + (px & 2)
                                forge on = (flags & 1) != 0
                                forge c = 0
                                if (q == 0) {
                                    if (on) { c = q0 } else { c = q1 }
                                } else if (q == 2) {
                                    if (on) { c = q2 } else { c = q3 }
                                } else if (q == 4) {
                                    if (on) { c = q4 } else { c = q5 }
                                } else {
                                    if (on) { c = q6 } else { c = q7 }
                                }
                                _wr(dst, row + px, c)
                                flags = flags >> 1
                                px++
                            }
                            py++
                        }
                    } else {
                        if (p + 4 > len) { return }
                        p = p + 4
                        forge a0 = _rd(_lut, c0 & 32767)
                        forge a1 = _rd(_lut, c1 & 32767)
                        forge py = 0
                        while (py < 4) {
                            forge row = base - py * w
                            forge px = 0
                            while (px < 4) {
                                if ((flags & 1) != 0) { _wr(dst, row + px, a0) } else { _wr(dst, row + px, a1) }
                                flags = flags >> 1
                                px++
                            }
                            py++
                        }
                    }
                } else {
                    // bloco de uma cor so
                    forge cf = _rd(_lut, ((bb << 8) | ba) & 32767)
                    forge py = 0
                    while (py < 4) {
                        forge row = base - py * w
                        _wr(dst, row, cf)
                        _wr(dst, row + 1, cf)
                        _wr(dst, row + 2, cf)
                        _wr(dst, row + 3, cf)
                        py++
                    }
                }
                total--
                bx++
            }
            by--
        }
    }
}
