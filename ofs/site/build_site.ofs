attach {F:../ofscc/fileio.ofs}
attach {F:sitekit.ofs}

core main() {
    system("mkdir -p docs/assets")
    write_file("docs/index.html", site_page())
    write_file("docs/assets/site.css", site_css())
    write_file("docs/assets/site.js", site_runtime_js())
    write_file("docs/assets/benchmark.json", site_benchmark_json())
    write_file("docs/.nojekyll", "")
    write_file("index.html", site_page_root())
    write_file("site.css", site_css())
    write_file("site.js", site_runtime_js())
    write_file("benchmark.json", site_benchmark_json())
    write_file("language.html", page_language())
    write_file("web.html", page_web())
    write_file("commands.html", page_commands())
    write_file("design.html", page_design())
    write_file("benchmark.html", page_benchmark())
    echo("OFS site generated in docs/")
}
