attach {benitoite}
attach {serpentine}

vein site_css() -> obsidian {
    forge s = ""
    s = s + serpentine.rule(":root", "color-scheme:dark;" + serpentine.var("ink", "#eef6ff") + serpentine.var("muted", "#9fb1c8") + serpentine.var("paper", "#070a0f") + serpentine.var("surface", "#101722") + serpentine.var("line", "#263244") + serpentine.var("accent", "#29e0bd") + serpentine.var("accent2", "#7c5cff") + serpentine.var("hot", "#ffcc66") + serpentine.var("code", "#070a0f") + serpentine.var("code-ink", "#dff8ff"))
    s = s + serpentine.rule("*", "box-sizing:border-box")
    s = s + serpentine.rule("html", "scroll-behavior:smooth")
    s = s + serpentine.rule("body", "margin:0;background:radial-gradient(circle at 20% 0%,rgba(41,224,189,.18),transparent 32%),radial-gradient(circle at 86% 12%,rgba(124,92,255,.22),transparent 34%),var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;line-height:1.55;overflow-x:hidden")
    s = s + serpentine.rule("body:before", "content:\"\";position:fixed;inset:0;background:linear-gradient(transparent 0 23px,rgba(255,255,255,.035) 24px),linear-gradient(90deg,transparent 0 23px,rgba(255,255,255,.03) 24px);background-size:24px 24px;mask-image:linear-gradient(to bottom,black,transparent 72%);pointer-events:none")
    s = s + serpentine.rule("a", "color:inherit")
    s = s + serpentine.rule(".wrap", "width:min(1180px,calc(100% - 32px));margin:0 auto")
    s = s + serpentine.rule(".topbar", "position:sticky;top:0;z-index:10;background:rgba(7,10,15,.76);border-bottom:1px solid var(--line);backdrop-filter:blur(18px)")
    s = s + serpentine.rule(".nav", "min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:16px")
    s = s + serpentine.rule(".brand", "display:inline-flex;align-items:center;gap:10px;font-weight:900;text-decoration:none")
    s = s + serpentine.rule(".brand img", "width:36px;height:36px")
    s = s + serpentine.rule(".links", "display:flex;align-items:center;gap:18px;color:var(--muted);font-size:14px")
    s = s + serpentine.rule(".links a", "text-decoration:none")
    s = s + serpentine.rule(".links a:hover", "color:var(--accent)")
    s = s + serpentine.rule(".lang", "display:inline-flex;gap:4px;padding:4px;border:1px solid var(--line);background:rgba(255,255,255,.04);border-radius:8px")
    s = s + serpentine.rule(".lang button", "border:0;background:transparent;min-width:38px;height:30px;border-radius:6px;color:var(--muted);font-weight:800;cursor:pointer")
    s = s + serpentine.rule(".lang button.active", "background:var(--accent);color:#06100e")
    s = s + serpentine.rule(".hero", "min-height:82vh;display:grid;align-items:center;padding:58px 0 36px")
    s = s + serpentine.rule(".hero-grid", "display:grid;grid-template-columns:minmax(0,1.08fr) minmax(340px,.92fr);gap:44px;align-items:center")
    s = s + serpentine.rule(".kicker", "margin:0 0 14px;color:var(--accent);font-weight:900;text-transform:uppercase;font-size:13px;letter-spacing:.12em")
    s = s + serpentine.rule("h1", "margin:0;font-size:clamp(50px,8vw,104px);line-height:.88;letter-spacing:0")
    s = s + serpentine.rule(".lead", "max-width:760px;margin:24px 0 0;color:var(--muted);font-size:clamp(18px,2.2vw,22px)")
    s = s + serpentine.rule(".actions", "display:flex;flex-wrap:wrap;gap:12px;margin-top:30px")
    s = s + serpentine.rule(".btn", "min-height:46px;display:inline-flex;align-items:center;justify-content:center;padding:0 18px;border-radius:8px;border:1px solid rgba(41,224,189,.55);background:linear-gradient(135deg,var(--accent),#7fffe4);color:#06100e;text-decoration:none;font-weight:900;box-shadow:0 12px 34px rgba(41,224,189,.18)")
    s = s + serpentine.rule(".btn.secondary", "background:rgba(255,255,255,.04);color:var(--ink);border-color:var(--line);box-shadow:none")
    s = s + serpentine.rule(".terminal,.showcase", "background:linear-gradient(180deg,rgba(16,23,34,.96),rgba(8,12,18,.96));color:var(--code-ink);border-radius:8px;box-shadow:0 24px 70px rgba(0,0,0,.36);overflow:hidden;border:1px solid var(--line)")
    s = s + serpentine.rule(".terminal-head", "height:40px;display:flex;align-items:center;padding:0 14px;border-bottom:1px solid var(--line);color:#9fb0c0;font-size:13px")
    s = s + serpentine.rule("pre", "margin:0;padding:18px;overflow:auto;font-size:13px;line-height:1.6")
    s = s + serpentine.rule("code", "font-family:SFMono-Regular,Consolas,Liberation Mono,monospace")
    s = s + serpentine.rule(".band", "padding:76px 0;border-top:1px solid var(--line);position:relative")
    s = s + serpentine.rule(".section-head", "display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:26px")
    s = s + serpentine.rule("h2", "margin:0;font-size:clamp(32px,4vw,54px);line-height:1;letter-spacing:0")
    s = s + serpentine.rule(".section-head p", "max-width:650px;margin:0;color:var(--muted)")
    s = s + serpentine.rule(".grid", "display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px")
    s = s + serpentine.rule(".card,.doc-link,.mini-page", "background:rgba(255,255,255,.055);border:1px solid var(--line);border-radius:8px;padding:20px;backdrop-filter:blur(8px)")
    s = s + serpentine.rule(".card,.step,.terminal,.doc-link", "opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease,border-color .2s ease")
    s = s + serpentine.rule(".card.seen,.step.seen,.terminal.seen,.doc-link.seen", "opacity:1;transform:translateY(0)")
    s = s + serpentine.rule(".card:hover,.doc-link:hover", "border-color:rgba(41,224,189,.55);transform:translateY(-2px)")
    s = s + serpentine.rule(".card h3", "margin:0 0 8px;font-size:18px")
    s = s + serpentine.rule(".card p", "margin:0;color:var(--muted)")
    s = s + serpentine.rule(".table-wrap", "overflow:auto;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.045)")
    s = s + serpentine.rule("table", "width:100%;border-collapse:collapse;min-width:760px")
    s = s + serpentine.rule("th,td", "padding:13px 14px;border-bottom:1px solid var(--line);text-align:left")
    s = s + serpentine.rule("th", "font-size:13px;color:var(--muted);background:rgba(255,255,255,.06)")
    s = s + serpentine.rule("tr:last-child td", "border-bottom:0")
    s = s + serpentine.rule(".bars", "display:grid;gap:10px")
    s = s + serpentine.rule(".bar-row", "display:grid;grid-template-columns:82px 1fr 88px;align-items:center;gap:12px")
    s = s + serpentine.rule(".bar", "height:15px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden")
    s = s + serpentine.rule(".bar span", "display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:999px;animation:grow .85s ease both")
    s = s + serpentine.rule(".docs-list", "display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px")
    s = s + serpentine.rule(".doc-link", "text-decoration:none")
    s = s + serpentine.rule(".doc-link strong", "display:block")
    s = s + serpentine.rule(".doc-link span", "color:var(--muted);font-size:14px")
    s = s + serpentine.rule(".workflow", "display:grid;grid-template-columns:repeat(4,1fr);gap:12px")
    s = s + serpentine.rule(".step", "padding:18px;border:1px solid var(--line);border-radius:8px;background:rgba(255,255,255,.04)")
    s = s + serpentine.rule(".footer", "padding:34px 0;color:var(--muted);border-top:1px solid var(--line)")
    s = s + serpentine.keyframes("grow", serpentine.frame("from", "width:0") + serpentine.frame("to", ""))
    s = s + serpentine.keyframes("float", serpentine.frame("0%,100%", "transform:translateY(0)") + serpentine.frame("50%", "transform:translateY(-10px)"))
    s = s + serpentine.rule(".showcase", "animation:float 6s ease-in-out infinite")
    s = s + serpentine.media("(max-width:900px)", ".links a{display:none}.hero-grid,.grid,.docs-list,.workflow{grid-template-columns:1fr}.hero{min-height:auto;padding-top:36px}.section-head{display:block}.section-head p{margin-top:12px}")
    return s
}

vein site_js() -> obsidian {
    forge s = ""
    s = s + "const translations={pt:{navDocs:'Documentacao',navBench:'Benchmark',navRelease:'Releases',kicker:'Linguagem compilada hibrida',title:'OFS compila, roda nativo e agora tambem serve Web.',lead:'Obsidian Fault Script e uma linguagem self-hosted com pipeline LLVM, stdlib modular, modos low-level e uma camada Web UI experimental para construir sites com OFS.',ctaStart:'Comecar',ctaGitHub:'GitHub',terminalTitle:'exemplo.ofs',pillarsTitle:'O que e a OFS',pillarsLead:'Uma linguagem para aprender, compilar e descer perto do sistema quando precisar.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker e geracao LLVM vivem no compilador OFS.',p2Title:'Nativa',p2Body:'A saida e LLVM IR linkada com libofs_runtime.a para gerar executaveis.',p3Title:'Hibrida',p3Body:'Console, canvas/window nativo e sites via webserver/webui no mesmo ecossistema.',webTitle:'Web UI oficial',webLead:'Arquivos web sao explicitos: a extensao so usa Go Live quando encontra attach {webui} ou chamadas web.',benchTitle:'Benchmark local',benchLead:'fib(25..32) iterativo repetido 5.000.000 vezes. Medicao local, nao um estudo completo de performance.',docsTitle:'Documentacao',docsLead:'Guias tecnicos para linguagem, compilador, bootstrap, UI e publicacao.',releaseTitle:'Release atual',releaseLead:'A release publica mais recente fica em /releases/latest e e gerada por GitHub Actions com assets Linux, macOS, Windows, VS Code e checksums.',footer:'OFS e um projeto experimental de linguagem compilada. Site gerado pela propria OFS para GitHub Pages.'},en:{navDocs:'Documentation',navBench:'Benchmark',navRelease:'Releases',kicker:'Hybrid compiled language',title:'OFS compiles, runs native, and now serves the Web.',lead:'Obsidian Fault Script is a self-hosted language with an LLVM pipeline, modular standard library, low-level modes, and an experimental Web UI layer for building sites with OFS.',ctaStart:'Get started',ctaGitHub:'GitHub',terminalTitle:'example.ofs',pillarsTitle:'What OFS is',pillarsLead:'A language for learning, compiling, and moving close to the system when needed.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker, and LLVM generation live in the OFS compiler.',p2Title:'Native',p2Body:'The output is LLVM IR linked with libofs_runtime.a to produce executables.',p3Title:'Hybrid',p3Body:'Console apps, native canvas/window apps, and sites via webserver/webui in one ecosystem.',webTitle:'Official Web UI',webLead:'Web files are explicit: the extension only uses Go Live when it sees attach {webui} or web calls.',benchTitle:'Local benchmark',benchLead:'Iterative fib(25..32) repeated 5,000,000 times. Local measurement, not a complete performance study.',docsTitle:'Documentation',docsLead:'Technical guides for the language, compiler, bootstrap, UI, and publishing.',releaseTitle:'Current release',releaseLead:'The latest public release is available at /releases/latest and is generated by GitHub Actions with Linux, macOS, Windows, VS Code, and checksum assets.',footer:'OFS is an experimental compiled language project. Site generated by OFS itself for GitHub Pages.'},es:{navDocs:'Documentacion',navBench:'Benchmark',navRelease:'Releases',kicker:'Lenguaje compilado hibrido',title:'OFS compila, ejecuta nativo y ahora tambien sirve Web.',lead:'Obsidian Fault Script es un lenguaje self-hosted con pipeline LLVM, libreria estandar modular, modos low-level y una capa Web UI experimental para crear sitios con OFS.',ctaStart:'Empezar',ctaGitHub:'GitHub',terminalTitle:'ejemplo.ofs',pillarsTitle:'Que es OFS',pillarsLead:'Un lenguaje para aprender, compilar y acercarse al sistema cuando haga falta.',p1Title:'Self-hosted',p1Body:'Lexer, parser, type checker y generacion LLVM viven en el compilador OFS.',p2Title:'Nativo',p2Body:'La salida es LLVM IR enlazada con libofs_runtime.a para generar ejecutables.',p3Title:'Hibrido',p3Body:'Consola, canvas/window nativo y sitios via webserver/webui en el mismo ecosistema.',webTitle:'Web UI oficial',webLead:'Los archivos web son explicitos: la extension solo usa Go Live cuando ve attach {webui} o llamadas web.',benchTitle:'Benchmark local',benchLead:'fib(25..32) iterativo repetido 5.000.000 veces. Medicion local, no un estudio completo de rendimiento.',docsTitle:'Documentacion',docsLead:'Guias tecnicas para lenguaje, compilador, bootstrap, UI y publicacion.',releaseTitle:'Release actual',releaseLead:'La release publica mas reciente esta en /releases/latest y se genera por GitHub Actions con assets Linux, macOS, Windows, VS Code y checksums.',footer:'OFS es un proyecto experimental de lenguaje compilado. Sitio generado por la propia OFS para GitHub Pages.'}};"
    s = s + "function applyLanguage(lang){const dict=translations[lang]||translations.pt;document.documentElement.lang=lang;document.querySelectorAll('[data-i18n]').forEach((node)=>{const key=node.getAttribute('data-i18n');if(dict[key])node.textContent=dict[key];});document.querySelectorAll('[data-lang]').forEach((button)=>button.classList.toggle('active',button.getAttribute('data-lang')===lang));localStorage.setItem('ofs-lang',lang)}"
    s = s + "async function loadBenchmark(){let response=await fetch('assets/benchmark.json');if(!response.ok){response=await fetch('benchmark.json')}const data=await response.json();const results=data.results.filter((r)=>r.best_seconds!==null);const max=Math.max(...results.map((r)=>r.best_seconds));const bars=document.getElementById('benchmark-bars');const rows=document.getElementById('benchmark-rows');const suites=document.getElementById('benchmark-suites');bars.innerHTML='';rows.innerHTML='';if(suites)suites.innerHTML='';data.results.forEach((result)=>{const value=result.best_seconds;const width=value===null?0:Math.max(4,(value/max)*100);const label=value===null?'n/a':`${value.toFixed(4)}s`;const factor=value===null?'n/a':`${(value/data.results[0].best_seconds).toFixed(1)}x`;bars.insertAdjacentHTML('beforeend',`<div class=\"bar-row\"><strong>${result.language}</strong><div class=\"bar\"><span style=\"width:${width}%\"></span></div><span>${label}</span></div>`);rows.insertAdjacentHTML('beforeend',`<tr><td>${result.language}</td><td>${label}</td><td>${factor}</td><td>${result.output}</td></tr>`)});if(suites&&data.suites){data.suites.forEach((suite)=>{suites.insertAdjacentHTML('beforeend',`<article class=\"card\"><h3>${suite.name}</h3><p>${suite.summary}</p><p><strong>${suite.best_seconds}s</strong> best - ${suite.status}</p></article>`)})}document.getElementById('benchmark-meta').textContent=`${data.benchmark} - menor e melhor - ${data.runs_per_language} runs - ${data.date_utc}`}"
    s = s + "document.querySelectorAll('[data-lang]').forEach((button)=>button.addEventListener('click',()=>applyLanguage(button.getAttribute('data-lang'))));applyLanguage(localStorage.getItem('ofs-lang')||'pt');loadBenchmark().catch(()=>{document.getElementById('benchmark-meta').textContent='Benchmark data unavailable.'});"
    return s
}

vein site_benchmark_json() -> obsidian {
    return "{\"benchmark\":\"fib(25..32) iterative repeated 5,000,000 times\",\"runs_per_language\":3,\"date_utc\":\"2026-06-14\",\"machine\":\"Linux-6.8.0-1052-azure-x86_64-with-glibc2.39\",\"note\":\"Local documentation benchmark. Smaller time is better. Python is slower here because 8.2346s is much greater than 0.0239s. These numbers are smoke measurements, not universal language rankings.\",\"results\":[{\"language\":\"OFS\",\"best_seconds\":0.0239,\"mean_seconds\":0.0254,\"max_seconds\":0.0279,\"output\":\"3488433750000\"},{\"language\":\"C\",\"best_seconds\":0.0238,\"mean_seconds\":0.0278,\"max_seconds\":0.0344,\"output\":\"3488433750000\"},{\"language\":\"C++\",\"best_seconds\":0.0645,\"mean_seconds\":0.0801,\"max_seconds\":0.0966,\"output\":\"3488433750000\"},{\"language\":\"Java\",\"best_seconds\":0.113,\"mean_seconds\":0.1441,\"max_seconds\":0.2023,\"output\":\"3488433750000\"},{\"language\":\"C#\",\"best_seconds\":0.1031,\"mean_seconds\":0.1145,\"max_seconds\":0.1362,\"output\":\"3488433750000\"},{\"language\":\"Python\",\"best_seconds\":8.2346,\"mean_seconds\":8.4333,\"max_seconds\":8.6425,\"output\":\"3488433750000\"},{\"language\":\"Rust\",\"best_seconds\":null,\"mean_seconds\":null,\"max_seconds\":null,\"output\":\"rustc not installed in this workspace\"}],\"suites\":[{\"name\":\"OFS semantic check: official site\",\"summary\":\"dist/ofs check ofs/site/build_site.ofs\",\"best_seconds\":0.3541,\"status\":\"pass\"},{\"name\":\"OFS native build: site generator\",\"summary\":\"dist/ofs build ofs/site/build_site.ofs -o /tmp/ofs_build_site_bench\",\"best_seconds\":0.6337,\"status\":\"pass\"},{\"name\":\"OFS generated site emit\",\"summary\":\"Runs the compiled site generator and writes Pages artifacts\",\"best_seconds\":0.0131,\"status\":\"pass\"},{\"name\":\"OFS web example check\",\"summary\":\"dist/ofs check ofs/examples/webui_site.ofs\",\"best_seconds\":0.1247,\"status\":\"pass\"},{\"name\":\"Web server/page smoke\",\"summary\":\"Local HTTP checks for index, docs pages, style, script and benchmark JSON\",\"best_seconds\":0.0100,\"status\":\"pass\"}]}"
}

vein site_runtime_js() -> obsidian {
    forge s = site_js()
    s = s + "document.querySelectorAll('[data-copy]').forEach((b)=>b.addEventListener('click',()=>navigator.clipboard&&navigator.clipboard.writeText(b.getAttribute('data-copy'))));"
    s = s + "const reveal=new IntersectionObserver((items)=>items.forEach((i)=>{if(i.isIntersecting)i.target.classList.add('seen')}),{threshold:.15});document.querySelectorAll('.card,.step,.terminal,.doc-link').forEach((n)=>reveal.observe(n));"
    return s
}

vein site_button(label: obsidian, href: obsidian, secondary: bool) -> obsidian {
    if (secondary) {
        return benitoite.a("btn secondary", href, label)
    }
    return benitoite.a("btn", href, label)
}

vein site_terminal(title: obsidian, code: obsidian) -> obsidian {
    return benitoite.div("terminal", benitoite.div("terminal-head", title) + benitoite.code_block(code))
}

vein site_card(title: obsidian, body: obsidian, key: obsidian) -> obsidian {
    forge h = benitoite.h3(title)
    forge p = benitoite.p("", body)
    if (key != "") {
        h = "<h3 data-i18n=\"" + key + "Title\">" + title + "</h3>"
        p = "<p data-i18n=\"" + key + "Body\">" + body + "</p>"
    }
    return benitoite.article("card", h + p)
}

vein site_section_head(title_key: obsidian, title: obsidian, lead_key: obsidian, lead: obsidian) -> obsidian {
    return benitoite.div("section-head", "<h2 data-i18n=\"" + title_key + "\">" + title + "</h2>" + "<p data-i18n=\"" + lead_key + "\">" + lead + "</p>")
}

vein site_doc_link(href: obsidian, title: obsidian, text: obsidian) -> obsidian {
    return benitoite.a("doc-link", href, benitoite.strong(title) + benitoite.span("", text))
}

vein site_topbar() -> obsidian {
    forge brand = benitoite.a("brand", "#top", benitoite.img("assets/ofs-256.png", "OFS logo") + benitoite.span("", "Obsidian Fault Script"))
    forge langs = benitoite.div("lang", "<button type=\"button\" data-lang=\"pt\">PT</button><button type=\"button\" data-lang=\"en\">EN</button><button type=\"button\" data-lang=\"es\">ES</button>")
    forge links = benitoite.div("links", "<a href=\"#docs\" data-i18n=\"navDocs\">Documentacao</a><a href=\"#benchmark\" data-i18n=\"navBench\">Benchmark</a><a href=\"#release\" data-i18n=\"navRelease\">Releases</a>" + langs)
    return benitoite.header("topbar", benitoite.nav("wrap nav", brand + links))
}

vein site_hero() -> obsidian {
    forge left = "<p class=\"kicker\" data-i18n=\"kicker\">Linguagem compilada hibrida</p>"
    left = left + "<h1 data-i18n=\"title\">OFS compila, roda nativo e agora tambem serve Web.</h1>"
    left = left + "<p class=\"lead\" data-i18n=\"lead\">Obsidian Fault Script e uma linguagem self-hosted com pipeline LLVM, stdlib modular, modos low-level e uma camada Web UI experimental para construir sites com OFS.</p>"
    left = left + benitoite.div("actions", site_button("Comecar", "GETTING_STARTED.md", false) + site_button("GitHub", "https://github.com/Samwns/Obsidian-Fault-Script", true))
    forge code = "attach {webui}\n\ncore main() {\n    forge body = webui.hero(\n        \"OFS Web\",\n        \"site oficial em OFS\",\n        webui.button(\"Docs\", \"#docs\")\n    )\n\n    webui.serve(8080, \"OFS\", body)\n}"
    return benitoite.section("", "hero", benitoite.div("wrap hero-grid", benitoite.div("", left) + site_terminal("exemplo.ofs", code)))
}

vein site_pillars() -> obsidian {
    forge cards = site_card("Self-hosted", "Lexer, parser, type checker e geracao LLVM vivem no compilador OFS.", "p1")
    cards = cards + site_card("Nativa", "A saida e LLVM IR linkada com libofs_runtime.a para gerar executaveis.", "p2")
    cards = cards + site_card("Hibrida", "Console, canvas/window nativo e sites via webserver/webui no mesmo ecossistema.", "p3")
    forge body = site_section_head("pillarsTitle", "O que e a OFS", "pillarsLead", "Uma linguagem para aprender, compilar e descer perto do sistema quando precisar.") + benitoite.div("grid", cards)
    return benitoite.section("", "band", benitoite.div("wrap", body))
}

vein site_web() -> obsidian {
    forge code = "attach {webui}\n\ncore main() {\n    forge body = webui.nav(\"OFS Web\", webui.button(\"Docs\", \"#docs\"))\n    body = body + webui.grid(\n        webui.card(\"Nativa\", \"LLVM + runtime\")\n        + webui.card(\"Web\", \"HTML e estilo gerados pela stdlib\")\n    )\n\n    webui.serve(8080, \"OFS Web\", body)\n}"
    forge body = site_section_head("webTitle", "Web UI oficial", "webLead", "Arquivos web sao explicitos: a extensao so usa Go Live quando encontra attach {webui} ou chamadas web.") + site_terminal("webui_site.ofs", code)
    return benitoite.section("web", "band", benitoite.div("wrap", body))
}

vein site_benchmark() -> obsidian {
    forge body = site_section_head("benchTitle", "Benchmark local", "benchLead", "fib(25..32) iterativo repetido 5.000.000 vezes. Medicao local, nao um estudo completo de performance.")
    body = body + benitoite.div("card", "<p id=\"benchmark-meta\" class=\"kicker\">Loading benchmark...</p><div class=\"bars\" id=\"benchmark-bars\"></div>")
    body = body + benitoite.div("table-wrap", benitoite.table("<tr><th>Language</th><th>Best</th><th>Relative</th><th>Output</th></tr>", ""))
    body = body + "<div id=\"benchmark-suites\" class=\"grid\"></div>"
    return benitoite.section("benchmark", "band", benitoite.div("wrap", body))
}

vein site_docs() -> obsidian {
    forge links = site_doc_link("GETTING_STARTED.md", "Getting Started", "Install, run, build and check OFS files.")
    links = links + site_doc_link("LANGUAGE_REFERENCE.md", "Language Reference", "Syntax, types, control flow and modules.")
    links = links + site_doc_link("COMPILER_ARCHITECTURE.md", "Compiler Architecture", "Self-hosted frontend and LLVM backend.")
    links = links + site_doc_link("WEB_UI.md", "Web UI", "Build OFS-powered static web pages.")
    links = links + site_doc_link("VISUAL_UI.md", "Native Visual UI", "Canvas, window and immediate UI helpers.")
    links = links + site_doc_link("GITHUB_REGISTRATION.md", "GitHub Registration", "Linguist and repository language recognition.")
    forge body = site_section_head("docsTitle", "Documentacao", "docsLead", "Guias tecnicos para linguagem, compilador, bootstrap, UI e publicacao.") + benitoite.div("docs-list", links)
    return benitoite.section("docs", "band", benitoite.div("wrap", body))
}

vein site_release() -> obsidian {
    forge body = site_section_head("releaseTitle", "Release atual", "releaseLead", "A release publica mais recente fica em /releases/latest e e gerada por GitHub Actions com assets Linux, macOS, Windows, VS Code e checksums.")
    body = body + benitoite.div("actions", site_button("Latest release", "https://github.com/Samwns/Obsidian-Fault-Script/releases/latest", false) + site_button("GitHub Actions", "https://github.com/Samwns/Obsidian-Fault-Script/actions", true))
    return benitoite.section("release", "band", benitoite.div("wrap", body))
}

vein site_page() -> obsidian {
    forge head = benitoite.icon("assets/ofs-256.png") + benitoite.css("assets/site.css")
    forge body = site_topbar()
    body = body + benitoite.main("top", site_hero() + site_pillars() + site_web() + site_benchmark() + site_docs() + site_release())
    body = body + benitoite.footer("footer", "<div class=\"wrap\" data-i18n=\"footer\">OFS e um projeto experimental de linguagem compilada. Site gerado pela propria OFS para GitHub Pages.</div>") + benitoite.script("assets/site.js")
    return benitoite.document("pt", "Obsidian Fault Script", "Official site and documentation for Obsidian Fault Script.", head, body)
}

vein site_page_root() -> obsidian {
    forge head = benitoite.icon("ofs-256.png") + benitoite.css("site.css")
    forge body = site_topbar_root()
    body = body + benitoite.main("top", site_hero_root() + site_pillars() + site_web() + site_benchmark() + site_docs_root() + site_release())
    body = body + benitoite.footer("footer", "<div class=\"wrap\" data-i18n=\"footer\">OFS e um projeto experimental de linguagem compilada. Site gerado pela propria OFS para GitHub Pages.</div>") + benitoite.script("site.js")
    return benitoite.document("pt", "Obsidian Fault Script", "Official site and documentation for Obsidian Fault Script.", head, body)
}

vein site_topbar_root() -> obsidian {
    forge brand = benitoite.a("brand", "#top", benitoite.img("ofs-256.png", "OFS logo") + benitoite.span("", "Obsidian Fault Script"))
    forge langs = benitoite.div("lang", "<button type=\"button\" data-lang=\"pt\">PT</button><button type=\"button\" data-lang=\"en\">EN</button><button type=\"button\" data-lang=\"es\">ES</button>")
    forge links = benitoite.div("links", "<a href=\"#docs\" data-i18n=\"navDocs\">Documentacao</a><a href=\"#benchmark\" data-i18n=\"navBench\">Benchmark</a><a href=\"#release\" data-i18n=\"navRelease\">Releases</a>" + langs)
    return benitoite.header("topbar", benitoite.nav("wrap nav", brand + links))
}

vein site_hero_root() -> obsidian {
    forge left = "<p class=\"kicker\" data-i18n=\"kicker\">Linguagem compilada hibrida</p>"
    left = left + "<h1 data-i18n=\"title\">OFS compila, roda nativo e agora tambem serve Web.</h1>"
    left = left + "<p class=\"lead\" data-i18n=\"lead\">Obsidian Fault Script e uma linguagem self-hosted com pipeline LLVM, stdlib modular, modos low-level e uma camada Web UI experimental para construir sites com OFS.</p>"
    left = left + benitoite.div("actions", site_button("Comecar", "docs/GETTING_STARTED.md", false) + site_button("GitHub", "https://github.com/Samwns/Obsidian-Fault-Script", true))
    forge code = "attach {webui}\n\ncore main() {\n    forge body = webui.hero(\n        \"OFS Web\",\n        \"site oficial em OFS\",\n        webui.button(\"Docs\", \"#docs\")\n    )\n\n    webui.serve(8080, \"OFS\", body)\n}"
    return benitoite.section("", "hero", benitoite.div("wrap hero-grid", benitoite.div("", left) + site_terminal("exemplo.ofs", code)))
}

vein site_docs_root() -> obsidian {
    forge links = site_doc_link("language.html", "Language", "Syntax, compiler pipeline, modules and runtime.")
    links = links + site_doc_link("web.html", "Benitoite + Serpentine", "The OFS-native web language.")
    links = links + site_doc_link("commands.html", "Commands", "Run, build, check, IR and assembly.")
    links = links + site_doc_link("design.html", "Design System", "Tokens, layout, components and animation.")
    links = links + site_doc_link("benchmark.html", "Benchmark", "Measured local comparison and methodology.")
    links = links + site_doc_link("docs/WEB_UI.md", "Reference Markdown", "Long-form notes and raw documentation.")
    forge body = site_section_head("docsTitle", "Documentacao", "docsLead", "Guias tecnicos para linguagem, compilador, bootstrap, UI e publicacao.") + benitoite.div("docs-list", links)
    return benitoite.section("docs", "band", benitoite.div("wrap", body))
}

vein page_nav() -> obsidian {
    forge brand = benitoite.a("brand", "index.html", benitoite.img("ofs-256.png", "OFS logo") + benitoite.span("", "OFS"))
    forge links = benitoite.div("links", "<a href=\"language.html\">Language</a><a href=\"web.html\">Web</a><a href=\"commands.html\">Commands</a><a href=\"design.html\">Design</a><a href=\"benchmark.html\">Benchmark</a>")
    return benitoite.header("topbar", benitoite.nav("wrap nav", brand + links))
}

vein page_shell(title: obsidian, subtitle: obsidian, content: obsidian) -> obsidian {
    forge head = benitoite.icon("ofs-256.png") + benitoite.css("site.css")
    forge hero = benitoite.section("", "band", benitoite.div("wrap", benitoite.p("kicker", "OFS documentation") + benitoite.h1(title) + benitoite.p("lead", subtitle)))
    forge body = page_nav() + benitoite.main("top", hero + content) + benitoite.footer("footer", "<div class=\"wrap\">Generated by Benitoite and Serpentine in OFS.</div>") + benitoite.script("site.js")
    return benitoite.document("en", title + " - OFS", subtitle, head, body)
}

vein page_language() -> obsidian {
    forge cards = site_card("Compiler", "Self-hosted frontend, LLVM IR output and native linking.", "")
    cards = cards + site_card("Types", "stone, crystal, obsidian, bool, small integers, arrays and monoliths.", "")
    cards = cards + site_card("Low-level", "fracture, abyss, fractal and bedrock blocks for explicit systems work.", "")
    forge content = benitoite.section("", "band", benitoite.div("wrap", benitoite.div("grid", cards) + site_terminal("hello.ofs", "core main() {\n    echo(\"hello from OFS\")\n}")))
    return page_shell("Language", "The technical core of Obsidian Fault Script.", content)
}

vein page_web() -> obsidian {
    forge flow = benitoite.div("workflow", benitoite.div("step", "<strong>1. Benitoite</strong><br>Declare document structure in OFS.") + benitoite.div("step", "<strong>2. Serpentine</strong><br>Generate style tokens, rules and animation.") + benitoite.div("step", "<strong>3. Webserver</strong><br>Serve generated output locally.") + benitoite.div("step", "<strong>4. Pages</strong><br>Publish generated artifacts."))
    forge code = "attach {benitoite}\nattach {serpentine}\n\nvein page() -> obsidian {\n    return benitoite.document(\"pt\", \"Site\", \"feito em OFS\", \"\", benitoite.h1(\"OFS Web\"))\n}"
    forge content = benitoite.section("", "band", benitoite.div("wrap", flow + site_terminal("benitoite.ofs", code)))
    return page_shell("Benitoite + Serpentine", "The OFS-native answer to HTML, CSS, PHP templates and React-style components.", content)
}

vein page_commands() -> obsidian {
    forge code = "dist/ofs check app.ofs\ndist/ofs run app.ofs\ndist/ofs build app.ofs -o app\ndist/ofs ir app.ofs -o app.ll\ndist/ofs asm app.ofs -o app.s"
    forge content = benitoite.section("", "band", benitoite.div("wrap", site_terminal("commands", code) + benitoite.div("grid", site_card("check", "Validate syntax and semantics without native output.", "") + site_card("run", "Compile and execute immediately.", "") + site_card("build", "Produce a native executable linked with the runtime.", ""))))
    return page_shell("Commands", "Daily commands for OFS development.", content)
}

vein page_design() -> obsidian {
    forge content = benitoite.section("", "band", benitoite.div("wrap", benitoite.div("grid", site_card("Tokens", "Serpentine keeps colors, spacing and motion as OFS-generated style tokens.", "") + site_card("Components", "Site pieces are functions returning Benitoite fragments.", "") + site_card("Motion", "Bars, cards and terminal surfaces use Serpentine keyframes.", "")) + site_terminal("serpentine.ofs", "s = s + serpentine.rule(\".btn\", serpentine.prop(\"border-radius\", \"8px\"))\ns = s + serpentine.keyframes(\"grow\", serpentine.frame(\"from\", \"width:0\"))")))
    return page_shell("Design System", "How the official site is styled without authoring plain CSS as source.", content)
}

vein page_benchmark() -> obsidian {
    forge content = benitoite.section("benchmark", "band", benitoite.div("wrap", site_benchmark() + benitoite.div("card", "<p>Method: iterative fib(25..32), 5,000,000 repetitions, three local runs. Results are smoke measurements, not a universal performance claim.</p>")))
    return page_shell("Benchmark", "Measured local comparison with animated results.", content)
}
