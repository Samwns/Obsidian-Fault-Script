        }
    }

    // --- acoes ---
    vein finish() -> void {
        if (activity != null) { _anative_activity_finish(activity) }
    }

    // Caminhos do app (ANativeActivity.internalDataPath / externalDataPath).
    vein internal_data_path() -> obsidian {
        fracture {
            if (activity == null) { return "" }
            forge p = peek(activity, 4) as *stone
            if (p == null) { return "" }
            return _android_strdup(p)
        }
    }
    vein external_data_path() -> obsidian {
        fracture {
            if (activity == null) { return "" }
            forge p = peek(activity, 5) as *stone
            if (p == null) { return "" }
            return _android_strdup(p)
        }
    }

    // --- desenho em software direto no ANativeWindow (RGBA_8888) ---
    // ANativeWindow_Buffer: { i32 width, i32 height, i32 stride, i32 format, void* bits, ... }
    forge buf_w: stone = 0
    forge buf_h: stone = 0
    forge buf_stride: stone = 0
    forge buf_bits: *stone = null

    vein lock() -> bool {
        fracture {
            if (window == null) { return false }
            if (s32(_anw_lock(window, _scratch, null)) != 0) { return false }
            forge w0 = peek(_scratch, 0)
            forge w1 = peek(_scratch, 1)
            buf_w = w0 & 4294967295
            buf_h = (w0 >> 32) & 4294967295
            buf_stride = w1 & 4294967295
            buf_bits = peek(_scratch, 2) as *stone
            return true
        }
    }

    vein unlock_post() -> void {
        if (window != null) { _anw_unlock_post(window) }
    }

    // 0xRRGGBB -> pixel RGBA_8888 em memoria (little-endian: 0xAABBGGRR).
    vein rgb(c: stone) -> stone {
        forge r = (c >> 16) & 255
        forge g = (c >> 8) & 255
        forge b = c & 255
        return (255 << 24) | (b << 16) | (g << 8) | r
    }

    // Preenche [x, x+w) x [y, y+h) com 0xRRGGBB. Escreve 2 pixels por palavra
    // de 64 bits; x e w sao ajustados para pares (o stride e sempre par).
    vein fill_rect(x: stone, y: stone, w: stone, h: stone, color: stone) -> void {
        fracture {
            forge x0 = x
            forge y0 = y
            forge x1 = x + w
            forge y1 = y + h
            if (x0 < 0) { x0 = 0 }
            if (y0 < 0) { y0 = 0 }
            if (x1 > buf_w) { x1 = buf_w }
            if (y1 > buf_h) { y1 = buf_h }
            x0 = x0 - (x0 & 1)
            x1 = x1 + (x1 & 1)
            if (x0 >= x1 || y0 >= y1) { return }
            forge px = rgb(color)
            forge pair = px | (px << 32)
            forge half_stride = buf_stride / 2
            forge yy = y0
            while (yy < y1) {
                forge row = yy * half_stride
                forge xx = x0 / 2
                forge xend = x1 / 2
                while (xx < xend) {
                    forge p: *stone = fault_step(buf_bits, row + xx)
                    fracture { *p = pair; }
                    xx++
                }
                yy++
            }
        }
    }

    // Copia um buffer de pixels OFS (1 stone por pixel, 0xRRGGBB, como o
    // Canvas do stdlib) para o buffer travado. Copia a interseccao.
    vein blit(src: *stone, src_w: stone, src_h: stone) -> void {
        fracture {
            forge w = src_w
            forge h = src_h
            if (w > buf_w) { w = buf_w }
            if (h > buf_h) { h = buf_h }
            forge pairs = w / 2
            forge half_stride = buf_stride / 2
            forge y = 0
            while (y < h) {
                forge srow = y * src_w
                forge drow = y * half_stride
                forge i = 0
                while (i < pairs) {
                    forge sp: *stone = fault_step(src, srow + i * 2)
                    forge a = 0
                    forge b = 0
                    fracture { a = *sp; }
                    forge sp2: *stone = fault_step(src, srow + i * 2 + 1)
                    fracture { b = *sp2; }
                    forge pa = 4278190080 | ((a & 255) << 16) | (a & 65280) | ((a >> 16) & 255)
                    forge pb = 4278190080 | ((b & 255) << 16) | (b & 65280) | ((b >> 16) & 255)
                    forge dp: *stone = fault_step(buf_bits, drow + i)
                    fracture { *dp = pa | (pb << 32); }
                    i++
                }
                y++
            }
        }
    }

    // ── modo motor: outro codigo/View na propria NativeActivity (2026-11) ──
    // Indices extras de JNINativeInterface.
    forge _JNI_EXCEPTION_OCCURRED: stone = 15
    forge _JNI_EXCEPTION_DESCRIBE: stone = 16
    forge jni_error: obsidian = ""   // texto da ultima excecao lida por jni_take_error

    // Se ha excecao Java pendente: guarda o toString() em jni_error, imprime a
    // pilha no logcat (System.err) e a limpa. Devolve true se havia.
    vein jni_take_error() -> bool {
        abyss {
            forge env = jni_env()
            if (env == 0) { return false }
            if ((fault_call(jni_fn(_JNI_EXCEPTION_CHECK), env) & 255) == 0) { return false }
            forge ex = fault_call(jni_fn(_JNI_EXCEPTION_OCCURRED), env)
            fault_call(jni_fn(_JNI_EXCEPTION_DESCRIBE), env)
            fault_call(jni_fn(_JNI_EXCEPTION_CLEAR), env)
            jni_error = "excecao Java"
            if (ex != 0) {
                forge js = jni_call(ex, "toString", "()Ljava/lang/String;", 0, 0, 0, 0, 0, 0)
                if (js != 0) { jni_error = jni_to_text(js) }
                jni_delete(js)
                jni_delete(ex)
            }
            return true
        }
    }

    // Estatico numa jclass ja obtida (ex.: de DexClassLoader.loadClass).
    vein jni_scall_cls(cls: stone, name: obsidian, sig: obsidian, a: stone, b: stone, c: stone, d: stone) -> stone {
        abyss {
            jni_failed = false
            forge env = jni_env()
            if (env == 0 || cls == 0) { jni_failed = true; return 0 }
            forge mid = fault_call(jni_fn(_JNI_GET_STATIC_METHOD_ID), env, cls, name, sig)
            if (jni_take_error() || mid == 0) { jni_failed = true; return 0 }
            forge kind = _sig_ret(sig)
            forge fnx = _JNI_CALL_STATIC_OBJECT_METHOD_A
            if (kind == 86) { fnx = 143 }
            if (kind == 90) { fnx = _JNI_CALL_STATIC_BOOLEAN_METHOD_A }
            if (kind == 73) { fnx = 131 }
            if (kind == 74) { fnx = 134 }
            forge r = fault_call(jni_fn(fnx), env, cls, mid, jni_argv(a, b, c, d, 0, 0, 0, 0))
            if (jni_take_error()) { jni_failed = true; return 0 }
            return _jni_result(kind, r)
        }
    }

    // getIntent().getStringExtra(chave) da activity ("" se nao houver).
    vein intent_extra(key: obsidian) -> obsidian {
        forge it = jni_call(jni_activity(), "getIntent", "()Landroid/content/Intent;", 0, 0, 0, 0, 0, 0)
        if (it == 0) { return "" }
        forge jk = jni_string(key)
        forge js = jni_call(it, "getStringExtra", "(Ljava/lang/String;)Ljava/lang/String;", jk, 0, 0, 0, 0, 0)
        forge out = ""
        if (js != 0) { out = jni_to_text(js) }
        jni_delete(js)
        jni_delete(jk)
        jni_delete(it)
        return out
    }

    // Libera a janela da NativeActivity: Window.takeSurface(null) e
    // takeInputQueue(null). Chamar em EV_CREATE (antes de a janela ser anexada,
    // o que acontece depois do onResume). Depois disso um setContentView(View)
    // comum desenha e recebe toques/teclas pelo Java; o OFS nao recebe mais
    // EV_WINDOW_* nem toques (o ciclo de vida continua chegando).
    forge window_released: bool = false
    vein release_window() -> bool {
        forge win = jni_call(jni_activity(), "getWindow", "()Landroid/view/Window;", 0, 0, 0, 0, 0, 0)
        if (win == 0) { return false }
        jni_call(win, "takeSurface", "(Landroid/view/SurfaceHolder$Callback2;)V", 0, 0, 0, 0, 0, 0)
        forge ok = !jni_failed
        jni_call(win, "takeInputQueue", "(Landroid/view/InputQueue$Callback;)V", 0, 0, 0, 0, 0, 0)
        ok = ok && !jni_failed
        jni_delete(win)
        window_released = ok
        return ok
    }

    // Activity.setContentView(view) (view = referencia de um android.view.View).
    vein set_content_view(view: stone) -> bool {
        jni_call(jni_activity(), "setContentView", "(Landroid/view/View;)V", view, 0, 0, 0, 0, 0)
        return !jni_failed
    }

    // Carrega uma classe de um .dex/.jar (varios separados por ":") com dalvik.system.DexClassLoader
    // (pai: o class loader da activity). dex: caminho do arquivo, que no
    // Android 14+ precisa ser somente leitura; libs: pasta das .so para
    // System.loadLibrary (ou ""). Devolve referencia GLOBAL da classe ou 0
    // (motivo em jni_error). O loader fica vivo enquanto a classe existir.
    vein dex_load_class(dex: obsidian, libs: obsidian, cls_name: obsidian) -> stone {
        abyss {
            jni_error = ""
            forge act = jni_activity()
            forge parent = jni_call(act, "getClassLoader", "()Ljava/lang/ClassLoader;", 0, 0, 0, 0, 0, 0)
            forge jdex = jni_string(dex)
            forge jlibs = 0
            if (ofs_str_len(libs) > 0) { jlibs = jni_string(libs) }
            forge loader = jni_new("dalvik/system/DexClassLoader", "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/ClassLoader;)V", jdex, 0, jlibs, parent)
            forge out = 0
            if (loader == 0) {
                if (!jni_take_error()) { jni_error = "DexClassLoader falhou" }
            } else {
                forge jn = jni_string(cls_name)
                forge env = jni_env()
                forge lcls = fault_call(jni_fn(_JNI_GET_OBJECT_CLASS), env, loader)
                forge mid = fault_call(jni_fn(_JNI_GET_METHOD_ID), env, lcls, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;")
                if (!jni_take_error() && mid != 0) {
                    forge c = fault_call(jni_fn(_JNI_CALL_OBJECT_METHOD_A), env, loader, mid, jni_argv(jn, 0, 0, 0, 0, 0, 0, 0))
                    if (!jni_take_error() && c != 0) {
                        out = jni_global(c)
                        jni_delete(c)
                    }
                }
                jni_delete(lcls)
                jni_delete(jn)
                jni_delete(loader)
            }
            jni_delete(jdex)
            jni_delete(jlibs)
            jni_delete(parent)
            return out
        }
    }

    // java.io.File(path).setReadOnly() (exigencia do Android 14+ para .dex/.so).
    vein set_read_only(path: obsidian) -> bool {
        forge jp = jni_string(path)
        forge f = jni_new("java/io/File", "(Ljava/lang/String;)V", jp, 0, 0, 0)
        forge ok = false
        if (f != 0) { ok = jni_call(f, "setReadOnly", "()Z", 0, 0, 0, 0, 0, 0) == 1 }
        jni_delete(f)
        jni_delete(jp)
        return ok
    }

    // Intent para esta mesma activity (getClass().getName()), com extras String
    // em pares (chaves[i] = valores[i]) e FLAG_ACTIVITY_NEW_TASK|CLEAR_TASK.
    // Referencia local (o chamador libera) ou 0.
    vein self_intent(keys: Array<obsidian>, vals: Array<obsidian>) -> stone {
        forge act = jni_activity()
        forge it = jni_new("android/content/Intent", "()V", 0, 0, 0, 0)
        if (it == 0) { return 0 }
        forge k = jni_call(act, "getClass", "()Ljava/lang/Class;", 0, 0, 0, 0, 0, 0)
        forge jcn = jni_call(k, "getName", "()Ljava/lang/String;", 0, 0, 0, 0, 0, 0)
        forge jpk = jni_string(package_name())
        forge r = jni_call(it, "setClassName", "(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;", jpk, jcn, 0, 0, 0, 0)
        jni_delete(r)
        jni_delete(jpk)
        jni_delete(jcn)
        jni_delete(k)
        forge n = ofs_array_len(keys)
        forge i = 0
        while (i < n) {
            forge jk = jni_string(ofs_array_get(keys, i))
            forge jv = jni_string(ofs_array_get(vals, i))
            forge r2 = jni_call(it, "putExtra", "(Ljava/lang/String;Ljava/lang/String;)Landroid/content/Intent;", jk, jv, 0, 0, 0, 0)
            jni_delete(r2)
            jni_delete(jv)
            jni_delete(jk)
            i++
        }
        forge r3 = jni_call(it, "addFlags", "(I)Landroid/content/Intent;", 268435456 | 32768, 0, 0, 0, 0, 0)
        jni_delete(r3)
        return it
    }

    // Reabre esta activity num processo NOVO com os extras dados: startActivity
    // (NEW_TASK|CLEAR_TASK) e encerra o processo atual na hora
    // (Process.killProcess(myPid)); o sistema sobe um processo novo para a
    // activity pendente. Nao retorna se der certo.
    vein restart_process(keys: Array<obsidian>, vals: Array<obsidian>) -> bool {
        forge it = self_intent(keys, vals)
        if (it == 0) { return false }
        jni_call(jni_activity(), "startActivity", "(Landroid/content/Intent;)V", it, 0, 0, 0, 0, 0)
        forge ok = !jni_failed
        jni_delete(it)
        if (!ok) { return false }
        log_tag("ofs", "android: reiniciando o processo")
        forge pid = jni_scall("android/os/Process", "myPid", "()I", 0, 0, 0, 0)
        jni_scall("android/os/Process", "killProcess", "(I)V", pid, 0, 0, 0)
        return false
    }
}
