        }
    }
    vein jni_new_object_array(n: stone, cls_name: obsidian) -> stone {
        abyss {
            forge cls = jni_find_class(cls_name)
            if (cls == 0) { return 0 }
            forge r = fault_call(jni_fn(_JNI_NEW_OBJECT_ARRAY), jni_env(), n, cls, 0)
            jni_delete(cls)
            return r
        }
    }
    vein jni_set_object_elem(arr: stone, i: stone, v: stone) -> void {
