    vein draw_shadow(disp: *stone, d: stone, gc: *stone, x: stone, y: stone, w: stone, h: stone, r: stone, depth: stone) -> void {
        forge si = 1
        while (si <= depth) {
            forge scol = 789516
            draw_rounded_border(disp, d, gc, scol, x - si, y - si, w + (si * 2), h + (si * 2), r + si)
            si++
        }
    }

    vein render_themed_button(disp: *stone, d: stone, gc: *stone, x: stone, y: stone, w: stone, h: stone, text: obsidian, variant: obsidian, icon: obsidian, state: stone, th: OllX11Theme) -> void {
        forge bg_col = th.btn_bg
        forge border_col = th.btn_border
        forge text_col = th.fg_primary

        if (ofs_str_eq(variant, "primary")) {
            bg_col = th.accent
            border_col = th.accent
            text_col = th.accent_fg
            if (state == 1) {
                bg_col = th.accent_hover
                border_col = th.accent_hover
            } else if (state == 2) {
                bg_col = th.btn_active
            }
        } else if (ofs_str_eq(variant, "danger")) {
            bg_col = 15208739
            border_col = 15208739
            text_col = 16777215
            if (state == 1) { bg_col = 16724530 }
        } else {
            if (state == 1) {
                bg_col = th.btn_hover
                text_col = 16777215
            } else if (state == 2) {
                bg_col = th.btn_active
            }
        }

        if (state == 1) {
            draw_shadow(disp, d, gc, x, y, w, h, th.btn_radius, 1)
        }
        fill_rounded_rect(disp, d, gc, bg_col, x, y, w, h, th.btn_radius)
        draw_rounded_border(disp, d, gc, border_col, x, y, w, h, th.btn_radius)

        forge tx = x + 12
        if (ofs_str_eq(icon, "run")) {
            icon_run(disp, d, gc, text_col, x + 8, y + 5)
            tx = x + 30
        }
        forge ty = y + (h / 2) + 4
        draw_str(disp, d, gc, text_col, tx, ty, text)
    }

    vein render_themed_switch(disp: *stone, d: stone, gc: *stone, x: stone, y: stone, active: stone, th: OllX11Theme) -> void {
        forge sw_w = 40
        forge sw_h = 20
        forge rad = 10
        if (active == 1) {
            fill_rounded_rect(disp, d, gc, th.accent, x, y, sw_w, sw_h, rad)
            fill_circle(disp, d, gc, 16777215, x + 29, y + 10, 7)
        } else {
            fill_rounded_rect(disp, d, gc, th.btn_bg, x, y, sw_w, sw_h, rad)
            draw_rounded_border(disp, d, gc, th.btn_border, x, y, sw_w, sw_h, rad)
            fill_circle(disp, d, gc, th.fg_muted, x + 11, y + 10, 7)
        }
    }

