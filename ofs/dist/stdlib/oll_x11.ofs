    vein get_theme_by_id(id: stone) -> OllX11Theme {
        if (id == 1) { return theme_gtk() }
        if (id == 2) { return theme_windows() }
        if (id == 3) { return theme_neon() }
        if (id == 4) { return theme_dracula() }
        if (id == 5) { return theme_monokai() }
        return theme_dark_modern()
    }

    vein resolve_path(p: obsidian) -> obsidian {
        forge f1: *stone = fopen(p, "r")
        if (f1 != null) {
            fclose(f1)
            return p
        }
        forge p2 = "idle/" + p
        forge f2: *stone = fopen(p2, "r")
        if (f2 != null) {
            fclose(f2)
            return p2
        }
        forge p3 = "../" + p
        forge f3: *stone = fopen(p3, "r")
        if (f3 != null) {
            fclose(f3)
            return p3
        }
        if (ofs_str_contains(p, "idle/")) {
            forge p4 = ofs_str_substr(p, 5, ofs_str_len(p) - 5)
            forge f4: *stone = fopen(p4, "r")
            if (f4 != null) {
                fclose(f4)
                return p4
            }
        }
        if (ofs_str_contains(p, "ofs/")) {
            forge p5 = "../" + p
            forge f5: *stone = fopen(p5, "r")
            if (f5 != null) {
                fclose(f5)
                return p5
            }
        }
        return p
    }

    vein resolve_ofs_binary() -> obsidian {
        forge f1 = fopen("./ofs/dist/ofs", "r")
        if (f1 != null) { fclose(f1); return "./ofs/dist/ofs" }
        forge f2 = fopen("../ofs/dist/ofs", "r")
        if (f2 != null) { fclose(f2); return "../ofs/dist/ofs" }
        return "ofs"
    }

    vein get_filename_from_path(p: obsidian) -> obsidian {
        forge len = ofs_str_len(p)
        forge last_slash = -1
        forge i = 0
        while (i < len) {
            forge c = ofs_str_char_at(p, i)
            if (c == 47 || c == 92) {
                last_slash = i
            }
            i++
        }
        if (last_slash >= 0 && last_slash < len - 1) {
            return ofs_str_substr(p, last_slash + 1, len - 1 - last_slash)
        }
        return p
    }

    vein scan_workspace_files(target_dir: obsidian) -> Array<obsidian> {
        forge list: Array<obsidian> = []
        if (ofs_str_len(target_dir) == 0) {
            return list
        }
        forge cmd = "(find \"" + target_dir + "\" -maxdepth 3 -not -path '*/.*' -not -path '*/dist*' -not -path '*/target*' -not -path '*/guide*' -not -path '*/node_modules*' -not -path '*/.gemini*' \\( -name \"*.ofs\" -o -name \"*.oll\" -o -name \"*.md\" \\) | sort) > /tmp/ofs_idle_scan.txt"
        system(cmd)
        forge f: *stone = fopen("/tmp/ofs_idle_scan.txt", "r")
        if (f == null) {
            return list
        }
        fseek(f, 0, 2)
        forge sz = ftell(f)
        fseek(f, 0, 0)
        if (sz <= 0) {
            fclose(f)
            return list
        }
        forge buf: *stone = ofs_alloc(sz + 1)
        fread(buf, 1, sz, f)
        fclose(f)

        forge text: obsidian = buf
        forge total_len = ofs_str_len(text)
        forge start = 0
        forge i = 0
        while (i < total_len) {
            forge c = ofs_str_char_at(text, i)
            if (c == 10) {
                forge line_len = i - start
                if (line_len > 0) {
                    if (ofs_str_char_at(text, i - 1) == 13) { line_len-- }
                }
                if (line_len > 1) {
                    forge raw_p = ofs_str_substr(text, start, line_len)
                    if (ofs_str_char_at(raw_p, 0) == 46 && ofs_str_char_at(raw_p, 1) == 47) {
                        forge clean_p = ofs_str_substr(raw_p, 2, ofs_str_len(raw_p) - 2)
                        ofs_array_push(list, clean_p)
                    } else {
                        ofs_array_push(list, raw_p)
                    }
                }
                start = i + 1
            }
            i++
        }
        return list
    }

    vein read_file_to_lines(path: obsidian) -> Array<obsidian> {
        forge lines: Array<obsidian> = []
        if (ofs_str_len(path) == 0) {
            return lines
        }
        forge resolved = resolve_path(path)
        forge f: *stone = fopen(resolved, "r")
        if (f == null) {
            ofs_array_push(lines, "")
            return lines
        }
        fseek(f, 0, 2)
        forge sz = ftell(f)
        fseek(f, 0, 0)
        if (sz <= 0) {
            fclose(f)
            ofs_array_push(lines, "")
            return lines
        }
        forge buf: *stone = ofs_alloc(sz + 1)
        fread(buf, 1, sz, f)
        fclose(f)

        forge text: obsidian = buf
        forge total_len = ofs_str_len(text)
        forge start = 0
        forge i = 0
        while (i < total_len) {
            forge c = ofs_str_char_at(text, i)
            if (c == 10) {
                forge line_len = i - start
                if (line_len > 0) {
                    if (ofs_str_char_at(text, i - 1) == 13) {
                        line_len--
                    }
                }
                forge l_sub = ofs_str_substr(text, start, line_len)
                ofs_array_push(lines, l_sub)
                start = i + 1
            }
            i++
        }
        if (start < total_len) {
            forge rem_len = total_len - start
            if (rem_len > 0) {
                if (ofs_str_char_at(text, total_len - 1) == 13) {
                    rem_len--
                }
            }
            forge rem_sub = ofs_str_substr(text, start, rem_len)
            ofs_array_push(lines, rem_sub)
        }
        if (ofs_array_len(lines) == 0) {
            ofs_array_push(lines, "")
        }
        return lines
    }

    vein save_lines_to_file(path: obsidian, lines: Array<obsidian>) -> stone {
        forge resolved = resolve_path(path)
        forge f: *stone = fopen(resolved, "w")
        if (f == null) {
            return 0
        }
        forge count = ofs_array_len(lines)
        forge i = 0
        while (i < count) {
            forge line: obsidian = ofs_array_get(lines, i)
            forge llen = ofs_str_len(line)
            if (llen > 0) {
                fwrite(line, 1, llen, f)
            }
            if (i < count - 1) {
                fwrite("\n", 1, 1, f)
            }
            i++
        }
        fclose(f)
        return 1
    }

    vein git_is_repository(target_dir: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" rev-parse --is-inside-work-tree > /tmp/ofs_git_check.txt 2>&1"
        system(cmd)
        forge lines = read_file_to_lines("/tmp/ofs_git_check.txt")
        if (ofs_array_len(lines) > 0) {
            forge l0: obsidian = ofs_array_get(lines, 0)
            if (ofs_str_contains(l0, "true")) { return 1 }
        }
        return 0
    }

    vein git_get_branch_name(target_dir: obsidian) -> obsidian {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" rev-parse --abbrev-ref HEAD > /tmp/ofs_git_br.txt 2>&1"
        system(cmd)
        forge lines = read_file_to_lines("/tmp/ofs_git_br.txt")
        if (ofs_array_len(lines) > 0) {
            forge br: obsidian = ofs_array_get(lines, 0)
            forge blen = ofs_str_len(br)
            if (blen > 0 && ofs_str_contains(br, "fatal") == 0) {
                return br
            }
        }
        return "main"
    }

    vein git_refresh_all_status(target_dir: obsidian, staged_f: Array<obsidian>, staged_t: Array<obsidian>, unstaged_f: Array<obsidian>, unstaged_t: Array<obsidian>) -> stone {
        while (ofs_array_len(staged_f) > 0) { ofs_array_pop(staged_f) }
        while (ofs_array_len(staged_t) > 0) { ofs_array_pop(staged_t) }
        while (ofs_array_len(unstaged_f) > 0) { ofs_array_pop(unstaged_f) }
        while (ofs_array_len(unstaged_t) > 0) { ofs_array_pop(unstaged_t) }

        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" status --porcelain > /tmp/ofs_git_status.txt 2>&1"
        system(cmd)
        forge lines = read_file_to_lines("/tmp/ofs_git_status.txt")
        forge len = ofs_array_len(lines)
        forge i = 0
        while (i < len) {
            forge l: obsidian = ofs_array_get(lines, i)
            forge llen = ofs_str_len(l)
            if (llen >= 3) {
                forge c0 = ofs_str_char_at(l, 0)
                forge c1 = ofs_str_char_at(l, 1)
                forge fname = ofs_str_substr(l, 3, llen - 3)
                if (c0 == 63 && c1 == 63) {
                    ofs_array_push(unstaged_f, fname)
                    ofs_array_push(unstaged_t, "U")
                } else {
                    if (c0 != 32) {
                        forge st_type = "M"
                        if (c0 == 65) { st_type = "A" }
                        else if (c0 == 68) { st_type = "D" }
                        else if (c0 == 82) { st_type = "R" }
                        ofs_array_push(staged_f, fname)
                        ofs_array_push(staged_t, st_type)
                    }
                    if (c1 != 32) {
                        forge ust_type = "M"
                        if (c1 == 68) { ust_type = "D" }
                        ofs_array_push(unstaged_f, fname)
                        ofs_array_push(unstaged_t, ust_type)
                    }
                }
            }
            i++
        }
        return 1
    }

    vein git_action_stage(target_dir: obsidian, file_path: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" add \"" + file_path + "\""
        return system(cmd)
    }

    vein git_action_stage_all(target_dir: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" add -A"
        return system(cmd)
    }

    vein git_action_unstage(target_dir: obsidian, file_path: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" restore --staged \"" + file_path + "\" 2>/dev/null || git -C \"" + d + "\" reset HEAD \"" + file_path + "\" 2>/dev/null"
        return system(cmd)
    }

    vein git_action_unstage_all(target_dir: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" restore --staged . 2>/dev/null || git -C \"" + d + "\" reset HEAD 2>/dev/null"
        return system(cmd)
    }

    vein git_action_discard(target_dir: obsidian, file_path: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" checkout -- \"" + file_path + "\" 2>/dev/null || git -C \"" + d + "\" restore \"" + file_path + "\" 2>/dev/null"
        return system(cmd)
    }

    vein git_action_commit(target_dir: obsidian, message: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" commit -m \"" + message + "\" > /tmp/ofs_git_cmd.log 2>&1"
        return system(cmd)
    }

    vein git_action_push(target_dir: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" push > /tmp/ofs_git_cmd.log 2>&1"
        return system(cmd)
    }

    vein git_action_pull(target_dir: obsidian) -> stone {
        forge d = target_dir
        if (ofs_str_len(d) == 0) { d = "." }
        forge cmd = "git -C \"" + d + "\" pull > /tmp/ofs_git_cmd.log 2>&1"
        return system(cmd)
    }

    vein insert_char_in_line(line: obsidian, col: stone, ch: obsidian) -> obsidian {
        forge len = ofs_str_len(line)
        if (col <= 0) {
            return ch + line
        }
        if (col >= len) {
            return line + ch
        }
        forge left = ofs_str_substr(line, 0, col)
        forge right = ofs_str_substr(line, col, len - col)
        return left + ch + right
    }

    vein delete_char_in_line(line: obsidian, col: stone) -> obsidian {
        forge len = ofs_str_len(line)
        if (col <= 0 || len == 0) {
            return line
        }
        forge left = ofs_str_substr(line, 0, col - 1)
        if (col >= len) {
            return left
        }
        forge right = ofs_str_substr(line, col, len - col)
        return left + right
    }

    vein split_line_at(line: obsidian, col: stone) -> obsidian {
        forge len = ofs_str_len(line)
        if (col >= len) {
            return ""
        }
        return ofs_str_substr(line, col, len - col)
    }

    vein array_remove_at(a: Array, idx: stone) -> void {
        forge len = ofs_array_len(a)
        if (idx < 0 || idx >= len) { return }
        forge i = idx
        while (i < len - 1) {
            forge nxt: stone = ofs_array_get(a, i + 1)
            ofs_array_set(a, i, nxt)
            i++
        }
        ofs_array_pop(a)
    }

    vein is_keyword(w: obsidian) -> stone {
        if (ofs_str_eq(w, "vein")) { return 1 }
        if (ofs_str_eq(w, "forge")) { return 1 }
        if (ofs_str_eq(w, "monolith")) { return 1 }
        if (ofs_str_eq(w, "impl")) { return 1 }
        if (ofs_str_eq(w, "attach")) { return 1 }
        if (ofs_str_eq(w, "if")) { return 1 }
        if (ofs_str_eq(w, "else")) { return 1 }
        if (ofs_str_eq(w, "while")) { return 1 }
        if (ofs_str_eq(w, "return")) { return 1 }
        if (ofs_str_eq(w, "extern")) { return 1 }
        if (ofs_str_eq(w, "match")) { return 1 }
        if (ofs_str_eq(w, "case")) { return 1 }
        if (ofs_str_eq(w, "fracture")) { return 1 }
        if (ofs_str_eq(w, "namespace")) { return 1 }
        if (ofs_str_eq(w, "break")) { return 1 }
        if (ofs_str_eq(w, "true")) { return 1 }
        if (ofs_str_eq(w, "false")) { return 1 }
        if (ofs_str_eq(w, "null")) { return 1 }
        return 0
    }

    vein is_type_ident(w: obsidian) -> stone {
        if (ofs_str_eq(w, "stone")) { return 1 }
        if (ofs_str_eq(w, "crystal")) { return 1 }
        if (ofs_str_eq(w, "obsidian")) { return 1 }
        if (ofs_str_eq(w, "bool")) { return 1 }
        if (ofs_str_eq(w, "void")) { return 1 }
        if (ofs_str_eq(w, "Array")) { return 1 }
        if (ofs_str_eq(w, "OllX11Theme")) { return 1 }
        return 0
    }

    vein render_syntax_line(disp: *stone, d: stone, gc: *stone, line: obsidian, x: stone, y: stone, default_col: stone) -> void {
        forge len = ofs_str_len(line)
        if (len <= 0) { return }
        forge i = 0
        while (i < len && i < 115) {
            forge c = ofs_str_char_at(line, i)
            if (c == 32 || c == 9) {
                i++
            } else if (c == 47 && i + 1 < len && ofs_str_char_at(line, i + 1) == 47) {
                forge tok_comm = ofs_str_substr(line, i, len - i)
                draw_str_code(disp, d, gc, 6054768, x + (i * 8), y, tok_comm)
                i = len
            } else if (c == 34) {
                forge s_start = i
                i++
                while (i < len && ofs_str_char_at(line, i) != 34) {
                    if (ofs_str_char_at(line, i) == 92 && i + 1 < len) { i++ }
                    i++
                }
                if (i < len) { i++ }
                forge tok_str = ofs_str_substr(line, s_start, i - s_start)
                draw_str_code(disp, d, gc, 10011513, x + (s_start * 8), y, tok_str)
            } else if (c >= 48 && c <= 57) {
                forge n_start = i
                while (i < len) {
                    forge nc = ofs_str_char_at(line, i)
                    if ((nc >= 48 && nc <= 57) || nc == 120 || nc == 88 || (nc >= 97 && nc <= 102) || (nc >= 65 && nc <= 70)) {
                        i++
                    } else {
                        break
                    }
                }
                forge tok_n = ofs_str_substr(line, n_start, i - n_start)
                draw_str_code(disp, d, gc, 15057019, x + (n_start * 8), y, tok_n)
            } else if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
                forge w_start = i
                while (i < len) {
                    forge wc = ofs_str_char_at(line, i)
                    if ((wc >= 65 && wc <= 90) || (wc >= 97 && wc <= 122) || (wc >= 48 && wc <= 57) || wc == 95) {
                        i++
                    } else {
                        break
                    }
                }
                forge tok_w = ofs_str_substr(line, w_start, i - w_start)
                forge w_col = default_col
                if (is_keyword(tok_w) == 1) {
                    w_col = 13007069
                } else if (is_type_ident(tok_w) == 1) {
                    w_col = 15057019
                }
                draw_str_code(disp, d, gc, w_col, x + (w_start * 8), y, tok_w)
            } else {
                forge sym_start = i
                while (i < len) {
                    forge sc = ofs_str_char_at(line, i)
                    if (sc == 32 || sc == 9 || sc == 34 || (sc >= 48 && sc <= 57) || (sc >= 65 && sc <= 90) || (sc >= 97 && sc <= 122) || sc == 95 || (sc == 47 && i + 1 < len && ofs_str_char_at(line, i + 1) == 47)) {
                        break
                    }
                    i++
                }
                forge tok_sym = ofs_str_substr(line, sym_start, i - sym_start)
                forge s_col = 11252415
                if (ofs_str_contains(tok_sym, "->") || ofs_str_contains(tok_sym, "==") || ofs_str_contains(tok_sym, "!=")) {
                    s_col = 6401007
                }
                draw_str_code(disp, d, gc, s_col, x + (sym_start * 8), y, tok_sym)
            }
        }
    }

    vein draw_rect(disp: *stone, d: stone, gc: *stone, col: stone, x: stone, y: stone, w: stone, h: stone) -> void {
        XSetForeground(disp, gc, col)
        XFillRectangle(disp, d, gc, x, y, w, h)
    }

    vein draw_border(disp: *stone, d: stone, gc: *stone, col: stone, x: stone, y: stone, w: stone, h: stone) -> void {
        XSetForeground(disp, gc, col)
        XDrawRectangle(disp, d, gc, x, y, w, h)
    }

    vein fill_rounded_rect(disp: *stone, d: stone, gc: *stone, col: stone, x: stone, y: stone, w: stone, h: stone, r: stone) -> void {
        if (r <= 1) {
            draw_rect(disp, d, gc, col, x, y, w, h)
            return
        }
        forge d_diam = r * 2
        XSetForeground(disp, gc, col)
        XFillRectangle(disp, d, gc, x + r, y, w - d_diam, h)
        XFillRectangle(disp, d, gc, x, y + r, r, h - d_diam)
        XFillRectangle(disp, d, gc, x + w - r, y + r, r, h - d_diam)
        XFillArc(disp, d, gc, x, y, d_diam, d_diam, 90 * 64, 90 * 64)
        XFillArc(disp, d, gc, x + w - d_diam, y, d_diam, d_diam, 0 * 64, 90 * 64)
        XFillArc(disp, d, gc, x, y + h - d_diam, d_diam, d_diam, 180 * 64, 90 * 64)
        XFillArc(disp, d, gc, x + w - d_diam, y + h - d_diam, d_diam, d_diam, 270 * 64, 90 * 64)
    }

    vein draw_rounded_border(disp: *stone, d: stone, gc: *stone, col: stone, x: stone, y: stone, w: stone, h: stone, r: stone) -> void {
        if (r <= 1) {
            draw_border(disp, d, gc, col, x, y, w, h)
            return
        }
        forge d_diam = r * 2
        XSetForeground(disp, gc, col)
        XDrawLine(disp, d, gc, x + r, y, x + w - r, y)
        XDrawLine(disp, d, gc, x + r, y + h, x + w - r, y + h)
        XDrawLine(disp, d, gc, x, y + r, x, y + h - r)
        XDrawLine(disp, d, gc, x + w, y + r, x + w, y + h - r)
        XDrawArc(disp, d, gc, x, y, d_diam, d_diam, 90 * 64, 90 * 64)
        XDrawArc(disp, d, gc, x + w - d_diam, y, d_diam, d_diam, 0 * 64, 90 * 64)
        XDrawArc(disp, d, gc, x, y + h - d_diam, d_diam, d_diam, 180 * 64, 90 * 64)
        XDrawArc(disp, d, gc, x + w - d_diam, y + h - d_diam, d_diam, d_diam, 270 * 64, 90 * 64)
    }

    vein fill_circle(disp: *stone, d: stone, gc: *stone, col: stone, cx: stone, cy: stone, r: stone) -> void {
        XSetForeground(disp, gc, col)
        XFillArc(disp, d, gc, cx - r, cy - r, r * 2, r * 2, 0, 360 * 64)
    }

    vein draw_circle(disp: *stone, d: stone, gc: *stone, col: stone, cx: stone, cy: stone, r: stone) -> void {
        XSetForeground(disp, gc, col)
        XDrawArc(disp, d, gc, cx - r, cy - r, r * 2, r * 2, 0, 360 * 64)
    }

    vein draw_line(disp: *stone, d: stone, gc: *stone, col: stone, x1: stone, y1: stone, x2: stone, y2: stone) -> void {
        XSetForeground(disp, gc, col)
        XDrawLine(disp, d, gc, x1, y1, x2, y2)
    }

    vein draw_str(disp: *stone, d: stone, gc: *stone, col: stone, x: stone, y: stone, str: obsidian) -> void {
        if (g_xft_draw != 0 && g_xft_font_ui != 0) {
            forge r_val = ((col / 65536) % 256) * 257
            forge g_val = ((col / 256) % 256) * 257
            forge b_val = (col % 256) * 257
            forge a_val = 65535
            forge c_quad = r_val + (g_val * 65536) + (b_val * 4294967296) + (a_val * 281474976710656)
            _store_stone(g_xft_col_in as *stone, c_quad)
            XftColorAllocValue(disp, g_xft_visual as *stone, g_xft_cmap, g_xft_col_in as *stone, g_xft_col_out as *stone)
            forge len = ofs_str_len(str)
            XftDrawStringUtf8(g_xft_draw as *stone, g_xft_col_out as *stone, g_xft_font_ui as *stone, x, y, str, len)
        } else {
            XSetForeground(disp, gc, col)
            forge len = ofs_str_len(str)
            XDrawString(disp, d, gc, x, y, str, len)
        }
    }

    vein draw_str_code(disp: *stone, d: stone, gc: *stone, col: stone, x: stone, y: stone, str: obsidian) -> void {
        if (g_xft_draw != 0 && g_xft_font_code != 0) {
            forge r_val = ((col / 65536) % 256) * 257
