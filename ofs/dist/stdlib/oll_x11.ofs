                    forge is_shift = state % 2
                    forge is_ctrl = (state / 4) % 2

                    forge sym = XKeycodeToKeysym(disp, keycode, is_shift)

                    if (folder_picker_open > 0) {
                        if (sym == 65307) {
                            folder_picker_open = 0
                            needs_redraw = 1
                        } else if (sym == 65293) {
                            workspace_folder = folder_picker_input
                            workspace_files = scan_workspace_files(workspace_folder)
                            git_is_repo = git_is_repository(workspace_folder)
                            if (git_is_repo == 1) {
                                git_branch = git_get_branch_name(workspace_folder)
                                git_refresh_all_status(workspace_folder, git_staged_files, git_staged_types, git_unstaged_files, git_unstaged_types)
                            }
                            folder_picker_open = 0
                            needs_redraw = 1
                        } else if (sym == 65288) {
                            forge f_len = ofs_str_len(folder_picker_input)
                            if (f_len > 0) {
                                folder_picker_input = ofs_str_substr(folder_picker_input, 0, f_len - 1)
                                needs_redraw = 1
                            }
                        } else if (sym >= 32 && sym <= 126 && is_ctrl == 0) {
                            forge ch_buf_fp: *stone = ofs_alloc(8)
                            fracture {
                                *ch_buf_fp = sym
                            }
                            forge ch_str_fp: obsidian = ch_buf_fp
                            folder_picker_input = folder_picker_input + ch_str_fp
                            needs_redraw = 1
                        }
                    } else if (palette_open > 0) {
                        if (sym == 65307) {
                            palette_open = 0
                            needs_redraw = 1
                        } else if (sym == 65362) {
                            if (palette_sel > 0) { palette_sel-- }
                            needs_redraw = 1
                        } else if (sym == 65364) {
                            if (palette_sel < 7) { palette_sel++ }
                            needs_redraw = 1
                        } else if (sym == 65288) {
                            forge qlen = ofs_str_len(palette_query)
                            if (qlen > 0) {
                                palette_query = ofs_str_substr(palette_query, 0, qlen - 1)
                                needs_redraw = 1
                            }
                        } else if (sym == 65293) {
                            if (palette_sel == 0 || palette_sel == 1) {
                                active_panel_tab = 0
                                if (is_dirty == 1) {
                                    save_lines_to_file(active_file_path, editor_lines)
                                    is_dirty = 0
                                }
                                forge ofs_bin_c2 = resolve_ofs_binary()
                                forge real_p_c2 = resolve_path(active_file_path)
                                ofs_array_push(terminal_lines, "samns@linux-ofs:~/Obsidian-Fault-Script/idle$ ofs build " + real_p_c2)
                                forge ret_c2 = system(ofs_bin_c2 + " build " + real_p_c2 + " > /tmp/ofs_idle_build.log 2>&1")
                                forge log_lines_c2 = read_file_to_lines("/tmp/ofs_idle_build.log")
                                forge l_len_c2 = ofs_array_len(log_lines_c2)
                                forge li_c2 = 0
                                while (li_c2 < l_len_c2) {
                                    forge ll_c2: obsidian = ofs_array_get(log_lines_c2, li_c2)
                                    if (ofs_str_len(ll_c2) > 0) { ofs_array_push(terminal_lines, ll_c2) }
                                    li_c2++
                                }
                                if (ret_c2 == 0) {
                                    ofs_array_push(terminal_lines, "[OFS IDLE] Build concluido com sucesso (codigo 0).")
                                    lsp_err_count = 0
                                } else {
                                    ofs_array_push(terminal_lines, "[OFS IDLE] Falha no build (codigo " + ofs_stone_to_obsidian(ret_c2) + ").")
                                    lsp_err_count = 1
                                }
                                ofs_array_push(terminal_lines, "samns@linux-ofs:~/Obsidian-Fault-Script/idle$")
                            } else if (palette_sel == 2) {
                                active_panel_tab = 1
                            } else if (palette_sel == 3) {
                                active_panel_tab = 2
                            } else if (palette_sel == 4) {
                                active_theme_id = (active_theme_id + 1) % 4
                            } else if (palette_sel == 5) {
                                save_lines_to_file(active_file_path, editor_lines)
                                is_dirty = 0
                                echo("[OFS IDLE] Arquivo salvo: " + active_file_path)
                            } else if (palette_sel == 6) {
                                ofs_array_push(open_tabs, "sem_titulo.ofs")
                                ofs_array_push(open_paths, "sem_titulo.ofs")
                                active_tab_idx = ofs_array_len(open_tabs) - 1
                                active_file_name = "sem_titulo.ofs"
                                active_file_path = "sem_titulo.ofs"
                                editor_lines = [""]
                                cursor_row = 0
                                cursor_col = 0
                                scroll_top = 0
                                is_dirty = 0
                            } else if (palette_sel == 7) {
                                terminal_lines = []
                                ofs_array_push(terminal_lines, "samns@linux-ofs:~/Obsidian-Fault-Script/idle$")
                            }
                            palette_open = 0
                            needs_redraw = 1
                        } else if (sym >= 32 && sym <= 126) {
                            forge ch_buf_p: *stone = ofs_alloc(8)
                            fracture {
                                *ch_buf_p = sym
                            }
                            forge ch_str_p: obsidian = ch_buf_p
                            palette_query = palette_query + ch_str_p
                            needs_redraw = 1
                        }
                    } else if (sym == 65307) {
                        if (modal_open > 0) {
                            modal_open = 0
                            needs_redraw = 1
                        } else if (menu_open > 0) {
                            menu_open = 0
                            needs_redraw = 1
                        } else {
                            running = 0
                        }
                    } else if (is_ctrl == 1 && (sym == 49 || sym == 101 || sym == 69)) {
                        active_activity = 0
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 50 || sym == 102 || sym == 70)) {
                        active_activity = 1
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 51 || sym == 103 || sym == 71)) {
                        active_activity = 2
                        focused_area = 2
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 52 || sym == 100 || sym == 68)) {
                        active_activity = 3
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 53 || sym == 120 || sym == 88)) {
                        active_activity = 4
                        focused_area = 3
                        needs_redraw = 1
                    } else if (sym == 65479) {
                        menu_open = 1
                        menu_hover = -1
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 112 || sym == 80)) {
                        palette_open = 1
                        palette_query = ""
                        palette_sel = 0
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 115 || sym == 83)) {
                        save_lines_to_file(active_file_path, editor_lines)
                        is_dirty = 0
                        echo("[OFS IDLE] Arquivo salvo: " + active_file_path)
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 119 || sym == 87)) {
                        if (ofs_array_len(open_tabs) > 0 && active_tab_idx >= 0) {
                            array_remove_at(open_tabs, active_tab_idx)
                            array_remove_at(open_paths, active_tab_idx)
                            forge rem_t = ofs_array_len(open_tabs)
                            if (rem_t == 0) {
                                active_tab_idx = -1
                                active_file_name = ""
                                active_file_path = ""
                                editor_lines = []
                            } else {
                                if (active_tab_idx >= rem_t) { active_tab_idx = rem_t - 1 }
                                active_file_path = ofs_array_get(open_paths, active_tab_idx)
                                active_file_name = ofs_array_get(open_tabs, active_tab_idx)
                                editor_lines = read_file_to_lines(active_file_path)
                            }
                            cursor_row = 0
                            cursor_col = 0
                            is_dirty = 0
                            needs_redraw = 1
                        }
                    } else if (sym == 65474 || (is_ctrl == 1 && (sym == 98 || sym == 66))) {
                        active_panel_tab = 0
                        if (is_dirty == 1) {
                            save_lines_to_file(active_file_path, editor_lines)
                            is_dirty = 0
                        }
                        forge ofs_bin_k = resolve_ofs_binary()
                        forge real_p_k = resolve_path(active_file_path)
                        ofs_array_push(terminal_lines, "samns@linux-ofs:~/Obsidian-Fault-Script/idle$ ofs build " + real_p_k)
                        forge ret_k = system(ofs_bin_k + " build " + real_p_k + " > /tmp/ofs_idle_build.log 2>&1")
                        forge log_lines_k = read_file_to_lines("/tmp/ofs_idle_build.log")
                        forge l_len_k = ofs_array_len(log_lines_k)
                        forge li_k = 0
                        while (li_k < l_len_k) {
                            forge ll_k: obsidian = ofs_array_get(log_lines_k, li_k)
                            if (ofs_str_len(ll_k) > 0) {
                                ofs_array_push(terminal_lines, ll_k)
                            }
                            li_k++
                        }
                        if (ret_k == 0) {
                            ofs_array_push(terminal_lines, "[OFS IDLE] Build concluido com sucesso (codigo 0).")
                            lsp_err_count = 0
                        } else {
                            ofs_array_push(terminal_lines, "[OFS IDLE] Falha no build (codigo " + ofs_stone_to_obsidian(ret_k) + ").")
                            lsp_err_count = 1
                        }
                        ofs_array_push(terminal_lines, "samns@linux-ofs:~/Obsidian-Fault-Script/idle$")
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 111 || sym == 79)) {
                        folder_picker_open = 1
                        folder_picker_input = "."
                        needs_redraw = 1
                    } else if (is_ctrl == 1 && (sym == 96 || sym == 126 || sym == 106 || sym == 74)) {
                        focused_area = 1
                        active_panel_tab = 0
                        needs_redraw = 1
                    } else if (focused_area == 1) {
                        if (sym == 65293) {
                            ofs_array_push(terminal_lines, "samns@linux-ofs:~/Obsidian-Fault-Script$ " + terminal_input_buf)
                            if (ofs_str_eq(terminal_input_buf, "clear")) {
                                terminal_lines = []
                            } else if (ofs_str_len(terminal_input_buf) > 0) {
                                system("(" + terminal_input_buf + ") > /tmp/ofs_idle_term.log 2>&1")
                                forge tlogs = read_file_to_lines("/tmp/ofs_idle_term.log")
                                forge tcnt = ofs_array_len(tlogs)
                                forge ti3 = 0
                                while (ti3 < tcnt) {
                                    forge tl3: obsidian = ofs_array_get(tlogs, ti3)
                                    if (ofs_str_len(tl3) > 0) {
                                        ofs_array_push(terminal_lines, tl3)
                                    }
                                    ti3++
                                }
                            }
                            terminal_input_buf = ""
                            needs_redraw = 1
                        } else if (sym == 65288) {
                            forge tlen = ofs_str_len(terminal_input_buf)
                            if (tlen > 0) {
                                terminal_input_buf = ofs_str_substr(terminal_input_buf, 0, tlen - 1)
                                needs_redraw = 1
                            }
                        } else if (sym >= 32 && sym <= 126 && is_ctrl == 0) {
                            forge ch_buf_t: *stone = ofs_alloc(8)
                            fracture {
                                *ch_buf_t = sym
                            }
                            forge ch_str_t: obsidian = ch_buf_t
                            terminal_input_buf = terminal_input_buf + ch_str_t
                            needs_redraw = 1
                        }
                    } else if (focused_area == 2) {
                        if (sym == 65307) {
                            focused_area = 0
                            needs_redraw = 1
                        } else if (sym == 65293) {
                            if (ofs_str_len(git_commit_msg_buf) > 0) {
                                git_action_commit(workspace_folder, git_commit_msg_buf)
                                git_commit_msg_buf = ""
                                git_refresh_all_status(workspace_folder, git_staged_files, git_staged_types, git_unstaged_files, git_unstaged_types)
                                needs_redraw = 1
                            }
                        } else if (sym == 65288) {
                            forge c_msg_len = ofs_str_len(git_commit_msg_buf)
                            if (c_msg_len > 0) {
                                git_commit_msg_buf = ofs_str_substr(git_commit_msg_buf, 0, c_msg_len - 1)
                                needs_redraw = 1
                            }
                        } else if (sym >= 32 && sym <= 126 && is_ctrl == 0) {
                            forge ch_buf_c: *stone = ofs_alloc(8)
                            fracture {
                                *ch_buf_c = sym
                            }
                            forge ch_str_c: obsidian = ch_buf_c
                            git_commit_msg_buf = git_commit_msg_buf + ch_str_c
                            needs_redraw = 1
                        }
                    } else if (focused_area == 3) {
                        if (sym == 65307) {
                            focused_area = 0
                            needs_redraw = 1
                        } else if (sym == 65288) {
                            forge q_len_x = ofs_str_len(ext_search_query)
                            if (q_len_x > 0) {
                                ext_search_query = ofs_str_substr(ext_search_query, 0, q_len_x - 1)
                                needs_redraw = 1
                            }
                        } else if (sym >= 32 && sym <= 126 && is_ctrl == 0) {
                            forge ch_buf_x: *stone = ofs_alloc(8)
                            fracture {
                                *ch_buf_x = sym
                            }
                            forge ch_str_x: obsidian = ch_buf_x
                            ext_search_query = ext_search_query + ch_str_x
                            needs_redraw = 1
                        }
                    } else if (ofs_array_len(open_tabs) > 0) {
                        if (sym == 65362) {
                            if (cursor_row > 0) {
                                cursor_row--
                                forge l_txt: obsidian = ofs_array_get(editor_lines, cursor_row)
                                forge l_len = ofs_str_len(l_txt)
                                if (cursor_col > l_len) { cursor_col = l_len }
                                if (cursor_row < scroll_top) { scroll_top = cursor_row }
                            }
                            needs_redraw = 1
                        } else if (sym == 65364) {
                            forge t_lines = ofs_array_len(editor_lines)
                            if (cursor_row < t_lines - 1) {
                                cursor_row++
                                forge l_txt: obsidian = ofs_array_get(editor_lines, cursor_row)
                                forge l_len = ofs_str_len(l_txt)
                                if (cursor_col > l_len) { cursor_col = l_len }
                                if (cursor_row >= scroll_top + 24) { scroll_top = cursor_row - 23 }
                            }
                            needs_redraw = 1
                        } else if (sym == 65361) {
                            if (cursor_col > 0) {
                                cursor_col--
                            } else if (cursor_row > 0) {
                                cursor_row--
                                forge l_txt: obsidian = ofs_array_get(editor_lines, cursor_row)
                                cursor_col = ofs_str_len(l_txt)
                                if (cursor_row < scroll_top) { scroll_top = cursor_row }
                            }
                            needs_redraw = 1
                        } else if (sym == 65363) {
                            forge cur_l: obsidian = ofs_array_get(editor_lines, cursor_row)
                            forge l_len = ofs_str_len(cur_l)
                            if (cursor_col < l_len) {
                                cursor_col++
                            } else {
                                forge t_lines = ofs_array_len(editor_lines)
                                if (cursor_row < t_lines - 1) {
                                    cursor_row++
                                    cursor_col = 0
                                    if (cursor_row >= scroll_top + 24) { scroll_top = cursor_row - 23 }
                                }
                            }
                            needs_redraw = 1
                        } else if (sym == 65360) {
                            cursor_col = 0
                            needs_redraw = 1
                        } else if (sym == 65367) {
                            forge cur_l: obsidian = ofs_array_get(editor_lines, cursor_row)
                            cursor_col = ofs_str_len(cur_l)
                            needs_redraw = 1
                        } else if (sym == 65365) {
                            if (cursor_row >= 15) { cursor_row = cursor_row - 15 }
                            else { cursor_row = 0 }
                            if (scroll_top >= 15) { scroll_top = scroll_top - 15 }
                            else { scroll_top = 0 }
                            needs_redraw = 1
                        } else if (sym == 65366) {
                            forge t_lines = ofs_array_len(editor_lines)
                            cursor_row = cursor_row + 15
                            if (cursor_row >= t_lines) { cursor_row = t_lines - 1 }
                            scroll_top = scroll_top + 15
                            if (scroll_top >= t_lines) { scroll_top = t_lines - 1 }
                            needs_redraw = 1
                        } else if (sym == 65288) {
                            forge cur_l: obsidian = ofs_array_get(editor_lines, cursor_row)
                            if (cursor_col > 0) {
                                forge new_l = delete_char_in_line(cur_l, cursor_col)
                                ofs_array_set(editor_lines, cursor_row, new_l)
                                cursor_col--
                                is_dirty = 1
                            } else if (cursor_row > 0) {
                                forge prev_l: obsidian = ofs_array_get(editor_lines, cursor_row - 1)
                                cursor_col = ofs_str_len(prev_l)
                                ofs_array_set(editor_lines, cursor_row - 1, prev_l + cur_l)

                                forge idx = cursor_row
                                forge total_l = ofs_array_len(editor_lines)
                                while (idx < total_l - 1) {
                                    forge nxt: obsidian = ofs_array_get(editor_lines, idx + 1)
                                    ofs_array_set(editor_lines, idx, nxt)
                                    idx++
                                }
                                ofs_array_pop(editor_lines)
                                cursor_row--
                                if (cursor_row < scroll_top) { scroll_top = cursor_row }
                                is_dirty = 1
                            }
                            needs_redraw = 1
                        } else if (sym == 65293) {
                            forge cur_l: obsidian = ofs_array_get(editor_lines, cursor_row)
                            forge left_p = ofs_str_substr(cur_l, 0, cursor_col)
                            forge right_p = split_line_at(cur_l, cursor_col)
                            ofs_array_set(editor_lines, cursor_row, left_p)

                            ofs_array_push(editor_lines, "")
                            forge shift_idx = ofs_array_len(editor_lines) - 1
                            while (shift_idx > cursor_row + 1) {
                                forge prev_item: obsidian = ofs_array_get(editor_lines, shift_idx - 1)
                                ofs_array_set(editor_lines, shift_idx, prev_item)
                                shift_idx--
                            }
                            ofs_array_set(editor_lines, cursor_row + 1, right_p)
                            cursor_row++
                            cursor_col = 0
                            if (cursor_row >= scroll_top + 24) { scroll_top = cursor_row - 23 }
                            is_dirty = 1
                            needs_redraw = 1
                        } else if (sym == 65289) {
                            forge cur_l: obsidian = ofs_array_get(editor_lines, cursor_row)
                            forge new_l = insert_char_in_line(cur_l, cursor_col, "    ")
                            ofs_array_set(editor_lines, cursor_row, new_l)
                            cursor_col = cursor_col + 4
                            is_dirty = 1
                            needs_redraw = 1
                        } else if (sym >= 32 && sym <= 126 && is_ctrl == 0) {
                            forge ch_buf: *stone = ofs_alloc(8)
                            fracture {
                                *ch_buf = sym
                            }
                            forge ch_str: obsidian = ch_buf
                            forge cur_l: obsidian = ofs_array_get(editor_lines, cursor_row)
                            forge new_l = insert_char_in_line(cur_l, cursor_col, ch_str)
                            ofs_array_set(editor_lines, cursor_row, new_l)
                            cursor_col++
                            is_dirty = 1
                            needs_redraw = 1
                        }
                    }
                } else if (ev_type == 22) {
                    forge p_wh: *stone = fault_step(event_buf, 7)
                    forge raw_wh: stone = 0
                    fracture {
                        raw_wh = *p_wh
                    }
                    forge new_w = (raw_wh % 4294967296) % 65536
                    forge new_h = ((raw_wh / 4294967296) % 4294967296) % 65536
                    echo("[OFS IDLE] ConfigureNotify: w=" + ofs_stone_to_obsidian(new_w) + " h=" + ofs_stone_to_obsidian(new_h))
                    if (new_w > 100 && new_h > 100) {
                        if (new_w != win_w || new_h != win_h) {
                            win_w = new_w
                            win_h = new_h
                            if (pix != 0) {
                                XFreePixmap(disp, pix)
                            }
                            pix = XCreatePixmap(disp, win, win_w, win_h, depth)
                            if (g_xft_draw != 0) {
                                XftDrawDestroy(g_xft_draw as *stone)
                            }
                            g_xft_draw = XftDrawCreate(disp, pix, g_xft_visual as *stone, g_xft_cmap) as stone
                            needs_redraw = 1
                        }
                    }
                } else if (ev_type == 12) {
                    needs_redraw = 1
                }
            }

            if (needs_redraw != 0) {
                forge cur_th = get_theme_by_id(active_theme_id)
                forge statusbar_y = win_h - 24
                forge panel_h = 220
                if (win_h < 650) { panel_h = 160 }
                forge panel_y = statusbar_y - panel_h

                draw_rect(disp, pix, gc, cur_th.bg_window, 0, 0, win_w, win_h)

                render_menu_bar(disp, pix, gc, hover_elem, cur_th, win_w)
                render_activity_bar(disp, pix, gc, active_activity, hover_elem, cur_th, win_h)
                render_sidebar(disp, pix, gc, active_activity, workspace_files, active_file_path, open_tabs, hover_elem, cur_th, search_query, workspace_folder, win_h, git_branch, git_commit_msg_buf, git_staged_files, git_staged_types, git_unstaged_files, git_unstaged_types, ext_search_query, focused_area, active_theme_id, git_is_repo)
                render_editor_area(disp, pix, gc, open_tabs, active_tab_idx, hover_elem, cur_th, editor_lines, cursor_row, cursor_col, scroll_top, is_dirty, active_file_path, win_w, win_h, panel_y)
                render_bottom_panel(disp, pix, gc, active_panel_tab, hover_elem, cur_th, terminal_lines, lsp_err_count, active_file_name, cursor_row, cursor_col, terminal_input_buf, focused_area, win_w, win_h, panel_y)
                render_status_bar(disp, pix, gc, cur_th, cursor_row, cursor_col, lsp_err_count, active_file_name, is_dirty, win_w, win_h, git_branch)

                if (menu_open > 0) {
                    render_dropdown_menu(disp, pix, gc, menu_open, menu_hover, cur_th)
                }

                if (modal_open > 0) {
                    render_preferences_modal(disp, pix, gc, win_w, win_h, modal_tab, modal_theme, modal_font_size, modal_lsp, modal_autosave, modal_hover, cur_th)
                }

                if (folder_picker_open > 0) {
                    render_folder_picker_modal(disp, pix, gc, win_w, win_h, folder_picker_input, hover_elem, cur_th)
                }

                if (palette_open > 0) {
                    render_command_palette(disp, pix, gc, win_w, win_h, palette_query, palette_sel, cur_th)
                }

                XCopyArea(disp, pix, win, gc, 0, 0, win_w, win_h, 0, 0)
                XFlush(disp)
                needs_redraw = 0
            }

            usleep(16000)
        }

        echo("[OFS OLL Viewer] Encerrando visualizacao...")
        if (g_xft_draw != 0) {
            XftDrawDestroy(g_xft_draw as *stone)
            g_xft_draw = 0
        }
        XFreePixmap(disp, pix)
        XDestroyWindow(disp, win)
        XCloseDisplay(disp)
        echo("[OFS OLL Viewer] Finalizado com sucesso.")
        return 0
    }
}

