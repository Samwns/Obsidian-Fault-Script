attach {F:bedrock.ofs}
attach {F:window.ofs}
attach {F:fs.ofs}

extern vein ofs_str_len(s: obsidian) -> stone
extern vein ofs_str_char_at(s: obsidian, idx: stone) -> stone
extern vein ofs_stone_to_obsidian(v: stone) -> obsidian
extern vein fopen(path: obsidian, mode: obsidian) -> *stone
extern vein fclose(f: *stone) -> stone
extern vein fputs(s: obsidian, f: *stone) -> stone
extern vein fputc(c: stone, f: *stone) -> stone

rift vein ofs_window_present_pixels(buf: *stone) -> void bind "ofs_window_present_stone_rgba" abi c

monolith Canvas {
    width: stone
    height: stone
    buffer: *stone
}

namespace canvas {
    vein create(w: stone, h: stone) -> Canvas {
        forge cv: Canvas
        cv.width = w
        cv.height = h
        cv.buffer = bedrock_region_new(w * h)
        clear(cv, 16777215)
        return cv
    }

    vein destroy(cv: Canvas) -> void {
        bedrock_region_drop(cv.buffer)
    }

    vein index_of(cv: Canvas, x: stone, y: stone) -> stone {
        return y * cv.width + x
    }

    vein in_bounds(cv: Canvas, x: stone, y: stone) -> bool {
        return x >= 0 && y >= 0 && x < cv.width && y < cv.height
    }

    vein clear(cv: Canvas, color: stone) -> void {
        forge total: stone = cv.width * cv.height
        cycle (forge i: stone = 0; i < total; i++) {
            bedrock_region_write(cv.buffer, i, color)
        }
    }

    vein set_pixel(cv: Canvas, x: stone, y: stone, color: stone) -> void {
        if (!in_bounds(cv, x, y)) {
            return
        }
        forge idx: stone = index_of(cv, x, y)
        bedrock_region_write(cv.buffer, idx, color)
    }

    vein get_pixel(cv: Canvas, x: stone, y: stone) -> stone {
        if (!in_bounds(cv, x, y)) {
            return 0
        }
        forge idx: stone = index_of(cv, x, y)
        return bedrock_region_read(cv.buffer, idx)
    }

    vein fill_rect(cv: Canvas, x: stone, y: stone, w: stone, h: stone, color: stone) -> void {
        cycle (forge yy: stone = 0; yy < h; yy++) {
            cycle (forge xx: stone = 0; xx < w; xx++) {
                set_pixel(cv, x + xx, y + yy, color)
            }
        }
    }

    vein draw_rect(cv: Canvas, x: stone, y: stone, w: stone, h: stone, color: stone) -> void {
        cycle (forge xx: stone = 0; xx < w; xx++) {
            set_pixel(cv, x + xx, y, color)
            set_pixel(cv, x + xx, y + h - 1, color)
        }
        cycle (forge yy: stone = 0; yy < h; yy++) {
            set_pixel(cv, x, y + yy, color)
            set_pixel(cv, x + w - 1, y + yy, color)
        }
    }

    vein fill_rounded_rect(cv: Canvas, x: stone, y: stone, w: stone, h: stone, r: stone, color: stone) -> void {
        if (r <= 0) {
            fill_rect(cv, x, y, w, h, color)
            return
        }
        if (r * 2 > w) { r = w / 2 }
        if (r * 2 > h) { r = h / 2 }
        forge r2 = r * r
        cycle (forge yy: stone = 0; yy < h; yy++) {
            cycle (forge xx: stone = 0; xx < w; xx++) {
                forge inside = true
                if (xx < r && yy < r) {
                    forge dx = r - xx
                    forge dy = r - yy
                    if ((dx * dx + dy * dy) > r2) { inside = false }
                } else if (xx >= w - r && yy < r) {
                    forge dx2 = xx - (w - r - 1)
                    forge dy2 = r - yy
                    if ((dx2 * dx2 + dy2 * dy2) > r2) { inside = false }
                } else if (xx < r && yy >= h - r) {
                    forge dx3 = r - xx
                    forge dy3 = yy - (h - r - 1)
                    if ((dx3 * dx3 + dy3 * dy3) > r2) { inside = false }
                } else if (xx >= w - r && yy >= h - r) {
                    forge dx4 = xx - (w - r - 1)
                    forge dy4 = yy - (h - r - 1)
                    if ((dx4 * dx4 + dy4 * dy4) > r2) { inside = false }
                }
                if (inside) {
                    set_pixel(cv, x + xx, y + yy, color)
                }
            }
        }
    }

    vein draw_rounded_border(cv: Canvas, x: stone, y: stone, w: stone, h: stone, r: stone, color: stone) -> void {
        if (r <= 0) {
            draw_rect(cv, x, y, w, h, color)
            return
        }
        if (r * 2 > w) { r = w / 2 }
        if (r * 2 > h) { r = h / 2 }
        forge r2 = r * r
        forge r_inner2 = (r - 1) * (r - 1)
        cycle (forge yy: stone = 0; yy < h; yy++) {
            cycle (forge xx: stone = 0; xx < w; xx++) {
                forge edge = false
                if (xx < r && yy < r) {
                    forge dx = r - xx
                    forge dy = r - yy
                    forge dist2 = dx * dx + dy * dy
                    if (dist2 <= r2 && dist2 >= r_inner2) { edge = true }
                } else if (xx >= w - r && yy < r) {
                    forge dx2 = xx - (w - r - 1)
                    forge dy2 = r - yy
                    forge dist22 = dx2 * dx2 + dy2 * dy2
                    if (dist22 <= r2 && dist22 >= r_inner2) { edge = true }
                } else if (xx < r && yy >= h - r) {
                    forge dx3 = r - xx
                    forge dy3 = yy - (h - r - 1)
                    forge dist23 = dx3 * dx3 + dy3 * dy3
                    if (dist23 <= r2 && dist23 >= r_inner2) { edge = true }
                } else if (xx >= w - r && yy >= h - r) {
                    forge dx4 = xx - (w - r - 1)
                    forge dy4 = yy - (h - r - 1)
                    forge dist24 = dx4 * dx4 + dy4 * dy4
                    if (dist24 <= r2 && dist24 >= r_inner2) { edge = true }
                } else if (yy == 0 || yy == h - 1 || xx == 0 || xx == w - 1) {
                    edge = true
                }
                if (edge) {
                    set_pixel(cv, x + xx, y + yy, color)
                }
            }
        }
    }


    vein draw_glyph_row(cv: Canvas, x: stone, y: stone, row_bits: stone, color: stone) -> void {
        if (row_bits >= 16) { set_pixel(cv, x, y, color) row_bits = row_bits - 16 }
        if (row_bits >= 8) { set_pixel(cv, x + 1, y, color) row_bits = row_bits - 8 }
        if (row_bits >= 4) { set_pixel(cv, x + 2, y, color) row_bits = row_bits - 4 }
        if (row_bits >= 2) { set_pixel(cv, x + 3, y, color) row_bits = row_bits - 2 }
        if (row_bits >= 1) { set_pixel(cv, x + 4, y, color) }
    }

    vein draw_char(cv: Canvas, x: stone, y: stone, ch: stone, color: stone) -> void {
        if (ch == 32) {
            return
        }
        if (ch >= 97 && ch <= 122) {
            ch = ch - 32
        }

        forge r0 = 0
        forge r1 = 0
        forge r2 = 0
        forge r3 = 0
        forge r4 = 0
        forge r5 = 0
        forge r6 = 0

        if (ch == 65) { r0 = 14 r1 = 17 r2 = 17 r3 = 31 r4 = 17 r5 = 17 r6 = 17 }
        else if (ch == 66) { r0 = 30 r1 = 17 r2 = 17 r3 = 30 r4 = 17 r5 = 17 r6 = 30 }
        else if (ch == 67) { r0 = 14 r1 = 17 r2 = 16 r3 = 16 r4 = 16 r5 = 17 r6 = 14 }
        else if (ch == 68) { r0 = 28 r1 = 18 r2 = 17 r3 = 17 r4 = 17 r5 = 18 r6 = 28 }
        else if (ch == 69) { r0 = 31 r1 = 16 r2 = 16 r3 = 30 r4 = 16 r5 = 16 r6 = 31 }
        else if (ch == 70) { r0 = 31 r1 = 16 r2 = 16 r3 = 30 r4 = 16 r5 = 16 r6 = 16 }
        else if (ch == 71) { r0 = 14 r1 = 17 r2 = 16 r3 = 23 r4 = 17 r5 = 17 r6 = 14 }
        else if (ch == 72) { r0 = 17 r1 = 17 r2 = 17 r3 = 31 r4 = 17 r5 = 17 r6 = 17 }
        else if (ch == 73) { r0 = 14 r1 = 4 r2 = 4 r3 = 4 r4 = 4 r5 = 4 r6 = 14 }
        else if (ch == 74) { r0 = 7 r1 = 2 r2 = 2 r3 = 2 r4 = 18 r5 = 18 r6 = 12 }
        else if (ch == 75) { r0 = 17 r1 = 18 r2 = 20 r3 = 24 r4 = 20 r5 = 18 r6 = 17 }
        else if (ch == 76) { r0 = 16 r1 = 16 r2 = 16 r3 = 16 r4 = 16 r5 = 16 r6 = 31 }
        else if (ch == 77) { r0 = 17 r1 = 27 r2 = 21 r3 = 21 r4 = 17 r5 = 17 r6 = 17 }
        else if (ch == 78) { r0 = 17 r1 = 25 r2 = 21 r3 = 19 r4 = 17 r5 = 17 r6 = 17 }
        else if (ch == 79) { r0 = 14 r1 = 17 r2 = 17 r3 = 17 r4 = 17 r5 = 17 r6 = 14 }
        else if (ch == 80) { r0 = 30 r1 = 17 r2 = 17 r3 = 30 r4 = 16 r5 = 16 r6 = 16 }
        else if (ch == 81) { r0 = 14 r1 = 17 r2 = 17 r3 = 17 r4 = 21 r5 = 18 r6 = 13 }
        else if (ch == 82) { r0 = 30 r1 = 17 r2 = 17 r3 = 30 r4 = 20 r5 = 18 r6 = 17 }
        else if (ch == 83) { r0 = 14 r1 = 17 r2 = 16 r3 = 14 r4 = 1 r5 = 17 r6 = 14 }
        else if (ch == 84) { r0 = 31 r1 = 4 r2 = 4 r3 = 4 r4 = 4 r5 = 4 r6 = 4 }
        else if (ch == 85) { r0 = 17 r1 = 17 r2 = 17 r3 = 17 r4 = 17 r5 = 17 r6 = 14 }
        else if (ch == 86) { r0 = 17 r1 = 17 r2 = 17 r3 = 17 r4 = 17 r5 = 10 r6 = 4 }
        else if (ch == 87) { r0 = 17 r1 = 17 r2 = 17 r3 = 21 r4 = 21 r5 = 27 r6 = 17 }
        else if (ch == 88) { r0 = 17 r1 = 17 r2 = 10 r3 = 4 r4 = 10 r5 = 17 r6 = 17 }
        else if (ch == 89) { r0 = 17 r1 = 17 r2 = 10 r3 = 4 r4 = 4 r5 = 4 r6 = 4 }
        else if (ch == 90) { r0 = 31 r1 = 1 r2 = 2 r3 = 4 r4 = 8 r5 = 16 r6 = 31 }
        else if (ch == 48) { r0 = 14 r1 = 17 r2 = 19 r3 = 21 r4 = 25 r5 = 17 r6 = 14 }
        else if (ch == 49) { r0 = 4 r1 = 12 r2 = 4 r3 = 4 r4 = 4 r5 = 4 r6 = 14 }
        else if (ch == 50) { r0 = 14 r1 = 17 r2 = 1 r3 = 6 r4 = 8 r5 = 16 r6 = 31 }
        else if (ch == 51) { r0 = 31 r1 = 2 r2 = 4 r3 = 2 r4 = 1 r5 = 17 r6 = 14 }
        else if (ch == 52) { r0 = 2 r1 = 6 r2 = 10 r3 = 18 r4 = 31 r5 = 2 r6 = 2 }
        else if (ch == 53) { r0 = 31 r1 = 16 r2 = 30 r3 = 1 r4 = 1 r5 = 17 r6 = 14 }
        else if (ch == 54) { r0 = 6 r1 = 8 r2 = 16 r3 = 30 r4 = 17 r5 = 17 r6 = 14 }
        else if (ch == 55) { r0 = 31 r1 = 1 r2 = 2 r3 = 4 r4 = 4 r5 = 4 r6 = 4 }
        else if (ch == 56) { r0 = 14 r1 = 17 r2 = 17 r3 = 14 r4 = 17 r5 = 17 r6 = 14 }
        else if (ch == 57) { r0 = 14 r1 = 17 r2 = 17 r3 = 15 r4 = 1 r5 = 2 r6 = 12 }
        else if (ch == 58) { r0 = 0 r1 = 4 r2 = 4 r3 = 0 r4 = 4 r5 = 4 r6 = 0 }
        else if (ch == 47) { r0 = 1 r1 = 2 r2 = 4 r3 = 8 r4 = 16 r5 = 0 r6 = 0 }
        else if (ch == 46) { r0 = 0 r1 = 0 r2 = 0 r3 = 0 r4 = 0 r5 = 6 r6 = 6 }
        else if (ch == 45) { r0 = 0 r1 = 0 r2 = 0 r3 = 31 r4 = 0 r5 = 0 r6 = 0 }
        else if (ch == 95) { r0 = 0 r1 = 0 r2 = 0 r3 = 0 r4 = 0 r5 = 0 r6 = 31 }
        else if (ch == 40) { r0 = 2 r1 = 4 r2 = 4 r3 = 4 r4 = 4 r5 = 4 r6 = 2 }
        else if (ch == 41) { r0 = 8 r1 = 4 r2 = 4 r3 = 4 r4 = 4 r5 = 4 r6 = 8 }
        else if (ch == 91) { r0 = 14 r1 = 8 r2 = 8 r3 = 8 r4 = 8 r5 = 8 r6 = 14 }
        else if (ch == 93) { r0 = 14 r1 = 2 r2 = 2 r3 = 2 r4 = 2 r5 = 2 r6 = 14 }
        else if (ch == 123) { r0 = 6 r1 = 4 r2 = 4 r3 = 8 r4 = 4 r5 = 4 r6 = 6 }
        else if (ch == 125) { r0 = 12 r1 = 4 r2 = 4 r3 = 2 r4 = 4 r5 = 4 r6 = 12 }
        else if (ch == 34) { r0 = 10 r1 = 10 r2 = 10 r3 = 0 r4 = 0 r5 = 0 r6 = 0 }
        else if (ch == 39) { r0 = 4 r1 = 4 r2 = 4 r3 = 0 r4 = 0 r5 = 0 r6 = 0 }
        else if (ch == 61) { r0 = 0 r1 = 0 r2 = 31 r3 = 0 r4 = 31 r5 = 0 r6 = 0 }
        else if (ch == 60) { r0 = 2 r1 = 4 r2 = 8 r3 = 16 r4 = 8 r5 = 4 r6 = 2 }
        else if (ch == 62) { r0 = 8 r1 = 4 r2 = 2 r3 = 1 r4 = 2 r5 = 4 r6 = 8 }
        else if (ch == 42) { r0 = 0 r1 = 10 r2 = 4 r3 = 31 r4 = 4 r5 = 10 r6 = 0 }
        else if (ch == 33) { r0 = 4 r1 = 4 r2 = 4 r3 = 4 r4 = 0 r5 = 4 r6 = 0 }
        else if (ch == 44) { r0 = 0 r1 = 0 r2 = 0 r3 = 0 r4 = 0 r5 = 4 r6 = 8 }
        else if (ch == 59) { r0 = 0 r1 = 4 r2 = 0 r3 = 0 r4 = 4 r5 = 4 r6 = 8 }
        else if (ch == 43) { r0 = 0 r1 = 4 r2 = 4 r3 = 31 r4 = 4 r5 = 4 r6 = 0 }
        else { r0 = 31 r1 = 17 r2 = 17 r3 = 17 r4 = 17 r5 = 17 r6 = 31 }

        draw_glyph_row(cv, x, y, r0, color)
        draw_glyph_row(cv, x, y + 1, r1, color)
        draw_glyph_row(cv, x, y + 2, r2, color)
        draw_glyph_row(cv, x, y + 3, r3, color)
        draw_glyph_row(cv, x, y + 4, r4, color)
        draw_glyph_row(cv, x, y + 5, r5, color)
        draw_glyph_row(cv, x, y + 6, r6, color)
    }

    vein draw_text(cv: Canvas, x: stone, y: stone, text: obsidian, color: stone) -> void {
        forge len = ofs_str_len(text)
        forge cx = x
        forge i = 0
        while (i < len) {
            forge ch = ofs_str_char_at(text, i)
            if (ch == 10) {
                cx = x
                y = y + 10
            } else {
                draw_char(cv, cx, y, ch, color)
                cx = cx + 7
            }
            i++
        }
    }

    vein save_ppm(cv: Canvas, path: obsidian) -> bool {
        forge f = fopen(path, "wb")
        if (f == null) { return false }
        forge header = "P6\n" + ofs_stone_to_obsidian(cv.width) + " " + ofs_stone_to_obsidian(cv.height) + "\n255\n"
        fputs(header, f)
        forge total = cv.width * cv.height
        forge i = 0
        forge col = 0
        forge r = 0
        forge g = 0
        forge b = 0
        while (i < total) {
            col = bedrock_region_read(cv.buffer, i)
            r = (col / 65536) % 256
            g = (col / 256) % 256
            b = col % 256
            fputc(r, f)
            fputc(g, f)
            fputc(b, f)
            i++
        }
        fclose(f)
        return true
    }

    vein present(cv: Canvas) -> void {
        ofs_window_present_pixels(cv.buffer)
    }
}