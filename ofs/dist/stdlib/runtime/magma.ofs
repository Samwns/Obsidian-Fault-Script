rift vein _ofs_runtime_pow(base: crystal, exp: crystal) -> crystal bind "pow" abi c
rift vein _ofs_runtime_sqrt(value: crystal) -> crystal bind "sqrt" abi c

vein ofs_pow(base: crystal, exp: crystal) -> crystal {
	return _ofs_runtime_pow(base, exp)
}

vein ofs_sqrt(value: crystal) -> crystal {
	return _ofs_runtime_sqrt(value)
}
