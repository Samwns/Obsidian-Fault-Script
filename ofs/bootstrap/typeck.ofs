// OFS Compiler — Type Checker
// Symbol table, scope management, and type validation

attach {F:symbols.ofs}
attach {F:ast.ofs}

namespace typeck {
    // ── Scope Stack ──────────────────────────────────────────────────
    
    forge _symbols: Array<Symbol> = []
    forge _symbol_depths: Array<stone> = []
    forge _scope_depth: stone = 0
    forge _field_owners: Array<obsidian> = []
    forge _field_names: Array<obsidian> = []
    forge _field_types: Array<obsidian> = []
    
    vein push_scope() -> void {
        _scope_depth++
    }
    
    vein pop_scope() -> void {
        forge len = ofs_array_len(_symbols)
        while (len > 0) {
            forge depth = ofs_array_get(_symbol_depths, len - 1)
            if (depth < _scope_depth) {
                break
            }
            ofs_array_pop(_symbols)
            ofs_array_pop(_symbol_depths)
            len = ofs_array_len(_symbols)
        }
        if (_scope_depth > 0) {
            _scope_depth--
        }
    }
    
    vein declare(sym: Symbol) -> void {
        ofs_array_push(_symbols, sym)
        ofs_array_push(_symbol_depths, _scope_depth)
    }
    
    vein resolve(name: obsidian) -> Symbol {
        forge i = ofs_array_len(_symbols) - 1

        while (i >= 0) {
            forge sym: Symbol = ofs_array_get(_symbols, i)
            if (ofs_str_eq(sym.name, name)) {
                return sym
            }
            i--
        }
        
        forge dummy: Symbol
        dummy.name = ""
        dummy.type_str = "unknown"
        dummy.kind = SYM_UNKNOWN
        return dummy
    }

    vein type_node_name(id: stone) -> obsidian {
        if (id < 0) { return "void" }
        forge t: Node = node_get(id)
        if (t.kind == NK_TYPE_ARRAY) { return "Array" }
        return t.val
    }

    vein register_field(owner: obsidian, name: obsidian, type_str: obsidian) -> void {
        ofs_array_push(_field_owners, owner)
        ofs_array_push(_field_names, name)
        ofs_array_push(_field_types, type_str)
    }

    vein field_type(owner: obsidian, name: obsidian) -> obsidian {
        forge i = ofs_array_len(_field_names) - 1
        while (i >= 0) {
            forge f_owner: obsidian = ofs_array_get(_field_owners, i)
            forge f_name: obsidian = ofs_array_get(_field_names, i)
            if (ofs_str_eq(f_owner, owner) && ofs_str_eq(f_name, name)) {
                return ofs_array_get(_field_types, i)
            }
            i--
        }
        return "unknown"
    }
    
    // ── Type Checking Core ───────────────────────────────────────────
    
    vein check_type_string(type_str: obsidian) -> bool {
        if (ofs_str_eq(type_str, "stone")) { return true }
        if (ofs_str_eq(type_str, "crystal")) { return true }
        if (ofs_str_eq(type_str, "obsidian")) { return true }
        if (ofs_str_eq(type_str, "bool")) { return true }
        if (ofs_str_eq(type_str, "void")) { return true }
        if (ofs_str_eq(type_str, "Array")) { return true }
        if (ofs_str_eq(type_str, "u8")) { return true }
        if (ofs_str_eq(type_str, "u16")) { return true }
        if (ofs_str_eq(type_str, "u32")) { return true }
        if (ofs_str_eq(type_str, "u64")) { return true }
        if (ofs_str_eq(type_str, "i8")) { return true }
        if (ofs_str_eq(type_str, "i32")) { return true }
        return false
    }
    
    vein check_type_compat(from: obsidian, to: obsidian) -> bool {
        if (ofs_str_eq(from, to)) { return true }
        if (ofs_str_eq(to, "stone") && ofs_str_eq(from, "i32")) { return true }
        return false
    }
    
    vein check_node(id: stone) -> obsidian {
        if (id < 0) { return "void" }
        
        forge n: Node = node_get(id)
        
        if (n.kind == NK_LIT_INT) {
            node_set_type(id, "stone")
            return "stone"
        }
        
        if (n.kind == NK_LIT_FLOAT) {
            node_set_type(id, "crystal")
            return "crystal"
        }
        
        if (n.kind == NK_LIT_STRING) {
            node_set_type(id, "obsidian")
            return "obsidian"
        }
        
        if (n.kind == NK_LIT_BOOL) {
            node_set_type(id, "bool")
            return "bool"
        }
        
        if (n.kind == NK_LIT_NULL) {
            node_set_type(id, "null")
            return "null"
        }
        
        if (n.kind == NK_IDENT) {
            forge sym: Symbol = resolve(n.val)
            if (ofs_str_eq(sym.name, "")) {
                echo("[typeck warn " + ofs_stone_to_obsidian(n.line) + ":" + ofs_stone_to_obsidian(n.col) + "] unknown identifier '" + n.val + "'")
                return "unknown"
            }
            node_set_type(id, sym.type_str)
            return sym.type_str
        }
        
        if (n.kind == NK_BIN_OP) {
            forge left_type = check_node(n.c0)
            forge right_type = check_node(n.c1)
            
            if (ofs_str_eq(n.val, "+") || ofs_str_eq(n.val, "-") ||
                ofs_str_eq(n.val, "*") || ofs_str_eq(n.val, "/")) {
                if (ofs_str_eq(n.val, "+") && (ofs_str_eq(left_type, "obsidian") || ofs_str_eq(right_type, "obsidian"))) {
                    node_set_type(id, "obsidian")
                    return "obsidian"
                }
                if (!check_type_compat(left_type, right_type)) {
                    echo("[typeck warn] type mismatch in " + n.val)
                }
                node_set_type(id, left_type)
                return left_type
            }
            
            if (ofs_str_eq(n.val, "==") || ofs_str_eq(n.val, "!=") ||
                ofs_str_eq(n.val, "<") || ofs_str_eq(n.val, "<=") ||
                ofs_str_eq(n.val, ">") || ofs_str_eq(n.val, ">=")) {
                node_set_type(id, "bool")
                return "bool"
            }
            
            if (ofs_str_eq(n.val, "&&") || ofs_str_eq(n.val, "||")) {
                node_set_type(id, "bool")
                return "bool"
            }
            
            node_set_type(id, left_type)
            return left_type
        }

        if (n.kind == NK_FIELD) {
            forge base_type = check_node(n.c0)
            forge ft = field_type(base_type, n.val)
            node_set_type(id, ft)
            return ft
        }

        if (n.kind == NK_INDEX) {
            check_node(n.c0)
            check_node(n.c1)
            node_set_type(id, "stone")
            return "stone"
        }

        if (n.kind == NK_CAST) {
            check_node(n.c0)
            node_set_type(id, n.val)
            return n.val
        }

        if (n.kind == NK_ASSIGN) {
            forge target_type = check_node(n.c0)
            check_node(n.c1)
            node_set_type(id, target_type)
            return target_type
        }
        
        if (n.kind == NK_UNARY_OP) {
            forge operand_type = check_node(n.c0)
            if (ofs_str_eq(n.val, "&")) {
                node_set_type(id, "*" + operand_type)
                return "*" + operand_type
            }
            if (ofs_str_eq(n.val, "*")) {
                if (ofs_str_len(operand_type) > 1 && ofs_str_eq(ofs_str_substr(operand_type, 0, 1), "*")) {
                    forge inner = ofs_str_substr(operand_type, 1, ofs_str_len(operand_type) - 1)
                    node_set_type(id, inner)
                    return inner
                }
            }
            node_set_type(id, operand_type)
            return operand_type
        }
        
        if (n.kind == NK_CALL) {
            forge i = 0
            while (i < node_extra_len(id)) {
                forge arg_id = node_get_extra(id, i)
                check_node(arg_id)
                i++
            }
            forge fn_sym: Symbol = resolve(n.val)
            if (!ofs_str_eq(fn_sym.name, "")) {
                node_set_type(id, fn_sym.type_str)
                return fn_sym.type_str
            }
            node_set_type(id, "unknown")
            return "unknown"
        }
        
        if (n.kind == NK_VAR_DECL || n.kind == NK_CONST_DECL) {
            // Get type from annotation
            forge type_node_id = n.c0
            forge init_id = n.c1
            forge type_str = "unknown"
            
            if (type_node_id >= 0) {
                type_str = type_node_name(type_node_id)
                if (init_id >= 0) {
                    check_node(init_id)
                }
            } else if (init_id >= 0) {
                // Infer from initializer
                type_str = check_node(init_id)
            }
            
            // Declare symbol
            forge sym: Symbol
            sym.name = n.val
            sym.type_str = type_str
            sym.kind = SYM_VAR
            if (n.kind == NK_CONST_DECL) {
                sym.kind = SYM_CONST
            }
            declare(sym)
            
            node_set_type(id, type_str)
            return type_str
        }
        
        if (n.kind == NK_RETURN) {
            if (n.c0 >= 0) {
                return check_node(n.c0)
            }
            return "void"
        }
        
        if (n.kind == NK_IF) {
            check_node(n.c0)  // condition
            push_scope()
            check_node(n.c1)  // then block
            pop_scope()
            if (n.c2 >= 0) {
                push_scope()
                check_node(n.c2)  // else block
                pop_scope()
            }
            return "void"
        }
        
        if (n.kind == NK_WHILE) {
            check_node(n.c0)  // condition
            push_scope()
            check_node(n.c1)  // body
            pop_scope()
            return "void"
        }

        if (n.kind == NK_CYCLE_C) {
            push_scope()
            if (n.c0 >= 0) { check_node(n.c0) }
            if (n.c1 >= 0) { check_node(n.c1) }
            if (n.c3 >= 0) { check_node(n.c3) }
            if (n.c2 >= 0) { check_node(n.c2) }
            pop_scope()
            return "void"
        }

        if (n.kind == NK_CYCLE_RANGE) {
            check_node(n.c0)
            push_scope()
            forge sym: Symbol
            sym.name = n.val
            sym.type_str = "stone"
            sym.kind = SYM_VAR
            declare(sym)
            if (n.c1 >= 0) { check_node(n.c1) }
            pop_scope()
            return "void"
        }
        
        if (n.kind == NK_BLOCK) {
            forge i = 0
            while (i < node_extra_len(id)) {
                forge stmt_id = node_get_extra(id, i)
                check_node(stmt_id)
                i++
            }
            return "void"
        }

        if (n.kind == NK_TREMOR) {
            push_scope()
            if (n.c0 >= 0) { check_node(n.c0) }
            pop_scope()

            if (n.c2 >= 0) {
                push_scope()
                if (n.c1 >= 0) {
                    forge cident: Node = node_get(n.c1)
                    forge csym: Symbol
                    csym.name = cident.val
                    csym.type_str = "obsidian"
                    csym.kind = SYM_VAR
                    declare(csym)
                }
                check_node(n.c2)
                pop_scope()
            }
            return "void"
        }
        
        if (n.kind == NK_FN_DECL || n.kind == NK_CORE_DECL) {
            push_scope()
            
            // Check parameters
            forge params_id = n.c0
            if (params_id >= 0) {
                forge i = 0
                while (i < node_extra_len(params_id)) {
                    forge param_id = node_get_extra(params_id, i)
                    forge param: Node = node_get(param_id)
                    forge param_type_id = param.c0
                    forge param_type_str = "unknown"
                    if (param_type_id >= 0) {
                        param_type_str = type_node_name(param_type_id)
                    }
                    forge sym: Symbol
                    sym.name = param.val
                    sym.type_str = param_type_str
                    sym.kind = SYM_PARAM
                    declare(sym)
                    i++
                }
            }
            
            // Check body
            forge body_id = n.c2
            if (body_id >= 0) {
                check_node(body_id)
            }
            
            pop_scope()
            return "void"
        }

        if (n.kind == NK_MONOLITH) {
            forge type_sym: Symbol
            type_sym.name = n.val
            type_sym.type_str = n.val
            type_sym.kind = SYM_MONOLITH
            declare(type_sym)

            forge i = 0
            while (i < node_extra_len(id)) {
                forge field_id = node_get_extra(id, i)
                forge field: Node = node_get(field_id)
                if (field.c0 >= 0) {
                    forge field_type_str = type_node_name(field.c0)
                    register_field(n.val, field.val, field_type_str)
                    if (!check_type_string(field_type_str)) {
                        echo("[typeck warn] unknown field type '" + field_type_str + "' in monolith " + n.val)
                    }
                }
                i++
            }
            return "void"
        }

        if (n.kind == NK_IMPL) {
            forge i = 0
            while (i < node_extra_len(id)) {
                forge method_id = node_get_extra(id, i)
                check_node(method_id)
                i++
            }
            return "void"
        }

        if (n.kind == NK_NAMESPACE) {
            push_scope()
            forge i = 0
            while (i < node_extra_len(id)) {
                forge member_id = node_get_extra(id, i)
                check_node(member_id)
                i++
            }
            pop_scope()
            return "void"
        }

        if (n.kind == NK_STRATA) {
            forge type_sym: Symbol
            type_sym.name = n.val
            type_sym.type_str = n.val
            type_sym.kind = SYM_MONOLITH
            declare(type_sym)
            return "void"
        }

        if (n.kind == NK_ATTACH) {
            return "void"
        }
        
        if (n.kind == NK_PROGRAM) {
            // predeclare top-level functions for call resolution
            forge d = 0
            while (d < node_extra_len(id)) {
                forge decl_id = node_get_extra(id, d)
                forge decl: Node = node_get(decl_id)
                if (decl.kind == NK_FN_DECL || decl.kind == NK_CORE_DECL) {
                    forge fn_sym: Symbol
                    fn_sym.name = decl.val
                    fn_sym.type_str = "unknown"
                    if (decl.c1 >= 0) {
                        fn_sym.type_str = type_node_name(decl.c1)
                    }
                    fn_sym.kind = SYM_FN
                    declare(fn_sym)
                } else if (decl.kind == NK_EXTERN_VN || decl.kind == NK_RIFT_VN) {
                    forge ext_sym: Symbol
                    ext_sym.name = decl.val
                    ext_sym.type_str = "unknown"
                    if (decl.c1 >= 0) {
                        ext_sym.type_str = type_node_name(decl.c1)
                    }
                    ext_sym.kind = SYM_FN
                    declare(ext_sym)
                } else if (decl.kind == NK_NAMESPACE || decl.kind == NK_IMPL) {
                    forge j = 0
                    while (j < node_extra_len(decl_id)) {
                        forge member_id = node_get_extra(decl_id, j)
                        forge member: Node = node_get(member_id)
                        if (member.kind == NK_FN_DECL || member.kind == NK_CORE_DECL || member.kind == NK_EXTERN_VN || member.kind == NK_RIFT_VN) {
                            forge member_sym: Symbol
                            member_sym.name = member.val
                            member_sym.type_str = "unknown"
                            if (member.c1 >= 0) {
                                member_sym.type_str = type_node_name(member.c1)
                            }
                            member_sym.kind = SYM_FN
                            declare(member_sym)
                        }
                        j++
                    }
                }
                d++
            }

            forge i = 0
            while (i < node_extra_len(id)) {
                forge decl_id = node_get_extra(id, i)
                check_node(decl_id)
                i++
            }
            return "void"
        }
        
        return "unknown"
    }
    
    vein check(root_id: stone) -> void {
        push_scope()
        check_node(root_id)
        pop_scope()
    }
}
