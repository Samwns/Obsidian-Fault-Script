// OFS Compiler — Type Checker
// Symbol table, scope management, and type validation

attach {F:symbols.ofs}
attach {F:ast.ofs}

namespace typeck {
    // ── Scope Stack ──────────────────────────────────────────────────
    
    forge _symbols: Array<Symbol> = []
    forge _symbol_depths: Array<stone> = []
    forge _scope_depth: stone = 0
    forge _field_owners: Array<obsidian> = []
    forge _field_names: Array<obsidian> = []
    forge _field_types: Array<obsidian> = []
    forge _anchor_depth: stone = 0
    // F4: profundidade de blocos de baixo nivel. `fracture`/`bedrock`/
    // `tectonic` liberam ponteiros; `abyss` libera tudo (fault_call/addr).
    forge _fracture_depth: stone = 0
    forge _abyss_depth: stone = 0
    forge _fault_strict: stone = -1
    forge _fault_warnings: stone = 0
    // A5.4: usos de baixo nivel sem `claim` (avisos) e os pares
    // modulo*8+bit ja avisados (uma mensagem por modulo e permissao);
    // pilha dos blocos de baixo nivel (1 = conta na profundidade, 0 = nao:
    // `bedrock` num arquivo `stratum crust` e so arena)
    forge _perm_uses: stone = 0
    forge _perm_seen: Array<stone> = []
    forge _fb_counted: Array<stone> = []
    forge _semantic_errors: stone = 0
    forge _check_visits: stone = 0
    // F3: tipos nomeados conhecidos e o retorno da vein em verificacao
    forge _strata_types: Array<obsidian> = []
    forge _mono_types: Array<obsidian> = []
    forge _cur_ret: obsidian = "unknown"

    // Classes de tipo usadas pelas regras de operacao e conversao (F3).
    // TY_UNK = o typeck nao sabe (builtin sem assinatura, expressao sem
    // tipo): nunca gera erro nem conversao.
    forge TY_UNK: stone = 0
    forge TY_INT: stone = 1
    forge TY_FLT: stone = 2
    forge TY_BOOL: stone = 3
    forge TY_STR: stone = 4
    forge TY_PTR: stone = 5
    forge TY_NULL: stone = 6
    forge TY_VAR: stone = 7
    forge TY_ARR: stone = 8
    forge TY_OBJ: stone = 9
    forge TY_VOID: stone = 10
    // F6: valor de vein, tipo `vein(T1,T2)->R` (texto canonico, ast.ofs)
    forge TY_FN: stone = 11
    // `extern`/`rift` de simbolo C variadico (printf...): nao vira valor
    forge _variadic_fns: Array<obsidian> = []
    // veins com parametros de valor padrao (onda 4): nome -> declaracao
    forge _dflt_names: Array<obsidian> = []
    forge _dflt_decls: Array<stone> = []
    // geode (closures): profundidade de escopo dos parametros da vein em
    // verificacao (simbolos de profundidade >= _fn_base sao locais dela), a
    // pilha de geodes abertos (profundidade dos parametros de cada um) e as
    // capturas achadas (por posicao na pilha). O corpo de cada geode vira
    // uma vein `__geode_<vein>_<k>` no fim do programa (_root_id), com as
    // capturas como primeiros parametros.
    forge _fn_base: stone = 1099511627776
    forge _fn_owner: obsidian = "global"
    forge _geode_k: stone = 0
    forge _gd_base: Array<stone> = []
    forge _cap_gd: Array<stone> = []
    forge _cap_name: Array<obsidian> = []
    forge _cap_type: Array<obsidian> = []
    forge _root_id: stone = -1
    forge _loop_depth: stone = 0
    
    vein push_scope() -> void {
        _scope_depth++
    }
    
    vein pop_scope() -> void {
        forge len = ofs_array_len(_symbols)
        while (len > 0) {
            forge depth = ofs_array_get(_symbol_depths, len - 1)
            if (depth < _scope_depth) {
                break
            }
            ofs_array_pop(_symbols)
            ofs_array_pop(_symbol_depths)
            len = ofs_array_len(_symbols)
        }
        if (_scope_depth > 0) {
            _scope_depth--
        }
    }
    
    vein declare(sym: Symbol) -> void {
        if (sym.param_types == null) { sym.param_types = "" }
        ofs_array_push(_symbols, sym)
        ofs_array_push(_symbol_depths, _scope_depth)
    }
    
    vein resolve(name: obsidian) -> Symbol {
        forge i = ofs_array_len(_symbols) - 1

        while (i >= 0) {
            forge sym: Symbol = ofs_array_get(_symbols, i)
            if (ofs_str_eq(sym.name, name)) {
                return sym
            }
            i--
        }
        
        forge dummy: Symbol
        dummy.name = ""
        dummy.type_str = "unknown"
        dummy.kind = SYM_UNKNOWN
        dummy.param_types = ""
        return dummy
    }

    // posicao do simbolo visivel com esse nome (-1 se nenhum)
    vein resolve_index(name: obsidian) -> stone {
        forge i = ofs_array_len(_symbols) - 1
        while (i >= 0) {
            forge sym: Symbol = ofs_array_get(_symbols, i)
            if (ofs_str_eq(sym.name, name)) { return i }
            i--
        }
        return -1
    }

    // ── geode (closures) ─────────────────────────────────────────────
    vein geode_error(n: Node, msg: obsidian, hint: obsidian) -> void {
        _semantic_errors++
        echo("[ERRO DE GEODE " + ast_src_loc(n.line, n.col) + "]: " + msg)
        if (!ofs_str_eq(hint, "")) { echo("  dica: " + hint) }
    }

    // profundidade de um simbolo local da vein em verificacao (-1 se nao e
    // variavel/parametro local: global, vein, monolith)
    vein local_depth(name: obsidian) -> stone {
        forge si = resolve_index(name)
        if (si < 0) { return -1 }
        forge sym: Symbol = ofs_array_get(_symbols, si)
        if (sym.kind != SYM_VAR && sym.kind != SYM_PARAM && sym.kind != SYM_CONST) { return -1 }
        forge d: stone = ofs_array_get(_symbol_depths, si)
        if (d < _fn_base) { return -1 }
        return d
    }

    // identificador lido dentro de geode(s): variavel de fora de cada geode
    // aberto que esta abaixo dele vira captura desse geode
    vein note_capture(name: obsidian, t: obsidian) -> void {
        forge g = ofs_array_len(_gd_base) - 1
        if (g < 0) { return }
        forge d = local_depth(name)
        if (d < 0) { return }
        while (g >= 0) {
            forge base: stone = ofs_array_get(_gd_base, g)
            if (d >= base) { return }
            forge seen = false
            forge ci = 0
            while (ci < ofs_array_len(_cap_gd)) {
                forge cg: stone = ofs_array_get(_cap_gd, ci)
                forge cn: obsidian = ofs_array_get(_cap_name, ci)
                if (cg == g && ofs_str_eq(cn, name)) { seen = true }
                ci++
            }
            if (!seen) {
                ofs_array_push(_cap_gd, g)
                ofs_array_push(_cap_name, name)
                ofs_array_push(_cap_type, t)
            }
            g--
        }
    }

    // atribuir a uma captura dentro do geode: erro (a captura e uma copia)
    vein check_capture_store(target_id: stone, what: obsidian) -> void {
        forge g = ofs_array_len(_gd_base) - 1
        if (g < 0 || target_id < 0) { return }
        if (node_kind_of(target_id) != NK_IDENT) { return }
        forge nm = node_val_of(target_id)
        forge d = local_depth(nm)
        if (d < 0) { return }
        forge base: stone = ofs_array_get(_gd_base, g)
        if (d >= base) { return }
        geode_error(node_get(target_id), "'" + nm + "' foi capturada por valor pelo geode: " + what + " aqui nao muda a variavel de fora",
            "use uma copia local (forge v = " + nm + "), ou devolva o valor novo e atribua fora do geode")
    }

    // no de tipo a partir do texto canonico (parametro da vein do geode)
    vein make_type_node(t: obsidian, line: stone, col: stone) -> stone {
        forge tl = ofs_str_len(t)
        if (tl > 7 && ofs_str_eq(ofs_str_substr(t, 0, 6), "Array<") && ofs_str_char_at(t, tl - 1) == 62) {
            forge an = node_new(NK_TYPE_ARRAY, "Array", line, col)
            node_set_child(an, 0, make_type_node(ofs_str_substr(t, 6, tl - 7), line, col))
            return an
        }
        if (vein_type_is(t)) {
            forge fnn = node_new(NK_TYPE_FN, t, line, col)
            forge pl = vein_type_params(t)
            forge pi = 0
            while (pi < type_list_len(pl)) {
                node_add_extra(fnn, make_type_node(type_list_at(pl, pi), line, col))
                pi++
            }
            forge rt = vein_type_ret(t)
            if (!ofs_str_eq(rt, "void")) { node_set_child(fnn, 1, make_type_node(rt, line, col)) }
            return fnn
        }
        return node_new(NK_TYPE, t, line, col)
    }

    // `geode (params) -> R { corpo }`: confere o corpo no escopo de quem o
    // cria (as variaveis de fora que ele le viram capturas), tira o corpo
    // para a vein `__geode_<vein>_<k>(capturas..., params...)` no fim do
    // programa e deixa no NK_LAMBDA: val = nome dessa vein, extra = as
    // capturas (NK_IDENT, na ordem), c0..c3 = -1. Tipo: vein(params)->R.
    vein check_geode(id: stone) -> obsidian {
        forge n: Node = node_get(id)
        forge gi = ofs_array_len(_gd_base)
        push_scope()
        ofs_array_push(_gd_base, _scope_depth)
        forge plist = ""
        forge params_id = n.c0
        forge pc = 0
        if (params_id >= 0) {
            while (pc < node_extra_len(params_id)) {
                forge pid = node_extra_at(params_id, pc)
                forge ptid = node_child(pid, 0)
                forge pts = "unknown"
                if (ptid >= 0) { pts = type_node_name(ptid) }
                if (pc > 0) { plist = plist + "," }
                plist = plist + pts
                forge psym: Symbol
                psym.name = node_val_of(pid)
                psym.type_str = pts
                psym.kind = SYM_PARAM
                declare(psym)
                pc++
            }
        }
        forge ret = "void"
        if (n.c1 >= 0) { ret = type_node_name(n.c1) }
        forge saved_ret = _cur_ret
        forge saved_anchor = _anchor_depth
        forge saved_loop = _loop_depth
        _cur_ret = ret
        _anchor_depth = 0
        _loop_depth = 0
        if (n.c2 >= 0) { check_node(n.c2) }
        _cur_ret = saved_ret
        _anchor_depth = saved_anchor
        _loop_depth = saved_loop
        ofs_array_pop(_gd_base)
        pop_scope()
        // capturas deste geode (as dos geodes de dentro ja sairam)
        forge cnames: Array<obsidian> = []
        forge ctypes: Array<obsidian> = []
        forge kg: Array<stone> = []
        forge kn: Array<obsidian> = []
        forge kt: Array<obsidian> = []
        forge ci = 0
        while (ci < ofs_array_len(_cap_gd)) {
            forge cg: stone = ofs_array_get(_cap_gd, ci)
            forge cn: obsidian = ofs_array_get(_cap_name, ci)
            forge ct: obsidian = ofs_array_get(_cap_type, ci)
            if (cg == gi) {
                ofs_array_push(cnames, cn)
                ofs_array_push(ctypes, ct)
            } else {
                ofs_array_push(kg, cg)
                ofs_array_push(kn, cn)
                ofs_array_push(kt, ct)
            }
            ci++
        }
        _cap_gd = kg
        _cap_name = kn
        _cap_type = kt
        // a vein do corpo
        forge gname = "__geode_" + _fn_owner + "_" + ofs_stone_to_obsidian(_geode_k)
        _geode_k++
        forge lp = node_new(NK_BLOCK, "", n.line, n.col)
        forge li = 0
        while (li < ofs_array_len(cnames)) {
            forge cpn = node_new(NK_PARAM, ofs_array_get(cnames, li), n.line, 0)
            node_set_child(cpn, 0, make_type_node(ofs_array_get(ctypes, li), n.line, n.col))
            node_add_extra(lp, cpn)
            li++
        }
        if (params_id >= 0) {
            forge oi = 0
            while (oi < node_extra_len(params_id)) {
                node_add_extra(lp, node_extra_at(params_id, oi))
                oi++
            }
        }
        forge decl = node_new(NK_FN_DECL, gname, n.line, n.col)
        node_set_child(decl, 0, lp)
        node_set_child(decl, 1, n.c1)
        node_set_child(decl, 2, n.c2)
        if (_root_id >= 0) { node_add_extra(_root_id, decl) }
        // o no do geode: nome da vein + capturas
        forge gn: Node = node_get(id)
        gn.val = gname
        gn.c0 = -1
        gn.c1 = -1
        gn.c2 = -1
        gn.c3 = -1
        forge caps: Array<stone> = []
        li = 0
        while (li < ofs_array_len(cnames)) {
            forge cid = node_new(NK_IDENT, ofs_array_get(cnames, li), n.line, n.col)
            node_set_type(cid, ofs_array_get(ctypes, li))
            ofs_array_push(caps, cid)
            li++
        }
        gn.extra = caps
        node_set(id, gn)
        forge gt = vein_type_make(plist, ret)
        node_set_type(id, gt)
        return gt
    }

    vein type_node_name(id: stone) -> obsidian {
        if (id < 0) { return "void" }
        forge t: Node = node_get(id)
        if (t.kind == NK_TYPE_ARRAY) {
            forge inner = "stone"
            if (t.c0 >= 0) {
                forge tn: Node = node_get(t.c0)
                inner = tn.val
            }
            return "Array<" + inner + ">"
        }
        return t.val
    }

    vein register_field(owner: obsidian, name: obsidian, type_str: obsidian) -> void {
        ofs_array_push(_field_owners, owner)
        ofs_array_push(_field_names, name)
        ofs_array_push(_field_types, type_str)
    }

    vein field_type(owner: obsidian, name: obsidian) -> obsidian {
        forge i = ofs_array_len(_field_names) - 1
        while (i >= 0) {
            forge f_owner: obsidian = ofs_array_get(_field_owners, i)
            forge f_name: obsidian = ofs_array_get(_field_names, i)
            if (ofs_str_eq(f_owner, owner) && ofs_str_eq(f_name, name)) {
                return ofs_array_get(_field_types, i)
            }
            i--
        }
        return "unknown"
    }
    
    // ── Type Checking Core ───────────────────────────────────────────
    
    vein check_type_string(type_str: obsidian) -> bool {
        if (ofs_str_len(type_str) > 0 && ofs_str_char_at(type_str, 0) == 42) { return true }
        if (vein_type_is(type_str)) { return true }
        if (ofs_str_eq(type_str, "stone")) { return true }
        if (ofs_str_eq(type_str, "crystal")) { return true }
        if (ofs_str_eq(type_str, "obsidian")) { return true }
        if (ofs_str_eq(type_str, "bool")) { return true }
        if (ofs_str_eq(type_str, "void")) { return true }
        if (ofs_str_eq(type_str, "Array")) { return true }
        // `Array<T>` (campo de monolith); antes gerava aviso falso
        if (ofs_str_len(type_str) > 6 && ofs_str_eq(ofs_str_substr(type_str, 0, 6), "Array<")) { return true }
        if (ofs_str_eq(type_str, "i16") || ofs_str_eq(type_str, "i64") || ofs_str_eq(type_str, "f32") || ofs_str_eq(type_str, "f64")) { return true }
        if (ofs_str_eq(type_str, "u8")) { return true }
        if (ofs_str_eq(type_str, "u16")) { return true }
        if (ofs_str_eq(type_str, "u32")) { return true }
        if (ofs_str_eq(type_str, "u64")) { return true }
        if (ofs_str_eq(type_str, "i8")) { return true }
        if (ofs_str_eq(type_str, "i32")) { return true }
        return false
    }

    vein is_int_type(t: obsidian) -> bool {
        if (ofs_str_eq(t, "stone") || ofs_str_eq(t, "u8") || ofs_str_eq(t, "u16") ||
            ofs_str_eq(t, "u32") || ofs_str_eq(t, "u64") || ofs_str_eq(t, "i8") || ofs_str_eq(t, "i32") ||
            ofs_str_eq(t, "i16") || ofs_str_eq(t, "i64")) {
            return true
        }
        return false
    }

    vein is_variant_name(name: obsidian) -> bool {
        // variant names are PascalCase (UpperCamel): start uppercase, contain a
        // lowercase letter, and have no underscores (excludes CONST_STYLE idents)
        if (ofs_str_len(name) < 2) { return false }
        forge c0 = ofs_str_char_at(name, 0)
        if (c0 < 65 || c0 > 90) { return false }
        forge has_lower = false
        forge i = 1
        while (i < ofs_str_len(name)) {
            forge c = ofs_str_char_at(name, i)
            if (c == 95) { return false }
            if (c >= 97 && c <= 122) { has_lower = true }
            i++
        }
        return has_lower
    }

    // ── Tipos e conversoes implicitas (F3) ────────────────────────────
    // O typeck decide o tipo final de cada expressao e materializa as
    // conversoes implicitas na propria arvore: um no NK_CAST (ou um literal
    // reescrito, ou uma chamada de conversao para texto). O llvmgen e o
    // interpretador so executam esses nos; nenhum dos dois converte por
    // conta propria. Regra completa: docs/LANGUAGE_REFERENCE.md, "Tipos".

    vein list_has(list: Array<obsidian>, v: obsidian) -> bool {
        forge i = 0
        forge cnt = ofs_array_len(list)
        while (i < cnt) {
            forge e: obsidian = ofs_array_get(list, i)
            if (ofs_str_eq(e, v)) { return true }
            i++
        }
        return false
    }

    vein is_float_type(t: obsidian) -> bool {
        return ofs_str_eq(t, "crystal") || ofs_str_eq(t, "f64")
    }

    vein ty_class(t: obsidian) -> stone {
        if (t == null) { return TY_UNK }
        forge tl = ofs_str_len(t)
        if (tl == 0) { return TY_UNK }
        if (ofs_str_char_at(t, 0) == 42) { return TY_PTR }
        if (vein_type_is(t)) { return TY_FN }
        if (is_int_type(t)) { return TY_INT }
        if (is_float_type(t)) { return TY_FLT }
        if (ofs_str_eq(t, "bool")) { return TY_BOOL }
        if (ofs_str_eq(t, "obsidian")) { return TY_STR }
        if (ofs_str_eq(t, "null")) { return TY_NULL }
        if (ofs_str_eq(t, "void")) { return TY_VOID }
        if (ofs_str_eq(t, "variant")) { return TY_VAR }
        if (ofs_str_eq(t, "Array")) { return TY_ARR }
        if (tl > 7 && ofs_str_eq(ofs_str_substr(t, 0, 6), "Array<")) { return TY_ARR }
        if (list_has(_strata_types, t)) { return TY_VAR }
        if (list_has(_mono_types, t)) { return TY_OBJ }
        return TY_UNK
    }

    // `Array<T>` -> T; "" se nao for um array com elemento declarado
    vein array_elem_of(t: obsidian) -> obsidian {
        if (t == null) { return "" }
        forge tl = ofs_str_len(t)
        if (tl < 8) { return "" }
        if (!ofs_str_eq(ofs_str_substr(t, 0, 6), "Array<")) { return "" }
        if (ofs_str_char_at(t, tl - 1) != 62) { return "" }
        return ofs_str_substr(t, 6, tl - 7)
    }

    vein type_error(n: Node, msg: obsidian, hint: obsidian) -> void {
        _semantic_errors++
        echo("[ERRO DE TIPO " + ast_src_loc(n.line, n.col) + "]: " + msg)
        if (!ofs_str_eq(hint, "")) { echo("  dica: " + hint) }
    }

    // tipos dos parametros de uma vein/extern, separados por ','
    // Parametro com valor padrao (onda 4): `b: stone = 3`. O padrao e um
    // literal (numero, texto, bool, null, ou -numero) e os parametros com
    // padrao ficam no fim; a chamada que omite os ultimos argumentos ganha
    // uma copia do literal (fill_defaults), entao o nativo e o interpretador
    // veem a chamada completa. A Fault Refract usa isso para aceitar um
    // parametro novo numa vein em uso (as chamadas antigas recebem o padrao).
    vein default_is_literal(d: stone) -> bool {
        forge k = node_kind_of(d)
        if (k == NK_LIT_INT || k == NK_LIT_FLOAT || k == NK_LIT_STRING || k == NK_LIT_BOOL || k == NK_LIT_NULL) { return true }
        if (k == NK_UNARY_OP && ofs_str_eq(node_val_of(d), "-")) {
            forge c = node_child(d, 0)
            return c >= 0 && (node_kind_of(c) == NK_LIT_INT || node_kind_of(c) == NK_LIT_FLOAT)
        }
        return false
    }

    vein note_defaults(decl_id: stone) -> void {
        forge params_id = node_child(decl_id, 0)
        if (params_id < 0) { return }
        forge any = false
        forge i = 0
        while (i < node_extra_len(params_id)) {
            forge pid = node_extra_at(params_id, i)
            forge d = node_child(pid, 1)
            forge pn: Node = node_get(pid)
            if (d >= 0) {
                any = true
                if (!default_is_literal(d)) {
                    _semantic_errors++
                    echo("[ERRO SEMANTICO " + ofs_stone_to_obsidian(pn.line) + ":" + ofs_stone_to_obsidian(pn.col) + "]: o valor padrao do parametro '" + pn.val + "' precisa ser um literal (numero, texto, bool ou null)")
                } else {
                    forge pt = "unknown"
                    if (node_child(pid, 0) >= 0) { pt = type_node_name(node_child(pid, 0)) }
                    check_node(d)
                    node_set_child(pid, 1, coerce_value(d, pt))
                }
            } else if (any) {
                _semantic_errors++
                echo("[ERRO SEMANTICO " + ofs_stone_to_obsidian(pn.line) + ":" + ofs_stone_to_obsidian(pn.col) + "]: o parametro '" + pn.val + "' vem depois de um parametro com valor padrao e tambem precisa de um")
            }
            i++
        }
        if (any) {
            ofs_array_push(_dflt_names, node_val_of(decl_id))
            ofs_array_push(_dflt_decls, decl_id)
        }
    }

    vein clone_literal(d: stone) -> stone {
        forge n: Node = node_get(d)
        forge c = node_new(n.kind, n.val, n.line, n.col)
        if (n.c0 >= 0) { node_set_child(c, 0, clone_literal(n.c0)) }
        return c
    }

    vein default_decl(name: obsidian) -> stone {
        forge di = ofs_array_len(_dflt_names) - 1
        while (di >= 0) {
            forge dn: obsidian = ofs_array_get(_dflt_names, di)
            if (ofs_str_eq(dn, name)) { return ofs_array_get(_dflt_decls, di) }
            di--
        }
        return -1
    }

    // os parametros de `from` em diante tem valor padrao?
    vein defaults_cover(name: obsidian, from: stone) -> bool {
        forge decl = default_decl(name)
        if (decl < 0) { return false }
        forge params_id = node_child(decl, 0)
        forge i = from
        while (i < node_extra_len(params_id)) {
            if (node_child(node_extra_at(params_id, i), 1) < 0) { return false }
            i++
        }
        return true
    }

    // chamada com menos argumentos: completa com os padroes dos ultimos
    vein fill_defaults(call_id: stone, name: obsidian) -> void {
        forge decl = default_decl(name)
        if (decl < 0) { return }
        forge params_id = node_child(decl, 0)
        forge np = node_extra_len(params_id)
        forge argc = node_extra_len(call_id)
        while (argc < np) {
            forge d = node_child(node_extra_at(params_id, argc), 1)
            if (d < 0) { return }
            forge c = clone_literal(d)
            check_node(c)
            node_add_extra(call_id, c)
            argc++
        }
    }

    vein param_types_of(decl_id: stone) -> obsidian {
        forge params_id = node_child(decl_id, 0)
        if (params_id < 0) { return "" }
        forge out = ""
        forge i = 0
        forge pc = node_extra_len(params_id)
        while (i < pc) {
            forge pid = node_extra_at(params_id, i)
            forge ptid = node_child(pid, 0)
            forge pt = "unknown"
            if (ptid >= 0) { pt = type_node_name(ptid) }
            if (i > 0) { out = out + "," }
            out = out + pt
            i++
        }
        return out
    }

    // i-esimo tipo de uma lista "a,b,c" ("" se nao existir); um parametro
    // pode ser um tipo de funcao com virgulas (ast.type_list_at)
    vein param_type_at(list: obsidian, idx: stone) -> obsidian {
        return type_list_at(list, idx)
    }

    vein set_extra_at(parent_id: stone, idx: stone, child_id: stone) -> void {
        forge pn: Node = node_get(parent_id)
        ofs_array_set(pn.extra, idx, child_id)
        node_set(parent_id, pn)
    }

    vein is_decimal_text(s: obsidian) -> bool {
        forge len = ofs_str_len(s)
        if (len == 0) { return false }
        forge i = 0
        while (i < len) {
            forge c = ofs_str_char_at(s, i)
            if (c < 48 || c > 57) { return false }
            i++
        }
        return true
    }

    // Conversao numerica explicita na arvore: `child as to_t`. Literal
    // inteiro decimal que vira crystal e reescrito no lugar (`1` -> `1.0`),
    // o que tambem serve de inicializador constante de global.
    vein wrap_cast(child_id: stone, to_t: obsidian) -> stone {
        forge cn: Node = node_get(child_id)
        if (is_float_type(to_t)) {
            if (cn.kind == NK_LIT_INT && is_decimal_text(cn.val)) {
                cn.kind = NK_LIT_FLOAT
                cn.val = cn.val + ".0"
                cn.type_str = "crystal"
                node_set(child_id, cn)
                return child_id
            }
            if (cn.kind == NK_UNARY_OP && ofs_str_eq(cn.val, "-") && cn.c0 >= 0) {
                forge inner: Node = node_get(cn.c0)
                if (inner.kind == NK_LIT_INT && is_decimal_text(inner.val)) {
                    inner.kind = NK_LIT_FLOAT
                    inner.val = inner.val + ".0"
                    inner.type_str = "crystal"
                    node_set(cn.c0, inner)
                    node_set_type(child_id, "crystal")
                    return child_id
                }
            }
        }
        forge cid = node_new(NK_CAST, to_t, cn.line, cn.col)
        node_set_child(cid, 0, child_id)
        node_set_type(cid, to_t)
        return cid
    }

    // Conversao para texto (concatenacao com obsidian): chamada explicita
    // de uma funcao do runtime, igual nos dois modos.
    vein wrap_text(child_id: stone, cls: stone) -> stone {
        forge fname = ""
        if (cls == TY_INT) { fname = "ofs_stone_to_obsidian" }
        if (cls == TY_FLT) { fname = "ofs_crystal_to_obsidian" }
        if (cls == TY_BOOL) { fname = "__ofs_bool_text" }
        if (cls == TY_VAR) { fname = "__ofs_variant_name" }
        // F6: valor de vein vira o nome da vein ("null" se nulo), igual nos
        // dois modos
        if (cls == TY_FN) { fname = "__ofs_vein_name" }
        if (ofs_str_eq(fname, "")) { return child_id }
        forge cn: Node = node_get(child_id)
        if (cls == TY_INT && !ofs_str_eq(cn.type_str, "stone")) {
            // u8/i32...: estende para stone antes (o mesmo widen da aritmetica)
            child_id = wrap_cast(child_id, "stone")
        }
        forge cid = node_new(NK_CALL, fname, cn.line, cn.col)
        node_add_extra(cid, child_id)
        node_set_type(cid, "obsidian")
        return cid
    }

    // ── Ideia 5: magma.vent(m, "nome") ────────────────────────────────
    // O tipo vein(...) do lugar onde o valor e guardado (forge com tipo, `=`,
    // argumento, return) e a assinatura pedida ao mod: vira o 3o argumento
    // (texto canonico, conferido em execucao contra o manifesto do mod) e o
    // endereco devolvido vira valor de vein desse tipo (NK_CAST gerado aqui,
    // sem abyss: o stdlib so devolve um endereco se a assinatura bate).
    vein is_magma_vent(id: stone) -> bool {
        if (node_kind_of(id) != NK_CALL || !ofs_str_eq(node_val_of(id), "magma__vent")) { return false }
        if (node_extra_len(id) != 3) { return false }
        forge sig = node_extra_at(id, 2)
        return node_kind_of(sig) == NK_LIT_STRING && ofs_str_len(node_val_of(sig)) == 0
    }

    vein magma_vent_seat(child_id: stone, to_t: obsidian) -> stone {
        forge sig: Node = node_get(node_extra_at(child_id, 2))
        sig.val = to_t
        node_set(node_extra_at(child_id, 2), sig)
        forge cn: Node = node_get(child_id)
        forge cid = node_new(NK_CAST, to_t, cn.line, cn.col)
        node_set_child(cid, 0, child_id)
        node_set_type(cid, to_t)
        return cid
    }

    // Valor `child_id` guardado num lugar do tipo `to_t` (forge com tipo,
    // `=`, argumento, return, elemento de array): devolve o no a usar.
    //   inteiro -> crystal; crystal -> inteiro (trunca, como `as`);
    //   bool -> inteiro (0/1); crystal/bool/variante -> obsidian (texto).
    // Inteiro -> inteiro de outra largura fica com o back-end (trunca/
    // estende no store, igual nos dois modos).
    vein coerce_value(child_id: stone, to_t: obsidian) -> stone {
        if (child_id < 0) { return child_id }
        forge tc = ty_class(to_t)
        if (tc == TY_UNK) { return child_id }
        if (tc == TY_FN && is_magma_vent(child_id)) { return magma_vent_seat(child_id, to_t) }
        forge ft = node_type_of(child_id)
        forge fc = ty_class(ft)
        if (fc == TY_UNK || ofs_str_eq(ft, to_t)) { return child_id }
        if (tc == TY_FN || fc == TY_FN) {
            fn_store_check(child_id, ft, to_t)
            return child_id
        }
        if (tc == TY_FLT && fc == TY_INT) { return wrap_cast(child_id, to_t) }
        if (tc == TY_INT && (fc == TY_FLT || fc == TY_BOOL)) { return wrap_cast(child_id, to_t) }
        if (tc == TY_STR && (fc == TY_FLT || fc == TY_BOOL || fc == TY_VAR)) { return wrap_text(child_id, fc) }
        if (store_suspicious(fc, tc)) {
            // So aviso: os dois modos ja divergem aqui (o nativo reinterpreta
            // os bits/o endereco, o interpretador guarda o valor como esta),
            // mas codigo de baixo nivel pode querer exatamente isso.
            forge wn: Node = node_get(child_id)
            echo("[AVISO DE TIPO " + ast_src_loc(wn.line, wn.col) + "]: valor " + ft + " guardado como " + to_t +
                " (converta com 'as " + to_t + "' se for intencional)")
        }
        return child_id
    }

    // guardar um valor da classe `fc` num lugar da classe `tc` sem conversao
    // definida (nem implicita, nem reinterpretacao de endereco usual)
    vein store_suspicious(fc: stone, tc: stone) -> bool {
        if (fc == TY_UNK || tc == TY_UNK || fc == tc) { return false }
        if (fc == TY_NULL || fc == TY_VOID || tc == TY_VOID) { return false }
        if (tc == TY_INT) { return fc == TY_STR || fc == TY_ARR || fc == TY_OBJ }
        if (tc == TY_FLT) { return fc != TY_INT }
        if (tc == TY_BOOL) { return fc == TY_STR || fc == TY_FLT || fc == TY_ARR || fc == TY_OBJ }
        if (tc == TY_STR) { return fc == TY_ARR || fc == TY_OBJ }
        if (tc == TY_ARR) { return fc == TY_FLT || fc == TY_BOOL || fc == TY_STR || fc == TY_OBJ }
        if (tc == TY_OBJ) { return fc == TY_FLT || fc == TY_BOOL || fc == TY_STR || fc == TY_ARR }
        return false
    }

    // F6: valor guardado num lugar de tipo de funcao (ou valor de vein num
    // lugar de outro tipo): so a mesma assinatura ou null. Endereco cru <->
    // vein so com `as` dentro de abyss.
    vein fn_store_check(child_id: stone, ft: obsidian, to_t: obsidian) -> void {
        forge fc = ty_class(ft)
        forge tc = ty_class(to_t)
        if (ofs_str_eq(ft, to_t)) { return }
        if (fc == TY_NULL && tc == TY_FN) { return }
        forge wn: Node = node_get(child_id)
        if (fc == TY_FN && tc == TY_FN) {
            type_error(wn, "vein de assinatura " + ft + " onde o tipo pede " + to_t,
                fn_mismatch_hint(ft, to_t))
            return
        }
        if (tc == TY_FN) {
            forge h = "a vein precisa ter exatamente essa assinatura"
            if (fc == TY_INT || fc == TY_PTR) { h = "endereco cru vira vein so com '(x as " + to_t + ")' dentro de abyss { }" }
            type_error(wn, "valor " + ft + " guardado como " + to_t, h)
            return
        }
        forge h2 = "um valor de vein so vai para um lugar do mesmo tipo vein(...)"
        if (tc == TY_INT || tc == TY_PTR) { h2 = "o endereco cru sai com '(f as " + to_t + ")' dentro de abyss { } (ou declare o parametro como " + ft + ")" }
        if (tc == TY_STR) { h2 = "o nome da vein sai com \"\" + f (ou echo(f))" }
        type_error(wn, "valor de vein " + ft + " guardado como " + to_t, h2)
    }

    // o que difere entre duas assinaturas, para a dica
    vein fn_mismatch_hint(have: obsidian, want: obsidian) -> obsidian {
        forge hp = vein_type_params(have)
        forge wp = vein_type_params(want)
        forge hn = type_list_len(hp)
        forge wn = type_list_len(wp)
        if (hn != wn) {
            return "aridade diferente: " + ofs_stone_to_obsidian(hn) + " parametro(s) onde o tipo pede " + ofs_stone_to_obsidian(wn)
        }
        forge i = 0
        while (i < hn) {
            forge a = type_list_at(hp, i)
            forge b = type_list_at(wp, i)
            if (!ofs_str_eq(a, b)) {
                return "parametro " + ofs_stone_to_obsidian(i + 1) + ": " + a + " onde o tipo pede " + b
            }
            i++
        }
        return "retorno: " + vein_type_ret(have) + " onde o tipo pede " + vein_type_ret(want)
    }

    // tipo de valor de uma vein/extern declarada (sym SYM_FN)
    vein fn_value_type(sym: Symbol) -> obsidian {
        return vein_type_make(sym.param_types, sym.type_str)
    }

    // nome de vein usado como valor (`forge f = dobro`): tipo vein(...)
    vein fn_value_ident(id: stone, sym: Symbol) -> obsidian {
        forge n: Node = node_get(id)
        if (list_has(_variadic_fns, sym.name)) {
            type_error(n, "a vein variadica '" + sym.name + "' (simbolo C com '...') nao pode virar valor de vein",
                "chame-a direto, ou declare um extern com os parametros fixos que voce usa")
            node_set_type(id, "unknown")
            return "unknown"
        }
        n.val = sym.name
        node_set(id, n)
        forge ft = fn_value_type(sym)
        node_set_type(id, ft)
        return ft
    }

    // Argumento de chamada de valor de vein: estrito (erro em vez de aviso)
    vein coerce_arg_strict(call_id: stone, idx: stone, pt: obsidian) -> void {
        forge aid = node_extra_at(call_id, idx)
        forge ft = node_type_of(aid)
        forge fc = ty_class(ft)
        forge tc = ty_class(pt)
        if (fc != TY_UNK && tc != TY_UNK && fc != TY_FN && tc != TY_FN && store_suspicious(fc, tc)) {
            forge an: Node = node_get(aid)
            type_error(an, "argumento " + ofs_stone_to_obsidian(idx + 1) + " da chamada: " + ft + " onde o tipo da vein pede " + pt,
                "converta com 'as " + pt + "' se for intencional")
            return
        }
        forge nid = coerce_value(aid, pt)
        if (nid != aid) { set_extra_at(call_id, idx, nid) }
    }

    // Chamada de um valor de vein: `f(x)` com f variavel/parametro/campo/
    // elemento do tipo vein(...). Vira NK_CALL "__vein_call" com a expressao
    // da vein em c0 (os back-ends fazem chamada indireta). Aridade e tipos
    // dos argumentos conferidos aqui (com as conversoes da F3).
    vein check_vein_call(id: stone, callee_id: stone, args_checked: bool) -> obsidian {
        forge cn: Node = node_get(id)
        cn.val = "__vein_call"
        cn.c0 = callee_id
        node_set(id, cn)
        forge ct = node_type_of(callee_id)
        forge plist = vein_type_params(ct)
        forge np = type_list_len(plist)
        forge argc = node_extra_len(id)
        forge i = 0
        if (!args_checked) {
            while (i < argc) {
                check_node(node_extra_at(id, i))
                i++
            }
        }
        if (argc != np) {
            forge who = "valor de vein"
            forge ck = node_kind_of(callee_id)
            if (ck == NK_IDENT || ck == NK_FIELD) { who = "'" + vein_display_name(node_val_of(callee_id)) + "'" }
            type_error(cn, "chamada de " + who + " com " + ofs_stone_to_obsidian(argc) +
                " argumento(s), mas o tipo " + ct + " pede " + ofs_stone_to_obsidian(np),
                "o tipo de funcao diz a aridade: vein(parametros) -> retorno")
        } else {
            i = 0
            while (i < argc) {
                coerce_arg_strict(id, i, type_list_at(plist, i))
                i++
            }
        }
        forge rt = vein_type_ret(ct)
        node_set_type(id, rt)
        return rt
    }

    // `recv__campo(args)` (`recv.campo(args)`) com campo de tipo vein: devolve
    // o id de um NK_FIELD novo (ja verificado), ou -1
    vein vein_field_callee(id: stone, name: obsidian) -> stone {
        forge nlen = ofs_str_len(name)
        forge sep = -1
        forge k = nlen - 2
        while (k > 0 && sep < 0) {
            if (ofs_str_char_at(name, k) == 95 && ofs_str_char_at(name, k + 1) == 95) { sep = k }
            k--
        }
        if (sep <= 0 || sep + 2 >= nlen) { return -1 }
        forge recv_name = ofs_str_substr(name, 0, sep)
        forge fld = ofs_str_substr(name, sep + 2, nlen - sep - 2)
        forge recv_sym: Symbol = resolve(recv_name)
        if (ofs_str_eq(recv_sym.name, "")) { return -1 }
        if (recv_sym.kind == SYM_FN || recv_sym.kind == SYM_MONOLITH) { return -1 }
        if (!vein_type_is(field_type(recv_sym.type_str, fld))) { return -1 }
        forge cn: Node = node_get(id)
        forge base_id = node_new(NK_IDENT, recv_name, cn.line, cn.col)
        forge fid = node_new(NK_FIELD, fld, cn.line, cn.col)
        node_set_child(fid, 0, base_id)
        check_node(fid)
        return fid
    }

    vein class_name(c: stone) -> obsidian {
        if (c == TY_INT) { return "inteiro" }
        if (c == TY_FLT) { return "crystal" }
        if (c == TY_BOOL) { return "bool" }
        if (c == TY_STR) { return "obsidian" }
        if (c == TY_PTR) { return "ponteiro" }
        if (c == TY_NULL) { return "null" }
        if (c == TY_VAR) { return "variante" }
        if (c == TY_ARR) { return "Array" }
        if (c == TY_OBJ) { return "monolith" }
        if (c == TY_VOID) { return "void" }
        if (c == TY_FN) { return "vein" }
        return "?"
    }

    vein is_arith_op(op: obsidian) -> bool {
        return ofs_str_eq(op, "+") || ofs_str_eq(op, "-") || ofs_str_eq(op, "*") ||
            ofs_str_eq(op, "/") || ofs_str_eq(op, "%")
    }

    vein is_bit_op(op: obsidian) -> bool {
        return ofs_str_eq(op, "&") || ofs_str_eq(op, "|") || ofs_str_eq(op, "^") ||
            ofs_str_eq(op, "<<") || ofs_str_eq(op, ">>")
    }

    vein is_cmp_op(op: obsidian) -> bool {
        return ofs_str_eq(op, "==") || ofs_str_eq(op, "!=") || ofs_str_eq(op, "<") ||
            ofs_str_eq(op, "<=") || ofs_str_eq(op, ">") || ofs_str_eq(op, ">=")
    }

    vein is_numeric_class(c: stone) -> bool {
        return c == TY_INT || c == TY_FLT
    }

    vein binop_mismatch(n: Node, lt: obsidian, rt: obsidian) -> void {
        forge lc = ty_class(lt)
        forge rc = ty_class(rt)
        forge msg = "operacao '" + n.val + "' entre " + lt + " e " + rt + " nao existe"
        forge hint = ""
        if (lc == TY_PTR || rc == TY_PTR) {
            msg = "aritmetica de ponteiro com '" + n.val + "' (" + lt + " e " + rt + ")"
            hint = "use fault_step(p, n) para andar n elementos, ou converta o endereco: (p as stone) " + n.val + " n"
        } else if (lc == TY_BOOL || rc == TY_BOOL) {
            hint = "bool nao e numero: converta com '(b as stone)'"
            if (is_bit_op(n.val)) { hint = "para bool use && / || / !; para bits converta com '(b as stone)'" }
        } else if (lc == TY_STR || rc == TY_STR) {
            hint = "obsidian so aceita '+' (concatenacao); para numero use ofs_obsidian_to_stone(s)"
        } else if (ofs_str_eq(n.val, "%") && (lc == TY_FLT || rc == TY_FLT)) {
            msg = "'%' so vale para inteiros (" + lt + " e " + rt + ")"
            hint = "converta com 'as stone', ou calcule a - b * ((a / b) as stone)"
        } else if (is_bit_op(n.val) && (lc == TY_FLT || rc == TY_FLT)) {
            msg = "operacao de bits '" + n.val + "' com crystal (" + lt + " e " + rt + ")"
            hint = "bits so existem em inteiros: converta com 'as stone'"
        } else if (lc == TY_VAR || rc == TY_VAR) {
            hint = "a etiqueta de uma variante sai com '(v as stone)'"
        } else if (lc == TY_FN || rc == TY_FN) {
            hint = "valor de vein so aceita == e != (com a mesma assinatura ou null) e a chamada f(...)"
        }
        type_error(n, msg, hint)
    }

    // Operacao binaria (nao atribuicao, nao && ||): valida, insere as
    // conversoes e devolve o tipo do resultado.
    vein check_binop(id: stone, lt: obsidian, rt: obsidian) -> obsidian {
        forge n: Node = node_get(id)
        forge op = n.val
        forge lc = ty_class(lt)
        forge rc = ty_class(rt)
        forge known = lc != TY_UNK && rc != TY_UNK

        if (is_arith_op(op)) {
            if (ofs_str_eq(op, "+") && (lc == TY_STR || rc == TY_STR)) {
                // concatenacao: o outro lado vira texto
                if (lc != TY_STR && lc != TY_NULL) { node_set_child(id, 0, wrap_text(n.c0, lc)) }
                if (rc != TY_STR && rc != TY_NULL) { node_set_child(id, 1, wrap_text(n.c1, rc)) }
                return "obsidian"
            }
            if (!known) { return lt }
            if (lc == TY_INT && rc == TY_INT) { return "stone" }
            if (is_numeric_class(lc) && is_numeric_class(rc)) {
                if (ofs_str_eq(op, "%")) {
                    binop_mismatch(n, lt, rt)
                    return "unknown"
                }
                if (lc == TY_INT) { node_set_child(id, 0, wrap_cast(n.c0, "crystal")) }
                if (rc == TY_INT) { node_set_child(id, 1, wrap_cast(n.c1, "crystal")) }
                return "crystal"
            }
            binop_mismatch(n, lt, rt)
            return "unknown"
        }

        if (is_bit_op(op)) {
            if (!known) { return lt }
            if (lc == TY_INT && rc == TY_INT) { return "stone" }
            binop_mismatch(n, lt, rt)
            return "unknown"
        }

        if (is_cmp_op(op)) {
            if (!known) { return "bool" }
            forge eq = ofs_str_eq(op, "==") || ofs_str_eq(op, "!=")
            // bool e variante comparados com numero: viram stone (0/1, etiqueta)
            if ((lc == TY_BOOL || lc == TY_VAR) && is_numeric_class(rc)) {
                node_set_child(id, 0, wrap_cast(n.c0, "stone"))
                lc = TY_INT
            }
            if ((rc == TY_BOOL || rc == TY_VAR) && is_numeric_class(lc)) {
                node_set_child(id, 1, wrap_cast(n.c1, "stone"))
                rc = TY_INT
            }
            if (is_numeric_class(lc) && is_numeric_class(rc)) {
                if (lc == TY_INT && rc == TY_FLT) { node_set_child(id, 0, wrap_cast(n.c0, "crystal")) }
                if (lc == TY_FLT && rc == TY_INT) { node_set_child(id, 1, wrap_cast(n.c1, "crystal")) }
                return "bool"
            }
            if (lc == TY_FN && rc == TY_FN && eq && !ofs_str_eq(lt, rt)) {
                type_error(n, "comparacao '" + op + "' entre veins de assinaturas diferentes (" + lt + " e " + rt + ")",
                    fn_mismatch_hint(lt, rt))
                return "bool"
            }
            if (lc == rc && lc != TY_VOID) {
                if (!eq && lc != TY_INT && lc != TY_FLT) {
                    type_error(n, "comparacao de ordem '" + op + "' entre " + lt + " e " + rt,
                        "'<', '<=', '>' e '>=' so valem para numeros")
                    return "bool"
                }
                return "bool"
            }
            if (eq && (lc == TY_NULL || rc == TY_NULL)) {
                forge other = lc
                if (lc == TY_NULL) { other = rc }
                if (other == TY_STR || other == TY_PTR || other == TY_ARR || other == TY_OBJ || other == TY_NULL || other == TY_FN) { return "bool" }
                if (other == TY_INT) {
                    // endereco guardado em stone comparado com null: vale 0
                    forge null_id = n.c1
                    if (lc == TY_NULL) { null_id = n.c0 }
                    forge nn: Node = node_get(null_id)
                    nn.kind = NK_LIT_INT
                    nn.val = "0"
                    nn.type_str = "stone"
                    node_set(null_id, nn)
                    return "bool"
                }
            }
            type_error(n, "comparacao '" + op + "' entre " + lt + " e " + rt + " nao existe",
                "os dois lados precisam ser do mesmo tipo (converta com 'as')")
            return "bool"
        }

        return lt
    }

    // `alvo op= valor` (op: + - * / % & | ^ << >>): valida e converte o
    // valor para o tipo do alvo. `x op= v` vale `x = x op v` com o
    // resultado no tipo de x.
    vein check_compound(id: stone, op: obsidian, target_t: obsidian) -> void {
        forge n: Node = node_get(id)
        forge value_id = n.c1
        forge vt = node_type_of(value_id)
        forge tc = ty_class(target_t)
        forge vc = ty_class(vt)
        if (tc == TY_UNK || vc == TY_UNK) { return }
        forge bop = ofs_str_substr(op, 0, ofs_str_len(op) - 1)
        if (tc == TY_STR && ofs_str_eq(bop, "+")) {
            if (vc != TY_STR && vc != TY_NULL) { node_set_child(id, 1, wrap_text(value_id, vc)) }
            return
        }
        forge ok = false
        if (tc == TY_INT && vc == TY_INT) { ok = true }
        if (tc == TY_FLT && is_numeric_class(vc) && is_arith_op(bop) && !ofs_str_eq(bop, "%")) { ok = true }
        if (!ok) {
            forge fake: Node = n
            fake.val = bop
            if (tc == TY_INT && vc == TY_FLT && is_arith_op(bop)) {
                type_error(n, "'" + op + "' de crystal num alvo inteiro (" + target_t + ")",
                    "escreva x = (x " + bop + " v) as " + target_t + ", ou converta o valor com 'as " + target_t + "'")
            } else {
                binop_mismatch(fake, target_t, vt)
            }
            return
        }
        if (tc == TY_FLT && vc == TY_INT) { node_set_child(id, 1, wrap_cast(value_id, target_t)) }
    }

    // ── Baixo nivel exige bloco (F4) ──────────────────────────────────
    // Regra (docs/LANGUAGE_REFERENCE.md, secao 12):
    //   fracture / bedrock / tectonic: `*p` (ler e escrever), `&x`, `as`
    //     envolvendo ponteiro, fault_step, fault_memcpy, fault_memset;
    //   abyss: tudo isso + fault_call e fault_addr.
    // Fora do bloco: [AVISO DE FALHA] ate 2027-01-09 e depois erro;
    // OFS_STRICT_FAULT=1 ja trata como [ERRO DE FALHA].
    vein fault_strict() -> bool {
        if (_fault_strict < 0) {
            _fault_strict = 0
            forge sv = getenv("OFS_STRICT_FAULT")
            if (sv != null && ofs_str_len(sv) > 0 && !ofs_str_eq(sv, "0")) { _fault_strict = 1 }
        }
        return _fault_strict == 1
    }

    vein fault_block_enter(kind: obsidian) -> void {
        if (ofs_str_eq(kind, "abyss")) { _abyss_depth++ }
        else { _fracture_depth++ }
    }

    vein fault_block_leave(kind: obsidian) -> void {
        if (ofs_str_eq(kind, "abyss")) { _abyss_depth-- }
        else { _fracture_depth-- }
    }

    // ── Estrato e permissoes por modulo (A5.4 + Ideia 4) ─────────────
    // O modulo de cada no vem da linha dele (ast_mod_of_line). Regra
    // (docs/LANGUAGE_REFERENCE.md, secao 12):
    //   stratum crust: nenhuma operacao de baixo nivel, nenhum bloco
    //     fracture/tectonic/abyss, nenhum extern/rift/quartz ([ERRO DE ESTRATO]);
    //     bedrock vale so como arena
    //   stratum fault (padrao): regra da F4 + `claim` para extern/rift vein
    //     (rift), bloco abyss (abyss) e quartz (quartz)
    //   stratum abyss: baixo nivel em qualquer lugar e vale como claim de tudo
    // Uso sem claim: [AVISO DE PERMISSAO] ate 2027-03-16, depois erro;
    // OFS_STRICT_FAULT=1 ja e [ERRO DE PERMISSAO] (mesma chave da F4).
    vein stratum_error(n: Node, op: obsidian) -> void {
        _semantic_errors++
        echo("[ERRO DE ESTRATO " + ast_src_loc(n.line, n.col) + "]: " + op + " num arquivo 'stratum crust' (sem baixo nivel)")
        echo("  dica: leve o codigo para um modulo 'stratum fault' (com o claim que ele pede) e anexe-o, ou mude o estrato deste arquivo")
    }

    vein claim_name(bit: stone) -> obsidian {
        if (bit == CLAIM_RIFT) { return "rift" }
        if (bit == CLAIM_ABYSS) { return "abyss" }
        if (bit == CLAIM_MAGMA) { return "magma" }
        return "quartz"
    }

    // `what` usa a permissao `bit` no modulo do no `n`
    vein require_claim(n: Node, bit: stone, what: obsidian) -> void {
        forge m = ast_mod_of_line(n.line)
        if (m < 0) { return }
        ast_mod_mark_used(m, bit)
        if (ast_mod_stratum(m) == STRATUM_CRUST) {
            stratum_error(n, what)
            return
        }
        if ((ast_mod_allowed(m) & bit) != 0) { return }
        // o resumo da migracao (aviso ate 2027-03-16) nao conta o magma
        if (bit != CLAIM_MAGMA) { _perm_uses++ }
        forge key = m * 16 + bit
        forge i = 0
        while (i < ofs_array_len(_perm_seen)) {
            forge k: stone = ofs_array_get(_perm_seen, i)
            if (k == key) { return }
            i++
        }
        ofs_array_push(_perm_seen, key)
        forge loc = ast_src_loc(n.line, n.col)
        forge cn = claim_name(bit)
        forge msg = what + " sem 'claim " + cn + "' no topo do arquivo"
        forge hint = "  dica: acrescente a linha 'claim " + cn + "' no topo de " + ast_mod_path(m) + " (quem anexa o modulo ve o que ele pede no ofs check)"
        // magma (Ideia 5) nasceu com a onda 5: sem migracao, sempre erro
        if (fault_strict() || bit == CLAIM_MAGMA) {
            _semantic_errors++
            echo("[ERRO DE PERMISSAO " + loc + "]: " + msg)
            echo(hint)
        } else {
            fault_note("[AVISO DE PERMISSAO " + loc + "]: " + msg)
            fault_note(hint)
        }
    }

    // extern/rift vein de simbolo do runtime do OFS (ofs_*) nao pede claim
    vein is_runtime_symbol(name: obsidian) -> bool {
        if (ofs_str_len(name) < 4) { return false }
        return ofs_str_eq(ofs_str_substr(name, 0, 4), "ofs_")
    }

    vein check_extern_claim(decl_id: stone) -> void {
        forge d: Node = node_get(decl_id)
        if (is_runtime_symbol(d.val)) { return }
        forge what = "'extern vein " + d.val + "'"
        if (d.kind == NK_RIFT_VN) { what = "'rift vein " + d.val + "'" }
        require_claim(d, CLAIM_RIFT, what)
    }

    // entrada num bloco fracture/bedrock/tectonic/abyss (ou vein marcada)
    vein fault_block_open(n: Node, kind: obsidian) -> void {
        forge counted = 1
        forge m = ast_mod_of_line(n.line)
        if (m >= 0 && ast_mod_stratum(m) == STRATUM_CRUST) {
            if (ofs_str_eq(kind, "bedrock")) {
                counted = 0
            } else {
                stratum_error(n, "bloco '" + kind + "'")
            }
        } else if (ofs_str_eq(kind, "abyss")) {
            require_claim(n, CLAIM_ABYSS, "bloco 'abyss'")
        }
        ofs_array_push(_fb_counted, counted)
        if (counted == 1) { fault_block_enter(kind) }
    }

    vein fault_block_close(kind: obsidian) -> void {
        forge counted: stone = ofs_array_pop(_fb_counted)
        if (counted == 1) { fault_block_leave(kind) }
    }

    // fim da checagem: claim em arquivo crust, caprock do principal e o
    // resumo dos avisos
    vein check_modules() -> void {
        forge nm = ast_mod_count()
        forge m = 0
        while (m < nm) {
            if (ast_mod_stratum(m) == STRATUM_CRUST && ast_mod_claims(m) != 0) {
                _semantic_errors++
                echo("[ERRO DE ESTRATO " + ast_mod_path(m) + "]: 'claim " + ast_claims_text(ast_mod_claims(m)) + "' num arquivo 'stratum crust' (sem baixo nivel)")
                echo("  dica: tire o claim ou use 'stratum fault'")
            }
            m++
        }
        forge cap = ast_mod_caprock()
        if (cap >= 0 && nm > 0) {
            m = 1
            // Ideia 5: o teto do magma.caprock vale tambem para o arquivo
            // principal do mod
            if (ast_mod_cast_ceiling()) { m = 0 }
            while (m < nm) {
                if (!ast_mod_is_runtime(m)) {
                    forge want = ast_mod_allowed(m) | ast_mod_used(m)
                    forge extra = want - (want & cap)
                    if (extra != 0) {
                        _semantic_errors++
                        forge lib = ast_claims_text(cap)
                        if (cap == 0) { lib = "nada (caprock crust)" }
                        forge how = "pede"
                        if (ast_mod_stratum(m) == STRATUM_ABYSS) { how = "e 'stratum abyss' (pede tudo):" }
                        if (ast_mod_cast_ceiling()) {
                            echo("[ERRO DE PERMISSAO " + ast_mod_path(m) + "]: o mod " + how + " '" + ast_claims_text(extra) +
                                "', mas o magma.caprock do programa que o carrega libera so: " + lib)
                            echo("  dica: tire o baixo nivel do mod, ou o programa que carrega libera mais com magma.caprock(\"...\")")
                        } else {
                        echo("[ERRO DE PERMISSAO " + ast_mod_path(0) + ":" + ofs_stone_to_obsidian(ast_mod_caprock_line()) + "]: o modulo " +
                            ast_mod_path(m) + " " + how + " '" + ast_claims_text(extra) + "', mas o caprock do programa principal libera so: " + lib)
                        echo("  dica: acrescente a permissao ao 'caprock' do principal, ou troque o modulo por um que nao a peca")
                        }
                    }
                }
                m++
            }
        }
        if (_perm_uses > 0 && !fault_strict()) {
            fault_note("[AVISO DE PERMISSAO] " + ofs_stone_to_obsidian(_perm_uses) +
                " uso(s) de baixo nivel sem 'claim' no topo do modulo: viram erro em 2027-03-16; OFS_STRICT_FAULT=1 ja trata como erro")
        }
    }

    vein is_fault_block(n: Node) -> bool {
        return n.kind == NK_BLOCK && ofs_str_len(n.val) > 0
    }

    // `op` = operacao (texto para a mensagem); `need_abyss` = so `abyss` libera;
    // `example` = trecho para a dica
    vein require_fault(n: Node, op: obsidian, need_abyss: bool, example: obsidian) -> void {
        if (_abyss_depth > 0) { return }
        if (!need_abyss && _fracture_depth > 0) { return }
        // estrato do arquivo: abyss libera tudo; crust nao libera nada
        forge fm = ast_mod_of_line(n.line)
        if (fm >= 0) {
            forge fst = ast_mod_stratum(fm)
            if (fst == STRATUM_ABYSS) { return }
            if (fst == STRATUM_CRUST) {
                stratum_error(n, op)
                return
            }
        }
        forge blocks = "fracture, bedrock ou abyss"
        forge vein_mark = "fracture vein"
        if (need_abyss) {
            blocks = "so abyss"
            vein_mark = "abyss vein"
        }
        forge loc = ast_src_loc(n.line, n.col)
        forge hint = "  dica: " + example + "  ou marque a vein: '" + vein_mark + " f(...)'"
        if (fault_strict()) {
            _semantic_errors++
            echo("[ERRO DE FALHA " + loc + "]: " + op + " fora de bloco de baixo nivel (libera: " + blocks + ")")
            echo(hint)
        } else {
            // aviso no stderr: no `ofs run` o stdout e do programa
            _fault_warnings++
            fault_note("[AVISO DE FALHA " + loc + "]: " + op + " fora de bloco de baixo nivel (libera: " + blocks + ")")
            fault_note(hint)
        }
    }

    // ── quartz (F5): assembly inline ─────────────────────────────────
    vein quartz_error(n: Node, msg: obsidian, hint: obsidian) -> void {
        _semantic_errors++
        echo("[ERRO DE QUARTZO " + ast_src_loc(n.line, n.col) + "]: " + msg)
        if (!ofs_str_eq(hint, "")) { echo("  dica: " + hint) }
    }

    // tipos que cabem num registrador e podem ser destino de quartz
    vein quartz_scalar(t: obsidian) -> bool {
        if (t == null || ofs_str_len(t) == 0) { return false }
        if (ofs_str_char_at(t, 0) == 42) { return true }
        if (is_int_type(t) || is_float_type(t)) { return true }
        return ofs_str_eq(t, "bool") || ofs_str_eq(t, "f32") || ofs_str_eq(t, "ptr")
    }

    vein quartz_is_digit(c: stone) -> bool {
        return c >= 48 && c <= 57
    }

    // confere os operandos $N do texto: N < nops; '$' sozinho = erro
    vein quartz_check_operands(n: Node, text: obsidian, nops: stone) -> void {
        forge len = ofs_str_len(text)
        forge i = 0
        while (i < len) {
            if (ofs_str_char_at(text, i) == 36) {
                if (i + 1 < len && ofs_str_char_at(text, i + 1) == 36) {
                    i = i + 2
                } else {
                    forge j = i + 1
                    if (j < len && ofs_str_char_at(text, j) == 123) { j++ }
                    forge start = j
                    forge idx = 0
                    while (j < len && quartz_is_digit(ofs_str_char_at(text, j))) {
                        idx = idx * 10 + ofs_str_char_at(text, j) - 48
                        j++
                    }
                    if (j == start) {
                        quartz_error(n, "'$' sozinho no texto do quartz: os operandos sao $0, $1, ... e um '$' literal e '$$'",
                            "imediato AT&T: 'shlq $$32, %rdx' (o LLVM le '$32' como o operando 32)")
                        return
                    }
                    if (idx >= nops) {
                        forge has = "nenhum operando"
                        if (nops > 0) { has = ofs_stone_to_obsidian(nops) + " operando(s), $0 a $" + ofs_stone_to_obsidian(nops - 1) }
                        quartz_error(n, "operando $" + ofs_stone_to_obsidian(idx) + " nao existe: este quartz tem " + has,
                            "$0 e o destino (-> x), se houver; depois vem cada 'in', na ordem")
                        return
                    }
                    i = j
                }
            } else {
                i++
            }
        }
    }

    vein check_quartz(id: stone) -> void {
        forge n: Node = node_get(id)
        forge nops = 0
        if (n.c0 >= 0) {
            forge d: Node = node_get(n.c0)
            forge dsym: Symbol = resolve(d.val)
            if (dsym.kind == SYM_CONST) {
                quartz_error(d, "destino '" + d.val + "' do quartz e constante", "use forge para uma saida modificavel")
                return
            }
            if (dsym.kind != SYM_VAR && dsym.kind != SYM_PARAM) {
                quartz_error(d, "destino '" + d.val + "' do quartz nao e uma variavel declarada",
                    "declare antes: 'forge " + d.val + ": stone = 0' e depois 'quartz { ... } -> " + d.val + "'")
                return
            }
            if (!quartz_scalar(dsym.type_str)) {
                quartz_error(d, "destino '" + d.val + "' do quartz e " + dsym.type_str + "; precisa caber num registrador (stone, iN/uN, bool, crystal, f32, ponteiro)", "")
                return
            }
            node_set_type(n.c0, dsym.type_str)
            nops = 1
            if (n.c1 >= 0) {
                forge oc = node_val_of(n.c1)
                if (ofs_str_contains(oc, ",") || ofs_str_contains(oc, "*")) {
                    quartz_error(d, "quartz suporta uma saida direta em registrador", "para memoria, passe o endereco como entrada e declare melt \"memory\"")
                    return
                }
                if (ofs_str_eq(oc, "=m") || ofs_str_eq(oc, "+m") || ofs_str_eq(oc, "=&m")) {
                    quartz_error(d, "saida de memoria no quartz precisa ser uma entrada de endereco", "use in \"r\" ponteiro e melt \"memory\"")
                    return
                }
                if (ofs_str_len(oc) == 0 || (ofs_str_char_at(oc, 0) != 61 && ofs_str_char_at(oc, 0) != 43)) {
                    quartz_error(d, "restricao da saida '" + oc + "' precisa comecar com '=' (so escreve) ou '+' (le e escreve)",
                        "ex.: -> " + d.val + " \"=r\"  (qualquer registrador), \"={rax}\" (rax), \"+r\" (entra e sai)")
                    return
                }
            }
        }
        forge ni = node_extra_len(id)
        forge i = 0
        while (i < ni) {
            forge inp_id = node_extra_at(id, i)
            forge inp: Node = node_get(inp_id)
            forge cons = inp.val
            if (ofs_str_len(cons) == 0 || ofs_str_char_at(cons, 0) == 61 || ofs_str_char_at(cons, 0) == 43 || ofs_str_char_at(cons, 0) == 126) {
                quartz_error(inp, "restricao de entrada '" + cons + "' invalida (sem '=', '+' ou '~': isso e de saida ou de melt)",
                    "ex.: in \"r\" x  (registrador), in \"{rdi}\" x (rdi), in \"m\" x (memoria)")
                return
            }
            forge it = check_node(inp.c0)
            if (!quartz_scalar(it) && !ofs_str_eq(it, "obsidian") && !ofs_str_eq(it, "null")) {
                quartz_error(inp, "entrada do quartz precisa ser escalar ou ponteiro (recebeu " + it + ")", "passe o endereco para arrays e monoliths")
                return
            }
            if (ofs_str_eq(cons, "m") || ofs_str_eq(cons, "*m")) {
                // memoria: o endereco de uma variavel escalar
                forge e: Node = node_get(inp.c0)
                forge esym: Symbol = resolve(e.val)
                if (e.kind != NK_IDENT || (esym.kind != SYM_VAR && esym.kind != SYM_PARAM) || !quartz_scalar(esym.type_str)) {
                    quartz_error(inp, "entrada de memoria ('" + cons + "') precisa ser uma variavel escalar (o quartz recebe o endereco dela)",
                        "ex.: in \"m\" contador")
                    return
                }
            }
            nops++
            i++
        }
        quartz_check_operands(n, n.val, nops)
    }

    vein fault_note(msg: obsidian) -> void {
        forge line = msg + "\n"
        write(2, line, ofs_str_len(line))
    }

    vein report_anchor_control(n: Node, control: obsidian) -> void {
        _semantic_errors++
        echo("[fault E0042] " + ofs_stone_to_obsidian(n.line) + ":" + ofs_stone_to_obsidian(n.col) +
            ": '" + control + "' is not allowed inside anchor/seal")
    }
    
    // Distancia de edicao (Levenshtein) com teto: devolve `cap + 1` assim
    // que passa de `cap`. So roda quando ha erro, para a sugestao.
    vein edit_distance(a: obsidian, b: obsidian, cap: stone) -> stone {
        forge la = ofs_str_len(a)
        forge lb = ofs_str_len(b)
        if (la - lb > cap || lb - la > cap) { return cap + 1 }
        forge prev: Array<stone> = []
        forge cur: Array<stone> = []
        forge j = 0
        while (j <= lb) {
            ofs_array_push(prev, j)
            ofs_array_push(cur, 0)
            j++
        }
        forge i = 1
        while (i <= la) {
            ofs_array_set(cur, 0, i)
            forge row_min = i
            forge ca = ofs_str_char_at(a, i - 1)
            j = 1
            while (j <= lb) {
                forge cost = 1
                if (ca == ofs_str_char_at(b, j - 1)) { cost = 0 }
                forge best: stone = ofs_array_get(prev, j - 1) + cost
                forge del: stone = ofs_array_get(prev, j) + 1
                forge ins: stone = ofs_array_get(cur, j - 1) + 1
                if (del < best) { best = del }
                if (ins < best) { best = ins }
                ofs_array_set(cur, j, best)
                if (best < row_min) { row_min = best }
                j++
            }
            if (row_min > cap) { return cap + 1 }
            forge tmp = prev
            prev = cur
            cur = tmp
            i++
        }
        return ofs_array_get(prev, lb)
    }

    // nome visivel mais parecido com `name` (ou ""), para "voce quis dizer"
    vein suggest_name(name: obsidian) -> obsidian {
        forge cap = ofs_str_len(name) / 3
        if (cap < 1) { cap = 1 }
        if (cap > 3) { cap = 3 }
        forge best = ""
        forge best_d = cap + 1
        forge i = ofs_array_len(_symbols) - 1
        while (i >= 0) {
            forge sym: Symbol = ofs_array_get(_symbols, i)
            if (!ofs_str_eq(sym.name, name) && ofs_str_len(sym.name) > 0) {
                forge d = edit_distance(name, sym.name, cap)
                if (d < best_d) {
                    best_d = d
                    best = sym.name
                }
            }
            i--
        }
        // nome mangled de namespace: mostra como o usuario escreve (ns.nome)
        forge bl = ofs_str_len(best)
        forge k = 1
        while (k + 1 < bl) {
            if (ofs_str_char_at(best, k) == 95 && ofs_str_char_at(best, k + 1) == 95) {
                return ofs_str_substr(best, 0, k) + "." + ofs_str_substr(best, k + 2, bl - k - 2)
            }
            k++
        }
        return best
    }

    // Identificador que nao existe em nenhum escopo: erro de compilacao
    // (antes era aviso e o nome chegava ao `llc` como `%nome`).
    vein report_undefined(n: Node) -> void {
        _semantic_errors++
        echo("[ERRO SEMANTICO " + ast_src_loc(n.line, n.col) + "]: identificador indefinido '" + n.val + "'")
        forge sug = suggest_name(n.val)
        if (!ofs_str_eq(sug, "")) {
            echo("  voce quis dizer '" + sug + "'?")
        }
        echo("  dica: declare com 'forge' antes de usar, ou anexe o modulo que o define com 'attach'")
        echo("        (um modulo verificado sozinho nao enxerga os nomes de quem o anexa).")
    }

    // Reescreve `recv__metodo(args)` (chamada `recv.metodo(args)`) para
    // `Tipo__metodo(recv, args)` quando `recv` e uma variavel de tipo `Tipo`
    // com metodo em `impl Tipo`. Devolve o tipo de retorno, ou "" se nao for.
    vein check_method_call(id: stone, name: obsidian, argc: stone) -> obsidian {
        forge nlen = ofs_str_len(name)
        forge sep = -1
        forge k = nlen - 2
        while (k > 0 && sep < 0) {
            if (ofs_str_char_at(name, k) == 95 && ofs_str_char_at(name, k + 1) == 95) { sep = k }
            k--
        }
        if (sep <= 0 || sep + 2 >= nlen) { return "" }
        forge recv_name = ofs_str_substr(name, 0, sep)
        forge meth = ofs_str_substr(name, sep + 2, nlen - sep - 2)
        forge recv_sym: Symbol = resolve(recv_name)
        if (ofs_str_eq(recv_sym.name, "")) { return "" }
        if (recv_sym.kind == SYM_FN || recv_sym.kind == SYM_MONOLITH) { return "" }
        forge rt = recv_sym.type_str
        if (ofs_str_char_at(rt, 0) == 42) { rt = ofs_str_substr(rt, 1, ofs_str_len(rt) - 1) }
        if (ofs_str_eq(rt, "") || ofs_str_eq(rt, "unknown")) { return "" }
        forge mname = rt + "__" + meth
        forge m_sym: Symbol = resolve(mname)
        if (ofs_str_eq(m_sym.name, "") || m_sym.kind != SYM_FN) { return "" }
        forge cn: Node = node_get(id)
        if (m_sym.fn_arity == argc + 1 || (m_sym.fn_arity > argc + 1 && defaults_cover(mname, argc + 1))) {
            forge recv_id = node_new(NK_IDENT, recv_name, cn.line, cn.col)
            check_node(recv_id)
            forge new_extra: Array<stone> = []
            ofs_array_push(new_extra, recv_id)
            forge ai = 0
            while (ai < argc) {
                ofs_array_push(new_extra, node_extra_at(id, ai))
                ai++
            }
            cn = node_get(id)
            cn.extra = new_extra
        }
        cn.val = mname
        node_set(id, cn)
        return m_sym.type_str
    }

    // argumentos de uma chamada nos tipos dos parametros declarados
    // (variadica: so os fixos; "unknown"/sem tipo: sem conversao)
    vein coerce_args(call_id: stone, ptypes: obsidian) -> void {
        if (ptypes == null || ofs_str_eq(ptypes, "")) { return }
        forge argc = node_extra_len(call_id)
        forge i = 0
        while (i < argc) {
            forge pt = param_type_at(ptypes, i)
            if (ofs_str_eq(pt, "")) { return }
            forge aid = node_extra_at(call_id, i)
            forge nid = coerce_value(aid, pt)
            if (nid != aid) { set_extra_at(call_id, i, nid) }
            i++
        }
    }

    // `strata T { A, B(stone) }`: o tipo e as variantes (as variantes viram
    // globais `stone` no llvmgen; nomes PascalCase ja passam por
    // is_variant_name, os outros, ex. `RED`, precisam estar declarados)
    vein declare_strata(id: stone) -> void {
        if (!list_has(_strata_types, node_val_of(id))) { ofs_array_push(_strata_types, node_val_of(id)) }
        forge type_sym: Symbol
        type_sym.name = node_val_of(id)
        type_sym.type_str = node_val_of(id)
        type_sym.kind = SYM_MONOLITH
        declare(type_sym)
        forge vi = 0
        while (vi < node_extra_len(id)) {
            forge var_id = node_extra_at(id, vi)
            if (node_kind_of(var_id) == NK_VARIANT) {
                forge vs: Symbol
                vs.name = node_val_of(var_id)
                vs.type_str = "variant"
                vs.kind = SYM_CONST
                declare(vs)
            }
            vi++
        }
    }

    // global (forge/const de topo ou de namespace) pre-declarado: o tipo vem
    // da anotacao ou de um literal; a declaracao de verdade redeclara depois
    // com o tipo inferido completo
    vein predeclare_global(decl_id: stone) -> void {
        forge gv_sym: Symbol
        gv_sym.name = node_val_of(decl_id)
        gv_sym.type_str = "unknown"
        forge gv_ann = node_child(decl_id, 0)
        forge gv_init = node_child(decl_id, 1)
        if (gv_ann >= 0) {
            gv_sym.type_str = type_node_name(gv_ann)
        } else if (gv_init >= 0) {
            forge gik = node_kind_of(gv_init)
            if (gik == NK_LIT_INT) { gv_sym.type_str = "stone" }
            if (gik == NK_LIT_FLOAT) { gv_sym.type_str = "crystal" }
            if (gik == NK_LIT_STRING) { gv_sym.type_str = "obsidian" }
            if (gik == NK_LIT_BOOL) { gv_sym.type_str = "bool" }
        }
        gv_sym.kind = SYM_VAR
        declare(gv_sym)
    }

    // extern/rift cujo simbolo C e variadico (llvmgen.variadic_fixed_count)
    vein note_variadic_extern(decl_id: stone) -> void {
        forge bsym = node_type_of(decl_id)
        if (ofs_str_eq(bsym, "")) { bsym = node_val_of(decl_id) }
        if (variadic_c_fixed(bsym) >= 0) { ofs_array_push(_variadic_fns, node_val_of(decl_id)) }
    }

    vein check_node(id: stone) -> obsidian {
        if (id < 0) { return "void" }

        _check_visits++
        if (_check_visits > node_pool_len() * 4 + 256) {
            _semantic_errors++
            echo("[fault E9001] typechecker traversal limit exceeded at node " + ofs_stone_to_obsidian(id))
            return "unknown"
        }
        if (_check_visits % 5000 == 0) {
            echo("[typeck trace] visited " + ofs_stone_to_obsidian(_check_visits) + " nodes")
        }
        
        forge n: Node = node_get(id)
        
        if (n.kind == NK_LIT_INT) {
            node_set_type(id, "stone")
            return "stone"
        }
        
        if (n.kind == NK_LIT_FLOAT) {
            node_set_type(id, "crystal")
            return "crystal"
        }
        
        if (n.kind == NK_LIT_STRING) {
            node_set_type(id, "obsidian")
            return "obsidian"
        }
        
        if (n.kind == NK_LIT_BOOL) {
            node_set_type(id, "bool")
            return "bool"
        }
        
        if (n.kind == NK_LIT_NULL) {
            node_set_type(id, "null")
            return "null"
        }
        
        if (n.kind == NK_IDENT) {
            forge sym: Symbol = resolve(n.val)
            if (ofs_str_eq(sym.name, "") && is_variant_name(n.val)) {
                node_set_type(id, "variant")
                return "variant"
            }
            if (ofs_str_eq(sym.name, "")) {
                report_undefined(n)
                node_set_type(id, "unknown")
                return "unknown"
            }
            // F6: nome de vein/extern como valor (tipo vein(...)), sem abyss
            if (sym.kind == SYM_FN) { return fn_value_ident(id, sym) }
            if (ofs_array_len(_gd_base) > 0) { note_capture(n.val, sym.type_str) }
            node_set_type(id, sym.type_str)
            return sym.type_str
        }

        if (n.kind == NK_LAMBDA) {
            return check_geode(id)
        }
        
        if (n.kind == NK_BIN_OP) {
            forge left_type = check_node(n.c0)
            forge right_type = check_node(n.c1)

            if (ofs_str_eq(n.val, "&&") || ofs_str_eq(n.val, "||")) {
                node_set_type(id, "bool")
                return "bool"
            }
            // atribuicao escrita como operador binario (`x = v`, `x += v`)
            forge bopl = ofs_str_len(n.val)
            if (ofs_str_eq(n.val, "=") || (bopl >= 2 && ofs_str_char_at(n.val, bopl - 1) == 61 && !is_cmp_op(n.val))) {
                check_capture_store(n.c0, "atribuir")
            }
            if (ofs_str_eq(n.val, "=")) {
                node_set_child(id, 1, coerce_value(n.c1, left_type))
                node_set_type(id, left_type)
                return left_type
            }
            forge opl = ofs_str_len(n.val)
            if (opl >= 2 && ofs_str_char_at(n.val, opl - 1) == 61 && !is_cmp_op(n.val)) {
                check_compound(id, n.val, left_type)
                node_set_type(id, left_type)
                return left_type
            }
            // "unknown" (builtin sem assinatura, ou um erro ja relatado)
            // nao gera erro em cascata: check_binop so decide com os dois
            // tipos conhecidos.
            forge bt = check_binop(id, left_type, right_type)
            node_set_type(id, bt)
            return bt
        }

        if (n.kind == NK_FIELD) {
            // `ns.global` acessado de fora do namespace: reescreve para o
            // identificador mangled `ns__global` (o parser ja faz isso para
            // chamadas `ns.fn()`). Vale para llvmgen e para o interpretador.
            if (n.c0 >= 0) {
                forge fb: Node = node_get(n.c0)
                if (fb.kind == NK_IDENT) {
                    forge base_sym: Symbol = resolve(fb.val)
                    if (ofs_str_eq(base_sym.name, "")) {
                        forge ns_sym: Symbol = resolve(fb.val + "__" + n.val)
                        if (!ofs_str_eq(ns_sym.name, "")) {
                            n.kind = NK_IDENT
                            n.val = fb.val + "__" + n.val
                            n.c0 = -1
                            node_set(id, n)
                            // `ns.vein` como valor
                            if (ns_sym.kind == SYM_FN) { return fn_value_ident(id, ns_sym) }
                            node_set_type(id, ns_sym.type_str)
                            return ns_sym.type_str
                        }
                    }
                }
            }
            forge base_type = check_node(n.c0)
            forge ft = field_type(base_type, n.val)
            node_set_type(id, ft)
            return ft
        }

        if (n.kind == NK_INDEX) {
            // `a[i]` tem o tipo do elemento de Array<T>; sem T declarado o
            // elemento e lido como stone (igual ao llvmgen)
            forge base_t = check_node(n.c0)
            check_node(n.c1)
            forge et = array_elem_of(base_t)
            if (ofs_str_eq(et, "")) { et = "stone" }
            node_set_type(id, et)
            return et
        }

        if (n.kind == NK_ASSIGN) {
            forge target_type = check_node(n.c0)
            check_capture_store(n.c0, "atribuir")
            check_node(n.c1)
            if (ofs_str_eq(n.val, "=") || ofs_str_eq(n.val, "")) {
                node_set_child(id, 1, coerce_value(n.c1, target_type))
            } else {
                check_compound(id, n.val, target_type)
            }
            node_set_type(id, target_type)
            return target_type
        }

        if (n.kind == NK_POST_OP) {
            forge operand_type = check_node(n.c0)
            if (!ofs_str_eq(n.val, "?")) { check_capture_store(n.c0, "'" + n.val + "'") }
            if (ofs_str_eq(n.val, "?")) {
                // `Solid(v)?` vale v (tipo do payload); qualquer outro `x?`
                // vale a etiqueta da variante (stone). Ver llvmgen.emit_try.
                forge try_t = "stone"
                forge top: Node = node_get(n.c0)
                if (top.kind == NK_CALL && is_variant_name(top.val) && node_extra_len(n.c0) > 0 &&
                    !ofs_str_eq(top.val, "Crack") && !ofs_str_eq(top.val, "Barren")) {
                    try_t = node_type_of(node_extra_at(n.c0, 0))
                }
                node_set_type(id, try_t)
                return try_t
            }
            node_set_type(id, operand_type)
            return operand_type
        }
        
        if (n.kind == NK_CAST) {
            forge src_type = check_node(n.c0)
            forge target_type = n.val
            forge cs = ty_class(src_type)
            forge ct = ty_class(target_type)
            if ((ct == TY_FN || cs == TY_FN) && !ofs_str_eq(src_type, target_type) && cs != TY_NULL) {
                // F6: endereco cru <-> vein, ou troca de assinatura: so em abyss
                forge fn_ok = (ct == TY_FN && (cs == TY_INT || cs == TY_PTR || cs == TY_FN || cs == TY_UNK)) ||
                    (cs == TY_FN && (ct == TY_INT || ct == TY_PTR))
                if (!fn_ok) {
                    type_error(n, "'as' entre " + src_type + " e " + target_type + " nao existe",
                        "vein vira endereco (as stone / as *u8) e endereco vira vein (as vein(...)), so dentro de abyss")
                } else {
                    forge fn_ex = "abyss { forge a = (f as " + target_type + ") }"
                    if (ct == TY_FN) { fn_ex = "abyss { forge f = (endereco as " + target_type + ") }" }
                    require_fault(n, "'as' com valor de vein (" + src_type + " as " + target_type + ")", true, fn_ex)
                }
            } else if ((ct == TY_PTR && cs != TY_NULL && !ofs_str_eq(src_type, target_type)) ||
                (cs == TY_PTR && !ofs_str_eq(src_type, target_type))) {
                require_fault(n, "'as' com ponteiro (" + src_type + " as " + target_type + ")", false,
                    "fracture { forge q = (p as stone) + 8 }")
            }
            node_set_type(id, target_type)
            return target_type
        }

        if (n.kind == NK_UNARY_OP) {
            forge operand_type = check_node(n.c0)
            if (ofs_str_eq(n.val, "&")) {
                check_capture_store(n.c0, "tomar o endereco '&'")
                require_fault(n, "endereco '&x'", false, "fracture { shard p: *stone = &x }")
                forge ptr_t = "*" + operand_type
                node_set_type(id, ptr_t)
                return ptr_t
            }
            if (ofs_str_eq(n.val, "*")) {
                require_fault(n, "acesso por ponteiro '*p' (leitura ou escrita)", false, "fracture { forge v = *p; *p = v + 1 }")
                forge deref_t = "stone"
                if (ofs_str_len(operand_type) > 1 && ofs_str_char_at(operand_type, 0) == 42) {
                    deref_t = ofs_str_substr(operand_type, 1, ofs_str_len(operand_type) - 1)
                }
                node_set_type(id, deref_t)
                return deref_t
            }
            if (ofs_str_eq(n.val, "!")) {
                node_set_type(id, "bool")
                return "bool"
            }
            forge uc = ty_class(operand_type)
            if (ofs_str_eq(n.val, "-") && uc != TY_UNK && uc != TY_INT && uc != TY_FLT) {
                type_error(n, "'-' unario em " + operand_type, "so numeros (stone, crystal, inteiros) tem sinal")
                node_set_type(id, "unknown")
                return "unknown"
            }
            if (ofs_str_eq(n.val, "~") && uc != TY_UNK && uc != TY_INT) {
                type_error(n, "'~' em " + operand_type, "bits so existem em inteiros: converta com 'as stone'")
                node_set_type(id, "unknown")
                return "unknown"
            }
            if (uc == TY_INT && !ofs_str_eq(operand_type, "stone") && (ofs_str_eq(n.val, "-") || ofs_str_eq(n.val, "~"))) {
                // u8/i32...: a conta e feita em stone (como na aritmetica)
                node_set_child(id, 0, wrap_cast(n.c0, "stone"))
                operand_type = "stone"
            }
            node_set_type(id, operand_type)
            return operand_type
        }
        
        if (n.kind == NK_CALL) {
            // F6: chamada de valor de vein. (a) expressao em c0 (o parser a
            // guarda quando quem e chamado nao e um nome: `a[i](x)`,
            // `f(1)(2)`); (b) nome de variavel/parametro do tipo vein(...).
            if (ofs_str_eq(n.val, "__vein_call") && n.c0 >= 0) {
                check_node(n.c0)
                return check_vein_call(id, n.c0, false)
            }
            if (n.c0 >= 0 && node_kind_of(n.c0) == NK_FIELD) {
                // `a.b.f(x)`: se `f` e uma vein, a chamada pelo nome de antes
                forge old_sym: Symbol = resolve(n.val)
                if (old_sym.kind == SYM_FN) {
                    n.c0 = -1
                    node_set(id, n)
                }
            }
            if (n.c0 >= 0) {
                forge cal_t = check_node(n.c0)
                if (vein_type_is(cal_t)) { return check_vein_call(id, n.c0, false) }
                // nao e valor de vein: chamada pelo nome, como antes
                n.c0 = -1
                node_set(id, n)
            }
            forge vc_sym: Symbol = resolve(n.val)
            if (!ofs_str_eq(vc_sym.name, "") && vc_sym.kind != SYM_FN && vein_type_is(vc_sym.type_str)) {
                forge vc_id = node_new(NK_IDENT, n.val, n.line, n.col)
                check_node(vc_id)
                return check_vein_call(id, vc_id, false)
            }
            // fault_addr(vein): endereco de uma vein como `stone` (ponteiro de
            // funcao C). O argumento e um nome de vein, nao uma expressao:
            // `ns.fn` vira o simbolo `ns__fn` e nao passa por check_node.
            if (ofs_str_eq(n.val, "fault_addr")) {
                require_fault(n, "'fault_addr' (endereco de vein)", true, "abyss { forge f = fault_addr(minha_vein) }")
                if (node_extra_len(id) == 1) {
                    forge fa_id = node_get_extra(id, 0)
                    forge fa: Node = node_get(fa_id)
                    forge fa_name = ""
                    if (fa.kind == NK_IDENT) { fa_name = fa.val }
                    if (fa.kind == NK_FIELD && fa.c0 >= 0) {
                        forge fa_base: Node = node_get(fa.c0)
                        if (fa_base.kind == NK_IDENT) { fa_name = fa_base.val + "__" + fa.val }
                    }
                    forge fa_sym: Symbol = resolve(fa_name)
                    if (!(!ofs_str_eq(fa_name, "") && fa_sym.kind == SYM_FN)) {
                        // F6: fault_addr(valor de vein) = endereco cru (`f as stone`)
                        forge fa_t = check_node(fa_id)
                        if (vein_type_is(fa_t)) {
                            forge fcn: Node = node_get(id)
                            fcn.kind = NK_CAST
                            fcn.val = "stone"
                            fcn.c0 = fa_id
                            fcn.extra = []
                            node_set(id, fcn)
                            node_set_type(id, "stone")
                            return "stone"
                        }
                    }
                    if (!ofs_str_eq(fa_name, "") && fa_sym.kind == SYM_FN) {
                        fa.kind = NK_IDENT
                        fa.val = fa_name
                        fa.c0 = -1
                        node_set(fa_id, fa)
                        node_set_type(id, "stone")
                        return "stone"
                    }
                }
                _semantic_errors++
                echo("[ERRO SEMANTICO " + ofs_stone_to_obsidian(n.line) + ":" + ofs_stone_to_obsidian(n.col) + "]: fault_addr espera o nome de uma vein")
                node_set_type(id, "stone")
                return "stone"
            }
            if (ofs_str_eq(n.val, "fault_call")) {
                require_fault(n, "'fault_call' (chamada por endereco)", true, "abyss { forge r = fault_call(f, a, b) }")
            } else if (ofs_str_eq(n.val, "fault_step") || ofs_str_eq(n.val, "fault_memcpy") || ofs_str_eq(n.val, "fault_memset")) {
                require_fault(n, "'" + n.val + "' (memoria crua)", false, "fracture { " + n.val + "(...) }")
            }
            forge i = 0
            forge argc = node_extra_len(id)
            while (i < argc) {
                forge arg_id = node_extra_at(id, i)
                check_node(arg_id)
                i++
            }
            if (ofs_str_eq(n.val, "fault_call") && argc >= 1 && vein_type_is(node_type_of(node_extra_at(id, 0)))) {
                // F6: fault_call(f, args) com f de tipo vein(...): assinatura
                // conferida e chamada tipada (= f(args))
                forge fcl_callee = node_extra_at(id, 0)
                forge fcl_extra: Array<stone> = []
                forge fcl_i = 1
                while (fcl_i < argc) {
                    ofs_array_push(fcl_extra, node_extra_at(id, fcl_i))
                    fcl_i++
                }
                forge fcl_n: Node = node_get(id)
                fcl_n.extra = fcl_extra
                node_set(id, fcl_n)
                return check_vein_call(id, fcl_callee, true)
            }
            if (ofs_str_eq(n.val, "fault_call") || ofs_str_eq(n.val, "fault_cut") || ofs_str_eq(n.val, "fault_patch") || ofs_str_eq(n.val, "fault_swap") || ofs_str_eq(n.val, "fault_count") || ofs_str_eq(n.val, "fault_lead") || ofs_str_eq(n.val, "fault_trail") || ofs_str_eq(n.val, "fault_spin_left") || ofs_str_eq(n.val, "fault_spin_right") || ofs_str_eq(n.val, "fault_weave")) {
                node_set_type(id, "stone")
                return "stone"
            }
            if (ofs_str_eq(n.val, "fault_fence") || ofs_str_eq(n.val, "fault_prefetch") || ofs_str_eq(n.val, "fault_trap") || ofs_str_eq(n.val, "fault_unreachable") || ofs_str_eq(n.val, "fault_memcpy") || ofs_str_eq(n.val, "fault_memset")) {
                node_set_type(id, "void")
                return "void"
            }
            // A5.1: falha de contrato inserida por contracts.ofs (mensagem
            // no stderr e codigo 1 nos dois modos)
            if (ofs_str_eq(n.val, "__ofs_contract_fail")) {
                node_set_type(id, "void")
                return "void"
            }
            if (ofs_str_eq(n.val, "fault_step")) {
                forge st_t = check_node(node_get_extra(id, 0))
                node_set_type(id, st_t)
                return st_t
            }
            if (ofs_str_eq(n.val, "echo") && argc == 1) {
                // variante imprime o nome nos dois modos (o nativo usa a
                // tabela de nomes gerada pelo llvmgen)
                forge ea = node_extra_at(id, 0)
                if (ty_class(node_type_of(ea)) == TY_VAR) { set_extra_at(id, 0, wrap_text(ea, TY_VAR)) }
                // valor de vein: o nome (o nativo usa a tabela do llvmgen)
                if (ty_class(node_type_of(ea)) == TY_FN) { set_extra_at(id, 0, wrap_text(ea, TY_FN)) }
                node_set_type(id, "void")
                return "void"
            }
            // Builtins genericos de Array (antes do `extern` que o stdlib declara
            // com `stone`: o elemento vem de Array<T>). Antes caiam em
            // "unknown" (= ponteiro no LLVM) e `forge n = ofs_array_get(a, i)`
            // gerava IR invalido. Infere o elemento a partir de Array<T>.
            if (ofs_str_eq(n.val, "ofs_array_get") || ofs_str_eq(n.val, "ofs_array_pop")) {
                forge elem_t = "stone"
                if (argc > 0) {
                    forge arr_t = node_type_of(node_extra_at(id, 0))
                    forge alen = ofs_str_len(arr_t)
                    if (alen > 7 && ofs_str_eq(ofs_str_substr(arr_t, 0, 6), "Array<")) {
                        elem_t = ofs_str_substr(arr_t, 6, alen - 7)
                    }
                }
                if (ofs_str_eq(elem_t, "stone")) {
                    // sem Array<T>: o tipo do `extern` declarado, se houver
                    forge ag_sym: Symbol = resolve(n.val)
                    if (!ofs_str_eq(ag_sym.name, "") && !ofs_str_eq(ag_sym.type_str, "unknown")) { elem_t = ag_sym.type_str }
                }
                node_set_type(id, elem_t)
                return elem_t
            }
            // ofs_array_push(a, v) / ofs_array_set(a, i, v): v no tipo do elemento
            if ((ofs_str_eq(n.val, "ofs_array_push") && argc == 2) || (ofs_str_eq(n.val, "ofs_array_set") && argc == 3)) {
                forge pa_et = array_elem_of(node_type_of(node_extra_at(id, 0)))
                if (!ofs_str_eq(pa_et, "")) {
                    set_extra_at(id, argc - 1, coerce_value(node_extra_at(id, argc - 1), pa_et))
                }
                node_set_type(id, "void")
                return "void"
            }
            // Ideia 5: compilar e carregar codigo em execucao pede 'claim
            // magma' (stratum crust: nunca)
            if (ofs_str_eq(n.val, "magma__cast")) {
                require_claim(n, CLAIM_MAGMA, "'magma.cast' (compilar e carregar codigo em execucao)")
            }
            forge fn_sym: Symbol = resolve(n.val)
            if (!ofs_str_eq(fn_sym.name, "")) {
                fill_defaults(id, n.val)
                coerce_args(id, fn_sym.param_types)
                node_set_type(id, fn_sym.type_str)
                return fn_sym.type_str
            }
            // Metodo de `impl`: o parser baixa `r.area()` para `r__area()`.
            // Se `r` e uma variavel de tipo T e existe `T__area`, reescreve
            // para `T__area(r, ...)` (receptor como primeiro argumento).
            forge mt = check_method_call(id, n.val, argc)
            if (!ofs_str_eq(mt, "")) {
                fill_defaults(id, node_val_of(id))
                forge m_sym: Symbol = resolve(node_val_of(id))
                coerce_args(id, m_sym.param_types)
                node_set_type(id, mt)
                return mt
            }
            // F6: `s.campo(args)` com campo de tipo vein(...)
            forge vf_id = vein_field_callee(id, n.val)
            if (vf_id >= 0) { return check_vein_call(id, vf_id, true) }
            if (ofs_str_eq(n.val, "ofs_crystal_to_obsidian") || ofs_str_eq(n.val, "__ofs_bool_text") || ofs_str_eq(n.val, "__ofs_variant_name") || ofs_str_eq(n.val, "__ofs_vein_name")) {
                node_set_type(id, "obsidian")
                return "obsidian"
            }
            if (ofs_str_eq(n.val, "ofs_obsidian_to_stone")) {
                node_set_type(id, "stone")
                return "stone"
            }
            if (ofs_str_eq(n.val, "ofs_pow") || ofs_str_eq(n.val, "ofs_sqrt")) {
                forge pi = 0
                while (pi < argc) {
                    set_extra_at(id, pi, coerce_value(node_extra_at(id, pi), "crystal"))
                    pi++
                }
                node_set_type(id, "crystal")
                return "crystal"
            }
            // Builtins de string do runtime (declarados implicitamente pelo llvmgen).
            if (ofs_str_eq(n.val, "ofs_str_len") || ofs_str_eq(n.val, "ofs_str_char_at") || ofs_str_eq(n.val, "ofs_str_char_at_known")) {
                node_set_type(id, "stone")
                return "stone"
            }
            if (ofs_str_eq(n.val, "ofs_str_eq") || ofs_str_eq(n.val, "ofs_str_contains")) {
                node_set_type(id, "bool")
                return "bool"
            }
            if (ofs_str_eq(n.val, "ofs_str_concat") || ofs_str_eq(n.val, "ofs_str_substr") || ofs_str_eq(n.val, "ofs_stone_to_obsidian")) {
                node_set_type(id, "obsidian")
                return "obsidian"
            }
            if (ofs_str_eq(n.val, "ofs_array_len")) {
                node_set_type(id, "stone")
                return "stone"
            }
            if (ofs_str_eq(n.val, "ofs_array_push") || ofs_str_eq(n.val, "ofs_array_set")) {
                node_set_type(id, "void")
                return "void"
            }
            node_set_type(id, "unknown")
            return "unknown"
        }
        
        if (n.kind == NK_VAR_DECL || n.kind == NK_CONST_DECL) {
            // Get type from annotation
            forge type_node_id = n.c0
            forge init_id = n.c1
            forge type_str = "unknown"
            
            if (type_node_id >= 0) {
                type_str = type_node_name(type_node_id)
                if (init_id >= 0) {
                    check_node(init_id)
                    // `forge a: Array<crystal> = [1, 2]`: cada elemento no tipo T
                    forge dl_et = array_elem_of(type_str)
                    if (node_kind_of(init_id) == NK_ARRAY_LIT && !ofs_str_eq(dl_et, "")) {
                        forge ei = 0
                        while (ei < node_extra_len(init_id)) {
                            set_extra_at(init_id, ei, coerce_value(node_extra_at(init_id, ei), dl_et))
                            ei++
                        }
                    }
                    node_set_child(id, 1, coerce_value(init_id, type_str))
                }
            } else if (init_id >= 0) {
                // Infer from initializer
                type_str = check_node(init_id)
                if (is_magma_vent(init_id)) {
                    type_error(n, "magma.vent precisa do tipo de vein pedido ao mod",
                        "declare o tipo: forge " + n.val + ": vein(stone) -> stone = magma.vent(m, \"nome\")")
                }
            }
            
            // Declare symbol
            forge sym: Symbol
            sym.name = n.val
            sym.type_str = type_str
            sym.kind = SYM_VAR
            if (n.kind == NK_CONST_DECL) {
                sym.kind = SYM_CONST
            }
            declare(sym)
            
            node_set_type(id, type_str)
            return type_str
        }
        
        if (n.kind == NK_RETURN) {
            if (_anchor_depth > 0) { report_anchor_control(n, "return") }
            if (n.c0 >= 0) {
                forge rv_t = check_node(n.c0)
                node_set_child(id, 0, coerce_value(n.c0, _cur_ret))
                return rv_t
            }
            return "void"
        }

        if (n.kind == NK_BREAK || n.kind == NK_CONTINUE) {
            if (ofs_array_len(_gd_base) > 0 && _loop_depth == 0) {
                forge bw = "shatter/break"
                if (n.kind == NK_CONTINUE) { bw = "erode/continue" }
                geode_error(n, "'" + bw + "' fora de laco dentro do geode (o corpo do geode e outra vein: nao sai do laco de fora)",
                    "devolva um valor (return) e decida fora do geode")
            }
            if (_anchor_depth > 0) {
                if (n.kind == NK_BREAK) { report_anchor_control(n, "shatter") }
                else { report_anchor_control(n, "erode") }
            }
            return "void"
        }

        if (n.kind == NK_THROW) {
            if (_anchor_depth > 0) { report_anchor_control(n, "throw") }
            if (n.c0 >= 0) { check_node(n.c0) }
            return "void"
        }

        if (n.kind == NK_QUARTZ) {
            require_fault(n, "'quartz' (assembly inline)", true, "abyss { quartz { \"nop\" } }")
            require_claim(n, CLAIM_QUARTZ, "'quartz' (assembly inline)")
            check_quartz(id)
            return "void"
        }

        if (n.kind == NK_ANCHOR) {
            _anchor_depth++
            if (n.c0 >= 0) { check_node(n.c0) }
            _anchor_depth--
            return "void"
        }

        if (n.kind == NK_MATCH) {
            if (n.c0 >= 0) { check_node(n.c0) }
            forge i = 0
            forge casec = node_extra_len(id)
            while (i < casec) {
                forge case_id = node_extra_at(id, i)
                check_node(case_id)
                i++
            }
            return "void"
        }

        if (n.kind == NK_CASE) {
            if (n.c0 >= 0) { check_node(n.c0) }
            if (n.c1 >= 0) { check_node(n.c1) }
            return "void"
        }

        if (n.kind == NK_DEFAULT) {
            if (n.c0 >= 0) { check_node(n.c0) }
            return "void"
        }
        
        if (n.kind == NK_IF) {
            check_node(n.c0)  // condition
            push_scope()
            check_node(n.c1)  // then block
            pop_scope()
            if (n.c2 >= 0) {
                push_scope()
                check_node(n.c2)  // else block
                pop_scope()
            }
            return "void"
        }
        
        if (n.kind == NK_WHILE) {
            check_node(n.c0)  // condition
            push_scope()
            _loop_depth++
            check_node(n.c1)  // body
            _loop_depth--
            pop_scope()
            return "void"
        }

        if (n.kind == NK_CYCLE_C) {
            push_scope()
            if (n.c0 >= 0) { check_node(n.c0) }
            if (n.c1 >= 0) { check_node(n.c1) }
            _loop_depth++
            if (n.c3 >= 0) { check_node(n.c3) }
            _loop_depth--
            if (n.c2 >= 0) { check_node(n.c2) }
            pop_scope()
            return "void"
        }

        if (n.kind == NK_CYCLE_RANGE) {
            forge arr_t = check_node(n.c0)
            push_scope()
            forge rsym: Symbol
            rsym.name = n.val
            rsym.type_str = "stone"
            if (ofs_str_eq(arr_t, "Array<obsidian>") || ofs_str_eq(arr_t, "obsidian")) {
                rsym.type_str = "obsidian"
            }
            // elemento escalar declarado (crystal, bool, inteiros, strata)
            forge cr_et = array_elem_of(arr_t)
            forge cr_c = ty_class(cr_et)
            if (cr_c == TY_INT || cr_c == TY_FLT || cr_c == TY_BOOL || cr_c == TY_FN || (cr_c == TY_VAR && !ofs_str_eq(cr_et, "variant"))) {
                rsym.type_str = cr_et
            }
            rsym.kind = SYM_VAR
            declare(rsym)
            node_set_type(id, rsym.type_str)
            _loop_depth++
            check_node(n.c1)
            _loop_depth--
            pop_scope()
            return "void"
        }
        
        if (n.kind == NK_BLOCK) {
            forge fault_kind = n.val
            forge is_fault = is_fault_block(n)
            if (is_fault) { fault_block_open(n, fault_kind) }
            forge i = 0
            forge stmtc = node_extra_len(id)
            while (i < stmtc) {
                forge stmt_id = node_extra_at(id, i)
                check_node(stmt_id)
                i++
            }
            if (is_fault) { fault_block_close(fault_kind) }
            return "void"
        }

        if (n.kind == NK_TREMOR) {
            push_scope()
            if (n.c0 >= 0) { check_node(n.c0) }
            pop_scope()

            if (n.c2 >= 0) {
                push_scope()
                if (n.c1 >= 0) {
                    forge cident: Node = node_get(n.c1)
                    forge csym: Symbol
                    csym.name = cident.val
                    csym.type_str = "obsidian"
                    csym.kind = SYM_VAR
                    declare(csym)
                }
                check_node(n.c2)
                pop_scope()
            }
            return "void"
        }
        
        if (n.kind == NK_FN_DECL || n.kind == NK_CORE_DECL) {
            push_scope()
            forge saved_ret = _cur_ret
            forge saved_base = _fn_base
            forge saved_owner = _fn_owner
            forge saved_gk = _geode_k
            _fn_base = _scope_depth
            _fn_owner = n.val
            _geode_k = 0
            // Ideia 5: o modulo que implementa magma.cast carrega codigo
            if (ofs_str_eq(n.val, "magma__cast")) { require_claim(n, CLAIM_MAGMA, "definir 'magma.cast' (carregar codigo em execucao)") }
            _cur_ret = "unknown"
            if (n.c1 >= 0) { _cur_ret = type_node_name(n.c1) }
            
            // Check parameters
            forge params_id = n.c0
            if (params_id >= 0) {
                forge i = 0
                forge paramc = node_extra_len(params_id)
                while (i < paramc) {
                    forge param_id = node_extra_at(params_id, i)
                    forge param_type_id = node_child(param_id, 0)
                    forge param_type_str = "unknown"
                    if (param_type_id >= 0) {
                        param_type_str = type_node_name(param_type_id)
                    }
                    forge sym: Symbol
                    sym.name = node_val_of(param_id)
                    sym.type_str = param_type_str
                    sym.kind = SYM_PARAM
                    declare(sym)
                    i++
                }
            }
            
            // Check body
            forge body_id = n.c2
            if (body_id >= 0) {
                check_node(body_id)
            }
            _cur_ret = saved_ret
            _fn_base = saved_base
            _fn_owner = saved_owner
            _geode_k = saved_gk
            
            pop_scope()
            return "void"
        }

        if (n.kind == NK_MONOLITH) {
            if (!list_has(_mono_types, n.val)) { ofs_array_push(_mono_types, n.val) }
            forge type_sym: Symbol
            type_sym.name = n.val
            type_sym.type_str = n.val
            type_sym.kind = SYM_MONOLITH
            declare(type_sym)

            forge i = 0
            forge fieldc = node_extra_len(id)
            while (i < fieldc) {
                forge field_id = node_extra_at(id, i)
                forge field_type_id = node_child(field_id, 0)
                if (field_type_id >= 0) {
                    forge field_type_str = type_node_name(field_type_id)
                    register_field(n.val, node_val_of(field_id), field_type_str)
                    // campo de outro monolith/strata (pre-declarado no topo)
                    forge fts: Symbol = resolve(field_type_str)
                    if (!check_type_string(field_type_str) && fts.kind != SYM_MONOLITH) {
                        echo("[typeck warn] unknown field type '" + field_type_str + "' in monolith " + n.val)
                    }
                }
                i++
            }
            return "void"
        }

        if (n.kind == NK_IMPL) {
            forge i = 0
            forge mc = node_extra_len(id)
            while (i < mc) {
                forge method_id = node_extra_at(id, i)
                check_node(method_id)
                i++
            }
            return "void"
        }

        if (n.kind == NK_NAMESPACE) {
            push_scope()
            forge i = 0
            forge mc = node_extra_len(id)
            while (i < mc) {
                forge member_id = node_extra_at(id, i)
                check_node(member_id)
                i++
            }
            pop_scope()
            return "void"
        }

        if (n.kind == NK_STRATA) {
            declare_strata(id)
            return "void"
        }

        if (n.kind == NK_ARRAY_LIT) {
            forge i = 0
            forge elc = node_extra_len(id)
            while (i < elc) {
                check_node(node_extra_at(id, i))
                i++
            }
            return "unknown"
        }

        if (n.kind == NK_ATTACH) {
            return "void"
        }
        
        if (n.kind == NK_PROGRAM) {
            _root_id = id
            // predeclare top-level functions for call resolution
            forge d = 0
            forge dcount = node_extra_len(id)
            while (d < dcount) {
                forge decl_id = node_extra_at(id, d)
                forge decl_kind = node_kind_of(decl_id)
                if (decl_kind == NK_FN_DECL || decl_kind == NK_CORE_DECL) {
                    forge fn_sym: Symbol
                    fn_sym.name = node_val_of(decl_id)
                    fn_sym.type_str = "unknown"
                    forge decl_c1 = node_child(decl_id, 1)
                    if (decl_c1 >= 0) {
                        fn_sym.type_str = type_node_name(decl_c1)
                    }
                    fn_sym.kind = SYM_FN
                    fn_sym.param_types = param_types_of(decl_id)
                    declare(fn_sym)
                    note_defaults(decl_id)
                } else if (decl_kind == NK_EXTERN_VN || decl_kind == NK_RIFT_VN) {
                    forge ext_sym: Symbol
                    ext_sym.name = node_val_of(decl_id)
                    ext_sym.type_str = "unknown"
                    forge decl_c1e = node_child(decl_id, 1)
                    if (decl_c1e >= 0) {
                        ext_sym.type_str = type_node_name(decl_c1e)
                    }
                    ext_sym.kind = SYM_FN
                    ext_sym.param_types = param_types_of(decl_id)
                    declare(ext_sym)
                    note_variadic_extern(decl_id)
                    check_extern_claim(decl_id)
                } else if (decl_kind == NK_VAR_DECL || decl_kind == NK_CONST_DECL) {
                    // global de topo usado numa vein antes da linha que o declara
                    predeclare_global(decl_id)
                } else if (decl_kind == NK_STRATA) {
                    declare_strata(decl_id)
                } else if (decl_kind == NK_MONOLITH) {
                    if (!list_has(_mono_types, node_val_of(decl_id))) { ofs_array_push(_mono_types, node_val_of(decl_id)) }
                    forge mono_sym: Symbol
                    mono_sym.name = node_val_of(decl_id)
                    mono_sym.type_str = node_val_of(decl_id)
                    mono_sym.kind = SYM_MONOLITH
                    declare(mono_sym)
                } else if (decl_kind == NK_NAMESPACE || decl_kind == NK_IMPL) {
                    forge j = 0
                    forge mcount = node_extra_len(decl_id)
                    while (j < mcount) {
                        forge member_id = node_extra_at(decl_id, j)
                        forge member_kind = node_kind_of(member_id)
                        if (member_kind == NK_FN_DECL || member_kind == NK_CORE_DECL || member_kind == NK_EXTERN_VN || member_kind == NK_RIFT_VN) {
                            forge member_sym: Symbol
                            member_sym.name = node_val_of(member_id)
                            member_sym.type_str = "unknown"
                            forge mc1 = node_child(member_id, 1)
                            if (mc1 >= 0) {
                                member_sym.type_str = type_node_name(mc1)
                            }
                            member_sym.kind = SYM_FN
                            member_sym.param_types = param_types_of(member_id)
                            member_sym.fn_arity = -1
                            forge mc0 = node_child(member_id, 0)
                            if (mc0 >= 0) { member_sym.fn_arity = node_extra_len(mc0) }
                            declare(member_sym)
                            if (member_kind == NK_FN_DECL) { note_defaults(member_id) }
                            if (member_kind == NK_EXTERN_VN || member_kind == NK_RIFT_VN) {
                                note_variadic_extern(member_id)
                                check_extern_claim(member_id)
                            }
                        } else if (member_kind == NK_VAR_DECL || member_kind == NK_CONST_DECL) {
                            // globais de namespace (nome ja mangled ns__nome),
                            // visiveis de fora como `ns.nome`
                            predeclare_global(member_id)
                        } else if (member_kind == NK_STRATA) {
                            declare_strata(member_id)
                        } else if (member_kind == NK_MONOLITH) {
                            if (!list_has(_mono_types, node_val_of(member_id))) { ofs_array_push(_mono_types, node_val_of(member_id)) }
                            forge nm_sym: Symbol
                            nm_sym.name = node_val_of(member_id)
                            nm_sym.type_str = node_val_of(member_id)
                            nm_sym.kind = SYM_MONOLITH
                            declare(nm_sym)
                        }
                        j++
                    }
                }
                d++
            }

            forge i = 0
            forge body_c = node_extra_len(id)
            while (i < body_c) {
                forge decl_id = node_extra_at(id, i)
                check_node(decl_id)
                i++
            }
            return "void"
        }
        
        return "unknown"
    }
    
    vein check(root_id: stone) -> void {
        _anchor_depth = 0
        _fracture_depth = 0
        _abyss_depth = 0
        _fault_warnings = 0
        _perm_uses = 0
        _perm_seen = []
        _fb_counted = []
        _semantic_errors = 0
        _cur_ret = "unknown"
        _check_visits = 0
        _fn_base = 1099511627776
        _fn_owner = "global"
        _geode_k = 0
        _gd_base = []
        _cap_gd = []
        _cap_name = []
        _cap_type = []
        _loop_depth = 0
        push_scope()
        check_node(root_id)
        pop_scope()
        if (_fault_warnings > 0) {
            fault_note("[AVISO DE FALHA] " + ofs_stone_to_obsidian(_fault_warnings) +
                " operacao(oes) de baixo nivel fora de bloco: viram erro em 2027-01-09; OFS_STRICT_FAULT=1 ja trata como erro")
        }
        check_modules()
    }

    // estado zerado para checar outro programa no mesmo processo (Fault
    // Refract: a versao nova e checada do zero, como numa execucao nova)
    vein reset() -> void {
        _symbols = []
        _symbol_depths = []
        _scope_depth = 0
        _field_owners = []
        _field_names = []
        _field_types = []
        _strata_types = []
        _mono_types = []
        _variadic_fns = []
        _dflt_names = []
        _dflt_decls = []
    }

    // A5.3 (sediment.ofs): strata (etiqueta i64) e monolith conhecidos
    vein is_strata_t(t: obsidian) -> bool {
        return list_has(_strata_types, t)
    }

    // valor sem memoria propria (numero, bool, etiqueta de strata, void)
    vein is_scalar_t(t: obsidian) -> bool {
        forge c = ty_class(t)
        return c == TY_INT || c == TY_FLT || c == TY_BOOL || c == TY_VAR || c == TY_VOID || c == TY_NULL
    }

    vein is_mono_t(t: obsidian) -> bool {
        return list_has(_mono_types, t)
    }

    // o monolith tem campo que aponta para memoria (texto, Array, ponteiro,
    // outro monolith, vein)? copia-lo por valor copia esses ponteiros
    vein mono_has_pointers(t: obsidian) -> bool {
        forge i = 0
        while (i < ofs_array_len(_field_owners)) {
            forge fo: obsidian = ofs_array_get(_field_owners, i)
            if (ofs_str_eq(fo, t)) {
                forge ft: obsidian = ofs_array_get(_field_types, i)
                forge c = ty_class(ft)
                if (c != TY_INT && c != TY_FLT && c != TY_BOOL && c != TY_VAR) { return true }
            }
            i++
        }
        return false
    }

    vein fault_warning_count() -> stone {
        return _fault_warnings
    }

    vein has_errors() -> bool {
        return _semantic_errors > 0
    }
}
