gem ink "#eef6ff"
gem muted "#9fb1c8"
gem paper "#070a0f"
gem surface "#101722"
gem line "#263244"
gem accent "#29e0bd"
gem violet "#7c5cff"

paint body
  margin "0"
  fill "radial-gradient(circle at top left, rgba(41,224,189,.20), transparent 34%), $paper"
  ink "$ink"
  font-family "Inter, system-ui, sans-serif"

paint .topbar
  flow "flex"
  justify "space-between"
  align "center"
  padding "18px clamp(18px, 5vw, 64px)"
  border-bottom "1px solid $line"
  fill "rgba(7,10,15,.82)"

paint .docs
  ink "$accent"
  text-decoration "none"
  weight "800"

paint .hero
  padding "88px clamp(18px, 5vw, 64px)"

paint .hero h1
  size "clamp(54px, 9vw, 120px)"
  line-height ".88"
  margin "0 0 22px"

paint .hero p
  size "20px"
  ink "$muted"

paint .grid
  flow "grid"
  grid-cols "repeat(3, minmax(0, 1fr))"
  space "16px"
  padding "0 clamp(18px, 5vw, 64px) 80px"

paint .card
  padding "22px"
  curve "8px"
  fill "$surface"
  edge "1px solid $line"
  transition "transform .2s ease, border-color .2s ease"

paint .card:hover
  transform "translateY(-4px)"
  border-color "$accent"

paint .card .docs
  flow "inline-flex"
  margin-top "12px"
  ink "$accent"
  text-decoration "none"
  weight "800"

veil "(max-width: 760px)"
  paint .grid
    grid-cols "1fr"

pulse "enter"
  rise
    opacity "0"
    transform "translateY(10px)"
  rest
    opacity "1"
    transform "translateY(0)"
