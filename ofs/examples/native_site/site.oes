gem ink: Color = #f4edff
gem muted: Color = #b8a9d6
gem paper: Color = #05030a
gem surface: Color = #120d1f
gem line: Color = #34234f
gem accent: Color = #a978ff
gem violet: Color = #f06cff

paint body
  margin: 0px
  fill: linear-gradient(135deg, #05030a 0%, #0b0613 42%, #160b26 100%)
  ink: $ink
  font-family: Inter, system-ui, sans-serif

paint .topbar
  flow: flex
  justify: space-between
  align: center
  padding: 18px clamp(18px, 5vw, 64px)
  border-bottom: 1px solid $line
  fill: rgba(5, 3, 10, .82)

paint .docs
  ink: $accent
  text-decoration: none
  weight: 800

paint .hero
  padding: 88px clamp(18px, 5vw, 64px)

paint .hero h1
  size: clamp(54px, 9vw, 120px)
  line-height: .88
  margin: 0px 0px 22px

paint .hero p
  size: 20px
  ink: $muted

paint .grid
  flow: grid
  grid-cols: repeat(3, minmax(0, 1fr))
  space: 16px
  padding: 0px clamp(18px, 5vw, 64px) 80px

paint .card
  padding: 22px
  curve: 8px
  fill: $surface
  edge: 1px solid $line
  transition: transform .2s ease, border-color .2s ease

paint .card:hover
  transform: translateY(-4px)
  border-color: $accent

paint .card .docs
  flow: inline-flex
  margin-top: 12px
  ink: $accent
  text-decoration: none
  weight: 800

veil "(max-width: 760px)"
  paint .grid
    grid-cols: 1fr

pulse "enter"
  rise
    opacity: 0%
    transform: translateY(10px)
  rest
    opacity: 100%
    transform: translateY(0px)
