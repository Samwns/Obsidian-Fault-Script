page "OFS Native Web Languages" "en"
skin "site.css"
flow
  deck.topbar
    strong "Obsidian Fault Script"
    link.docs "Documentation" "#content"
  stage#content
    band.hero
      title1 "ODL + OES"
      mark "Build **documents**, `components`, and native-hosted sites."
      raw "<small>Raw HTML remains available when interoperability matters.</small>"
    band.grid
      tile.card
        title2 "ODL"
        text "Document structure with an indentation-based syntax."
        link.docs "Read source" "source/page.odl"
      tile.card
        title2 "OES"
        text "Tokens, visual rules, responsive behavior, and motion."
        link.docs "Read source" "source/site.oes"
      move.card.feature
        title2 "Safe visual positioning"
        text "Run with ?ofs-studio=1 on localhost and drag marked elements."
        link.docs "Export OES" "?ofs-studio=1"
  studio "safe-localhost"
  spark "app.js"
