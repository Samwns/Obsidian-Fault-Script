page "OFS Native Site" "en"
skin "site.css"
flow
  deck.topbar
    strong "Obsidian Fault Script"
    link.docs "Source" "source/page.odl"
  stage#content
    band.hero
      title1 "Native site source"
      text "This example keeps ODL and OES as source files. HTML and CSS are generated artifacts."
    band.grid
      tile.card
        title2 "ODL"
        text "Document tree, semantic nodes, component mount points, and explicit interop."
        link.docs "Read source" "source/page.odl"
      tile.card
        title2 "OES"
        text "Typed visual values, px and percent units, responsive contexts, and motion."
        link.docs "Read source" "source/site.oes"
      tile.card
        title2 "Backend"
        text "Serve the generated target with webserver.ofs or any static host."
