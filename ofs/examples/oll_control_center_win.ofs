extern vein GetModuleHandleA(name: obsidian) -> *stone
extern vein CreateWindowExA(ex: stone, cls: obsidian, name: obsidian, style: stone, x: stone, y: stone, w: stone, h: stone, parent: *stone, menu: *stone, inst: *stone, param: *stone) -> *stone
extern vein ShowWindow(hwnd: *stone, cmd: stone) -> stone
extern vein UpdateWindow(hwnd: *stone) -> stone
extern vein GetMessageA(msg: *stone, hwnd: *stone, min: stone, max: stone) -> stone
extern vein TranslateMessage(msg: *stone) -> stone
extern vein DispatchMessageA(msg: *stone) -> stone
extern vein PostQuitMessage(code: stone) -> void
extern vein ExitProcess(code: stone) -> void
extern vein GetDC(hwnd: *stone) -> *stone
extern vein ReleaseDC(hwnd: *stone, hdc: *stone) -> stone
extern vein InvalidateRect(hwnd: *stone, rect: *stone, erase: stone) -> stone
extern vein ValidateRect(hwnd: *stone, rect: *stone) -> stone
extern vein CreateSolidBrush(color: stone) -> *stone
extern vein CreatePen(style: stone, width: stone, color: stone) -> *stone
extern vein SelectObject(hdc: *stone, obj: *stone) -> *stone
extern vein DeleteObject(obj: *stone) -> stone
extern vein RoundRect(hdc: *stone, l: stone, t: stone, r: stone, b: stone, rw: stone, rh: stone) -> stone
extern vein Rectangle(hdc: *stone, l: stone, t: stone, r: stone, b: stone) -> stone
extern vein SetBkMode(hdc: *stone, mode: stone) -> stone
extern vein SetTextColor(hdc: *stone, color: stone) -> stone
extern vein TextOutA(hdc: *stone, x: stone, y: stone, text: obsidian, len: stone) -> stone
extern vein CreateFontA(h: stone, w: stone, e: stone, o: stone, wt: stone, it: stone, un: stone, st: stone, c: stone, op: stone, cp: stone, q: stone, p: stone, f: obsidian) -> *stone
extern vein CreateCompatibleDC(hdc: *stone) -> *stone
extern vein CreateCompatibleBitmap(hdc: *stone, w: stone, h: stone) -> *stone
extern vein BitBlt(dest: *stone, x: stone, y: stone, w: stone, h: stone, src: *stone, sx: stone, sy: stone, rop: stone) -> stone
extern vein DeleteDC(hdc: *stone) -> stone
extern vein MessageBoxA(hwnd: *stone, text: obsidian, title: obsidian, utype: stone) -> stone
extern vein ofs_alloc(size: stone) -> *stone
extern vein ofs_free(ptr: *stone) -> void
extern vein lstrlenA(s: obsidian) -> stone
extern vein fault_step(p: *stone, idx: stone) -> *stone
extern vein LoadCursorA(inst: *stone, name: stone) -> *stone
extern vein SetCursor(cur: *stone) -> *stone
extern vein GetCursorPos(pt: *stone) -> stone
extern vein ScreenToClient(hwnd: *stone, pt: *stone) -> stone
extern vein GetSystemMetrics(idx: stone) -> stone

vein _load_stone(p: *stone) -> stone {
    fracture {
        return *p
    }
}

vein draw_card(hdc: *stone, x: stone, y: stone, w: stone, h: stone, bg_col: stone, border_col: stone, radius: stone) -> void {
    forge hbrush = CreateSolidBrush(bg_col)
    forge hpen = CreatePen(0, 1, border_col)
    forge old_b = SelectObject(hdc, hbrush)
    forge old_p = SelectObject(hdc, hpen)
    RoundRect(hdc, x, y, x + w, y + h, radius, radius)
    SelectObject(hdc, old_b)
    SelectObject(hdc, old_p)
    DeleteObject(hbrush)
    DeleteObject(hpen)
}

vein draw_text(hdc: *stone, hfont: *stone, x: stone, y: stone, text: obsidian, fg_col: stone) -> void {
    forge old_f = SelectObject(hdc, hfont)
    SetTextColor(hdc, fg_col)
    SetBkMode(hdc, 1)
    TextOutA(hdc, x, y, text, lstrlenA(text))
    SelectObject(hdc, old_f)
}

vein draw_badge(hdc: *stone, hfont: *stone, x: stone, y: stone, w: stone, h: stone, text: obsidian, bg_col: stone, fg_col: stone) -> void {
    forge hbrush = CreateSolidBrush(bg_col)
    forge hpen = CreatePen(0, 1, bg_col)
    forge old_b = SelectObject(hdc, hbrush)
    forge old_p = SelectObject(hdc, hpen)
    RoundRect(hdc, x, y, x + w, y + h, h, h)
    SelectObject(hdc, old_b)
    SelectObject(hdc, old_p)
    DeleteObject(hbrush)
    DeleteObject(hpen)
    forge old_f = SelectObject(hdc, hfont)
    SetTextColor(hdc, fg_col)
    SetBkMode(hdc, 1)
    forge tlen = lstrlenA(text)
    forge tx = x + (w - (tlen * 7)) / 2
    forge ty = y + (h - 14) / 2
    TextOutA(hdc, tx, ty, text, tlen)
    SelectObject(hdc, old_f)
}

vein draw_progress(hdc: *stone, x: stone, y: stone, w: stone, h: stone, pct: stone, track_col: stone, fill_col: stone) -> void {
    forge hbrush_t = CreateSolidBrush(track_col)
    forge hpen_t = CreatePen(0, 1, track_col)
    forge old_b = SelectObject(hdc, hbrush_t)
    forge old_p = SelectObject(hdc, hpen_t)
    RoundRect(hdc, x, y, x + w, y + h, 8, 8)
    SelectObject(hdc, old_b)
    SelectObject(hdc, old_p)
    DeleteObject(hbrush_t)
    DeleteObject(hpen_t)

    if (pct > 0) {
        forge fill_w = (w * pct) / 100
        forge hbrush_f = CreateSolidBrush(fill_col)
        forge hpen_f = CreatePen(0, 1, fill_col)
        old_b = SelectObject(hdc, hbrush_f)
        old_p = SelectObject(hdc, hpen_f)
        RoundRect(hdc, x, y, x + fill_w, y + h, 8, 8)
        SelectObject(hdc, old_b)
        SelectObject(hdc, old_p)
        DeleteObject(hbrush_f)
        DeleteObject(hpen_f)
    }
}

vein draw_btn_state(hdc: *stone, hfont: *stone, x: stone, y: stone, w: stone, h: stone, text: obsidian, btn_id: stone, hover_id: stone, base_bg: stone, hover_bg: stone, base_border: stone, hover_border: stone, fg_col: stone) -> void {
    forge bg = base_bg
    forge bcol = base_border
    if (btn_id == hover_id && hover_id > 0) {
        bg = hover_bg
        bcol = hover_border
    }
    forge hbrush = CreateSolidBrush(bg)
    forge hpen = CreatePen(0, 1, bcol)
    forge old_b = SelectObject(hdc, hbrush)
    forge old_p = SelectObject(hdc, hpen)
    RoundRect(hdc, x, y, x + w, y + h, 10, 10)
    SelectObject(hdc, old_b)
    SelectObject(hdc, old_p)
    DeleteObject(hbrush)
    DeleteObject(hpen)
    forge old_f = SelectObject(hdc, hfont)
    SetTextColor(hdc, fg_col)
    SetBkMode(hdc, 1)
    forge tlen = lstrlenA(text)
    forge tx = x + (w - (tlen * 8)) / 2
    forge ty = y + (h - 16) / 2
    TextOutA(hdc, tx, ty, text, tlen)
    SelectObject(hdc, old_f)
}

vein render_ui(hwnd: *stone, progress_val: stone, status_text: obsidian, hover_id: stone) -> void {
    forge hdc = GetDC(hwnd)
    if (hdc == null) { return }

    forge mem_dc = CreateCompatibleDC(hdc)
    forge mem_bmp = CreateCompatibleBitmap(hdc, 908, 680)
    forge old_bmp = SelectObject(mem_dc, mem_bmp)

    forge bg_brush = CreateSolidBrush(1708303)
    forge old_b = SelectObject(mem_dc, bg_brush)
    Rectangle(mem_dc, -2, -2, 912, 684)
    SelectObject(mem_dc, old_b)
    DeleteObject(bg_brush)

    forge font_title = CreateFontA(-22, 0, 0, 0, 700, 0, 0, 0, 0, 0, 0, 5, 0, "Segoe UI")
    forge font_h2 = CreateFontA(-17, 0, 0, 0, 700, 0, 0, 0, 0, 0, 0, 5, 0, "Segoe UI")
    forge font_bold = CreateFontA(-14, 0, 0, 0, 700, 0, 0, 0, 0, 0, 0, 5, 0, "Segoe UI")
    forge font_regular = CreateFontA(-14, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 0, "Segoe UI")
    forge font_small = CreateFontA(-12, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 0, "Segoe UI")

    draw_text(mem_dc, font_title, 32, 22, "OBSIDIAN FAULT SCRIPT - NATIVE CONTROL SUITE", 16230091)
    draw_text(mem_dc, font_small, 32, 50, "Ambiente Multiplataforma: Windows, Linux e macOS | Stack Magma 100% OFS | Zero-Clang", 13151654)

    draw_badge(mem_dc, font_small, 32, 76, 95, 24, "v1.0.137", 16430217, 1314060)
    draw_badge(mem_dc, font_small, 135, 76, 125, 24, "Stack Magma", 10609574, 1314060)
    draw_badge(mem_dc, font_small, 268, 76, 110, 24, "Zero Clang", 8893434, 1314060)
    draw_badge(mem_dc, font_small, 386, 76, 110, 24, "OLL 60 FPS", 16230091, 1314060)
    draw_badge(mem_dc, font_small, 504, 76, 140, 24, "Multiplataforma", 11045875, 1314060)

    draw_card(mem_dc, 32, 116, 410, 260, 2693912, 4731181, 12)
    draw_text(mem_dc, font_h2, 48, 132, "Arquitetura e Pipeline Nativo", 16430217)
    draw_text(mem_dc, font_bold, 48, 164, "Compilador:", 16250357)
    draw_text(mem_dc, font_regular, 160, 164, "ofscc (Self-Hosted v1.0.137)", 16250357)
    draw_text(mem_dc, font_bold, 48, 192, "Backend IR:", 16250357)
    draw_text(mem_dc, font_regular, 160, 192, "LLVM IR SSA Nativo (Zero C)", 13151654)
    draw_text(mem_dc, font_bold, 48, 220, "Emissao:", 16250357)
    draw_text(mem_dc, font_regular, 160, 220, "LLC -> LLD PE32+ (x86_64)", 13151654)
    draw_text(mem_dc, font_bold, 48, 248, "Runtime:", 16250357)
    draw_text(mem_dc, font_regular, 160, 248, "Stack Magma 100% OFS", 10609574)
    draw_text(mem_dc, font_bold, 48, 276, "Determinismo:", 16250357)
    draw_text(mem_dc, font_regular, 160, 276, "Byte-a-byte verificado (cmp -s)", 13151654)
    draw_text(mem_dc, font_bold, 48, 304, "Alocador Heap:", 16250357)
    draw_text(mem_dc, font_regular, 160, 304, "Reservoir Deterministico", 13151654)
    draw_text(mem_dc, font_bold, 48, 332, "Ambiente:", 16250357)
    draw_text(mem_dc, font_regular, 160, 332, "Windows / PortProton / Wine", 8893434)

    draw_card(mem_dc, 458, 116, 410, 260, 2693912, 4731181, 12)
    draw_text(mem_dc, font_h2, 474, 132, "Motor Visual e UI OLL", 10609574)
    draw_text(mem_dc, font_bold, 474, 164, "Linguagem UI:", 16250357)
    draw_text(mem_dc, font_regular, 595, 164, "Obsidian Layout Language (.oll)", 16250357)
    draw_text(mem_dc, font_bold, 474, 192, "Renderizacao:", 16250357)
    draw_text(mem_dc, font_regular, 595, 192, "60 FPS com Double Buffering", 13151654)
    draw_text(mem_dc, font_bold, 474, 220, "Modelo Layout:", 16250357)
    draw_text(mem_dc, font_regular, 595, 220, "Box Model Flexbox Automatico", 13151654)
    draw_text(mem_dc, font_bold, 474, 248, "Plataformas:", 16250357)
    draw_text(mem_dc, font_regular, 595, 248, "Windows, Linux e macOS", 16230091)
    draw_text(mem_dc, font_bold, 474, 276, "Tipografia:", 16250357)
    draw_text(mem_dc, font_regular, 595, 276, "ClearType Anti-Aliasing Nitido", 13151654)
    draw_text(mem_dc, font_bold, 474, 304, "Eventos:", 16250357)
    draw_text(mem_dc, font_regular, 595, 304, "Mouse, Cliques e Teclado", 13151654)
    draw_text(mem_dc, font_bold, 474, 332, "Integracao:", 16250357)
    draw_text(mem_dc, font_regular, 595, 332, "100% Nativo sem Wrappers", 10609574)

    draw_card(mem_dc, 32, 392, 836, 155, 2693912, 4731181, 12)
    draw_text(mem_dc, font_h2, 48, 408, "Telemetria do Sistema e Carregamento Magma", 8893434)
    draw_text(mem_dc, font_regular, 48, 436, "Carga dos Subsistemas (Reservoir, Facet, Matrix, Pulse):", 16250357)
    draw_badge(mem_dc, font_small, 690, 434, 162, 22, status_text, 10609574, 1314060)

    draw_progress(mem_dc, 48, 466, 804, 20, progress_val, 3549736, 10609574)

    draw_card(mem_dc, 48, 496, 804, 36, 1051145, 4731181, 6)
    draw_text(mem_dc, font_small, 58, 506, "[OFS-CORE] Modulos Magma ativos. Compilacao direta sem Clang. Zero memory leaks.", 13151654)

    draw_btn_state(mem_dc, font_bold, 32, 565, 195, 42, "Executar Benchmark", 1, hover_id, 16430217, 16694206, 16430217, 16777215, 1314060)
    draw_btn_state(mem_dc, font_bold, 245, 565, 195, 42, "Testar Reservoir", 2, hover_id, 10609574, 13169824, 10609574, 16777215, 1314060)
    draw_btn_state(mem_dc, font_bold, 458, 565, 195, 42, "Sobre o OFS", 3, hover_id, 16230091, 16566268, 16230091, 16777215, 1314060)
    draw_btn_state(mem_dc, font_bold, 673, 565, 195, 42, "Fechar", 4, hover_id, 11045875, 13153528, 11045875, 16777215, 1314060)

    draw_text(mem_dc, font_small, 32, 626, "Obsidian Fault Script (OFS) - Criado por Samwns e comunidade. Layout declarativo OLL.", 13151654)

    BitBlt(hdc, 0, 0, 908, 680, mem_dc, 0, 0, 13369376)

    DeleteObject(font_title)
    DeleteObject(font_h2)
    DeleteObject(font_bold)
    DeleteObject(font_regular)
    DeleteObject(font_small)

    SelectObject(mem_dc, old_bmp)
    DeleteObject(mem_bmp)
    DeleteDC(mem_dc)
    ReleaseDC(hwnd, hdc)
}

vein main() -> void {
    forge hInst = GetModuleHandleA(null)

    forge sw = GetSystemMetrics(0)
    forge sh = GetSystemMetrics(1)
    forge init_w: stone = 920
    forge init_h: stone = 710
    forge wx = (sw - init_w) / 2
    forge wy = (sh - init_h) / 2
    if (wx < 0) { wx = 0 }
    if (wy < 0) { wy = 0 }

    forge WS_FIXED = 13238272
    forge WS_VISIBLE = 268435456
    forge SS_NOTIFY = 256

    forge main_hwnd = CreateWindowExA(0, "STATIC", "Obsidian Fault Script (OFS) - Control Center & OLL Studio", WS_FIXED | WS_VISIBLE | SS_NOTIFY, wx, wy, init_w, init_h, null, null, hInst, null)
    if (main_hwnd == null) {
        ExitProcess(1)
    }

    forge hCurArrow = LoadCursorA(null, 32512)
    forge hCurHand = LoadCursorA(null, 32649)
    forge cur_cursor = hCurArrow
    SetCursor(cur_cursor)

    ShowWindow(main_hwnd, 5)
    UpdateWindow(main_hwnd)
    SetCursor(cur_cursor)

    forge cur_progress: stone = 94
    forge cur_status: obsidian = "94% NOMINAL"
    forge hover_id: stone = 0

    render_ui(main_hwnd, cur_progress, cur_status, hover_id)

    forge pt: *stone = ofs_alloc(16)
    forge msg: *stone = ofs_alloc(96)
    forge has_msg = GetMessageA(msg, null, 0, 0)
    while (has_msg > 0) {
        forge msg_id = _load_stone(fault_step(msg, 1)) & 65535
        if (msg_id == 16 || msg_id == 2) {
            ExitProcess(0)
        }

        if (msg_id == 32) {
            SetCursor(cur_cursor)
            has_msg = GetMessageA(msg, null, 0, 0)
            continue
        }

        if (msg_id == 20) {
            has_msg = GetMessageA(msg, null, 0, 0)
            continue
        }

        if (msg_id == 15) {
            ValidateRect(main_hwnd, null)
            render_ui(main_hwnd, cur_progress, cur_status, hover_id)
            has_msg = GetMessageA(msg, null, 0, 0)
            continue
        }

        GetCursorPos(pt)
        ScreenToClient(main_hwnd, pt)
        forge pt_val = _load_stone(pt)
        forge mx = pt_val & 65535
        forge my = (pt_val >> 32) & 65535

        forge in_bounds: stone = 1
        if (mx > 32767 || mx > 908 || my > 32767 || my > 680) {
            in_bounds = 0
        }

        forge new_hover: stone = 0
        if (in_bounds == 1 && my >= 565 && my <= 607) {
            if (mx >= 32 && mx <= 227) { new_hover = 1 }
            else if (mx >= 245 && mx <= 440) { new_hover = 2 }
            else if (mx >= 458 && mx <= 653) { new_hover = 3 }
            else if (mx >= 673 && mx <= 868) { new_hover = 4 }
        }

        if (new_hover != hover_id) {
            hover_id = new_hover
            if (hover_id > 0) {
                cur_cursor = hCurHand
            } else {
                cur_cursor = hCurArrow
            }
            SetCursor(cur_cursor)
            render_ui(main_hwnd, cur_progress, cur_status, hover_id)
        }

        if (msg_id == 513) {
            if (hover_id == 1) {
                cur_progress = 100
                cur_status = "100% CONCLUIDO"
                render_ui(main_hwnd, cur_progress, cur_status, hover_id)
                MessageBoxA(main_hwnd, "Benchmark executado com sucesso!\n\nWorkload: Fibonacci iterativo 5.000.000 iteracoes\nTempo mediano: 4.6 ms\nStatus: Determinismo estrito verificado!\nRuntime: Stack Magma puro.", "OFS Benchmark", 64)
            } else if (hover_id == 2) {
                forge p = ofs_alloc(4096)
                ofs_free(p)
                cur_status = "RESERVOIR OK"
                render_ui(main_hwnd, cur_progress, cur_status, hover_id)
                MessageBoxA(main_hwnd, "Teste de memoria Reservoir realizado com sucesso!\n\nAlocador: Reservoir nativo OFS\nAlocacao: 4096 bytes alocados e liberados com sucesso.\nStatus: Zero vazamento de memoria.", "Reservoir Heap Test", 64)
            } else if (hover_id == 3) {
                MessageBoxA(main_hwnd, "Obsidian Fault Script (OFS) v1.0.137\n\n- Compilador: 100% self-hosted em OFS\n- Backend: LLVM IR SSA (Zero Clang)\n- Motor Visual: OLL Declarative 60 FPS\n- Multiplataforma: Linux, Windows e macOS\n- Criado por Samwns e comunidade.", "Sobre o OFS", 64)
            } else if (hover_id == 4) {
                ExitProcess(0)
            }
        }

        TranslateMessage(msg)
        DispatchMessageA(msg)
        has_msg = GetMessageA(msg, null, 0, 0)
    }

    ExitProcess(0)
}
