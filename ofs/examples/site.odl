page "OFS Native Web Languages" "en"
skin "site.css"
flow
  deck.topbar
    strong "Obsidian Fault Script"
    link.docs "Documentation" "#content"
  stage#content
    band.hero
      title1 "ODL + OES"
      mark "Build **documents**, `components`, and native-hosted sites."
      raw "<small>Raw HTML remains available when interoperability matters.</small>"
    band.grid
      tile.card
        title2 "ODL"
        text "Document structure with an indentation-based syntax."
      tile.card
        title2 "OES"
        text "Tokens, visual rules, responsive behavior, and motion."
  spark "app.js"
