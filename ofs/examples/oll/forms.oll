window UserForm {
    title: "User Profile Form"
    width: 500
    height: 420
    background: #181825

    column {
        padding: 24
        gap: 12
        label "Create Account" { color: #cdd6f4 }
        label "Username:" { color: #a6adc8 }
        input { id: "txt_username", bind: "username", width: 440, height: 30, background: #11111b, color: #cdd6f4, border: 1 }
        label "Email Address:" { color: #a6adc8 }
        input { id: "txt_email", bind: "email", width: 440, height: 30, background: #11111b, color: #cdd6f4, border: 1 }
        row {
            height: 36
            gap: 10
            button "Register" { id: "btn_submit", width: 120, height: 32, background: #a6e3a1, color: #11111b, on_click: do_register }
            button "Cancel" { id: "btn_cancel", width: 100, height: 32, on_click: do_cancel }
        }
    }
}
