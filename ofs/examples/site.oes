gem ink "#eef6ff"
gem paper "#070a0f"
gem accent "#29e0bd"

paint body
  margin "0"
  fill "$paper"
  ink "$ink"
  font-family "system-ui, sans-serif"

paint .topbar
  flow "flex"
  justify "space-between"
  padding "18px"
  border-bottom "1px solid #263244"

paint .hero
  padding "72px 24px"

paint .grid
  flow "grid"
  grid-cols "repeat(2, minmax(0, 1fr))"
  space "16px"

paint .card
  padding "20px"
  curve "8px"
  fill "#101722"
  transition "transform .2s ease"

veil "(max-width: 700px)"
  paint .grid
    grid-cols "1fr"

pulse "enter"
  rise
    opacity "0"
  rest
    opacity "1"
