// OFS Compiler — AST Interpreter Backend
// Direct evaluation backend executing typed AST without LLVM or C dependencies
// claim em forma de comentario: a semente (ofs/dist/ofscc) e anterior a onda 5
//! claim rift, abyss
//
// Memoria (A6): no codigo gerado pelo ofscc todo `forge x: <monolith>` (e toda
// copia `forge n: Node = node_get(id)`) vira um ofs_alloc que nunca e liberado.
// A versao anterior criava ~40 desses por chamada de funcao interpretada
// (Value de 56 B, Node de 80 B, Location), ~3 KB por chamada e ~4 KB por volta
// de laco. Por isso este interpretador NAO usa monolith nos caminhos quentes:
//   - o valor corrente vive em "registradores" globais (_rk/_rt/_ri/_rf/_rb/
//     _rs/_rr); eval_expr() escreve neles e os chamadores guardam o que
//     precisam em locais primitivos (alloca, sem heap);
//   - a AST e copiada uma vez, no inicio, para tabelas paralelas por no
//     (_nk/_nval/_nc0.. ) com o operador ja decodificado (_nop) e literais e
//     chamadas ja resolvidos (_naux/_nf);
//   - variaveis sao procuradas por id de simbolo (inteiro), nao por nome;
//   - arrays interpretados guardam so as colunas que diferem do padrao
//     (um Array<stone> de inteiros e um unico array nativo, nao sete).
// Strings novas (concatenacao, conversao) continuam sem liberacao, como no
// codigo nativo.
//
// Memoria crua (F2 de plans/INTERPRETADOR_PARIDADE.md): o processo do
// interpretador e nativo, entao ponteiro = endereco real (VAL_INT com tipo
// "*T"). `*p`/`*p = v` leem e escrevem pela largura do tipo apontado (o
// tipo estatico do typeck, como no llvmgen); `&x` de uma variavel muda a
// variavel para um slot de memoria crua (VAL_BOXED) que o C pode ler e
// escrever; monoliths vivem em memoria crua com o layout C do llvmgen
// (llvmgen.struct_layout) e o valor VAL_OBJECT e o endereco; Array vai ao C
// como o proprio ofs_array nativo da coluna de valores; `fault_addr` de uma
// vein interpretada devolve um trampolim nativo (__ofs_cb_K) que reentra no
// interpretador.

attach {F:ast.ofs}
attach {F:symbols.ofs}
attach {F:fossil.ofs}

extern vein ofs_str_len(s: obsidian) -> stone
extern vein ofs_str_eq(a: obsidian, b: obsidian) -> bool
extern vein ofs_str_concat(a: obsidian, b: obsidian) -> obsidian
extern vein ofs_str_char_at(s: obsidian, idx: stone) -> stone
extern vein ofs_str_substr(s: obsidian, start: stone, len: stone) -> obsidian
extern vein ofs_str_contains(haystack: obsidian, needle: obsidian) -> bool
extern vein ofs_stone_to_obsidian(v: stone) -> obsidian
extern vein ofs_crystal_to_obsidian(v: crystal) -> obsidian
extern vein ofs_pow(base: crystal, exp: crystal) -> crystal
extern vein ofs_sqrt(v: crystal) -> crystal
extern vein exit(code: stone) -> void
extern vein raise(sig: stone) -> stone

// FFI (F1): funcoes C resolvidas por endereco no carregamento. dlsym/dlopen
// estao na libc (glibc >= 2.34, bionic, macOS); glibc antiga precisa de -ldl
// no link do ofscc. __ofs_ffi_dispatch e DEFINIDA pelo llvmgen no modulo que
// a declara (trampolins tipados) e procurada por dlsym, nunca chamada direto:
// assim um ofscc gerado por um compilador antigo ainda liga (so sem floats).
extern vein dlsym(handle: stone, name: obsidian) -> stone
extern vein dlopen(path: obsidian, flags: stone) -> stone
extern vein write(fd: stone, buf: obsidian, n: stone) -> stone
extern vein __ofs_ffi_dispatch(fn: stone, sig: stone, buf: stone) -> stone
// Callbacks C -> OFS (F2): o llvmgen DEFINE __ofs_cb_table e os trampolins
// __ofs_cb_K no modulo que a declara; o interpretador a acha por dlsym (um
// ofscc gerado por compilador antigo liga, so sem callbacks).
extern vein __ofs_cb_table(slot: stone) -> stone
extern vein memset(dst: *u8, v: stone, n: stone) -> *u8
// execucao hibrida (F5): apagar o .ll temporario (C padrao)
extern vein remove(path: obsidian) -> stone
extern vein rmdir(path: obsidian) -> stone
extern vein getpid() -> stone

// ── Value System ──────────────────────────────────────────────────────────

forge VAL_VOID: stone = 0
forge VAL_INT: stone = 1
forge VAL_FLOAT: stone = 2
forge VAL_BOOL: stone = 3
forge VAL_STRING: stone = 4
forge VAL_ARRAY: stone = 5
forge VAL_OBJECT: stone = 6
forge VAL_POINTER: stone = 7
forge VAL_NULL: stone = 8
forge VAL_VARIANT: stone = 9
// variavel cujo endereco foi tomado (&x): o valor vive em memoria crua;
// _env_i = endereco, _env_type = tipo, _env_ref = classe de memoria (MC_*)
forge VAL_BOXED: stone = 10
// valor de vein (F6): _rt = tipo vein(...), _rr = vein interpretada (id do
// no da declaracao) ou -1, _ri = endereco nativo (extern, ou vindo do C),
// _rs = nome da vein ("" se o endereco nao tem nome no programa)
forge VAL_FN: stone = 11

forge EXEC_OK: stone = 0
forge EXEC_RETURN: stone = 1
forge EXEC_BREAK: stone = 2
forge EXEC_CONTINUE: stone = 3
forge EXEC_THROW: stone = 4

forge LOC_INVALID: stone = 0
forge LOC_VAR: stone = 1
forge LOC_ARRAY: stone = 2
forge LOC_FIELD: stone = 3
forge LOC_MEM: stone = 4

// Classe de memoria de um tipo: largura e conversao de leitura/escrita em
// memoria crua (ponteiro, campo de monolith, variavel com endereco)
forge MC_I64: stone = 0
forge MC_I32: stone = 1
forge MC_U32: stone = 2
forge MC_I16: stone = 3
forge MC_U16: stone = 4
forge MC_I8: stone = 5
forge MC_U8: stone = 6
forge MC_BOOL: stone = 7
forge MC_F64: stone = 8
forge MC_F32: stone = 9
forge MC_STR: stone = 10
forge MC_PTR: stone = 11
forge MC_ARRAY: stone = 12
forge MC_OBJ: stone = 13
forge MC_VARIANT: stone = 14
// valor de vein em memoria crua: endereco nativo, ou -(id+1) para uma vein
// interpretada (o C recebe trampolim quando o valor vai como argumento)
forge MC_FN: stone = 15

// Operadores decodificados uma vez (antes: ofs_str_eq por avaliacao e
// ofs_str_substr — que aloca — em todo `x += 1`).
forge OP_NONE: stone = 0
forge OP_ASSIGN: stone = 1
forge OP_ADD_ASSIGN: stone = 2
forge OP_SUB_ASSIGN: stone = 3
forge OP_MUL_ASSIGN: stone = 4
forge OP_DIV_ASSIGN: stone = 5
forge OP_MOD_ASSIGN: stone = 6
forge OP_LAND: stone = 7
forge OP_LOR: stone = 8
forge OP_EQ: stone = 9
forge OP_NE: stone = 10
forge OP_LT: stone = 11
forge OP_LE: stone = 12
forge OP_GT: stone = 13
forge OP_GE: stone = 14
forge OP_ADD: stone = 15
forge OP_SUB: stone = 16
forge OP_MUL: stone = 17
forge OP_DIV: stone = 18
forge OP_MOD: stone = 19
forge OP_BAND: stone = 20
forge OP_BOR: stone = 21
forge OP_BXOR: stone = 22
forge OP_SHL: stone = 23
forge OP_SHR: stone = 24
forge OP_ADDR: stone = 25
forge OP_DEREF: stone = 26
forge OP_NEG: stone = 27
forge OP_NOT: stone = 28
forge OP_BNOT: stone = 29
forge OP_TRY: stone = 30
forge OP_INC: stone = 31
forge OP_DEC: stone = 32

forge CAST_OTHER: stone = 0
forge CAST_STONE: stone = 1
forge CAST_CRYSTAL: stone = 2
forge CAST_BOOL: stone = 3
forge CAST_OBSIDIAN: stone = 4

forge CALL_BUILTIN: stone = 1
forge CALL_VARIANT: stone = 2
forge CALL_FN: stone = 3
forge CALL_DYN: stone = 4
forge CALL_EXTERN: stone = 5
// chamada de valor de vein (F6): NK_CALL "__vein_call", c0 = a vein
forge CALL_VEIN: stone = 6

// Classe de tipo de um parametro/retorno de `extern vein` (FFI)
forge TC_INT: stone = 0
forge TC_I32: stone = 1
forge TC_U32: stone = 2
forge TC_I16: stone = 3
forge TC_U16: stone = 4
forge TC_I8: stone = 5
forge TC_U8: stone = 6
forge TC_BOOL: stone = 7
forge TC_F64: stone = 8
forge TC_STR: stone = 9
forge TC_PTR: stone = 10
forge TC_VOID: stone = 11
forge TC_F32: stone = 12
forge TC_AGG: stone = 13

forge BI_NONE: stone = 0
forge BI_ECHO: stone = 1
forge BI_ETCH: stone = 2
forge BI_ETCHLN: stone = 3
forge BI_MOLD: stone = 4
forge BI_EXIT: stone = 5
forge BI_STR_LEN: stone = 6
forge BI_STR_EQ: stone = 7
forge BI_STR_CONCAT: stone = 8
forge BI_STR_CHAR_AT: stone = 9
forge BI_STR_SUBSTR: stone = 10
forge BI_STR_CONTAINS: stone = 11
forge BI_STONE_TO_OBS: stone = 12
forge BI_CRYSTAL_TO_OBS: stone = 13
forge BI_OBS_TO_STONE: stone = 14
forge BI_ARRAY_NEW: stone = 15
forge BI_ARRAY_LEN: stone = 16
forge BI_ARRAY_PUSH: stone = 17
forge BI_ARRAY_GET: stone = 18
forge BI_ARRAY_SET: stone = 19
forge BI_ARRAY_POP: stone = 20
forge BI_POW: stone = 21
forge BI_SQRT: stone = 22
forge BI_FAULT_COUNT: stone = 23
forge BI_FAULT_LEAD: stone = 24
forge BI_FAULT_TRAIL: stone = 25
forge BI_FAULT_SPIN_L: stone = 26
forge BI_FAULT_SPIN_R: stone = 27
forge BI_FAULT_WEAVE: stone = 28
forge BI_FAULT_SWAP: stone = 29
forge BI_FAULT_CUT: stone = 30
forge BI_FAULT_PATCH: stone = 31
forge BI_FAULT_NOP: stone = 32
forge BI_FAULT_TRAP: stone = 33
forge BI_FAULT_MEMCPY: stone = 34
forge BI_FAULT_MEMSET: stone = 35
forge BI_FAULT_ADDR: stone = 36
forge BI_FAULT_CALL: stone = 37
forge BI_FAULT_STEP: stone = 38
// conversoes para texto inseridas pelo typeck (F3); iguais ao llvmgen
forge BI_VARIANT_NAME: stone = 39
forge BI_BOOL_TEXT: stone = 40
forge BI_VEIN_NAME: stone = 41
// A5.1: contrato violado (inserido por contracts.ofs; igual ao nativo)
forge BI_CONTRACT_FAIL: stone = 42
// A5.3: texto que sai de um bedrock (copia se estiver numa arena)
forge BI_BEDROCK_LIFT: stone = 43

// Colunas de um array interpretado (bitmask em _arr_mask)
forge COL_KIND: stone = 1
forge COL_TYPE: stone = 2
forge COL_I: stone = 4
forge COL_F: stone = 8
forge COL_B: stone = 16
forge COL_S: stone = 32
forge COL_REF: stone = 64

namespace interpreter {

    // ── Global Interpreter State ──────────────────────────────────────────
    // `?` com falha: vein em execucao e pedido de saida antecipada
    forge _cur_fn_id: stone = -1
    forge _try_unwind: bool = false

    // Registradores do valor corrente (resultado da ultima avaliacao)
    forge _rk: stone = 0
    forge _rt: obsidian = "void"
    forge _ri: stone = 0
    forge _rf: crystal = 0.0
    forge _rb: bool = false
    forge _rs: obsidian = ""
    forge _rr: stone = -1

    // Registradores de lvalue (resultado de eval_lvalue)
    forge _lk: stone = 0
    forge _lvar: stone = -1
    forge _lh: stone = -1
    forge _lidx: stone = -1
    forge _lfield: obsidian = ""

    // Tabelas da AST (copiadas do _node_pool uma vez por execucao)
    forge _n_count: stone = 0
    forge _nk: Array<stone> = []
    forge _nval: Array<obsidian> = []
    forge _ntype: Array<obsidian> = []
    forge _nc0: Array<stone> = []
    forge _nc1: Array<stone> = []
    forge _nc2: Array<stone> = []
    forge _nc3: Array<stone> = []
    forge _nx: Array<Array> = []
    forge _nop: Array<stone> = []
    forge _naux: Array<stone> = []
    forge _nf: Array<crystal> = []
    forge _nsym: Array<stone> = []
    forge _empty_extra: Array<stone> = []

    // Chamadas dinamicas (metodo `obj.m`/`obj__m` resolvido pelo tipo em
    // tempo de execucao): partes do nome e cache do ultimo tipo visto.
    forge _dyn_name: Array<obsidian> = []
    forge _dyn_has_sep: Array<bool> = []
    forge _dyn_var_sym: Array<stone> = []
    forge _dyn_method: Array<obsidian> = []
    forge _dyn_cache_type: Array<obsidian> = []
    forge _dyn_cache_fn: Array<stone> = []
    forge _dyn_cache_ok: Array<bool> = []
    forge _dyn_errmsg: Array<obsidian> = []

    // Tabela de simbolos (nomes de variaveis -> id)
    forge _sym_names: Array<obsidian> = []

    // Environment (scoped variables stored in parallel arrays of primitive types)
    forge _env_sym: Array<stone> = []
    forge _env_kind: Array<stone> = []
    forge _env_type: Array<obsidian> = []
    forge _env_i: Array<stone> = []
    forge _env_f: Array<crystal> = []
    forge _env_b: Array<bool> = []
    forge _env_s: Array<obsidian> = []
    forge _env_ref: Array<stone> = []
    forge _env_depth: Array<stone> = []
    forge _scope_depth: stone = 0
    forge _globals_count: stone = 0
    forge _current_frame_base: stone = 0
    forge _anchor_nodes: Array<stone> = []
    forge _anchor_depths: Array<stone> = []

    // Heap Arrays: por instancia, comprimento + mascara de colunas presentes.
    // Coluna ausente = todos os elementos tem o valor padrao dela
    // (kind=VAL_INT, type=nome canonico do kind, i=0, f=0.0, b=false, s="",
    // ref=-1). _arr_nocol e a sentinela (nunca escrita) das colunas ausentes.
    forge _arr_len: Array<stone> = []
    forge _arr_mask: Array<stone> = []
    forge _arr_ck: Array<Array> = []
    forge _arr_ct: Array<Array> = []
    forge _arr_ci: Array<Array> = []
    forge _arr_cf: Array<Array> = []
    forge _arr_cb: Array<Array> = []
    forge _arr_cs: Array<Array> = []
    forge _arr_cr: Array<Array> = []
    forge _arr_nocol: Array<stone> = []

    // Variaveis com endereco (VAL_BOXED) vivas: 0 = caminho rapido sem checar
    forge _boxed_live: stone = 0

    // Function Registry
    forge _func_names: Array<obsidian> = []
    forge _func_node_ids: Array<stone> = []

    // Monolith Type Registry. Instancias sao blocos de memoria crua (o
    // VAL_OBJECT guarda o endereco) com o layout C de llvmgen.struct_layout;
    // os campos de um tipo sao contiguos nas tabelas _mono_field_*.
    forge _mono_names: Array<obsidian> = []
    forge _mono_ffirst: Array<stone> = []
    forge _mono_fcount: Array<stone> = []
    forge _mono_size: Array<stone> = []
    forge _mono_field_owners: Array<obsidian> = []
    forge _mono_field_names: Array<obsidian> = []
    forge _mono_field_types: Array<obsidian> = []
    forge _mono_field_offs: Array<stone> = []
    forge _mono_field_cls: Array<stone> = []
    // variantes em ordem de declaracao (etiqueta numerica = posicao)
    forge _variant_names: Array<obsidian> = []
    forge _strata_names: Array<obsidian> = []

    // Call Argument Stack
    forge _arg_kinds: Array<stone> = []
    forge _arg_types: Array<obsidian> = []
    forge _arg_i: Array<stone> = []
    forge _arg_f: Array<crystal> = []
    forge _arg_b: Array<bool> = []
    forge _arg_s: Array<obsidian> = []
    forge _arg_refs: Array<stone> = []

    // Return Value Register
    forge _ret_kind: stone = 0
    forge _ret_type: obsidian = "void"
    forge _ret_i: stone = 0
    forge _ret_f: crystal = 0.0
    forge _ret_b: bool = false
    forge _ret_s: obsidian = ""
    forge _ret_ref: stone = -1

    // FFI: tabela das `extern vein`/`rift vein` (montada no carregamento)
    forge _ext_names: Array<obsidian> = []
    forge _ext_syms: Array<obsidian> = []
    forge _ext_nodes: Array<stone> = []
    forge _ext_addr: Array<stone> = []
    forge _ext_vfix: Array<stone> = []
    forge _ext_pcls: Array<Array> = []
    forge _ext_rcls: Array<stone> = []
    forge _ext_rtype: Array<obsidian> = []
    forge _ffi_ready: bool = false
    forge _ffi_buf: stone = 0
    forge _ffi_disp: stone = 0
    forge _ffi_exports: bool = false
    forge _ffi_libs: obsidian = ""
    forge _ffi_ui_libs: bool = false
    // Arrays passados ao C na chamada em curso (comprimento sincronizado na volta)
    forge _ffi_sync_h: Array<stone> = []
    forge _ffi_sync_c: Array<stone> = []
    forge _arr_last_col: stone = 0
    // Callbacks: slot K -> vein interpretada (ver cb_slot_for)
    forge _cb_table: stone = 0
    forge _cb_fn: Array<stone> = []
    forge _cb_pcls: Array<Array> = []
    forge _cb_ptypes: Array<Array> = []
    forge _cb_rcls: Array<stone> = []
    forge _cb_addr: Array<stone> = []
    // onda 4: callbacks com crystal/f32 (trampolins __ofs_cbx_K)
    forge _cb_float: Array<bool> = []
    forge _cbx_table: stone = 0
    forge _cbx_checked: bool = false
    forge _fbits_scr: stone = 0
    // extern usada como valor de vein (F6): nome de um endereco vindo do C
    forge _ext_vref: Array<bool> = []
    // no da chamada em curso (fault_step le o tipo estatico do argumento)
    forge _cur_call_id: stone = -1

    // ── Value Registers ───────────────────────────────────────────────────

    vein r_set(k: stone, t: obsidian, i: stone, f: crystal, b: bool, s: obsidian, r: stone) -> void {
        _rk = k
        _rt = t
        _ri = i
        _rf = f
        _rb = b
        _rs = s
        _rr = r
    }

    vein r_void() -> void { r_set(VAL_VOID, "void", 0, 0.0, false, "", -1) }
    vein r_int(i: stone) -> void { r_set(VAL_INT, "stone", i, 0.0, false, "", -1) }
    vein r_float(f: crystal) -> void { r_set(VAL_FLOAT, "crystal", 0, f, false, "", -1) }
    vein r_bool(b: bool) -> void { r_set(VAL_BOOL, "bool", 0, 0.0, b, "", -1) }
    vein r_string(s: obsidian) -> void { r_set(VAL_STRING, "obsidian", 0, 0.0, false, s, -1) }
    vein r_array(h: stone) -> void { r_set(VAL_ARRAY, "Array", 0, 0.0, false, "", h) }
    vein r_object(type_name: obsidian, h: stone) -> void { r_set(VAL_OBJECT, type_name, 0, 0.0, false, "", h) }
    vein r_null() -> void { r_set(VAL_NULL, "null", 0, 0.0, false, "", -1) }

    // Variante `tag` com o valor dos registradores como payload
    vein r_variant(tag: obsidian) -> void {
        forge pk = _rk
        forge pi = _ri
        forge pf: crystal = _rf
        forge pb = _rb
        forge ps: obsidian = _rs
        forge pr = _rr
        r_set(VAL_VARIANT, tag, 0, 0.0, false, tag, -1)
        if (pk == VAL_INT) { _ri = pi }
        else if (pk == VAL_FLOAT) { _rf = pf }
        else if (pk == VAL_BOOL) { _rb = pb }
        else if (pk == VAL_STRING) { _rs = ps }
        else if (pk == VAL_OBJECT || pk == VAL_ARRAY || pk == VAL_POINTER || pk == VAL_NULL) {
            _rr = pr
        }
    }

    // Nome de tipo que os construtores de valor usam para cada kind
    vein kind_type_name(k: stone) -> obsidian {
        if (k == VAL_INT) { return "stone" }
        if (k == VAL_FLOAT) { return "crystal" }
        if (k == VAL_BOOL) { return "bool" }
        if (k == VAL_STRING) { return "obsidian" }
        if (k == VAL_ARRAY) { return "Array" }
        if (k == VAL_NULL) { return "null" }
        if (k == VAL_VOID) { return "void" }
        if (k == VAL_POINTER) { return "ptr" }
        return ""
    }

    // ── Value Inspection ──────────────────────────────────────────────────

    vein val_str(k: stone, t: obsidian, i: stone, f: crystal, b: bool, s: obsidian) -> obsidian {
        if (k == VAL_VOID) { return "" }
        if (k == VAL_INT) { return ofs_stone_to_obsidian(i) }
        if (k == VAL_FLOAT) {
            return ofs_crystal_to_obsidian(f)
        }
        if (k == VAL_BOOL) {
            if (b) { return "true" }
            return "false"
        }
        if (k == VAL_STRING) { return s }
        if (k == VAL_ARRAY) { return "[array]" }
        if (k == VAL_OBJECT) { return "[" + t + "]" }
        if (k == VAL_POINTER) { return "*ptr" }
        if (k == VAL_NULL) { return "null" }
        if (k == VAL_VARIANT) { return t }
        if (k == VAL_FN) {
            if (ofs_str_len(s) > 0) { return vein_display_name(s) }
            return "<vein>"
        }
        return ""
    }

    vein r_to_string() -> obsidian {
        return val_str(_rk, _rt, _ri, _rf, _rb, _rs)
    }

    vein val_truthy(k: stone, i: stone, f: crystal, b: bool, s: obsidian, r: stone) -> bool {
        if (k == VAL_BOOL) { return b }
        if (k == VAL_INT) { return i != 0 }
        if (k == VAL_FLOAT) { return f != 0.0 }
        if (k == VAL_STRING) { return ofs_str_len(s) > 0 }
        if (k == VAL_ARRAY) { return r >= 0 }
        if (k == VAL_OBJECT) { return r >= 0 }
        if (k == VAL_POINTER) { return r >= 0 }
        if (k == VAL_NULL) { return false }
        if (k == VAL_VOID) { return false }
        if (k == VAL_VARIANT) { return true }
        if (k == VAL_FN) { return true }
        return false
    }

    vein r_truthy() -> bool {
        return val_truthy(_rk, _ri, _rf, _rb, _rs, _rr)
    }

    // ── Return Value Helpers ──────────────────────────────────────────────

    vein set_return_from_regs() -> void {
        _ret_kind = _rk
        _ret_type = _rt
        _ret_i = _ri
        _ret_f = _rf
        _ret_b = _rb
        _ret_s = _rs
        _ret_ref = _rr
    }

    vein regs_from_return() -> void {
        r_set(_ret_kind, _ret_type, _ret_i, _ret_f, _ret_b, _ret_s, _ret_ref)
    }

    // ── Number and Text Parsing ───────────────────────────────────────────

    vein parse_int(s: obsidian) -> stone {
        forge len = ofs_str_len(s)
        if (len == 0) { return 0 }
        forge res = 0
        forge i = 0
        forge neg = false
        if (ofs_str_char_at(s, 0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            forge c = ofs_str_char_at(s, i)
            if (c >= 48 && c <= 57) {
                res = res * 10 + (c - 48)
            } else {
                break
            }
            i++
        }
        if (neg) { return 0 - res }
        return res
    }

    vein parse_float(s: obsidian) -> crystal {
        forge len = ofs_str_len(s)
        if (len == 0) { return 0.0 }
        forge res: crystal = 0.0
        forge i = 0
        forge neg = false
        if (ofs_str_char_at(s, 0) == 45) {
            neg = true
            i = 1
        }
        forge in_dec = false
        forge dec_div: crystal = 10.0
        while (i < len) {
            forge c = ofs_str_char_at(s, i)
            if (c == 46) {
                in_dec = true
                i++
                break
            }
            if (c >= 48 && c <= 57) {
                res = res * 10.0 + ((c - 48) as crystal)
            } else {
                break
            }
            i++
        }
        if (in_dec) {
            while (i < len) {
                forge c2 = ofs_str_char_at(s, i)
                if (c2 >= 48 && c2 <= 57) {
                    res = res + (((c2 - 48) as crystal) / dec_div)
                    dec_div = dec_div * 10.0
                } else {
                    break
                }
                i++
            }
        }
        if (neg) { return 0.0 - res }
        return res
    }

    // ── AST Tables ────────────────────────────────────────────────────────

    vein bin_op_code(op: obsidian) -> stone {
        if (ofs_str_eq(op, "=")) { return OP_ASSIGN }
        if (ofs_str_eq(op, "+=")) { return OP_ADD_ASSIGN }
        if (ofs_str_eq(op, "-=")) { return OP_SUB_ASSIGN }
        if (ofs_str_eq(op, "*=")) { return OP_MUL_ASSIGN }
        if (ofs_str_eq(op, "/=")) { return OP_DIV_ASSIGN }
        if (ofs_str_eq(op, "%=")) { return OP_MOD_ASSIGN }
        if (ofs_str_eq(op, "&&")) { return OP_LAND }
        if (ofs_str_eq(op, "||")) { return OP_LOR }
        if (ofs_str_eq(op, "==")) { return OP_EQ }
        if (ofs_str_eq(op, "!=")) { return OP_NE }
        if (ofs_str_eq(op, "<")) { return OP_LT }
        if (ofs_str_eq(op, "<=")) { return OP_LE }
        if (ofs_str_eq(op, ">")) { return OP_GT }
        if (ofs_str_eq(op, ">=")) { return OP_GE }
        if (ofs_str_eq(op, "+")) { return OP_ADD }
        if (ofs_str_eq(op, "-")) { return OP_SUB }
        if (ofs_str_eq(op, "*")) { return OP_MUL }
        if (ofs_str_eq(op, "/")) { return OP_DIV }
        if (ofs_str_eq(op, "%")) { return OP_MOD }
        if (ofs_str_eq(op, "&")) { return OP_BAND }
        if (ofs_str_eq(op, "|")) { return OP_BOR }
        if (ofs_str_eq(op, "^")) { return OP_BXOR }
        if (ofs_str_eq(op, "<<")) { return OP_SHL }
        if (ofs_str_eq(op, ">>")) { return OP_SHR }
        return OP_NONE
    }

    vein unary_op_code(op: obsidian) -> stone {
        if (ofs_str_eq(op, "&")) { return OP_ADDR }
        if (ofs_str_eq(op, "*")) { return OP_DEREF }
        if (ofs_str_eq(op, "-")) { return OP_NEG }
        if (ofs_str_eq(op, "!")) { return OP_NOT }
        if (ofs_str_eq(op, "~")) { return OP_BNOT }
        return OP_NONE
    }

    vein post_op_code(op: obsidian) -> stone {
        if (ofs_str_eq(op, "?")) { return OP_TRY }
        if (ofs_str_eq(op, "++")) { return OP_INC }
        return OP_DEC
    }

    vein cast_code(t: obsidian) -> stone {
        if (ofs_str_eq(t, "stone")) { return CAST_STONE }
        if (ofs_str_eq(t, "crystal")) { return CAST_CRYSTAL }
        if (ofs_str_eq(t, "bool")) { return CAST_BOOL }
        if (ofs_str_eq(t, "obsidian")) { return CAST_OBSIDIAN }
        return CAST_OTHER
    }

    // intrinsecos fault_* (mesma semantica do llvmgen, em 64 bits)
    vein fault_code(name: obsidian) -> stone {
        if (ofs_str_eq(name, "fault_count")) { return BI_FAULT_COUNT }
        if (ofs_str_eq(name, "fault_lead")) { return BI_FAULT_LEAD }
        if (ofs_str_eq(name, "fault_trail")) { return BI_FAULT_TRAIL }
        if (ofs_str_eq(name, "fault_spin_left")) { return BI_FAULT_SPIN_L }
        if (ofs_str_eq(name, "fault_spin_right")) { return BI_FAULT_SPIN_R }
        if (ofs_str_eq(name, "fault_weave")) { return BI_FAULT_WEAVE }
        if (ofs_str_eq(name, "fault_swap")) { return BI_FAULT_SWAP }
        if (ofs_str_eq(name, "fault_cut")) { return BI_FAULT_CUT }
        if (ofs_str_eq(name, "fault_patch")) { return BI_FAULT_PATCH }
        if (ofs_str_eq(name, "fault_fence")) { return BI_FAULT_NOP }
        if (ofs_str_eq(name, "fault_prefetch")) { return BI_FAULT_NOP }
        if (ofs_str_eq(name, "fault_trap")) { return BI_FAULT_TRAP }
        if (ofs_str_eq(name, "fault_unreachable")) { return BI_FAULT_TRAP }
        if (ofs_str_eq(name, "fault_memcpy")) { return BI_FAULT_MEMCPY }
        if (ofs_str_eq(name, "fault_memset")) { return BI_FAULT_MEMSET }
        if (ofs_str_eq(name, "fault_addr")) { return BI_FAULT_ADDR }
        if (ofs_str_eq(name, "fault_call")) { return BI_FAULT_CALL }
        if (ofs_str_eq(name, "fault_step")) { return BI_FAULT_STEP }
        return BI_NONE
    }

    vein builtin_code(name: obsidian) -> stone {
        if (ofs_str_eq(name, "echo")) { return BI_ECHO }
        if (ofs_str_eq(name, "etch")) { return BI_ETCH }
        if (ofs_str_eq(name, "etchln")) { return BI_ETCHLN }
        if (ofs_str_eq(name, "mold")) { return BI_MOLD }
        if (ofs_str_eq(name, "exit")) { return BI_EXIT }
        if (ofs_str_eq(name, "ofs_str_len")) { return BI_STR_LEN }
        if (ofs_str_eq(name, "ofs_str_eq")) { return BI_STR_EQ }
        if (ofs_str_eq(name, "ofs_str_concat")) { return BI_STR_CONCAT }
        if (ofs_str_eq(name, "ofs_str_char_at")) { return BI_STR_CHAR_AT }
        if (ofs_str_eq(name, "ofs_str_substr")) { return BI_STR_SUBSTR }
        if (ofs_str_eq(name, "ofs_str_contains")) { return BI_STR_CONTAINS }
        if (ofs_str_eq(name, "ofs_stone_to_obsidian")) { return BI_STONE_TO_OBS }
        if (ofs_str_eq(name, "ofs_crystal_to_obsidian")) { return BI_CRYSTAL_TO_OBS }
        if (ofs_str_eq(name, "ofs_obsidian_to_stone")) { return BI_OBS_TO_STONE }
        if (ofs_str_eq(name, "ofs_array_new")) { return BI_ARRAY_NEW }
        if (ofs_str_eq(name, "ofs_array_len")) { return BI_ARRAY_LEN }
        if (ofs_str_eq(name, "ofs_array_push")) { return BI_ARRAY_PUSH }
        if (ofs_str_eq(name, "ofs_array_get")) { return BI_ARRAY_GET }
        if (ofs_str_eq(name, "ofs_array_set")) { return BI_ARRAY_SET }
        if (ofs_str_eq(name, "ofs_array_pop")) { return BI_ARRAY_POP }
        if (ofs_str_eq(name, "ofs_pow")) { return BI_POW }
        if (ofs_str_eq(name, "ofs_sqrt")) { return BI_SQRT }
        if (ofs_str_eq(name, "__ofs_variant_name")) { return BI_VARIANT_NAME }
        if (ofs_str_eq(name, "__ofs_bool_text")) { return BI_BOOL_TEXT }
        if (ofs_str_eq(name, "__ofs_vein_name")) { return BI_VEIN_NAME }
        if (ofs_str_eq(name, "__ofs_contract_fail")) { return BI_CONTRACT_FAIL }
        if (ofs_str_eq(name, "__bedrock_lift")) { return BI_BEDROCK_LIFT }
        if (ofs_str_char_at(name, 0) == 102 && ofs_str_len(name) > 6) { return fault_code(name) }
        return BI_NONE
    }

    vein starts_upper(s: obsidian) -> bool {
        if (ofs_str_len(s) == 0) { return false }
        forge c = ofs_str_char_at(s, 0)
        return c >= 65 && c <= 90
    }

    // Copia o _node_pool para as tabelas (unica copia de Node por no)
    vein build_node_tables() -> void {
        build_node_tables_from(0)
    }

    // copia os nos [start, node_pool_len) (a Fault Refract acrescenta os nos
    // de cada versao nova do programa)
    vein build_node_tables_from(start: stone) -> void {
        forge cnt = node_pool_len()
        _n_count = cnt
        forge i = start
        while (i < cnt) {
            forge n: Node = node_get(i)
            ofs_array_push(_nk, n.kind)
            ofs_array_push(_nval, n.val)
            ofs_array_push(_ntype, n.type_str)
            ofs_array_push(_nc0, n.c0)
            ofs_array_push(_nc1, n.c1)
            ofs_array_push(_nc2, n.c2)
            ofs_array_push(_nc3, n.c3)
            ofs_array_push(_nx, n.extra)
            ofs_array_push(_nsym, -1)
            forge op = 0
            forge aux = 0
            forge fv: crystal = 0.0
            if (n.kind == NK_BIN_OP) { op = bin_op_code(n.val) }
            else if (n.kind == NK_UNARY_OP) { op = unary_op_code(n.val) }
            else if (n.kind == NK_POST_OP) { op = post_op_code(n.val) }
            else if (n.kind == NK_CAST) { op = cast_code(n.val) }
            else if (n.kind == NK_LIT_INT) { aux = parse_int(n.val) }
            else if (n.kind == NK_LIT_FLOAT) { fv = parse_float(n.val) }
            else if (n.kind == NK_LIT_BOOL) {
                if (ofs_str_eq(n.val, "true")) { aux = 1 }
            }
            else if (n.kind == NK_IDENT) {
                // variante: nome com inicial maiuscula que o typeck nao
                // resolveu como variavel (tipo "variant", ou no nao visitado).
                // Antes bastava a inicial maiuscula, e um global
                // `forge LIMITE = 5` valia a variante "LIMITE" no `ofs run`
                // (no nativo, 5).
                if (starts_upper(n.val) && (ofs_str_eq(n.type_str, "variant") || ofs_str_eq(n.type_str, ""))) { op = 1 }
            }
            ofs_array_push(_nop, op)
            ofs_array_push(_naux, aux)
            ofs_array_push(_nf, fv)
            i++
        }
    }

    vein nk(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge k: stone = ofs_array_get(_nk, id)
        return k
    }

    vein nval(id: stone) -> obsidian {
        if (id < 0 || id >= _n_count) { return "" }
        forge v: obsidian = ofs_array_get(_nval, id)
        return v
    }

    vein ntype(id: stone) -> obsidian {
        if (id < 0 || id >= _n_count) { return "" }
        forge v: obsidian = ofs_array_get(_ntype, id)
        return v
    }

    vein nc0(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc0, id)
        return c
    }

    vein nc1(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc1, id)
        return c
    }

    vein nc2(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc2, id)
        return c
    }

    vein nc3(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc3, id)
        return c
    }

    vein nop(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return 0 }
        forge c: stone = ofs_array_get(_nop, id)
        return c
    }

    vein naux(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return 0 }
        forge c: stone = ofs_array_get(_naux, id)
        return c
    }

    vein nextra(id: stone) -> Array<stone> {
        if (id < 0 || id >= _n_count) { return _empty_extra }
        forge x: Array<stone> = ofs_array_get(_nx, id)
        return x
    }

    vein nx_len(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return 0 }
        forge x: Array<stone> = ofs_array_get(_nx, id)
        return ofs_array_len(x)
    }

    vein nx_at(id: stone, index: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge x: Array<stone> = ofs_array_get(_nx, id)
        if (index < 0 || index >= ofs_array_len(x)) { return -1 }
        forge c: stone = ofs_array_get(x, index)
        return c
    }

    // ── Symbols ───────────────────────────────────────────────────────────

    vein sym_lookup(name: obsidian) -> stone {
        forge i = 0
        forge len = ofs_array_len(_sym_names)
        while (i < len) {
            forge s: obsidian = ofs_array_get(_sym_names, i)
            if (ofs_str_eq(s, name)) { return i }
            i++
        }
        return -1
    }

    vein sym_intern(name: obsidian) -> stone {
        forge s = sym_lookup(name)
        if (s >= 0) { return s }
        ofs_array_push(_sym_names, name)
        return ofs_array_len(_sym_names) - 1
    }

    // Id do simbolo do nome de um no (IDENT, VAR_DECL, PARAM...), cacheado
    vein node_sym(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return sym_intern("") }
        forge s: stone = ofs_array_get(_nsym, id)
        if (s >= 0) { return s }
        forge v: obsidian = ofs_array_get(_nval, id)
        s = sym_intern(v)
        ofs_array_set(_nsym, id, s)
        return s
    }

    // ── Memoria crua (F2) ────────────────────────────────────────────────
    // Leitura/escrita por largura usando o proprio codigo nativo do
    // interpretador (o llvmgen gera load/store i8/i16/i32/i64/float/double).
    // Inteiros estreitos ficam na forma canonica do nativo (widen_int):
    // sinal estendido para iN, zeros para uN.

    vein is_strata_type(t: obsidian) -> bool {
        forge i = 0
        while (i < ofs_array_len(_strata_names)) {
            forge sn: obsidian = ofs_array_get(_strata_names, i)
            if (ofs_str_eq(sn, t)) { return true }
            i++
        }
        return false
    }

    // classe de memoria do tipo t (MC_*); desconhecido = 8 bytes inteiro
    vein mem_class(t: obsidian) -> stone {
        forge n = ofs_str_len(t)
        if (n == 0) { return MC_I64 }
        forge c0 = ofs_str_char_at(t, 0)
        if (c0 == 42) { return MC_PTR }
        if (c0 == 118 && vein_type_is(t)) { return MC_FN }
        if (ofs_str_eq(t, "stone") || ofs_str_eq(t, "i64") || ofs_str_eq(t, "u64") || ofs_str_eq(t, "unknown")) { return MC_I64 }
        if (ofs_str_eq(t, "crystal") || ofs_str_eq(t, "f64")) { return MC_F64 }
        if (ofs_str_eq(t, "obsidian")) { return MC_STR }
        if (ofs_str_eq(t, "bool") || ofs_str_eq(t, "bool1")) { return MC_BOOL }
        if (ofs_str_eq(t, "u8")) { return MC_U8 }
        if (ofs_str_eq(t, "i8")) { return MC_I8 }
        if (ofs_str_eq(t, "u16")) { return MC_U16 }
        if (ofs_str_eq(t, "i16")) { return MC_I16 }
        if (ofs_str_eq(t, "u32")) { return MC_U32 }
        if (ofs_str_eq(t, "i32")) { return MC_I32 }
        if (ofs_str_eq(t, "f32")) { return MC_F32 }
        if (ofs_str_eq(t, "ptr")) { return MC_PTR }
        if (ofs_str_eq(t, "variant")) { return MC_VARIANT }
        if (c0 == 65 && n >= 5 && ofs_str_eq(ofs_str_substr(t, 0, 5), "Array")) { return MC_ARRAY }
        if (mono_index(t) >= 0) { return MC_OBJ }
        if (is_strata_type(t)) { return MC_VARIANT }
        return MC_I64
    }

    vein mc_is_narrow(c: stone) -> bool {
        return c >= MC_I32 && c <= MC_U8
    }

    vein mc_is_unsigned(c: stone) -> bool {
        return c == MC_U32 || c == MC_U16 || c == MC_U8
    }

    // bits do tipo LLVM da classe (llvmgen.llvm_type/int_bitwidth)
    vein mc_bits(c: stone) -> stone {
        if (c == MC_I32 || c == MC_U32 || c == MC_BOOL || c == MC_F32) { return 32 }
        if (c == MC_I16 || c == MC_U16) { return 16 }
        if (c == MC_I8 || c == MC_U8) { return 8 }
        return 64
    }

    vein mc_name(c: stone) -> obsidian {
        if (c == MC_I32) { return "i32" }
        if (c == MC_U32) { return "u32" }
        if (c == MC_I16) { return "i16" }
        if (c == MC_U16) { return "u16" }
        if (c == MC_I8) { return "i8" }
        if (c == MC_U8) { return "u8" }
        if (c == MC_F32) { return "f32" }
        if (c == MC_BOOL) { return "bool" }
        if (c == MC_F64) { return "crystal" }
        if (c == MC_STR) { return "obsidian" }
        return "stone"
    }

    // v (64 bits) truncado para a classe e na forma canonica dela
    vein mc_canon(c: stone, v: stone) -> stone {
        if (c == MC_I32) { return ((v & 4294967295) ^ 2147483648) - 2147483648 }
        if (c == MC_U32 || c == MC_BOOL) { return v & 4294967295 }
        if (c == MC_I16) { return ((v & 65535) ^ 32768) - 32768 }
        if (c == MC_U16) { return v & 65535 }
        if (c == MC_I8) { return ((v & 255) ^ 128) - 128 }
        if (c == MC_U8) { return v & 255 }
        return v
    }

    // conversao implicita ao gravar numa variavel/parametro do tipo da
    // classe c (coerce_for_store do llvmgen): trunc de inteiro estreito,
    // arredondamento de f32. So classes estreitas chegam aqui.
    vein coerce_regs(c: stone) -> void {
        if (c == MC_F32) {
            if (_rk == VAL_FLOAT) {
                _rf = f32_round(_rf)
                _rt = "f32"
            }
            return
        }
        if (_rk == VAL_INT) {
            _ri = mc_canon(c, _ri)
            _rt = mc_name(c)
        }
    }

    vein coerce_code(t: obsidian) -> stone {
        forge c = mem_class(t)
        if (mc_is_narrow(c) || c == MC_F32) { return c }
        return 0
    }

    vein f32_round(f: crystal) -> crystal {
        forge x: f32 = f as f32
        return x as crystal
    }

    // inteiro (bits brutos, canonicos) no endereco a
    vein mem_rd(a: stone, c: stone) -> stone {
        fracture {
            if (c == MC_U8 || c == MC_I8) {
                forge p8: *u8 = a as *u8
                forge v8: u8 = 0
                fracture { v8 = *p8 }
                return mc_canon(c, v8 as stone)
            }
            if (c == MC_U16 || c == MC_I16) {
                forge p16: *u16 = a as *u16
                forge v16: u16 = 0
                fracture { v16 = *p16 }
                return mc_canon(c, v16 as stone)
            }
            if (c == MC_U32 || c == MC_I32 || c == MC_BOOL || c == MC_F32) {
                forge p32: *u32 = a as *u32
                forge v32: u32 = 0
                fracture { v32 = *p32 }
                return mc_canon(c, v32 as stone)
            }
            forge p64: *stone = a as *stone
            forge v64: stone = 0
            fracture { v64 = *p64 }
            return v64
        }
    }

    vein mem_wr(a: stone, c: stone, v: stone) -> void {
        fracture {
            if (c == MC_U8 || c == MC_I8) {
                forge p8: *u8 = a as *u8
                fracture { *p8 = v as u8 }
                return
            }
            if (c == MC_U16 || c == MC_I16) {
                forge p16: *u16 = a as *u16
                fracture { *p16 = v as u16 }
                return
            }
            if (c == MC_U32 || c == MC_I32 || c == MC_BOOL) {
                forge p32: *u32 = a as *u32
                fracture { *p32 = v as u32 }
                return
            }
            forge p64: *stone = a as *stone
            fracture { *p64 = v }
        }
    }

    vein mem_rd_f(a: stone, c: stone) -> crystal {
        fracture {
            if (c == MC_F32) {
                forge pf: *f32 = a as *f32
                fracture { return (*pf) as crystal }
            }
            forge pd: *crystal = a as *crystal
            forge d: crystal = 0.0
            fracture { d = *pd }
            return d
        }
    }

    vein mem_wr_f(a: stone, c: stone, f: crystal) -> void {
        fracture {
            if (c == MC_F32) {
                forge pf: *f32 = a as *f32
                fracture { *pf = f as f32 }
                return
            }
            forge pd: *crystal = a as *crystal
            fracture { *pd = f }
        }
    }

    // valor dos registradores como palavra de 64 bits para memoria/C:
    // ponteiros e obsidian viram o endereco, monolith o endereco do bloco,
    // Array o ofs_array nativo, variante a etiqueta, null 0
    vein reg_as_int() -> stone {
        if (_rk == VAL_INT) { return _ri }
        if (_rk == VAL_BOOL) {
            if (_rb) { return 1 }
            return 0
        }
        if (_rk == VAL_FLOAT) { return _rf as stone }
        if (_rk == VAL_STRING) { return _rs as stone }
        if (_rk == VAL_OBJECT) { return _rr }
        if (_rk == VAL_ARRAY) { return arr_native_ptr(_rr) }
        if (_rk == VAL_VARIANT) { return variant_index(_rt) }
        if (_rk == VAL_FN) { return fn_native_addr() }
        return 0
    }

    vein reg_as_f() -> crystal {
        if (_rk == VAL_FLOAT) { return _rf }
        if (_rk == VAL_INT) { return _ri as crystal }
        if (_rk == VAL_BOOL && _rb) { return 1.0 }
        return 0.0
    }

    // palavra bruta v (de memoria, do C ou de um callback) -> registradores,
    // pelo tipo t de classe c
    vein regs_from_raw(v: stone, c: stone, t: obsidian) -> void {
        if (c == MC_I64) { r_int(v); return }
        if (mc_is_narrow(c)) {
            r_int(mc_canon(c, v))
            _rt = mc_name(c)
            return
        }
        if (c == MC_BOOL) { r_bool((v & 4294967295) != 0); return }
        if (v == 0 && (c == MC_STR || c == MC_PTR || c == MC_OBJ || c == MC_ARRAY || c == MC_FN)) { r_null(); return }
        if (c == MC_FN) { fn_from_raw(v, t); return }
        if (c == MC_STR) { r_string(v as obsidian); return }
        if (c == MC_PTR) { r_int(v); _rt = t; return }
        if (c == MC_OBJ) { r_object(t, v); return }
        if (c == MC_ARRAY) {
            if (v < 0) { r_array(0 - v - 1); return }
            r_array(arr_adopt(v, t))
            return
        }
        if (c == MC_VARIANT) {
            forge nm = variant_name_at(v)
            if (ofs_str_len(nm) == 0) { r_int(v); return }
            r_null()
            r_variant(nm)
            return
        }
        r_int(v)
    }

    // memoria em a (tipo t, classe c) -> registradores
    vein mem_load(a: stone, c: stone, t: obsidian) -> void {
        if (c == MC_F64) { r_float(mem_rd_f(a, c)); return }
        if (c == MC_F32) {
            r_float(mem_rd_f(a, c))
            _rt = "f32"
            return
        }
        regs_from_raw(mem_rd(a, c), c, t)
    }

    // registradores -> memoria em a (tipo t, classe c); registradores intactos
    vein mem_store(a: stone, c: stone, t: obsidian) -> void {
        if (c == MC_F64 || c == MC_F32) {
            mem_wr_f(a, c, reg_as_f())
            return
        }
        if (c == MC_STR && _rk == VAL_INT && ofs_str_eq(_rt, "stone")) {
            // coerce_for_store stone -> obsidian do nativo: vira texto
            mem_wr(a, MC_I64, ofs_stone_to_obsidian(_ri) as stone)
            return
        }
        if (c == MC_FN) {
            mem_wr(a, MC_I64, fn_raw_mem())
            return
        }
        mem_wr(a, c, reg_as_int())
    }

    // ── Valores de vein (F6) ──────────────────────────────────────────────

    vein r_fn(t: obsidian, fid: stone, addr: stone, name: obsidian) -> void {
        r_set(VAL_FN, t, addr, 0.0, false, name, fid)
    }

    // endereco nativo do valor de vein dos registradores (o que o C chama):
    // vein interpretada = trampolim de callback (cb_slot_for)
    vein fn_native_addr() -> stone {
        if (_rk != VAL_FN) { return 0 }
        if (_rr >= 0) {
            if (_ri > 0) {
                // geode com captura: o C so recebe o endereco de uma funcao
                ffi_stderr("ofs: geode com captura nao pode ir para o C (Rift) nem virar endereco; passe uma vein ou um geode sem captura\n")
                exit(1)
            }
            return cb_slot_for(_rr, _rs)
        }
        return _ri
    }

    // palavra de memoria crua do valor de vein (campo de monolith, *p):
    // vein interpretada = -(id + 1); geode com captura leva o ambiente
    // (handle + 1) nos bits de cima: -(id + 1 + amb * 2^24)
    vein fn_raw_mem() -> stone {
        if (_rk == VAL_FN && _rr >= 0) { return 0 - _rr - 1 - _ri * 16777216 }
        return reg_as_int()
    }

    // palavra bruta (memoria, C, callback) de tipo vein t -> registradores
    vein fn_from_raw(v: stone, t: obsidian) -> void {
        if (v == 0) { r_null(); return }
        if (v < 0) {
            forge hraw = 0 - v - 1
            forge hid = hraw & 16777215
            r_fn(t, hid, hraw >> 24, nval(hid))
            return
        }
        forge native_i = 0
        while (native_i < ofs_array_len(_hy_value_addr)) {
            forge native_addr: stone = ofs_array_get(_hy_value_addr, native_i)
            if (native_addr == v) {
                forge native_fid: stone = ofs_array_get(_hy_value_fid, native_i)
                r_fn(t, native_fid, 0, nval(native_fid))
                return
            }
            native_i++
        }
        forge slot = 0
        while (slot < ofs_array_len(_cb_addr)) {
            forge sa: stone = ofs_array_get(_cb_addr, slot)
            if (sa == v) {
                forge sf: stone = ofs_array_get(_cb_fn, slot)
                r_fn(t, sf, 0, nval(sf))
                return
            }
            slot++
        }
        forge nm = ""
        forge ei = 0
        while (ei < ofs_array_len(_ext_vref)) {
            forge used: bool = ofs_array_get(_ext_vref, ei)
            if (used) {
                if (ffi_resolve(ei) == v) {
                    nm = ofs_array_get(_ext_names, ei)
                    break
                }
            }
            ei++
        }
        r_fn(t, -1, v, nm)
    }

    // chamada de um valor de vein (registradores = a vein; argumentos ja na
    // pilha): interpretada direto, nativa pela assinatura do tipo
    vein call_vein_value(num_args: stone, arg_base: stone) -> void {
        if (_rk == VAL_NULL || (_rk == VAL_FN && _rr < 0 && _ri == 0)) {
            ffi_stderr("ofs: chamada de vein nula (o valor de vein e null)\n")
            exit(1)
            return
        }
        if (_rk != VAL_FN) {
            fault_runtime_error("chamada de valor que nao e vein")
            return
        }
        if (_rr >= 0) {
            if (_ri > 0) {
                // geode com captura: a vein do corpo recebe (capturas..., args)
                call_geode(_rr, _ri - 1, num_args, arg_base)
                return
            }
            call_function_by_id(_rr, num_args, arg_base)
            return
        }
        forge what = "vein"
        if (ofs_str_len(_rs) > 0) { what = "vein '" + _rs + "'" }
        call_native_sig(_ri, _rt, num_args, arg_base, what)
    }

    // geode com captura: copia os argumentos ja empilhados para depois das
    // capturas do ambiente (array interpretado `env`) e chama a vein do
    // corpo com (capturas..., args...)
    vein call_geode(fid: stone, env: stone, num_args: stone, arg_base: stone) -> void {
        forge base2 = ofs_array_len(_arg_kinds)
        forge nc = interp_array_len(env)
        forge ci = 0
        while (ci < nc) {
            interp_array_get(env, ci)
            arg_push_regs()
            ci++
        }
        forge ai = 0
        while (ai < num_args) {
            load_arg(arg_base + ai)
            arg_push_regs()
            ai++
        }
        call_function_by_id(fid, nc + num_args, base2)
        // o resultado fica nos registradores; tira so a copia
        forge rk = _rk
        forge rt: obsidian = _rt
        forge ri = _ri
        forge rf = _rf
        forge rb = _rb
        forge rs: obsidian = _rs
        forge rr = _rr
        args_pop_to(base2)
        r_set(rk, rt, ri, rf, rb, rs, rr)
    }

    // `geode (...) { }`: valor de vein da vein do corpo (_naux = id + 1);
    // com captura, o ambiente e um array interpretado com as capturas
    // copiadas agora (handle + 1 em _ri)
    vein eval_geode(id: stone) -> void {
        forge fid = naux(id) - 1
        forge caps: Array<stone> = nextra(id)
        forge nc = ofs_array_len(caps)
        if (nc == 0) {
            r_fn(ntype(id), fid, 0, nval(id))
            return
        }
        forge env = interp_new_array()
        forge ci = 0
        while (ci < nc) {
            forge cid: stone = ofs_array_get(caps, ci)
            eval_expr(cid)
            interp_array_push(env)
            ci++
        }
        r_fn(ntype(id), fid, env + 1, nval(id))
    }

    // ── Arena do bedrock (A5.3) ──────────────────────────────────────────
    // O bloco marcado "arena" abre uma arena do runtime nativo (procurado por
    // dlsym: o ofscc ligado com um magma antigo roda sem arena) e a fecha em
    // qualquer saida. No interpretador so o `ofs_alloc` do proprio bloco vem
    // da arena (texto e Array sao valores do interpretador); ofs_free/
    // ofs_realloc do runtime ja reconhecem os blocos dela. O que pode sair
    // e decidido em compilacao (sediment.ofs), igual ao nativo.
    forge _ar_ready: bool = false
    forge _ar_open_fn: stone = 0
    forge _ar_close_fn: stone = 0
    forge _ar_use_fn: stone = 0
    forge _ar_lift_fn: stone = 0
    forge _ar_alloc_fn: stone = 0
    forge _ar_h: Array<stone> = []
    forge _ar_frame: Array<stone> = []

    vein ar_resolve() -> void {
        if (_ar_ready) { return }
        _ar_ready = true
        ffi_init()
        _ar_open_fn = dlsym(ffi_rtld_default(), "ofs_arena_open")
        _ar_close_fn = dlsym(ffi_rtld_default(), "ofs_arena_close")
        _ar_use_fn = dlsym(ffi_rtld_default(), "ofs_arena_use")
        _ar_lift_fn = dlsym(ffi_rtld_default(), "ofs_arena_lift")
        _ar_alloc_fn = dlsym(ffi_rtld_default(), "__ofs_arena_alloc")
        if (_ar_open_fn == 0 || _ar_close_fn == 0 || _ar_use_fn == 0 || _ar_alloc_fn == 0) {
            _ar_open_fn = 0
        }
    }

    abyss vein ar_call0(f: stone) -> stone {
        return fault_call(f)
    }

    abyss vein ar_call1(f: stone, a: stone) -> stone {
        return fault_call(f, a)
    }

    abyss vein ar_call2(f: stone, a: stone, b: stone) -> stone {
        return fault_call(f, a, b)
    }

    vein exec_arena_block(id: stone) -> stone {
        ar_resolve()
        forge h = 0
        if (_ar_open_fn != 0) {
            h = ar_call0(_ar_open_fn)
            // a arena nao recebe as alocacoes do proprio interpretador
            ar_call1(_ar_use_fn, 0)
        }
        ofs_array_push(_ar_h, h)
        ofs_array_push(_ar_frame, _current_frame_base)
        push_scope()
        forge st = exec_stmt_list(id)
        pop_scope()
        ofs_array_pop(_ar_h)
        ofs_array_pop(_ar_frame)
        if (h != 0) { ar_call1(_ar_close_fn, h) }
        return st
    }

    // `ofs_alloc(n)` escrito no proprio bloco bedrock (mesma vein): da arena
    vein ar_lexical() -> stone {
        forge n = ofs_array_len(_ar_h)
        if (n == 0) { return 0 }
        forge fr: stone = ofs_array_get(_ar_frame, n - 1)
        if (fr != _current_frame_base) { return 0 }
        forge h: stone = ofs_array_get(_ar_h, n - 1)
        return h
    }

    // tipo apontado por um ponteiro de tipo pt ("*T" -> T; outro -> stone,
    // como no llvmgen)
    vein pointee_of(pt: obsidian) -> obsidian {
        if (ofs_str_len(pt) > 1 && ofs_str_char_at(pt, 0) == 42) {
            return ofs_str_substr(pt, 1, ofs_str_len(pt) - 1)
        }
        return "stone"
    }

    // tipo/classe de `*p` no no `id` (o ponteiro ja esta nos registradores):
    // o tipo estatico do typeck (o mesmo que o llvmgen usa) ou, sem ele, o
    // tipo do valor -> _dt_t/_dt_c
    forge _dt_t: obsidian = "stone"
    forge _dt_c: stone = 0

    vein deref_type(id: stone) -> void {
        forge c: stone = ofs_array_get(_naux, id)
        if (c > 0) {
            _dt_c = c - 1
            _dt_t = ofs_array_get(_ntype, id)
            return
        }
        if (_rk == VAL_INT && ofs_str_len(_rt) > 1 && ofs_str_char_at(_rt, 0) == 42) {
            _dt_t = pointee_of(_rt)
            _dt_c = mem_class(_dt_t)
            return
        }
        _dt_t = "stone"
        _dt_c = MC_I64
    }

    // nome do tipo de um no de tipo (Array<T> como o typeck)
    vein type_node_str(tid: stone) -> obsidian {
        if (tid < 0) { return "" }
        if (nk(tid) == NK_TYPE_ARRAY) {
            forge inner = "stone"
            if (nc0(tid) >= 0) { inner = nval(nc0(tid)) }
            return "Array<" + inner + ">"
        }
        return nval(tid)
    }

    // ── Heap Arrays Operations ────────────────────────────────────────────

    vein arr_valid(h: stone) -> bool {
        return h >= 0 && h < ofs_array_len(_arr_len)
    }

    // `a[i]`, `a[i] = v`, ofs_array_get/set fora do limite: o mesmo erro do
    // runtime nativo (matrix.ofs, ofs_array_oob) no stderr, e rc 1. Antes o
    // interpretador devolvia null e seguia (e o nativo saia mudo).
    vein arr_check_index(h: stone, idx: stone) -> void {
        if (!arr_valid(h)) { return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (idx >= 0 && idx < len) { return }
        forge msg = "ofs: indice " + ofs_stone_to_obsidian(idx) + " fora do limite do array (tamanho " + ofs_stone_to_obsidian(len) + ")\n"
        write(2, msg, ofs_str_len(msg))
        exit(1)
    }

    vein interp_new_array() -> stone {
        ofs_array_push(_arr_len, 0)
        ofs_array_push(_arr_mask, 0)
        ofs_array_push(_arr_ck, _arr_nocol)
        ofs_array_push(_arr_ct, _arr_nocol)
        ofs_array_push(_arr_ci, _arr_nocol)
        ofs_array_push(_arr_cf, _arr_nocol)
        ofs_array_push(_arr_cb, _arr_nocol)
        ofs_array_push(_arr_cs, _arr_nocol)
        ofs_array_push(_arr_cr, _arr_nocol)
        return ofs_array_len(_arr_len) - 1
    }

    vein arr_elem_kind(h: stone, mask: stone, idx: stone) -> stone {
        if ((mask & COL_KIND) != 0) {
            forge ck: Array<stone> = ofs_array_get(_arr_ck, h)
            forge k: stone = ofs_array_get(ck, idx)
            return k
        }
        return VAL_INT
    }

    // Cria a coluna `col` de h preenchida com o padrao para os elementos atuais
    vein arr_materialize(h: stone, col: stone) -> void {
        forge len: stone = ofs_array_get(_arr_len, h)
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge j = 0
        if (col == COL_KIND) {
            forge c: Array<stone> = []
            while (j < len) { ofs_array_push(c, VAL_INT); j++ }
            ofs_array_set(_arr_ck, h, c)
        } else if (col == COL_TYPE) {
            forge c: Array<obsidian> = []
            while (j < len) {
                ofs_array_push(c, kind_type_name(arr_elem_kind(h, mask, j)))
                j++
            }
            ofs_array_set(_arr_ct, h, c)
        } else if (col == COL_I) {
            forge c: Array<stone> = []
            while (j < len) { ofs_array_push(c, 0); j++ }
            ofs_array_set(_arr_ci, h, c)
        } else if (col == COL_F) {
            forge c: Array<crystal> = []
            forge zf: crystal = 0.0
            while (j < len) { ofs_array_push(c, zf); j++ }
            ofs_array_set(_arr_cf, h, c)
        } else if (col == COL_B) {
            forge c: Array<bool> = []
            while (j < len) { ofs_array_push(c, false); j++ }
            ofs_array_set(_arr_cb, h, c)
        } else if (col == COL_S) {
            forge c: Array<obsidian> = []
            while (j < len) { ofs_array_push(c, ""); j++ }
            ofs_array_set(_arr_cs, h, c)
        } else if (col == COL_REF) {
            forge c: Array<stone> = []
            while (j < len) { ofs_array_push(c, -1); j++ }
            ofs_array_set(_arr_cr, h, c)
        }
        ofs_array_set(_arr_mask, h, mask | col)
    }

    // Colunas que o valor dos registradores precisa (campos fora do padrao)
    vein regs_needed_cols() -> stone {
        forge need = 0
        if (_rk != VAL_INT) { need = need | COL_KIND }
        if (!ofs_str_eq(_rt, kind_type_name(_rk))) { need = need | COL_TYPE }
        if (_ri != 0) { need = need | COL_I }
        if (_rk == VAL_FLOAT || _rk == VAL_VARIANT || _rf != 0.0) { need = need | COL_F }
        if (_rb) { need = need | COL_B }
        if (!ofs_str_eq(_rs, "")) { need = need | COL_S }
        if (_rr != -1) { need = need | COL_REF }
        return need
    }

    // Garante as colunas necessarias para o valor dos registradores; devolve a mascara
    vein arr_prepare(h: stone) -> stone {
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge missing = regs_needed_cols() & (~mask)
        if (missing != 0) {
            if ((missing & COL_KIND) != 0) { arr_materialize(h, COL_KIND) }
            if ((missing & COL_TYPE) != 0) { arr_materialize(h, COL_TYPE) }
            if ((missing & COL_I) != 0) { arr_materialize(h, COL_I) }
            if ((missing & COL_F) != 0) { arr_materialize(h, COL_F) }
            if ((missing & COL_B) != 0) { arr_materialize(h, COL_B) }
            if ((missing & COL_S) != 0) { arr_materialize(h, COL_S) }
            if ((missing & COL_REF) != 0) { arr_materialize(h, COL_REF) }
            mask = ofs_array_get(_arr_mask, h)
        }
        return mask
    }

    // push do valor dos registradores
    vein interp_array_push(h: stone) -> void {
        if (!arr_valid(h)) { return }
        forge mask = arr_prepare(h)
        if ((mask & COL_KIND) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ck, h)
            ofs_array_push(c, _rk)
        }
        if ((mask & COL_TYPE) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_ct, h)
            ofs_array_push(c, _rt)
        }
        if ((mask & COL_I) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ci, h)
            ofs_array_push(c, _ri)
        }
        if ((mask & COL_F) != 0) {
            forge c: Array<crystal> = ofs_array_get(_arr_cf, h)
            ofs_array_push(c, _rf)
        }
        if ((mask & COL_B) != 0) {
            forge c: Array<bool> = ofs_array_get(_arr_cb, h)
            ofs_array_push(c, _rb)
        }
        if ((mask & COL_S) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_cs, h)
            ofs_array_push(c, _rs)
        }
        if ((mask & COL_REF) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_cr, h)
            ofs_array_push(c, _rr)
        }
        forge len: stone = ofs_array_get(_arr_len, h)
        ofs_array_set(_arr_len, h, len + 1)
    }

    // elemento -> registradores (null fora dos limites)
    vein interp_array_get(h: stone, idx: stone) -> void {
        if (!arr_valid(h)) { r_null(); return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (idx < 0 || idx >= len) { r_null(); return }
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge k = arr_elem_kind(h, mask, idx)
        forge t: obsidian = ""
        if ((mask & COL_TYPE) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_ct, h)
            t = ofs_array_get(c, idx)
        } else {
            t = kind_type_name(k)
        }
        forge iv = 0
        if ((mask & COL_I) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ci, h)
            iv = ofs_array_get(c, idx)
        }
        forge fv: crystal = 0.0
        if ((mask & COL_F) != 0) {
            forge c: Array<crystal> = ofs_array_get(_arr_cf, h)
            fv = ofs_array_get(c, idx) as crystal
        }
        forge bv = false
        if ((mask & COL_B) != 0) {
            forge c: Array<bool> = ofs_array_get(_arr_cb, h)
            bv = ofs_array_get(c, idx)
        }
        forge sv: obsidian = ""
        if ((mask & COL_S) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_cs, h)
            sv = ofs_array_get(c, idx)
        }
        forge rv = -1
        if ((mask & COL_REF) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_cr, h)
            rv = ofs_array_get(c, idx)
        }
        r_set(k, t, iv, fv, bv, sv, rv)
    }

    // elemento idx <- registradores
    vein interp_array_set(h: stone, idx: stone) -> void {
        if (!arr_valid(h)) { return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (idx < 0 || idx >= len) { return }
        forge mask = arr_prepare(h)
        if ((mask & COL_KIND) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ck, h)
            ofs_array_set(c, idx, _rk)
        }
        if ((mask & COL_TYPE) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_ct, h)
            ofs_array_set(c, idx, _rt)
        }
        if ((mask & COL_I) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ci, h)
            ofs_array_set(c, idx, _ri)
        }
        if ((mask & COL_F) != 0) {
            forge c: Array<crystal> = ofs_array_get(_arr_cf, h)
            ofs_array_set(c, idx, _rf)
        }
        if ((mask & COL_B) != 0) {
            forge c: Array<bool> = ofs_array_get(_arr_cb, h)
            ofs_array_set(c, idx, _rb)
        }
        if ((mask & COL_S) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_cs, h)
            ofs_array_set(c, idx, _rs)
        }
        if ((mask & COL_REF) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_cr, h)
            ofs_array_set(c, idx, _rr)
        }
    }

    vein interp_array_len(h: stone) -> stone {
        if (!arr_valid(h)) { return 0 }
        forge len: stone = ofs_array_get(_arr_len, h)
        return len
    }

    // ultimo elemento -> registradores, e remove
    vein interp_array_pop(h: stone) -> void {
        if (!arr_valid(h)) { r_null(); return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (len <= 0) { r_null(); return }
        interp_array_get(h, len - 1)
        forge mask: stone = ofs_array_get(_arr_mask, h)
        if ((mask & COL_KIND) != 0) { forge c: Array<stone> = ofs_array_get(_arr_ck, h); ofs_array_pop(c) }
        if ((mask & COL_TYPE) != 0) { forge c: Array<obsidian> = ofs_array_get(_arr_ct, h); ofs_array_pop(c) }
        if ((mask & COL_I) != 0) { forge c: Array<stone> = ofs_array_get(_arr_ci, h); ofs_array_pop(c) }
        if ((mask & COL_F) != 0) { forge c: Array<crystal> = ofs_array_get(_arr_cf, h); ofs_array_pop(c) }
        if ((mask & COL_B) != 0) { forge c: Array<bool> = ofs_array_get(_arr_cb, h); ofs_array_pop(c) }
        if ((mask & COL_S) != 0) { forge c: Array<obsidian> = ofs_array_get(_arr_cs, h); ofs_array_pop(c) }
        if ((mask & COL_REF) != 0) { forge c: Array<stone> = ofs_array_get(_arr_cr, h); ofs_array_pop(c) }
        ofs_array_set(_arr_len, h, len - 1)
    }

    // ── Arrays e o C (F2) ─────────────────────────────────────────────────
    // A coluna de valores de um array interpretado (_arr_ci/_arr_cf/...) E um
    // ofs_array nativo (cabecalho [data, len, cap, elem_size] + dados, ver
    // stdlib/runtime/matrix.ofs) com elementos de 8 bytes, a mesma
    // representacao de um Array<T> no build nativo. Passar o array ao C
    // passa essa coluna (o C le e escreve os elementos no lugar); na volta
    // o comprimento e sincronizado (o C pode ter feito push/pop).

    vein arr_col_array(h: stone, col: stone) -> stone {
        if (col == COL_F) { forge cf: Array<crystal> = ofs_array_get(_arr_cf, h); return cf as stone }
        if (col == COL_S) { forge cs: Array<obsidian> = ofs_array_get(_arr_cs, h); return cs as stone }
        if (col == COL_B) { forge cb: Array<bool> = ofs_array_get(_arr_cb, h); return cb as stone }
        if (col == COL_REF) { forge cr: Array<stone> = ofs_array_get(_arr_cr, h); return cr as stone }
        forge ci: Array<stone> = ofs_array_get(_arr_ci, h)
        return ci as stone
    }

    // endereco do ofs_array nativo equivalente ao array h (0 = invalido); a
    // coluna usada fica em _arr_last_col
    vein arr_native_ptr(h: stone) -> stone {
        if (!arr_valid(h)) { return 0 }
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge len: stone = ofs_array_get(_arr_len, h)
        forge col = COL_I
        if ((mask & COL_KIND) != 0 && len > 0) {
            forge ck: Array<stone> = ofs_array_get(_arr_ck, h)
            forge k0: stone = ofs_array_get(ck, 0)
            forge j = 1
            while (j < len) {
                forge kj: stone = ofs_array_get(ck, j)
                if (kj != k0) {
                    fault_runtime_error("Array com elementos de tipos diferentes passado ao C")
                    return 0
                }
                j++
            }
            if (k0 == VAL_FLOAT) { col = COL_F }
            else if (k0 == VAL_STRING) { col = COL_S }
            else if (k0 == VAL_BOOL) { col = COL_B }
            else if (k0 == VAL_OBJECT) { col = COL_REF }
            else if (k0 != VAL_INT) {
                fault_runtime_error("Array de " + kind_type_name(k0) + " passado ao C: no interpretador so Array de inteiros/ponteiros, crystal, bool, obsidian ou monolith")
                return 0
            }
        }
        if ((mask & col) == 0) { arr_materialize(h, col) }
        _arr_last_col = col
        return arr_col_array(h, col)
    }

    // depois do C: comprimento do array h = o da coluna col; as outras colunas
    // presentes ganham (padrao) ou perdem elementos para acompanhar
    vein arr_sync(h: stone, col: stone) -> void {
        if (!arr_valid(h)) { return }
        forge na: Array<stone> = arr_col_array(h, col) as Array
        forge nl = ofs_array_len(na)
        forge len: stone = ofs_array_get(_arr_len, h)
        if (nl == len) { return }
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge c = 1
        while (c <= COL_REF) {
            if (c != col && (mask & c) != 0) {
                forge other: Array<stone> = arr_col_array(h, c) as Array
                while (ofs_array_len(other) > nl) { ofs_array_pop(other) }
                while (ofs_array_len(other) < nl) {
                    if (c == COL_KIND) {
                        forge k: stone = VAL_INT
                        if (col == COL_F) { k = VAL_FLOAT }
                        if (col == COL_S) { k = VAL_STRING }
                        if (col == COL_B) { k = VAL_BOOL }
                        if (col == COL_REF) { k = VAL_OBJECT }
                        ofs_array_push(other, k)
                    } else if (c == COL_TYPE) {
                        forge ot: Array<obsidian> = arr_col_array(h, c) as Array
                        forge tl: obsidian = "stone"
                        if (ofs_array_len(ot) > 0) { tl = ofs_array_get(ot, 0) }
                        ofs_array_push(ot, tl)
                    } else if (c == COL_S) {
                        forge os: Array<obsidian> = arr_col_array(h, c) as Array
                        ofs_array_push(os, "")
                    } else if (c == COL_REF) {
                        ofs_array_push(other, -1)
                    } else {
                        ofs_array_push(other, 0)
                    }
                }
            }
            c = c * 2
        }
        ofs_array_set(_arr_len, h, nl)
    }

    // ofs_array nativo vindo do C/memoria -> array interpretado que usa o
    // proprio bloco como coluna de valores (sem copia); t = "Array<T>"
    vein arr_adopt(p: stone, t: obsidian) -> stone {
        forge et = "stone"
        forge tl = ofs_str_len(t)
        if (tl > 7 && ofs_str_char_at(t, 5) == 60) { et = ofs_str_substr(t, 6, tl - 7) }
        forge c = mem_class(et)
        forge h = interp_new_array()
        forge na: Array<stone> = p as Array
        forge len = ofs_array_len(na)
        forge col = COL_I
        forge k = VAL_INT
        if (c == MC_F64) { col = COL_F; k = VAL_FLOAT; ofs_array_set(_arr_cf, h, p as Array) }
        else if (c == MC_STR) { col = COL_S; k = VAL_STRING; ofs_array_set(_arr_cs, h, p as Array) }
        else if (c == MC_BOOL) { col = COL_B; k = VAL_BOOL; ofs_array_set(_arr_cb, h, p as Array) }
        else if (c == MC_OBJ) { col = COL_REF; k = VAL_OBJECT; ofs_array_set(_arr_cr, h, p as Array) }
        else { ofs_array_set(_arr_ci, h, p as Array) }
        ofs_array_set(_arr_len, h, len)
        ofs_array_set(_arr_mask, h, col)
        if (k != VAL_INT) {
            arr_materialize(h, COL_KIND)
            forge ck: Array<stone> = ofs_array_get(_arr_ck, h)
            forge j = 0
            while (j < len) { ofs_array_set(ck, j, k); j++ }
        }
        if (c == MC_OBJ) {
            forge ct: Array<obsidian> = []
            forge j2 = 0
            while (j2 < len) { ofs_array_push(ct, et); j2++ }
            ofs_array_set(_arr_ct, h, ct)
            ofs_array_set(_arr_mask, h, col | COL_KIND | COL_TYPE)
        }
        return h
    }

    // ── Monolith Schema and Heap Objects ──────────────────────────────────

    // devolve true se o tipo e novo (os campos so entram uma vez)
    vein register_monolith(name: obsidian) -> bool {
        if (mono_index(name) >= 0) { return false }
        ofs_array_push(_mono_names, name)
        ofs_array_push(_mono_ffirst, ofs_array_len(_mono_field_names))
        ofs_array_push(_mono_fcount, 0)
        ofs_array_push(_mono_size, 1)
        return true
    }

    vein register_monolith_field(owner: obsidian, field_name: obsidian, field_type: obsidian) -> void {
        ofs_array_push(_mono_field_owners, owner)
        ofs_array_push(_mono_field_names, field_name)
        ofs_array_push(_mono_field_types, field_type)
        ofs_array_push(_mono_field_offs, 0)
        ofs_array_push(_mono_field_cls, MC_I64)
        forge mi = ofs_array_len(_mono_names) - 1
        forge fc: stone = ofs_array_get(_mono_fcount, mi)
        ofs_array_set(_mono_fcount, mi, fc + 1)
    }

    forge _mono_last_name: obsidian = ""
    forge _mono_last_idx: stone = -1

    vein mono_index(t: obsidian) -> stone {
        if (_mono_last_idx >= 0 && ofs_str_eq(t, _mono_last_name)) { return _mono_last_idx }
        forge i = 0
        forge n = ofs_array_len(_mono_names)
        while (i < n) {
            forge m: obsidian = ofs_array_get(_mono_names, i)
            if (ofs_str_eq(m, t)) {
                _mono_last_name = m
                _mono_last_idx = i
                return i
            }
            i++
        }
        return -1
    }

    // offsets, classes e tamanho de cada monolith (llvmgen.struct_layout:
    // o mesmo layout do codigo nativo); depois de collect_declarations
    vein compute_layouts() -> void {
        forge mi = 0
        while (mi < ofs_array_len(_mono_names)) {
            forge first: stone = ofs_array_get(_mono_ffirst, mi)
            forge cnt: stone = ofs_array_get(_mono_fcount, mi)
            forge types: Array<obsidian> = []
            forge offs: Array<stone> = []
            forge j = 0
            while (j < cnt) {
                forge ft: obsidian = ofs_array_get(_mono_field_types, first + j)
                ofs_array_push(types, ft)
                j++
            }
            forge size = llvmgen.struct_layout(types, offs)
            ofs_array_set(_mono_size, mi, size)
            j = 0
            while (j < cnt) {
                forge off: stone = ofs_array_get(offs, j)
                forge ft2: obsidian = ofs_array_get(types, j)
                ofs_array_set(_mono_field_offs, first + j, off)
                ofs_array_set(_mono_field_cls, first + j, mem_class(ft2))
                j++
            }
            mi++
        }
    }

    // valor padrao do tipo t -> registradores (objeto novo ja e unico: quem
    // declara nao precisa clonar)
    vein default_value_for_type(t: obsidian) -> void {
        if (ofs_str_eq(t, "stone")) { r_int(0); return }
        if (ofs_str_eq(t, "crystal")) { r_float(0.0); return }
        if (ofs_str_eq(t, "bool")) { r_bool(false); return }
        if (ofs_str_eq(t, "obsidian")) { r_string(""); return }
        if (ofs_str_eq(t, "Array")) {
            forge h = interp_new_array()
            r_array(h)
            return
        }
        forge mi = mono_index(t)
        if (mi >= 0) {
            r_object(t, obj_new(mi, 0))
            return
        }
        forge c = mem_class(t)
        if (mc_is_narrow(c) || ofs_str_eq(t, "i64") || ofs_str_eq(t, "u64")) {
            r_int(0)
            if (mc_is_narrow(c)) { _rt = mc_name(c) }
            return
        }
        if (c == MC_F64 || c == MC_F32) {
            r_float(0.0)
            if (c == MC_F32) { _rt = "f32" }
            return
        }
        r_null()
    }

    // bloco zerado do monolith mi; campos Array ganham um array novo e
    // campos monolith um objeto novo (como antes da F2), ate 8 niveis
    vein obj_new(mi: stone, depth: stone) -> stone {
        forge size: stone = ofs_array_get(_mono_size, mi)
        forge a = rf_obj_alloc(mi, size)
        forge first: stone = ofs_array_get(_mono_ffirst, mi)
        forge cnt: stone = ofs_array_get(_mono_fcount, mi)
        forge j = 0
        while (j < cnt) {
            forge c: stone = ofs_array_get(_mono_field_cls, first + j)
            if (c == MC_ARRAY) {
                forge off: stone = ofs_array_get(_mono_field_offs, first + j)
                forge h = interp_new_array()
                mem_wr(a + off, MC_I64, 0 - h - 1)
            } else if (c == MC_OBJ && depth < 8) {
                forge off2: stone = ofs_array_get(_mono_field_offs, first + j)
                forge ft: obsidian = ofs_array_get(_mono_field_types, first + j)
                forge smi = mono_index(ft)
                if (smi >= 0) { mem_wr(a + off2, MC_I64, obj_new(smi, depth + 1)) }
            }
            j++
        }
        return a
    }

    // Bloco de monolith. Na Fault Refract (onda 4) cada instancia e
    // registrada e nasce com folga (RF_OBJ_SLACK bytes) para o layout poder
    // crescer no lugar: os ponteiros para ela (variaveis, arrays, campos, o
    // nativo) continuam validos depois da migracao.
    forge RF_OBJ_SLACK: stone = 64
    forge _rf_obj_addr: Array<stone> = []
    forge _rf_obj_mono: Array<stone> = []
    forge _rf_obj_cap: Array<stone> = []
    forge _ar_cur_sym: stone = -1

    vein rf_obj_alloc(mi: stone, size: stone) -> stone {
        if (!_rf_on || mi < 0) { return ofs_alloc(size) as stone }
        forge cap = size + RF_OBJ_SLACK
        forge a = ofs_alloc(cap) as stone
        rf_count_instance(mi)
        ofs_array_push(_rf_obj_addr, a)
        ofs_array_push(_rf_obj_mono, mi)
        ofs_array_push(_rf_obj_cap, cap)
        return a
    }

    // alocacao de monolith pelo codigo nativo do modo hibrido; dentro de um
    // bedrock nativo o bloco e da arena (morre no fim dele): nao registra
    vein obj_alloc_native(size: stone, name: obsidian) -> stone {
        if (!_rf_on) { return ofs_alloc(size) as stone }
        if (_ar_cur_sym == -1) {
            ffi_init()
            _ar_cur_sym = dlsym(ffi_rtld_default(), "__ofs_arena_cur")
        }
        if (_ar_cur_sym != 0 && mem_rd(_ar_cur_sym, MC_I64) != 0) { return ofs_alloc(size) as stone }
        return rf_obj_alloc(mono_index(name), size)
    }

    vein obj_size(t: obsidian) -> stone {
        forge mi = mono_index(t)
        if (mi < 0) { return 0 }
        forge size: stone = ofs_array_get(_mono_size, mi)
        return size
    }

    // indice global do campo `name` do monolith t (-1 se nao existir)
    vein obj_field_find(t: obsidian, name: obsidian) -> stone {
        forge mi = mono_index(t)
        if (mi < 0) { return -1 }
        forge first: stone = ofs_array_get(_mono_ffirst, mi)
        forge cnt: stone = ofs_array_get(_mono_fcount, mi)
        forge j = 0
        while (j < cnt) {
            forge fname: obsidian = ofs_array_get(_mono_field_names, first + j)
            if (ofs_str_eq(fname, name)) { return first + j }
            j++
        }
        return -1
    }

    // campo do no NK_FIELD `id` sobre um objeto do tipo t (cache em _naux)
    vein field_cached(id: stone, t: obsidian) -> stone {
        forge c: stone = ofs_array_get(_naux, id)
        if (c > 0) {
            forge owner: obsidian = ofs_array_get(_mono_field_owners, c - 1)
            if (ofs_str_eq(owner, t)) { return c - 1 }
        }
        forge fi = obj_field_find(t, nval(id))
        ofs_array_set(_naux, id, fi + 1)
        return fi
    }

    // campo fi do objeto em a -> registradores
    vein obj_load_field(a: stone, fi: stone) -> void {
        forge off: stone = ofs_array_get(_mono_field_offs, fi)
        forge c: stone = ofs_array_get(_mono_field_cls, fi)
        forge t: obsidian = ofs_array_get(_mono_field_types, fi)
        mem_load(a + off, c, t)
        // obsidian nulo num campo: texto vazio (o padrao de antes da F2)
        if (c == MC_STR && _rk == VAL_NULL) { r_string("") }
    }

    // registradores -> campo fi do objeto em a (registradores intactos);
    // campo Array guarda o handle interpretado como -(h+1)
    vein obj_store_field(a: stone, fi: stone) -> void {
        forge off: stone = ofs_array_get(_mono_field_offs, fi)
        forge c: stone = ofs_array_get(_mono_field_cls, fi)
        if (c == MC_ARRAY && _rk == VAL_ARRAY) {
            mem_wr(a + off, MC_I64, 0 - _rr - 1)
            return
        }
        forge t: obsidian = ofs_array_get(_mono_field_types, fi)
        mem_store(a + off, c, t)
    }

    // copia (rasa) do objeto em a, do tipo t; devolve o novo endereco
    vein obj_clone(a: stone, t: obsidian) -> stone {
        fracture {
            forge size = obj_size(t)
            if (size <= 0) { return a }
            forge b = rf_obj_alloc(mono_index(t), size)
            memcpy(b as *u8, a as *u8, size)
            return b
        }
    }

    // Objetos tem semantica de valor ao ir para variavel: copia nos registradores
    vein clone_regs() -> void {
        if (_rk == VAL_OBJECT && _rr > 0) {
            _rr = obj_clone(_rr, _rt)
        }
    }

    // ── Variables & Locations ─────────────────────────────────────────────

    vein env_load(idx: stone) -> void {
        forge k: stone = ofs_array_get(_env_kind, idx)
        forge t: obsidian = ofs_array_get(_env_type, idx)
        forge iv: stone = ofs_array_get(_env_i, idx)
        if (k == VAL_BOXED) {
            forge bc: stone = ofs_array_get(_env_ref, idx)
            mem_load(iv, bc, t)
            return
        }
        forge fv: crystal = ofs_array_get(_env_f, idx) as crystal
        forge bv: bool = ofs_array_get(_env_b, idx)
        forge sv: obsidian = ofs_array_get(_env_s, idx)
        forge rv: stone = ofs_array_get(_env_ref, idx)
        r_set(k, t, iv, fv, bv, sv, rv)
    }

    // variavel idx <- registradores (sem clonar)
    vein env_store(idx: stone) -> void {
        if (_boxed_live > 0) {
            forge ck: stone = ofs_array_get(_env_kind, idx)
            if (ck == VAL_BOXED) {
                forge a: stone = ofs_array_get(_env_i, idx)
                forge bc: stone = ofs_array_get(_env_ref, idx)
                forge bt: obsidian = ofs_array_get(_env_type, idx)
                mem_store(a, bc, bt)
                return
            }
        }
        ofs_array_set(_env_kind, idx, _rk)
        ofs_array_set(_env_type, idx, _rt)
        ofs_array_set(_env_i, idx, _ri)
        ofs_array_set(_env_f, idx, _rf)
        ofs_array_set(_env_b, idx, _rb)
        ofs_array_set(_env_s, idx, _rs)
        ofs_array_set(_env_ref, idx, _rr)
    }

    // variavel idx <- copia dos registradores; os registradores ficam intactos.
    // Monolith sobre monolith do mesmo tipo copia para o bloco que a variavel
    // ja tem (como o `store %T` do nativo): `&x` tomado antes continua valendo.
    vein env_assign(idx: stone) -> void {
        fracture {
            if (_rk == VAL_OBJECT && _rr > 0) {
                forge ck: stone = ofs_array_get(_env_kind, idx)
                if (ck == VAL_OBJECT) {
                    forge dst: stone = ofs_array_get(_env_ref, idx)
                    forge dt: obsidian = ofs_array_get(_env_type, idx)
                    if (dst > 0 && ofs_str_eq(dt, _rt)) {
                        if (dst != _rr) { memcpy(dst as *u8, _rr as *u8, obj_size(dt)) }
                        return
                    }
                } else if (ck == VAL_BOXED) {
                    // global monolith na celula compartilhada (onda 4):
                    // copia para o bloco atual, como o `store %T` do nativo
                    forge bc: stone = ofs_array_get(_env_ref, idx)
                    if (bc == MC_OBJ) {
                        forge bdst = mem_rd(ofs_array_get(_env_i, idx), MC_I64)
                        forge bdt: obsidian = ofs_array_get(_env_type, idx)
                        if (bdst > 0 && ofs_str_eq(bdt, _rt)) {
                            if (bdst != _rr) { memcpy(bdst as *u8, _rr as *u8, obj_size(bdt)) }
                            return
                        }
                    }
                }
            }
            forge k = _rk
            forge t: obsidian = _rt
            forge iv = _ri
            forge fv: crystal = _rf
            forge bv = _rb
            forge sv: obsidian = _rs
            forge rv = _rr
            clone_regs()
            env_store(idx)
            r_set(k, t, iv, fv, bv, sv, rv)
        }
    }

    // `&x`: a variavel idx passa a viver num slot de memoria crua (8 bytes)
    // com o tipo t; devolve o endereco. O slot e liberado quando a variavel
    // sai de escopo (como a alloca do nativo).
    vein box_var(idx: stone, st: obsidian) -> stone {
        forge k: stone = ofs_array_get(_env_kind, idx)
        if (k == VAL_BOXED) {
            forge a0: stone = ofs_array_get(_env_i, idx)
            return a0
        }
        forge t: obsidian = st
        if (ofs_str_len(t) == 0 || ofs_str_eq(t, "unknown") || ofs_str_eq(t, "null") || ofs_str_eq(t, "void")) {
            forge et: obsidian = ofs_array_get(_env_type, idx)
            t = et
            if (k == VAL_INT && ofs_str_len(t) == 0) { t = "stone" }
            if (k == VAL_BOOL) { t = "bool" }
            if (k == VAL_STRING) { t = "obsidian" }
            if (k == VAL_NULL) { t = "ptr" }
            if (k == VAL_VARIANT) { t = "variant" }
        }
        forge c = mem_class(t)
        if (k == VAL_ARRAY || c == MC_ARRAY) {
            fault_runtime_error("&x de uma variavel Array ainda nao e suportado no interpretador (use ofs_array_data(x) ou ofs run --native)")
            return 0
        }
        if (k == VAL_OBJECT || c == MC_OBJ) {
            fault_runtime_error("&x de monolith nulo no interpretador")
            return 0
        }
        forge a = ofs_alloc(8) as stone
        env_load(idx)
        mem_store(a, c, t)
        ofs_array_set(_env_kind, idx, VAL_BOXED)
        ofs_array_set(_env_type, idx, t)
        ofs_array_set(_env_i, idx, a)
        ofs_array_set(_env_ref, idx, c)
        _boxed_live++
        return a
    }

    vein load_location(lk: stone, lvar: stone, lh: stone, lidx: stone, lfield: obsidian) -> void {
        if (lk == LOC_VAR) {
            if (lvar >= 0 && lvar < ofs_array_len(_env_kind)) {
                env_load(lvar)
                return
            }
            r_null()
            return
        }
        if (lk == LOC_ARRAY) {
            arr_check_index(lh, lidx)
            interp_array_get(lh, lidx)
            return
        }
        if (lk == LOC_FIELD) {
            if (lidx < 0) { r_null(); return }
            obj_load_field(lh, lidx)
            return
        }
        if (lk == LOC_MEM) {
            mem_load(lh, lidx, lfield)
            return
        }
        r_null()
    }

    // local <- registradores (os registradores ficam intactos)
    vein store_location(lk: stone, lvar: stone, lh: stone, lidx: stone, lfield: obsidian) -> void {
        if (lk == LOC_VAR) {
            if (lvar >= 0 && lvar < ofs_array_len(_env_kind)) {
                env_assign(lvar)
            }
            return
        }
        if (lk == LOC_ARRAY) {
            arr_check_index(lh, lidx)
            interp_array_set(lh, lidx)
            return
        }
        if (lk == LOC_FIELD) {
            if (lidx < 0) {
                fault_runtime_error("atribuicao a campo que o monolith nao declara")
                return
            }
            obj_store_field(lh, lidx)
            return
        }
        if (lk == LOC_MEM) {
            mem_store(lh, lidx, lfield)
            return
        }
    }

    // ── Scope & Environment ───────────────────────────────────────────────

    vein push_scope() -> void {
        _scope_depth++
    }

    vein run_anchors_from_depth(min_depth: stone) -> void {
        forge len = ofs_array_len(_anchor_nodes)
        while (len > 0) {
            forge depth: stone = ofs_array_get(_anchor_depths, len - 1)
            if (depth < min_depth) { break }
            forge action: stone = ofs_array_get(_anchor_nodes, len - 1)
            ofs_array_pop(_anchor_nodes)
            ofs_array_pop(_anchor_depths)
            execute_stmt(action)
            len--
        }
    }

    vein env_pop_one() -> void {
        if (_boxed_live > 0) {
            forge last = ofs_array_len(_env_kind) - 1
            forge lk: stone = ofs_array_get(_env_kind, last)
            if (lk == VAL_BOXED) {
                forge la: stone = ofs_array_get(_env_i, last)
                ofs_free(la as obsidian)
                _boxed_live--
            }
        }
        ofs_array_pop(_env_sym)
        ofs_array_pop(_env_kind)
        ofs_array_pop(_env_type)
        ofs_array_pop(_env_i)
        ofs_array_pop(_env_f)
        ofs_array_pop(_env_b)
        ofs_array_pop(_env_s)
        ofs_array_pop(_env_ref)
        ofs_array_pop(_env_depth)
    }

    vein pop_scope() -> void {
        run_anchors_from_depth(_scope_depth)
        forge len = ofs_array_len(_env_depth)
        while (len > 0) {
            forge d: stone = ofs_array_get(_env_depth, len - 1)
            if (d < _scope_depth) {
                break
            }
            env_pop_one()
            len--
        }
        if (_scope_depth > 0) {
            _scope_depth--
        }
    }

    // declara a variavel `sym` com (uma copia de) o valor dos registradores
    vein declare_var(sym: stone) -> void {
        clone_regs()
        declare_var_noclone(sym)
    }

    // declara com o valor dos registradores sem copiar o monolith: parametro
    // (o nativo passa monolith por ponteiro) e objeto recem-criado
    vein declare_var_noclone(sym: stone) -> void {
        ofs_array_push(_env_sym, sym)
        ofs_array_push(_env_kind, _rk)
        ofs_array_push(_env_type, _rt)
        ofs_array_push(_env_i, _ri)
        ofs_array_push(_env_f, _rf)
        ofs_array_push(_env_b, _rb)
        ofs_array_push(_env_s, _rs)
        ofs_array_push(_env_ref, _rr)
        ofs_array_push(_env_depth, _scope_depth)
    }

    vein find_var(sym: stone) -> stone {
        if (sym < 0) { return -1 }
        forge i = ofs_array_len(_env_sym) - 1
        while (i >= _current_frame_base) {
            forge s: stone = ofs_array_get(_env_sym, i)
            if (s == sym) {
                return i
            }
            i--
        }
        forge g = _globals_count - 1
        while (g >= 0) {
            forge gs: stone = ofs_array_get(_env_sym, g)
            if (gs == sym) {
                return g
            }
            g--
        }
        return -1
    }

    // ── Function Registry ─────────────────────────────────────────────────

    vein register_function(name: obsidian, node_id: stone) -> void {
        ofs_array_push(_func_names, name)
        ofs_array_push(_func_node_ids, node_id)
    }

    vein find_function(name: obsidian) -> stone {
        forge i = ofs_array_len(_func_names) - 1
        while (i >= 0) {
            forge fn_name: obsidian = ofs_array_get(_func_names, i)
            if (ofs_str_eq(fn_name, name)) {
                forge fid: stone = ofs_array_get(_func_node_ids, i)
                return fid
            }
            i--
        }
        return -1
    }

    // ── Call Argument Stack Helpers ───────────────────────────────────────

    vein arg_push_regs() -> void {
        ofs_array_push(_arg_kinds, _rk)
        ofs_array_push(_arg_types, _rt)
        ofs_array_push(_arg_i, _ri)
        ofs_array_push(_arg_f, _rf)
        ofs_array_push(_arg_b, _rb)
        ofs_array_push(_arg_s, _rs)
        ofs_array_push(_arg_refs, _rr)
    }

    vein args_pop_to(base: stone) -> void {
        while (ofs_array_len(_arg_kinds) > base) {
            ofs_array_pop(_arg_kinds)
            ofs_array_pop(_arg_types)
            ofs_array_pop(_arg_i)
            ofs_array_pop(_arg_f)
            ofs_array_pop(_arg_b)
            ofs_array_pop(_arg_s)
            ofs_array_pop(_arg_refs)
        }
    }

    // argumento na posicao absoluta pos -> registradores
    vein load_arg(pos: stone) -> void {
        forge k: stone = ofs_array_get(_arg_kinds, pos)
        forge t: obsidian = ofs_array_get(_arg_types, pos)
        forge iv: stone = ofs_array_get(_arg_i, pos)
        forge fv: crystal = ofs_array_get(_arg_f, pos) as crystal
        forge bv: bool = ofs_array_get(_arg_b, pos)
        forge sv: obsidian = ofs_array_get(_arg_s, pos)
        forge rv: stone = ofs_array_get(_arg_refs, pos)
        r_set(k, t, iv, fv, bv, sv, rv)
    }

    vein arg_i(pos: stone) -> stone {
        forge v: stone = ofs_array_get(_arg_i, pos)
        return v
    }

    vein arg_s(pos: stone) -> obsidian {
        forge v: obsidian = ofs_array_get(_arg_s, pos)
        return v
    }

    vein arg_ref(pos: stone) -> stone {
        forge v: stone = ofs_array_get(_arg_refs, pos)
        return v
    }

    vein arg_kind(pos: stone) -> stone {
        forge v: stone = ofs_array_get(_arg_kinds, pos)
        return v
    }

    vein arg_b(pos: stone) -> bool {
        forge v: bool = ofs_array_get(_arg_b, pos)
        return v
    }

    vein arg_t(pos: stone) -> obsidian {
        forge v: obsidian = ofs_array_get(_arg_types, pos)
        return v
    }

    vein arg_f(pos: stone) -> crystal {
        forge v: crystal = ofs_array_get(_arg_f, pos) as crystal
        return v
    }

    // arg como crystal (inteiro convertido)
    vein arg_num(pos: stone) -> crystal {
        if (arg_kind(pos) == VAL_FLOAT) { return arg_f(pos) }
        return arg_i(pos) as crystal
    }

    // ── Builtin Functions ─────────────────────────────────────────────────

    vein is_builtin(name: obsidian) -> bool {
        return builtin_code(name) != BI_NONE
    }

    // concatena o texto de todos os argumentos
    vein args_text(num_args: stone, arg_base: stone) -> obsidian {
        forge s = ""
        forge i = 0
        while (i < num_args) {
            load_arg(arg_base + i)
            s = s + r_to_string()
            i++
        }
        return s
    }

    // resultado -> registradores
    vein call_builtin(code: stone, num_args: stone, arg_base: stone) -> void {
        if (code == BI_BEDROCK_LIFT) {
            // a mesma copia do nativo (ofs_arena_lift): so muda o texto que
            // esta numa arena viva (buffer de ofs_alloc do bloco)
            load_arg(arg_base)
            if (_rk == VAL_STRING && _rs != null) {
                ar_resolve()
                if (_ar_lift_fn != 0) {
                    forge lifted = ar_call1(_ar_lift_fn, _rs as stone)
                    r_string(lifted as obsidian)
                }
            }
            return
        }
        if (code == BI_VEIN_NAME) {
            // F6: nome do valor de vein ("null" se nulo), como o nativo
            if (num_args < 1) { r_string("null"); return }
            load_arg(arg_base)
            if (_rk == VAL_NULL) { r_string("null"); return }
            r_string(r_to_string())
            return
        }
        if (code == BI_ECHO) {
            if (num_args == 1) {
                // um argumento: sem concatenacao (o texto ja e o resultado)
                load_arg(arg_base)
                if (!_fs_mute) { echo(r_to_string()) }
            } else {
                forge es = args_text(num_args, arg_base)
                if (!_fs_mute) { echo(es) }
            }
            r_void()
            return
        }
        if (code == BI_ETCH || code == BI_ETCHLN) {
            forge s = args_text(num_args, arg_base)
            if (code == BI_ETCHLN) { s = s + "\n" }
            if (!_fs_mute) { echo(s) }
            r_void()
            return
        }
        if (code == BI_MOLD) {
            r_string(args_text(num_args, arg_base))
            return
        }
        if (code == BI_EXIT) {
            forge ecode: stone = 0
            if (num_args > 0) {
                ecode = arg_i(arg_base)
            }
            if (_fs_mode != 0) { fs_finish(ecode) }
            exit(ecode)
            r_void()
            return
        }
        if (code == BI_STR_LEN) {
            if (num_args > 0) { r_int(ofs_str_len(arg_s(arg_base))); return }
            r_int(0)
            return
        }
        if (code == BI_STR_EQ) {
            if (num_args >= 2) { r_bool(ofs_str_eq(arg_s(arg_base), arg_s(arg_base + 1))); return }
            r_bool(false)
            return
        }
        if (code == BI_STR_CONCAT) {
            if (num_args >= 2) { r_string(ofs_str_concat(arg_s(arg_base), arg_s(arg_base + 1))); return }
            r_string("")
            return
        }
        if (code == BI_STR_CHAR_AT) {
            if (num_args >= 2) { r_int(ofs_str_char_at(arg_s(arg_base), arg_i(arg_base + 1))); return }
            r_int(-1)
            return
        }
        if (code == BI_STR_SUBSTR) {
            if (num_args >= 3) { r_string(ofs_str_substr(arg_s(arg_base), arg_i(arg_base + 1), arg_i(arg_base + 2))); return }
            r_string("")
            return
        }
        if (code == BI_STR_CONTAINS) {
            if (num_args >= 2) { r_bool(ofs_str_contains(arg_s(arg_base), arg_s(arg_base + 1))); return }
            r_bool(false)
            return
        }
        if (code == BI_STONE_TO_OBS) {
            if (num_args > 0) { r_string(ofs_stone_to_obsidian(arg_i(arg_base))); return }
            r_string("0")
            return
        }
        if (code == BI_CRYSTAL_TO_OBS) {
            if (num_args > 0) {
                load_arg(arg_base)
                r_string(r_to_string())
                return
            }
            r_string("0.0")
            return
        }
        if (code == BI_OBS_TO_STONE) {
            if (num_args > 0) { r_int(parse_int(arg_s(arg_base))); return }
            r_int(0)
            return
        }
        if (code == BI_ARRAY_NEW) {
            forge h = interp_new_array()
            r_array(h)
            return
        }
        if (code >= BI_ARRAY_LEN && code <= BI_ARRAY_POP && num_args > 0 && arg_kind(arg_base) == VAL_INT) {
            // ofs_array nativo cru (endereco vindo do C/runtime, ex. *stone de
            // matrix.create): as mesmas operacoes do caminho rapido do llvmgen
            raw_array_op(code, num_args, arg_base)
            return
        }
        if (code == BI_ARRAY_LEN) {
            if (num_args > 0) { r_int(interp_array_len(arg_ref(arg_base))); return }
            r_int(0)
            return
        }
        if (code == BI_ARRAY_PUSH) {
            if (num_args >= 2) {
                forge ph = arg_ref(arg_base)
                load_arg(arg_base + 1)
                interp_array_push(ph)
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_GET) {
            if (num_args >= 2) {
                arr_check_index(arg_ref(arg_base), arg_i(arg_base + 1))
                interp_array_get(arg_ref(arg_base), arg_i(arg_base + 1))
                return
            }
            r_null()
            return
        }
        if (code == BI_ARRAY_SET) {
            if (num_args >= 3) {
                forge sh = arg_ref(arg_base)
                forge si = arg_i(arg_base + 1)
                arr_check_index(sh, si)
                load_arg(arg_base + 2)
                interp_array_set(sh, si)
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_POP) {
            if (num_args > 0) {
                interp_array_pop(arg_ref(arg_base))
                return
            }
            r_null()
            return
        }
        if (code == BI_POW) {
            if (num_args >= 2) {
                r_float(ofs_pow(arg_num(arg_base), arg_num(arg_base + 1)))
                return
            }
            r_float(0.0)
            return
        }
        if (code == BI_SQRT) {
            if (num_args > 0) {
                r_float(ofs_sqrt(arg_num(arg_base)))
                return
            }
            r_float(0.0)
            return
        }
        if (code == BI_FAULT_CALL) {
            ffi_fault_call(num_args, arg_base)
            return
        }
        if (code == BI_FAULT_STEP) {
            ffi_fault_step(num_args, arg_base)
            return
        }
        if (code == BI_VARIANT_NAME) {
            // nome da variante; etiqueta fora da tabela sai como numero
            load_arg(arg_base)
            if (_rk == VAL_VARIANT) { r_string(_rt); return }
            forge vn_tag = reg_as_int()
            forge vn = variant_name_at(vn_tag)
            if (ofs_str_eq(vn, "")) { vn = ofs_stone_to_obsidian(vn_tag) }
            r_string(vn)
            return
        }
        if (code == BI_CONTRACT_FAIL) {
            // o mesmo texto do nativo (ofs_array_fail): "ofs: " + msg, rc 1
            ffi_stderr("ofs: " + arg_s(arg_base) + "\n")
            exit(1)
            r_void()
            return
        }
        if (code == BI_BOOL_TEXT) {
            load_arg(arg_base)
            if (r_truthy()) { r_string("true") } else { r_string("false") }
            return
        }
        if (code >= BI_FAULT_COUNT && code <= BI_FAULT_STEP) {
            call_fault(code, num_args, arg_base)
            return
        }
        r_void()
    }

    // ofs_array_len/push/get/set/pop sobre um ofs_array nativo cru
    // (elementos de 8 bytes; inteiros, ou crystal no push/set de crystal)
    vein raw_array_op(code: stone, num_args: stone, arg_base: stone) -> void {
        forge na: Array<stone> = arg_i(arg_base) as Array
        if (code == BI_ARRAY_LEN) { r_int(ofs_array_len(na)); return }
        if (code == BI_ARRAY_PUSH && num_args >= 2) {
            load_arg(arg_base + 1)
            if (_rk == VAL_FLOAT) {
                forge nf: Array<crystal> = arg_i(arg_base) as Array
                ofs_array_push(nf, _rf)
            } else {
                ofs_array_push(na, reg_as_int())
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_GET && num_args >= 2) {
            forge gv: stone = ofs_array_get(na, arg_i(arg_base + 1))
            r_int(gv)
            return
        }
        if (code == BI_ARRAY_SET && num_args >= 3) {
            forge si = arg_i(arg_base + 1)
            load_arg(arg_base + 2)
            if (_rk == VAL_FLOAT) {
                forge sf: Array<crystal> = arg_i(arg_base) as Array
                ofs_array_set(sf, si, _rf)
            } else {
                ofs_array_set(na, si, reg_as_int())
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_POP) {
            forge pv: stone = ofs_array_pop(na)
            r_int(pv)
            return
        }
        r_void()
    }

    // ── Intrinsecos fault_* ───────────────────────────────────────────────
    // Mesmos resultados do build nativo (llvm.ctpop/ctlz/cttz/fshl/fshr/
    // bswap): inteiros de 64 bits em complemento de 2; 0 tem 64 zeros.

    // deslocamento logico a direita (o `>>` de stone e aritmetico)
    vein fault_lshr(x: stone, k: stone) -> stone {
        if (k <= 0) { return x }
        if (k >= 64) { return 0 }
        return (x >> k) & ((1 << (64 - k)) - 1)
    }

    vein fault_popcount(x: stone) -> stone {
        forge c = 0
        forge i = 0
        while (i < 64) {
            if (((x >> i) & 1) != 0) { c++ }
            i++
        }
        return c
    }

    vein fault_clz(x: stone) -> stone {
        forge i = 63
        while (i >= 0) {
            if (((x >> i) & 1) != 0) { return 63 - i }
            i--
        }
        return 64
    }

    vein fault_ctz(x: stone) -> stone {
        forge i = 0
        while (i < 64) {
            if (((x >> i) & 1) != 0) { return i }
            i++
        }
        return 64
    }

    vein fault_rotl(x: stone, n: stone) -> stone {
        forge s = n & 63
        if (s == 0) { return x }
        return (x << s) | fault_lshr(x, 64 - s)
    }

    vein fault_bswap(x: stone) -> stone {
        forge r = 0
        forge i = 0
        while (i < 8) {
            r = (r << 8) | ((x >> (8 * i)) & 255)
            i++
        }
        return r
    }

    // mascara dos `len` bytes baixos (len >= 8: todos)
    vein fault_byte_mask(len: stone) -> stone {
        if (len >= 8) { return -1 }
        return (1 << (8 * len)) - 1
    }

    vein fault_runtime_error(msg: obsidian) -> void {
        echo("Interpreter runtime error: " + msg)
        if (_fs_mode != 0) { fs_finish(1) }
        exit(1)
    }

    // fault_memcpy(dst, src, len) / fault_memset(dst, byte, len): memoria
    // crua de verdade (memcpy/memset da libc), como o llvm.memcpy/memset do
    // nativo. Ponteiros: endereco do C, &x, obsidian, monolith ou Array.
    vein fault_mem(code: stone, num_args: stone, arg_base: stone) -> void {
        fracture {
            if (num_args < 3) {
                fault_runtime_error("fault_memcpy/fault_memset esperam (ponteiro, valor, len)")
                return
            }
            forge len = arg_i(arg_base + 2)
            if (len <= 0) { r_void(); return }
            load_arg(arg_base)
            forge dst = reg_as_int()
            if (code == BI_FAULT_MEMCPY) {
                load_arg(arg_base + 1)
                forge src = reg_as_int()
                memcpy(dst as *u8, src as *u8, len)
            } else {
                memset(dst as *u8, arg_i(arg_base + 1) & 255, len)
            }
            r_void()
        }
    }

    vein call_fault(code: stone, num_args: stone, arg_base: stone) -> void {
        forge a0 = 0
        forge a1 = 0
        forge a2 = 0
        forge a3 = 0
        if (num_args > 0) { a0 = arg_i(arg_base) }
        if (num_args > 1) { a1 = arg_i(arg_base + 1) }
        if (num_args > 2) { a2 = arg_i(arg_base + 2) }
        if (num_args > 3) { a3 = arg_i(arg_base + 3) }
        if (code == BI_FAULT_COUNT) { r_int(fault_popcount(a0)); return }
        if (code == BI_FAULT_LEAD) { r_int(fault_clz(a0)); return }
        if (code == BI_FAULT_TRAIL) { r_int(fault_ctz(a0)); return }
        if (code == BI_FAULT_SPIN_L) { r_int(fault_rotl(a0, a1)); return }
        if (code == BI_FAULT_SPIN_R) { r_int(fault_rotl(a0, 64 - (a1 & 63))); return }
        if (code == BI_FAULT_WEAVE) { r_int((a1 & a0) | (a2 & (a0 ^ -1))); return }
        if (code == BI_FAULT_SWAP) { r_int(fault_bswap(a0)); return }
        if (code == BI_FAULT_CUT) {
            r_int((a0 >> a1) & ((1 << a2) - 1))
            return
        }
        if (code == BI_FAULT_PATCH) {
            forge m1 = (1 << a2) - 1
            r_int((a0 & ((m1 << a1) ^ -1)) | ((a3 & m1) << a1))
            return
        }
        if (code == BI_FAULT_TRAP) {
            // como llvm.trap no nativo: SIGILL
            raise(4)
            exit(132)
            return
        }
        if (code == BI_FAULT_MEMCPY || code == BI_FAULT_MEMSET) {
            fault_mem(code, num_args, arg_base)
            return
        }
        r_void()
    }

    // ── FFI: extern vein / rift vein (F1) ─────────────────────────────────
    // Cada `extern vein f(...)` (ou `rift vein ... bind "sym"`) vira um
    // endereco: dlsym(RTLD_DEFAULT, sym), resolvido uma vez no carregamento
    // para toda chamada presente no programa (o linker do build nativo exige
    // o mesmo: simbolo referenciado e ausente = erro, codigo de saida 1).
    // O ofscc e linkado com -rdynamic, entao o runtime OFS (ofs_alloc,
    // ofs_echo_color...) tambem e achado; libm e as libs de OFS_FFI_LIBS sao
    // abertas com RTLD_GLOBAL antes. A chamada passa pelos trampolins tipados
    // de __ofs_ffi_dispatch (llvmgen.emit_ffi_dispatch): inteiros, bool,
    // ponteiros e obsidian (char*) vao como i64; crystal como double.
    // Ponteiros sao enderecos reais (VAL_INT com tipo "*T"); `&x`, Array
    // (a coluna nativa) e monolith (o bloco com layout C) vao ao C como
    // endereco (F2).

    // Plataforma: RTLD_DEFAULT e 0 em glibc, bionic (LP64) e no shim do
    // Windows (magma_windows.ofs); no macOS e -2. ffi_init descobre qual
    // funciona procurando `strlen`.
    forge _ffi_default: stone = 0
    forge _ffi_macos: bool = false

    vein ffi_rtld_default() -> stone {
        return _ffi_default
    }

    // RTLD_NOW | RTLD_GLOBAL (glibc/bionic LP64: 2 | 0x100; macOS: 2 | 8)
    vein ffi_dlopen_flags() -> stone {
        if (_ffi_macos) { return 10 }
        return 258
    }

    vein ffi_stderr(msg: obsidian) -> void {
        write(2, msg, ofs_str_len(msg))
    }

    vein ffi_open_lib(path: obsidian) -> bool {
        if (ofs_str_len(path) == 0) { return false }
        forge h = dlopen(path, ffi_dlopen_flags())
        if (h == 0) { return false }
        if (ofs_str_len(_ffi_libs) > 0) { _ffi_libs = _ffi_libs + ", " }
        _ffi_libs = _ffi_libs + path
        return true
    }

    vein ffi_init() -> void {
        if (_ffi_ready) { return }
        _ffi_ready = true
        _ffi_buf = ofs_alloc(FFI_BUF_BYTES) as stone
        if (dlsym(0, "strlen") == 0 && dlsym(-2, "strlen") != 0) {
            _ffi_default = -2
            _ffi_macos = true
        }
        // o build nativo liga -lm (e -lc); X11/Xft so entram em apps de UI
        if (!ffi_open_lib("libm.so.6")) { ffi_open_lib("libm.so") }
        // bibliotecas extras: OFS_FFI_LIBS="libfoo.so:/caminho/libbar.so"
        forge extra: obsidian = getenv("OFS_FFI_LIBS")
        if (extra != null) {
            forge n = ofs_str_len(extra)
            forge st = 0
            forge i = 0
            while (i <= n) {
                if (i == n || ofs_str_char_at(extra, i) == 58) {
                    forge lib = ofs_str_substr(extra, st, i - st)
                    if (ofs_str_len(lib) > 0 && !ffi_open_lib(lib)) {
                        ffi_stderr("ofs run: aviso: nao foi possivel abrir '" + lib + "' (OFS_FFI_LIBS)\n")
                    }
                    st = i + 1
                }
                i++
            }
        }
        _ffi_disp = dlsym(ffi_rtld_default(), "__ofs_ffi_dispatch")
        _ffi_exports = dlsym(ffi_rtld_default(), "ofs_alloc") != 0
    }

    vein ffi_type_class(t: obsidian) -> stone {
        if (ofs_str_len(t) == 0) { return TC_VOID }
        if (ofs_str_char_at(t, 0) == 42) { return TC_PTR }
        if (vein_type_is(t)) { return TC_PTR }
        if (ofs_str_eq(t, "stone") || ofs_str_eq(t, "i64") || ofs_str_eq(t, "u64") || ofs_str_eq(t, "variant")) { return TC_INT }
        if (ofs_str_eq(t, "obsidian")) { return TC_STR }
        if (ofs_str_eq(t, "crystal") || ofs_str_eq(t, "f64")) { return TC_F64 }
        if (ofs_str_eq(t, "bool") || ofs_str_eq(t, "bool1")) { return TC_BOOL }
        if (ofs_str_eq(t, "void")) { return TC_VOID }
        if (ofs_str_eq(t, "i32")) { return TC_I32 }
        if (ofs_str_eq(t, "u32")) { return TC_U32 }
        if (ofs_str_eq(t, "i16")) { return TC_I16 }
        if (ofs_str_eq(t, "u16")) { return TC_U16 }
        if (ofs_str_eq(t, "i8")) { return TC_I8 }
        if (ofs_str_eq(t, "u8")) { return TC_U8 }
        if (ofs_str_eq(t, "ptr")) { return TC_PTR }
        if (ofs_str_eq(t, "f32")) { return TC_F32 }
        return TC_AGG
    }

    // sym vazio: o do `bind` (type_str do no) ou o proprio nome
    vein register_extern(name: obsidian, node_id: stone, sym_in: obsidian) -> void {
        forge sym: obsidian = sym_in
        if (ofs_str_len(sym) == 0) { sym = ntype(node_id) }
        if (ofs_str_len(sym) == 0) { sym = name }
        forge pcls: Array<stone> = []
        forge params = nc0(node_id)
        forge np = nx_len(params)
        forge j = 0
        while (j < np) {
            forge pid = nx_at(params, j)
            forge pt = ""
            if (nc0(pid) >= 0) { pt = nval(nc0(pid)) }
            ofs_array_push(pcls, ffi_type_class(pt))
            j++
        }
        forge rt = "void"
        if (nc1(node_id) >= 0) { rt = nval(nc1(node_id)) }
        ofs_array_push(_ext_names, name)
        ofs_array_push(_ext_syms, sym)
        ofs_array_push(_ext_nodes, node_id)
        ofs_array_push(_ext_addr, 0)
        ofs_array_push(_ext_vfix, llvmgen.variadic_fixed_count(sym))
        ofs_array_push(_ext_pcls, pcls)
        ofs_array_push(_ext_rcls, ffi_type_class(rt))
        ofs_array_push(_ext_rtype, rt)
        ofs_array_push(_ext_vref, false)
    }

    // Vein definida em stdlib/runtime/*.ofs cujo simbolo o ofscc exporta (o
    // runtime linkado nele): roda nativa, como um builtin, em vez de
    // interpretar o codigo de memoria crua do runtime. OFS_RUN_RUNTIME=interp
    // desliga (interpreta tudo). Assinaturas fora do FFI continuam
    // interpretadas.
    vein ffi_runtime_native(node_id: stone, sym: obsidian) -> bool {
        if (!ast_line_is_runtime(node_line_of(node_id))) { return false }
        forge mode: obsidian = getenv("OFS_RUN_RUNTIME")
        if (mode != null && ofs_str_eq(mode, "interp")) { return false }
        forge params = nc0(node_id)
        forge np = nx_len(params)
        if (np > FFI_MAX_ARGS) { return false }
        forge fmask = 0
        forge j = 0
        while (j < np) {
            forge pid = nx_at(params, j)
            forge pt = ""
            if (nc0(pid) >= 0) { pt = nval(nc0(pid)) }
            forge c = ffi_type_class(pt)
            if (c == TC_AGG) { return false }
            if (c == TC_F64 || c == TC_F32) {
                if (j >= 6) { return false }
                fmask = fmask | (1 << j)
            }
            j++
        }
        forge rt = "void"
        if (nc1(node_id) >= 0) { rt = nval(nc1(node_id)) }
        forge rc = ffi_type_class(rt)
        if (rc == TC_AGG) { return false }
        forge retf = 0
        if (rc == TC_F64 || rc == TC_F32) { retf = 1 }
        if (!llvmgen.ffi_sig_supported(np, fmask, retf, 0)) { return false }
        ffi_init()
        if (_ffi_disp == 0 && (fmask != 0 || retf != 0)) { return false }
        return dlsym(ffi_rtld_default(), sym) != 0
    }

    vein find_extern(name: obsidian) -> stone {
        forge i = ofs_array_len(_ext_names) - 1
        while (i >= 0) {
            forge en: obsidian = ofs_array_get(_ext_names, i)
            if (ofs_str_eq(en, name)) { return i }
            i--
        }
        return -1
    }

    vein ext_sym(ei: stone) -> obsidian {
        forge s: obsidian = ofs_array_get(_ext_syms, ei)
        return s
    }

    // endereco da extern ei (0 = simbolo ausente)
    vein ffi_resolve(ei: stone) -> stone {
        forge a: stone = ofs_array_get(_ext_addr, ei)
        if (a != 0) { return a }
        ffi_init()
        a = dlsym(ffi_rtld_default(), ext_sym(ei))
        if (a == 0 && !_ffi_ui_libs) {
            // o wrapper `ofs build` tambem liga -lX11 -lXft quando existem:
            // abre so se algum simbolo nao for achado no processo/libm
            _ffi_ui_libs = true
            ffi_open_lib("libX11.so.6")
            ffi_open_lib("libXft.so.2")
            a = dlsym(ffi_rtld_default(), ext_sym(ei))
        }
        ofs_array_set(_ext_addr, ei, a)
        return a
    }

    // mesma ideia do erro do linker no build nativo
    vein ffi_undefined_msg(sym: obsidian) -> obsidian {
        forge m = "ofs run: erro: undefined reference to `" + sym + "' (extern vein sem simbolo no processo"
        if (ofs_str_len(_ffi_libs) > 0) { m = m + " nem em " + _ffi_libs }
        m = m + "; outras bibliotecas: OFS_FFI_LIBS=libx.so"
        if (!_ffi_exports) {
            m = m + "; este ofscc nao exporta o runtime: linke-o com -rdynamic"
        }
        return m + ")\n"
    }

    // Toda chamada a extern (e todo fault_addr de extern) presente no
    // programa precisa do simbolo, como no link nativo.
    vein ffi_check_symbols() -> void {
        forge missing = 0
        forge seen: Array<stone> = []
        forge i = 0
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_CALL) {
                forge ck: stone = ofs_array_get(_nop, i)
                forge ei = -1
                if (ck == CALL_EXTERN) {
                    ei = ofs_array_get(_naux, i)
                } else if (ck == CALL_BUILTIN) {
                    forge aux: stone = ofs_array_get(_naux, i)
                    if (aux == BI_FAULT_ADDR && nx_len(i) == 1) {
                        forge an = nx_at(i, 0)
                        if (find_function(nval(an)) < 0) { ei = find_extern(nval(an)) }
                    }
                }
                if (ei >= 0) {
                    if (ffi_resolve(ei) == 0) {
                        forge dup = false
                        forge si = 0
                        while (si < ofs_array_len(seen)) {
                            forge sv: stone = ofs_array_get(seen, si)
                            if (ofs_str_eq(ext_sym(sv), ext_sym(ei))) { dup = true }
                            si++
                        }
                        if (!dup) {
                            ofs_array_push(seen, ei)
                            ffi_stderr(ffi_undefined_msg(ext_sym(ei)))
                            missing++
                        }
                    }
                }
            }
            i++
        }
        if (missing > 0) { exit(1) }
    }

    // ajusta v a largura/sinal da classe (o que o C espera no registrador)
    vein ffi_narrow(v: stone, cls: stone) -> stone {
        if (cls == TC_I32) { return ((v & 4294967295) ^ 2147483648) - 2147483648 }
        if (cls == TC_U32) { return v & 4294967295 }
        if (cls == TC_I16) { return ((v & 65535) ^ 32768) - 32768 }
        if (cls == TC_U16) { return v & 65535 }
        if (cls == TC_I8) { return ((v & 255) ^ 128) - 128 }
        if (cls == TC_U8) { return v & 255 }
        if (cls == TC_BOOL) {
            if ((v & 4294967295) != 0) { return 1 }
            return 0
        }
        return v
    }

    // argumento na posicao pos como i64 para o C (classe inteira/ponteiro)
    vein ffi_arg_int(pos: stone, cls: stone, what: obsidian) -> stone {
        forge k = arg_kind(pos)
        forge v = 0
        if (k == VAL_INT) { v = arg_i(pos) }
        else if (k == VAL_BOOL) {
            if (arg_b(pos)) { v = 1 }
        }
        else if (k == VAL_FLOAT) { v = arg_f(pos) as stone }
        else if (k == VAL_STRING) { v = arg_s(pos) as stone }
        else if (k == VAL_NULL || k == VAL_VOID) { v = 0 }
        else if (k == VAL_VARIANT) { v = variant_index(arg_t(pos)) }
        else if (k == VAL_OBJECT) { v = arg_ref(pos) }
        else if (k == VAL_FN) {
            // vein interpretada vai ao C como trampolim de callback
            load_arg(pos)
            v = fn_native_addr()
        }
        else if (k == VAL_ARRAY) {
            // o ofs_array nativo do array; o comprimento volta na sincronia
            forge h = arg_ref(pos)
            v = arr_native_ptr(h)
            ofs_array_push(_ffi_sync_h, h)
            ofs_array_push(_ffi_sync_c, _arr_last_col)
        }
        return ffi_narrow(v, cls)
    }

    vein ffi_slot(i: stone) -> stone {
        return _ffi_buf + 8 * i
    }

    vein ffi_put_i(i: stone, v: stone) -> void {
        fracture {
            forge p: *stone = ffi_slot(i) as *stone
            fracture { *p = v }
        }
    }

    vein ffi_put_f(i: stone, v: crystal) -> void {
        fracture {
            forge p: *crystal = ffi_slot(i) as *crystal
            fracture { *p = v }
        }
    }

    vein ffi_get_i(i: stone) -> stone {
        fracture {
            forge p: *stone = ffi_slot(i) as *stone
            forge v: stone = 0
            fracture { v = *p }
            return v
        }
    }

    vein ffi_get_f(i: stone) -> crystal {
        fracture {
            forge p: *crystal = ffi_slot(i) as *crystal
            forge v: crystal = 0.0
            fracture { v = *p }
            return v
        }
    }

    // Chama addr com os slots ja preenchidos; resultado inteiro bruto (o
    // double fica em _ffi_ret_f).
    forge _ffi_ret_f: crystal = 0.0

    vein ffi_invoke(addr: stone, nargs: stone, fmask: stone, retf: stone, vfixed: stone, what: obsidian) -> stone {
        abyss {
            if (!llvmgen.ffi_sig_supported(nargs, fmask, retf, vfixed)) {
                fault_runtime_error(what + ": assinatura FFI sem trampolim (" + ofs_stone_to_obsidian(nargs) + " args; ate 4 com crystal, 12 so inteiros, variadica ate 4 extras)")
                return 0
            }
            if (_ffi_disp == 0) {
                // ofscc sem trampolins (gerado por compilador antigo ou sem
                // -rdynamic): so inteiros/ponteiros, todos como i64
                if (fmask != 0 || retf != 0) {
                    fault_runtime_error(what + ": crystal no FFI precisa dos trampolins (__ofs_ffi_dispatch) e de um ofscc linkado com -rdynamic")
                    return 0
                }
                return fault_call(addr, ffi_get_i(0), ffi_get_i(1), ffi_get_i(2), ffi_get_i(3), ffi_get_i(4), ffi_get_i(5), ffi_get_i(6), ffi_get_i(7), ffi_get_i(8), ffi_get_i(9), ffi_get_i(10), ffi_get_i(11))
            }
            ffi_put_i(FFI_SLOT_ST, 0)
            forge r = fault_call(_ffi_disp, addr, llvmgen.ffi_sig(nargs, fmask, retf, vfixed), _ffi_buf)
            if (ffi_get_i(FFI_SLOT_ST) != 0) {
                fault_runtime_error(what + ": assinatura FFI sem trampolim")
                return 0
            }
            if (retf != 0) { _ffi_ret_f = ffi_get_f(FFI_SLOT_RET) }
            return r
        }
    }

    // resultado -> registradores
    vein call_extern(ei: stone, num_args: stone, arg_base: stone) -> void {
        // ofs fossil: chamada que vem do mundo de fora (gravada/reproduzida)
        if (_fs_mode != 0) { fs_extern_enter(ei, num_args, arg_base) }
        forge addr = ffi_resolve(ei)
        forge sym = ext_sym(ei)
        if (addr == 0) {
            ffi_stderr(ffi_undefined_msg(sym))
            exit(1)
            return
        }
        forge pcls: Array<stone> = ofs_array_get(_ext_pcls, ei)
        forge np = ofs_array_len(pcls)
        forge vfixed: stone = ofs_array_get(_ext_vfix, ei)
        if (vfixed > np) { vfixed = -1 }
        if (vfixed < 0) { vfixed = 0 }
        forge rcls: stone = ofs_array_get(_ext_rcls, ei)
        forge rtype: obsidian = ofs_array_get(_ext_rtype, ei)
        ffi_call_addr(addr, pcls, vfixed, rcls, rtype, "extern '" + sym + "'", num_args, arg_base)
    }

    // F6: chamada de um endereco nativo com a assinatura de um tipo vein(...)
    // (valor de vein de extern ou vindo do C): a assinatura e conhecida pelo
    // tipo, sem adivinhar pelos valores
    vein call_native_sig(addr: stone, ft: obsidian, num_args: stone, arg_base: stone, what: obsidian) -> void {
        ffi_init()
        forge plist = vein_type_params(ft)
        forge np = type_list_len(plist)
        forge pcls: Array<stone> = []
        forge j = 0
        while (j < np) {
            ofs_array_push(pcls, ffi_type_class(type_list_at(plist, j)))
            j++
        }
        forge rt = vein_type_ret(ft)
        ffi_call_addr(addr, pcls, 0, ffi_type_class(rt), rt, what, num_args, arg_base)
    }

    // chamada C de addr: argumentos pelas classes pcls, retorno rcls/rtype
    vein ffi_call_addr(addr: stone, pcls: Array<stone>, vfixed: stone, rcls: stone, rtype: obsidian, what: obsidian, num_args: stone, arg_base: stone) -> void {
        // politica do ofs fossil para esta chamada (0 = chamada normal)
        forge fsp = _fs_pol
        _fs_pol = 0
        forge np = ofs_array_len(pcls)
        forge sync_base = ofs_array_len(_ffi_sync_h)
        if (num_args > FFI_MAX_ARGS) {
            fault_runtime_error(what + ": mais de 12 argumentos no FFI do interpretador")
            return
        }
        forge fmask = 0
        forge j = 0
        while (j < num_args) {
            forge cls = TC_INT
            if (j < np) {
                cls = ofs_array_get(pcls, j)
            } else if (arg_kind(arg_base + j) == VAL_FLOAT) {
                cls = TC_F64
            }
            if (cls == TC_F64) {
                if (j >= 6) {
                    fault_runtime_error(what + ": crystal depois do 6o argumento no FFI do interpretador")
                    return
                }
                fmask = fmask | (1 << j)
                ffi_put_f(FFI_SLOT_F + j, arg_num(arg_base + j))
            } else if (cls == TC_F32) {
                // f32 vai num registrador float com os bits na metade baixa
                // (o C le so os 32 bits de baixo); variadica promove a double
                if (j >= 6 || (vfixed > 0 && j >= vfixed)) {
                    fault_runtime_error(what + ": f32 depois do 6o argumento ou na parte variadica no FFI do interpretador")
                    return
                }
                fmask = fmask | (1 << j)
                ffi_put_i(FFI_SLOT_F + j, f32_bits(arg_num(arg_base + j)))
            } else if (cls == TC_AGG) {
                // monolith/Array: o nativo passa ponteiro
                ffi_put_i(j, ffi_arg_int(arg_base + j, TC_PTR, what))
            } else {
                ffi_put_i(j, ffi_arg_int(arg_base + j, cls, what))
            }
            j++
        }
        forge retf = 0
        if (rcls == TC_F64 || rcls == TC_F32) { retf = 1 }
        forge r = 0
        if (fsp != 0) {
            r = fs_invoke(fsp, addr, num_args, fmask, retf, vfixed, what, rcls)
        } else {
            r = ffi_invoke(addr, num_args, fmask, retf, vfixed, what)
        }
        if (rcls == TC_AGG) {
            ffi_set_agg_result(r, rtype, sync_base)
        } else {
            ffi_set_result(r, rcls, rtype)
        }
        ffi_sync_arrays(sync_base)
    }

    // arrays passados ao C desde sync_base: comprimento de volta (o C pode ter
    // feito push/pop); registradores intactos
    vein ffi_sync_arrays(sync_base: stone) -> void {
        while (ofs_array_len(_ffi_sync_h) > sync_base) {
            forge n = ofs_array_len(_ffi_sync_h) - 1
            forge h: stone = ofs_array_get(_ffi_sync_h, n)
            forge c: stone = ofs_array_get(_ffi_sync_c, n)
            arr_sync(h, c)
            ofs_array_pop(_ffi_sync_h)
            ofs_array_pop(_ffi_sync_c)
        }
    }

    // retorno monolith/Array do C (ponteiro): monolith = o bloco; Array = o
    // array que foi passado nesta chamada (mesmo ofs_array) ou um novo que
    // usa o bloco nativo
    vein ffi_set_agg_result(r: stone, rtype: obsidian, sync_base: stone) -> void {
        if (r == 0) { r_null(); return }
        forge c = mem_class(rtype)
        if (c == MC_ARRAY) {
            forge i = sync_base
            while (i < ofs_array_len(_ffi_sync_h)) {
                forge h: stone = ofs_array_get(_ffi_sync_h, i)
                forge col: stone = ofs_array_get(_ffi_sync_c, i)
                if (arr_col_array(h, col) == r) { r_array(h); return }
                i++
            }
        }
        regs_from_raw(r, c, rtype)
    }

    // retorno bruto do C -> registradores, pelo tipo declarado
    vein ffi_set_result(r: stone, rcls: stone, rtype: obsidian) -> void {
        if (rcls == TC_VOID) { r_void(); return }
        if (rcls == TC_F64) { r_float(_ffi_ret_f); return }
        if (rcls == TC_F32) {
            r_float(bits_f32(ffi_get_i(FFI_SLOT_RET)))
            _rt = "f32"
            return
        }
        if (rcls == TC_BOOL) { r_bool(ffi_narrow(r, TC_BOOL) != 0); return }
        if (rcls == TC_STR) {
            // char* do C vira obsidian sem copia: no nativo obsidian E o
            // ponteiro (FILE* em `-> obsidian`, buffer de ofs_alloc que o C
            // preenche depois); copiar quebraria esses usos.
            if (r == 0) { r_null(); return }
            r_string(r as obsidian)
            return
        }
        if (rcls == TC_PTR) {
            if (r == 0) { r_null(); return }
            if (vein_type_is(rtype)) { fn_from_raw(r, rtype); return }
            r_int(r)
            _rt = rtype
            return
        }
        r_int(ffi_narrow(r, rcls))
    }

    // fault_addr(vein): endereco C (extern/rift); vein OFS e callback (F2)
    vein ffi_fault_addr(id: stone) -> void {
        forge an = nx_at(id, 0)
        forge name: obsidian = nval(an)
        forge fid = find_function(name)
        if (fid >= 0) {
            r_int(cb_slot_for(fid, name))
            return
        }
        forge ei = find_extern(name)
        if (ei < 0) {
            fault_runtime_error("fault_addr espera o nome de uma vein")
            return
        }
        forge a = ffi_resolve(ei)
        if (a == 0) {
            ffi_stderr(ffi_undefined_msg(ext_sym(ei)))
            exit(1)
        }
        r_int(a)
    }

    // fault_call(endereco, args...): como no nativo, cada argumento vai no
    // tipo do valor (crystal = double, resto i64) e o retorno e i64.
    vein ffi_fault_call(num_args: stone, arg_base: stone) -> void {
        if (num_args < 1) { r_int(0); return }
        forge ak = arg_kind(arg_base)
        if (ak != VAL_INT) {
            fault_runtime_error("fault_call: o primeiro argumento precisa ser um endereco (fault_addr)")
            return
        }
        ffi_init()
        forge addr = arg_i(arg_base)
        forge sync_base = ofs_array_len(_ffi_sync_h)
        forge n = num_args - 1
        if (n > FFI_MAX_ARGS) {
            fault_runtime_error("fault_call: mais de 12 argumentos no interpretador")
            return
        }
        forge fmask = 0
        forge j = 0
        while (j < n) {
            forge pos = arg_base + 1 + j
            if (arg_kind(pos) == VAL_FLOAT) {
                if (j >= 6) {
                    fault_runtime_error("fault_call: crystal depois do 6o argumento")
                    return
                }
                fmask = fmask | (1 << j)
                ffi_put_f(FFI_SLOT_F + j, arg_f(pos))
            } else if (arg_kind(pos) == VAL_BOOL) {
                ffi_put_i(j, ffi_arg_int(pos, TC_BOOL, "fault_call"))
            } else {
                ffi_put_i(j, ffi_arg_int(pos, TC_INT, "fault_call"))
            }
            j++
        }
        forge fr = ffi_invoke(addr, n, fmask, 0, 0, "fault_call")
        ffi_sync_arrays(sync_base)
        r_int(fr)
    }

    // fault_step(p, i): p + i * sizeof(*p) (getelementptr do llvmgen, com o
    // tipo estatico de p; sem ele, o tipo do valor)
    vein ffi_fault_step(num_args: stone, arg_base: stone) -> void {
        if (num_args < 2) { r_null(); return }
        forge t: obsidian = ""
        if (_cur_call_id >= 0) { t = ntype(nx_at(_cur_call_id, 0)) }
        if (!(ofs_str_len(t) > 1 && ofs_str_char_at(t, 0) == 42)) { t = arg_t(arg_base) }
        load_arg(arg_base)
        forge base = reg_as_int()
        forge pointee = pointee_of(t)
        r_int(base + arg_i(arg_base + 1) * llvmgen.type_storage_size(pointee))
        if (ofs_str_len(t) > 1 && ofs_str_char_at(t, 0) == 42) { _rt = t }
    }

    // ── Execucao hibrida (F5): veins com quartz rodam nativas ─────────────
    // O interpretador nao executa assembly. No carregamento, as veins que
    // contem `quartz` (raizes) e o fechamento delas (veins chamadas ou usadas
    // como valor, globais; tipos/strings/externs do programa inteiro) viram
    // um modulo LLVM gerado pelo proprio llvmgen (llvmgen.hy_generate), que
    // o clang compila para .so num cache por hash do IR
    // ($OFS_QUARTZ_CACHE ou ~/.cache/ofs/quartz). O .so e aberto com
    // RTLD_LOCAL e -Bsymbolic (as veins dele chamam as copias nativas dele);
    // o runtime (ofs_*, echo_*) vem do proprio ofscc (-rdynamic), entao heap,
    // stdout e strings sao os mesmos dos dois lados.
    // Chamada interpretado -> nativo: pela assinatura declarada da raiz, com
    // o FFI tipado (ffi_call_addr/__ofs_ffi_dispatch, F1). Nativo ->
    // interpretado: valor de vein interpretada vira trampolim __ofs_cb_K (F2).
    // Globais (onda 4): cada global que o fechamento usa mora numa celula
    // unica, a mesma para o interpretador e todos os .so (hy_global_cell);
    // so Array e valor de vein sao copiados na fronteira (e em volta de cada
    // callback).
    forge _hy_on: bool = false
    forge _hy_depth: stone = 0
    forge _hy_fid: Array<stone> = []
    forge _hy_value_addr: Array<stone> = []
    forge _hy_value_fid: Array<stone> = []
    forge _hy_addr: Array<stone> = []
    forge _hy_pcls: Array<Array> = []
    forge _hy_rcls: Array<stone> = []
    forge _hy_rtype: Array<obsidian> = []
    forge _hy_gsym: Array<stone> = []
    forge _hy_gidx: Array<stone> = []
    forge _hy_gaddr: Array<stone> = []
    forge _hy_gtype: Array<obsidian> = []
    forge _hy_gcls: Array<stone> = []
    forge _hy_garr: Array<stone> = []
    forge _hy_gcol: Array<stone> = []
    forge _hy_gptr: Array<stone> = []
    // Cristalizacao: um lote com todos os candidatos; depois, modulos de OSR
    // por laco. Todos compartilham as celulas dos globais.
    forge _cr_enabled: bool = true
    forge _cr_threshold: stone = 1000
    forge _cr_heat: Array<stone> = []
    forge _cr_eligible: Array<bool> = []
    forge _cr_quartz: Array<bool> = []
    forge _cr_names: Array<obsidian> = []
    forge _cr_fids: Array<stone> = []
    forge _cr_root: stone = -1
    forge _cr_started: bool = false
    forge _cr_hot: bool = false
    forge _cr_done: bool = false
    forge _cr_pending: bool = false
    forge _cr_so: obsidian = ""
    forge _cr_dir: obsidian = ""
    forge _cr_ready: obsidian = ""
    forge _cr_log: obsidian = ""
    forge _hy_temp: obsidian = ""
    // trabalho em segundo plano pendente: raizes, geracao do programa e tipo
    // (lote da cristalizacao ou recristalizacao da Fault Refract)
    forge _cr_jnames: Array<obsidian> = []
    forge _cr_jfids: Array<stone> = []
    forge _cr_jgen: stone = 0
    forge _cr_jrefract: bool = false
    // modo brando (Fault Refract): falha do clang/dlopen nao encerra o
    // programa; quem chamou ve _hy_soft_err e mantem a versao em execucao
    forge _hy_soft: bool = false
    forge _hy_soft_err: bool = false
    // cada .so carregado e um modulo com a sua copia dos globais: a sincronia
    // na fronteira so mexe nos globais do modulo da vein chamada
    forge _hy_mod: stone = 0
    forge _hy_nmods: stone = 0
    forge _hy_fmod: Array<stone> = []
    forge _hy_gmod: Array<stone> = []

    // ── Fault Refract (L0/L1): edicao ao vivo ─────────────────────────────
    // `ofs refract app.ofs` (OFS_REFRACT=1): o interpretador observa o arquivo
    // principal e os attach locais (conteudo, entre chamadas), recompila o
    // programa no proprio processo e troca so as veins que mudaram pela
    // celula de despacho (_rf_cell, por no). Veins nativas (cristalizadas ou
    // com quartz) sao recompiladas num .so novo; ate ele ficar pronto, a
    // versao nova roda interpretada. Ver docs/COMPILER_ARCHITECTURE.md.
    forge RF_GLOBAL_SLOTS: stone = 64
    forge _rf_on: bool = false
    forge _rf_quiet: bool = false
    forge _rf_path: obsidian = ""
    forge _rf_files: Array<obsidian> = []
    forge _rf_sig: stone = 0
    forge _rf_seen: stone = 0
    forge _rf_busy: bool = false
    forge _rf_period: stone = 200
    forge _rf_next: stone = 0
    forge _rf_clock: stone = 0
    forge _rf_time: stone = 0
    forge _rf_tbuf: stone = 0
    forge _rf_fflush: stone = 0
    forge _rf_gen: stone = 0
    forge _rf_root: stone = -1
    forge _rf_cell: Array<stone> = []
    forge _rf_active: Array<stone> = []
    forge _rf_mono_live: Array<stone> = []
    forge _rf_gslot: stone = 0
    forge _rf_gslot_end: stone = 0
    forge _rf_dirty: Array<obsidian> = []
    // lava: o rascunho que o editor grava sem salvar (rf_lava_init). Por
    // arquivo observado: ultimo hash visto do disco e da lava e quem mudou
    // por ultimo (true = a lava vence). "" na raiz = lava desligada.
    forge _rf_lava_root: obsidian = ""
    forge _rf_lava_pulse: obsidian = ""
    forge _rf_lava_eco: obsidian = ""
    forge _rf_lp: Array<obsidian> = []
    forge _rf_dh: Array<stone> = []
    forge _rf_lh: Array<stone> = []
    forge _rf_lw: Array<bool> = []
    forge _rf_lava_live: bool = false
    // erro com fonte da lava (digitacao incompleta): guardado e mostrado so
    // se o conteudo ficar parado com erro por RF_LAVA_QUIET_MS, uma vez
    forge RF_LAVA_QUIET_MS: stone = 1000
    forge _rf_err_wait: bool = false
    forge _rf_err_sig: stone = 0
    forge _rf_err_at: stone = 0
    forge _rf_err_text: obsidian = ""
    forge _rf_err_shown: obsidian = ""
    // programa em execucao: veins (chave = nome com namespace/monolith),
    // globais, monoliths e externs, com a forma usada na comparacao
    forge _rf_vkey: Array<obsidian> = []
    forge _rf_vfid: Array<stone> = []
    forge _rf_vhash: Array<stone> = []
    forge _rf_vsig: Array<obsidian> = []
    forge _rf_vgone: Array<bool> = []
    forge _rf_gkey: Array<obsidian> = []
    forge _rf_gtype: Array<obsidian> = []
    forge _rf_mkey: Array<obsidian> = []
    forge _rf_mshape: Array<obsidian> = []
    forge _rf_ekey: Array<obsidian> = []
    forge _rf_eshape: Array<obsidian> = []
    // varredura de um programa (atual ou novo): preenchida por rf_scan
    forge _rs_vkey: Array<obsidian> = []
    forge _rs_vfid: Array<stone> = []
    forge _rs_vregs: Array<Array> = []
    forge _rs_gkey: Array<obsidian> = []
    forge _rs_gnode: Array<stone> = []
    forge _rs_mkey: Array<obsidian> = []
    forge _rs_mnode: Array<stone> = []
    forge _rs_ekey: Array<obsidian> = []
    forge _rs_enode: Array<stone> = []
    forge _rs_eregs: Array<Array> = []

    vein hy_has_quartz(id: stone) -> bool {
        if (id < 0) { return false }
        if (nk(id) == NK_QUARTZ) { return true }
        if (hy_has_quartz(nc0(id)) || hy_has_quartz(nc1(id)) || hy_has_quartz(nc2(id)) || hy_has_quartz(nc3(id))) { return true }
        forge i = 0
        forge n = nx_len(id)
        while (i < n) {
            if (hy_has_quartz(nx_at(id, i))) { return true }
            i++
        }
        return false
    }

    vein hy_root_index(fid: stone) -> stone {
        forge i = 0
        while (i < ofs_array_len(_hy_fid)) {
            forge f: stone = ofs_array_get(_hy_fid, i)
            if (f == fid) { return i }
            i++
        }
        return -1
    }

    vein hy_fail(msg: obsidian) -> void {
        if (_hy_soft) {
            _hy_soft_err = true
            ffi_stderr("ofs refract: " + msg + "\n")
            return
        }
        ffi_stderr("ofs run: " + msg + "\n")
        exit(1)
    }

    // texto entre aspas simples para o sh
    vein hy_q(s: obsidian) -> obsidian {
        forge out = "'"
        forge i = 0
        forge n = ofs_str_len(s)
        while (i < n) {
            if (ofs_str_char_at(s, i) == 39) { out = out + "'\\''" }
            else { out = out + ofs_str_substr(s, i, 1) }
            i++
        }
        return out + "'"
    }

    vein hy_hex(v: stone) -> obsidian {
        forge digits = "0123456789abcdef"
        forge out = ""
        forge i = 15
        while (i >= 0) {
            forge nib = (v >> (4 * i)) & 15
            out = out + ofs_str_substr(digits, nib, 1)
            i--
        }
        return out
    }

    // FNV-1a de 64 bits (base = semente)
    vein hy_fnv(s: obsidian, basis: stone) -> stone {
        forge h = basis
        forge i = 0
        forge n = ofs_str_len(s)
        while (i < n) {
            h = h ^ (ofs_str_char_at(s, i) & 255)
            h = h * 1099511628211
            i++
        }
        return h
    }

    vein hy_env_or(name: obsidian, dflt: obsidian) -> obsidian {
        forge v: obsidian = getenv(name)
        if (v == null || ofs_str_len(v) == 0) { return dflt }
        return v
    }

    vein hy_cache_dir() -> obsidian {
        forge d: obsidian = getenv("OFS_QUARTZ_CACHE")
        if (d != null && ofs_str_len(d) > 0) { return d }
        forge x: obsidian = getenv("XDG_CACHE_HOME")
        if (x != null && ofs_str_len(x) > 0) { return x + "/ofs/quartz" }
        return hy_env_or("HOME", "/tmp") + "/.cache/ofs/quartz"
    }

    vein hy_file_exists(path: obsidian) -> bool {
        forge f = fopen(path, "rb")
        if (f == null) { return false }
        fclose(f)
        return true
    }

    // mensagem do dlerror (procurado por dlsym: o ofscc do Windows nao tem)
    vein hy_dlerror() -> obsidian {
        abyss {
            forge de = dlsym(ffi_rtld_default(), "dlerror")
            if (de == 0) { return "" }
            forge m = fault_call(de)
            if (m == 0) { return "" }
            return m as obsidian
        }
    }

    // classe FFI de um tipo de parametro/retorno de vein OFS (strata = i64)
    vein hy_type_class(t: obsidian) -> stone {
        if (is_strata_type(t)) { return TC_INT }
        return ffi_type_class(t)
    }

    // A ponte passa escalares/ponteiros/agregados por endereco e f32/f64 em
    // registrador float (ate quatro parametros quando ha ponto flutuante).
    vein cr_supported(fid: stone) -> bool {
        if (ast_line_is_runtime(node_line_of(fid))) { return false }
        forge params = nc0(fid)
        forge np = nx_len(params)
        forge mask = 0
        forge j = 0
        while (j < np) {
            forge pid = nx_at(params, j)
            forge pt = "stone"
            if (nc0(pid) >= 0) { pt = type_node_str(nc0(pid)) }
            forge c = hy_type_class(pt)
            if (c == TC_F64 || c == TC_F32) { mask = mask | (1 << j) }
            j++
        }
        forge rt = "void"
        if (nc1(fid) >= 0) { rt = type_node_str(nc1(fid)) }
        forge rc = hy_type_class(rt)
        forge retf = 0
        if (rc == TC_F64 || rc == TC_F32) { retf = 1 }
        if (!llvmgen.ffi_sig_supported(np, mask, retf, 0)) { return false }
        // geode: um fechamento do interpretador nao vira codigo nativo; a
        // vein que mexe com valores de vein (ou chama quem mexe) fica
        // interpretada quando o programa tem geode
        cr_scan_geodes()
        if (_cr_geodes && cr_vein_reach(fid)) { return false }
        // arena do bedrock no nativo precisa do runtime de arena no processo
        if (cr_has_arena(nc2(fid))) {
            ar_resolve()
            if (_ar_open_fn == 0) { return false }
        }
        return true
    }

    forge _cr_geodes: bool = false
    forge _cr_gscan: stone = 0

    vein cr_scan_geodes() -> void {
        while (_cr_gscan < _n_count) {
            if (nk(_cr_gscan) == NK_LAMBDA) { _cr_geodes = true }
            _cr_gscan++
        }
    }

    vein cr_has_arena(id: stone) -> bool {
        if (id < 0) { return false }
        if (nk(id) == NK_BLOCK && ofs_str_eq(ntype(id), "arena")) { return true }
        if (cr_has_arena(nc0(id)) || cr_has_arena(nc1(id)) || cr_has_arena(nc2(id)) || cr_has_arena(nc3(id))) { return true }
        forge i = 0
        while (i < nx_len(id)) {
            if (cr_has_arena(nx_at(id, i))) { return true }
            i++
        }
        return false
    }

    // a subarvore cria geode ou tem valor/tipo de vein?
    vein cr_touches_vein(id: stone) -> bool {
        if (id < 0) { return false }
        forge k = nk(id)
        if (k == NK_LAMBDA || k == NK_TYPE_FN) { return true }
        if (vein_type_is(ntype(id))) { return true }
        if (cr_touches_vein(nc0(id)) || cr_touches_vein(nc1(id)) || cr_touches_vein(nc2(id)) || cr_touches_vein(nc3(id))) { return true }
        forge i = 0
        while (i < nx_len(id)) {
            if (cr_touches_vein(nx_at(id, i))) { return true }
            i++
        }
        return false
    }

    // fid ou alguma vein que ela chama (fechamento) mexe com valor de vein?
    vein cr_vein_reach(fid: stone) -> bool {
        forge todo: Array<stone> = []
        forge seen: Array<stone> = []
        ofs_array_push(todo, fid)
        while (ofs_array_len(todo) > 0) {
            forge f: stone = ofs_array_pop(todo)
            if (f >= 0 && !rf_has_id(seen, f)) {
                ofs_array_push(seen, f)
                if (cr_touches_vein(nc0(f)) || cr_touches_vein(nc1(f)) || cr_touches_vein(nc2(f))) { return true }
                forge callees: Array<stone> = []
                rf_walk_calls(nc2(f), callees)
                forge i = 0
                while (i < ofs_array_len(callees)) {
                    ofs_array_push(todo, ofs_array_get(callees, i))
                    i++
                }
            }
        }
        return false
    }

    vein hy_prepare(root_id: stone) -> void {
        _cr_root = root_id
        _cr_enabled = !ofs_str_eq(hy_env_or("OFS_CRYSTALLIZE", "1"), "0")
        // ofs fossil: tudo interpretado (o nativo nao passa pelo gancho das
        // chamadas externas nem conta passos); cristalizacao e OSR desligadas
        if (_fs_mode != 0) { _cr_enabled = false }
        forge lim = hy_env_or("OFS_CRYSTALLIZE_THRESHOLD", "1000")
        forge parsed = 0
        forge li = 0
        while (li < ofs_str_len(lim)) {
            forge c = ofs_str_char_at(lim, li)
            if (c < 48 || c > 57 || parsed > 100000000) { hy_fail("OFS_CRYSTALLIZE_THRESHOLD precisa ser inteiro positivo (1..1000000000)") }
            parsed = parsed * 10 + c - 48
            li++
        }
        if (parsed < 1 || parsed > 1000000000) { hy_fail("OFS_CRYSTALLIZE_THRESHOLD precisa ser inteiro positivo (1..1000000000)") }
        _cr_threshold = parsed
        forge i = 0
        while (i < _n_count) {
            ofs_array_push(_cr_heat, 0)
            ofs_array_push(_cr_eligible, false)
            ofs_array_push(_cr_quartz, false)
            // A F2 ainda nao tem trampolins de callback com registradores
            // float. Esses programas continuam interpretados, evitando que
            // uma aceleracao opcional introduza erro em codigo antes valido.
            forge ft = ntype(i)
            if (nk(i) == NK_TYPE_FN) { ft = nval(i) }
            if (_cr_enabled && vein_type_is(ft) && (ofs_str_contains(ft, "crystal") || ofs_str_contains(ft, "f64") || ofs_str_contains(ft, "f32")) && !cb_float_ready()) {
                cr_abandon("callback de ponto flutuante sem trampolim neste ofscc; continuando interpretado")
            }
            i++
        }
        _osr_native = _cr_enabled && !ofs_str_eq(hy_env_or("OFS_OSR", "1"), "0")
        _osr_on = _osr_native || _rf_on
        osr_extend()
        forge required = false
        forge fi = 0
        while (fi < ofs_array_len(_func_node_ids)) {
            forge fid: stone = ofs_array_get(_func_node_ids, fi)
            forge dup = false
            forge di = 0
            while (di < ofs_array_len(_cr_fids)) {
                forge df: stone = ofs_array_get(_cr_fids, di)
                if (df == fid) { dup = true }
                di++
            }
            forge needs_quartz = hy_has_quartz(nc2(fid))
            forge supported = cr_supported(fid)
            ofs_array_set(_cr_eligible, fid, supported)
            ofs_array_set(_cr_quartz, fid, needs_quartz)
            if (needs_quartz) { required = true }
            if (!dup && (needs_quartz || (_cr_enabled && supported))) {
                ofs_array_push(_cr_fids, fid)
                ofs_array_push(_cr_names, nval(fid))
            }
            fi++
        }
        if (required) {
            hy_compile(root_id, _cr_names, _cr_fids, false)
            _cr_all_loaded = true
        }
    }

    // mkdtemp nao existe no CRT do Windows. Resolucao tardia preserva o
    // self-host em Windows sem forcar essa dependencia no linker.
    abyss vein hy_mkdtemp(template: obsidian) -> obsidian {
        forge mk = dlsym(ffi_rtld_default(), "mkdtemp")
        if (mk == 0) { return null }
        return fault_call(mk, template as stone) as obsidian
    }

    vein hy_compile(root_id: stone, names: Array<obsidian>, fids: Array<stone>, background: bool) -> void {
        ffi_init()
        if (!_ffi_exports) {
            hy_fail("este programa usa quartz (assembly inline), que roda nativo, mas este ofscc nao exporta o runtime (ligue-o com -rdynamic); use `ofs build`")
            return
        }
        // 1. IR do fechamento (num temporario; o nome final e o hash)
        // mkdtemp cria o diretorio 0700 de forma atomica; nunca segue um
        // nome previsivel em /tmp ao escrever IR/logs/biblioteca temporaria.
        forge temp = hy_mkdtemp(hy_env_or("TMPDIR", "/tmp") + "/ofs-quartz-XXXXXX")
        if (temp == null) {
            if (background) { cr_abandon("criacao segura de temporario indisponivel nesta plataforma"); return }
            hy_fail("nao foi possivel criar temporario seguro para quartz nesta plataforma; use `ofs build`")
            return
        }
        _hy_temp = temp
        forge ll = temp + "/module.ll"
        forge probe = fopen(ll, "w")
        if (probe == null) { hy_fail("nao foi possivel criar " + ll + " (execucao hibrida do quartz)"); return }
        fclose(probe)
        // lacos com OSR pedidos para este modulo (osr_tick)
        forge loops = _osr_req
        _osr_req = []
        llvmgen.hy_osr_reset(_rf_on)
        forge li2 = 0
        while (li2 < ofs_array_len(loops)) {
            forge lp: stone = ofs_array_get(loops, li2)
            forge linfo: stone = ofs_array_get(_osr_info, lp)
            forge ld: Array<stone> = ofs_array_get(_osr_ldecls, linfo)
            llvmgen.hy_osr_add(lp, ofs_array_get(_osr_lfid, linfo), ld)
            li2++
        }
        cg_open(ll)
        llvmgen.set_target("")
        llvmgen.hy_generate(root_id, names)
        cg_close()
        forge ir = read_file(ll)
        // 2. cache por hash do IR + comando de compilacao
        forge cc = hy_env_or("OFS_QUARTZ_CC", "clang")
        forge flags = "-shared -fPIC -O2 -Wno-override-module"
        if (_ffi_macos) { flags = flags + " -undefined dynamic_lookup" }
        else { flags = flags + " -Wl,-Bsymbolic" }
        forge identity = temp + "/identity"
        system("( " + hy_q(cc) + " --version; uname -sm ) > " + hy_q(identity) + " 2>/dev/null")
        forge keytxt = ir + "\n" + cc + " " + flags + "\n" + read_file(identity)
        remove(identity)
        forge key = hy_hex(hy_fnv(keytxt, -3750763034362895579)) + hy_hex(hy_fnv(keytxt, 1469598103934665603))
        forge cache = hy_cache_dir()
        forge so = cache + "/" + key + ".so"
        forge how = "cache"
        if (!hy_file_exists(so)) {
            how = "compilado"
            if ((system("command -v " + hy_q(cc) + " >/dev/null 2>&1") & 4294967295) != 0) {
                remove(ll)
                rmdir(temp)
                if (background) { cr_abandon("clang nao encontrado; cristalizacao desativada"); return }
                hy_fail("este programa usa quartz e precisa do clang; instale o clang ou use `ofs build`")
                return
            }
            forge tmp_so = temp + "/module.so"
            forge ready = temp + "/ready"
            forge log = temp + "/clang.log"
            // Um cache com miss nunca le uma biblioteca parcialmente escrita:
            // o compilador publica a copia no proprio filesystem do cache e
            // o rename atomico vem antes do marcador de conclusao.
            forge stage = so + "." + hy_hex(hy_fnv(temp, 1469598103934665603))
            forge cmd = "L=$(ulimit -v); if [ \"$L\" = unlimited ] || [ \"$L\" -gt 3000000 ]; then ulimit -v 3000000; fi; mkdir -p -m 700 " + hy_q(cache) + " && O=; if " + hy_q(cc) + " --version 2>/dev/null | grep -Eq 'version 14[.]|clang-1400[.]'; then O='-mllvm -opaque-pointers'; fi; " +
                "timeout 120 " + hy_q(cc) + " $O " + flags + " " + hy_q(ll) + " -o " + hy_q(tmp_so) + " && cp " + hy_q(tmp_so) + " " + hy_q(stage) + " && mv -f " + hy_q(stage) + " " + hy_q(so)
            if (background) {
                _cr_pending = true
                _cr_so = so
                _cr_dir = temp
                _cr_ready = ready
                _cr_log = log
                _cr_jnames = names
                _cr_jfids = fids
                _cr_jloops = loops
                _cr_jgen = _rf_gen
                // O shell escreve o status por ultimo; o interpretador so
                // carrega depois desse marcador. O limite de memoria herdado
                // nunca e aumentado (importante para interp_memory).
                forge cleanup = "rm -f " + hy_q(ll) + " " + hy_q(tmp_so) + " " + hy_q(log) + " " + hy_q(ready) + " " + hy_q(ready + ".tmp") + " " + hy_q(temp + "/abandoned") + "; rmdir " + hy_q(temp)
                forge launch = "( ( " + cmd + " ) > " + hy_q(log) + " 2>&1; printf '%s' $? > " + hy_q(ready + ".tmp") + "; mv " + hy_q(ready + ".tmp") + " " + hy_q(ready) + "; if [ -f " + hy_q(temp + "/abandoned") + " ] || ! kill -0 " + ofs_stone_to_obsidian(getpid()) + " 2>/dev/null; then " + cleanup + "; fi ) </dev/null >/dev/null 2>&1 &"
                if ((system(launch) & 4294967295) != 0) { cr_abandon("nao foi possivel iniciar clang em segundo plano") }
                return
            }
            if ((system(cmd) & 4294967295) != 0) {
                remove(ll)
                rmdir(temp)
                hy_fail("o clang nao compilou as veins com quartz (erro acima)")
                return
            }
        }
        remove(ll)
        remove(temp + "/module.so")
        rmdir(temp)
        _hy_load_loops = loops
        hy_load(so, how, names, fids)
        _hy_load_loops = []
    }

    vein hy_load(so: obsidian, how: obsidian, names: Array<obsidian>, fids: Array<stone>) -> void {
        // 3. carrega (RTLD_NOW | RTLD_LOCAL) e resolve raizes e globais
        forge dlf = 2
        if (_ffi_macos) { dlf = 6 }
        forge h = dlopen(so, dlf)
        if (h == 0) {
            forge err = hy_dlerror()
            remove(so)
            if ((_cr_hot || _rf_on) && !_hy_soft) { cr_abandon("cache nativo invalido (removido): " + err); return }
            hy_fail("nao foi possivel carregar " + so + " (cache removido; execute novamente): " + err)
            return
        }
        // cada .so e um modulo (copias proprias dos globais)
        forge mod = _hy_nmods
        _hy_nmods++
        forge vi = 0
        while (vi < llvmgen.hy_fn_count()) {
            forge vfid = llvmgen.hy_fn_node(vi)
            if (vfid >= 0) {
                forge vaddr = dlsym(h, llvmgen.hy_fn_name(vi))
                if (vaddr != 0) {
                    ofs_array_push(_hy_value_addr, vaddr)
                    ofs_array_push(_hy_value_fid, vfid)
                }
            }
            vi++
        }
        forge loaded = 0
        forge ri = 0
        while (ri < ofs_array_len(fids)) {
            forge rfid: stone = ofs_array_get(fids, ri)
            // Fault Refract: a raiz vale pela versao viva da vein
            if (_rf_on) { rfid = rf_live_fid(rfid) }
            forge rname: obsidian = ofs_array_get(names, ri)
            // so a refract tolera raiz ausente/sem ponte: a vein (que sumiu ou
            // mudou de assinatura) continua interpretada
            forge rq: bool = ofs_array_get(_cr_quartz, rfid)
            forge lenient = _rf_on && !rq
            forge ok = true
            forge addr = dlsym(h, rname)
            if (addr == 0) {
                if (lenient) { ok = false }
                else { hy_fail("vein nativa '" + rname + "' nao esta em " + so); return }
            }
            forge pcls: Array<stone> = []
            forge params = nc0(rfid)
            forge np = nx_len(params)
            forge fmask = 0
            forge j = 0
            while (ok && j < np) {
                forge pid = nx_at(params, j)
                forge pt = ""
                if (nc0(pid) >= 0) { pt = type_node_str(nc0(pid)) }
                forge c = hy_type_class(pt)
                if (c == TC_F64 || c == TC_F32) { fmask = fmask | (1 << j) }
                ofs_array_push(pcls, c)
                j++
            }
            forge rt = "void"
            if (nc1(rfid) >= 0) { rt = type_node_str(nc1(rfid)) }
            forge rc = hy_type_class(rt)
            forge retf = 0
            if (rc == TC_F64 || rc == TC_F32) { retf = 1 }
            if (ok && (!llvmgen.ffi_sig_supported(np, fmask, retf, 0) || (_ffi_disp == 0 && (fmask != 0 || retf != 0)))) {
                if (lenient) { ok = false }
                else { hy_fail("vein '" + rname + "' (com quartz): assinatura sem trampolim FFI (ate 12 parametros inteiros/ponteiro, ou ate 4 com crystal); divida a vein ou use `ofs build`"); return }
            }
            if (ok) {
                hy_set_root(rfid, addr, pcls, rc, rt, mod)
                loaded++
            }
            ri++
        }
        // globais: o .so tem so um ponteiro por global (@__ofsg.nome); ele
        // passa a apontar para a celula unica do global (hy_global_cell)
        forge gi = 0
        while (gi < llvmgen.hy_glob_count()) {
            forge gname = llvmgen.hy_glob_name(gi)
            forge gvar = dlsym(h, "__ofsg." + gname)
            forge gsym = sym_intern(gname)
            if (gvar != 0 && gsym >= 0) {
                forge cell = hy_global_cell(gsym, llvmgen.hy_glob_type(gi))
                mem_wr(gvar, MC_I64, cell)
            }
            gi++
        }
        // OSR: entradas dos lacos pedidos neste modulo
        forge oi = 0
        while (oi < ofs_array_len(_hy_load_loops)) {
            forge lp: stone = ofs_array_get(_hy_load_loops, oi)
            forge oaddr = dlsym(h, "__ofs_osr_" + ofs_stone_to_obsidian(lp))
            if (oaddr != 0) {
                osr_extend()
                ofs_array_set(_osr_addr, lp, oaddr)
            }
            oi++
        }
        _hy_on = true
        if (ofs_str_eq(hy_env_or("OFS_VERBOSE", ""), "1")) {
            forge feature = "quartz"
            if (_cr_hot) { feature = "cristalizacao" }
            if (_cr_jrefract) { feature = "refract" }
            if (ofs_array_len(_hy_load_loops) > 0) { feature = "osr (" + rf_plural(ofs_array_len(_hy_load_loops), "laco", "lacos") + ")" }
            ffi_stderr("ofs run: " + feature + ": " + ofs_stone_to_obsidian(loaded) + " vein(s) nativa(s) (" + how + "): " + so + "\n")
        }
    }

    // raiz nativa da vein fid: substitui a entrada existente (recristalizacao
    // da Fault Refract) ou acrescenta uma nova
    vein hy_set_root(fid: stone, addr: stone, pcls: Array<stone>, rc: stone, rt: obsidian, mod: stone) -> void {
        forge hi = hy_root_index(fid)
        if (hi >= 0) {
            ofs_array_set(_hy_addr, hi, addr)
            ofs_array_set(_hy_pcls, hi, pcls)
            ofs_array_set(_hy_rcls, hi, rc)
            ofs_array_set(_hy_rtype, hi, rt)
            ofs_array_set(_hy_fmod, hi, mod)
            return
        }
        ofs_array_push(_hy_fid, fid)
        ofs_array_push(_hy_addr, addr)
        ofs_array_push(_hy_pcls, pcls)
        ofs_array_push(_hy_rcls, rc)
        ofs_array_push(_hy_rtype, rt)
        ofs_array_push(_hy_fmod, mod)
    }

    vein cr_abandon(msg: obsidian) -> void {
        _cr_enabled = false
        _cr_pending = false
        _cr_done = true
        if (ofs_str_eq(hy_env_or("OFS_VERBOSE", ""), "1")) { ffi_stderr("ofs run: cristalizacao: " + msg + "\n") }
    }

    vein cr_cleanup() -> void {
        remove(_cr_dir + "/module.ll")
        remove(_cr_dir + "/module.so")
        remove(_cr_log)
        remove(_cr_ready)
        rmdir(_cr_dir)
    }

    // Nao espera pelo clang no fim de programas curtos. O worker remove
    // seu diretorio depois de publicar o cache; se terminou, limpamos aqui.
    vein cr_finish() -> void {
        if (!_cr_pending) { return }
        forge f = fopen(_cr_dir + "/abandoned", "w")
        if (f != null) { fclose(f) }
        if (hy_file_exists(_cr_ready)) {
            remove(_cr_dir + "/abandoned")
            cr_cleanup()
        }
    }

    // trabalho em segundo plano pronto? carrega (ou descarta, se a Fault
    // Refract trocou o programa depois do inicio da compilacao)
    vein cr_poll_job() -> void {
        if (!_cr_pending || _hy_depth > 0) { return }
        if (!hy_file_exists(_cr_ready)) { return }
        forge status = read_file(_cr_ready)
        forge refract_job = _cr_jrefract
        forge osr_job = _cr_josr
        _cr_josr = false
        if (!ofs_str_eq(status, "0")) {
            cr_cleanup()
            if (osr_job) {
                // o laco fica interpretado; o resto da cristalizacao segue
                _cr_pending = false
                osr_mark(_cr_jloops, 2)
                if (ofs_str_eq(hy_env_or("OFS_VERBOSE", ""), "1")) { ffi_stderr("ofs run: osr: o clang nao compilou o laco; ele segue interpretado\n") }
                return
            }
            if (refract_job) {
                _cr_pending = false
                rf_note("recristalizacao indisponivel (clang falhou); as veins seguem interpretadas")
                return
            }
            cr_abandon("compilacao nativa indisponivel; continuando interpretado")
            return
        }
        if (_rf_on && _cr_jgen != _rf_gen) {
            // compilado de uma versao anterior do programa: descarta e
            // recompila as mesmas raizes com o programa atual
            _cr_pending = false
            cr_cleanup()
            if (osr_job) {
                osr_mark(_cr_jloops, 0)
                rf_launch()
                return
            }
            rf_mark_dirty(_cr_jnames)
            if (!refract_job) { _cr_done = true }
            rf_launch()
            return
        }
        _hy_load_loops = _cr_jloops
        hy_load(_cr_so, "segundo plano", _cr_jnames, _cr_jfids)
        _hy_load_loops = []
        _cr_pending = false
        if (!refract_job && !osr_job) { _cr_done = true }
        cr_cleanup()
        if (refract_job) { rf_note_list("cristalizada(s) de novo (.so novo)", _cr_jnames) }
    }

    vein cr_tick(fid: stone) -> void {
        if (!_cr_enabled || _cr_done || _hy_depth > 0 || !_cr_started) { return }
        if (_cr_pending) {
            cr_poll_job()
            return
        }
        forge supported: bool = ofs_array_get(_cr_eligible, fid)
        if (!supported) { return }
        forge heat: stone = ofs_array_get(_cr_heat, fid)
        heat++
        ofs_array_set(_cr_heat, fid, heat)
        if (heat < _cr_threshold) { return }
        _cr_hot = true
        // quartz ja exige o mesmo modulo no inicio (com todos os candidatos);
        // so ativamos as celulas dos outros candidatos.
        if (_cr_all_loaded) { _cr_done = true; return }
        ffi_init()
        if (!_ffi_exports) { cr_abandon("runtime sem -rdynamic; continuando interpretado"); return }
        _cr_jrefract = false
        _cr_josr = false
        hy_compile(_cr_root, _cr_names, _cr_fids, true)
        if (!_cr_pending && _hy_on) { _cr_done = true }
    }

    // indice no ambiente do global g (-1 = ainda nao iniciado)
    vein hy_gidx(g: stone) -> stone {
        forge c: stone = ofs_array_get(_hy_gidx, g)
        if (c >= 0) { return c }
        forge sym: stone = ofs_array_get(_hy_gsym, g)
        forge lim = _globals_count
        if (lim <= 0) { lim = ofs_array_len(_env_sym) }
        forge i = 0
        while (i < lim) {
            forge es: stone = ofs_array_get(_env_sym, i)
            if (es == sym) {
                if (_globals_count > 0) { ofs_array_set(_hy_gidx, g, i) }
                return i
            }
            i++
        }
        return -1
    }

    // Globais compartilhados (onda 4): cada global usado por codigo nativo
    // tem UMA celula de 8 bytes; todo .so aponta para ela (@__ofsg.nome) e o
    // interpretador guarda o global nela (VAL_BOXED, como `&x`), entao nao ha
    // copia na fronteira. Ficam com copia (modo 1) so Array (o interpretador
    // tem handle proprio), valor de vein e global ainda nao iniciado.
    forge _hy_gmode: Array<stone> = []

    vein hy_global_index(sym: stone) -> stone {
        forge g = 0
        while (g < ofs_array_len(_hy_gsym)) {
            forge s: stone = ofs_array_get(_hy_gsym, g)
            if (s == sym) { return g }
            g++
        }
        return -1
    }

    vein hy_global_cell(sym: stone, gt: obsidian) -> stone {
        forge g = hy_global_index(sym)
        if (g >= 0) {
            hy_box_global(g)
            forge a0: stone = ofs_array_get(_hy_gaddr, g)
            return a0
        }
        forge cell = ofs_alloc(8) as stone
        mem_wr(cell, MC_I64, 0)
        ofs_array_push(_hy_gsym, sym)
        ofs_array_push(_hy_gidx, -1)
        ofs_array_push(_hy_gaddr, cell)
        ofs_array_push(_hy_gtype, gt)
        ofs_array_push(_hy_gcls, mem_class(gt))
        ofs_array_push(_hy_garr, -1)
        ofs_array_push(_hy_gcol, 0)
        ofs_array_push(_hy_gptr, 0)
        ofs_array_push(_hy_gmode, 1)
        g = ofs_array_len(_hy_gsym) - 1
        hy_box_global(g)
        forge a: stone = ofs_array_get(_hy_gaddr, g)
        return a
    }

    // global g passa a morar na celula (se a classe permite e ele ja existe)
    vein hy_box_global(g: stone) -> void {
        forge mode: stone = ofs_array_get(_hy_gmode, g)
        if (mode == 0) { return }
        forge c: stone = ofs_array_get(_hy_gcls, g)
        if (c == MC_ARRAY || c == MC_FN) { return }
        forge idx = hy_gidx(g)
        if (idx < 0) { return }
        forge t: obsidian = ofs_array_get(_hy_gtype, g)
        forge k: stone = ofs_array_get(_env_kind, idx)
        if (k == VAL_BOXED) {
            // `&g` ja pos o global numa celula: ela vira a celula unica
            forge old: stone = ofs_array_get(_env_i, idx)
            ofs_array_set(_hy_gaddr, g, old)
            ofs_array_set(_hy_gmode, g, 0)
            return
        }
        forge cell: stone = ofs_array_get(_hy_gaddr, g)
        forge sk = _rk
        forge st: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        env_load(idx)
        mem_store(cell, c, t)
        r_set(sk, st, si, sf, sb, ss, sr)
        ofs_array_set(_env_kind, idx, VAL_BOXED)
        ofs_array_set(_env_type, idx, t)
        ofs_array_set(_env_i, idx, cell)
        ofs_array_set(_env_ref, idx, c)
        _boxed_live++
        ofs_array_set(_hy_gmode, g, 0)
    }

    // interpretador -> celulas dos globais com copia (modo 1)
    // (registradores mudam)
    vein hy_sync_in(mod: stone) -> void {
        forge g = 0
        while (g < ofs_array_len(_hy_gsym)) {
            forge gm: stone = ofs_array_get(_hy_gmode, g)
            if (gm != 0) {
                hy_box_global(g)
                gm = ofs_array_get(_hy_gmode, g)
            }
            forge idx = -1
            if (gm != 0) { idx = hy_gidx(g) }
            if (idx >= 0) {
                forge a: stone = ofs_array_get(_hy_gaddr, g)
                forge c: stone = ofs_array_get(_hy_gcls, g)
                forge t: obsidian = ofs_array_get(_hy_gtype, g)
                env_load(idx)
                if (c == MC_ARRAY) {
                    forge p = 0
                    ofs_array_set(_hy_garr, g, -1)
                    if (_rk == VAL_ARRAY) {
                        forge hh = _rr
                        p = arr_native_ptr(hh)
                        ofs_array_set(_hy_garr, g, hh)
                        ofs_array_set(_hy_gcol, g, _arr_last_col)
                    }
                    ofs_array_set(_hy_gptr, g, p)
                    mem_wr(a, MC_I64, p)
                } else if (c == MC_FN) {
                    mem_wr(a, MC_I64, fn_native_addr())
                } else {
                    mem_store(a, c, t)
                }
            }
            g++
        }
    }

    // celulas dos globais com copia (modo 1) -> interpretador (registradores
    // mudam)
    vein hy_sync_out(mod: stone) -> void {
        forge g = 0
        while (g < ofs_array_len(_hy_gsym)) {
            forge gm: stone = ofs_array_get(_hy_gmode, g)
            forge idx = -1
            if (gm != 0) { idx = hy_gidx(g) }
            if (idx >= 0) {
                forge a: stone = ofs_array_get(_hy_gaddr, g)
                forge c: stone = ofs_array_get(_hy_gcls, g)
                forge t: obsidian = ofs_array_get(_hy_gtype, g)
                if (c == MC_ARRAY) {
                    forge p = mem_rd(a, MC_I64)
                    forge oh: stone = ofs_array_get(_hy_garr, g)
                    forge op: stone = ofs_array_get(_hy_gptr, g)
                    if (oh >= 0 && p == op) {
                        forge ocol: stone = ofs_array_get(_hy_gcol, g)
                        arr_sync(oh, ocol)
                    } else if (p != op) {
                        regs_from_raw(p, MC_ARRAY, t)
                        env_store(idx)
                    }
                } else {
                    mem_load(a, c, t)
                    env_store(idx)
                }
            }
            g++
        }
    }

    // chamada interpretado -> vein nativa hi; resultado nos registradores
    vein hy_call(hi: stone, num_args: stone, arg_base: stone) -> void {
        forge addr: stone = ofs_array_get(_hy_addr, hi)
        forge pcls: Array<stone> = ofs_array_get(_hy_pcls, hi)
        forge rcls: stone = ofs_array_get(_hy_rcls, hi)
        forge rtype: obsidian = ofs_array_get(_hy_rtype, hi)
        forge fid: stone = ofs_array_get(_hy_fid, hi)
        forge mod: stone = ofs_array_get(_hy_fmod, hi)
        forge saved_mod = _hy_mod
        // os argumentos ja estao na pilha (_arg_*); a sincronia so mexe nos
        // registradores
        _hy_mod = mod
        hy_sync_in(mod)
        _hy_depth++
        ffi_call_addr(addr, pcls, 0, rcls, rtype, "vein nativa '" + nval(fid) + "'", num_args, arg_base)
        _hy_depth--
        forge sk = _rk
        forge st: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        hy_sync_out(mod)
        _hy_mod = saved_mod
        r_set(sk, st, si, sf, sb, ss, sr)
        if (is_strata_type(rtype) && _rk == VAL_INT) { regs_from_raw(_ri, MC_VARIANT, rtype) }
    }

    // ── OSR (onda 4): troca no meio de um laco ────────────────────────────
    // Um `while` em execucao muda de versao sem esperar a proxima chamada:
    //   * nativo (cristalizacao): exec_while conta as voltas; a cada 1024
    //     (osr_tick) um laco elegivel com OFS_CRYSTALLIZE_THRESHOLD voltas pede
    //     ao llvmgen uma funcao `__ofs_osr_<no>` (o laco extraido; as
    //     variaveis vivas vao num bloco de 8 bytes por variavel), compilada em
    //     segundo plano num modulo proprio (os globais sao as celulas
    //     compartilhadas, entao dois .so nunca divergem). Pronta, o laco
    //     transfere o estado (osr_enter), roda nativo do cabecalho em diante e
    //     devolve as variaveis; o interpretador segue depois do laco.
    //   * Fault Refract: a edicao aplicada vale no proximo cabecalho do laco
    //     da vein editada (rf_osr_target/rf_osr_switch): o laco da versao nova
    //     continua com as mesmas variaveis e o resto da vein tambem e o novo.
    //     Um laco nativo (OSR) consulta o gancho __ofs_osr_poll a cada 65536
    //     voltas e volta ao interpretador pelo cabecalho quando ha edicao.
    // OFS_OSR=0 desliga a OSR nativa (a troca da Refract continua).
    forge _osr_on: bool = false
    forge _osr_native: bool = false
    forge _osr_hold: bool = false
    forge _osr_poll_fn: stone = 0
    forge _osr_poll_next: stone = 0
    forge _osr_addr: Array<stone> = []
    forge _osr_state: Array<stone> = []
    forge _osr_heat: Array<stone> = []
    forge _osr_info: Array<stone> = []
    forge _osr_ldecls: Array<Array> = []
    forge _osr_lfid: Array<stone> = []
    forge _osr_req: Array<stone> = []
    forge _cr_jloops: Array<stone> = []
    forge _cr_josr: bool = false
    forge _hy_load_loops: Array<stone> = []
    forge _cr_all_loaded: bool = false

    vein osr_extend() -> void {
        while (ofs_array_len(_osr_addr) < _n_count) {
            ofs_array_push(_osr_addr, 0)
            ofs_array_push(_osr_state, 0)
            ofs_array_push(_osr_heat, 0)
            ofs_array_push(_osr_info, -1)
        }
    }

    // o corpo do laco cabe numa funcao nativa que so sai pelo fim/break?
    vein osr_body_ok(id: stone) -> bool {
        if (id < 0) { return true }
        forge k = nk(id)
        if (k == NK_RETURN || k == NK_THROW || k == NK_TREMOR || k == NK_ANCHOR || k == NK_LAMBDA || k == NK_TYPE_FN || k == NK_QUARTZ) { return false }
        if (k == NK_POST_OP && ofs_str_eq(nval(id), "?")) { return false }
        if (k == NK_UNARY_OP && ofs_str_eq(nval(id), "&")) { return false }
        if (k == NK_BLOCK && ofs_str_eq(ntype(id), "arena")) { return false }
        if (vein_type_is(ntype(id))) { return false }
        if (!osr_body_ok(nc0(id)) || !osr_body_ok(nc1(id)) || !osr_body_ok(nc2(id)) || !osr_body_ok(nc3(id))) { return false }
        forge i = 0
        while (i < nx_len(id)) {
            if (!osr_body_ok(nx_at(id, i))) { return false }
            i++
        }
        return true
    }

    // veins alcancadas pelo laco: sem geode/valor de vein (se o programa tem
    // geode) e com o runtime de arena quando usam bedrock
    vein osr_reach_ok(loop: stone) -> bool {
        cr_scan_geodes()
        forge todo: Array<stone> = []
        forge seen: Array<stone> = []
        rf_walk_calls(loop, todo)
        while (ofs_array_len(todo) > 0) {
            forge f: stone = ofs_array_pop(todo)
            if (f >= 0 && !rf_has_id(seen, f)) {
                ofs_array_push(seen, f)
                if (!ast_line_is_runtime(node_line_of(f))) {
                    if (_cr_geodes && (cr_touches_vein(nc0(f)) || cr_touches_vein(nc1(f)) || cr_touches_vein(nc2(f)))) { return false }
                    if (cr_has_arena(nc2(f))) {
                        ar_resolve()
                        if (_ar_open_fn == 0) { return false }
                    }
                    rf_walk_calls(nc2(f), todo)
                }
            }
        }
        return true
    }

    // caminho (nos) de root ate target, inclusive
    vein osr_path(root: stone, target: stone, out: Array<stone>) -> bool {
        if (root < 0) { return false }
        ofs_array_push(out, root)
        if (root == target) { return true }
        if (osr_path(nc0(root), target, out) || osr_path(nc1(root), target, out) || osr_path(nc2(root), target, out) || osr_path(nc3(root), target, out)) { return true }
        forge i = 0
        while (i < nx_len(root)) {
            if (osr_path(nx_at(root, i), target, out)) { return true }
            i++
        }
        ofs_array_pop(out)
        return false
    }

    // declaracoes visiveis no cabecalho do laco (fim do caminho): parametros
    // e forge dos blocos antes do caminho; [-1] se o caminho passa por algo
    // que a OSR nao acompanha. only_simple: so bloco/while/if (troca da
    // Refract, que retoma o resto da vein pelo caminho)
    vein osr_scope_decls(fid: stone, path: Array<stone>, only_simple: bool) -> Array<stone> {
        forge out: Array<stone> = []
        forge bad: Array<stone> = []
        ofs_array_push(bad, -1)
        forge params = nc0(fid)
        forge pi = 0
        while (params >= 0 && pi < nx_len(params)) {
            ofs_array_push(out, nx_at(params, pi))
            pi++
        }
        forge k = 0
        while (k < ofs_array_len(path) - 1) {
            forge parent: stone = ofs_array_get(path, k)
            forge child: stone = ofs_array_get(path, k + 1)
            forge pk = nk(parent)
            if (pk == NK_BLOCK) {
                if (naux(parent) == 1 || ofs_str_eq(ntype(parent), "arena")) { return bad }
                forge si = 0
                while (si < nx_len(parent)) {
                    forge sid = nx_at(parent, si)
                    if (sid == child) { break }
                    if (nk(sid) == NK_VAR_DECL || nk(sid) == NK_CONST_DECL) { ofs_array_push(out, sid) }
                    si++
                }
            } else if (pk == NK_CYCLE_C && !only_simple) {
                forge ini = nc0(parent)
                if (ini >= 0 && ini != child && nk(ini) == NK_VAR_DECL) { ofs_array_push(out, ini) }
            } else if (pk != NK_WHILE && pk != NK_IF) {
                return bad
            } else if (pk == NK_WHILE && child != nc1(parent)) {
                return bad
            }
            k++
        }
        return out
    }

    vein osr_idents(id: stone, out: Array<obsidian>) -> void {
        if (id < 0) { return }
        if (nk(id) == NK_IDENT) {
            forge v: obsidian = nval(id)
            if (!rf_has_name(out, v)) { ofs_array_push(out, v) }
        }
        osr_idents(nc0(id), out)
        osr_idents(nc1(id), out)
        osr_idents(nc2(id), out)
        osr_idents(nc3(id), out)
        forge i = 0
        while (i < nx_len(id)) {
            osr_idents(nx_at(id, i), out)
            i++
        }
    }

    // variaveis vivas do laco: a declaracao mais interna de cada nome usado
    vein osr_live(decls: Array<stone>, loop: stone) -> Array<stone> {
        forge names: Array<obsidian> = []
        osr_idents(loop, names)
        forge chosen: Array<obsidian> = []
        forge live: Array<stone> = []
        forge i = ofs_array_len(decls) - 1
        while (i >= 0) {
            forge d: stone = ofs_array_get(decls, i)
            forge dn: obsidian = nval(d)
            if (rf_has_name(names, dn) && !rf_has_name(chosen, dn)) {
                ofs_array_push(chosen, dn)
                ofs_array_push(live, d)
            }
            i--
        }
        return live
    }

    vein osr_prepare(loop: stone, fid: stone) -> bool {
        if (fid < 0 || nk(loop) != NK_WHILE) { return false }
        if (nk(fid) != NK_FN_DECL && nk(fid) != NK_CORE_DECL) { return false }
        if (ast_line_is_runtime(node_line_of(fid))) { return false }
        if (!osr_body_ok(loop)) { return false }
        if (!osr_reach_ok(loop)) { return false }
        forge path: Array<stone> = []
        if (!osr_path(nc2(fid), loop, path)) { return false }
        forge decls = osr_scope_decls(fid, path, false)
        if (ofs_array_len(decls) == 1) {
            forge d0: stone = ofs_array_get(decls, 0)
            if (d0 < 0) { return false }
        }
        forge live = osr_live(decls, loop)
        forge i = 0
        while (i < ofs_array_len(live)) {
            forge t = llvmgen.osr_decl_type(ofs_array_get(live, i))
            if (mem_class(t) == MC_FN || vein_type_is(t)) { return false }
            i++
        }
        ofs_array_set(_osr_info, loop, ofs_array_len(_osr_ldecls))
        ofs_array_push(_osr_ldecls, live)
        ofs_array_push(_osr_lfid, fid)
        return true
    }

    vein osr_mark(loops: Array<stone>, state: stone) -> void {
        forge i = 0
        while (i < ofs_array_len(loops)) {
            forge lp: stone = ofs_array_get(loops, i)
            ofs_array_set(_osr_state, lp, state)
            if (state == 0) { ofs_array_set(_osr_heat, lp, 0) }
            i++
        }
    }

    // um laco atingiu o limiar: pede (ou usa) a versao nativa.
    // -1 = continua interpretado; 0 = o laco terminou nativo; 1 = o laco
    // nativo voltou pelo cabecalho (gancho da Refract)
    vein osr_tick(loop: stone) -> stone {
        if (!_osr_native || !_cr_enabled || !_cr_started || _hy_depth > 0 || _cur_fn_id < 0) { return -1 }
        osr_extend()
        forge a: stone = ofs_array_get(_osr_addr, loop)
        if (a == 0 && _cr_pending) {
            cr_poll_job()
            a = ofs_array_get(_osr_addr, loop)
        }
        if (a != 0) {
            if (_osr_hold) { return -1 }
            return osr_enter(loop, a)
        }
        if (_cr_pending) { return -1 }
        forge state: stone = ofs_array_get(_osr_state, loop)
        if (state == 0) {
            state = 2
            if (osr_prepare(loop, _cur_fn_id)) { state = 1 }
            ofs_array_set(_osr_state, loop, state)
        }
        if (state != 1) { return -1 }
        forge heat: stone = ofs_array_get(_osr_heat, loop)
        heat = heat + 1024
        ofs_array_set(_osr_heat, loop, heat)
        if (heat < _cr_threshold) { return -1 }
        ffi_init()
        if (!_ffi_exports) { _osr_native = false; return -1 }
        if (_rf_on) {
            if (_osr_poll_fn == 0) { _osr_poll_fn = dlsym(ffi_rtld_default(), "__ofs_osr_poll") }
            // sem o gancho, um laco nativo nao veria as edicoes
            if (_osr_poll_fn == 0) { _osr_native = false; return -1 }
        }
        ofs_array_set(_osr_state, loop, 3)
        _osr_req = []
        ofs_array_push(_osr_req, loop)
        _cr_jrefract = false
        _cr_josr = true
        forge none_n: Array<obsidian> = []
        forge none_f: Array<stone> = []
        hy_compile(_cr_root, none_n, none_f, true)
        if (!_cr_pending) { _cr_josr = false }
        a = ofs_array_get(_osr_addr, loop)
        if (a != 0 && !_osr_hold) { return osr_enter(loop, a) }
        return -1
    }

    // estado do interpretador -> funcao nativa do laco -> estado de volta
    vein osr_enter(loop: stone, addr: stone) -> stone {
        forge info: stone = ofs_array_get(_osr_info, loop)
        if (info < 0) { return -1 }
        forge decls: Array<stone> = ofs_array_get(_osr_ldecls, info)
        forge n = ofs_array_len(decls)
        forge idxs: Array<stone> = []
        forge cls: Array<stone> = []
        forge tys: Array<obsidian> = []
        forge ah: Array<stone> = []
        forge acol: Array<stone> = []
        forge ap: Array<stone> = []
        forge st = ofs_alloc(8 * (n + 1)) as stone
        forge poll = 0
        if (_rf_on) { poll = _osr_poll_fn }
        mem_wr(st, MC_I64, poll)
        forge sk = _rk
        forge stt: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        forge i = 0
        while (i < n) {
            forge did: stone = ofs_array_get(decls, i)
            forge t = llvmgen.osr_decl_type(did)
            forge c = mem_class(t)
            forge idx = find_var(node_sym(did))
            forge ok = idx >= _current_frame_base
            if (ok) {
                forge ek: stone = ofs_array_get(_env_kind, idx)
                if (ek == VAL_BOXED) { ok = false }
            }
            forge slot = st + 8 * (i + 1)
            forge h = -1
            forge col = 0
            forge p = 0
            if (ok) {
                env_load(idx)
                if (c == MC_ARRAY) {
                    if (_rk == VAL_ARRAY) {
                        h = _rr
                        p = arr_native_ptr(h)
                        col = _arr_last_col
                    } else if (_rk != VAL_NULL) { ok = false }
                    mem_wr(slot, MC_I64, p)
                } else if (c == MC_OBJ) {
                    if (_rk != VAL_OBJECT || _rr <= 0) { ok = false }
                    else { mem_wr(slot, MC_I64, _rr) }
                } else {
                    mem_wr(slot, MC_I64, 0)
                    mem_store(slot, c, t)
                }
            }
            if (!ok) {
                // estado que a funcao nativa nao representa (`&x` tomado,
                // variavel fora do quadro): este laco fica interpretado
                ofs_free(st as obsidian)
                ofs_array_set(_osr_addr, loop, 0)
                ofs_array_set(_osr_state, loop, 2)
                r_set(sk, stt, si, sf, sb, ss, sr)
                return -1
            }
            ofs_array_push(idxs, idx)
            ofs_array_push(cls, c)
            ofs_array_push(tys, t)
            ofs_array_push(ah, h)
            ofs_array_push(acol, col)
            ofs_array_push(ap, p)
            i++
        }
        hy_sync_in(0)
        _hy_depth++
        forge r = 0
        abyss { r = fault_call(addr, st) }
        _hy_depth--
        hy_sync_out(0)
        i = 0
        while (i < n) {
            forge idx2: stone = ofs_array_get(idxs, i)
            forge c2: stone = ofs_array_get(cls, i)
            forge t2: obsidian = ofs_array_get(tys, i)
            forge slot2 = st + 8 * (i + 1)
            if (c2 == MC_ARRAY) {
                forge p2 = mem_rd(slot2, MC_I64)
                forge oh: stone = ofs_array_get(ah, i)
                forge op: stone = ofs_array_get(ap, i)
                if (oh >= 0 && p2 == op) {
                    forge ocol: stone = ofs_array_get(acol, i)
                    arr_sync(oh, ocol)
                } else if (p2 != op) {
                    regs_from_raw(p2, MC_ARRAY, t2)
                    env_store(idx2)
                }
            } else if (c2 != MC_OBJ) {
                mem_load(slot2, c2, t2)
                env_store(idx2)
            }
            i++
        }
        ofs_free(st as obsidian)
        r_set(sk, stt, si, sf, sb, ss, sr)
        if (ofs_str_eq(hy_env_or("OFS_VERBOSE", ""), "1") && r == 0) {
            ffi_stderr("ofs run: osr: laco de '" + nval(_cur_fn_id) + "' terminou nativo\n")
        }
        return r
    }

    // gancho dos lacos nativos (Fault Refract): 1 = ha edicao salva, o laco
    // volta ao interpretador pelo cabecalho
    vein rf_osr_poll() -> stone {
        if (!_rf_on || _rf_busy) { return 0 }
        forge now = rf_now_ms()
        if (now < _osr_poll_next) { return 0 }
        _osr_poll_next = now + _rf_period
        rf_flush()
        if (rf_files_sig() != _rf_sig) {
            _osr_hold = true
            return 1
        }
        return 0
    }

    // k-esimo `while` (pre-ordem) de uma subarvore
    forge _rf_wcount: stone = 0

    vein rf_while_find(id: stone, target: stone) -> stone {
        if (id < 0) { return -1 }
        if (nk(id) == NK_WHILE) {
            if (id == target) { return _rf_wcount }
            _rf_wcount++
        }
        forge r = rf_while_find(nc0(id), target)
        if (r < 0) { r = rf_while_find(nc1(id), target) }
        if (r < 0) { r = rf_while_find(nc2(id), target) }
        if (r < 0) { r = rf_while_find(nc3(id), target) }
        forge i = 0
        while (r < 0 && i < nx_len(id)) {
            r = rf_while_find(nx_at(id, i), target)
            i++
        }
        return r
    }

    vein rf_while_at(id: stone, ord: stone) -> stone {
        if (id < 0) { return -1 }
        if (nk(id) == NK_WHILE) {
            if (_rf_wcount == ord) { return id }
            _rf_wcount++
        }
        forge r = rf_while_at(nc0(id), ord)
        if (r < 0) { r = rf_while_at(nc1(id), ord) }
        if (r < 0) { r = rf_while_at(nc2(id), ord) }
        if (r < 0) { r = rf_while_at(nc3(id), ord) }
        forge i = 0
        while (r < 0 && i < nx_len(id)) {
            r = rf_while_at(nx_at(id, i), ord)
            i++
        }
        return r
    }

    vein rf_decl_shape(decls: Array<stone>) -> Array<obsidian> {
        forge out: Array<obsidian> = []
        forge i = 0
        while (i < ofs_array_len(decls)) {
            forge d: stone = ofs_array_get(decls, i)
            forge e = nval(d) + ":" + llvmgen.osr_decl_type(d)
            if (!rf_has_name(out, e)) { ofs_array_push(out, e) }
            i++
        }
        return out
    }

    // o laco `loop` da vein em execucao mudou? devolve o laco correspondente
    // da versao viva (mesma posicao entre os `while`, mesmas variaveis vivas)
    vein rf_osr_target(loop: stone) -> stone {
        forge fid = _cur_fn_id
        if (fid < 0) { return -1 }
        forge nf = rf_live_fid(fid)
        if (nf == fid || nf < 0) { return -1 }
        forge who = vein_display_name(nval(fid))
        _rf_wcount = 0
        forge ord = rf_while_find(nc2(fid), loop)
        if (ord < 0) { return -1 }
        _rf_wcount = 0
        forge nl = rf_while_at(nc2(nf), ord)
        if (nl < 0) {
            rf_info("o laco de '" + who + "' sumiu na versao nova; ele termina na versao antiga")
            return -1
        }
        forge op: Array<stone> = []
        forge np: Array<stone> = []
        osr_path(nc2(fid), loop, op)
        osr_path(nc2(nf), nl, np)
        forge od = osr_scope_decls(fid, op, true)
        forge nd = osr_scope_decls(nf, np, true)
        forge bad = ofs_array_len(od) == 1 && ofs_array_get(od, 0) < 0
        if (ofs_array_len(nd) == 1 && ofs_array_get(nd, 0) < 0) { bad = true }
        if (bad) {
            rf_info("o laco de '" + who + "' esta dentro de cycle/match/bedrock; ele termina na versao antiga e a nova vale na proxima chamada")
            return -1
        }
        // variaveis antes do laco: mesma (nome, tipo) segue com o valor
        // vivo; nova ganha o valor inicial na hora da troca; removida some;
        // tipo diferente (ou parametro novo) recusa
        _rf_osr_add = []
        _rf_osr_hide = []
        forge why = ""
        forge i = 0
        while (i < ofs_array_len(nd)) {
            forge d: stone = ofs_array_get(nd, i)
            forge dn: obsidian = nval(d)
            forge dt = llvmgen.osr_decl_type(d)
            forge oi = rf_decl_find(od, dn)
            if (oi < 0) {
                if (nk(d) == NK_PARAM) { why = rf_reason(why, "parametro novo '" + dn + "'") }
                else { ofs_array_push(_rf_osr_add, d) }
            } else if (!ofs_str_eq(llvmgen.osr_decl_type(oi), dt)) {
                why = rf_reason(why, "'" + dn + "' mudou de tipo (de " + llvmgen.osr_decl_type(oi) + " para " + dt + ")")
            }
            i++
        }
        i = 0
        while (i < ofs_array_len(od)) {
            forge d2: stone = ofs_array_get(od, i)
            forge dn2: obsidian = nval(d2)
            if (rf_decl_find(nd, dn2) < 0 && !rf_has_name(_rf_osr_hide, dn2)) { ofs_array_push(_rf_osr_hide, dn2) }
            i++
        }
        if (ofs_str_len(why) > 0) {
            rf_info("o laco de '" + who + "' segue na versao antiga: " + why + "; a nova vale na proxima chamada")
            return -1
        }
        return nl
    }

    forge _rf_osr_add: Array<stone> = []
    forge _rf_osr_hide: Array<obsidian> = []

    // ultima declaracao com o nome (a mais interna)
    vein rf_decl_find(decls: Array<stone>, name: obsidian) -> stone {
        forge i = ofs_array_len(decls) - 1
        while (i >= 0) {
            forge d: stone = ofs_array_get(decls, i)
            if (ofs_str_eq(nval(d), name)) { return d }
            i--
        }
        return -1
    }

    vein rf_exec_after(block: stone, child: stone) -> stone {
        forge stmts: Array<stone> = nextra(block)
        forge n = ofs_array_len(stmts)
        forge i = 0
        while (i < n) {
            forge sid: stone = ofs_array_get(stmts, i)
            i++
            if (sid == child) { break }
        }
        while (i < n) {
            forge st = execute_stmt(ofs_array_get(stmts, i))
            if (st != EXEC_OK) { return st }
            if (_try_unwind) { return EXEC_RETURN }
            i++
        }
        return EXEC_OK
    }

    // continua no laco novo `nl` e no resto da versao nova da vein; o quadro
    // antigo (exec_while/blocos acima) so desempilha
    vein rf_osr_switch(loop: stone, nl: stone) -> stone {
        forge fid = _cur_fn_id
        forge nf = rf_live_fid(fid)
        forge path: Array<stone> = []
        osr_path(nc2(nf), nl, path)
        rf_info("laco de '" + vein_display_name(nval(fid)) + "' continua na versao nova (OSR)")
        rf_frame(fid, -1)
        rf_frame(nf, 1)
        _cur_fn_id = nf
        // variaveis removidas saem de vista; novas ganham o valor inicial
        forge hi = 0
        while (hi < ofs_array_len(_rf_osr_hide)) {
            forge hidx = find_var(sym_intern(ofs_array_get(_rf_osr_hide, hi)))
            if (hidx >= _current_frame_base) { ofs_array_set(_env_sym, hidx, -2) }
            hi++
        }
        forge added: Array<obsidian> = []
        forge ai = 0
        while (ai < ofs_array_len(_rf_osr_add)) {
            forge ad: stone = ofs_array_get(_rf_osr_add, ai)
            execute_stmt(ad)
            ofs_array_push(added, nval(ad))
            ai++
        }
        if (ofs_array_len(added) > 0) { rf_info("variavel(is) nova(s) antes do laco, com o valor inicial: " + rf_join(added)) }
        if (ofs_array_len(_rf_osr_hide) > 0) { rf_info("variavel(is) removida(s): " + rf_join(_rf_osr_hide)) }
        forge st = exec_while(nl)
        forge k = ofs_array_len(path) - 2
        while (k >= 0 && st != EXEC_RETURN && st != EXEC_THROW) {
            forge parent: stone = ofs_array_get(path, k)
            forge child: stone = ofs_array_get(path, k + 1)
            forge pk = nk(parent)
            if (pk == NK_BLOCK) {
                if (st == EXEC_OK) { st = rf_exec_after(parent, child) }
            } else if (pk == NK_WHILE) {
                if (st == EXEC_BREAK) { st = EXEC_OK }
                else { st = exec_while(parent) }
            }
            k--
        }
        if (st == EXEC_THROW) { return EXEC_THROW }
        if (st != EXEC_RETURN) {
            r_void()
            set_return_from_regs()
        }
        return EXEC_RETURN
    }

    // ── Callbacks C -> OFS (fault_addr de vein interpretada) ─────────────
    // Cada vein recebe um slot fixo da tabela de trampolins nativos
    // (llvmgen.emit_cb_trampolines, FFI_CB_SLOTS); o trampolim chama
    // __ofs_cb_enter(slot, a0..a5), que reentra no interpretador (inclusive
    // dentro de uma chamada C feita pelo proprio interpretador, como qsort).
    // Inteiros/ponteiros/obsidian/bool/monolith (por ponteiro); com crystal/
    // f32 o slot usa o trampolim __ofs_cbx_K (registradores float, onda 4).

    // o ofscc tem os trampolins com ponto flutuante (gerados pelo llvmgen
    // da onda 4; nao no Windows x64)?
    vein cb_float_ready() -> bool {
        if (!_cbx_checked) {
            _cbx_checked = true
            ffi_init()
            _cbx_table = dlsym(ffi_rtld_default(), "__ofs_cbx_table")
        }
        return _cbx_table != 0
    }

    vein cb_slot_for(fid: stone, name: obsidian) -> stone {
        abyss {
            ffi_init()
            if (_cb_table == 0) {
                _cb_table = dlsym(ffi_rtld_default(), "__ofs_cb_table")
                if (_cb_table == 0) {
                    fault_runtime_error("fault_addr(" + name + "): callback para o C precisa dos trampolins __ofs_cb_table (ofscc compilado por um ofscc com F2 e linkado com -rdynamic)")
                    return 0
                }
            }
            forge slot = 0
            forge n = ofs_array_len(_cb_fn)
            while (slot < n) {
                forge f: stone = ofs_array_get(_cb_fn, slot)
                if (f == fid) {
                    forge ca: stone = ofs_array_get(_cb_addr, slot)
                    return ca
                }
                slot++
            }
            if (n >= FFI_CB_SLOTS) {
                fault_runtime_error("fault_addr(" + name + "): trampolins de callback esgotados (" + ofs_stone_to_obsidian(FFI_CB_SLOTS) + " veins diferentes por execucao)")
                return 0
            }
            forge pcls: Array<stone> = []
            forge ptypes: Array<obsidian> = []
            forge params = nc0(fid)
            forge np = nx_len(params)
            forge nint = 0
            forge nflt = 0
            forge j = 0
            while (j < np) {
                forge pid = nx_at(params, j)
                forge pt = ""
                if (nc0(pid) >= 0) { pt = type_node_str(nc0(pid)) }
                forge c = mem_class(pt)
                if (c == MC_F64 || c == MC_F32) { nflt++ } else { nint++ }
                ofs_array_push(pcls, c)
                ofs_array_push(ptypes, pt)
                j++
            }
            forge rt = "void"
            if (nc1(fid) >= 0) { rt = type_node_str(nc1(fid)) }
            forge rc = mem_class(rt)
            forge fl = nflt > 0 || rc == MC_F64 || rc == MC_F32
            if (fl && !cb_float_ready()) {
                fault_runtime_error("fault_addr(" + name + "): callback com crystal/f32 precisa dos trampolins com ponto flutuante (ofscc da onda 4, fora do Windows x64)")
                return 0
            }
            if (nint > FFI_CB_ARGS || nflt > FFI_CB_FARGS) {
                fault_runtime_error("fault_addr(" + name + "): callback com mais de " + ofs_stone_to_obsidian(FFI_CB_ARGS) + " parametros inteiros/ponteiros ou " + ofs_stone_to_obsidian(FFI_CB_FARGS) + " crystal/f32")
                return 0
            }
            ofs_array_push(_cb_fn, fid)
            ofs_array_push(_cb_pcls, pcls)
            ofs_array_push(_cb_ptypes, ptypes)
            ofs_array_push(_cb_rcls, rc)
            ofs_array_push(_cb_float, fl)
            forge cba = 0
            if (fl) { cba = fault_call(_cbx_table, n) }
            else { cba = fault_call(_cb_table, n) }
            ofs_array_push(_cb_addr, cba)
            return cba
        }
    }

    // bits <-> ponto flutuante (memoria de rascunho)
    vein fbits_scr() -> stone {
        if (_fbits_scr == 0) { _fbits_scr = ofs_alloc(8) as stone }
        return _fbits_scr
    }

    vein f64_bits(f: crystal) -> stone {
        forge a = fbits_scr()
        mem_wr_f(a, MC_F64, f)
        return mem_rd(a, MC_I64)
    }

    vein bits_f64(b: stone) -> crystal {
        forge a = fbits_scr()
        mem_wr(a, MC_I64, b)
        return mem_rd_f(a, MC_F64)
    }

    // f32 na metade baixa de 64 bits (como fica num registrador xmm/s)
    vein f32_bits(f: crystal) -> stone {
        forge a = fbits_scr()
        mem_wr(a, MC_I64, 0)
        mem_wr_f(a, MC_F32, f)
        return mem_rd(a, MC_I64)
    }

    vein bits_f32(b: stone) -> crystal {
        forge a = fbits_scr()
        mem_wr(a, MC_I64, b & 4294967295)
        return mem_rd_f(a, MC_F32)
    }

    vein cbx_fbit(k: stone, b0: stone, b1: stone, b2: stone, b3: stone, b4: stone, b5: stone, b6: stone, b7: stone) -> stone {
        if (k == 0) { return b0 }
        if (k == 1) { return b1 }
        if (k == 2) { return b2 }
        if (k == 3) { return b3 }
        if (k == 4) { return b4 }
        if (k == 5) { return b5 }
        if (k == 6) { return b6 }
        return b7
    }

    // entrada de um trampolim com ponto flutuante: inteiros pela ordem dos
    // registradores inteiros, crystal/f32 pela dos registradores float
    vein cbx_enter(slot: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone, b0: stone, b1: stone, b2: stone, b3: stone, b4: stone, b5: stone, b6: stone, b7: stone) -> stone {
        if (slot < 0 || slot >= ofs_array_len(_cb_fn)) { return 0 }
        forge sk = _rk
        forge st: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        forge scall = _cur_call_id
        if (_hy_depth > 0) { hy_sync_out(_hy_mod) }
        forge fid: stone = ofs_array_get(_cb_fn, slot)
        forge pcls: Array<stone> = ofs_array_get(_cb_pcls, slot)
        forge ptypes: Array<obsidian> = ofs_array_get(_cb_ptypes, slot)
        forge np = ofs_array_len(pcls)
        forge base = ofs_array_len(_arg_kinds)
        forge ii = 0
        forge fi = 0
        forge j = 0
        while (j < np) {
            forge c: stone = ofs_array_get(pcls, j)
            forge t: obsidian = ofs_array_get(ptypes, j)
            if (c == MC_F64) {
                r_float(bits_f64(cbx_fbit(fi, b0, b1, b2, b3, b4, b5, b6, b7)))
                fi++
            } else if (c == MC_F32) {
                r_float(bits_f32(cbx_fbit(fi, b0, b1, b2, b3, b4, b5, b6, b7)))
                _rt = "f32"
                fi++
            } else {
                regs_from_raw(cb_raw_arg(ii, a0, a1, a2, a3, a4, a5), c, t)
                ii++
            }
            arg_push_regs()
            j++
        }
        call_function_by_id(fid, np, base)
        forge rc: stone = ofs_array_get(_cb_rcls, slot)
        forge r = 0
        if (rc == MC_F64) { r = f64_bits(reg_as_f()) }
        else if (rc == MC_F32) { r = f32_bits(reg_as_f()) }
        else { r = reg_as_int() }
        args_pop_to(base)
        if (_hy_depth > 0) { hy_sync_in(_hy_mod) }
        r_set(sk, st, si, sf, sb, ss, sr)
        _cur_call_id = scall
        return r
    }

    vein cb_raw_arg(j: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone) -> stone {
        if (j == 0) { return a0 }
        if (j == 1) { return a1 }
        if (j == 2) { return a2 }
        if (j == 3) { return a3 }
        if (j == 4) { return a4 }
        return a5
    }

    // entrada de um trampolim: roda a vein do slot com os argumentos brutos
    vein cb_enter(slot: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone) -> stone {
        if (slot < 0 || slot >= ofs_array_len(_cb_fn)) { return 0 }
        forge sk = _rk
        forge st: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        forge scall = _cur_call_id
        // F5: callback vindo de uma vein nativa do modo hibrido: os globais
        // que o nativo mexeu voltam para o interpretador antes, e vao de
        // novo para o nativo depois
        if (_hy_depth > 0) { hy_sync_out(_hy_mod) }
        forge fid: stone = ofs_array_get(_cb_fn, slot)
        forge pcls: Array<stone> = ofs_array_get(_cb_pcls, slot)
        forge ptypes: Array<obsidian> = ofs_array_get(_cb_ptypes, slot)
        forge np = ofs_array_len(pcls)
        forge base = ofs_array_len(_arg_kinds)
        forge j = 0
        while (j < np) {
            forge c: stone = ofs_array_get(pcls, j)
            forge t: obsidian = ofs_array_get(ptypes, j)
            regs_from_raw(cb_raw_arg(j, a0, a1, a2, a3, a4, a5), c, t)
            arg_push_regs()
            j++
        }
        call_function_by_id(fid, np, base)
        forge r = reg_as_int()
        args_pop_to(base)
        if (_hy_depth > 0) { hy_sync_in(_hy_mod) }
        r_set(sk, st, si, sf, sb, ss, sr)
        _cur_call_id = scall
        return r
    }

    // ── LValue Evaluation ─────────────────────────────────────────────────

    vein set_lvalue(k: stone, var_idx: stone, h: stone, idx: stone, field: obsidian) -> void {
        _lk = k
        _lvar = var_idx
        _lh = h
        _lidx = idx
        _lfield = field
    }

    // resultado -> registradores de lvalue (_lk.. )
    vein eval_lvalue(id: stone) -> void {
        if (id < 0) { set_lvalue(LOC_INVALID, -1, -1, -1, ""); return }
        forge kind = nk(id)

        if (kind == NK_IDENT) {
            forge idx = find_var(node_sym(id))
            if (idx >= 0) {
                set_lvalue(LOC_VAR, idx, -1, -1, nval(id))
                return
            }
        }

        if (kind == NK_INDEX) {
            eval_expr(nc0(id))
            forge ak = _rk
            forge ar = _rr
            eval_expr(nc1(id))
            if (ak == VAL_ARRAY) {
                set_lvalue(LOC_ARRAY, -1, ar, _ri, "")
                return
            }
        }

        if (kind == NK_FIELD) {
            eval_expr(nc0(id))
            if (_rk == VAL_OBJECT && _rr > 0) {
                set_lvalue(LOC_FIELD, -1, _rr, field_cached(id, _rt), "")
                return
            }
        }

        if (kind == NK_UNARY_OP) {
            if (nop(id) == OP_DEREF) {
                // `*p = v`: memoria crua no endereco p, na largura do tipo
                // apontado (null = endereco 0: falha como no nativo)
                eval_expr(nc0(id))
                deref_type(id)
                set_lvalue(LOC_MEM, -1, reg_as_int(), _dt_c, _dt_t)
                return
            }
        }

        set_lvalue(LOC_INVALID, -1, -1, -1, "")
    }

    // compara o valor a* com os registradores
    vein val_equals_regs(ak: stone, at: obsidian, ai: stone, af: crystal, ab: bool, astr: obsidian, ar: stone) -> bool {
        if (ak == VAL_FN && _rk == VAL_FN) {
            // geode com captura: cada criacao e um valor (como o ponteiro do nativo)
            if (ar >= 0 || _rr >= 0) { return ar == _rr && (ai == _ri || (ai <= 0 && _ri <= 0)) }
            return ai == _ri
        }
        if (ak == VAL_VARIANT && _rk == VAL_VARIANT) {
            return ofs_str_eq(at, _rt)
        }
        if (ak == VAL_STRING && _rk == VAL_STRING) {
            return ofs_str_eq(astr, _rs)
        }
        if (ak == VAL_FLOAT || _rk == VAL_FLOAT) {
            forge lf: crystal = 0.0
            if (ak == VAL_FLOAT) { lf = af } else { lf = ai as crystal }
            forge rf: crystal = 0.0
            if (_rk == VAL_FLOAT) { rf = _rf } else { rf = _ri as crystal }
            return lf == rf
        }
        if (ak == VAL_BOOL && _rk == VAL_BOOL) {
            return ab == _rb
        }
        if (ak == VAL_NULL && _rk == VAL_NULL) {
            return true
        }
        // ponteiro do C/memoria crua comparado com null
        if (ak == VAL_NULL && _rk == VAL_INT) { return _ri == 0 }
        if (ak == VAL_INT && _rk == VAL_NULL) { return ai == 0 }
        if (ak == VAL_NULL || _rk == VAL_NULL) {
            return false
        }
        if (ak == VAL_ARRAY && _rk == VAL_ARRAY) {
            return ar == _rr
        }
        if (ak == VAL_OBJECT && _rk == VAL_OBJECT) {
            return ar == _rr
        }
        return ai == _ri
    }

    // left = a*, right = registradores; resultado -> registradores
    vein eval_bin_calc(op: stone, ak: stone, at: obsidian, ai: stone, af: crystal, ab: bool, astr: obsidian) -> void {
        forge lf: crystal = 0.0
        forge rf: crystal = 0.0
        forge is_f: bool = ak == VAL_FLOAT || _rk == VAL_FLOAT
        if (is_f) {
            if (ak == VAL_FLOAT) { lf = af } else { lf = ai as crystal }
            if (_rk == VAL_FLOAT) { rf = _rf } else { rf = _ri as crystal }
        }
        if (op == OP_ADD) {
            if (ak == VAL_STRING || _rk == VAL_STRING) {
                forge ls: obsidian = val_str(ak, at, ai, af, ab, astr)
                forge rs: obsidian = r_to_string()
                r_string(ls + rs)
                return
            }
            if (is_f) { r_float(lf + rf); return }
            r_int(ai + _ri)
            return
        }
        if (op == OP_SUB) {
            if (is_f) { r_float(lf - rf); return }
            r_int(ai - _ri)
            return
        }
        if (op == OP_MUL) {
            if (is_f) { r_float(lf * rf); return }
            r_int(ai * _ri)
            return
        }
        if (op == OP_DIV) {
            if (is_f) {
                if (rf == 0.0) { r_float(0.0); return }
                r_float(lf / rf)
                return
            }
            if (_ri == 0) { r_int(0); return }
            r_int(ai / _ri)
            return
        }
        if (op == OP_MOD) {
            if (_ri == 0) { r_int(0); return }
            r_int(ai % _ri)
            return
        }
        if (op == OP_BAND) { r_int(ai & _ri); return }
        if (op == OP_BOR) { r_int(ai | _ri); return }
        if (op == OP_BXOR) { r_int(ai ^ _ri); return }
        if (op == OP_SHL) { r_int(ai << _ri); return }
        if (op == OP_SHR) { r_int(ai >> _ri); return }
        r_int(0)
    }

    // left = a*, right = registradores; ordem (<, <=, >, >=) -> bool
    vein eval_compare(op: stone, ak: stone, ai: stone, af: crystal) -> bool {
        if (ak == VAL_FLOAT || _rk == VAL_FLOAT) {
            forge lf: crystal = 0.0
            if (ak == VAL_FLOAT) { lf = af } else { lf = ai as crystal }
            forge rf: crystal = 0.0
            if (_rk == VAL_FLOAT) { rf = _rf } else { rf = _ri as crystal }
            if (op == OP_LT) { return lf < rf }
            if (op == OP_LE) { return lf <= rf }
            if (op == OP_GT) { return lf > rf }
            return lf >= rf
        }
        if (op == OP_LT) { return ai < _ri }
        if (op == OP_LE) { return ai <= _ri }
        if (op == OP_GT) { return ai > _ri }
        return ai >= _ri
    }

    vein calc_op_of_assign(op: stone) -> stone {
        if (op == OP_ADD_ASSIGN) { return OP_ADD }
        if (op == OP_SUB_ASSIGN) { return OP_SUB }
        if (op == OP_MUL_ASSIGN) { return OP_MUL }
        if (op == OP_DIV_ASSIGN) { return OP_DIV }
        return OP_MOD
    }

    // ── Expression Evaluation ─────────────────────────────────────────────
    //
    // Cada tipo de no tem a sua vein, com os locais declarados logo no
    // inicio (allocas estaticas e pequenas): a recursao do programa
    // interpretado passa por estas veins, e o tamanho de cada quadro nativo
    // limita a profundidade de recursao suportada.

    // resultado -> registradores
    vein eval_expr(id: stone) -> void {
        forge kind = nk(id)
        if (id < 0) { r_void(); return }
        if (kind == NK_BIN_OP) { eval_bin_op(id); return }
        if (kind == NK_IDENT) { eval_ident(id); return }
        if (kind == NK_LIT_INT) { r_int(naux(id)); return }
        if (kind == NK_CALL) { eval_call(id); return }
        if (kind == NK_INDEX) { eval_index(id); return }
        if (kind == NK_LIT_STRING) { r_string(nval(id)); return }
        if (kind == NK_LIT_FLOAT) { eval_lit_float(id); return }
        if (kind == NK_LIT_BOOL) { r_bool(naux(id) != 0); return }
        if (kind == NK_LIT_NULL) { r_null(); return }
        if (kind == NK_FIELD) { eval_field(id); return }
        if (kind == NK_UNARY_OP) { eval_unary_op(id); return }
        if (kind == NK_POST_OP) { eval_post_op(id); return }
        if (kind == NK_CAST) { eval_cast(id); return }
        if (kind == NK_ARRAY_LIT) { eval_array_lit(id); return }
        if (kind == NK_LAMBDA) { eval_geode(id); return }
        r_null()
    }

    vein eval_lit_float(id: stone) -> void {
        forge fv: crystal = ofs_array_get(_nf, id) as crystal
        r_float(fv)
    }

    vein eval_array_lit(id: stone) -> void {
        forge h = interp_new_array()
        forge elems: Array<stone> = nextra(id)
        forge count = ofs_array_len(elems)
        forge i = 0
        forge elem_id = 0
        while (i < count) {
            elem_id = ofs_array_get(elems, i)
            eval_expr(elem_id)
            interp_array_push(h)
            i++
        }
        r_array(h)
    }

    vein eval_ident(id: stone) -> void {
        forge vidx = 0
        if (nop(id) != 0) {
            r_null()
            r_variant(nval(id))
            return
        }
        vidx = find_var(node_sym(id))
        if (vidx >= 0) {
            env_load(vidx)
            return
        }
        // F6: nome de vein (_naux = id+1) ou de extern (_naux = -(ei+1))
        forge fa = naux(id)
        if (fa > 0) {
            r_fn(ntype(id), fa - 1, 0, nval(id))
            return
        }
        if (fa < 0) {
            forge fei = 0 - fa - 1
            forge faddr = ffi_resolve(fei)
            if (faddr == 0) {
                ffi_stderr(ffi_undefined_msg(ext_sym(fei)))
                exit(1)
            }
            r_fn(ntype(id), -1, faddr, nval(id))
            return
        }
        r_null()
    }

    vein eval_index(id: stone) -> void {
        forge ak = 0
        forge ar = 0
        eval_expr(nc0(id))
        ak = _rk
        ar = _rr
        eval_expr(nc1(id))
        if (ak == VAL_ARRAY) {
            arr_check_index(ar, _ri)
            interp_array_get(ar, _ri)
            return
        }
        r_null()
    }

    vein eval_field(id: stone) -> void {
        eval_expr(nc0(id))
        if (_rk == VAL_OBJECT && _rr > 0) {
            forge fi = field_cached(id, _rt)
            if (fi < 0) { r_null(); return }
            obj_load_field(_rr, fi)
            return
        }
        r_null()
    }

    // etiqueta numerica da variante: posicao global em ordem de declaracao
    // (a mesma do llvmgen, onde variantes sao globais i64)
    vein variant_index(name: obsidian) -> stone {
        forge i = 0
        forge n = ofs_array_len(_variant_names)
        while (i < n) {
            forge vn: obsidian = ofs_array_get(_variant_names, i)
            if (ofs_str_eq(vn, name)) { return i }
            i++
        }
        return -1
    }

    vein is_strata_name(name: obsidian) -> bool {
        if (ofs_str_len(name) == 0) { return false }
        forge i = 0
        while (i < _n_count) {
            if (nk(i) == NK_STRATA && ofs_str_eq(nval(i), name)) { return true }
            i++
        }
        return false
    }

    // `x?` sobre variante (mesma semantica do nativo, ver llvmgen.emit_try):
    //   Solid(v)? / Ore(v)? -> v
    //   Crack(e)? / Barren? -> sai da vein atual (anchors rodam) devolvendo a
    //     variante se o retorno declarado for um tipo `strata`; senao a
    //     etiqueta numerica (stone; crystal/obsidian convertidos; void: nada)
    vein eval_try(id: stone) -> void {
        eval_expr(nc0(id))
        if (_rk != VAL_VARIANT) { return }
        forge bt: obsidian = _rt
        forge bi = _ri
        forge bs: obsidian = _rs
        if (ofs_str_eq(bt, "Crack") || ofs_str_eq(bt, "Barren")) {
            forge rt: obsidian = ""
            if (_cur_fn_id >= 0 && nk(_cur_fn_id) == NK_FN_DECL && nc1(_cur_fn_id) >= 0) {
                rt = nval(nc1(_cur_fn_id))
            }
            if (!is_strata_name(rt)) {
                forge tag = variant_index(bt)
                if (ofs_str_eq(rt, "void")) { r_void() }
                else if (ofs_str_eq(rt, "crystal")) { r_float(tag as crystal) }
                else if (ofs_str_eq(rt, "obsidian")) { r_string(ofs_stone_to_obsidian(tag)) }
                else { r_int(tag) }
            }
            set_return_from_regs()
            _try_unwind = true
            r_null()
            return
        }
        if (!ofs_str_eq(bs, bt)) {
            r_string(bs)
            return
        }
        r_int(bi)
    }

    vein eval_post_op(id: stone) -> void {
        forge pcode = nop(id)
        if (pcode == OP_TRY) { eval_try(id); return }
        eval_lvalue(nc0(id))
        forge plk = _lk
        forge plv = _lvar
        forge plh = _lh
        forge pli = _lidx
        forge plf: obsidian = _lfield
        load_location(plk, plv, plh, pli, plf)
        forge ok = _rk
        forge ot: obsidian = _rt
        forge oi = _ri
        forge of: crystal = _rf
        forge ob = _rb
        forge os: obsidian = _rs
        forge orr = _rr
        if (pcode == OP_INC) {
            r_int(oi + 1)
        } else {
            r_int(oi - 1)
        }
        store_location(plk, plv, plh, pli, plf)
        r_set(ok, ot, oi, of, ob, os, orr)
    }

    vein eval_unary_op(id: stone) -> void {
        forge uop = nop(id)
        forge ival = 0
        if (uop == OP_ADDR) {
            eval_addr(id)
            return
        }
        eval_expr(nc0(id))
        if (uop == OP_DEREF) {
            // `*p`: le a memoria crua em p pela largura do tipo apontado
            deref_type(id)
            mem_load(reg_as_int(), _dt_c, _dt_t)
            return
        }
        if (uop == OP_NEG) {
            if (_rk == VAL_FLOAT) {
                r_float(0.0 - _rf)
                return
            }
            r_int(0 - _ri)
            return
        }
        if (uop == OP_NOT) {
            if (r_truthy()) {
                r_bool(false)
                return
            }
            r_bool(true)
            return
        }
        if (uop == OP_BNOT) {
            ival = _ri
            r_int(~ival)
            return
        }
    }

    // `&x` (endereco real): variavel -> slot de memoria crua (box_var);
    // monolith -> o proprio bloco. Como no
    // llvmgen, o tipo e "*" + tipo do operando (typeck).
    vein eval_addr(id: stone) -> void {
        forge c = nc0(id)
        forge ck = nk(c)
        if (ck == NK_IDENT) {
            forge idx = find_var(node_sym(c))
            if (idx < 0) {
                fault_runtime_error("&" + nval(c) + ": variavel desconhecida")
                return
            }
            forge k: stone = ofs_array_get(_env_kind, idx)
            forge a = 0
            if (k == VAL_OBJECT) {
                a = ofs_array_get(_env_ref, idx)
            } else {
                a = box_var(idx, ntype(c))
            }
            r_int(a)
            _rt = ntype(id)
            return
        }
        // `&s.campo`, `&a[i]`: o llvmgen so tem endereco de variavel (para o
        // resto devolve o valor, nao o endereco); aqui, erro claro
        fault_runtime_error("&expr: so existe endereco de variavel (&x); para um campo use (&s) as stone + offset")
    }

    // `x as T` com a regra do llvmgen (NK_CAST): mesmo tipo LLVM = so muda o
    // tipo; ptrtoint/inttoptr; fptosi/sitofp (da largura de origem);
    // fpext/fptrunc; trunc se a origem e mais larga, senao zext.
    // _naux = classe do destino; _nop = classe estatica da origem + 1.
    vein eval_cast(id: stone) -> void {
        forge dt: obsidian = nval(id)
        forge dc = naux(id)
        forge sstat = nop(id) - 1
        eval_expr(nc0(id))
        forge k = _rk
        if (dc == MC_FN) {
            // F6 (abyss): endereco cru ou outra vein -> vein do tipo dt
            if (k == VAL_NULL) { return }
            if (k == VAL_FN) { _rt = dt; return }
            forge fv = reg_as_int()
            fn_from_raw(fv, dt)
            return
        }
        if (dc == MC_STR) {
            if (k == VAL_STRING || k == VAL_NULL) { return }
            if (k == VAL_INT || k == VAL_OBJECT || k == VAL_ARRAY) {
                // inttoptr / ptr -> ptr: o endereco vira char*
                forge pa = reg_as_int()
                if (pa == 0) { r_null(); return }
                r_string(pa as obsidian)
                return
            }
            // bool/crystal/variante: o nativo nao compila; vira texto
            r_string(r_to_string())
            return
        }
        if (dc == MC_PTR || dc == MC_OBJ || dc == MC_ARRAY) {
            if (k == VAL_NULL) { return }
            if (k == VAL_OBJECT && dc == MC_OBJ) { _rt = dt; return }
            if (k == VAL_ARRAY && dc == MC_ARRAY) { return }
            forge pv = 0
            if (k == VAL_FLOAT) { pv = _rf as stone } else { pv = reg_as_int() }
            if (dc == MC_OBJ) {
                if (pv == 0) { r_null(); return }
                r_object(dt, pv)
                return
            }
            if (dc == MC_ARRAY) {
                if (pv == 0) { r_null(); return }
                r_array(arr_adopt(pv, dt))
                return
            }
            r_int(pv)
            _rt = dt
            return
        }
        if (dc == MC_F64 || dc == MC_F32) {
            forge f: crystal = 0.0
            if (k == VAL_FLOAT) { f = _rf }
            else if (k == VAL_INT) {
                // iN com sinal, uN sem sinal (sitofp/uitofp do llvmgen)
                forge sc = cast_src_class(sstat)
                f = mc_canon(sc, _ri) as crystal
            }
            else if (k == VAL_BOOL) {
                if (_rb) { f = 1.0 }
            }
            else if (k == VAL_STRING) { f = parse_float(_rs) }
            else { f = reg_as_int() as crystal }
            if (dc == MC_F32) {
                r_float(f32_round(f))
                _rt = "f32"
                return
            }
            r_float(f)
            return
        }
        if (dc == MC_BOOL) {
            if (k == VAL_BOOL) { return }
            forge bv = 0
            if (k == VAL_FLOAT) { bv = _rf as stone } else { bv = reg_as_int() }
            r_bool((bv & 4294967295) != 0)
            return
        }
        // destino inteiro
        forge v = 0
        if (k == VAL_FLOAT) { v = _rf as stone }
        else if (k == VAL_INT) {
            forge sc2 = cast_src_class(sstat)
            v = _ri
            if (mc_bits(sc2) < mc_bits(dc)) {
                // estende da largura de origem: sext para iN, zext para uN
                v = mc_canon(sc2, v)
            }
        } else { v = reg_as_int() }
        r_int(mc_canon(dc, v))
        if (mc_is_narrow(dc)) { _rt = mc_name(dc) }
    }

    // classe da origem de um cast de VAL_INT: a estatica (typeck) se for
    // inteira; senao a do tipo do valor
    vein cast_src_class(sstat: stone) -> stone {
        if (sstat >= 0 && (sstat <= MC_BOOL || sstat == MC_PTR || sstat == MC_STR || sstat == MC_VARIANT)) { return sstat }
        if (ofs_str_eq(_rt, "stone")) { return MC_I64 }
        return mem_class(_rt)
    }

    // `=` e `op=`; o resultado (valor atribuido) fica nos registradores
    vein eval_assign(id: stone, op: stone) -> void {
        eval_lvalue(nc0(id))
        forge alk = _lk
        forge alv = _lvar
        forge alh = _lh
        forge ali = _lidx
        forge alf: obsidian = _lfield
        eval_expr(nc1(id))
        forge ac: stone = ofs_array_get(_naux, id)
        if (op == OP_ASSIGN) {
            if (ac != 0) { coerce_regs(ac) }
            store_location(alk, alv, alh, ali, alf)
            return
        }
        forge rk = _rk
        forge rt: obsidian = _rt
        forge ri = _ri
        forge rfv: crystal = _rf
        forge rb = _rb
        forge rs: obsidian = _rs
        forge rr = _rr
        load_location(alk, alv, alh, ali, alf)
        forge ok2 = _rk
        forge ot2: obsidian = _rt
        forge oi2 = _ri
        forge of2: crystal = _rf
        forge ob2 = _rb
        forge os2: obsidian = _rs
        r_set(rk, rt, ri, rfv, rb, rs, rr)
        eval_bin_calc(calc_op_of_assign(op), ok2, ot2, oi2, of2, ob2, os2)
        if (ac != 0) { coerce_regs(ac) }
        store_location(alk, alv, alh, ali, alf)
    }

    vein eval_logic(id: stone, op: stone) -> void {
        eval_expr(nc0(id))
        if (op == OP_LAND) {
            if (!r_truthy()) { r_bool(false); return }
        } else {
            if (r_truthy()) { r_bool(true); return }
        }
        eval_expr(nc1(id))
        if (r_truthy()) { r_bool(true); return }
        r_bool(false)
    }

    vein eval_bin_op(id: stone) -> void {
        forge op = nop(id)
        forge lk = 0
        forge lt: obsidian = ""
        forge li = 0
        forge lfv: crystal = 0.0
        forge lb = false
        forge ls: obsidian = ""
        forge lr = 0
        if (op >= OP_ASSIGN && op <= OP_MOD_ASSIGN) { eval_assign(id, op); return }
        if (op == OP_LAND || op == OP_LOR) { eval_logic(id, op); return }

        eval_expr(nc0(id))
        lk = _rk
        lt = _rt
        li = _ri
        lfv = _rf
        lb = _rb
        ls = _rs
        lr = _rr
        eval_expr(nc1(id))

        if (op >= OP_LT && op <= OP_GE) {
            r_bool(eval_compare(op, lk, li, lfv))
            return
        }
        if (op == OP_EQ) {
            r_bool(val_equals_regs(lk, lt, li, lfv, lb, ls, lr))
            return
        }
        if (op == OP_NE) {
            r_bool(!val_equals_regs(lk, lt, li, lfv, lb, ls, lr))
            return
        }
        eval_bin_calc(op, lk, lt, li, lfv, lb, ls)
    }

    vein eval_call(id: stone) -> void {
        forge args: Array<stone> = nextra(id)
        forge num_args = ofs_array_len(args)
        forge arg_base = ofs_array_len(_arg_kinds)
        forge ck: stone = ofs_array_get(_nop, id)
        forge aux: stone = ofs_array_get(_naux, id)
        forge ai = 0
        forge arg_id = 0
        if (ck == CALL_BUILTIN && aux == BI_FAULT_ADDR) {
            // o argumento e um nome de vein, nao uma expressao
            ffi_fault_addr(id)
            return
        }
        if (ofs_array_len(_ar_h) > 0 && num_args == 1 && ck != CALL_FN && ofs_str_eq(nval(id), "ofs_alloc")) {
            forge arh = ar_lexical()
            if (arh != 0) {
                eval_expr(ofs_array_get(args, 0))
                forge asz = reg_as_int()
                if (asz <= 0) { asz = 1 }
                forge ap = ar_call2(_ar_alloc_fn, arh, asz)
                forge apt: obsidian = ntype(id)
                if (ofs_str_len(apt) == 0 || ofs_str_eq(apt, "unknown")) { apt = "*stone" }
                r_set(VAL_INT, apt, ap, 0.0, false, "", -1)
                return
            }
        }
        if (ck == CALL_VEIN) {
            // F6: a vein (c0) e avaliada antes dos argumentos, como no nativo
            eval_expr(nc0(id))
            forge vk = _rk
            forge vt: obsidian = _rt
            forge vi = _ri
            forge vs: obsidian = _rs
            forge vr = _rr
            while (ai < num_args) {
                arg_id = ofs_array_get(args, ai)
                eval_expr(arg_id)
                arg_push_regs()
                ai++
            }
            r_set(vk, vt, vi, 0.0, false, vs, vr)
            _cur_call_id = id
            call_vein_value(num_args, arg_base)
            args_pop_to(arg_base)
            return
        }
        while (ai < num_args) {
            arg_id = ofs_array_get(args, ai)
            eval_expr(arg_id)
            arg_push_regs()
            ai++
        }
        if (ck == CALL_FN) {
            call_function_by_id(aux, num_args, arg_base)
        } else {
            _cur_call_id = id
            call_classified(ck, aux, nval(id), num_args, arg_base)
        }
        // Pop arguments from stack (o resultado esta nos registradores)
        args_pop_to(arg_base)
    }

    // ── Function Execution ────────────────────────────────────────────────

    // primeira ocorrencia de "__" (ou, sem ela, de "."): devolve a posicao e
    // o tamanho do separador em _sep_len
    forge _sep_len: stone = 0

    vein find_method_sep(name: obsidian) -> stone {
        forge len = ofs_str_len(name)
        forge i = 0
        while (i + 1 < len) {
            if (ofs_str_char_at(name, i) == 95 && ofs_str_char_at(name, i + 1) == 95) {
                _sep_len = 2
                return i
            }
            i++
        }
        i = 0
        while (i < len) {
            if (ofs_str_char_at(name, i) == 46) {
                _sep_len = 1
                return i
            }
            i++
        }
        _sep_len = 0
        return -1
    }

    // Classifica uma chamada pelo nome (mesma ordem de antes: builtin,
    // construtor de variante, vein registrada, metodo dinamico).
    forge _cls_aux: stone = 0

    vein classify_call(name: obsidian) -> stone {
        if (ofs_str_eq(name, "__vein_call")) {
            _cls_aux = 0
            return CALL_VEIN
        }
        forge bi = builtin_code(name)
        if (bi != BI_NONE) {
            _cls_aux = bi
            return CALL_BUILTIN
        }
        forge fid = find_function(name)
        if (fid >= 0) {
            _cls_aux = fid
            return CALL_FN
        }
        // extern/rift: o simbolo (bind) pode ser uma vein do proprio programa
        // (o llvmgen tambem nao declara o que o modulo define) ou um builtin
        forge ei = find_extern(name)
        if (ei >= 0) {
            forge esym = ext_sym(ei)
            if (!ofs_str_eq(esym, name)) {
                forge bfid = find_function(esym)
                if (bfid >= 0) {
                    _cls_aux = bfid
                    return CALL_FN
                }
                forge bbi = builtin_code(esym)
                if (bbi != BI_NONE) {
                    _cls_aux = bbi
                    return CALL_BUILTIN
                }
            }
            _cls_aux = ei
            return CALL_EXTERN
        }
        // Nome com inicial maiuscula e construtor de variante, exceto se for
        // uma vein registrada (metodo de impl ja reescrito: `Rect__area`).
        if (starts_upper(name)) {
            _cls_aux = 0
            return CALL_VARIANT
        }
        _cls_aux = new_dyn_call(name)
        return CALL_DYN
    }

    vein new_dyn_call(name: obsidian) -> stone {
        forge sep_pos = find_method_sep(name)
        forge sl = _sep_len
        ofs_array_push(_dyn_name, name)
        if (sep_pos >= 0) {
            forge var_part = ofs_str_substr(name, 0, sep_pos)
            forge method_part = ofs_str_substr(name, sep_pos + sl, ofs_str_len(name) - sep_pos - sl)
            ofs_array_push(_dyn_has_sep, true)
            ofs_array_push(_dyn_var_sym, sym_intern(var_part))
            ofs_array_push(_dyn_method, method_part)
        } else {
            ofs_array_push(_dyn_has_sep, false)
            ofs_array_push(_dyn_var_sym, -1)
            ofs_array_push(_dyn_method, "")
        }
        ofs_array_push(_dyn_cache_type, "")
        ofs_array_push(_dyn_cache_fn, -1)
        ofs_array_push(_dyn_cache_ok, false)
        ofs_array_push(_dyn_errmsg, "")
        return ofs_array_len(_dyn_name) - 1
    }

    // Resolve todas as chamadas da AST (depois de collect_declarations)
    vein resolve_calls() -> void {
        resolve_calls_from(0)
    }

    vein resolve_calls_from(start: stone) -> void {
        forge i = start
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_CALL) {
                forge name: obsidian = ofs_array_get(_nval, i)
                forge ck = classify_call(name)
                ofs_array_set(_nop, i, ck)
                ofs_array_set(_naux, i, _cls_aux)
            } else if (k == NK_LAMBDA) {
                // geode: a vein do corpo (__geode_<vein>_<k>)
                ofs_array_set(_naux, i, find_function(ofs_array_get(_nval, i)) + 1)
            } else if (k == NK_IDENT) {
                // F6: nome de vein/extern usado como valor (o typeck deu o
                // tipo vein(...)); uma variavel com o mesmo nome vence em
                // eval_ident
                forge ityp: obsidian = ofs_array_get(_ntype, i)
                if (vein_type_is(ityp)) {
                    forge iname: obsidian = ofs_array_get(_nval, i)
                    forge rfid = find_function(iname)
                    if (rfid >= 0) {
                        ofs_array_set(_naux, i, rfid + 1)
                    } else {
                        forge rei = find_extern(iname)
                        if (rei >= 0) {
                            forge resym = ext_sym(rei)
                            forge rbfid = -1
                            if (!ofs_str_eq(resym, iname)) { rbfid = find_function(resym) }
                            if (rbfid >= 0) {
                                ofs_array_set(_naux, i, rbfid + 1)
                            } else {
                                ofs_array_set(_naux, i, 0 - rei - 1)
                                ofs_array_set(_ext_vref, rei, true)
                            }
                        }
                    }
                }
            }
            i++
        }
    }

    vein call_classified(ck: stone, aux: stone, name: obsidian, num_args: stone, arg_base: stone) -> void {
        if (ck == CALL_FN) {
            call_function_by_id(aux, num_args, arg_base)
            return
        }
        if (ck == CALL_BUILTIN) {
            call_builtin(aux, num_args, arg_base)
            return
        }
        if (ck == CALL_EXTERN) {
            call_extern(aux, num_args, arg_base)
            return
        }
        if (ck == CALL_VARIANT) {
            if (num_args > 0) {
                load_arg(arg_base)
            } else {
                r_null()
            }
            r_variant(name)
            return
        }
        call_dynamic(aux, num_args, arg_base)
    }

    vein call_function(name: obsidian, num_args: stone, arg_base: stone) -> void {
        forge ck = classify_call(name)
        call_classified(ck, _cls_aux, name, num_args, arg_base)
    }

    // Check method call (e.g. obj__method or obj.method)
    vein call_dynamic(di: stone, num_args: stone, arg_base: stone) -> void {
        forge name: obsidian = ofs_array_get(_dyn_name, di)
        forge has_sep: bool = ofs_array_get(_dyn_has_sep, di)
        if (has_sep) {
            forge vsym: stone = ofs_array_get(_dyn_var_sym, di)
            forge vidx = find_var(vsym)
            if (vidx >= 0) {
                forge vk: stone = ofs_array_get(_env_kind, vidx)
                if (vk == VAL_OBJECT) {
                    forge vtype: obsidian = ofs_array_get(_env_type, vidx)
                    forge m_fn_id = -1
                    forge cache_ok: bool = ofs_array_get(_dyn_cache_ok, di)
                    forge ctype: obsidian = ofs_array_get(_dyn_cache_type, di)
                    if (cache_ok && ofs_str_eq(ctype, vtype)) {
                        m_fn_id = ofs_array_get(_dyn_cache_fn, di)
                    } else {
                        forge method_part: obsidian = ofs_array_get(_dyn_method, di)
                        forge mangled_name = vtype + "__" + method_part
                        m_fn_id = find_function(mangled_name)
                        if (m_fn_id < 0) {
                            m_fn_id = find_function(method_part)
                        }
                        ofs_array_set(_dyn_cache_type, di, vtype)
                        ofs_array_set(_dyn_cache_fn, di, m_fn_id)
                        ofs_array_set(_dyn_cache_ok, di, true)
                    }
                    if (m_fn_id >= 0) {
                        // Push self as first argument onto _arg_* stack before method args
                        forge self_base = ofs_array_len(_arg_kinds)
                        env_load(vidx)
                        arg_push_regs()
                        forge ai = 0
                        while (ai < num_args) {
                            load_arg(arg_base + ai)
                            arg_push_regs()
                            ai++
                        }
                        call_function_by_id(m_fn_id, num_args + 1, self_base)
                        args_pop_to(self_base)
                        return
                    }
                }
            }
        }
        // mensagem montada uma vez por chamada (um laco que repete o erro
        // nao aloca a cada volta)
        forge msg: obsidian = ofs_array_get(_dyn_errmsg, di)
        if (ofs_str_len(msg) == 0) {
            msg = "Interpreter runtime error: undefined function '" + name + "'"
            ofs_array_set(_dyn_errmsg, di, msg)
        }
        echo(msg)
        // erro de runtime do interpretador: termina com 1, como o runtime nativo
        exit(1)
        r_null()
    }

    // resultado -> registradores
    vein call_function_by_id(fn_id_in: stone, num_args_in: stone, arg_base: stone) -> void {
        forge fn_id = fn_id_in
        forge num_args = num_args_in
        if (_rf_on) {
            // Fault Refract: entre chamadas, aplica a edicao salva; a celula
            // de despacho leva a chamada a versao viva da vein
            rf_tick()
            forge cell: stone = ofs_array_get(_rf_cell, fn_id)
            if (cell >= 0) { fn_id = cell }
            // chamada antiga de uma vein que ganhou parametro com padrao:
            // os padroes entram na pilha de argumentos (vale tambem no nativo)
            if (num_args < nx_len(nc0(fn_id)) && arg_base + num_args == ofs_array_len(_arg_kinds)) {
                num_args = rf_pad_defaults(fn_id, num_args)
            }
        }
        cr_tick(fn_id)
        forge needs_quartz: bool = ofs_array_get(_cr_quartz, fn_id)
        if (_hy_on && (_cr_hot || needs_quartz)) {
            forge hi = hy_root_index(fn_id)
            forge haddr = 0
            if (hi >= 0) { haddr = ofs_array_get(_hy_addr, hi) }
            // endereco 0: raiz nativa em recristalizacao (roda interpretada)
            if (haddr != 0) {
                if (_rf_on) { rf_frame(fn_id, 1) }
                hy_call(hi, num_args, arg_base)
                if (_rf_on) { rf_frame(fn_id, -1) }
                return
            }
        }
        forge params_node_id = nc0(fn_id)
        forge body_id = nc2(fn_id)
        forge saved_frame_base = _current_frame_base
        forge saved_scope_depth = _scope_depth
        forge saved_fn_id = _cur_fn_id
        forge st = EXEC_OK
        _cur_fn_id = fn_id
        if (_rf_on) { rf_frame(fn_id, 1) }

        _current_frame_base = ofs_array_len(_env_sym)
        push_scope()
        if (params_node_id >= 0) {
            bind_params(params_node_id, num_args, arg_base)
        }
        if (body_id >= 0) {
            if (nk(body_id) == NK_BLOCK) {
                st = exec_stmt_list(body_id)
            } else {
                st = execute_stmt(body_id)
            }
        }

        run_anchors_from_depth(saved_scope_depth + 1)

        // Clean up all local variables allocated in this frame
        while (ofs_array_len(_env_sym) > _current_frame_base) {
            env_pop_one()
        }
        _scope_depth = saved_scope_depth
        _current_frame_base = saved_frame_base
        // a OSR da Refract pode ter trocado a versao em execucao
        if (_rf_on) { rf_frame(_cur_fn_id, -1) }
        _cur_fn_id = saved_fn_id
        _try_unwind = false

        if (st == EXEC_RETURN) {
            regs_from_return()
            return
        }
        r_void()
    }

    vein rf_pad_defaults(fid: stone, num_args: stone) -> stone {
        forge params = nc0(fid)
        forge n = num_args
        while (n < nx_len(params)) {
            forge pid = nx_at(params, n)
            if (nc1(pid) < 0) { return n }
            eval_expr(nc1(pid))
            forge pc: stone = ofs_array_get(_nop, pid)
            if (pc != 0) { coerce_regs(pc) }
            arg_push_regs()
            n++
        }
        return n
    }

    vein bind_params(params_node_id: stone, num_args: stone, arg_base: stone) -> void {
        forge params: Array<stone> = nextra(params_node_id)
        forge num_params = ofs_array_len(params)
        forge pi = 0
        forge param_id = 0
        while (pi < num_params) {
            param_id = ofs_array_get(params, pi)
            if (pi < num_args) {
                load_arg(arg_base + pi)
            } else if (nc1(param_id) >= 0) {
                // valor padrao (onda 4): chamada antiga de uma vein que
                // ganhou um parametro na Fault Refract
                eval_expr(nc1(param_id))
            } else {
                r_void()
            }
            forge pc: stone = ofs_array_get(_nop, param_id)
            if (pc != 0) { coerce_regs(pc) }
            // monolith por referencia, como o ponteiro do nativo
            declare_var_noclone(node_sym(param_id))
            pi++
        }
    }

    // executa os statements de um bloco (sem abrir escopo); para no primeiro
    // status diferente de EXEC_OK
    vein exec_stmt_list(block_id: stone) -> stone {
        forge stmts: Array<stone> = nextra(block_id)
        forge b_len = ofs_array_len(stmts)
        forge bi = 0
        forge st = EXEC_OK
        forge s_id = 0
        while (bi < b_len) {
            s_id = ofs_array_get(stmts, bi)
            st = execute_stmt(s_id)
            if (st != EXEC_OK) {
                return st
            }
            if (_try_unwind) { return EXEC_RETURN }
            bi++
        }
        return EXEC_OK
    }

    // ── Statement Execution ───────────────────────────────────────────────

    vein execute_stmt(id: stone) -> stone {
        forge kind = nk(id)
        if (id < 0) { return EXEC_OK }
        // ofs fossil: conta o passo (e para nele no replay com --to/--back)
        if (_fs_on) { fs_step(id) }
        if (kind == NK_RETURN) { return exec_return(id) }
        if (kind == NK_IF) { return exec_if(id) }
        if (kind == NK_BLOCK) { return exec_block(id) }
        if (kind == NK_VAR_DECL || kind == NK_CONST_DECL) { return exec_var_decl(id) }
        if (kind == NK_WHILE) { return exec_while(id) }
        if (kind == NK_CYCLE_C) { return exec_cycle_c(id) }
        if (kind == NK_CYCLE_RANGE) { return exec_cycle_range(id) }
        if (kind == NK_BREAK) { return EXEC_BREAK }
        if (kind == NK_CONTINUE) { return EXEC_CONTINUE }
        if (kind == NK_ASSIGN) { return exec_assign_stmt(id) }
        if (kind == NK_ANCHOR) { return exec_anchor(id) }
        if (kind == NK_MATCH) { return exec_match(id) }
        if (kind == NK_CASE) {
            if (nc1(id) >= 0) { return execute_stmt(nc1(id)) }
            return EXEC_OK
        }
        if (kind == NK_DEFAULT) {
            if (nc0(id) >= 0) { return execute_stmt(nc0(id)) }
            return EXEC_OK
        }
        if (kind == NK_THROW) { return exec_throw(id) }
        if (kind == NK_QUARTZ) {
            // nunca chega aqui: a vein com quartz roda nativa (hy_prepare)
            fault_runtime_error("quartz (assembly inline) nao roda no interpretador; a vein devia rodar nativa (execucao hibrida)")
            return EXEC_OK
        }

        // Expression as statement
        eval_expr(id)
        return EXEC_OK
    }

    vein exec_return(id: stone) -> stone {
        forge rexpr = nc0(id)
        if (rexpr >= 0) {
            eval_expr(rexpr)
            // `return x?` com falha: o valor de retorno ja foi gravado
            if (_try_unwind) { return EXEC_RETURN }
        } else {
            r_void()
        }
        set_return_from_regs()
        return EXEC_RETURN
    }

    vein exec_if(id: stone) -> stone {
        eval_expr(nc0(id))
        if (_try_unwind) { return EXEC_RETURN }
        if (r_truthy()) {
            return execute_stmt(nc1(id))
        } else if (nc2(id) >= 0) {
            return execute_stmt(nc2(id))
        }
        return EXEC_OK
    }

    vein exec_block(id: stone) -> stone {
        forge st = EXEC_OK
        // bloco "arena" (A5.3): marcado em annotate_nodes_from (_naux = 1)
        if (naux(id) == 1) { return exec_arena_block(id) }
        push_scope()
        st = exec_stmt_list(id)
        pop_scope()
        return st
    }

    vein exec_var_decl(id: stone) -> stone {
        forge init_id = nc1(id)
        if (init_id >= 0) {
            eval_expr(init_id)
            forge dc: stone = ofs_array_get(_nop, id)
            if (dc != 0) { coerce_regs(dc) }
            declare_var(node_sym(id))
        } else {
            default_value_for_type(ntype(id))
            declare_var_noclone(node_sym(id))
        }
        return EXEC_OK
    }

    vein exec_assign_stmt(id: stone) -> stone {
        eval_lvalue(nc0(id))
        forge alk = _lk
        forge alv = _lvar
        forge alh = _lh
        forge ali = _lidx
        forge alf: obsidian = _lfield
        eval_expr(nc1(id))
        forge ac: stone = ofs_array_get(_naux, id)
        if (ac != 0) { coerce_regs(ac) }
        store_location(alk, alv, alh, ali, alf)
        return EXEC_OK
    }

    vein exec_while(id: stone) -> stone {
        forge wc = nc0(id)
        forge wb = nc1(id)
        forge st = EXEC_OK
        forge spin = 0
        forge gen = _rf_gen
        while (true) {
            // OSR (onda 4): cabecalho do laco
            if (_osr_on) {
                if (_rf_on && _rf_gen != gen) {
                    gen = _rf_gen
                    forge nl = rf_osr_target(id)
                    if (nl >= 0) { return rf_osr_switch(id, nl) }
                }
                spin++
                if ((spin & 1023) == 0) {
                    // laco sem chamadas tambem ve a edicao salva
                    if (_rf_on) {
                        rf_tick()
                        if (_rf_gen != gen) { continue }
                    }
                    forge os = osr_tick(id)
                    if (os == 0) { return EXEC_OK }
                }
            }
            eval_expr(wc)
            if (_try_unwind) { return EXEC_RETURN }
            if (!r_truthy()) { break }
            st = execute_stmt(wb)
            if (st == EXEC_RETURN || st == EXEC_THROW) { return st }
            if (st == EXEC_BREAK) { break }
        }
        return EXEC_OK
    }

    vein exec_cycle_c(id: stone) -> stone {
        forge c_init = nc0(id)
        forge c_cond = nc1(id)
        forge c_step = nc2(id)
        forge c_body = nc3(id)
        forge st = EXEC_OK
        push_scope()
        if (c_init >= 0) { execute_stmt(c_init) }
        while (true) {
            if (c_cond >= 0) {
                eval_expr(c_cond)
                if (!r_truthy()) { break }
            }
            st = execute_stmt(c_body)
            if (st == EXEC_RETURN || st == EXEC_THROW) { pop_scope(); return st }
            if (st == EXEC_BREAK) { break }
            if (c_step >= 0) { execute_stmt(c_step) }
        }
        pop_scope()
        return EXEC_OK
    }

    vein exec_cycle_range(id: stone) -> stone {
        forge arr_h = 0
        forge alen = 0
        forge vsym = 0
        forge k = 0
        forge vi = 0
        forge st = EXEC_OK
        push_scope()
        eval_expr(nc0(id))
        if (_rk == VAL_ARRAY) {
            arr_h = _rr
            alen = interp_array_len(arr_h)
            vsym = node_sym(id)
            r_int(0)
            declare_var(vsym)
            while (k < alen) {
                interp_array_get(arr_h, k)
                vi = find_var(vsym)
                if (vi >= 0) { env_assign(vi) }
                st = execute_stmt(nc1(id))
                if (st == EXEC_RETURN || st == EXEC_THROW) { pop_scope(); return st }
                if (st == EXEC_BREAK) { break }
                k++
            }
        }
        pop_scope()
        return EXEC_OK
    }

    vein exec_anchor(id: stone) -> stone {
        forge action = nc0(id)
        if (action >= 0) {
            ofs_array_push(_anchor_nodes, action)
            ofs_array_push(_anchor_depths, _scope_depth)
        }
        return EXEC_OK
    }

    vein exec_match(id: stone) -> stone {
        eval_expr(nc0(id))
        forge sk = _rk
        forge stt: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        forge i = 0
        forge case_id = 0
        forge ck = 0
        while (i < nx_len(id)) {
            case_id = nx_at(id, i)
            ck = nk(case_id)
            if (ck == NK_DEFAULT) {
                return execute_stmt(nc0(case_id))
            }
            if (ck == NK_CASE) {
                eval_expr(nc0(case_id))
                if (val_equals_regs(sk, stt, si, sf, sb, ss, sr)) {
                    return execute_stmt(nc1(case_id))
                }
            }
            i++
        }
        return EXEC_OK
    }

    vein exec_throw(id: stone) -> stone {
        forge texpr = nc0(id)
        if (texpr >= 0) {
            eval_expr(texpr)
            set_return_from_regs()
            echo("Runtime throw: " + r_to_string())
        } else {
            r_void()
            set_return_from_regs()
            echo("Runtime throw")
        }
        exit(1)
        return EXEC_THROW
    }

    // ── Declarations Collection ───────────────────────────────────────────

    vein collect_declarations(root_id: stone) -> void {
        forge len = nx_len(root_id)
        forge i = 0
        while (i < len) {
            forge child_id = nx_at(root_id, i)
            forge ck = nk(child_id)
            forge cval: obsidian = nval(child_id)

            if (ck == NK_FN_DECL || ck == NK_CORE_DECL) {
                if (ck == NK_FN_DECL && ffi_runtime_native(child_id, cval)) {
                    register_extern(cval, child_id, cval)
                } else {
                    register_function(cval, child_id)
                }
            }

            if (ck == NK_EXTERN_VN || ck == NK_RIFT_VN) {
                register_extern(cval, child_id, "")
            }

            if (ck == NK_MONOLITH && register_monolith(cval)) {
                forge num_fields = nx_len(child_id)
                forge fi = 0
                while (fi < num_fields) {
                    forge f_id = nx_at(child_id, fi)
                    forge ft_str = "stone"
                    if (nc0(f_id) >= 0) {
                        ft_str = type_node_str(nc0(f_id))
                    }
                    register_monolith_field(cval, nval(f_id), ft_str)
                    fi++
                }
            }

            if (ck == NK_IMPL) {
                forge mono_name = cval
                forge num_methods = nx_len(child_id)
                forge mi = 0
                while (mi < num_methods) {
                    forge m_id = nx_at(child_id, mi)
                    forge mname: obsidian = nval(m_id)
                    register_function(mname, m_id)
                    register_function(mono_name + "__" + mname, m_id)
                    mi++
                }
            }

            if (ck == NK_NAMESPACE) {
                forge ns_name = cval
                forge num_ns_children = nx_len(child_id)
                forge nsi = 0
                while (nsi < num_ns_children) {
                    forge nc_id = nx_at(child_id, nsi)
                    forge nck = nk(nc_id)
                    if (nck == NK_FN_DECL || nck == NK_CORE_DECL) {
                        forge ncname: obsidian = nval(nc_id)
                        // o parser ja da o nome `ns__f` as veins do namespace
                        forge ncmangled = ns_name + "__" + ncname
                        forge nspre = ns_name + "__"
                        if (ofs_str_eq(ofs_str_substr(ncname, 0, ofs_str_len(nspre)), nspre)) { ncmangled = ncname }
                        if (nck == NK_FN_DECL && ffi_runtime_native(nc_id, ncmangled)) {
                            register_extern(ncname, nc_id, ncmangled)
                            register_extern(ncmangled, nc_id, ncmangled)
                        } else {
                            register_function(ncname, nc_id)
                            register_function(ncmangled, nc_id)
                        }
                    }
                    if (nck == NK_EXTERN_VN || nck == NK_RIFT_VN) {
                        forge nename: obsidian = nval(nc_id)
                        register_extern(nename, nc_id, "")
                        register_extern(ns_name + "__" + nename, nc_id, "")
                    }
                    nsi++
                }
            }

            i++
        }
    }

    // variantes e tipos strata em ordem de declaracao
    vein collect_strata() -> void {
        forge i = 0
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_VARIANT) {
                forge vn: obsidian = ofs_array_get(_nval, i)
                ofs_array_push(_variant_names, vn)
            } else if (k == NK_STRATA) {
                forge sn: obsidian = ofs_array_get(_nval, i)
                ofs_array_push(_strata_names, sn)
            }
            i++
        }
    }

    vein variant_name_at(v: stone) -> obsidian {
        if (v < 0 || v >= ofs_array_len(_variant_names)) { return "" }
        forge nm: obsidian = ofs_array_get(_variant_names, v)
        return nm
    }

    // tipo estatico concreto (o typeck deu um tipo)?
    vein static_known(t: obsidian) -> bool {
        if (ofs_str_len(t) == 0) { return false }
        return !(ofs_str_eq(t, "unknown") || ofs_str_eq(t, "null") || ofs_str_eq(t, "void"))
    }

    // Decisoes de tipo pre-calculadas por no (a partir dos tipos do typeck,
    // os mesmos que o llvmgen usa):
    //   `*p`        _naux = classe do tipo apontado + 1 (0 = usar o valor)
    //   NK_CAST     _naux = classe do destino; _nop = classe da origem + 1
    //   forge/param _nop  = classe estreita (iN/uN/f32) para coerce_regs
    //   `x = v`     _naux = idem, para o tipo de x
    vein annotate_nodes() -> void {
        annotate_nodes_from(0)
    }

    vein annotate_nodes_from(start: stone) -> void {
        forge i = start
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_UNARY_OP) {
                forge uop: stone = ofs_array_get(_nop, i)
                if (uop == OP_DEREF) {
                    forge ot = ntype(nc0(i))
                    if (ofs_str_len(ot) > 1 && ofs_str_char_at(ot, 0) == 42) {
                        ofs_array_set(_naux, i, mem_class(ntype(i)) + 1)
                    }
                }
            } else if (k == NK_CAST) {
                ofs_array_set(_naux, i, mem_class(nval(i)))
                forge st = ntype(nc0(i))
                forge sc = 0
                if (static_known(st)) { sc = mem_class(st) + 1 }
                ofs_array_set(_nop, i, sc)
            } else if (k == NK_BLOCK) {
                if (ofs_str_eq(ntype(i), "arena")) { ofs_array_set(_naux, i, 1) }
            } else if (k == NK_VAR_DECL || k == NK_CONST_DECL) {
                ofs_array_set(_nop, i, coerce_code(ntype(i)))
            } else if (k == NK_PARAM) {
                forge pt = ""
                if (nc0(i) >= 0) { pt = type_node_str(nc0(i)) }
                ofs_array_set(_nop, i, coerce_code(pt))
            } else if (k == NK_ASSIGN || k == NK_BIN_OP) {
                forge aop: stone = ofs_array_get(_nop, i)
                if ((k == NK_ASSIGN || (aop >= OP_ASSIGN && aop <= OP_MOD_ASSIGN)) && nk(nc0(i)) == NK_IDENT) {
                    ofs_array_set(_naux, i, coerce_code(ntype(nc0(i))))
                }
            }
            i++
        }
    }

    // ── Fault Refract (L0/L1) ─────────────────────────────────────────────
    // Fluxo (entre chamadas, em call_function_by_id -> rf_tick):
    //   1. a cada OFS_REFRACT_PERIOD ms (200), le os arquivos observados e
    //      compara o hash do conteudo; muda e fica estavel por um periodo ->
    //   2. refract_reload (ofscc.ofs) relexa, reparseia e checa (typeck) o
    //      programa inteiro no proprio processo (stdout do compilador vai
    //      para o stderr); erro = a versao em execucao continua;
    //   3. diff por vein (hash estrutural da arvore tipada), regras de
    //      seguranca (assinatura em uso, layout com instancias, remocao em
    //      uso, tipo de global, extern, ordem das variantes);
    //   4. troca: a celula de despacho da versao antiga aponta para a nova;
    //      um laco em execucao troca no proximo cabecalho (OSR, onda 4), o
    //      resto termina na antiga; globais novos ganham um slot reservado
    //      com o valor inicial; monolith com instancias migra no lugar;
    //   5. L1: raizes nativas que mudaram (ou que chamam o que mudou) vao
    //      para um .so novo em segundo plano; ate la rodam interpretadas.

    vein rf_enable(path: obsidian, files: Array<obsidian>) -> void {
        _rf_on = true
        _osr_on = true
        _rf_path = path
        _rf_files = files
        _rf_quiet = ofs_str_eq(hy_env_or("OFS_REFRACT_QUIET", ""), "1")
        forge per = hy_env_or("OFS_REFRACT_PERIOD", "200")
        forge parsed = 0
        forge ok = ofs_str_len(per) > 0 && ofs_str_len(per) < 7
        forge i = 0
        while (ok && i < ofs_str_len(per)) {
            forge c = ofs_str_char_at(per, i)
            if (c < 48 || c > 57) { ok = false }
            else { parsed = parsed * 10 + c - 48 }
            i++
        }
        if (ok && parsed >= 10 && parsed <= 60000) { _rf_period = parsed }
        else { rf_note("OFS_REFRACT_PERIOD precisa ser um inteiro de 10 a 60000 (ms); usando 200") }
    }

    vein rf_note(msg: obsidian) -> void {
        ffi_stderr("ofs refract: " + msg + "\n")
    }

    vein rf_info(msg: obsidian) -> void {
        if (!_rf_quiet) { rf_note(msg) }
    }

    vein rf_join(list: Array<obsidian>) -> obsidian {
        forge out = ""
        forge i = 0
        while (i < ofs_array_len(list)) {
            forge s: obsidian = ofs_array_get(list, i)
            if (i > 0) { out = out + ", " }
            out = out + vein_display_name(s)
            i++
        }
        return out
    }

    vein rf_plural(n: stone, one: obsidian, many: obsidian) -> obsidian {
        if (n == 1) { return "1 " + one }
        return ofs_stone_to_obsidian(n) + " " + many
    }

    vein rf_note_list(what: obsidian, names: Array<obsidian>) -> void {
        if (ofs_array_len(names) == 0) { return }
        rf_info(rf_join(names) + ": " + what)
    }

    vein rf_has_name(list: Array<obsidian>, v: obsidian) -> bool {
        forge i = 0
        while (i < ofs_array_len(list)) {
            forge s: obsidian = ofs_array_get(list, i)
            if (ofs_str_eq(s, v)) { return true }
            i++
        }
        return false
    }

    vein rf_has_id(list: Array<stone>, v: stone) -> bool {
        forge i = 0
        while (i < ofs_array_len(list)) {
            forge s: stone = ofs_array_get(list, i)
            if (s == v) { return true }
            i++
        }
        return false
    }

    vein rf_mark_dirty(names: Array<obsidian>) -> void {
        forge i = 0
        while (i < ofs_array_len(names)) {
            forge s: obsidian = ofs_array_get(names, i)
            if (!rf_has_name(_rf_dirty, s)) { ofs_array_push(_rf_dirty, s) }
            i++
        }
    }

    // ── tempo, saida e leitura (resolvidos por dlsym, como o hy_mkdtemp) ──

    abyss vein rf_now_ms() -> stone {
        if (_rf_clock != 0) {
            forge clk = 1
            if (_ffi_macos) { clk = 6 }
            fault_call(_rf_clock, clk, _rf_tbuf)
            return mem_rd(_rf_tbuf, MC_I64) * 1000 + mem_rd(_rf_tbuf + 8, MC_I64) / 1000000
        }
        if (_rf_time != 0) { return fault_call(_rf_time, 0) * 1000 }
        return 0
    }

    abyss vein rf_flush() -> void {
        if (_rf_fflush != 0) { fault_call(_rf_fflush, 0) }
    }

    // o compilador escreve diagnosticos no stdout; durante a recompilacao o
    // stdout aponta para o stderr (o stdout continua sendo do programa)
    abyss vein rf_stdout_to_stderr() -> stone {
        rf_flush()
        forge dupf = dlsym(ffi_rtld_default(), "dup")
        forge dup2f = dlsym(ffi_rtld_default(), "dup2")
        if (dupf == 0 || dup2f == 0) { return -1 }
        forge saved = fault_call(dupf, 1) & 4294967295
        if (saved == 4294967295) { return -1 }
        fault_call(dup2f, 2, 1)
        return saved
    }

    // como acima, mas para um arquivo (diagnostico guardado da lava)
    abyss vein rf_stdout_to_file(path: obsidian) -> stone {
        rf_flush()
        forge dupf = dlsym(ffi_rtld_default(), "dup")
        forge dup2f = dlsym(ffi_rtld_default(), "dup2")
        forge filenof = dlsym(ffi_rtld_default(), "fileno")
        if (filenof == 0) { filenof = dlsym(ffi_rtld_default(), "_fileno") }
        if (dupf == 0 || dup2f == 0 || filenof == 0) { return rf_stdout_to_stderr() }
        forge f = fopen(path, "wb")
        if (f == null) { return rf_stdout_to_stderr() }
        forge saved = fault_call(dupf, 1) & 4294967295
        if (saved == 4294967295) { fclose(f); return -1 }
        fault_call(dup2f, fault_call(filenof, f as stone) & 4294967295, 1)
        fclose(f)
        return saved
    }

    abyss vein rf_stdout_restore(saved: stone) -> void {
        rf_flush()
        if (saved < 0) { return }
        forge dup2f = dlsym(ffi_rtld_default(), "dup2")
        forge closef = dlsym(ffi_rtld_default(), "close")
        if (dup2f != 0) { fault_call(dup2f, saved, 1) }
        if (closef != 0) { fault_call(closef, saved) }
    }

    // hash do conteudo; arquivo ausente (salvamento atomico em curso) = sem
    // mudanca por enquanto
    vein rf_file_hash(path: obsidian, basis: stone) -> stone {
        return rf_file_hash_as(path, path, basis)
    }

    // hash do conteudo de `path` com o nome `key` (a lava de um arquivo com
    // o mesmo conteudo do disco da o mesmo hash: apagar o rascunho depois de
    // salvar nao recompila)
    vein rf_file_hash_as(path: obsidian, key: obsidian, basis: stone) -> stone {
        forge f = fopen(path, "rb")
        if (f == null) { return 0 }
        fseek(f, 0, 2)
        forge size = ftell(f)
        fseek(f, 0, 0)
        if (size < 0) { fclose(f); return 0 }
        forge buf = ofs_alloc(size + 1)
        fread(buf, 1, size, f)
        fclose(f)
        forge h = hy_fnv(buf, basis)
        ofs_free(buf)
        h = hy_fnv(key, h ^ size)
        if (h == 0) { h = 1 }
        return h
    }

    // assinatura dos arquivos observados. Para cada um, vale quem mudou por
    // ultimo: o disco (salvou) ou a lava (o editor gravou o rascunho); a lava
    // apagada (salvou, fechou, desfez tudo) devolve o arquivo ao disco. O
    // mapa da lava (lava_add, ofscc.ofs) diz ao refract_reload o que ler.
    vein rf_files_sig() -> stone {
        forge basis = 1469598103934665603
        forge h = basis
        forge live = false
        lava_reset()
        forge i = 0
        while (i < ofs_array_len(_rf_files)) {
            forge p: obsidian = ofs_array_get(_rf_files, i)
            forge dh = rf_file_hash(p, basis)
            forge lh = 0
            forge lp = ""
            if (i < ofs_array_len(_rf_lp)) {
                lp = ofs_array_get(_rf_lp, i)
                if (ofs_str_len(lp) > 0) { lh = rf_file_hash_as(lp, p, basis) }
            }
            forge win = false
            if (i >= ofs_array_len(_rf_dh)) {
                // primeiro olhar: rascunho que ja existia e velho (so vale se mudar)
                ofs_array_push(_rf_dh, dh)
                ofs_array_push(_rf_lh, lh)
                ofs_array_push(_rf_lw, false)
            } else {
                win = ofs_array_get(_rf_lw, i)
                forge od: stone = ofs_array_get(_rf_dh, i)
                forge ol: stone = ofs_array_get(_rf_lh, i)
                if (dh != 0 && dh != od) {
                    win = false
                    ofs_array_set(_rf_dh, i, dh)
                }
                if (lh != ol) {
                    win = lh != 0
                    ofs_array_set(_rf_lh, i, lh)
                }
                ofs_array_set(_rf_lw, i, win)
            }
            forge fh = dh
            if (win) {
                fh = lh
                live = true
                lava_add(p, lp)
            }
            if (fh == 0) { return _rf_sig }
            h = hy_fnv(ofs_stone_to_obsidian(fh), h)
            i++
        }
        _rf_lava_live = live
        return h
    }

    // ── lava: pasta do rascunho do editor ─────────────────────────────────
    // POSIX: ${XDG_RUNTIME_DIR:-/tmp}/ofs-refract-<uid>; Windows:
    // %TEMP%/ofs-refract. Dentro: lava/<caminho absoluto sem a 1a barra>
    // (no Windows "C:\a\b.ofs" -> lava/C/a/b.ofs) e pulse/<pid>, um por
    // refract viva; a extensao do VS Code so grava a lava se houver pulse de
    // um processo vivo. OFS_REFRACT_DRAFT=0 desliga.
    abyss vein rf_lava_init() -> void {
        if (ofs_str_eq(hy_env_or("OFS_REFRACT_DRAFT", "1"), "0")) { return }
        forge root = ""
        forge uidf = dlsym(ffi_rtld_default(), "getuid")
        if (uidf != 0) {
            root = hy_env_or("XDG_RUNTIME_DIR", "/tmp") + "/ofs-refract-" + ofs_stone_to_obsidian(fault_call(uidf, 0) & 4294967295)
            // so uma pasta 0700 do proprio usuario (em /tmp, outro usuario
            // poderia te-la criado antes)
            forge q = hy_q(root)
            forge cmd = "mkdir -m 700 " + q + " 2>/dev/null; [ -d " + q + " ] && [ ! -L " + q + " ] && [ -O " + q + " ] && chmod 700 " + q + " && mkdir -p " + hy_q(root + "/lava") + " " + hy_q(root + "/pulse") +
                " && { for p in " + hy_q(root + "/pulse") + "/*; do n=${p##*/}; n=${n%.eco}; kill -0 \"$n\" 2>/dev/null || rm -f \"$p\"; done; true; }"
            if ((system(cmd) & 4294967295) != 0) {
                rf_note("lava desligada: " + root + " nao e uma pasta sua (0700); edicoes sem salvar nao entram")
                return
            }
        } else {
            forge tmp = hy_env_or("TEMP", hy_env_or("TMP", ""))
            if (ofs_str_len(tmp) == 0) { return }
            root = rf_slashes(tmp) + "/ofs-refract"
            forge mk = dlsym(ffi_rtld_default(), "_mkdir")
            if (mk == 0) { return }
            fault_call(mk, root as stone)
            forge lroot = root + "/lava"
            fault_call(mk, lroot as stone)
            forge proot = root + "/pulse"
            fault_call(mk, proot as stone)
        }
        _rf_lava_root = root
        forge pid = ofs_stone_to_obsidian(getpid())
        _rf_lava_pulse = root + "/pulse/" + pid
        _rf_lava_eco = root + "/pulse/" + pid + ".eco"
        forge f = fopen(_rf_lava_pulse, "wb")
        if (f != null) { fclose(f) }
        forge cwd = rf_cwd()
        forge i = 0
        while (i < ofs_array_len(_rf_files)) {
            ofs_array_push(_rf_lp, rf_lava_of(ofs_array_get(_rf_files, i), cwd))
            i++
        }
    }

    vein rf_slashes(p: obsidian) -> obsidian {
        forge out = ""
        forge start = 0
        forge i = 0
        while (i < ofs_str_len(p)) {
            if (ofs_str_char_at(p, i) == 92) {
                out = out + ofs_str_substr(p, start, i - start) + "/"
                start = i + 1
            }
            i++
        }
        return out + ofs_str_substr(p, start, ofs_str_len(p) - start)
    }

    abyss vein rf_cwd() -> obsidian {
        forge g = dlsym(ffi_rtld_default(), "getcwd")
        if (g == 0) { g = dlsym(ffi_rtld_default(), "_getcwd") }
        if (g != 0) {
            forge buf = ofs_alloc(4097) as stone
            forge r = fault_call(g, buf, 4096)
            if (r != 0) { return rf_slashes(r as obsidian) }
        }
        return rf_slashes(hy_env_or("PWD", "."))
    }

    // caminho da lava de um arquivo observado
    vein rf_lava_of(path: obsidian, cwd: obsidian) -> obsidian {
        forge a = rf_slashes(path)
        forge n = ofs_str_len(a)
        if (n >= 2 && ofs_str_char_at(a, 1) == 58) {
            a = ofs_str_substr(a, 0, 1) + ofs_str_substr(a, 2, n - 2)
        } else if (n == 0 || ofs_str_char_at(a, 0) != 47) {
            a = cwd + "/" + a
            if (ofs_str_len(cwd) >= 2 && ofs_str_char_at(cwd, 1) == 58) {
                a = ofs_str_substr(a, 0, 1) + ofs_str_substr(a, 2, ofs_str_len(a) - 2)
            }
        }
        a = normalize_path(a)
        while (ofs_str_len(a) > 0 && ofs_str_char_at(a, 0) == 47) { a = ofs_str_substr(a, 1, ofs_str_len(a) - 1) }
        return _rf_lava_root + "/lava/" + a
    }

    // fim do `ofs refract`: o pulse sai (a extensao para de gravar a lava)
    vein rf_finish() -> void {
        if (ofs_str_len(_rf_lava_pulse) > 0) {
            remove(_rf_lava_pulse)
            remove(_rf_lava_eco)
            _rf_lava_pulse = ""
        }
    }

    // ── tabelas por no ────────────────────────────────────────────────────

    vein rf_extend() -> void {
        while (ofs_array_len(_rf_cell) < _n_count) {
            ofs_array_push(_rf_cell, -1)
            ofs_array_push(_rf_active, 0)
        }
        while (ofs_array_len(_cr_heat) < _n_count) {
            ofs_array_push(_cr_heat, 0)
            ofs_array_push(_cr_eligible, false)
            ofs_array_push(_cr_quartz, false)
        }
    }

    vein rf_live_fid(fid: stone) -> stone {
        if (fid < 0 || fid >= ofs_array_len(_rf_cell)) { return fid }
        forge c: stone = ofs_array_get(_rf_cell, fid)
        if (c >= 0) { return c }
        return fid
    }

    vein rf_frame(fid: stone, d: stone) -> void {
        forge a: stone = ofs_array_get(_rf_active, fid)
        ofs_array_set(_rf_active, fid, a + d)
    }

    vein rf_is_active(fid: stone) -> bool {
        if (fid < 0 || fid >= ofs_array_len(_rf_active)) { return false }
        forge a: stone = ofs_array_get(_rf_active, fid)
        return a > 0
    }

    vein rf_count_instance(mi: stone) -> void {
        while (ofs_array_len(_rf_mono_live) <= mi) { ofs_array_push(_rf_mono_live, 0) }
        forge c: stone = ofs_array_get(_rf_mono_live, mi)
        ofs_array_set(_rf_mono_live, mi, c + 1)
    }

    vein rf_instances(mi: stone) -> stone {
        if (mi < 0 || mi >= ofs_array_len(_rf_mono_live)) { return 0 }
        forge c: stone = ofs_array_get(_rf_mono_live, mi)
        return c
    }

    // a celula da versao `from` (e quem ja apontava para ela) vai para `to`
    vein rf_redirect(from: stone, to: stone) -> void {
        forge i = 0
        forge n = ofs_array_len(_rf_cell)
        while (i < n) {
            forge c: stone = ofs_array_get(_rf_cell, i)
            if (c == from) { ofs_array_set(_rf_cell, i, to) }
            i++
        }
        ofs_array_set(_rf_cell, from, to)
        ofs_array_set(_rf_cell, to, -1)
    }

    // ── varredura de um programa (espelha collect_declarations) ──────────

    vein rf_scan_vein(key: obsidian, fid: stone, regs: Array<obsidian>) -> void {
        // veins do runtime (stdlib/runtime) nao sao observadas
        if (ast_line_is_runtime(node_line_of(fid))) { return }
        ofs_array_push(_rs_vkey, key)
        ofs_array_push(_rs_vfid, fid)
        ofs_array_push(_rs_vregs, regs)
    }

    vein rf_scan_extern(key: obsidian, node: stone, regs: Array<obsidian>) -> void {
        ofs_array_push(_rs_ekey, key)
        ofs_array_push(_rs_enode, node)
        ofs_array_push(_rs_eregs, regs)
    }

    vein rf_scan(root_id: stone) -> void {
        _rs_vkey = []
        _rs_vfid = []
        _rs_vregs = []
        _rs_gkey = []
        _rs_gnode = []
        _rs_mkey = []
        _rs_mnode = []
        _rs_ekey = []
        _rs_enode = []
        _rs_eregs = []
        forge len = nx_len(root_id)
        forge i = 0
        while (i < len) {
            forge child_id = nx_at(root_id, i)
            forge ck = nk(child_id)
            forge cval: obsidian = nval(child_id)
            if (ck == NK_FN_DECL || ck == NK_CORE_DECL) {
                forge r1: Array<obsidian> = []
                ofs_array_push(r1, cval)
                rf_scan_vein(cval, child_id, r1)
            } else if (ck == NK_EXTERN_VN || ck == NK_RIFT_VN) {
                forge r2: Array<obsidian> = []
                ofs_array_push(r2, cval)
                rf_scan_extern(cval, child_id, r2)
            } else if (ck == NK_MONOLITH) {
                ofs_array_push(_rs_mkey, cval)
                ofs_array_push(_rs_mnode, child_id)
            } else if (ck == NK_VAR_DECL || ck == NK_CONST_DECL) {
                ofs_array_push(_rs_gkey, cval)
                ofs_array_push(_rs_gnode, child_id)
            } else if (ck == NK_IMPL) {
                forge mi = 0
                while (mi < nx_len(child_id)) {
                    forge m_id = nx_at(child_id, mi)
                    forge mname: obsidian = nval(m_id)
                    forge r3: Array<obsidian> = []
                    ofs_array_push(r3, mname)
                    ofs_array_push(r3, cval + "__" + mname)
                    // o parser ja pode ter dado o nome `T__m` ao metodo
                    forge mkey = cval + "__" + mname
                    forge mpre = cval + "__"
                    if (ofs_str_eq(ofs_str_substr(mname, 0, ofs_str_len(mpre)), mpre)) { mkey = mname }
                    rf_scan_vein(mkey, m_id, r3)
                    mi++
                }
            } else if (ck == NK_NAMESPACE) {
                forge nsi = 0
                while (nsi < nx_len(child_id)) {
                    forge nc_id = nx_at(child_id, nsi)
                    forge nck = nk(nc_id)
                    forge ncname: obsidian = nval(nc_id)
                    if (nck == NK_FN_DECL || nck == NK_CORE_DECL) {
                        forge ncmangled = cval + "__" + ncname
                        forge nspre = cval + "__"
                        if (ofs_str_eq(ofs_str_substr(ncname, 0, ofs_str_len(nspre)), nspre)) { ncmangled = ncname }
                        forge r4: Array<obsidian> = []
                        ofs_array_push(r4, ncname)
                        ofs_array_push(r4, ncmangled)
                        rf_scan_vein(ncmangled, nc_id, r4)
                    } else if (nck == NK_EXTERN_VN || nck == NK_RIFT_VN) {
                        forge r5: Array<obsidian> = []
                        ofs_array_push(r5, ncname)
                        ofs_array_push(r5, cval + "__" + ncname)
                        rf_scan_extern(cval + "__" + ncname, nc_id, r5)
                    } else if (nck == NK_VAR_DECL || nck == NK_CONST_DECL) {
                        ofs_array_push(_rs_gkey, ncname)
                        ofs_array_push(_rs_gnode, nc_id)
                    }
                    nsi++
                }
            }
            i++
        }
    }

    // hash estrutural da arvore tipada (tipo, texto e tipo final de cada no)
    vein rf_hash(id: stone, h0: stone) -> stone {
        if (id < 0) { return (h0 ^ 977) * 1099511628211 }
        forge h = (h0 ^ (nk(id) + 1)) * 1099511628211
        h = hy_fnv(nval(id), h)
        h = hy_fnv(ntype(id), (h ^ 31) * 1099511628211)
        h = rf_hash(nc0(id), h)
        h = rf_hash(nc1(id), h)
        h = rf_hash(nc2(id), h)
        h = rf_hash(nc3(id), h)
        forge n = nx_len(id)
        h = (h ^ (n + 4099)) * 1099511628211
        forge i = 0
        while (i < n) {
            h = rf_hash(nx_at(id, i), h)
            i++
        }
        return h
    }

    // tipo de um no para a refract: o tipo apagado e, se veio de um
    // `mineral`, a regra dele (mudar a grain de um tipo usado e mudar o tipo)
    vein rf_tstr(tid: stone) -> obsidian {
        forge t = type_node_str(tid)
        forge note = contracts.type_note(tid)
        if (ofs_str_len(note) > 0) { return t + "{" + note + "}" }
        if (tid >= 0 && nk(tid) == NK_TYPE_ARRAY) {
            forge inote = contracts.type_note(nc0(tid))
            if (ofs_str_len(inote) > 0) { return t + "{" + inote + "}" }
        }
        return t
    }

    // tipo de um global para a refract (com a grain, se for de mineral)
    vein rf_gtype(gn: stone) -> obsidian {
        forge note = contracts.type_note(nc0(gn))
        if (ofs_str_len(note) > 0) { return ntype(gn) + "{" + note + "}" }
        return ntype(gn)
    }

    // assinatura de vein/extern: "(T1,T2)->R"
    vein rf_sig(fid: stone) -> obsidian {
        forge params = nc0(fid)
        forge np = nx_len(params)
        forge out = "("
        forge j = 0
        while (j < np) {
            forge pid = nx_at(params, j)
            forge pt = "stone"
            if (nc0(pid) >= 0) { pt = rf_tstr(nc0(pid)) }
            if (j > 0) { out = out + "," }
            out = out + pt
            j++
        }
        forge rt = "void"
        if (nc1(fid) >= 0) { rt = rf_tstr(nc1(fid)) }
        return out + ")->" + rt
    }

    vein rf_mshape(node: stone) -> obsidian {
        forge out = ""
        forge fi = 0
        while (fi < nx_len(node)) {
            forge f_id = nx_at(node, fi)
            forge ft = "stone"
            if (nc0(f_id) >= 0) { ft = rf_tstr(nc0(f_id)) }
            out = out + nval(f_id) + ":" + ft + ";"
            fi++
        }
        return out
    }

    vein rf_eshape(node: stone) -> obsidian {
        return rf_sig(node) + "|" + ntype(node) + "|" + ofs_stone_to_obsidian(nk(node))
    }

    vein rf_index(list: Array<obsidian>, key: obsidian) -> stone {
        forge i = ofs_array_len(list) - 1
        while (i >= 0) {
            forge s: obsidian = ofs_array_get(list, i)
            if (ofs_str_eq(s, key)) { return i }
            i--
        }
        return -1
    }

    // registro inicial (programa que comecou a rodar)
    vein rf_start(root_id: stone) -> void {
        ffi_init()
        _rf_clock = dlsym(ffi_rtld_default(), "clock_gettime")
        _rf_time = dlsym(ffi_rtld_default(), "time")
        _rf_fflush = dlsym(ffi_rtld_default(), "fflush")
        _rf_tbuf = ofs_alloc(16) as stone
        _rf_root = root_id
        rf_extend()
        // slots reservados para globais novos: ficam dentro de
        // [0, _globals_count), onde find_var procura os globais
        _rf_gslot = ofs_array_len(_env_sym)
        forge k = 0
        while (k < RF_GLOBAL_SLOTS) {
            r_void()
            declare_var_noclone(-2)
            k++
        }
        _rf_gslot_end = ofs_array_len(_env_sym)
        rf_scan(root_id)
        forge i = 0
        while (i < ofs_array_len(_rs_vkey)) {
            forge fid: stone = ofs_array_get(_rs_vfid, i)
            ofs_array_push(_rf_vkey, ofs_array_get(_rs_vkey, i))
            ofs_array_push(_rf_vfid, fid)
            ofs_array_push(_rf_vhash, rf_hash(fid, 1469598103934665603))
            ofs_array_push(_rf_vsig, rf_sig(fid))
            ofs_array_push(_rf_vgone, false)
            i++
        }
        i = 0
        while (i < ofs_array_len(_rs_gkey)) {
            forge gn: stone = ofs_array_get(_rs_gnode, i)
            ofs_array_push(_rf_gkey, ofs_array_get(_rs_gkey, i))
            ofs_array_push(_rf_gtype, rf_gtype(gn))
            i++
        }
        i = 0
        while (i < ofs_array_len(_rs_mkey)) {
            forge mn: stone = ofs_array_get(_rs_mnode, i)
            ofs_array_push(_rf_mkey, ofs_array_get(_rs_mkey, i))
            ofs_array_push(_rf_mshape, rf_mshape(mn))
            i++
        }
        i = 0
        while (i < ofs_array_len(_rs_ekey)) {
            forge en: stone = ofs_array_get(_rs_enode, i)
            ofs_array_push(_rf_ekey, ofs_array_get(_rs_ekey, i))
            ofs_array_push(_rf_eshape, rf_eshape(en))
            i++
        }
        rf_lava_init()
        _rf_sig = rf_files_sig()
        _rf_seen = _rf_sig
        _rf_next = rf_now_ms() + _rf_period
        forge extra = ofs_array_len(_rf_files) - 1
        forge what = _rf_path
        if (extra > 0) { what = what + " (+" + rf_plural(extra, "attach local", "attach locais") + ")" }
        if (ofs_str_len(_rf_lava_root) > 0) { rf_info("observando " + what + "; salve (ou so edite, no VS Code) para refratar") }
        else { rf_info("observando " + what + "; salve para refratar") }
    }

    // chamado no comeco de toda chamada de vein (entre chamadas)
    vein rf_tick() -> void {
        if (_rf_busy || _hy_depth > 0) { return }
        forge now = rf_now_ms()
        if (now < _rf_next) { return }
        _rf_next = now + _rf_period
        _rf_busy = true
        // saida ao vivo mesmo com o stdout num arquivo/pipe
        rf_flush()
        cr_poll_job()
        if (!_cr_pending && ofs_array_len(_rf_dirty) > 0) { rf_launch() }
        forge sig = rf_files_sig()
        if (sig != _rf_sig) {
            // so recompila depois de um periodo com o mesmo conteudo (o
            // editor pode estar no meio da gravacao)
            if (sig == _rf_seen) {
                _rf_sig = sig
                forge sk = _rk
                forge st: obsidian = _rt
                forge si = _ri
                forge sf: crystal = _rf
                forge sb = _rb
                forge ss: obsidian = _rs
                forge sr = _rr
                forge scall = _cur_call_id
                rf_refract()
                r_set(sk, st, si, sf, sb, ss, sr)
                _cur_call_id = scall
                _rf_next = rf_now_ms() + _rf_period
            } else {
                _rf_seen = sig
            }
        } else if (_rf_err_wait && sig == _rf_err_sig && now - _rf_err_at >= RF_LAVA_QUIET_MS) {
            // a lava ficou parada com erro: agora sim, mostra (uma vez)
            _rf_err_wait = false
            if (!ofs_str_eq(_rf_err_text, _rf_err_shown)) {
                _rf_err_shown = _rf_err_text
                ffi_stderr(_rf_err_text)
                rf_note("erro de compilacao no rascunho do editor (acima); a versao em execucao continua")
            }
        }
        // laco nativo volta a entrar depois que a edicao foi tratada
        _osr_hold = sig != _rf_sig
        _rf_busy = false
    }

    // veins vivas chamadas/usadas pelo corpo id (fids vivos em out)
    vein rf_walk_calls(id: stone, out: Array<stone>) -> void {
        if (id < 0) { return }
        forge k = nk(id)
        if (k == NK_CALL) {
            forge ck = nop(id)
            if (ck == CALL_FN) {
                forge t = rf_live_fid(naux(id))
                if (!rf_has_id(out, t)) { ofs_array_push(out, t) }
            } else if (ck == CALL_DYN) {
                forge di = naux(id)
                if (di >= 0 && di < ofs_array_len(_dyn_method)) {
                    forge m: obsidian = ofs_array_get(_dyn_method, di)
                    forge ml = ofs_str_len(m)
                    if (ml > 0) {
                        forge vi = 0
                        while (vi < ofs_array_len(_rf_vkey)) {
                            forge key: obsidian = ofs_array_get(_rf_vkey, vi)
                            forge kl = ofs_str_len(key)
                            if (kl > ml + 2 && ofs_str_eq(ofs_str_substr(key, kl - ml - 2, ml + 2), "__" + m)) {
                                forge mf: stone = ofs_array_get(_rf_vfid, vi)
                                if (!rf_has_id(out, mf)) { ofs_array_push(out, mf) }
                            }
                            vi++
                        }
                    }
                }
            }
        } else if (k == NK_IDENT) {
            forge a = naux(id)
            if (a > 0 && vein_type_is(ntype(id))) {
                forge vf = rf_live_fid(a - 1)
                if (!rf_has_id(out, vf)) { ofs_array_push(out, vf) }
            }
        }
        rf_walk_calls(nc0(id), out)
        rf_walk_calls(nc1(id), out)
        rf_walk_calls(nc2(id), out)
        rf_walk_calls(nc3(id), out)
        forge i = 0
        forge n = nx_len(id)
        while (i < n) {
            rf_walk_calls(nx_at(id, i), out)
            i++
        }
    }

    // `id` usa a vein viva `target` como valor (NK_IDENT de tipo vein)?
    vein rf_value_ref(id: stone, target: stone) -> bool {
        if (id < 0) { return false }
        if (nk(id) == NK_IDENT) {
            forge a = naux(id)
            if (a > 0 && vein_type_is(ntype(id)) && rf_live_fid(a - 1) == target) { return true }
        }
        if (rf_value_ref(nc0(id), target) || rf_value_ref(nc1(id), target) || rf_value_ref(nc2(id), target) || rf_value_ref(nc3(id), target)) { return true }
        forge i = 0
        forge n = nx_len(id)
        while (i < n) {
            if (rf_value_ref(nx_at(id, i), target)) { return true }
            i++
        }
        return false
    }

    vein rf_used_as_value(target: stone) -> bool {
        forge vi = 0
        while (vi < ofs_array_len(_rf_vfid)) {
            forge f: stone = ofs_array_get(_rf_vfid, vi)
            if (rf_value_ref(nc2(f), target)) { return true }
            vi++
        }
        // inicializadores de globais do programa em execucao
        forge i = 0
        while (i < nx_len(_rf_root)) {
            if (rf_value_ref(nx_at(_rf_root, i), target)) { return true }
            i++
        }
        return false
    }

    vein rf_is_callback(target: stone) -> bool {
        forge i = 0
        while (i < ofs_array_len(_cb_fn)) {
            forge f: stone = ofs_array_get(_cb_fn, i)
            if (rf_live_fid(f) == target) { return true }
            i++
        }
        return false
    }

    // alguma vein viva em execucao (na pilha) chama `target`? devolve o nome
    vein rf_active_user(target: stone) -> obsidian {
        forge vi = 0
        while (vi < ofs_array_len(_rf_vfid)) {
            forge f: stone = ofs_array_get(_rf_vfid, vi)
            if (rf_is_active(f)) {
                forge callees: Array<stone> = []
                rf_walk_calls(nc2(f), callees)
                if (rf_has_id(callees, target)) {
                    forge nm: obsidian = ofs_array_get(_rf_vkey, vi)
                    return nm
                }
            }
            vi++
        }
        return ""
    }

    // a raiz nativa fid alcanca (chama, direta ou indiretamente) algum alvo?
    vein rf_reaches(fid: stone, targets: Array<stone>) -> bool {
        forge todo: Array<stone> = []
        forge seen: Array<stone> = []
        ofs_array_push(todo, fid)
        while (ofs_array_len(todo) > 0) {
            forge f: stone = ofs_array_pop(todo)
            if (!rf_has_id(seen, f)) {
                ofs_array_push(seen, f)
                if (f != fid && rf_has_id(targets, f)) { return true }
                forge callees: Array<stone> = []
                rf_walk_calls(nc2(f), callees)
                forge i = 0
                while (i < ofs_array_len(callees)) {
                    forge c: stone = ofs_array_get(callees, i)
                    if (rf_has_id(targets, c)) { return true }
                    ofs_array_push(todo, c)
                    i++
                }
            }
        }
        return false
    }

    // vein do corpo de um geode (__geode_<vein>_<k>)
    vein rf_is_geode_key(key: obsidian) -> bool {
        return ofs_str_len(key) > 8 && ofs_str_eq(ofs_str_substr(key, 0, 8), "__geode_")
    }

    vein rf_key_of(fid: stone) -> obsidian {
        forge vi = ofs_array_len(_rf_vfid) - 1
        while (vi >= 0) {
            forge f: stone = ofs_array_get(_rf_vfid, vi)
            if (f == fid) {
                forge k: obsidian = ofs_array_get(_rf_vkey, vi)
                return k
            }
            vi--
        }
        return ""
    }

    vein rf_reason(acc: obsidian, msg: obsidian) -> obsidian {
        if (ofs_str_len(acc) == 0) { return msg }
        return acc + "; " + msg
    }

    // ── onda 4: assinatura compativel ──
    vein rf_ret_str(fid: stone) -> obsidian {
        if (nc1(fid) >= 0) { return rf_tstr(nc1(fid)) }
        return "void"
    }

    vein rf_is_int_name(t: obsidian) -> bool {
        return ofs_str_eq(t, "i32") || ofs_str_eq(t, "u32") || ofs_str_eq(t, "i16") || ofs_str_eq(t, "u16") || ofs_str_eq(t, "i8") || ofs_str_eq(t, "u8")
    }

    // "" = incompativel; senao o que mudou. Compativel: os parametros antigos
    // iguais e no comeco, os novos no fim com valor padrao; retorno igual,
    // antes void, inteiro estreito onde era stone, ou f32 onde era crystal
    vein rf_sig_compat(of: stone, nf: stone) -> obsidian {
        forge op = nc0(of)
        forge np = nc0(nf)
        forge on = nx_len(op)
        forge nn = nx_len(np)
        if (nn < on) { return "" }
        forge j = 0
        while (j < on) {
            forge ot = "stone"
            forge nt = "stone"
            if (nc0(nx_at(op, j)) >= 0) { ot = rf_tstr(nc0(nx_at(op, j))) }
            if (nc0(nx_at(np, j)) >= 0) { nt = rf_tstr(nc0(nx_at(np, j))) }
            if (!ofs_str_eq(ot, nt)) { return "" }
            j++
        }
        forge added: Array<obsidian> = []
        while (j < nn) {
            forge pid = nx_at(np, j)
            if (nc1(pid) < 0) { return "" }
            ofs_array_push(added, nval(pid))
            j++
        }
        forge desc = ""
        if (ofs_array_len(added) > 0) { desc = rf_plural(ofs_array_len(added), "parametro novo com padrao", "parametros novos com padrao") + ": " + rf_join(added) }
        forge ort = rf_ret_str(of)
        forge nrt = rf_ret_str(nf)
        if (!ofs_str_eq(ort, nrt)) {
            if (ofs_str_eq(ort, "void")) {
                desc = rf_reason(desc, "retorno novo " + nrt + " (a chamada antiga ignora)")
            } else if ((ofs_str_eq(ort, "stone") || ofs_str_eq(ort, "i64")) && rf_is_int_name(nrt)) {
                desc = rf_reason(desc, "retorno " + nrt + " cabe em " + ort)
            } else if ((ofs_str_eq(ort, "crystal") || ofs_str_eq(ort, "f64")) && ofs_str_eq(nrt, "f32")) {
                desc = rf_reason(desc, "retorno f32 cabe em " + ort)
            } else {
                return ""
            }
        }
        return desc
    }

    // ── onda 4: migracao de monolith com instancias vivas ──
    vein rf_num_class(c: stone) -> bool {
        return c == MC_I64 || mc_is_narrow(c) || c == MC_BOOL || c == MC_F64 || c == MC_F32
    }

    // "" = migra; senao o motivo da recusa
    vein rf_migrate_check(mi: stone, mkey: obsidian, mnode: stone) -> obsidian {
        forge of0: stone = ofs_array_get(_mono_ffirst, mi)
        forge ofc: stone = ofs_array_get(_mono_fcount, mi)
        forge bad = ""
        forge ntypes: Array<obsidian> = []
        forge fi = 0
        while (fi < nx_len(mnode)) {
            forge f_id = nx_at(mnode, fi)
            forge nt = "stone"
            if (nc0(f_id) >= 0) { nt = type_node_str(nc0(f_id)) }
            ofs_array_push(ntypes, nt)
            forge oj = 0
            while (oj < ofc) {
                forge on: obsidian = ofs_array_get(_mono_field_names, of0 + oj)
                if (ofs_str_eq(on, nval(f_id))) {
                    forge ot: obsidian = ofs_array_get(_mono_field_types, of0 + oj)
                    if (!ofs_str_eq(ot, nt) && !(rf_num_class(mem_class(ot)) && rf_num_class(mem_class(nt)))) {
                        bad = rf_reason(bad, "'" + on + "' de " + ot + " para " + nt)
                    }
                }
                oj++
            }
            fi++
        }
        if (ofs_str_len(bad) > 0) {
            return "o monolith '" + mkey + "' tem " + rf_plural(rf_instances(mi), "instancia viva", "instancias vivas") + " e um campo mudou para um tipo que nao converte (" + bad + ")"
        }
        forge noffs: Array<stone> = []
        forge nsize = llvmgen.struct_layout(ntypes, noffs)
        forge k = 0
        forge mincap = -1
        while (k < ofs_array_len(_rf_obj_addr)) {
            forge km: stone = ofs_array_get(_rf_obj_mono, k)
            if (km == mi) {
                forge kc: stone = ofs_array_get(_rf_obj_cap, k)
                if (mincap < 0 || kc < mincap) { mincap = kc }
            }
            k++
        }
        if (mincap >= 0 && nsize > mincap) {
            return "o monolith '" + mkey + "' cresceu para " + ofs_stone_to_obsidian(nsize) + " bytes e as instancias vivas tem lugar para " + ofs_stone_to_obsidian(mincap) + " (folga de " + ofs_stone_to_obsidian(RF_OBJ_SLACK) + " bytes)"
        }
        return ""
    }

    // reescreve no lugar cada instancia viva de mi (layout novo ja na
    // tabela); devolve o relatorio
    vein rf_migrate(mi: stone, onames: Array<obsidian>, otypes: Array<obsidian>, ooffs: Array<stone>, ocls: Array<stone>, osize: stone) -> obsidian {
        forge first: stone = ofs_array_get(_mono_ffirst, mi)
        forge cnt: stone = ofs_array_get(_mono_fcount, mi)
        forge nsize: stone = ofs_array_get(_mono_size, mi)
        forge tmp = ofs_alloc(osize + 8) as stone
        forge sk = _rk
        forge stt: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        forge count = 0
        forge k = 0
        while (k < ofs_array_len(_rf_obj_addr)) {
            forge km: stone = ofs_array_get(_rf_obj_mono, k)
            if (km == mi) {
                forge a: stone = ofs_array_get(_rf_obj_addr, k)
                forge cap: stone = ofs_array_get(_rf_obj_cap, k)
                fracture { memcpy(tmp as *u8, a as *u8, osize) }
                forge z = 0
                while (z + 8 <= cap) {
                    mem_wr(a + z, MC_I64, 0)
                    z = z + 8
                }
                forge j = 0
                while (j < cnt) {
                    forge nn: obsidian = ofs_array_get(_mono_field_names, first + j)
                    forge nt: obsidian = ofs_array_get(_mono_field_types, first + j)
                    forge noff: stone = ofs_array_get(_mono_field_offs, first + j)
                    forge nc: stone = ofs_array_get(_mono_field_cls, first + j)
                    forge oi = rf_index(onames, nn)
                    if (oi >= 0) {
                        forge ot: obsidian = ofs_array_get(otypes, oi)
                        forge ooff: stone = ofs_array_get(ooffs, oi)
                        forge oc: stone = ofs_array_get(ocls, oi)
                        if (ofs_str_eq(ot, nt)) {
                            forge sz = llvmgen.type_storage_size(nt)
                            fracture { memcpy((a + noff) as *u8, (tmp + ooff) as *u8, sz) }
                        } else {
                            mem_load(tmp + ooff, oc, ot)
                            if (mc_is_narrow(nc) || nc == MC_F32) { coerce_regs(nc) }
                            mem_store(a + noff, nc, nt)
                        }
                    } else if (nc == MC_ARRAY) {
                        mem_wr(a + noff, MC_I64, 0 - interp_new_array() - 1)
                    } else if (nc == MC_OBJ) {
                        forge smi = mono_index(nt)
                        if (smi >= 0) { mem_wr(a + noff, MC_I64, obj_new(smi, 1)) }
                    }
                    j++
                }
                count++
            }
            k++
        }
        ofs_free(tmp as obsidian)
        r_set(sk, stt, si, sf, sb, ss, sr)
        // relatorio: campos novos, removidos e convertidos
        forge added: Array<obsidian> = []
        forge conv: Array<obsidian> = []
        forge j2 = 0
        while (j2 < cnt) {
            forge nn2: obsidian = ofs_array_get(_mono_field_names, first + j2)
            forge nt2: obsidian = ofs_array_get(_mono_field_types, first + j2)
            forge oi2 = rf_index(onames, nn2)
            if (oi2 < 0) { ofs_array_push(added, nn2) }
            else {
                forge ot2: obsidian = ofs_array_get(otypes, oi2)
                if (!ofs_str_eq(ot2, nt2)) { ofs_array_push(conv, nn2 + " " + ot2 + "->" + nt2) }
            }
            j2++
        }
        forge removed: Array<obsidian> = []
        j2 = 0
        while (j2 < ofs_array_len(onames)) {
            forge on2: obsidian = ofs_array_get(onames, j2)
            if (obj_field_find(ofs_array_get(_mono_names, mi), on2) < 0) { ofs_array_push(removed, on2) }
            j2++
        }
        forge rep = "monolith '" + ofs_array_get(_mono_names, mi) + "' migrado ao vivo (" + rf_plural(count, "instancia", "instancias") + ")"
        if (ofs_array_len(added) > 0) { rep = rep + "; campo(s) novo(s) com o valor padrao: " + rf_join(added) }
        if (ofs_array_len(removed) > 0) { rep = rep + "; removido(s): " + rf_join(removed) }
        if (ofs_array_len(conv) > 0) { rep = rep + "; convertido(s): " + rf_join(conv) }
        return rep
    }

    // global novo no slot reservado, com o valor inicial (os existentes
    // mantem o valor)
    vein rf_new_global(node: stone) -> void {
        forge saved_base = _current_frame_base
        forge saved_fn = _cur_fn_id
        forge before = ofs_array_len(_env_sym)
        _current_frame_base = before
        execute_stmt(node)
        _current_frame_base = saved_base
        _cur_fn_id = saved_fn
        forge top = ofs_array_len(_env_sym) - 1
        if (top < before) { return }
        forge slot = _rf_gslot
        _rf_gslot++
        env_load(top)
        env_store(slot)
        ofs_array_set(_env_sym, slot, node_sym(node))
        ofs_array_set(_env_depth, slot, 0)
        env_pop_one()
    }

    // proxima recristalizacao (uma por vez; a pendente e descartada se o
    // programa mudar antes de ela terminar)
    vein rf_launch() -> void {
        if (_cr_pending || ofs_array_len(_rf_dirty) == 0) { return }
        forge names: Array<obsidian> = []
        forge fids: Array<stone> = []
        forge i = 0
        while (i < ofs_array_len(_rf_dirty)) {
            forge key: obsidian = ofs_array_get(_rf_dirty, i)
            forge vi = rf_index(_rf_vkey, key)
            if (vi >= 0) {
                forge fid: stone = ofs_array_get(_rf_vfid, vi)
                forge el: bool = ofs_array_get(_cr_eligible, fid)
                if (el && cr_supported(fid)) {
                    ofs_array_push(names, key)
                    ofs_array_push(fids, fid)
                }
            }
            i++
        }
        _rf_dirty = []
        if (ofs_array_len(names) == 0) { return }
        ffi_init()
        if (!_ffi_exports || !_cr_enabled) {
            rf_info("sem compilacao nativa nesta execucao: " + rf_join(names) + " segue(m) interpretada(s)")
            return
        }
        _cr_jrefract = true
        _cr_josr = false
        rf_info("recristalizando em segundo plano: " + rf_join(names))
        hy_compile(_rf_root, names, fids, true)
        if (!_cr_pending && _cr_enabled) { rf_note_list("cristalizada(s) de novo (cache)", names) }
        else if (!_cr_enabled) { rf_note("clang indisponivel: " + rf_join(names) + " segue(m) interpretada(s)") }
    }

    vein rf_refract() -> void {
        forge start = node_pool_len()
        // fonte da lava: o diagnostico vai para o .eco e so aparece se o
        // conteudo ficar parado com erro (a pessoa ainda pode estar digitando)
        forge lava = _rf_lava_live && ofs_str_len(_rf_lava_eco) > 0
        forge saved = -1
        if (lava) { saved = rf_stdout_to_file(_rf_lava_eco) }
        else { saved = rf_stdout_to_stderr() }
        forge root2 = refract_reload(_rf_path)
        rf_stdout_restore(saved)
        // nos de tentativas com erro tambem entram nas tabelas (ids globais)
        build_node_tables_from(_n_count)
        rf_extend()
        if (root2 < 0) {
            if (lava) {
                _rf_err_text = read_file(_rf_lava_eco)
                _rf_err_sig = _rf_sig
                _rf_err_at = rf_now_ms()
                _rf_err_wait = true
                return
            }
            rf_note("erro de compilacao (acima); a versao em execucao continua")
            return
        }
        // voltou a compilar: o mesmo erro, se voltar, aparece de novo
        _rf_err_wait = false
        _rf_err_shown = ""
        rf_apply(root2, start)
    }

    vein rf_apply(root2: stone, start: stone) -> void {
        rf_scan(root2)
        // ── 1. diff por vein ──
        forge ch_vi: Array<stone> = []
        forge ch_new: Array<stone> = []
        forge ch_hash: Array<stone> = []
        forge ad_si: Array<stone> = []
        forge ad_hash: Array<stone> = []
        forge un_new: Array<stone> = []
        forge un_old: Array<stone> = []
        forge seen_vi: Array<stone> = []
        forge i = 0
        while (i < ofs_array_len(_rs_vkey)) {
            forge key: obsidian = ofs_array_get(_rs_vkey, i)
            forge nf: stone = ofs_array_get(_rs_vfid, i)
            forge nh = rf_hash(nf, 1469598103934665603)
            forge vi = rf_index(_rf_vkey, key)
            if (vi < 0) {
                ofs_array_push(ad_si, i)
                ofs_array_push(ad_hash, nh)
            } else {
                ofs_array_push(seen_vi, vi)
                forge oh: stone = ofs_array_get(_rf_vhash, vi)
                forge of: stone = ofs_array_get(_rf_vfid, vi)
                if (nh == oh) {
                    ofs_array_push(un_new, nf)
                    ofs_array_push(un_old, of)
                } else {
                    ofs_array_push(ch_vi, vi)
                    ofs_array_push(ch_new, nf)
                    ofs_array_push(ch_hash, nh)
                }
            }
            i++
        }
        // ── 2. regras de seguranca ──
        forge why = ""
        forge sig_ok: Array<obsidian> = []
        forge ch_old: Array<stone> = []
        i = 0
        while (i < ofs_array_len(ch_vi)) {
            forge cvi: stone = ofs_array_get(ch_vi, i)
            forge cof: stone = ofs_array_get(_rf_vfid, cvi)
            forge cnf: stone = ofs_array_get(ch_new, i)
            forge cname: obsidian = ofs_array_get(_rf_vkey, cvi)
            ofs_array_push(ch_old, cof)
            forge osig: obsidian = ofs_array_get(_rf_vsig, cvi)
            forge nsig = rf_sig(cnf)
            // geode: com outra assinatura (capturas mudaram) os geodes ja
            // criados seguem com o codigo antigo (sem redirecionar); os novos
            // usam o novo. Nao recusa.
            if (!ofs_str_eq(osig, nsig) && !rf_is_geode_key(cname)) {
                forge shown = "a assinatura de '" + vein_display_name(cname) + "' mudou de " + osig + " para " + nsig
                forge user = rf_active_user(cof)
                if (rf_is_callback(cof)) {
                    why = rf_reason(why, shown + " e ela foi entregue ao C como callback")
                } else if (rf_used_as_value(cof)) {
                    why = rf_reason(why, shown + " e ela e usada como valor de vein")
                } else if (ofs_str_len(user) > 0) {
                    // onda 4: aceita quando a chamada antiga continua valida
                    forge compat = rf_sig_compat(cof, cnf)
                    if (ofs_str_len(compat) > 0) {
                        ofs_array_push(sig_ok, shown + ": compativel (" + compat + "), '" + vein_display_name(user) + "' segue chamando")
                    } else {
                        why = rf_reason(why, shown + " e '" + vein_display_name(user) + "', em execucao, ainda a chama com a antiga (aceito so parametro novo no fim com valor padrao e retorno compativel)")
                    }
                }
            }
            i++
        }
        // veins removidas ainda em uso
        forge gone: Array<obsidian> = []
        i = 0
        while (i < ofs_array_len(_rf_vkey)) {
            forge was_gone: bool = ofs_array_get(_rf_vgone, i)
            if (!rf_has_id(seen_vi, i) && !was_gone) {
                forge rkey: obsidian = ofs_array_get(_rf_vkey, i)
                forge rof: stone = ofs_array_get(_rf_vfid, i)
                if (rof >= 0) {
                    forge ruser = rf_active_user(rof)
                    if (ofs_str_len(ruser) > 0 && !ofs_str_eq(ruser, rkey)) {
                        why = rf_reason(why, "a vein '" + vein_display_name(rkey) + "' foi removida, mas '" + vein_display_name(ruser) + "', em execucao, ainda a chama")
                    } else if (rf_is_callback(rof)) {
                        why = rf_reason(why, "a vein '" + vein_display_name(rkey) + "' foi removida, mas o C ainda a tem como callback")
                    } else {
                        ofs_array_push(gone, rkey)
                    }
                }
            }
            i++
        }
        // monoliths
        forge relayout: Array<stone> = []
        forge migrate: Array<stone> = []
        forge mono_new: Array<stone> = []
        i = 0
        while (i < ofs_array_len(_rs_mkey)) {
            forge mkey: obsidian = ofs_array_get(_rs_mkey, i)
            forge mnode: stone = ofs_array_get(_rs_mnode, i)
            forge mvi = rf_index(_rf_mkey, mkey)
            if (mvi < 0) {
                ofs_array_push(mono_new, i)
            } else {
                forge oshape: obsidian = ofs_array_get(_rf_mshape, mvi)
                if (!ofs_str_eq(oshape, rf_mshape(mnode))) {
                    forge mmi = mono_index(mkey)
                    if (rf_instances(mmi) > 0) {
                        // onda 4: as instancias vivas migram para o layout novo
                        forge mw = rf_migrate_check(mmi, mkey, mnode)
                        if (ofs_str_len(mw) > 0) { why = rf_reason(why, mw) }
                        else {
                            ofs_array_push(relayout, i)
                            ofs_array_push(migrate, i)
                        }
                    } else {
                        ofs_array_push(relayout, i)
                    }
                }
            }
            i++
        }
        // globais
        forge glob_new: Array<stone> = []
        i = 0
        while (i < ofs_array_len(_rs_gkey)) {
            forge gkey: obsidian = ofs_array_get(_rs_gkey, i)
            forge gnode: stone = ofs_array_get(_rs_gnode, i)
            forge gvi = rf_index(_rf_gkey, gkey)
            if (gvi < 0) {
                ofs_array_push(glob_new, i)
            } else {
                forge ogt: obsidian = ofs_array_get(_rf_gtype, gvi)
                if (!ofs_str_eq(ogt, rf_gtype(gnode))) {
                    why = rf_reason(why, "o global '" + vein_display_name(gkey) + "' mudou de tipo (de " + ogt + " para " + rf_gtype(gnode) + ")")
                }
            }
            i++
        }
        if (_rf_gslot + ofs_array_len(glob_new) > _rf_gslot_end) {
            why = rf_reason(why, "globais novos demais nesta execucao (limite " + ofs_stone_to_obsidian(RF_GLOBAL_SLOTS) + ")")
        }
        // externs
        forge ext_new: Array<stone> = []
        i = 0
        while (i < ofs_array_len(_rs_ekey)) {
            forge ekey: obsidian = ofs_array_get(_rs_ekey, i)
            forge enode: stone = ofs_array_get(_rs_enode, i)
            forge evi = rf_index(_rf_ekey, ekey)
            if (evi < 0) {
                forge esym = ntype(enode)
                if (ofs_str_len(esym) == 0) { esym = nval(enode) }
                ffi_init()
                if (dlsym(ffi_rtld_default(), esym) == 0 && find_function(esym) < 0) {
                    why = rf_reason(why, "a extern nova '" + ekey + "' nao tem simbolo no processo (" + esym + ")")
                }
                ofs_array_push(ext_new, i)
            } else {
                forge oes: obsidian = ofs_array_get(_rf_eshape, evi)
                if (!ofs_str_eq(oes, rf_eshape(enode))) {
                    why = rf_reason(why, "a extern '" + ekey + "' mudou de assinatura")
                }
            }
            i++
        }
        // variantes: a lista nova precisa comecar pela antiga (etiquetas)
        forge v2: Array<obsidian> = []
        forge s2: Array<obsidian> = []
        i = start
        while (i < _n_count) {
            if (nk(i) == NK_VARIANT) { ofs_array_push(v2, nval(i)) }
            if (nk(i) == NK_STRATA) { ofs_array_push(s2, nval(i)) }
            i++
        }
        i = 0
        while (i < ofs_array_len(_variant_names)) {
            forge ov: obsidian = ofs_array_get(_variant_names, i)
            if (i >= ofs_array_len(v2) || !ofs_str_eq(ov, ofs_array_get(v2, i))) {
                why = rf_reason(why, "variantes de strata foram removidas ou reordenadas (so acrescentar no fim troca ao vivo)")
                break
            }
            i++
        }
        if (ofs_str_len(why) > 0) {
            rf_note("troca recusada: " + why + ". O programa segue com a versao anterior; reinicie (ofs refract) para aplicar")
            return
        }
        // ── 3. L1: raizes nativas afetadas ──
        // muda a vein nativa, ou ela chama (no .so, direto) algo que mudou
        forge dirty: Array<obsidian> = []
        forge dirty_hi: Array<stone> = []
        forge hi = 0
        while (hi < ofs_array_len(_hy_fid)) {
            forge rfid: stone = ofs_array_get(_hy_fid, hi)
            forge rkey2 = rf_key_of(rfid)
            if (ofs_str_len(rkey2) > 0) {
                if (rf_has_id(ch_old, rfid) || ofs_array_len(relayout) > 0 || rf_reaches(rfid, ch_old)) {
                    forge rq2: bool = ofs_array_get(_cr_quartz, rfid)
                    if ((nk(rfid) == NK_CORE_DECL || ofs_str_eq(rkey2, "main")) && !rq2) {
                        // o ponto de entrada nao e chamado de novo: recompilar
                        // traria o programa inteiro para o .so; se for, roda
                        // interpretado (versao nova)
                        ofs_array_set(_hy_addr, hi, 0)
                    } else if (!rf_has_name(dirty, rkey2)) {
                        ofs_array_push(dirty, rkey2)
                        ofs_array_push(dirty_hi, hi)
                    }
                }
            }
            hi++
        }
        // elegibilidade das versoes novas (antes de qualquer compilacao)
        forge qnames: Array<obsidian> = []
        forge qfids: Array<stone> = []
        i = 0
        while (i < ofs_array_len(ch_new) + ofs_array_len(ad_si)) {
            forge vfid = 0
            forge vkey = ""
            if (i < ofs_array_len(ch_new)) {
                vfid = ofs_array_get(ch_new, i)
                forge cvi2: stone = ofs_array_get(ch_vi, i)
                vkey = ofs_array_get(_rf_vkey, cvi2)
            } else {
                forge asi: stone = ofs_array_get(ad_si, i - ofs_array_len(ch_new))
                vfid = ofs_array_get(_rs_vfid, asi)
                vkey = ofs_array_get(_rs_vkey, asi)
            }
            forge vq = hy_has_quartz(nc2(vfid))
            ofs_array_set(_cr_eligible, vfid, cr_supported(vfid))
            ofs_array_set(_cr_quartz, vfid, vq)
            if (vq) {
                ofs_array_push(qnames, vkey)
                ofs_array_push(qfids, vfid)
            }
            i++
        }
        // raizes afetadas com quartz tambem precisam de nativo ja
        i = 0
        while (i < ofs_array_len(dirty)) {
            forge dkey: obsidian = ofs_array_get(dirty, i)
            forge dhi: stone = ofs_array_get(dirty_hi, i)
            forge dfid: stone = ofs_array_get(_hy_fid, dhi)
            forge dq: bool = ofs_array_get(_cr_quartz, dfid)
            if (dq && !rf_has_id(ch_old, dfid) && !rf_has_name(qnames, dkey)) {
                ofs_array_push(qnames, dkey)
                ofs_array_push(qfids, dfid)
            }
            i++
        }
        if (ofs_array_len(qnames) > 0) {
            // quartz nao roda interpretado: compila agora, antes da troca
            ffi_init()
            _hy_soft = true
            _hy_soft_err = false
            hy_compile(root2, qnames, qfids, false)
            _hy_soft = false
            if (_hy_soft_err) {
                rf_note("troca recusada: as veins com quartz da versao nova nao compilaram (acima). O programa segue com a versao anterior")
                return
            }
        }
        // ── 4. troca ──
        _rf_gen++
        _rf_root = root2
        _cr_root = root2
        // variantes e strata novos (no fim)
        i = ofs_array_len(_variant_names)
        while (i < ofs_array_len(v2)) {
            ofs_array_push(_variant_names, ofs_array_get(v2, i))
            i++
        }
        i = 0
        while (i < ofs_array_len(s2)) {
            forge sn: obsidian = ofs_array_get(s2, i)
            if (!rf_has_name(_strata_names, sn)) { ofs_array_push(_strata_names, sn) }
            i++
        }
        // layout antigo dos monoliths que migram (antes da tabela nova)
        forge mig_mi: Array<stone> = []
        forge mig_names: Array<Array> = []
        forge mig_types: Array<Array> = []
        forge mig_offs: Array<Array> = []
        forge mig_cls: Array<Array> = []
        forge mig_size: Array<stone> = []
        i = 0
        while (i < ofs_array_len(migrate)) {
            forge gmi = mono_index(ofs_array_get(_rs_mkey, ofs_array_get(migrate, i)))
            forge on: Array<obsidian> = []
            forge ot: Array<obsidian> = []
            forge oo: Array<stone> = []
            forge oc: Array<stone> = []
            forge of0: stone = ofs_array_get(_mono_ffirst, gmi)
            forge ofc: stone = ofs_array_get(_mono_fcount, gmi)
            forge oj = 0
            while (oj < ofc) {
                ofs_array_push(on, ofs_array_get(_mono_field_names, of0 + oj))
                ofs_array_push(ot, ofs_array_get(_mono_field_types, of0 + oj))
                ofs_array_push(oo, ofs_array_get(_mono_field_offs, of0 + oj))
                ofs_array_push(oc, ofs_array_get(_mono_field_cls, of0 + oj))
                oj++
            }
            ofs_array_push(mig_mi, gmi)
            ofs_array_push(mig_names, on)
            ofs_array_push(mig_types, ot)
            ofs_array_push(mig_offs, oo)
            ofs_array_push(mig_cls, oc)
            ofs_array_push(mig_size, ofs_array_get(_mono_size, gmi))
            i++
        }
        // monoliths novos e com layout novo
        i = 0
        while (i < ofs_array_len(mono_new) + ofs_array_len(relayout)) {
            forge msi = 0
            if (i < ofs_array_len(mono_new)) { msi = ofs_array_get(mono_new, i) }
            else { msi = ofs_array_get(relayout, i - ofs_array_len(mono_new)) }
            forge mk2: obsidian = ofs_array_get(_rs_mkey, msi)
            forge mn2: stone = ofs_array_get(_rs_mnode, msi)
            forge mi2 = mono_index(mk2)
            if (mi2 < 0) {
                register_monolith(mk2)
                mi2 = mono_index(mk2)
            } else {
                // os campos antigos saem da tabela: o cache de campo (_naux)
                // dos nos que ja rodaram nao acha mais o dono e reprocura
                forge of1: stone = ofs_array_get(_mono_ffirst, mi2)
                forge ofc1: stone = ofs_array_get(_mono_fcount, mi2)
                forge oj1 = 0
                while (oj1 < ofc1) {
                    ofs_array_set(_mono_field_owners, of1 + oj1, "")
                    oj1++
                }
            }
            ofs_array_set(_mono_ffirst, mi2, ofs_array_len(_mono_field_names))
            ofs_array_set(_mono_fcount, mi2, 0)
            forge fi = 0
            while (fi < nx_len(mn2)) {
                forge f_id = nx_at(mn2, fi)
                forge ft_str = "stone"
                if (nc0(f_id) >= 0) { ft_str = type_node_str(nc0(f_id)) }
                ofs_array_push(_mono_field_owners, mk2)
                ofs_array_push(_mono_field_names, nval(f_id))
                ofs_array_push(_mono_field_types, ft_str)
                ofs_array_push(_mono_field_offs, 0)
                ofs_array_push(_mono_field_cls, MC_I64)
                ofs_array_set(_mono_fcount, mi2, fi + 1)
                fi++
            }
            forge mvi2 = rf_index(_rf_mkey, mk2)
            if (mvi2 < 0) {
                ofs_array_push(_rf_mkey, mk2)
                ofs_array_push(_rf_mshape, rf_mshape(mn2))
            } else {
                ofs_array_set(_rf_mshape, mvi2, rf_mshape(mn2))
            }
            i++
        }
        _mono_last_idx = -1
        compute_layouts()
        forge migrated: Array<obsidian> = []
        i = 0
        while (i < ofs_array_len(mig_mi)) {
            forge mmi3: stone = ofs_array_get(mig_mi, i)
            ofs_array_push(migrated, rf_migrate(mmi3, ofs_array_get(mig_names, i), ofs_array_get(mig_types, i), ofs_array_get(mig_offs, i), ofs_array_get(mig_cls, i), ofs_array_get(mig_size, i)))
            i++
        }
        // externs novas
        i = 0
        while (i < ofs_array_len(ext_new)) {
            forge esi: stone = ofs_array_get(ext_new, i)
            forge en2: stone = ofs_array_get(_rs_enode, esi)
            forge eregs: Array<obsidian> = ofs_array_get(_rs_eregs, esi)
            forge ri = 0
            while (ri < ofs_array_len(eregs)) {
                register_extern(ofs_array_get(eregs, ri), en2, "")
                ri++
            }
            ofs_array_push(_rf_ekey, ofs_array_get(_rs_ekey, esi))
            ofs_array_push(_rf_eshape, rf_eshape(en2))
            i++
        }
        // veins novas: registradas pelo nome, como no inicio
        forge added_names: Array<obsidian> = []
        i = 0
        while (i < ofs_array_len(ad_si)) {
            forge asi2: stone = ofs_array_get(ad_si, i)
            forge afid: stone = ofs_array_get(_rs_vfid, asi2)
            forge akey: obsidian = ofs_array_get(_rs_vkey, asi2)
            forge aregs: Array<obsidian> = ofs_array_get(_rs_vregs, asi2)
            forge ri2 = 0
            while (ri2 < ofs_array_len(aregs)) {
                register_function(ofs_array_get(aregs, ri2), afid)
                ri2++
            }
            ofs_array_push(_rf_vkey, akey)
            ofs_array_push(_rf_vfid, afid)
            ofs_array_push(_rf_vhash, ofs_array_get(ad_hash, i))
            ofs_array_push(_rf_vsig, rf_sig(afid))
            ofs_array_push(_rf_vgone, false)
            ofs_array_push(added_names, akey)
            i++
        }
        // veins que mudaram: a celula da versao viva aponta para a nova
        forge changed_names: Array<obsidian> = []
        forge running: Array<obsidian> = []
        i = 0
        while (i < ofs_array_len(ch_vi)) {
            forge cvi3: stone = ofs_array_get(ch_vi, i)
            forge cof3: stone = ofs_array_get(_rf_vfid, cvi3)
            forge cnf3: stone = ofs_array_get(ch_new, i)
            forge ckey3: obsidian = ofs_array_get(_rf_vkey, cvi3)
            if (rf_is_active(cof3)) { ofs_array_push(running, ckey3) }
            forge osig3: obsidian = ofs_array_get(_rf_vsig, cvi3)
            if (!(rf_is_geode_key(ckey3) && !ofs_str_eq(osig3, rf_sig(cnf3)))) { rf_redirect(cof3, cnf3) }
            ofs_array_set(_rf_vfid, cvi3, cnf3)
            ofs_array_set(_rf_vhash, cvi3, ofs_array_get(ch_hash, i))
            ofs_array_set(_rf_vsig, cvi3, rf_sig(cnf3))
            ofs_array_set(_rf_vgone, cvi3, false)
            ofs_array_push(changed_names, ckey3)
            i++
        }
        // copias identicas da versao nova apontam para a versao viva
        i = 0
        while (i < ofs_array_len(un_new)) {
            forge un: stone = ofs_array_get(un_new, i)
            forge uo: stone = ofs_array_get(un_old, i)
            ofs_array_set(_rf_cell, un, uo)
            i++
        }
        i = 0
        while (i < ofs_array_len(seen_vi)) {
            ofs_array_set(_rf_vgone, ofs_array_get(seen_vi, i), false)
            i++
        }
        // nos novos: decisoes de tipo e chamadas resolvidas
        annotate_nodes_from(start)
        resolve_calls_from(start)
        if (_cr_enabled) {
            i = start
            while (i < _n_count) {
                forge ft = ntype(i)
                if (nk(i) == NK_TYPE_FN) { ft = nval(i) }
                if (vein_type_is(ft) && (ofs_str_contains(ft, "crystal") || ofs_str_contains(ft, "f64") || ofs_str_contains(ft, "f32")) && !cb_float_ready()) {
                    cr_abandon("callback de ponto flutuante sem trampolim neste ofscc; continuando interpretado")
                    break
                }
                i++
            }
        }
        // globais novos (os existentes mantem o valor)
        forge new_globals: Array<obsidian> = []
        i = 0
        while (i < ofs_array_len(glob_new)) {
            forge gsi: stone = ofs_array_get(glob_new, i)
            forge gn2: stone = ofs_array_get(_rs_gnode, gsi)
            forge gk2: obsidian = ofs_array_get(_rs_gkey, gsi)
            rf_new_global(gn2)
            ofs_array_push(_rf_gkey, gk2)
            ofs_array_push(_rf_gtype, rf_gtype(gn2))
            ofs_array_push(new_globals, gk2)
            i++
        }
        // arquivos observados da versao nova (attach acrescentado/removido)
        _rf_files = refract_paths()
        _rf_sig = rf_files_sig()
        _rf_seen = _rf_sig
        // L1: as raizes nativas afetadas rodam interpretadas ate o .so novo
        forge bg: Array<obsidian> = []
        i = 0
        while (i < ofs_array_len(dirty)) {
            forge bkey: obsidian = ofs_array_get(dirty, i)
            if (!rf_has_name(qnames, bkey)) {
                forge bhi: stone = ofs_array_get(dirty_hi, i)
                ofs_array_set(_hy_addr, bhi, 0)
                ofs_array_push(bg, bkey)
            }
            i++
        }
        // OSR: as versoes nativas dos lacos chamam direto as veins de antes;
        // descarta e deixa cada laco pedir de novo com o programa novo
        osr_extend()
        i = 0
        while (i < ofs_array_len(_osr_addr)) {
            ofs_array_set(_osr_addr, i, 0)
            forge ost: stone = ofs_array_get(_osr_state, i)
            if (ost == 1 || ost == 3) {
                ofs_array_set(_osr_state, i, 0)
                ofs_array_set(_osr_heat, i, 0)
            }
            i++
        }
        // ── 5. relatorio ──
        forge msg = ""
        if (ofs_array_len(changed_names) > 0) {
            msg = rf_plural(ofs_array_len(changed_names), "vein refratada", "veins refratadas") + " (" + rf_join(changed_names) + ")"
        }
        if (ofs_array_len(added_names) > 0) {
            msg = rf_reason(msg, rf_plural(ofs_array_len(added_names), "vein nova", "veins novas") + " (" + rf_join(added_names) + ")")
        }
        if (ofs_array_len(new_globals) > 0) {
            msg = rf_reason(msg, rf_plural(ofs_array_len(new_globals), "global novo", "globais novos") + " (" + rf_join(new_globals) + ")")
        }
        if (ofs_array_len(gone) > 0) {
            msg = rf_reason(msg, rf_plural(ofs_array_len(gone), "vein removida", "veins removidas") + " (" + rf_join(gone) + ")")
        }
        if (ofs_array_len(mono_new) + ofs_array_len(relayout) > 0) {
            msg = rf_reason(msg, rf_plural(ofs_array_len(mono_new) + ofs_array_len(relayout), "monolith com layout novo", "monoliths com layout novo"))
        }
        if (ofs_str_len(msg) == 0) { msg = "nenhuma vein mudou" }
        rf_info(msg)
        i = 0
        while (i < ofs_array_len(sig_ok)) {
            rf_info(ofs_array_get(sig_ok, i))
            i++
        }
        i = 0
        while (i < ofs_array_len(migrated)) {
            rf_info(ofs_array_get(migrated, i))
            i++
        }
        if (ofs_array_len(running) > 0) {
            rf_info(rf_join(running) + " em execucao: troca no proximo cabecalho de laco (OSR); fora de laco, a nova vale na proxima chamada")
        }
        if (ofs_array_len(qnames) > 0) { rf_note_list("cristalizada(s) de novo (quartz)", qnames) }
        // removidas seguem carregadas (a antiga termina o que estiver fazendo)
        i = 0
        while (i < ofs_array_len(gone)) {
            forge gk3: obsidian = ofs_array_get(gone, i)
            forge gvi3 = rf_index(_rf_vkey, gk3)
            if (gvi3 >= 0) { ofs_array_set(_rf_vgone, gvi3, true) }
            i++
        }
        rf_mark_dirty(bg)
        if (_cr_pending && ofs_array_len(bg) > 0) {
            rf_info("recristalizacao na fila (espera a compilacao em curso): " + rf_join(bg))
        }
        rf_launch()
    }

    // ── Driver Entry Point ────────────────────────────────────────────────

    // ── ofs fossil (Ideia 2): gravar, reproduzir e voltar no tempo ─────────
    // Gravar (_fs_mode 1): toda chamada externa com politica (fossil.ofs,
    // fz_spec) passa por fs_invoke, que chama o C e grava o retorno, os bytes
    // que o C escreveu no buffer do programa e o hash dos dados de saida.
    // Reproduzir (_fs_mode 2): fs_invoke nao chama o C; devolve o gravado e
    // copia os bytes para o buffer atual (os enderecos mudam de uma execucao
    // para outra; o argumento e o mesmo). Saida para o console roda de
    // verdade (e a saida do programa); para arquivo/rede vira no-op conferido
    // pelo hash. O resto (o interpretador, funcoes puras do C) e
    // deterministico, entao a execucao se repete passo a passo.
    // Passo = um statement (execute_stmt). Voltar no tempo: camadas (fork do
    // processo inteiro, copia sob demanda: variaveis, heap, memoria crua e o
    // C) a cada _fs_every passos; ir para um passo anterior = acordar a
    // camada mais proxima antes dele e reexecutar dela ate o passo, sem
    // saida. Cristalizacao/OSR ficam desligadas (hy_prepare).
    forge _fs_mode: stone = 0
    forge _fs_on: bool = false
    forge _fs_mute: bool = false
    forge _fs_pol: stone = 0
    forge _fs_cur_sym: obsidian = ""
    forge _fs_steps: stone = 0
    forge _fs_events: stone = 0
    forge _fs_spec: Array<stone> = []
    forge _fs_world_extra: obsidian = ""
    forge _fs_file: obsidian = ""
    forge _fs_users: Array<obsidian> = []
    forge _fs_user_gsym: Array<stone> = []
    forge _fs_mismatch: stone = 0
    forge _fs_finished: bool = false
    forge _fs_ended: bool = false
    forge _fs_code: stone = 0
    forge _fs_to: obsidian = ""
    forge _fs_back: stone = 0
    forge _fs_talk: bool = false
    forge _fs_nav: bool = false
    forge _fs_stop: stone = -1
    forge _fs_wl: stone = -1
    forge _fs_wfirst: stone = -1
    forge _fs_nline: Array<stone> = []
    forge _fs_every: stone = 2000
    forge _fs_lay_next: stone = 1
    forge _fs_lay_step: Array<stone> = []
    forge _fs_lay_pid: Array<stone> = []
    forge _fs_lay_wfd: Array<stone> = []
    forge _fs_done_r: stone = -1
    forge _fs_done_w: stone = -1
    forge _fs_opaque: Array<stone> = []
    // a parada pedida e so um `segue` (nao conta como alvo nao alcancado)
    forge _fs_soft: bool = false
    forge _fs_sync: bool = true
    forge _fs_libc_names: Array<obsidian> = []
    forge _fs_libc_addr: Array<stone> = []
    forge _fs_stdout_fp: stone = 0
    forge _fs_stderr_fp: stone = 0
    forge _fs_eof: bool = false
    forge _fs_byte: stone = 0
    forge FS_MAX_LAYERS: stone = 32

    // funcoes POSIX pelo endereco (o ofscc do Windows liga sem elas)
    vein fs_libc(name: obsidian) -> stone {
        forge i = 0
        while (i < ofs_array_len(_fs_libc_names)) {
            forge n: obsidian = ofs_array_get(_fs_libc_names, i)
            if (ofs_str_eq(n, name)) {
                forge a: stone = ofs_array_get(_fs_libc_addr, i)
                return a
            }
            i++
        }
        ffi_init()
        forge addr = dlsym(ffi_rtld_default(), name)
        ofs_array_push(_fs_libc_names, name)
        ofs_array_push(_fs_libc_addr, addr)
        return addr
    }

    abyss vein fs_c0(name: obsidian) -> stone {
        forge f = fs_libc(name)
        if (f == 0) { return -1 }
        return fault_call(f)
    }

    abyss vein fs_c1(name: obsidian, a: stone) -> stone {
        forge f = fs_libc(name)
        if (f == 0) { return -1 }
        return fault_call(f, a)
    }

    abyss vein fs_c3(name: obsidian, a: stone, b: stone, c: stone) -> stone {
        forge f = fs_libc(name)
        if (f == 0) { return -1 }
        return fault_call(f, a, b, c)
    }

    vein fs_flush_all() -> void {
        fs_c1("fflush", 0)
    }

    // texto para o terminal, na ordem da saida do programa (echo usa stdio)
    vein fs_out(s: obsidian) -> void {
        fs_flush_all()
        write(1, s, ofs_str_len(s))
    }

    vein fs_int_of(s: obsidian) -> stone {
        if (s == null) { return 0 }
        return fz_parse_int(s)
    }

    vein fs_is_digits(s: obsidian) -> bool {
        forge n = ofs_str_len(s)
        if (n == 0) { return false }
        forge i = 0
        while (i < n) {
            forge c = ofs_str_char_at(s, i)
            if (c < 48 || c > 57) { return false }
            i++
        }
        return true
    }

    // Liga o modo (antes de run): "record" cria o arquivo; "replay" le o
    // cabecalho e confere o hash do fonte. users: arquivos do programa (o
    // principal primeiro), os mesmos que a Refract observa.
    vein fs_enable(mode: obsidian, path: obsidian, src_hash: stone, users: Array<obsidian>) -> bool {
        _fs_file = path
        _fs_users = users
        forge extra: obsidian = getenv("OFS_FOSSIL_WORLD")
        if (extra != null && ofs_str_len(extra) > 0) {
            forge sp = " "
            forge i = 0
            while (i < ofs_str_len(extra)) {
                forge c = ofs_str_char_at(extra, i)
                if (c == 58 || c == 44) { sp = sp + " " } else { sp = sp + ofs_str_substr(extra, i, 1) }
                i++
            }
            _fs_world_extra = sp + " "
        }
        forge main_src = ""
        if (ofs_array_len(users) > 0) { main_src = ofs_array_get(users, 0) }
        if (ofs_str_eq(mode, "record")) {
            if (!fz_create(path)) {
                ffi_stderr("ofs fossil: nao foi possivel criar '" + path + "'\n")
                return false
            }
            fz_header_write(main_src, src_hash)
            _fs_sync = !ofs_str_eq(getenv("OFS_FOSSIL_SYNC"), "0")
            _fs_mode = 1
            _fs_on = true
            return true
        }
        if (!fz_load(path)) {
            ffi_stderr("ofs fossil: nao foi possivel ler '" + path + "'\n")
            return false
        }
        if (!fz_header_read()) {
            ffi_stderr("ofs fossil: '" + path + "': " + _fz_hdr_err + "\n")
            return false
        }
        if (_fz_hdr_hash != src_hash) {
            ffi_stderr("ofs fossil: aviso: o programa mudou desde a gravacao (o hash do fonte difere); o replay pode divergir\n")
        }
        _fs_mode = 2
        _fs_on = true
        forge to: obsidian = getenv("OFS_FOSSIL_TO")
        if (to != null) { _fs_to = to }
        _fs_back = fs_int_of(getenv("OFS_FOSSIL_BACK"))
        _fs_talk = ofs_str_eq(getenv("OFS_FOSSIL_DIG"), "1")
        forge every = fs_int_of(getenv("OFS_FOSSIL_LAYER"))
        if (every > 0) { _fs_every = every }
        _fs_nav = _fs_talk || _fs_back > 0
        return true
    }

    // Dentro de run, com as tabelas prontas e antes dos globais
    vein fs_start(root_id: stone) -> void {
        _fs_steps = 0
        forge q = 0
        while (q < ofs_array_len(_cr_quartz)) {
            forge hq: bool = ofs_array_get(_cr_quartz, q)
            if (hq) {
                ffi_stderr("ofs fossil: aviso: veins com quartz rodam nativas; as chamadas externas feitas dentro delas nao sao gravadas\n")
                break
            }
            q++
        }
        if (_fs_mode != 2) { return }
        fs_collect_user_globals(root_id)
        forge so = dlsym(ffi_rtld_default(), "stdout")
        if (so != 0) { _fs_stdout_fp = mem_rd(so, MC_I64) }
        forge se = dlsym(ffi_rtld_default(), "stderr")
        if (se != 0) { _fs_stderr_fp = mem_rd(se, MC_I64) }
        if (_fs_nav) {
            if (fs_libc("fork") == 0 || fs_libc("pipe") == 0) {
                ffi_stderr("ofs fossil: voltar no tempo precisa de fork/pipe (Linux, Android, macOS)\n")
                exit(2)
            }
            fs_supervisor_start()
            _fs_lay_next = 1
        }
        if (ofs_str_len(_fs_to) > 0) {
            if (!fs_set_target(_fs_to)) {
                ffi_stderr("ofs fossil: alvo '" + _fs_to + "' invalido (use um passo, L<linha>, <arquivo.ofs>:<linha> ou o nome de uma vein)\n")
                exit(2)
            }
            _fs_mute = true
        } else if (_fs_talk) {
            _fs_stop = 1
            _fs_mute = true
        } else if (_fs_back > 0) {
            // --back sem --to: conta do fim
            _fs_mute = true
        }
    }

    // globais declarados nos arquivos do programa (fora da stdlib/runtime)
    vein fs_collect_user_globals(root_id: stone) -> void {
        forge i = 0
        while (i < nx_len(root_id)) {
            forge d = nx_at(root_id, i)
            forge dk = nk(d)
            if (dk == NK_VAR_DECL || dk == NK_CONST_DECL) {
                fs_note_global(d)
            } else if (dk == NK_NAMESPACE) {
                forge j = 0
                while (j < nx_len(d)) {
                    forge nd = nx_at(d, j)
                    forge ndk = nk(nd)
                    if (ndk == NK_VAR_DECL || ndk == NK_CONST_DECL) { fs_note_global(nd) }
                    j++
                }
            }
            i++
        }
    }

    vein fs_is_user_file(f: obsidian) -> bool {
        forge i = 0
        while (i < ofs_array_len(_fs_users)) {
            forge u: obsidian = ofs_array_get(_fs_users, i)
            if (ofs_str_eq(u, f)) { return true }
            i++
        }
        return false
    }

    vein fs_note_global(d: stone) -> void {
        if (fs_is_user_file(ast_src_file(node_line_of(d)))) {
            ofs_array_push(_fs_user_gsym, node_sym(d))
        }
    }

    // alvo: passo (so digitos), L<linha>/linha:<n>/line:<n> (arquivo
    // principal), <arquivo>:<linha>, ou o nome de uma vein (primeiro
    // statement de cada entrada nela)
    vein fs_set_target(t: obsidian) -> bool {
        if (fs_is_digits(t)) {
            _fs_stop = fs_int_of(t)
            if (_fs_stop <= _fs_steps) { _fs_stop = _fs_steps + 1 }
            return true
        }
        forge n = ofs_str_len(t)
        forge file = ""
        forge line = -1
        if (n > 1 && ofs_str_char_at(t, 0) == 76 && fs_is_digits(ofs_str_substr(t, 1, n - 1))) {
            line = fs_int_of(ofs_str_substr(t, 1, n - 1))
        } else {
            forge c = n - 1
            while (c >= 0 && ofs_str_char_at(t, c) != 58) { c-- }
            if (c >= 0 && fs_is_digits(ofs_str_substr(t, c + 1, n - c - 1))) {
                file = ofs_str_substr(t, 0, c)
                line = fs_int_of(ofs_str_substr(t, c + 1, n - c - 1))
                if (ofs_str_eq(file, "linha") || ofs_str_eq(file, "line") || ofs_str_eq(file, "L")) { file = "" }
            }
        }
        if (line >= 0) {
            if (ofs_str_len(file) == 0 && ofs_array_len(_fs_users) > 0) { file = ofs_array_get(_fs_users, 0) }
            forge el = ast_exp_line(file, line)
            if (el < 0) { return false }
            if (ofs_array_len(_fs_nline) == 0) {
                forge k = 0
                while (k < _n_count) {
                    ofs_array_push(_fs_nline, node_line_of(k))
                    k++
                }
            }
            _fs_wl = el
            return true
        }
        forge fid = find_function(t)
        if (fid < 0) { return false }
        forge body = nc2(fid)
        if (body < 0 || nk(body) != NK_BLOCK || nx_len(body) == 0) { return false }
        _fs_wfirst = nx_at(body, 0)
        return true
    }

    // gancho de execute_stmt
    vein fs_step(id: stone) -> void {
        _fs_steps++
        if (_fs_mode != 2) { return }
        if (_fs_nav && _fs_steps >= _fs_lay_next) { fs_layer_make() }
        if (_fs_steps == _fs_stop) { fs_arrive(id); return }
        if (_fs_wl >= 0) {
            forge ln: stone = ofs_array_get(_fs_nline, id)
            if (ln == _fs_wl) { fs_arrive(id); return }
        }
        if (id == _fs_wfirst) { fs_arrive(id) }
    }

    vein fs_arrive(id: stone) -> void {
        _fs_soft = false
        _fs_stop = -1
        _fs_wl = -1
        _fs_wfirst = -1
        if (_fs_back > 0) {
            forge t = _fs_steps - _fs_back
            _fs_back = 0
            if (t < 1) { t = 1 }
            fs_travel(t)
            return
        }
        if (_fs_talk) {
            fs_prompt(id)
            return
        }
        fs_where(id)
        fs_show_vars()
        fs_end(0)
    }

    // ── camadas (fork) ──────────────────────────────────────────────────

    vein fs_layer_make() -> void {
        _fs_lay_next = _fs_steps + _fs_every
        if (ofs_array_len(_fs_lay_pid) >= FS_MAX_LAYERS) { fs_layer_thin() }
        fs_flush_all()
        forge fds = ofs_alloc(16) as stone
        if (fs_c1("pipe", fds) != 0) { return }
        forge rfd = mem_rd(fds, MC_I32)
        forge wfd = mem_rd(fds + 4, MC_I32)
        forge pid = fs_c0("fork")
        if (pid < 0) {
            fs_c1("close", rfd)
            fs_c1("close", wfd)
            return
        }
        if (pid == 0) {
            fs_layer_wait(rfd, wfd)
            return
        }
        fs_c1("close", rfd)
        ofs_array_push(_fs_lay_step, _fs_steps)
        ofs_array_push(_fs_lay_pid, pid)
        ofs_array_push(_fs_lay_wfd, wfd)
        fs_tell("L " + ofs_stone_to_obsidian(pid))
    }

    // a camada dorme ate um "go <passo>": entao um filho dela segue daqui
    // (a camada continua guardando este ponto para a proxima volta)
    vein fs_layer_wait(rfd: stone, wfd: stone) -> void {
        while (true) {
            forge msg = fs_fd_line(rfd)
            if (_fs_eof || ofs_str_len(msg) < 4 || !ofs_str_eq(ofs_str_substr(msg, 0, 3), "go ")) {
                fs_c1("_exit", 0)
            }
            forge t = fs_int_of(ofs_str_substr(msg, 3, ofs_str_len(msg) - 3))
            fs_flush_all()
            forge c = fs_c0("fork")
            if (c == 0) {
                fs_c1("close", rfd)
                fs_tell("A " + ofs_stone_to_obsidian(getpid()))
                ofs_array_push(_fs_lay_step, _fs_steps)
                ofs_array_push(_fs_lay_pid, fs_c0("getppid"))
                ofs_array_push(_fs_lay_wfd, wfd)
                _fs_stop = t
                _fs_wl = -1
                _fs_wfirst = -1
                _fs_back = 0
                _fs_soft = false
                _fs_mute = true
                return
            }
        }
    }

    vein fs_layer_kill(i: stone) -> void {
        forge pid: stone = ofs_array_get(_fs_lay_pid, i)
        forge wfd: stone = ofs_array_get(_fs_lay_wfd, i)
        fs_c3("kill", pid, 9, 0)
        fs_c3("waitpid", pid, 0, 0)
        fs_c1("close", wfd)
        fs_tell("K " + ofs_stone_to_obsidian(pid))
    }

    // muitas camadas: fica com uma sim, outra nao, e dobra o intervalo
    vein fs_layer_thin() -> void {
        forge ns: Array<stone> = []
        forge np: Array<stone> = []
        forge nw: Array<stone> = []
        forge i = 0
        while (i < ofs_array_len(_fs_lay_pid)) {
            if (i % 2 == 0) {
                ofs_array_push(ns, ofs_array_get(_fs_lay_step, i))
                ofs_array_push(np, ofs_array_get(_fs_lay_pid, i))
                ofs_array_push(nw, ofs_array_get(_fs_lay_wfd, i))
            } else {
                fs_layer_kill(i)
            }
            i++
        }
        _fs_lay_step = ns
        _fs_lay_pid = np
        _fs_lay_wfd = nw
        _fs_every = _fs_every * 2
    }

    // vai ao passo t (anterior): acorda a camada mais proxima antes dele e
    // sai desta linha do tempo
    vein fs_travel(t: stone) -> void {
        forge k = ofs_array_len(_fs_lay_step) - 1
        while (k >= 0) {
            forge st: stone = ofs_array_get(_fs_lay_step, k)
            if (st <= t) { break }
            k--
        }
        if (k < 0) {
            fs_out("fossil: nenhuma camada antes do passo " + ofs_stone_to_obsidian(t) + "\n")
            fs_end(1)
            return
        }
        forge last = ofs_array_len(_fs_lay_pid) - 1
        while (last > k) {
            fs_layer_kill(last)
            ofs_array_pop(_fs_lay_step)
            ofs_array_pop(_fs_lay_pid)
            ofs_array_pop(_fs_lay_wfd)
            last--
        }
        forge wfd: stone = ofs_array_get(_fs_lay_wfd, k)
        fs_flush_all()
        forge msg = "go " + ofs_stone_to_obsidian(t) + "\n"
        write(wfd, msg, ofs_str_len(msg))
        fs_retire()
    }

    // mensagem ao supervisor (escrita atomica: menor que PIPE_BUF)
    vein fs_tell(m: obsidian) -> void {
        if (_fs_done_w < 0) { return }
        forge line = m + "\n"
        write(_fs_done_w, line, ofs_str_len(line))
    }

    // este processo deixa a linha do tempo (a camada acordada segue)
    vein fs_retire() -> void {
        fs_flush_all()
        fs_tell("H " + ofs_stone_to_obsidian(getpid()))
        fs_c1("_exit", 0)
    }

    // fim da linha do tempo ativa: camadas fora, codigo ao supervisor
    vein fs_end(code: stone) -> void {
        forge i = ofs_array_len(_fs_lay_pid) - 1
        while (i >= 0) {
            fs_layer_kill(i)
            i--
        }
        _fs_lay_step = []
        _fs_lay_pid = []
        _fs_lay_wfd = []
        fs_flush_all()
        if (_fs_done_w < 0) { exit(code) }
        fs_tell("X " + ofs_stone_to_obsidian(code))
        fs_c1("_exit", code)
    }

    // Supervisor: o processo que o shell espera fica fora da execucao.
    // Recebe pelo pipe A <pid> (nova linha do tempo ativa), H <pid> (a
    // ativa saiu e acordou uma camada), L/K <pid> (camada criada/encerrada)
    // e X <codigo> (fim); no Linux e "subreaper" (prctl), entao recolhe os
    // processos orfaos e percebe se a ativa cair sem avisar (sinal).
    forge _fsv_active: stone = -1
    forge _fsv_handing: stone = -1
    forge _fsv_final: stone = -1
    forge _fsv_has_final: bool = false
    forge _fsv_layers: Array<stone> = []

    vein fs_supervisor_start() -> void {
        forge reaper = fs_c3("prctl", 36, 1, 0) == 0
        forge fds = ofs_alloc(16) as stone
        fs_c1("pipe", fds)
        _fs_done_r = mem_rd(fds, MC_I32)
        _fs_done_w = mem_rd(fds + 4, MC_I32)
        fs_flush_all()
        forge pid = fs_c0("fork")
        if (pid < 0) {
            ffi_stderr("ofs fossil: fork falhou\n")
            exit(2)
        }
        if (pid == 0) {
            fs_c1("close", _fs_done_r)
            _fs_done_r = -1
            return
        }
        fs_c1("close", _fs_done_w)
        _fs_done_w = -1
        _fsv_active = pid
        if (reaper) {
            // leitura sem bloquear (O_NONBLOCK: 2048 no Linux)
            fs_c3("fcntl", _fs_done_r, 4, 2048)
            fs_supervise_reap()
        }
        fs_supervise_read()
    }

    vein fs_supervise_msg(line: obsidian) -> void {
        if (ofs_str_len(line) < 3) { return }
        forge c = ofs_str_char_at(line, 0)
        forge v = fs_int_of(ofs_str_substr(line, 2, ofs_str_len(line) - 2))
        if (c == 65) {
            _fsv_active = v
            _fsv_handing = -1
        } else if (c == 72) {
            if (v == _fsv_active) { _fsv_handing = v }
        } else if (c == 76) {
            ofs_array_push(_fsv_layers, v)
        } else if (c == 75) {
            forge keep: Array<stone> = []
            forge i = 0
            while (i < ofs_array_len(_fsv_layers)) {
                forge p: stone = ofs_array_get(_fsv_layers, i)
                if (p != v) { ofs_array_push(keep, p) }
                i++
            }
            _fsv_layers = keep
        } else if (c == 88) {
            _fsv_final = v
            _fsv_has_final = true
        }
    }

    vein fs_supervise_exit(code: stone) -> void {
        forge i = 0
        while (i < ofs_array_len(_fsv_layers)) {
            forge p: stone = ofs_array_get(_fsv_layers, i)
            fs_c3("kill", p, 9, 0)
            i++
        }
        exit(code)
    }

    vein fs_supervise_reap() -> void {
        forge st = ofs_alloc(16) as stone
        while (true) {
            forge w = fs_c3("waitpid", -1, st, 0)
            while (true) {
                forge line = fs_fd_line(_fs_done_r)
                if (ofs_str_len(line) == 0 && _fs_eof) { break }
                fs_supervise_msg(line)
            }
            if (w < 0) {
                if (_fsv_has_final) { fs_supervise_exit(_fsv_final) }
                fs_supervise_exit(1)
            }
            if (w == _fsv_active) {
                if (_fsv_has_final) { fs_supervise_exit(_fsv_final) }
                if (_fsv_handing == w) {
                    _fsv_active = -1
                    _fsv_handing = -1
                } else {
                    forge status = mem_rd(st, MC_I32)
                    forge sig = status & 127
                    if (sig != 0) {
                        ffi_stderr("ofs fossil: o replay caiu (sinal " + ofs_stone_to_obsidian(sig) + ")\n")
                        fs_supervise_exit(128 + sig)
                    }
                    fs_supervise_exit((status >> 8) & 255)
                }
            }
        }
    }

    // sem subreaper (macOS): espera o X pelo pipe
    vein fs_supervise_read() -> void {
        while (true) {
            forge line = fs_fd_line(_fs_done_r)
            if (ofs_str_len(line) == 0 && _fs_eof) { fs_supervise_exit(1) }
            fs_supervise_msg(line)
            if (_fsv_has_final) { fs_supervise_exit(_fsv_final) }
        }
    }

    // linha de um descritor, byte a byte (sem o buffer do stdio, que o fork
    // duplicaria); _fs_eof no fim
    vein fs_fd_line(fd: stone) -> obsidian {
        if (_fs_byte == 0) { _fs_byte = ofs_alloc(8) as stone }
        _fs_eof = false
        forge out = ""
        while (true) {
            forge n = fs_c3("read", fd, _fs_byte, 1)
            if (n <= 0) {
                _fs_eof = true
                return out
            }
            forge b = fz_byte_at(_fs_byte)
            if (b == 10) { return out }
            if (b != 13) { out = out + fz_text(_fs_byte, 1) }
        }
        return out
    }

    // ── estado: onde e variaveis ────────────────────────────────────────

    vein fs_base_name(p: obsidian) -> obsidian {
        forge n = ofs_str_len(p)
        forge i = n - 1
        while (i >= 0 && ofs_str_char_at(p, i) != 47) { i-- }
        return ofs_str_substr(p, i + 1, n - i - 1)
    }

    vein fs_where(id: stone) -> void {
        if (id < 0) {
            fs_out("fossil: fim do programa (passo " + ofs_stone_to_obsidian(_fs_steps) + ", codigo " + ofs_stone_to_obsidian(_fs_code) + ")\n")
            return
        }
        forge el = node_line_of(id)
        forge f = ast_src_file(el)
        forge ln = ast_src_line(el)
        forge vn = "(globais)"
        if (_cur_fn_id >= 0) { vn = vein_display_name(nval(_cur_fn_id)) }
        fs_out("fossil: passo " + ofs_stone_to_obsidian(_fs_steps) + " | " + fs_base_name(f) + ":" + ofs_stone_to_obsidian(ln) + " | vein " + vn + "\n")
        if (ofs_str_len(f) > 0) {
            forge src = fz_source_line(f, ln)
            fs_out("  " + ofs_stone_to_obsidian(ln) + " | " + src + "\n")
        }
    }

    // valor nos registradores como texto (arrays e monoliths por dentro)
    vein fs_val_text(depth: stone) -> obsidian {
        forge k = _rk
        if (k == VAL_STRING) {
            if (_rs == null) { return "null" }
            if (fs_arg_index(_fs_opaque, _rs as stone) >= 0) { return "<ponteiro do C>" }
            return "\"" + _rs + "\""
        }
        if (k == VAL_ARRAY) {
            forge h = _rr
            forge n = interp_array_len(h)
            if (depth >= 2) { return "[" + ofs_stone_to_obsidian(n) + " itens]" }
            forge out = "["
            forge i = 0
            while (i < n && i < 16) {
                if (i > 0) { out = out + ", " }
                interp_array_get(h, i)
                out = out + fs_val_text(depth + 1)
                i++
            }
            if (n > 16) { out = out + ", ... (" + ofs_stone_to_obsidian(n) + " itens)" }
            return out + "]"
        }
        if (k == VAL_OBJECT) {
            forge a = _rr
            forge t: obsidian = _rt
            forge mi = mono_index(t)
            if (a <= 0 || mi < 0) { return val_str(_rk, _rt, _ri, _rf, _rb, _rs) }
            if (depth >= 2) { return t + " {...}" }
            forge first: stone = ofs_array_get(_mono_ffirst, mi)
            forge cnt: stone = ofs_array_get(_mono_fcount, mi)
            forge out = t + " { "
            forge j = 0
            while (j < cnt) {
                if (j > 0) { out = out + ", " }
                forge fname: obsidian = ofs_array_get(_mono_field_names, first + j)
                obj_load_field(a, first + j)
                out = out + fname + ": " + fs_val_text(depth + 1)
                j++
            }
            return out + " }"
        }
        if (k == VAL_NULL) { return "null" }
        return val_str(_rk, _rt, _ri, _rf, _rb, _rs)
    }

    vein fs_var_text(idx: stone) -> obsidian {
        forge sym: stone = ofs_array_get(_env_sym, idx)
        forge name: obsidian = ofs_array_get(_sym_names, sym)
        forge t: obsidian = ofs_array_get(_env_type, idx)
        env_load(idx)
        return vein_display_name(name) + ": " + t + " = " + fs_val_text(0)
    }

    vein fs_is_user_global(sym: stone) -> bool {
        forge i = 0
        while (i < ofs_array_len(_fs_user_gsym)) {
            forge s: stone = ofs_array_get(_fs_user_gsym, i)
            if (s == sym) { return true }
            i++
        }
        return false
    }

    vein fs_show_vars() -> void {
        forge total = ofs_array_len(_env_sym)
        if (_cur_fn_id >= 0 && !_fs_ended) {
            fs_out("  locais:\n")
            forge i = _current_frame_base
            if (i >= total) { fs_out("    (nenhuma)\n") }
            while (i < total) {
                fs_out("    " + fs_var_text(i) + "\n")
                i++
            }
        }
        fs_out("  globais:\n")
        forge gend = _globals_count
        if (_cur_fn_id < 0 && !_fs_ended) { gend = total }
        forge shown = 0
        forge g = 0
        while (g < gend && g < total) {
            forge sym: stone = ofs_array_get(_env_sym, g)
            if (fs_is_user_global(sym)) {
                fs_out("    " + fs_var_text(g) + "\n")
                shown++
            }
            g++
        }
        if (shown == 0) { fs_out("    (nenhum)\n") }
    }

    // ver <nome>: local (do topo) e depois global
    vein fs_print_var(name: obsidian) -> void {
        forge total = ofs_array_len(_env_sym)
        forge i = total - 1
        forge lo = _current_frame_base
        if (_cur_fn_id < 0 || _fs_ended) { lo = total }
        while (i >= lo) {
            forge s: stone = ofs_array_get(_env_sym, i)
            forge sn: obsidian = ofs_array_get(_sym_names, s)
            if (ofs_str_eq(sn, name)) {
                fs_out("  " + fs_var_text(i) + "\n")
                return
            }
            i--
        }
        forge gend = _globals_count
        if (_cur_fn_id < 0 && !_fs_ended) { gend = total }
        forge g = gend - 1
        while (g >= 0) {
            if (g < total) {
                forge s: stone = ofs_array_get(_env_sym, g)
                forge sn: obsidian = ofs_array_get(_sym_names, s)
                if (ofs_str_eq(sn, name) || ofs_str_eq(vein_display_name(sn), name)) {
                    fs_out("  " + fs_var_text(g) + "\n")
                    return
                }
            }
            g--
        }
        fs_out("  '" + name + "' nao existe neste ponto\n")
    }

    // ── modo interativo (ofs fossil replay --dig) ───────────────────────

    vein fs_help() -> void {
        fs_out("  segue [n]   (n)  avanca n passos mostrando a saida do programa\n")
        fs_out("  cava [n]    (b)  volta n passos no tempo\n")
        fs_out("  ir <alvo>   (g)  vai a um passo, L<linha>, arquivo.ofs:<linha> ou vein\n")
        fs_out("  ver <nome>  (p)  mostra uma variavel\n")
        fs_out("  estrato     (e)  mostra as variaveis locais e globais\n")
        fs_out("  onde        (w)  mostra o passo e a linha atuais\n")
        fs_out("  sai         (q)  encerra\n")
    }

    // le comandos ate um que mova a execucao para frente (volta da vein) ou
    // para tras (fs_travel, nao volta)
    vein fs_prompt(id: stone) -> void {
        _fs_mute = false
        fs_where(id)
        while (true) {
            fs_out("(fossil) ")
            forge line = fs_fd_line(0)
            if (_fs_eof && ofs_str_len(line) == 0) {
                fs_out("\n")
                fs_end(0)
                return
            }
            forge n = ofs_str_len(line)
            forge sp = 0
            while (sp < n && ofs_str_char_at(line, sp) != 32) { sp++ }
            forge cmd = ofs_str_substr(line, 0, sp)
            forge arg = ""
            if (sp < n) { arg = ofs_str_substr(line, sp + 1, n - sp - 1) }
            forge pos = _fs_steps
            if (_fs_ended) { pos = _fs_steps + 1 }
            if (ofs_str_eq(cmd, "segue") || ofs_str_eq(cmd, "n")) {
                forge cnt = 1
                if (fs_is_digits(arg)) { cnt = fs_int_of(arg) }
                if (_fs_ended) {
                    fs_out("  o programa ja terminou; use cava\n")
                } else {
                    _fs_stop = _fs_steps + cnt
                    _fs_soft = true
                    return
                }
            } else if (ofs_str_eq(cmd, "cava") || ofs_str_eq(cmd, "b")) {
                forge cnt = 1
                if (fs_is_digits(arg)) { cnt = fs_int_of(arg) }
                forge t = pos - cnt
                if (t < 1) { t = 1 }
                fs_travel(t)
                return
            } else if (ofs_str_eq(cmd, "ir") || ofs_str_eq(cmd, "g")) {
                if (fs_is_digits(arg)) {
                    forge t = fs_int_of(arg)
                    if (t < 1) { t = 1 }
                    if (t < pos) {
                        fs_travel(t)
                        return
                    }
                    if (t > pos && !_fs_ended) {
                        _fs_stop = t
                        _fs_mute = true
                        return
                    }
                    if (t > pos) { fs_out("  o programa terminou no passo " + ofs_stone_to_obsidian(_fs_steps) + "\n") }
                    else { fs_where(id) }
                } else if (_fs_ended) {
                    fs_out("  o programa ja terminou; use cava ou ir <passo>\n")
                } else if (ofs_str_len(arg) > 0 && fs_set_target(arg)) {
                    _fs_mute = true
                    return
                } else {
                    fs_out("  alvo invalido: " + arg + "\n")
                }
            } else if (ofs_str_eq(cmd, "ver") || ofs_str_eq(cmd, "p")) {
                fs_print_var(arg)
            } else if (ofs_str_eq(cmd, "estrato") || ofs_str_eq(cmd, "e")) {
                fs_show_vars()
            } else if (ofs_str_eq(cmd, "onde") || ofs_str_eq(cmd, "w")) {
                fs_where(id)
            } else if (ofs_str_eq(cmd, "sai") || ofs_str_eq(cmd, "q")) {
                fs_end(0)
                return
            } else if (ofs_str_eq(cmd, "ajuda") || ofs_str_eq(cmd, "h") || ofs_str_eq(cmd, "?")) {
                fs_help()
            } else if (n > 0) {
                fs_out("  comando desconhecido: " + cmd + " (ajuda lista os comandos)\n")
            }
        }
    }

    // ── chamadas externas ───────────────────────────────────────────────

    vein fs_spec_of(ei: stone) -> stone {
        while (ofs_array_len(_fs_spec) <= ei) { ofs_array_push(_fs_spec, -1) }
        forge c: stone = ofs_array_get(_fs_spec, ei)
        if (c >= 0) { return c }
        forge sym = ext_sym(ei)
        forge sp = fz_spec(sym)
        if (sp == 0 && ofs_str_len(_fs_world_extra) > 0 && fz_in(sym, _fs_world_extra)) { sp = fz_plain() }
        forge rcls: stone = ofs_array_get(_ext_rcls, ei)
        if (rcls == TC_AGG && (sp & 15) != FZ_EXIT) { sp = 0 }
        ofs_array_set(_fs_spec, ei, sp)
        return sp
    }

    vein fs_extern_enter(ei: stone, num_args: stone, arg_base: stone) -> void {
        forge sp = fs_spec_of(ei)
        if (sp == 0) { return }
        if ((sp & 15) == FZ_EXIT) {
            forge code = 0
            if (num_args > 0) { code = arg_i(arg_base) }
            fs_finish(code)
            return
        }
        _fs_pol = sp
        _fs_cur_sym = ext_sym(ei)
    }

    vein fs_arg(a: Array<stone>, i: stone) -> stone {
        if (i < 0 || i >= ofs_array_len(a)) { return 0 }
        forge v: stone = ofs_array_get(a, i)
        return v
    }

    // hash dos dados de saida pelos argumentos atuais (0 = sem conferencia)
    vein fs_out_hash(sp: stone, a: Array<stone>) -> stone {
        forge harg = fz_field(sp, 24)
        forge hk = fz_field(sp, 28)
        if (harg == FZ_NONE || hk == 0 || harg >= ofs_array_len(a)) { return 0 }
        forge p = fs_arg(a, harg)
        forge h = 1469598103934665603
        if (hk == FZ_HK_VAL) {
            h = fz_hash_int(p, h)
        } else {
            if (p == 0) { return 0 }
            forge n = 0
            if (hk == FZ_HK_A2) { n = fs_arg(a, 2) }
            else if (hk == FZ_HK_A1A2) { n = fs_arg(a, 1) * fs_arg(a, 2) }
            else { n = ofs_str_len(p as obsidian) }
            if (n < 0) { n = 0 }
            h = fz_hash_raw(p, n, h)
        }
        if (h == 0) { h = 1 }
        return h
    }

    // bytes que o C escreveu no argumento do efeito (0 = nenhum)
    vein fs_effect_len(sp: stone, r: stone, a: Array<stone>) -> stone {
        forge earg = fz_field(sp, 8)
        forge ek = fz_field(sp, 12)
        if (earg == FZ_NONE || ek == 0) { return 0 }
        forge p = fs_arg(a, earg)
        if (p == 0) { return 0 }
        if (ek == FZ_EK_R) {
            if (r > 0) { return r }
            return 0
        }
        if (ek == FZ_EK_RA1) {
            if (r > 0) { return r * fs_arg(a, 1) }
            return 0
        }
        if (ek == FZ_EK_STR) {
            if (r == 0) { return 0 }
            return ofs_str_len(p as obsidian) + 1
        }
        if (ek == FZ_EK_16) { return 16 }
        if (ek == FZ_EK_8) { return 8 }
        if (ek == FZ_EK_56) { return 56 }
        if (ek == FZ_EK_144) { return 144 }
        return 0
    }

    vein fs_arg_index(a: Array<stone>, v: stone) -> stone {
        forge i = 0
        while (i < ofs_array_len(a)) {
            forge x: stone = ofs_array_get(a, i)
            if (x == v) { return i }
            i++
        }
        return -1
    }

    vein fs_is_console(sp: stone, a: Array<stone>) -> bool {
        forge ck = fz_field(sp, 16)
        forge carg = fz_field(sp, 20)
        if (ck == FZ_CK_ALWAYS) { return true }
        if (ck == FZ_CK_FD) {
            forge fd = fs_arg(a, carg)
            return fd == 1 || fd == 2
        }
        if (ck == FZ_CK_FILE) {
            forge fp = fs_arg(a, carg)
            return fp == 0 || fp == _fs_stdout_fp || fp == _fs_stderr_fp
        }
        return false
    }

    // no lugar de ffi_invoke quando a chamada tem politica do fossil
    vein fs_invoke(sp: stone, addr: stone, nargs: stone, fmask: stone, retf: stone, vfixed: stone, what: obsidian, rcls: stone) -> stone {
        // argumentos inteiros/ponteiros antes da chamada (um callback pode
        // reusar o buffer do FFI)
        forge a: Array<stone> = []
        forge j = 0
        while (j < nargs) {
            ofs_array_push(a, ffi_get_i(j))
            j++
        }
        forge sym = _fs_cur_sym
        if (_fs_mode == 1) {
            forge h = fs_out_hash(sp, a)
            forge r = ffi_invoke(addr, nargs, fmask, retf, vfixed, what)
            forge fb = 0
            if (retf != 0) { fb = ffi_get_i(FFI_SLOT_RET) }
            fs_record(sp, sym, r, fb, h, a, rcls)
            return r
        }
        return fs_replay(sp, sym, addr, nargs, fmask, retf, vfixed, what, rcls, a)
    }

    vein fs_record(sp: stone, sym: obsidian, r: stone, fb: stone, h: stone, a: Array<stone>, rcls: stone) -> void {
        forge rm = fz_field(sp, 4)
        forge rk = 0
        forge rv = r
        if (rm == FZ_RM_OPAQUE && r != 0) { ofs_array_push(_fs_opaque, r) }
        if (r != 0 && rm == FZ_RM_RBUF) {
            rk = 3
        } else if (r != 0 && rm == FZ_RM_NORMAL && (rcls == TC_STR || rcls == TC_PTR)) {
            forge ai = fs_arg_index(a, r)
            if (ai >= 0) {
                rk = 2
                rv = ai
            } else if (rcls == TC_STR) {
                rk = 1
            }
        }
        forge ev = "E " + sym + " " + ofs_stone_to_obsidian(rk) + " " + ofs_stone_to_obsidian(rv)
        if (fb != 0 || h != 0) { ev = ev + " " + ofs_stone_to_obsidian(fb) }
        if (h != 0) { ev = ev + " " + ofs_stone_to_obsidian(h) }
        fz_put(ev + "\n")
        if (rk == 1) { fz_put_blob(r, ofs_str_len(r as obsidian)) }
        if (rk == 3) { fz_put_blob(r, FZ_RBUF_BYTES) }
        forge en = fs_effect_len(sp, r, a)
        if (en > 0) {
            forge earg = fz_field(sp, 8)
            fz_put("M " + ofs_stone_to_obsidian(earg) + " ")
            fz_put_blob(fs_arg(a, earg), en)
        }
        _fs_events++
        // em disco a cada evento: um programa que cai deixa a gravacao ate
        // a queda (OFS_FOSSIL_SYNC=0 so no fim, mais rapido)
        if (_fs_sync) { fz_sync() }
    }

    vein fs_diverge(msg: obsidian) -> void {
        fs_flush_all()
        ffi_stderr("ofs fossil: o replay divergiu no evento " + ofs_stone_to_obsidian(_fs_events + 1) + " (passo " + ofs_stone_to_obsidian(_fs_steps) + "): " + msg + "\n")
        fs_end(3)
    }

    vein fs_replay(sp: stone, sym: obsidian, addr: stone, nargs: stone, fmask: stone, retf: stone, vfixed: stone, what: obsidian, rcls: stone, a: Array<stone>) -> stone {
        if (fz_peek() != 69) {
            fs_diverge("a gravacao acabou, mas o programa chamou '" + sym + "'")
            return 0
        }
        fz_word()
        forge rsym = fz_word()
        forge rk = fz_int()
        forge rv = fz_int()
        forge fb = 0
        forge h = 0
        if (!_fz_eol) { fb = fz_int() }
        if (!_fz_eol) { h = fz_int() }
        if (!ofs_str_eq(rsym, sym)) {
            fs_diverge("a gravacao tem '" + rsym + "', o programa chamou '" + sym + "'")
            return 0
        }
        forge r = rv
        if (rk == 1 || rk == 3) {
            forge n = fz_int()
            forge src = fz_take(n)
            forge buf = ofs_alloc(n + 1) as stone
            fz_copy(buf, src, n)
            fz_set_byte(buf + n, 0)
            r = buf
        } else if (rk == 2) {
            r = fs_arg(a, rv)
        }
        if (fz_field(sp, 4) == FZ_RM_OPAQUE && r != 0) { ofs_array_push(_fs_opaque, r) }
        while (fz_peek() == 77) {
            fz_word()
            forge earg = fz_int()
            forge n = fz_int()
            forge src = fz_take(n)
            forge dst = fs_arg(a, earg)
            if (dst != 0) { fz_copy(dst, src, n) }
        }
        if (h != 0) {
            forge now = fs_out_hash(sp, a)
            if (now != h) {
                _fs_mismatch++
                if (_fs_mismatch <= 5) {
                    ffi_stderr("ofs fossil: aviso: a saida de '" + sym + "' (evento " + ofs_stone_to_obsidian(_fs_events + 1) + ") difere da gravada\n")
                }
            }
        }
        if ((sp & 15) == FZ_OUT && !_fs_mute && fs_is_console(sp, a)) {
            ffi_invoke(addr, nargs, fmask, retf, vfixed, what)
        }
        if (retf != 0) {
            ffi_put_i(FFI_SLOT_RET, fb)
            _ffi_ret_f = ffi_get_f(FFI_SLOT_RET)
        }
        _fs_events++
        return r
    }

    // fim do programa (main voltou, exit, erro de execucao)
    vein fs_finish(code: stone) -> void {
        if (_fs_mode == 1) {
            if (_fs_finished) { return }
            _fs_finished = true
            fz_put("F " + ofs_stone_to_obsidian(_fs_steps) + " " + ofs_stone_to_obsidian(_fs_events) + " " + ofs_stone_to_obsidian(code) + "\n")
            fz_close()
            fs_flush_all()
            ffi_stderr("ofs fossil: gravado em " + _fs_file + " (" + ofs_stone_to_obsidian(_fs_events) + " chamadas externas, " + ofs_stone_to_obsidian(_fs_steps) + " passos)\n")
            return
        }
        if (_fs_mode != 2 || _fs_ended) { return }
        _fs_ended = true
        _fs_code = code
        forge pending = (_fs_stop >= 0 && !_fs_soft) || _fs_wl >= 0 || _fs_wfirst >= 0
        forge rec_steps = -1
        if (fz_peek() == 70) {
            fz_word()
            rec_steps = fz_int()
            fz_int()
            fz_int()
        } else if (fz_peek() == 69) {
            ffi_stderr("ofs fossil: aviso: o programa terminou antes de fazer todas as chamadas externas gravadas\n")
        }
        if (rec_steps >= 0 && rec_steps != _fs_steps) {
            ffi_stderr("ofs fossil: aviso: o replay andou " + ofs_stone_to_obsidian(_fs_steps) + " passos; a gravacao, " + ofs_stone_to_obsidian(rec_steps) + "\n")
        }
        if (_fs_back > 0) {
            forge t = _fs_steps + 1 - _fs_back
            _fs_back = 0
            if (t < 1) { t = 1 }
            fs_travel(t)
            return
        }
        if (_fs_talk) {
            if (pending) { fs_out("fossil: o alvo nao foi alcancado\n") }
            fs_prompt(-1)
            fs_end(code)
            return
        }
        if (pending) {
            fs_flush_all()
            ffi_stderr("ofs fossil: alvo '" + _fs_to + "' nao alcancado (o programa terminou no passo " + ofs_stone_to_obsidian(_fs_steps) + ")\n")
            fs_end(1)
            return
        }
        if (_fs_mismatch > 0) {
            ffi_stderr("ofs fossil: " + ofs_stone_to_obsidian(_fs_mismatch) + " saida(s) diferentes da gravacao\n")
        }
        if (_fs_nav) { fs_end(code) }
    }

    vein run(root_id: stone) -> stone {
        _rk = VAL_VOID
        _rt = "void"
        _ri = 0
        _rf = 0.0
        _rb = false
        _rs = ""
        _rr = -1

        _nk = []
        _nval = []
        _ntype = []
        _nc0 = []
        _nc1 = []
        _nc2 = []
        _nc3 = []
        _nx = []
        _nop = []
        _naux = []
        _nf = []
        _nsym = []
        _n_count = 0

        _dyn_name = []
        _dyn_has_sep = []
        _dyn_var_sym = []
        _dyn_method = []
        _dyn_cache_type = []
        _dyn_cache_fn = []
        _dyn_cache_ok = []
        _dyn_errmsg = []

        _sym_names = []

        _env_sym = []
        _env_kind = []
        _env_type = []
        _env_i = []
        _env_f = []
        _env_b = []
        _env_s = []
        _env_ref = []
        _env_depth = []
        _scope_depth = 0
        _globals_count = 0
        _current_frame_base = 0
        _anchor_nodes = []
        _anchor_depths = []

        _arr_len = []
        _arr_mask = []
        _arr_ck = []
        _arr_ct = []
        _arr_ci = []
        _arr_cf = []
        _arr_cb = []
        _arr_cs = []
        _arr_cr = []

        _boxed_live = 0
        _ffi_sync_h = []
        _ffi_sync_c = []
        _cb_fn = []
        _cb_pcls = []
        _cb_ptypes = []
        _cb_rcls = []
        _cb_addr = []
        _ext_vref = []
        _cur_call_id = -1
        _hy_on = false
        _hy_depth = 0
        _hy_fid = []
        _hy_value_addr = []
        _hy_value_fid = []
        _hy_addr = []
        _hy_pcls = []
        _hy_rcls = []
        _hy_rtype = []
        _hy_gsym = []
        _hy_gidx = []
        _hy_gaddr = []
        _hy_gtype = []
        _hy_gcls = []
        _hy_garr = []
        _hy_gcol = []
        _hy_gptr = []
        _cr_enabled = true
        _cr_threshold = 1000
        _cr_heat = []
        _cr_eligible = []
        _cr_quartz = []
        _cr_names = []
        _cr_fids = []
        _cr_root = root_id
        _cr_started = false
        _cr_hot = false
        _cr_done = false
        _cr_pending = false
        _cr_so = ""
        _cr_dir = ""
        _cr_ready = ""
        _cr_log = ""

        _func_names = []
        _func_node_ids = []

        _ext_names = []
        _ext_syms = []
        _ext_nodes = []
        _ext_addr = []
        _ext_vfix = []
        _ext_pcls = []
        _ext_rcls = []
        _ext_rtype = []

        _mono_names = []
        _mono_ffirst = []
        _mono_fcount = []
        _mono_size = []
        _mono_last_idx = -1
        _mono_field_owners = []
        _mono_field_names = []
        _mono_field_types = []
        _mono_field_offs = []
        _mono_field_cls = []
        _variant_names = []
        _strata_names = []

        _arg_kinds = []
        _arg_types = []
        _arg_i = []
        _arg_f = []
        _arg_b = []
        _arg_s = []
        _arg_refs = []

        _ret_kind = 0
        _ret_type = "void"
        _ret_i = 0
        _ret_f = 0.0
        _ret_b = false
        _ret_s = ""
        _ret_ref = -1

        build_node_tables()
        collect_declarations(root_id)
        collect_strata()
        compute_layouts()
        annotate_nodes()
        resolve_calls()
        ffi_check_symbols()
        hy_prepare(root_id)
        if (_fs_mode != 0) { fs_start(root_id) }

        // Initialize global variables at file scope
        forge i = 0
        while (i < nx_len(root_id)) {
            forge decl_id = nx_at(root_id, i)
            forge dk = nk(decl_id)
            if (dk == NK_VAR_DECL || dk == NK_CONST_DECL) {
                execute_stmt(decl_id)
            } else if (dk == NK_NAMESPACE) {
                // globais declarados dentro de namespace (nomes ja mangled
                // pelo parser como ns__nome) tambem precisam existir
                forge nsj = 0
                while (nsj < nx_len(decl_id)) {
                    forge ns_decl = nx_at(decl_id, nsj)
                    forge nsk = nk(ns_decl)
                    if (nsk == NK_VAR_DECL || nsk == NK_CONST_DECL) {
                        execute_stmt(ns_decl)
                    }
                    nsj++
                }
            }
            i++
        }
        if (_rf_on) { rf_start(root_id) }
        _globals_count = ofs_array_len(_env_sym)
        _current_frame_base = _globals_count

        _cr_started = true

        // Locate main entry point
        forge main_node_id = find_function("main")
        if (main_node_id < 0) {
            forge k = 0
            while (k < nx_len(root_id)) {
                forge top_id = nx_at(root_id, k)
                if (nk(top_id) == NK_CORE_DECL) {
                    main_node_id = top_id
                    break
                }
                k++
            }
        }

        if (main_node_id < 0) {
            echo("Interpreter error: entry point 'core main()' or 'vein main()' not found")
            return 1
        }

        call_function(nval(main_node_id), 0, 0)
        cr_finish()

        if (_rk == VAL_INT) {
            return _ri
        }
        return 0
    }
}

// Entrada dos trampolins de callback (__ofs_cb_K, gerados pelo llvmgen no
// modulo que declara __ofs_cb_table): reentra no interpretador.
vein __ofs_cb_enter(slot: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone) -> stone {
    return interpreter.cb_enter(slot, a0, a1, a2, a3, a4, a5)
}

// Onda 4: trampolins com ponto flutuante (__ofs_cbx_K; os doubles chegam
// como bits) e o gancho dos lacos nativos da OSR na Fault Refract.
vein __ofs_cbx_enter(slot: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone, b0: stone, b1: stone, b2: stone, b3: stone, b4: stone, b5: stone, b6: stone, b7: stone) -> stone {
    return interpreter.cbx_enter(slot, a0, a1, a2, a3, a4, a5, b0, b1, b2, b3, b4, b5, b6, b7)
}

vein __ofs_osr_poll() -> stone {
    return interpreter.rf_osr_poll()
}

// monolith alocado pelo codigo nativo do modo hibrido (registro da Refract)
vein __ofs_obj_alloc(size: stone, name: obsidian) -> stone {
    return interpreter.obj_alloc_native(size, name)
}
