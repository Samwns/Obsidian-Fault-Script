// OFS Compiler — AST Interpreter Backend
// Direct evaluation backend executing typed AST without LLVM or C dependencies
//
// Memoria (A6): no codigo gerado pelo ofscc todo `forge x: <monolith>` (e toda
// copia `forge n: Node = node_get(id)`) vira um ofs_alloc que nunca e liberado.
// A versao anterior criava ~40 desses por chamada de funcao interpretada
// (Value de 56 B, Node de 80 B, Location), ~3 KB por chamada e ~4 KB por volta
// de laco. Por isso este interpretador NAO usa monolith nos caminhos quentes:
//   - o valor corrente vive em "registradores" globais (_rk/_rt/_ri/_rf/_rb/
//     _rs/_rr); eval_expr() escreve neles e os chamadores guardam o que
//     precisam em locais primitivos (alloca, sem heap);
//   - a AST e copiada uma vez, no inicio, para tabelas paralelas por no
//     (_nk/_nval/_nc0.. ) com o operador ja decodificado (_nop) e literais e
//     chamadas ja resolvidos (_naux/_nf);
//   - variaveis sao procuradas por id de simbolo (inteiro), nao por nome;
//   - arrays interpretados guardam so as colunas que diferem do padrao
//     (um Array<stone> de inteiros e um unico array nativo, nao sete).
// Strings novas (concatenacao, conversao) continuam sem liberacao, como no
// codigo nativo.
//
// Memoria crua (F2 de plans/INTERPRETADOR_PARIDADE.md): o processo do
// interpretador e nativo, entao ponteiro = endereco real (VAL_INT com tipo
// "*T"). `*p`/`*p = v` leem e escrevem pela largura do tipo apontado (o
// tipo estatico do typeck, como no llvmgen); `&x` de uma variavel muda a
// variavel para um slot de memoria crua (VAL_BOXED) que o C pode ler e
// escrever; monoliths vivem em memoria crua com o layout C do llvmgen
// (llvmgen.struct_layout) e o valor VAL_OBJECT e o endereco; Array vai ao C
// como o proprio ofs_array nativo da coluna de valores; `fault_addr` de uma
// vein interpretada devolve um trampolim nativo (__ofs_cb_K) que reentra no
// interpretador.

attach {F:ast.ofs}
attach {F:symbols.ofs}

extern vein ofs_str_len(s: obsidian) -> stone
extern vein ofs_str_eq(a: obsidian, b: obsidian) -> bool
extern vein ofs_str_concat(a: obsidian, b: obsidian) -> obsidian
extern vein ofs_str_char_at(s: obsidian, idx: stone) -> stone
extern vein ofs_str_substr(s: obsidian, start: stone, len: stone) -> obsidian
extern vein ofs_str_contains(haystack: obsidian, needle: obsidian) -> bool
extern vein ofs_stone_to_obsidian(v: stone) -> obsidian
extern vein ofs_crystal_to_obsidian(v: crystal) -> obsidian
extern vein ofs_pow(base: crystal, exp: crystal) -> crystal
extern vein ofs_sqrt(v: crystal) -> crystal
extern vein exit(code: stone) -> void
extern vein raise(sig: stone) -> stone

// FFI (F1): funcoes C resolvidas por endereco no carregamento. dlsym/dlopen
// estao na libc (glibc >= 2.34, bionic, macOS); glibc antiga precisa de -ldl
// no link do ofscc. __ofs_ffi_dispatch e DEFINIDA pelo llvmgen no modulo que
// a declara (trampolins tipados) e procurada por dlsym, nunca chamada direto:
// assim um ofscc gerado por um compilador antigo ainda liga (so sem floats).
extern vein dlsym(handle: stone, name: obsidian) -> stone
extern vein dlopen(path: obsidian, flags: stone) -> stone
extern vein write(fd: stone, buf: obsidian, n: stone) -> stone
extern vein __ofs_ffi_dispatch(fn: stone, sig: stone, buf: stone) -> stone
// Callbacks C -> OFS (F2): o llvmgen DEFINE __ofs_cb_table e os trampolins
// __ofs_cb_K no modulo que a declara; o interpretador a acha por dlsym (um
// ofscc gerado por compilador antigo liga, so sem callbacks).
extern vein __ofs_cb_table(slot: stone) -> stone
extern vein memset(dst: *u8, v: stone, n: stone) -> *u8

// ── Value System ──────────────────────────────────────────────────────────

forge VAL_VOID: stone = 0
forge VAL_INT: stone = 1
forge VAL_FLOAT: stone = 2
forge VAL_BOOL: stone = 3
forge VAL_STRING: stone = 4
forge VAL_ARRAY: stone = 5
forge VAL_OBJECT: stone = 6
forge VAL_POINTER: stone = 7
forge VAL_NULL: stone = 8
forge VAL_VARIANT: stone = 9
// variavel cujo endereco foi tomado (&x): o valor vive em memoria crua;
// _env_i = endereco, _env_type = tipo, _env_ref = classe de memoria (MC_*)
forge VAL_BOXED: stone = 10

forge EXEC_OK: stone = 0
forge EXEC_RETURN: stone = 1
forge EXEC_BREAK: stone = 2
forge EXEC_CONTINUE: stone = 3
forge EXEC_THROW: stone = 4

forge LOC_INVALID: stone = 0
forge LOC_VAR: stone = 1
forge LOC_ARRAY: stone = 2
forge LOC_FIELD: stone = 3
forge LOC_MEM: stone = 4

// Classe de memoria de um tipo: largura e conversao de leitura/escrita em
// memoria crua (ponteiro, campo de monolith, variavel com endereco)
forge MC_I64: stone = 0
forge MC_I32: stone = 1
forge MC_U32: stone = 2
forge MC_I16: stone = 3
forge MC_U16: stone = 4
forge MC_I8: stone = 5
forge MC_U8: stone = 6
forge MC_BOOL: stone = 7
forge MC_F64: stone = 8
forge MC_F32: stone = 9
forge MC_STR: stone = 10
forge MC_PTR: stone = 11
forge MC_ARRAY: stone = 12
forge MC_OBJ: stone = 13
forge MC_VARIANT: stone = 14

// Operadores decodificados uma vez (antes: ofs_str_eq por avaliacao e
// ofs_str_substr — que aloca — em todo `x += 1`).
forge OP_NONE: stone = 0
forge OP_ASSIGN: stone = 1
forge OP_ADD_ASSIGN: stone = 2
forge OP_SUB_ASSIGN: stone = 3
forge OP_MUL_ASSIGN: stone = 4
forge OP_DIV_ASSIGN: stone = 5
forge OP_MOD_ASSIGN: stone = 6
forge OP_LAND: stone = 7
forge OP_LOR: stone = 8
forge OP_EQ: stone = 9
forge OP_NE: stone = 10
forge OP_LT: stone = 11
forge OP_LE: stone = 12
forge OP_GT: stone = 13
forge OP_GE: stone = 14
forge OP_ADD: stone = 15
forge OP_SUB: stone = 16
forge OP_MUL: stone = 17
forge OP_DIV: stone = 18
forge OP_MOD: stone = 19
forge OP_BAND: stone = 20
forge OP_BOR: stone = 21
forge OP_BXOR: stone = 22
forge OP_SHL: stone = 23
forge OP_SHR: stone = 24
forge OP_ADDR: stone = 25
forge OP_DEREF: stone = 26
forge OP_NEG: stone = 27
forge OP_NOT: stone = 28
forge OP_BNOT: stone = 29
forge OP_TRY: stone = 30
forge OP_INC: stone = 31
forge OP_DEC: stone = 32

forge CAST_OTHER: stone = 0
forge CAST_STONE: stone = 1
forge CAST_CRYSTAL: stone = 2
forge CAST_BOOL: stone = 3
forge CAST_OBSIDIAN: stone = 4

forge CALL_BUILTIN: stone = 1
forge CALL_VARIANT: stone = 2
forge CALL_FN: stone = 3
forge CALL_DYN: stone = 4
forge CALL_EXTERN: stone = 5

// Classe de tipo de um parametro/retorno de `extern vein` (FFI)
forge TC_INT: stone = 0
forge TC_I32: stone = 1
forge TC_U32: stone = 2
forge TC_I16: stone = 3
forge TC_U16: stone = 4
forge TC_I8: stone = 5
forge TC_U8: stone = 6
forge TC_BOOL: stone = 7
forge TC_F64: stone = 8
forge TC_STR: stone = 9
forge TC_PTR: stone = 10
forge TC_VOID: stone = 11
forge TC_F32: stone = 12
forge TC_AGG: stone = 13

forge BI_NONE: stone = 0
forge BI_ECHO: stone = 1
forge BI_ETCH: stone = 2
forge BI_ETCHLN: stone = 3
forge BI_MOLD: stone = 4
forge BI_EXIT: stone = 5
forge BI_STR_LEN: stone = 6
forge BI_STR_EQ: stone = 7
forge BI_STR_CONCAT: stone = 8
forge BI_STR_CHAR_AT: stone = 9
forge BI_STR_SUBSTR: stone = 10
forge BI_STR_CONTAINS: stone = 11
forge BI_STONE_TO_OBS: stone = 12
forge BI_CRYSTAL_TO_OBS: stone = 13
forge BI_OBS_TO_STONE: stone = 14
forge BI_ARRAY_NEW: stone = 15
forge BI_ARRAY_LEN: stone = 16
forge BI_ARRAY_PUSH: stone = 17
forge BI_ARRAY_GET: stone = 18
forge BI_ARRAY_SET: stone = 19
forge BI_ARRAY_POP: stone = 20
forge BI_POW: stone = 21
forge BI_SQRT: stone = 22
forge BI_FAULT_COUNT: stone = 23
forge BI_FAULT_LEAD: stone = 24
forge BI_FAULT_TRAIL: stone = 25
forge BI_FAULT_SPIN_L: stone = 26
forge BI_FAULT_SPIN_R: stone = 27
forge BI_FAULT_WEAVE: stone = 28
forge BI_FAULT_SWAP: stone = 29
forge BI_FAULT_CUT: stone = 30
forge BI_FAULT_PATCH: stone = 31
forge BI_FAULT_NOP: stone = 32
forge BI_FAULT_TRAP: stone = 33
forge BI_FAULT_MEMCPY: stone = 34
forge BI_FAULT_MEMSET: stone = 35
forge BI_FAULT_ADDR: stone = 36
forge BI_FAULT_CALL: stone = 37
forge BI_FAULT_STEP: stone = 38
// conversoes para texto inseridas pelo typeck (F3); iguais ao llvmgen
forge BI_VARIANT_NAME: stone = 39
forge BI_BOOL_TEXT: stone = 40

// Colunas de um array interpretado (bitmask em _arr_mask)
forge COL_KIND: stone = 1
forge COL_TYPE: stone = 2
forge COL_I: stone = 4
forge COL_F: stone = 8
forge COL_B: stone = 16
forge COL_S: stone = 32
forge COL_REF: stone = 64

namespace interpreter {

    // ── Global Interpreter State ──────────────────────────────────────────
    // `?` com falha: vein em execucao e pedido de saida antecipada
    forge _cur_fn_id: stone = -1
    forge _try_unwind: bool = false

    // Registradores do valor corrente (resultado da ultima avaliacao)
    forge _rk: stone = 0
    forge _rt: obsidian = "void"
    forge _ri: stone = 0
    forge _rf: crystal = 0.0
    forge _rb: bool = false
    forge _rs: obsidian = ""
    forge _rr: stone = -1

    // Registradores de lvalue (resultado de eval_lvalue)
    forge _lk: stone = 0
    forge _lvar: stone = -1
    forge _lh: stone = -1
    forge _lidx: stone = -1
    forge _lfield: obsidian = ""

    // Tabelas da AST (copiadas do _node_pool uma vez por execucao)
    forge _n_count: stone = 0
    forge _nk: Array<stone> = []
    forge _nval: Array<obsidian> = []
    forge _ntype: Array<obsidian> = []
    forge _nc0: Array<stone> = []
    forge _nc1: Array<stone> = []
    forge _nc2: Array<stone> = []
    forge _nc3: Array<stone> = []
    forge _nx: Array<Array> = []
    forge _nop: Array<stone> = []
    forge _naux: Array<stone> = []
    forge _nf: Array<crystal> = []
    forge _nsym: Array<stone> = []
    forge _empty_extra: Array<stone> = []

    // Chamadas dinamicas (metodo `obj.m`/`obj__m` resolvido pelo tipo em
    // tempo de execucao): partes do nome e cache do ultimo tipo visto.
    forge _dyn_name: Array<obsidian> = []
    forge _dyn_has_sep: Array<bool> = []
    forge _dyn_var_sym: Array<stone> = []
    forge _dyn_method: Array<obsidian> = []
    forge _dyn_cache_type: Array<obsidian> = []
    forge _dyn_cache_fn: Array<stone> = []
    forge _dyn_cache_ok: Array<bool> = []
    forge _dyn_errmsg: Array<obsidian> = []

    // Tabela de simbolos (nomes de variaveis -> id)
    forge _sym_names: Array<obsidian> = []

    // Environment (scoped variables stored in parallel arrays of primitive types)
    forge _env_sym: Array<stone> = []
    forge _env_kind: Array<stone> = []
    forge _env_type: Array<obsidian> = []
    forge _env_i: Array<stone> = []
    forge _env_f: Array<crystal> = []
    forge _env_b: Array<bool> = []
    forge _env_s: Array<obsidian> = []
    forge _env_ref: Array<stone> = []
    forge _env_depth: Array<stone> = []
    forge _scope_depth: stone = 0
    forge _globals_count: stone = 0
    forge _current_frame_base: stone = 0
    forge _anchor_nodes: Array<stone> = []
    forge _anchor_depths: Array<stone> = []

    // Heap Arrays: por instancia, comprimento + mascara de colunas presentes.
    // Coluna ausente = todos os elementos tem o valor padrao dela
    // (kind=VAL_INT, type=nome canonico do kind, i=0, f=0.0, b=false, s="",
    // ref=-1). _arr_nocol e a sentinela (nunca escrita) das colunas ausentes.
    forge _arr_len: Array<stone> = []
    forge _arr_mask: Array<stone> = []
    forge _arr_ck: Array<Array> = []
    forge _arr_ct: Array<Array> = []
    forge _arr_ci: Array<Array> = []
    forge _arr_cf: Array<Array> = []
    forge _arr_cb: Array<Array> = []
    forge _arr_cs: Array<Array> = []
    forge _arr_cr: Array<Array> = []
    forge _arr_nocol: Array<stone> = []

    // Variaveis com endereco (VAL_BOXED) vivas: 0 = caminho rapido sem checar
    forge _boxed_live: stone = 0

    // Function Registry
    forge _func_names: Array<obsidian> = []
    forge _func_node_ids: Array<stone> = []

    // Monolith Type Registry. Instancias sao blocos de memoria crua (o
    // VAL_OBJECT guarda o endereco) com o layout C de llvmgen.struct_layout;
    // os campos de um tipo sao contiguos nas tabelas _mono_field_*.
    forge _mono_names: Array<obsidian> = []
    forge _mono_ffirst: Array<stone> = []
    forge _mono_fcount: Array<stone> = []
    forge _mono_size: Array<stone> = []
    forge _mono_field_owners: Array<obsidian> = []
    forge _mono_field_names: Array<obsidian> = []
    forge _mono_field_types: Array<obsidian> = []
    forge _mono_field_offs: Array<stone> = []
    forge _mono_field_cls: Array<stone> = []
    // variantes em ordem de declaracao (etiqueta numerica = posicao)
    forge _variant_names: Array<obsidian> = []
    forge _strata_names: Array<obsidian> = []

    // Call Argument Stack
    forge _arg_kinds: Array<stone> = []
    forge _arg_types: Array<obsidian> = []
    forge _arg_i: Array<stone> = []
    forge _arg_f: Array<crystal> = []
    forge _arg_b: Array<bool> = []
    forge _arg_s: Array<obsidian> = []
    forge _arg_refs: Array<stone> = []

    // Return Value Register
    forge _ret_kind: stone = 0
    forge _ret_type: obsidian = "void"
    forge _ret_i: stone = 0
    forge _ret_f: crystal = 0.0
    forge _ret_b: bool = false
    forge _ret_s: obsidian = ""
    forge _ret_ref: stone = -1

    // FFI: tabela das `extern vein`/`rift vein` (montada no carregamento)
    forge _ext_names: Array<obsidian> = []
    forge _ext_syms: Array<obsidian> = []
    forge _ext_nodes: Array<stone> = []
    forge _ext_addr: Array<stone> = []
    forge _ext_vfix: Array<stone> = []
    forge _ext_pcls: Array<Array> = []
    forge _ext_rcls: Array<stone> = []
    forge _ext_rtype: Array<obsidian> = []
    forge _ffi_ready: bool = false
    forge _ffi_buf: stone = 0
    forge _ffi_disp: stone = 0
    forge _ffi_exports: bool = false
    forge _ffi_libs: obsidian = ""
    forge _ffi_ui_libs: bool = false
    // Arrays passados ao C na chamada em curso (comprimento sincronizado na volta)
    forge _ffi_sync_h: Array<stone> = []
    forge _ffi_sync_c: Array<stone> = []
    forge _arr_last_col: stone = 0
    // Callbacks: slot K -> vein interpretada (ver cb_slot_for)
    forge _cb_table: stone = 0
    forge _cb_fn: Array<stone> = []
    forge _cb_pcls: Array<Array> = []
    forge _cb_ptypes: Array<Array> = []
    forge _cb_rcls: Array<stone> = []
    // no da chamada em curso (fault_step le o tipo estatico do argumento)
    forge _cur_call_id: stone = -1

    // ── Value Registers ───────────────────────────────────────────────────

    vein r_set(k: stone, t: obsidian, i: stone, f: crystal, b: bool, s: obsidian, r: stone) -> void {
        _rk = k
        _rt = t
        _ri = i
        _rf = f
        _rb = b
        _rs = s
        _rr = r
    }

    vein r_void() -> void { r_set(VAL_VOID, "void", 0, 0.0, false, "", -1) }
    vein r_int(i: stone) -> void { r_set(VAL_INT, "stone", i, 0.0, false, "", -1) }
    vein r_float(f: crystal) -> void { r_set(VAL_FLOAT, "crystal", 0, f, false, "", -1) }
    vein r_bool(b: bool) -> void { r_set(VAL_BOOL, "bool", 0, 0.0, b, "", -1) }
    vein r_string(s: obsidian) -> void { r_set(VAL_STRING, "obsidian", 0, 0.0, false, s, -1) }
    vein r_array(h: stone) -> void { r_set(VAL_ARRAY, "Array", 0, 0.0, false, "", h) }
    vein r_object(type_name: obsidian, h: stone) -> void { r_set(VAL_OBJECT, type_name, 0, 0.0, false, "", h) }
    vein r_null() -> void { r_set(VAL_NULL, "null", 0, 0.0, false, "", -1) }

    // Variante `tag` com o valor dos registradores como payload
    vein r_variant(tag: obsidian) -> void {
        forge pk = _rk
        forge pi = _ri
        forge pf: crystal = _rf
        forge pb = _rb
        forge ps: obsidian = _rs
        forge pr = _rr
        r_set(VAL_VARIANT, tag, 0, 0.0, false, tag, -1)
        if (pk == VAL_INT) { _ri = pi }
        else if (pk == VAL_FLOAT) { _rf = pf }
        else if (pk == VAL_BOOL) { _rb = pb }
        else if (pk == VAL_STRING) { _rs = ps }
        else if (pk == VAL_OBJECT || pk == VAL_ARRAY || pk == VAL_POINTER || pk == VAL_NULL) {
            _rr = pr
        }
    }

    // Nome de tipo que os construtores de valor usam para cada kind
    vein kind_type_name(k: stone) -> obsidian {
        if (k == VAL_INT) { return "stone" }
        if (k == VAL_FLOAT) { return "crystal" }
        if (k == VAL_BOOL) { return "bool" }
        if (k == VAL_STRING) { return "obsidian" }
        if (k == VAL_ARRAY) { return "Array" }
        if (k == VAL_NULL) { return "null" }
        if (k == VAL_VOID) { return "void" }
        if (k == VAL_POINTER) { return "ptr" }
        return ""
    }

    // ── Value Inspection ──────────────────────────────────────────────────

    vein val_str(k: stone, t: obsidian, i: stone, f: crystal, b: bool, s: obsidian) -> obsidian {
        if (k == VAL_VOID) { return "" }
        if (k == VAL_INT) { return ofs_stone_to_obsidian(i) }
        if (k == VAL_FLOAT) {
            return ofs_crystal_to_obsidian(f)
        }
        if (k == VAL_BOOL) {
            if (b) { return "true" }
            return "false"
        }
        if (k == VAL_STRING) { return s }
        if (k == VAL_ARRAY) { return "[array]" }
        if (k == VAL_OBJECT) { return "[" + t + "]" }
        if (k == VAL_POINTER) { return "*ptr" }
        if (k == VAL_NULL) { return "null" }
        if (k == VAL_VARIANT) { return t }
        return ""
    }

    vein r_to_string() -> obsidian {
        return val_str(_rk, _rt, _ri, _rf, _rb, _rs)
    }

    vein val_truthy(k: stone, i: stone, f: crystal, b: bool, s: obsidian, r: stone) -> bool {
        if (k == VAL_BOOL) { return b }
        if (k == VAL_INT) { return i != 0 }
        if (k == VAL_FLOAT) { return f != 0.0 }
        if (k == VAL_STRING) { return ofs_str_len(s) > 0 }
        if (k == VAL_ARRAY) { return r >= 0 }
        if (k == VAL_OBJECT) { return r >= 0 }
        if (k == VAL_POINTER) { return r >= 0 }
        if (k == VAL_NULL) { return false }
        if (k == VAL_VOID) { return false }
        if (k == VAL_VARIANT) { return true }
        return false
    }

    vein r_truthy() -> bool {
        return val_truthy(_rk, _ri, _rf, _rb, _rs, _rr)
    }

    // ── Return Value Helpers ──────────────────────────────────────────────

    vein set_return_from_regs() -> void {
        _ret_kind = _rk
        _ret_type = _rt
        _ret_i = _ri
        _ret_f = _rf
        _ret_b = _rb
        _ret_s = _rs
        _ret_ref = _rr
    }

    vein regs_from_return() -> void {
        r_set(_ret_kind, _ret_type, _ret_i, _ret_f, _ret_b, _ret_s, _ret_ref)
    }

    // ── Number and Text Parsing ───────────────────────────────────────────

    vein parse_int(s: obsidian) -> stone {
        forge len = ofs_str_len(s)
        if (len == 0) { return 0 }
        forge res = 0
        forge i = 0
        forge neg = false
        if (ofs_str_char_at(s, 0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            forge c = ofs_str_char_at(s, i)
            if (c >= 48 && c <= 57) {
                res = res * 10 + (c - 48)
            } else {
                break
            }
            i++
        }
        if (neg) { return 0 - res }
        return res
    }

    vein parse_float(s: obsidian) -> crystal {
        forge len = ofs_str_len(s)
        if (len == 0) { return 0.0 }
        forge res: crystal = 0.0
        forge i = 0
        forge neg = false
        if (ofs_str_char_at(s, 0) == 45) {
            neg = true
            i = 1
        }
        forge in_dec = false
        forge dec_div: crystal = 10.0
        while (i < len) {
            forge c = ofs_str_char_at(s, i)
            if (c == 46) {
                in_dec = true
                i++
                break
            }
            if (c >= 48 && c <= 57) {
                res = res * 10.0 + ((c - 48) as crystal)
            } else {
                break
            }
            i++
        }
        if (in_dec) {
            while (i < len) {
                forge c2 = ofs_str_char_at(s, i)
                if (c2 >= 48 && c2 <= 57) {
                    res = res + (((c2 - 48) as crystal) / dec_div)
                    dec_div = dec_div * 10.0
                } else {
                    break
                }
                i++
            }
        }
        if (neg) { return 0.0 - res }
        return res
    }

    // ── AST Tables ────────────────────────────────────────────────────────

    vein bin_op_code(op: obsidian) -> stone {
        if (ofs_str_eq(op, "=")) { return OP_ASSIGN }
        if (ofs_str_eq(op, "+=")) { return OP_ADD_ASSIGN }
        if (ofs_str_eq(op, "-=")) { return OP_SUB_ASSIGN }
        if (ofs_str_eq(op, "*=")) { return OP_MUL_ASSIGN }
        if (ofs_str_eq(op, "/=")) { return OP_DIV_ASSIGN }
        if (ofs_str_eq(op, "%=")) { return OP_MOD_ASSIGN }
        if (ofs_str_eq(op, "&&")) { return OP_LAND }
        if (ofs_str_eq(op, "||")) { return OP_LOR }
        if (ofs_str_eq(op, "==")) { return OP_EQ }
        if (ofs_str_eq(op, "!=")) { return OP_NE }
        if (ofs_str_eq(op, "<")) { return OP_LT }
        if (ofs_str_eq(op, "<=")) { return OP_LE }
        if (ofs_str_eq(op, ">")) { return OP_GT }
        if (ofs_str_eq(op, ">=")) { return OP_GE }
        if (ofs_str_eq(op, "+")) { return OP_ADD }
        if (ofs_str_eq(op, "-")) { return OP_SUB }
        if (ofs_str_eq(op, "*")) { return OP_MUL }
        if (ofs_str_eq(op, "/")) { return OP_DIV }
        if (ofs_str_eq(op, "%")) { return OP_MOD }
        if (ofs_str_eq(op, "&")) { return OP_BAND }
        if (ofs_str_eq(op, "|")) { return OP_BOR }
        if (ofs_str_eq(op, "^")) { return OP_BXOR }
        if (ofs_str_eq(op, "<<")) { return OP_SHL }
        if (ofs_str_eq(op, ">>")) { return OP_SHR }
        return OP_NONE
    }

    vein unary_op_code(op: obsidian) -> stone {
        if (ofs_str_eq(op, "&")) { return OP_ADDR }
        if (ofs_str_eq(op, "*")) { return OP_DEREF }
        if (ofs_str_eq(op, "-")) { return OP_NEG }
        if (ofs_str_eq(op, "!")) { return OP_NOT }
        if (ofs_str_eq(op, "~")) { return OP_BNOT }
        return OP_NONE
    }

    vein post_op_code(op: obsidian) -> stone {
        if (ofs_str_eq(op, "?")) { return OP_TRY }
        if (ofs_str_eq(op, "++")) { return OP_INC }
        return OP_DEC
    }

    vein cast_code(t: obsidian) -> stone {
        if (ofs_str_eq(t, "stone")) { return CAST_STONE }
        if (ofs_str_eq(t, "crystal")) { return CAST_CRYSTAL }
        if (ofs_str_eq(t, "bool")) { return CAST_BOOL }
        if (ofs_str_eq(t, "obsidian")) { return CAST_OBSIDIAN }
        return CAST_OTHER
    }

    // intrinsecos fault_* (mesma semantica do llvmgen, em 64 bits)
    vein fault_code(name: obsidian) -> stone {
        if (ofs_str_eq(name, "fault_count")) { return BI_FAULT_COUNT }
        if (ofs_str_eq(name, "fault_lead")) { return BI_FAULT_LEAD }
        if (ofs_str_eq(name, "fault_trail")) { return BI_FAULT_TRAIL }
        if (ofs_str_eq(name, "fault_spin_left")) { return BI_FAULT_SPIN_L }
        if (ofs_str_eq(name, "fault_spin_right")) { return BI_FAULT_SPIN_R }
        if (ofs_str_eq(name, "fault_weave")) { return BI_FAULT_WEAVE }
        if (ofs_str_eq(name, "fault_swap")) { return BI_FAULT_SWAP }
        if (ofs_str_eq(name, "fault_cut")) { return BI_FAULT_CUT }
        if (ofs_str_eq(name, "fault_patch")) { return BI_FAULT_PATCH }
        if (ofs_str_eq(name, "fault_fence")) { return BI_FAULT_NOP }
        if (ofs_str_eq(name, "fault_prefetch")) { return BI_FAULT_NOP }
        if (ofs_str_eq(name, "fault_trap")) { return BI_FAULT_TRAP }
        if (ofs_str_eq(name, "fault_unreachable")) { return BI_FAULT_TRAP }
        if (ofs_str_eq(name, "fault_memcpy")) { return BI_FAULT_MEMCPY }
        if (ofs_str_eq(name, "fault_memset")) { return BI_FAULT_MEMSET }
        if (ofs_str_eq(name, "fault_addr")) { return BI_FAULT_ADDR }
        if (ofs_str_eq(name, "fault_call")) { return BI_FAULT_CALL }
        if (ofs_str_eq(name, "fault_step")) { return BI_FAULT_STEP }
        return BI_NONE
    }

    vein builtin_code(name: obsidian) -> stone {
        if (ofs_str_eq(name, "echo")) { return BI_ECHO }
        if (ofs_str_eq(name, "etch")) { return BI_ETCH }
        if (ofs_str_eq(name, "etchln")) { return BI_ETCHLN }
        if (ofs_str_eq(name, "mold")) { return BI_MOLD }
        if (ofs_str_eq(name, "exit")) { return BI_EXIT }
        if (ofs_str_eq(name, "ofs_str_len")) { return BI_STR_LEN }
        if (ofs_str_eq(name, "ofs_str_eq")) { return BI_STR_EQ }
        if (ofs_str_eq(name, "ofs_str_concat")) { return BI_STR_CONCAT }
        if (ofs_str_eq(name, "ofs_str_char_at")) { return BI_STR_CHAR_AT }
        if (ofs_str_eq(name, "ofs_str_substr")) { return BI_STR_SUBSTR }
        if (ofs_str_eq(name, "ofs_str_contains")) { return BI_STR_CONTAINS }
        if (ofs_str_eq(name, "ofs_stone_to_obsidian")) { return BI_STONE_TO_OBS }
        if (ofs_str_eq(name, "ofs_crystal_to_obsidian")) { return BI_CRYSTAL_TO_OBS }
        if (ofs_str_eq(name, "ofs_obsidian_to_stone")) { return BI_OBS_TO_STONE }
        if (ofs_str_eq(name, "ofs_array_new")) { return BI_ARRAY_NEW }
        if (ofs_str_eq(name, "ofs_array_len")) { return BI_ARRAY_LEN }
        if (ofs_str_eq(name, "ofs_array_push")) { return BI_ARRAY_PUSH }
        if (ofs_str_eq(name, "ofs_array_get")) { return BI_ARRAY_GET }
        if (ofs_str_eq(name, "ofs_array_set")) { return BI_ARRAY_SET }
        if (ofs_str_eq(name, "ofs_array_pop")) { return BI_ARRAY_POP }
        if (ofs_str_eq(name, "ofs_pow")) { return BI_POW }
        if (ofs_str_eq(name, "ofs_sqrt")) { return BI_SQRT }
        if (ofs_str_eq(name, "__ofs_variant_name")) { return BI_VARIANT_NAME }
        if (ofs_str_eq(name, "__ofs_bool_text")) { return BI_BOOL_TEXT }
        if (ofs_str_char_at(name, 0) == 102 && ofs_str_len(name) > 6) { return fault_code(name) }
        return BI_NONE
    }

    vein starts_upper(s: obsidian) -> bool {
        if (ofs_str_len(s) == 0) { return false }
        forge c = ofs_str_char_at(s, 0)
        return c >= 65 && c <= 90
    }

    // Copia o _node_pool para as tabelas (unica copia de Node por no)
    vein build_node_tables() -> void {
        forge cnt = node_pool_len()
        _n_count = cnt
        forge i = 0
        while (i < cnt) {
            forge n: Node = node_get(i)
            ofs_array_push(_nk, n.kind)
            ofs_array_push(_nval, n.val)
            ofs_array_push(_ntype, n.type_str)
            ofs_array_push(_nc0, n.c0)
            ofs_array_push(_nc1, n.c1)
            ofs_array_push(_nc2, n.c2)
            ofs_array_push(_nc3, n.c3)
            ofs_array_push(_nx, n.extra)
            ofs_array_push(_nsym, -1)
            forge op = 0
            forge aux = 0
            forge fv: crystal = 0.0
            if (n.kind == NK_BIN_OP) { op = bin_op_code(n.val) }
            else if (n.kind == NK_UNARY_OP) { op = unary_op_code(n.val) }
            else if (n.kind == NK_POST_OP) { op = post_op_code(n.val) }
            else if (n.kind == NK_CAST) { op = cast_code(n.val) }
            else if (n.kind == NK_LIT_INT) { aux = parse_int(n.val) }
            else if (n.kind == NK_LIT_FLOAT) { fv = parse_float(n.val) }
            else if (n.kind == NK_LIT_BOOL) {
                if (ofs_str_eq(n.val, "true")) { aux = 1 }
            }
            else if (n.kind == NK_IDENT) {
                // variante: nome com inicial maiuscula que o typeck nao
                // resolveu como variavel (tipo "variant", ou no nao visitado).
                // Antes bastava a inicial maiuscula, e um global
                // `forge LIMITE = 5` valia a variante "LIMITE" no `ofs run`
                // (no nativo, 5).
                if (starts_upper(n.val) && (ofs_str_eq(n.type_str, "variant") || ofs_str_eq(n.type_str, ""))) { op = 1 }
            }
            ofs_array_push(_nop, op)
            ofs_array_push(_naux, aux)
            ofs_array_push(_nf, fv)
            i++
        }
    }

    vein nk(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge k: stone = ofs_array_get(_nk, id)
        return k
    }

    vein nval(id: stone) -> obsidian {
        if (id < 0 || id >= _n_count) { return "" }
        forge v: obsidian = ofs_array_get(_nval, id)
        return v
    }

    vein ntype(id: stone) -> obsidian {
        if (id < 0 || id >= _n_count) { return "" }
        forge v: obsidian = ofs_array_get(_ntype, id)
        return v
    }

    vein nc0(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc0, id)
        return c
    }

    vein nc1(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc1, id)
        return c
    }

    vein nc2(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc2, id)
        return c
    }

    vein nc3(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge c: stone = ofs_array_get(_nc3, id)
        return c
    }

    vein nop(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return 0 }
        forge c: stone = ofs_array_get(_nop, id)
        return c
    }

    vein naux(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return 0 }
        forge c: stone = ofs_array_get(_naux, id)
        return c
    }

    vein nextra(id: stone) -> Array<stone> {
        if (id < 0 || id >= _n_count) { return _empty_extra }
        forge x: Array<stone> = ofs_array_get(_nx, id)
        return x
    }

    vein nx_len(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return 0 }
        forge x: Array<stone> = ofs_array_get(_nx, id)
        return ofs_array_len(x)
    }

    vein nx_at(id: stone, index: stone) -> stone {
        if (id < 0 || id >= _n_count) { return -1 }
        forge x: Array<stone> = ofs_array_get(_nx, id)
        if (index < 0 || index >= ofs_array_len(x)) { return -1 }
        forge c: stone = ofs_array_get(x, index)
        return c
    }

    // ── Symbols ───────────────────────────────────────────────────────────

    vein sym_lookup(name: obsidian) -> stone {
        forge i = 0
        forge len = ofs_array_len(_sym_names)
        while (i < len) {
            forge s: obsidian = ofs_array_get(_sym_names, i)
            if (ofs_str_eq(s, name)) { return i }
            i++
        }
        return -1
    }

    vein sym_intern(name: obsidian) -> stone {
        forge s = sym_lookup(name)
        if (s >= 0) { return s }
        ofs_array_push(_sym_names, name)
        return ofs_array_len(_sym_names) - 1
    }

    // Id do simbolo do nome de um no (IDENT, VAR_DECL, PARAM...), cacheado
    vein node_sym(id: stone) -> stone {
        if (id < 0 || id >= _n_count) { return sym_intern("") }
        forge s: stone = ofs_array_get(_nsym, id)
        if (s >= 0) { return s }
        forge v: obsidian = ofs_array_get(_nval, id)
        s = sym_intern(v)
        ofs_array_set(_nsym, id, s)
        return s
    }

    // ── Memoria crua (F2) ────────────────────────────────────────────────
    // Leitura/escrita por largura usando o proprio codigo nativo do
    // interpretador (o llvmgen gera load/store i8/i16/i32/i64/float/double).
    // Inteiros estreitos ficam na forma canonica do nativo (widen_int):
    // sinal estendido para iN, zeros para uN.

    vein is_strata_type(t: obsidian) -> bool {
        forge i = 0
        while (i < ofs_array_len(_strata_names)) {
            forge sn: obsidian = ofs_array_get(_strata_names, i)
            if (ofs_str_eq(sn, t)) { return true }
            i++
        }
        return false
    }

    // classe de memoria do tipo t (MC_*); desconhecido = 8 bytes inteiro
    vein mem_class(t: obsidian) -> stone {
        forge n = ofs_str_len(t)
        if (n == 0) { return MC_I64 }
        forge c0 = ofs_str_char_at(t, 0)
        if (c0 == 42) { return MC_PTR }
        if (ofs_str_eq(t, "stone") || ofs_str_eq(t, "i64") || ofs_str_eq(t, "u64") || ofs_str_eq(t, "unknown")) { return MC_I64 }
        if (ofs_str_eq(t, "crystal") || ofs_str_eq(t, "f64")) { return MC_F64 }
        if (ofs_str_eq(t, "obsidian")) { return MC_STR }
        if (ofs_str_eq(t, "bool") || ofs_str_eq(t, "bool1")) { return MC_BOOL }
        if (ofs_str_eq(t, "u8")) { return MC_U8 }
        if (ofs_str_eq(t, "i8")) { return MC_I8 }
        if (ofs_str_eq(t, "u16")) { return MC_U16 }
        if (ofs_str_eq(t, "i16")) { return MC_I16 }
        if (ofs_str_eq(t, "u32")) { return MC_U32 }
        if (ofs_str_eq(t, "i32")) { return MC_I32 }
        if (ofs_str_eq(t, "f32")) { return MC_F32 }
        if (ofs_str_eq(t, "ptr")) { return MC_PTR }
        if (ofs_str_eq(t, "variant")) { return MC_VARIANT }
        if (c0 == 65 && n >= 5 && ofs_str_eq(ofs_str_substr(t, 0, 5), "Array")) { return MC_ARRAY }
        if (mono_index(t) >= 0) { return MC_OBJ }
        if (is_strata_type(t)) { return MC_VARIANT }
        return MC_I64
    }

    vein mc_is_narrow(c: stone) -> bool {
        return c >= MC_I32 && c <= MC_U8
    }

    vein mc_is_unsigned(c: stone) -> bool {
        return c == MC_U32 || c == MC_U16 || c == MC_U8
    }

    // bits do tipo LLVM da classe (llvmgen.llvm_type/int_bitwidth)
    vein mc_bits(c: stone) -> stone {
        if (c == MC_I32 || c == MC_U32 || c == MC_BOOL || c == MC_F32) { return 32 }
        if (c == MC_I16 || c == MC_U16) { return 16 }
        if (c == MC_I8 || c == MC_U8) { return 8 }
        return 64
    }

    vein mc_name(c: stone) -> obsidian {
        if (c == MC_I32) { return "i32" }
        if (c == MC_U32) { return "u32" }
        if (c == MC_I16) { return "i16" }
        if (c == MC_U16) { return "u16" }
        if (c == MC_I8) { return "i8" }
        if (c == MC_U8) { return "u8" }
        if (c == MC_F32) { return "f32" }
        if (c == MC_BOOL) { return "bool" }
        if (c == MC_F64) { return "crystal" }
        if (c == MC_STR) { return "obsidian" }
        return "stone"
    }

    // v (64 bits) truncado para a classe e na forma canonica dela
    vein mc_canon(c: stone, v: stone) -> stone {
        if (c == MC_I32) { return ((v & 4294967295) ^ 2147483648) - 2147483648 }
        if (c == MC_U32 || c == MC_BOOL) { return v & 4294967295 }
        if (c == MC_I16) { return ((v & 65535) ^ 32768) - 32768 }
        if (c == MC_U16) { return v & 65535 }
        if (c == MC_I8) { return ((v & 255) ^ 128) - 128 }
        if (c == MC_U8) { return v & 255 }
        return v
    }

    // conversao implicita ao gravar numa variavel/parametro do tipo da
    // classe c (coerce_for_store do llvmgen): trunc de inteiro estreito,
    // arredondamento de f32. So classes estreitas chegam aqui.
    vein coerce_regs(c: stone) -> void {
        if (c == MC_F32) {
            if (_rk == VAL_FLOAT) {
                _rf = f32_round(_rf)
                _rt = "f32"
            }
            return
        }
        if (_rk == VAL_INT) {
            _ri = mc_canon(c, _ri)
            _rt = mc_name(c)
        }
    }

    vein coerce_code(t: obsidian) -> stone {
        forge c = mem_class(t)
        if (mc_is_narrow(c) || c == MC_F32) { return c }
        return 0
    }

    vein f32_round(f: crystal) -> crystal {
        forge x: f32 = f as f32
        return x as crystal
    }

    // inteiro (bits brutos, canonicos) no endereco a
    vein mem_rd(a: stone, c: stone) -> stone {
        if (c == MC_U8 || c == MC_I8) {
            forge p8: *u8 = a as *u8
            forge v8: u8 = 0
            fracture { v8 = *p8 }
            return mc_canon(c, v8 as stone)
        }
        if (c == MC_U16 || c == MC_I16) {
            forge p16: *u16 = a as *u16
            forge v16: u16 = 0
            fracture { v16 = *p16 }
            return mc_canon(c, v16 as stone)
        }
        if (c == MC_U32 || c == MC_I32 || c == MC_BOOL || c == MC_F32) {
            forge p32: *u32 = a as *u32
            forge v32: u32 = 0
            fracture { v32 = *p32 }
            return mc_canon(c, v32 as stone)
        }
        forge p64: *stone = a as *stone
        forge v64: stone = 0
        fracture { v64 = *p64 }
        return v64
    }

    vein mem_wr(a: stone, c: stone, v: stone) -> void {
        if (c == MC_U8 || c == MC_I8) {
            forge p8: *u8 = a as *u8
            fracture { *p8 = v as u8 }
            return
        }
        if (c == MC_U16 || c == MC_I16) {
            forge p16: *u16 = a as *u16
            fracture { *p16 = v as u16 }
            return
        }
        if (c == MC_U32 || c == MC_I32 || c == MC_BOOL) {
            forge p32: *u32 = a as *u32
            fracture { *p32 = v as u32 }
            return
        }
        forge p64: *stone = a as *stone
        fracture { *p64 = v }
    }

    vein mem_rd_f(a: stone, c: stone) -> crystal {
        if (c == MC_F32) {
            forge pf: *f32 = a as *f32
            fracture { return (*pf) as crystal }
        }
        forge pd: *crystal = a as *crystal
        forge d: crystal = 0.0
        fracture { d = *pd }
        return d
    }

    vein mem_wr_f(a: stone, c: stone, f: crystal) -> void {
        if (c == MC_F32) {
            forge pf: *f32 = a as *f32
            fracture { *pf = f as f32 }
            return
        }
        forge pd: *crystal = a as *crystal
        fracture { *pd = f }
    }

    // valor dos registradores como palavra de 64 bits para memoria/C:
    // ponteiros e obsidian viram o endereco, monolith o endereco do bloco,
    // Array o ofs_array nativo, variante a etiqueta, null 0
    vein reg_as_int() -> stone {
        if (_rk == VAL_INT) { return _ri }
        if (_rk == VAL_BOOL) {
            if (_rb) { return 1 }
            return 0
        }
        if (_rk == VAL_FLOAT) { return _rf as stone }
        if (_rk == VAL_STRING) { return _rs as stone }
        if (_rk == VAL_OBJECT) { return _rr }
        if (_rk == VAL_ARRAY) { return arr_native_ptr(_rr) }
        if (_rk == VAL_VARIANT) { return variant_index(_rt) }
        return 0
    }

    vein reg_as_f() -> crystal {
        if (_rk == VAL_FLOAT) { return _rf }
        if (_rk == VAL_INT) { return _ri as crystal }
        if (_rk == VAL_BOOL && _rb) { return 1.0 }
        return 0.0
    }

    // palavra bruta v (de memoria, do C ou de um callback) -> registradores,
    // pelo tipo t de classe c
    vein regs_from_raw(v: stone, c: stone, t: obsidian) -> void {
        if (c == MC_I64) { r_int(v); return }
        if (mc_is_narrow(c)) {
            r_int(mc_canon(c, v))
            _rt = mc_name(c)
            return
        }
        if (c == MC_BOOL) { r_bool((v & 4294967295) != 0); return }
        if (v == 0 && (c == MC_STR || c == MC_PTR || c == MC_OBJ || c == MC_ARRAY)) { r_null(); return }
        if (c == MC_STR) { r_string(v as obsidian); return }
        if (c == MC_PTR) { r_int(v); _rt = t; return }
        if (c == MC_OBJ) { r_object(t, v); return }
        if (c == MC_ARRAY) {
            if (v < 0) { r_array(0 - v - 1); return }
            r_array(arr_adopt(v, t))
            return
        }
        if (c == MC_VARIANT) {
            forge nm = variant_name_at(v)
            if (ofs_str_len(nm) == 0) { r_int(v); return }
            r_null()
            r_variant(nm)
            return
        }
        r_int(v)
    }

    // memoria em a (tipo t, classe c) -> registradores
    vein mem_load(a: stone, c: stone, t: obsidian) -> void {
        if (c == MC_F64) { r_float(mem_rd_f(a, c)); return }
        if (c == MC_F32) {
            r_float(mem_rd_f(a, c))
            _rt = "f32"
            return
        }
        regs_from_raw(mem_rd(a, c), c, t)
    }

    // registradores -> memoria em a (tipo t, classe c); registradores intactos
    vein mem_store(a: stone, c: stone, t: obsidian) -> void {
        if (c == MC_F64 || c == MC_F32) {
            mem_wr_f(a, c, reg_as_f())
            return
        }
        if (c == MC_STR && _rk == VAL_INT && ofs_str_eq(_rt, "stone")) {
            // coerce_for_store stone -> obsidian do nativo: vira texto
            mem_wr(a, MC_I64, ofs_stone_to_obsidian(_ri) as stone)
            return
        }
        mem_wr(a, c, reg_as_int())
    }

    // tipo apontado por um ponteiro de tipo pt ("*T" -> T; outro -> stone,
    // como no llvmgen)
    vein pointee_of(pt: obsidian) -> obsidian {
        if (ofs_str_len(pt) > 1 && ofs_str_char_at(pt, 0) == 42) {
            return ofs_str_substr(pt, 1, ofs_str_len(pt) - 1)
        }
        return "stone"
    }

    // tipo/classe de `*p` no no `id` (o ponteiro ja esta nos registradores):
    // o tipo estatico do typeck (o mesmo que o llvmgen usa) ou, sem ele, o
    // tipo do valor -> _dt_t/_dt_c
    forge _dt_t: obsidian = "stone"
    forge _dt_c: stone = 0

    vein deref_type(id: stone) -> void {
        forge c: stone = ofs_array_get(_naux, id)
        if (c > 0) {
            _dt_c = c - 1
            _dt_t = ofs_array_get(_ntype, id)
            return
        }
        if (_rk == VAL_INT && ofs_str_len(_rt) > 1 && ofs_str_char_at(_rt, 0) == 42) {
            _dt_t = pointee_of(_rt)
            _dt_c = mem_class(_dt_t)
            return
        }
        _dt_t = "stone"
        _dt_c = MC_I64
    }

    // nome do tipo de um no de tipo (Array<T> como o typeck)
    vein type_node_str(tid: stone) -> obsidian {
        if (tid < 0) { return "" }
        if (nk(tid) == NK_TYPE_ARRAY) {
            forge inner = "stone"
            if (nc0(tid) >= 0) { inner = nval(nc0(tid)) }
            return "Array<" + inner + ">"
        }
        return nval(tid)
    }

    // ── Heap Arrays Operations ────────────────────────────────────────────

    vein arr_valid(h: stone) -> bool {
        return h >= 0 && h < ofs_array_len(_arr_len)
    }

    // `a[i]`, `a[i] = v`, ofs_array_get/set fora do limite: o mesmo erro do
    // runtime nativo (matrix.ofs, ofs_array_oob) no stderr, e rc 1. Antes o
    // interpretador devolvia null e seguia (e o nativo saia mudo).
    vein arr_check_index(h: stone, idx: stone) -> void {
        if (!arr_valid(h)) { return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (idx >= 0 && idx < len) { return }
        forge msg = "ofs: indice " + ofs_stone_to_obsidian(idx) + " fora do limite do array (tamanho " + ofs_stone_to_obsidian(len) + ")\n"
        write(2, msg, ofs_str_len(msg))
        exit(1)
    }

    vein interp_new_array() -> stone {
        ofs_array_push(_arr_len, 0)
        ofs_array_push(_arr_mask, 0)
        ofs_array_push(_arr_ck, _arr_nocol)
        ofs_array_push(_arr_ct, _arr_nocol)
        ofs_array_push(_arr_ci, _arr_nocol)
        ofs_array_push(_arr_cf, _arr_nocol)
        ofs_array_push(_arr_cb, _arr_nocol)
        ofs_array_push(_arr_cs, _arr_nocol)
        ofs_array_push(_arr_cr, _arr_nocol)
        return ofs_array_len(_arr_len) - 1
    }

    vein arr_elem_kind(h: stone, mask: stone, idx: stone) -> stone {
        if ((mask & COL_KIND) != 0) {
            forge ck: Array<stone> = ofs_array_get(_arr_ck, h)
            forge k: stone = ofs_array_get(ck, idx)
            return k
        }
        return VAL_INT
    }

    // Cria a coluna `col` de h preenchida com o padrao para os elementos atuais
    vein arr_materialize(h: stone, col: stone) -> void {
        forge len: stone = ofs_array_get(_arr_len, h)
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge j = 0
        if (col == COL_KIND) {
            forge c: Array<stone> = []
            while (j < len) { ofs_array_push(c, VAL_INT); j++ }
            ofs_array_set(_arr_ck, h, c)
        } else if (col == COL_TYPE) {
            forge c: Array<obsidian> = []
            while (j < len) {
                ofs_array_push(c, kind_type_name(arr_elem_kind(h, mask, j)))
                j++
            }
            ofs_array_set(_arr_ct, h, c)
        } else if (col == COL_I) {
            forge c: Array<stone> = []
            while (j < len) { ofs_array_push(c, 0); j++ }
            ofs_array_set(_arr_ci, h, c)
        } else if (col == COL_F) {
            forge c: Array<crystal> = []
            forge zf: crystal = 0.0
            while (j < len) { ofs_array_push(c, zf); j++ }
            ofs_array_set(_arr_cf, h, c)
        } else if (col == COL_B) {
            forge c: Array<bool> = []
            while (j < len) { ofs_array_push(c, false); j++ }
            ofs_array_set(_arr_cb, h, c)
        } else if (col == COL_S) {
            forge c: Array<obsidian> = []
            while (j < len) { ofs_array_push(c, ""); j++ }
            ofs_array_set(_arr_cs, h, c)
        } else if (col == COL_REF) {
            forge c: Array<stone> = []
            while (j < len) { ofs_array_push(c, -1); j++ }
            ofs_array_set(_arr_cr, h, c)
        }
        ofs_array_set(_arr_mask, h, mask | col)
    }

    // Colunas que o valor dos registradores precisa (campos fora do padrao)
    vein regs_needed_cols() -> stone {
        forge need = 0
        if (_rk != VAL_INT) { need = need | COL_KIND }
        if (!ofs_str_eq(_rt, kind_type_name(_rk))) { need = need | COL_TYPE }
        if (_ri != 0) { need = need | COL_I }
        if (_rk == VAL_FLOAT || _rk == VAL_VARIANT || _rf != 0.0) { need = need | COL_F }
        if (_rb) { need = need | COL_B }
        if (!ofs_str_eq(_rs, "")) { need = need | COL_S }
        if (_rr != -1) { need = need | COL_REF }
        return need
    }

    // Garante as colunas necessarias para o valor dos registradores; devolve a mascara
    vein arr_prepare(h: stone) -> stone {
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge missing = regs_needed_cols() & (~mask)
        if (missing != 0) {
            if ((missing & COL_KIND) != 0) { arr_materialize(h, COL_KIND) }
            if ((missing & COL_TYPE) != 0) { arr_materialize(h, COL_TYPE) }
            if ((missing & COL_I) != 0) { arr_materialize(h, COL_I) }
            if ((missing & COL_F) != 0) { arr_materialize(h, COL_F) }
            if ((missing & COL_B) != 0) { arr_materialize(h, COL_B) }
            if ((missing & COL_S) != 0) { arr_materialize(h, COL_S) }
            if ((missing & COL_REF) != 0) { arr_materialize(h, COL_REF) }
            mask = ofs_array_get(_arr_mask, h)
        }
        return mask
    }

    // push do valor dos registradores
    vein interp_array_push(h: stone) -> void {
        if (!arr_valid(h)) { return }
        forge mask = arr_prepare(h)
        if ((mask & COL_KIND) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ck, h)
            ofs_array_push(c, _rk)
        }
        if ((mask & COL_TYPE) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_ct, h)
            ofs_array_push(c, _rt)
        }
        if ((mask & COL_I) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ci, h)
            ofs_array_push(c, _ri)
        }
        if ((mask & COL_F) != 0) {
            forge c: Array<crystal> = ofs_array_get(_arr_cf, h)
            ofs_array_push(c, _rf)
        }
        if ((mask & COL_B) != 0) {
            forge c: Array<bool> = ofs_array_get(_arr_cb, h)
            ofs_array_push(c, _rb)
        }
        if ((mask & COL_S) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_cs, h)
            ofs_array_push(c, _rs)
        }
        if ((mask & COL_REF) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_cr, h)
            ofs_array_push(c, _rr)
        }
        forge len: stone = ofs_array_get(_arr_len, h)
        ofs_array_set(_arr_len, h, len + 1)
    }

    // elemento -> registradores (null fora dos limites)
    vein interp_array_get(h: stone, idx: stone) -> void {
        if (!arr_valid(h)) { r_null(); return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (idx < 0 || idx >= len) { r_null(); return }
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge k = arr_elem_kind(h, mask, idx)
        forge t: obsidian = ""
        if ((mask & COL_TYPE) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_ct, h)
            t = ofs_array_get(c, idx)
        } else {
            t = kind_type_name(k)
        }
        forge iv = 0
        if ((mask & COL_I) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ci, h)
            iv = ofs_array_get(c, idx)
        }
        forge fv: crystal = 0.0
        if ((mask & COL_F) != 0) {
            forge c: Array<crystal> = ofs_array_get(_arr_cf, h)
            fv = ofs_array_get(c, idx) as crystal
        }
        forge bv = false
        if ((mask & COL_B) != 0) {
            forge c: Array<bool> = ofs_array_get(_arr_cb, h)
            bv = ofs_array_get(c, idx)
        }
        forge sv: obsidian = ""
        if ((mask & COL_S) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_cs, h)
            sv = ofs_array_get(c, idx)
        }
        forge rv = -1
        if ((mask & COL_REF) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_cr, h)
            rv = ofs_array_get(c, idx)
        }
        r_set(k, t, iv, fv, bv, sv, rv)
    }

    // elemento idx <- registradores
    vein interp_array_set(h: stone, idx: stone) -> void {
        if (!arr_valid(h)) { return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (idx < 0 || idx >= len) { return }
        forge mask = arr_prepare(h)
        if ((mask & COL_KIND) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ck, h)
            ofs_array_set(c, idx, _rk)
        }
        if ((mask & COL_TYPE) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_ct, h)
            ofs_array_set(c, idx, _rt)
        }
        if ((mask & COL_I) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_ci, h)
            ofs_array_set(c, idx, _ri)
        }
        if ((mask & COL_F) != 0) {
            forge c: Array<crystal> = ofs_array_get(_arr_cf, h)
            ofs_array_set(c, idx, _rf)
        }
        if ((mask & COL_B) != 0) {
            forge c: Array<bool> = ofs_array_get(_arr_cb, h)
            ofs_array_set(c, idx, _rb)
        }
        if ((mask & COL_S) != 0) {
            forge c: Array<obsidian> = ofs_array_get(_arr_cs, h)
            ofs_array_set(c, idx, _rs)
        }
        if ((mask & COL_REF) != 0) {
            forge c: Array<stone> = ofs_array_get(_arr_cr, h)
            ofs_array_set(c, idx, _rr)
        }
    }

    vein interp_array_len(h: stone) -> stone {
        if (!arr_valid(h)) { return 0 }
        forge len: stone = ofs_array_get(_arr_len, h)
        return len
    }

    // ultimo elemento -> registradores, e remove
    vein interp_array_pop(h: stone) -> void {
        if (!arr_valid(h)) { r_null(); return }
        forge len: stone = ofs_array_get(_arr_len, h)
        if (len <= 0) { r_null(); return }
        interp_array_get(h, len - 1)
        forge mask: stone = ofs_array_get(_arr_mask, h)
        if ((mask & COL_KIND) != 0) { forge c: Array<stone> = ofs_array_get(_arr_ck, h); ofs_array_pop(c) }
        if ((mask & COL_TYPE) != 0) { forge c: Array<obsidian> = ofs_array_get(_arr_ct, h); ofs_array_pop(c) }
        if ((mask & COL_I) != 0) { forge c: Array<stone> = ofs_array_get(_arr_ci, h); ofs_array_pop(c) }
        if ((mask & COL_F) != 0) { forge c: Array<crystal> = ofs_array_get(_arr_cf, h); ofs_array_pop(c) }
        if ((mask & COL_B) != 0) { forge c: Array<bool> = ofs_array_get(_arr_cb, h); ofs_array_pop(c) }
        if ((mask & COL_S) != 0) { forge c: Array<obsidian> = ofs_array_get(_arr_cs, h); ofs_array_pop(c) }
        if ((mask & COL_REF) != 0) { forge c: Array<stone> = ofs_array_get(_arr_cr, h); ofs_array_pop(c) }
        ofs_array_set(_arr_len, h, len - 1)
    }

    // ── Arrays e o C (F2) ─────────────────────────────────────────────────
    // A coluna de valores de um array interpretado (_arr_ci/_arr_cf/...) E um
    // ofs_array nativo (cabecalho [data, len, cap, elem_size] + dados, ver
    // stdlib/runtime/matrix.ofs) com elementos de 8 bytes, a mesma
    // representacao de um Array<T> no build nativo. Passar o array ao C
    // passa essa coluna (o C le e escreve os elementos no lugar); na volta
    // o comprimento e sincronizado (o C pode ter feito push/pop).

    vein arr_col_array(h: stone, col: stone) -> stone {
        if (col == COL_F) { forge cf: Array<crystal> = ofs_array_get(_arr_cf, h); return cf as stone }
        if (col == COL_S) { forge cs: Array<obsidian> = ofs_array_get(_arr_cs, h); return cs as stone }
        if (col == COL_B) { forge cb: Array<bool> = ofs_array_get(_arr_cb, h); return cb as stone }
        if (col == COL_REF) { forge cr: Array<stone> = ofs_array_get(_arr_cr, h); return cr as stone }
        forge ci: Array<stone> = ofs_array_get(_arr_ci, h)
        return ci as stone
    }

    // endereco do ofs_array nativo equivalente ao array h (0 = invalido); a
    // coluna usada fica em _arr_last_col
    vein arr_native_ptr(h: stone) -> stone {
        if (!arr_valid(h)) { return 0 }
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge len: stone = ofs_array_get(_arr_len, h)
        forge col = COL_I
        if ((mask & COL_KIND) != 0 && len > 0) {
            forge ck: Array<stone> = ofs_array_get(_arr_ck, h)
            forge k0: stone = ofs_array_get(ck, 0)
            forge j = 1
            while (j < len) {
                forge kj: stone = ofs_array_get(ck, j)
                if (kj != k0) {
                    fault_runtime_error("Array com elementos de tipos diferentes passado ao C")
                    return 0
                }
                j++
            }
            if (k0 == VAL_FLOAT) { col = COL_F }
            else if (k0 == VAL_STRING) { col = COL_S }
            else if (k0 == VAL_BOOL) { col = COL_B }
            else if (k0 == VAL_OBJECT) { col = COL_REF }
            else if (k0 != VAL_INT) {
                fault_runtime_error("Array de " + kind_type_name(k0) + " passado ao C: no interpretador so Array de inteiros/ponteiros, crystal, bool, obsidian ou monolith")
                return 0
            }
        }
        if ((mask & col) == 0) { arr_materialize(h, col) }
        _arr_last_col = col
        return arr_col_array(h, col)
    }

    // depois do C: comprimento do array h = o da coluna col; as outras colunas
    // presentes ganham (padrao) ou perdem elementos para acompanhar
    vein arr_sync(h: stone, col: stone) -> void {
        if (!arr_valid(h)) { return }
        forge na: Array<stone> = arr_col_array(h, col) as Array
        forge nl = ofs_array_len(na)
        forge len: stone = ofs_array_get(_arr_len, h)
        if (nl == len) { return }
        forge mask: stone = ofs_array_get(_arr_mask, h)
        forge c = 1
        while (c <= COL_REF) {
            if (c != col && (mask & c) != 0) {
                forge other: Array<stone> = arr_col_array(h, c) as Array
                while (ofs_array_len(other) > nl) { ofs_array_pop(other) }
                while (ofs_array_len(other) < nl) {
                    if (c == COL_KIND) {
                        forge k: stone = VAL_INT
                        if (col == COL_F) { k = VAL_FLOAT }
                        if (col == COL_S) { k = VAL_STRING }
                        if (col == COL_B) { k = VAL_BOOL }
                        if (col == COL_REF) { k = VAL_OBJECT }
                        ofs_array_push(other, k)
                    } else if (c == COL_TYPE) {
                        forge ot: Array<obsidian> = arr_col_array(h, c) as Array
                        forge tl: obsidian = "stone"
                        if (ofs_array_len(ot) > 0) { tl = ofs_array_get(ot, 0) }
                        ofs_array_push(ot, tl)
                    } else if (c == COL_S) {
                        forge os: Array<obsidian> = arr_col_array(h, c) as Array
                        ofs_array_push(os, "")
                    } else if (c == COL_REF) {
                        ofs_array_push(other, -1)
                    } else {
                        ofs_array_push(other, 0)
                    }
                }
            }
            c = c * 2
        }
        ofs_array_set(_arr_len, h, nl)
    }

    // ofs_array nativo vindo do C/memoria -> array interpretado que usa o
    // proprio bloco como coluna de valores (sem copia); t = "Array<T>"
    vein arr_adopt(p: stone, t: obsidian) -> stone {
        forge et = "stone"
        forge tl = ofs_str_len(t)
        if (tl > 7 && ofs_str_char_at(t, 5) == 60) { et = ofs_str_substr(t, 6, tl - 7) }
        forge c = mem_class(et)
        forge h = interp_new_array()
        forge na: Array<stone> = p as Array
        forge len = ofs_array_len(na)
        forge col = COL_I
        forge k = VAL_INT
        if (c == MC_F64) { col = COL_F; k = VAL_FLOAT; ofs_array_set(_arr_cf, h, p as Array) }
        else if (c == MC_STR) { col = COL_S; k = VAL_STRING; ofs_array_set(_arr_cs, h, p as Array) }
        else if (c == MC_BOOL) { col = COL_B; k = VAL_BOOL; ofs_array_set(_arr_cb, h, p as Array) }
        else if (c == MC_OBJ) { col = COL_REF; k = VAL_OBJECT; ofs_array_set(_arr_cr, h, p as Array) }
        else { ofs_array_set(_arr_ci, h, p as Array) }
        ofs_array_set(_arr_len, h, len)
        ofs_array_set(_arr_mask, h, col)
        if (k != VAL_INT) {
            arr_materialize(h, COL_KIND)
            forge ck: Array<stone> = ofs_array_get(_arr_ck, h)
            forge j = 0
            while (j < len) { ofs_array_set(ck, j, k); j++ }
        }
        if (c == MC_OBJ) {
            forge ct: Array<obsidian> = []
            forge j2 = 0
            while (j2 < len) { ofs_array_push(ct, et); j2++ }
            ofs_array_set(_arr_ct, h, ct)
            ofs_array_set(_arr_mask, h, col | COL_KIND | COL_TYPE)
        }
        return h
    }

    // ── Monolith Schema and Heap Objects ──────────────────────────────────

    // devolve true se o tipo e novo (os campos so entram uma vez)
    vein register_monolith(name: obsidian) -> bool {
        if (mono_index(name) >= 0) { return false }
        ofs_array_push(_mono_names, name)
        ofs_array_push(_mono_ffirst, ofs_array_len(_mono_field_names))
        ofs_array_push(_mono_fcount, 0)
        ofs_array_push(_mono_size, 1)
        return true
    }

    vein register_monolith_field(owner: obsidian, field_name: obsidian, field_type: obsidian) -> void {
        ofs_array_push(_mono_field_owners, owner)
        ofs_array_push(_mono_field_names, field_name)
        ofs_array_push(_mono_field_types, field_type)
        ofs_array_push(_mono_field_offs, 0)
        ofs_array_push(_mono_field_cls, MC_I64)
        forge mi = ofs_array_len(_mono_names) - 1
        forge fc: stone = ofs_array_get(_mono_fcount, mi)
        ofs_array_set(_mono_fcount, mi, fc + 1)
    }

    forge _mono_last_name: obsidian = ""
    forge _mono_last_idx: stone = -1

    vein mono_index(t: obsidian) -> stone {
        if (_mono_last_idx >= 0 && ofs_str_eq(t, _mono_last_name)) { return _mono_last_idx }
        forge i = 0
        forge n = ofs_array_len(_mono_names)
        while (i < n) {
            forge m: obsidian = ofs_array_get(_mono_names, i)
            if (ofs_str_eq(m, t)) {
                _mono_last_name = m
                _mono_last_idx = i
                return i
            }
            i++
        }
        return -1
    }

    // offsets, classes e tamanho de cada monolith (llvmgen.struct_layout:
    // o mesmo layout do codigo nativo); depois de collect_declarations
    vein compute_layouts() -> void {
        forge mi = 0
        while (mi < ofs_array_len(_mono_names)) {
            forge first: stone = ofs_array_get(_mono_ffirst, mi)
            forge cnt: stone = ofs_array_get(_mono_fcount, mi)
            forge types: Array<obsidian> = []
            forge offs: Array<stone> = []
            forge j = 0
            while (j < cnt) {
                forge ft: obsidian = ofs_array_get(_mono_field_types, first + j)
                ofs_array_push(types, ft)
                j++
            }
            forge size = llvmgen.struct_layout(types, offs)
            ofs_array_set(_mono_size, mi, size)
            j = 0
            while (j < cnt) {
                forge off: stone = ofs_array_get(offs, j)
                forge ft2: obsidian = ofs_array_get(types, j)
                ofs_array_set(_mono_field_offs, first + j, off)
                ofs_array_set(_mono_field_cls, first + j, mem_class(ft2))
                j++
            }
            mi++
        }
    }

    // valor padrao do tipo t -> registradores (objeto novo ja e unico: quem
    // declara nao precisa clonar)
    vein default_value_for_type(t: obsidian) -> void {
        if (ofs_str_eq(t, "stone")) { r_int(0); return }
        if (ofs_str_eq(t, "crystal")) { r_float(0.0); return }
        if (ofs_str_eq(t, "bool")) { r_bool(false); return }
        if (ofs_str_eq(t, "obsidian")) { r_string(""); return }
        if (ofs_str_eq(t, "Array")) {
            forge h = interp_new_array()
            r_array(h)
            return
        }
        forge mi = mono_index(t)
        if (mi >= 0) {
            r_object(t, obj_new(mi, 0))
            return
        }
        forge c = mem_class(t)
        if (mc_is_narrow(c) || ofs_str_eq(t, "i64") || ofs_str_eq(t, "u64")) {
            r_int(0)
            if (mc_is_narrow(c)) { _rt = mc_name(c) }
            return
        }
        if (c == MC_F64 || c == MC_F32) {
            r_float(0.0)
            if (c == MC_F32) { _rt = "f32" }
            return
        }
        r_null()
    }

    // bloco zerado do monolith mi; campos Array ganham um array novo e
    // campos monolith um objeto novo (como antes da F2), ate 8 niveis
    vein obj_new(mi: stone, depth: stone) -> stone {
        forge size: stone = ofs_array_get(_mono_size, mi)
        forge a = ofs_alloc(size) as stone
        forge first: stone = ofs_array_get(_mono_ffirst, mi)
        forge cnt: stone = ofs_array_get(_mono_fcount, mi)
        forge j = 0
        while (j < cnt) {
            forge c: stone = ofs_array_get(_mono_field_cls, first + j)
            if (c == MC_ARRAY) {
                forge off: stone = ofs_array_get(_mono_field_offs, first + j)
                forge h = interp_new_array()
                mem_wr(a + off, MC_I64, 0 - h - 1)
            } else if (c == MC_OBJ && depth < 8) {
                forge off2: stone = ofs_array_get(_mono_field_offs, first + j)
                forge ft: obsidian = ofs_array_get(_mono_field_types, first + j)
                forge smi = mono_index(ft)
                if (smi >= 0) { mem_wr(a + off2, MC_I64, obj_new(smi, depth + 1)) }
            }
            j++
        }
        return a
    }

    vein obj_size(t: obsidian) -> stone {
        forge mi = mono_index(t)
        if (mi < 0) { return 0 }
        forge size: stone = ofs_array_get(_mono_size, mi)
        return size
    }

    // indice global do campo `name` do monolith t (-1 se nao existir)
    vein obj_field_find(t: obsidian, name: obsidian) -> stone {
        forge mi = mono_index(t)
        if (mi < 0) { return -1 }
        forge first: stone = ofs_array_get(_mono_ffirst, mi)
        forge cnt: stone = ofs_array_get(_mono_fcount, mi)
        forge j = 0
        while (j < cnt) {
            forge fname: obsidian = ofs_array_get(_mono_field_names, first + j)
            if (ofs_str_eq(fname, name)) { return first + j }
            j++
        }
        return -1
    }

    // campo do no NK_FIELD `id` sobre um objeto do tipo t (cache em _naux)
    vein field_cached(id: stone, t: obsidian) -> stone {
        forge c: stone = ofs_array_get(_naux, id)
        if (c > 0) {
            forge owner: obsidian = ofs_array_get(_mono_field_owners, c - 1)
            if (ofs_str_eq(owner, t)) { return c - 1 }
        }
        forge fi = obj_field_find(t, nval(id))
        ofs_array_set(_naux, id, fi + 1)
        return fi
    }

    // campo fi do objeto em a -> registradores
    vein obj_load_field(a: stone, fi: stone) -> void {
        forge off: stone = ofs_array_get(_mono_field_offs, fi)
        forge c: stone = ofs_array_get(_mono_field_cls, fi)
        forge t: obsidian = ofs_array_get(_mono_field_types, fi)
        mem_load(a + off, c, t)
        // obsidian nulo num campo: texto vazio (o padrao de antes da F2)
        if (c == MC_STR && _rk == VAL_NULL) { r_string("") }
    }

    // registradores -> campo fi do objeto em a (registradores intactos);
    // campo Array guarda o handle interpretado como -(h+1)
    vein obj_store_field(a: stone, fi: stone) -> void {
        forge off: stone = ofs_array_get(_mono_field_offs, fi)
        forge c: stone = ofs_array_get(_mono_field_cls, fi)
        if (c == MC_ARRAY && _rk == VAL_ARRAY) {
            mem_wr(a + off, MC_I64, 0 - _rr - 1)
            return
        }
        forge t: obsidian = ofs_array_get(_mono_field_types, fi)
        mem_store(a + off, c, t)
    }

    // copia (rasa) do objeto em a, do tipo t; devolve o novo endereco
    vein obj_clone(a: stone, t: obsidian) -> stone {
        forge size = obj_size(t)
        if (size <= 0) { return a }
        forge b = ofs_alloc(size) as stone
        memcpy(b as *u8, a as *u8, size)
        return b
    }

    // Objetos tem semantica de valor ao ir para variavel: copia nos registradores
    vein clone_regs() -> void {
        if (_rk == VAL_OBJECT && _rr > 0) {
            _rr = obj_clone(_rr, _rt)
        }
    }

    // ── Variables & Locations ─────────────────────────────────────────────

    vein env_load(idx: stone) -> void {
        forge k: stone = ofs_array_get(_env_kind, idx)
        forge t: obsidian = ofs_array_get(_env_type, idx)
        forge iv: stone = ofs_array_get(_env_i, idx)
        if (k == VAL_BOXED) {
            forge bc: stone = ofs_array_get(_env_ref, idx)
            mem_load(iv, bc, t)
            return
        }
        forge fv: crystal = ofs_array_get(_env_f, idx) as crystal
        forge bv: bool = ofs_array_get(_env_b, idx)
        forge sv: obsidian = ofs_array_get(_env_s, idx)
        forge rv: stone = ofs_array_get(_env_ref, idx)
        r_set(k, t, iv, fv, bv, sv, rv)
    }

    // variavel idx <- registradores (sem clonar)
    vein env_store(idx: stone) -> void {
        if (_boxed_live > 0) {
            forge ck: stone = ofs_array_get(_env_kind, idx)
            if (ck == VAL_BOXED) {
                forge a: stone = ofs_array_get(_env_i, idx)
                forge bc: stone = ofs_array_get(_env_ref, idx)
                forge bt: obsidian = ofs_array_get(_env_type, idx)
                mem_store(a, bc, bt)
                return
            }
        }
        ofs_array_set(_env_kind, idx, _rk)
        ofs_array_set(_env_type, idx, _rt)
        ofs_array_set(_env_i, idx, _ri)
        ofs_array_set(_env_f, idx, _rf)
        ofs_array_set(_env_b, idx, _rb)
        ofs_array_set(_env_s, idx, _rs)
        ofs_array_set(_env_ref, idx, _rr)
    }

    // variavel idx <- copia dos registradores; os registradores ficam intactos.
    // Monolith sobre monolith do mesmo tipo copia para o bloco que a variavel
    // ja tem (como o `store %T` do nativo): `&x` tomado antes continua valendo.
    vein env_assign(idx: stone) -> void {
        if (_rk == VAL_OBJECT && _rr > 0) {
            forge ck: stone = ofs_array_get(_env_kind, idx)
            if (ck == VAL_OBJECT) {
                forge dst: stone = ofs_array_get(_env_ref, idx)
                forge dt: obsidian = ofs_array_get(_env_type, idx)
                if (dst > 0 && ofs_str_eq(dt, _rt)) {
                    if (dst != _rr) { memcpy(dst as *u8, _rr as *u8, obj_size(dt)) }
                    return
                }
            }
        }
        forge k = _rk
        forge t: obsidian = _rt
        forge iv = _ri
        forge fv: crystal = _rf
        forge bv = _rb
        forge sv: obsidian = _rs
        forge rv = _rr
        clone_regs()
        env_store(idx)
        r_set(k, t, iv, fv, bv, sv, rv)
    }

    // `&x`: a variavel idx passa a viver num slot de memoria crua (8 bytes)
    // com o tipo t; devolve o endereco. O slot e liberado quando a variavel
    // sai de escopo (como a alloca do nativo).
    vein box_var(idx: stone, st: obsidian) -> stone {
        forge k: stone = ofs_array_get(_env_kind, idx)
        if (k == VAL_BOXED) {
            forge a0: stone = ofs_array_get(_env_i, idx)
            return a0
        }
        forge t: obsidian = st
        if (ofs_str_len(t) == 0 || ofs_str_eq(t, "unknown") || ofs_str_eq(t, "null") || ofs_str_eq(t, "void")) {
            forge et: obsidian = ofs_array_get(_env_type, idx)
            t = et
            if (k == VAL_INT && ofs_str_len(t) == 0) { t = "stone" }
            if (k == VAL_BOOL) { t = "bool" }
            if (k == VAL_STRING) { t = "obsidian" }
            if (k == VAL_NULL) { t = "ptr" }
            if (k == VAL_VARIANT) { t = "variant" }
        }
        forge c = mem_class(t)
        if (k == VAL_ARRAY || c == MC_ARRAY) {
            fault_runtime_error("&x de uma variavel Array ainda nao e suportado no interpretador (use ofs_array_data(x) ou ofs run --native)")
            return 0
        }
        if (k == VAL_OBJECT || c == MC_OBJ) {
            fault_runtime_error("&x de monolith nulo no interpretador")
            return 0
        }
        forge a = ofs_alloc(8) as stone
        env_load(idx)
        mem_store(a, c, t)
        ofs_array_set(_env_kind, idx, VAL_BOXED)
        ofs_array_set(_env_type, idx, t)
        ofs_array_set(_env_i, idx, a)
        ofs_array_set(_env_ref, idx, c)
        _boxed_live++
        return a
    }

    vein load_location(lk: stone, lvar: stone, lh: stone, lidx: stone, lfield: obsidian) -> void {
        if (lk == LOC_VAR) {
            if (lvar >= 0 && lvar < ofs_array_len(_env_kind)) {
                env_load(lvar)
                return
            }
            r_null()
            return
        }
        if (lk == LOC_ARRAY) {
            arr_check_index(lh, lidx)
            interp_array_get(lh, lidx)
            return
        }
        if (lk == LOC_FIELD) {
            if (lidx < 0) { r_null(); return }
            obj_load_field(lh, lidx)
            return
        }
        if (lk == LOC_MEM) {
            mem_load(lh, lidx, lfield)
            return
        }
        r_null()
    }

    // local <- registradores (os registradores ficam intactos)
    vein store_location(lk: stone, lvar: stone, lh: stone, lidx: stone, lfield: obsidian) -> void {
        if (lk == LOC_VAR) {
            if (lvar >= 0 && lvar < ofs_array_len(_env_kind)) {
                env_assign(lvar)
            }
            return
        }
        if (lk == LOC_ARRAY) {
            arr_check_index(lh, lidx)
            interp_array_set(lh, lidx)
            return
        }
        if (lk == LOC_FIELD) {
            if (lidx < 0) {
                fault_runtime_error("atribuicao a campo que o monolith nao declara")
                return
            }
            obj_store_field(lh, lidx)
            return
        }
        if (lk == LOC_MEM) {
            mem_store(lh, lidx, lfield)
            return
        }
    }

    // ── Scope & Environment ───────────────────────────────────────────────

    vein push_scope() -> void {
        _scope_depth++
    }

    vein run_anchors_from_depth(min_depth: stone) -> void {
        forge len = ofs_array_len(_anchor_nodes)
        while (len > 0) {
            forge depth: stone = ofs_array_get(_anchor_depths, len - 1)
            if (depth < min_depth) { break }
            forge action: stone = ofs_array_get(_anchor_nodes, len - 1)
            ofs_array_pop(_anchor_nodes)
            ofs_array_pop(_anchor_depths)
            execute_stmt(action)
            len--
        }
    }

    vein env_pop_one() -> void {
        if (_boxed_live > 0) {
            forge last = ofs_array_len(_env_kind) - 1
            forge lk: stone = ofs_array_get(_env_kind, last)
            if (lk == VAL_BOXED) {
                forge la: stone = ofs_array_get(_env_i, last)
                ofs_free(la as obsidian)
                _boxed_live--
            }
        }
        ofs_array_pop(_env_sym)
        ofs_array_pop(_env_kind)
        ofs_array_pop(_env_type)
        ofs_array_pop(_env_i)
        ofs_array_pop(_env_f)
        ofs_array_pop(_env_b)
        ofs_array_pop(_env_s)
        ofs_array_pop(_env_ref)
        ofs_array_pop(_env_depth)
    }

    vein pop_scope() -> void {
        run_anchors_from_depth(_scope_depth)
        forge len = ofs_array_len(_env_depth)
        while (len > 0) {
            forge d: stone = ofs_array_get(_env_depth, len - 1)
            if (d < _scope_depth) {
                break
            }
            env_pop_one()
            len--
        }
        if (_scope_depth > 0) {
            _scope_depth--
        }
    }

    // declara a variavel `sym` com (uma copia de) o valor dos registradores
    vein declare_var(sym: stone) -> void {
        clone_regs()
        declare_var_noclone(sym)
    }

    // declara com o valor dos registradores sem copiar o monolith: parametro
    // (o nativo passa monolith por ponteiro) e objeto recem-criado
    vein declare_var_noclone(sym: stone) -> void {
        ofs_array_push(_env_sym, sym)
        ofs_array_push(_env_kind, _rk)
        ofs_array_push(_env_type, _rt)
        ofs_array_push(_env_i, _ri)
        ofs_array_push(_env_f, _rf)
        ofs_array_push(_env_b, _rb)
        ofs_array_push(_env_s, _rs)
        ofs_array_push(_env_ref, _rr)
        ofs_array_push(_env_depth, _scope_depth)
    }

    vein find_var(sym: stone) -> stone {
        if (sym < 0) { return -1 }
        forge i = ofs_array_len(_env_sym) - 1
        while (i >= _current_frame_base) {
            forge s: stone = ofs_array_get(_env_sym, i)
            if (s == sym) {
                return i
            }
            i--
        }
        forge g = _globals_count - 1
        while (g >= 0) {
            forge gs: stone = ofs_array_get(_env_sym, g)
            if (gs == sym) {
                return g
            }
            g--
        }
        return -1
    }

    // ── Function Registry ─────────────────────────────────────────────────

    vein register_function(name: obsidian, node_id: stone) -> void {
        ofs_array_push(_func_names, name)
        ofs_array_push(_func_node_ids, node_id)
    }

    vein find_function(name: obsidian) -> stone {
        forge i = ofs_array_len(_func_names) - 1
        while (i >= 0) {
            forge fn_name: obsidian = ofs_array_get(_func_names, i)
            if (ofs_str_eq(fn_name, name)) {
                forge fid: stone = ofs_array_get(_func_node_ids, i)
                return fid
            }
            i--
        }
        return -1
    }

    // ── Call Argument Stack Helpers ───────────────────────────────────────

    vein arg_push_regs() -> void {
        ofs_array_push(_arg_kinds, _rk)
        ofs_array_push(_arg_types, _rt)
        ofs_array_push(_arg_i, _ri)
        ofs_array_push(_arg_f, _rf)
        ofs_array_push(_arg_b, _rb)
        ofs_array_push(_arg_s, _rs)
        ofs_array_push(_arg_refs, _rr)
    }

    vein args_pop_to(base: stone) -> void {
        while (ofs_array_len(_arg_kinds) > base) {
            ofs_array_pop(_arg_kinds)
            ofs_array_pop(_arg_types)
            ofs_array_pop(_arg_i)
            ofs_array_pop(_arg_f)
            ofs_array_pop(_arg_b)
            ofs_array_pop(_arg_s)
            ofs_array_pop(_arg_refs)
        }
    }

    // argumento na posicao absoluta pos -> registradores
    vein load_arg(pos: stone) -> void {
        forge k: stone = ofs_array_get(_arg_kinds, pos)
        forge t: obsidian = ofs_array_get(_arg_types, pos)
        forge iv: stone = ofs_array_get(_arg_i, pos)
        forge fv: crystal = ofs_array_get(_arg_f, pos) as crystal
        forge bv: bool = ofs_array_get(_arg_b, pos)
        forge sv: obsidian = ofs_array_get(_arg_s, pos)
        forge rv: stone = ofs_array_get(_arg_refs, pos)
        r_set(k, t, iv, fv, bv, sv, rv)
    }

    vein arg_i(pos: stone) -> stone {
        forge v: stone = ofs_array_get(_arg_i, pos)
        return v
    }

    vein arg_s(pos: stone) -> obsidian {
        forge v: obsidian = ofs_array_get(_arg_s, pos)
        return v
    }

    vein arg_ref(pos: stone) -> stone {
        forge v: stone = ofs_array_get(_arg_refs, pos)
        return v
    }

    vein arg_kind(pos: stone) -> stone {
        forge v: stone = ofs_array_get(_arg_kinds, pos)
        return v
    }

    vein arg_b(pos: stone) -> bool {
        forge v: bool = ofs_array_get(_arg_b, pos)
        return v
    }

    vein arg_t(pos: stone) -> obsidian {
        forge v: obsidian = ofs_array_get(_arg_types, pos)
        return v
    }

    vein arg_f(pos: stone) -> crystal {
        forge v: crystal = ofs_array_get(_arg_f, pos) as crystal
        return v
    }

    // arg como crystal (inteiro convertido)
    vein arg_num(pos: stone) -> crystal {
        if (arg_kind(pos) == VAL_FLOAT) { return arg_f(pos) }
        return arg_i(pos) as crystal
    }

    // ── Builtin Functions ─────────────────────────────────────────────────

    vein is_builtin(name: obsidian) -> bool {
        return builtin_code(name) != BI_NONE
    }

    // concatena o texto de todos os argumentos
    vein args_text(num_args: stone, arg_base: stone) -> obsidian {
        forge s = ""
        forge i = 0
        while (i < num_args) {
            load_arg(arg_base + i)
            s = s + r_to_string()
            i++
        }
        return s
    }

    // resultado -> registradores
    vein call_builtin(code: stone, num_args: stone, arg_base: stone) -> void {
        if (code == BI_ECHO) {
            if (num_args == 1) {
                // um argumento: sem concatenacao (o texto ja e o resultado)
                load_arg(arg_base)
                echo(r_to_string())
            } else {
                echo(args_text(num_args, arg_base))
            }
            r_void()
            return
        }
        if (code == BI_ETCH || code == BI_ETCHLN) {
            forge s = args_text(num_args, arg_base)
            if (code == BI_ETCHLN) { s = s + "\n" }
            echo(s)
            r_void()
            return
        }
        if (code == BI_MOLD) {
            r_string(args_text(num_args, arg_base))
            return
        }
        if (code == BI_EXIT) {
            forge ecode: stone = 0
            if (num_args > 0) {
                ecode = arg_i(arg_base)
            }
            exit(ecode)
            r_void()
            return
        }
        if (code == BI_STR_LEN) {
            if (num_args > 0) { r_int(ofs_str_len(arg_s(arg_base))); return }
            r_int(0)
            return
        }
        if (code == BI_STR_EQ) {
            if (num_args >= 2) { r_bool(ofs_str_eq(arg_s(arg_base), arg_s(arg_base + 1))); return }
            r_bool(false)
            return
        }
        if (code == BI_STR_CONCAT) {
            if (num_args >= 2) { r_string(ofs_str_concat(arg_s(arg_base), arg_s(arg_base + 1))); return }
            r_string("")
            return
        }
        if (code == BI_STR_CHAR_AT) {
            if (num_args >= 2) { r_int(ofs_str_char_at(arg_s(arg_base), arg_i(arg_base + 1))); return }
            r_int(-1)
            return
        }
        if (code == BI_STR_SUBSTR) {
            if (num_args >= 3) { r_string(ofs_str_substr(arg_s(arg_base), arg_i(arg_base + 1), arg_i(arg_base + 2))); return }
            r_string("")
            return
        }
        if (code == BI_STR_CONTAINS) {
            if (num_args >= 2) { r_bool(ofs_str_contains(arg_s(arg_base), arg_s(arg_base + 1))); return }
            r_bool(false)
            return
        }
        if (code == BI_STONE_TO_OBS) {
            if (num_args > 0) { r_string(ofs_stone_to_obsidian(arg_i(arg_base))); return }
            r_string("0")
            return
        }
        if (code == BI_CRYSTAL_TO_OBS) {
            if (num_args > 0) {
                load_arg(arg_base)
                r_string(r_to_string())
                return
            }
            r_string("0.0")
            return
        }
        if (code == BI_OBS_TO_STONE) {
            if (num_args > 0) { r_int(parse_int(arg_s(arg_base))); return }
            r_int(0)
            return
        }
        if (code == BI_ARRAY_NEW) {
            forge h = interp_new_array()
            r_array(h)
            return
        }
        if (code >= BI_ARRAY_LEN && code <= BI_ARRAY_POP && num_args > 0 && arg_kind(arg_base) == VAL_INT) {
            // ofs_array nativo cru (endereco vindo do C/runtime, ex. *stone de
            // matrix.create): as mesmas operacoes do caminho rapido do llvmgen
            raw_array_op(code, num_args, arg_base)
            return
        }
        if (code == BI_ARRAY_LEN) {
            if (num_args > 0) { r_int(interp_array_len(arg_ref(arg_base))); return }
            r_int(0)
            return
        }
        if (code == BI_ARRAY_PUSH) {
            if (num_args >= 2) {
                forge ph = arg_ref(arg_base)
                load_arg(arg_base + 1)
                interp_array_push(ph)
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_GET) {
            if (num_args >= 2) {
                arr_check_index(arg_ref(arg_base), arg_i(arg_base + 1))
                interp_array_get(arg_ref(arg_base), arg_i(arg_base + 1))
                return
            }
            r_null()
            return
        }
        if (code == BI_ARRAY_SET) {
            if (num_args >= 3) {
                forge sh = arg_ref(arg_base)
                forge si = arg_i(arg_base + 1)
                arr_check_index(sh, si)
                load_arg(arg_base + 2)
                interp_array_set(sh, si)
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_POP) {
            if (num_args > 0) {
                interp_array_pop(arg_ref(arg_base))
                return
            }
            r_null()
            return
        }
        if (code == BI_POW) {
            if (num_args >= 2) {
                r_float(ofs_pow(arg_num(arg_base), arg_num(arg_base + 1)))
                return
            }
            r_float(0.0)
            return
        }
        if (code == BI_SQRT) {
            if (num_args > 0) {
                r_float(ofs_sqrt(arg_num(arg_base)))
                return
            }
            r_float(0.0)
            return
        }
        if (code == BI_FAULT_CALL) {
            ffi_fault_call(num_args, arg_base)
            return
        }
        if (code == BI_FAULT_STEP) {
            ffi_fault_step(num_args, arg_base)
            return
        }
        if (code == BI_VARIANT_NAME) {
            // nome da variante; etiqueta fora da tabela sai como numero
            load_arg(arg_base)
            if (_rk == VAL_VARIANT) { r_string(_rt); return }
            forge vn_tag = reg_as_int()
            forge vn = variant_name_at(vn_tag)
            if (ofs_str_eq(vn, "")) { vn = ofs_stone_to_obsidian(vn_tag) }
            r_string(vn)
            return
        }
        if (code == BI_BOOL_TEXT) {
            load_arg(arg_base)
            if (r_truthy()) { r_string("true") } else { r_string("false") }
            return
        }
        if (code >= BI_FAULT_COUNT && code <= BI_FAULT_STEP) {
            call_fault(code, num_args, arg_base)
            return
        }
        r_void()
    }

    // ofs_array_len/push/get/set/pop sobre um ofs_array nativo cru
    // (elementos de 8 bytes; inteiros, ou crystal no push/set de crystal)
    vein raw_array_op(code: stone, num_args: stone, arg_base: stone) -> void {
        forge na: Array<stone> = arg_i(arg_base) as Array
        if (code == BI_ARRAY_LEN) { r_int(ofs_array_len(na)); return }
        if (code == BI_ARRAY_PUSH && num_args >= 2) {
            load_arg(arg_base + 1)
            if (_rk == VAL_FLOAT) {
                forge nf: Array<crystal> = arg_i(arg_base) as Array
                ofs_array_push(nf, _rf)
            } else {
                ofs_array_push(na, reg_as_int())
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_GET && num_args >= 2) {
            forge gv: stone = ofs_array_get(na, arg_i(arg_base + 1))
            r_int(gv)
            return
        }
        if (code == BI_ARRAY_SET && num_args >= 3) {
            forge si = arg_i(arg_base + 1)
            load_arg(arg_base + 2)
            if (_rk == VAL_FLOAT) {
                forge sf: Array<crystal> = arg_i(arg_base) as Array
                ofs_array_set(sf, si, _rf)
            } else {
                ofs_array_set(na, si, reg_as_int())
            }
            r_void()
            return
        }
        if (code == BI_ARRAY_POP) {
            forge pv: stone = ofs_array_pop(na)
            r_int(pv)
            return
        }
        r_void()
    }

    // ── Intrinsecos fault_* ───────────────────────────────────────────────
    // Mesmos resultados do build nativo (llvm.ctpop/ctlz/cttz/fshl/fshr/
    // bswap): inteiros de 64 bits em complemento de 2; 0 tem 64 zeros.

    // deslocamento logico a direita (o `>>` de stone e aritmetico)
    vein fault_lshr(x: stone, k: stone) -> stone {
        if (k <= 0) { return x }
        if (k >= 64) { return 0 }
        return (x >> k) & ((1 << (64 - k)) - 1)
    }

    vein fault_popcount(x: stone) -> stone {
        forge c = 0
        forge i = 0
        while (i < 64) {
            if (((x >> i) & 1) != 0) { c++ }
            i++
        }
        return c
    }

    vein fault_clz(x: stone) -> stone {
        forge i = 63
        while (i >= 0) {
            if (((x >> i) & 1) != 0) { return 63 - i }
            i--
        }
        return 64
    }

    vein fault_ctz(x: stone) -> stone {
        forge i = 0
        while (i < 64) {
            if (((x >> i) & 1) != 0) { return i }
            i++
        }
        return 64
    }

    vein fault_rotl(x: stone, n: stone) -> stone {
        forge s = n & 63
        if (s == 0) { return x }
        return (x << s) | fault_lshr(x, 64 - s)
    }

    vein fault_bswap(x: stone) -> stone {
        forge r = 0
        forge i = 0
        while (i < 8) {
            r = (r << 8) | ((x >> (8 * i)) & 255)
            i++
        }
        return r
    }

    // mascara dos `len` bytes baixos (len >= 8: todos)
    vein fault_byte_mask(len: stone) -> stone {
        if (len >= 8) { return -1 }
        return (1 << (8 * len)) - 1
    }

    vein fault_runtime_error(msg: obsidian) -> void {
        echo("Interpreter runtime error: " + msg)
        exit(1)
    }

    // fault_memcpy(dst, src, len) / fault_memset(dst, byte, len): memoria
    // crua de verdade (memcpy/memset da libc), como o llvm.memcpy/memset do
    // nativo. Ponteiros: endereco do C, &x, obsidian, monolith ou Array.
    vein fault_mem(code: stone, num_args: stone, arg_base: stone) -> void {
        if (num_args < 3) {
            fault_runtime_error("fault_memcpy/fault_memset esperam (ponteiro, valor, len)")
            return
        }
        forge len = arg_i(arg_base + 2)
        if (len <= 0) { r_void(); return }
        load_arg(arg_base)
        forge dst = reg_as_int()
        if (code == BI_FAULT_MEMCPY) {
            load_arg(arg_base + 1)
            forge src = reg_as_int()
            memcpy(dst as *u8, src as *u8, len)
        } else {
            memset(dst as *u8, arg_i(arg_base + 1) & 255, len)
        }
        r_void()
    }

    vein call_fault(code: stone, num_args: stone, arg_base: stone) -> void {
        forge a0 = 0
        forge a1 = 0
        forge a2 = 0
        forge a3 = 0
        if (num_args > 0) { a0 = arg_i(arg_base) }
        if (num_args > 1) { a1 = arg_i(arg_base + 1) }
        if (num_args > 2) { a2 = arg_i(arg_base + 2) }
        if (num_args > 3) { a3 = arg_i(arg_base + 3) }
        if (code == BI_FAULT_COUNT) { r_int(fault_popcount(a0)); return }
        if (code == BI_FAULT_LEAD) { r_int(fault_clz(a0)); return }
        if (code == BI_FAULT_TRAIL) { r_int(fault_ctz(a0)); return }
        if (code == BI_FAULT_SPIN_L) { r_int(fault_rotl(a0, a1)); return }
        if (code == BI_FAULT_SPIN_R) { r_int(fault_rotl(a0, 64 - (a1 & 63))); return }
        if (code == BI_FAULT_WEAVE) { r_int((a1 & a0) | (a2 & (a0 ^ -1))); return }
        if (code == BI_FAULT_SWAP) { r_int(fault_bswap(a0)); return }
        if (code == BI_FAULT_CUT) {
            r_int((a0 >> a1) & ((1 << a2) - 1))
            return
        }
        if (code == BI_FAULT_PATCH) {
            forge m1 = (1 << a2) - 1
            r_int((a0 & ((m1 << a1) ^ -1)) | ((a3 & m1) << a1))
            return
        }
        if (code == BI_FAULT_TRAP) {
            // como llvm.trap no nativo: SIGILL
            raise(4)
            exit(132)
            return
        }
        if (code == BI_FAULT_MEMCPY || code == BI_FAULT_MEMSET) {
            fault_mem(code, num_args, arg_base)
            return
        }
        r_void()
    }

    // ── FFI: extern vein / rift vein (F1) ─────────────────────────────────
    // Cada `extern vein f(...)` (ou `rift vein ... bind "sym"`) vira um
    // endereco: dlsym(RTLD_DEFAULT, sym), resolvido uma vez no carregamento
    // para toda chamada presente no programa (o linker do build nativo exige
    // o mesmo: simbolo referenciado e ausente = erro, codigo de saida 1).
    // O ofscc e linkado com -rdynamic, entao o runtime OFS (ofs_alloc,
    // ofs_echo_color...) tambem e achado; libm e as libs de OFS_FFI_LIBS sao
    // abertas com RTLD_GLOBAL antes. A chamada passa pelos trampolins tipados
    // de __ofs_ffi_dispatch (llvmgen.emit_ffi_dispatch): inteiros, bool,
    // ponteiros e obsidian (char*) vao como i64; crystal como double.
    // Ponteiros sao enderecos reais (VAL_INT com tipo "*T"); `&x`, Array
    // (a coluna nativa) e monolith (o bloco com layout C) vao ao C como
    // endereco (F2).

    // Plataforma: RTLD_DEFAULT e 0 em glibc, bionic (LP64) e no shim do
    // Windows (magma_windows.ofs); no macOS e -2. ffi_init descobre qual
    // funciona procurando `strlen`.
    forge _ffi_default: stone = 0
    forge _ffi_macos: bool = false

    vein ffi_rtld_default() -> stone {
        return _ffi_default
    }

    // RTLD_NOW | RTLD_GLOBAL (glibc/bionic LP64: 2 | 0x100; macOS: 2 | 8)
    vein ffi_dlopen_flags() -> stone {
        if (_ffi_macos) { return 10 }
        return 258
    }

    vein ffi_stderr(msg: obsidian) -> void {
        write(2, msg, ofs_str_len(msg))
    }

    vein ffi_open_lib(path: obsidian) -> bool {
        if (ofs_str_len(path) == 0) { return false }
        forge h = dlopen(path, ffi_dlopen_flags())
        if (h == 0) { return false }
        if (ofs_str_len(_ffi_libs) > 0) { _ffi_libs = _ffi_libs + ", " }
        _ffi_libs = _ffi_libs + path
        return true
    }

    vein ffi_init() -> void {
        if (_ffi_ready) { return }
        _ffi_ready = true
        _ffi_buf = ofs_alloc(FFI_BUF_BYTES) as stone
        if (dlsym(0, "strlen") == 0 && dlsym(-2, "strlen") != 0) {
            _ffi_default = -2
            _ffi_macos = true
        }
        // o build nativo liga -lm (e -lc); X11/Xft so entram em apps de UI
        if (!ffi_open_lib("libm.so.6")) { ffi_open_lib("libm.so") }
        // bibliotecas extras: OFS_FFI_LIBS="libfoo.so:/caminho/libbar.so"
        forge extra: obsidian = getenv("OFS_FFI_LIBS")
        if (extra != null) {
            forge n = ofs_str_len(extra)
            forge st = 0
            forge i = 0
            while (i <= n) {
                if (i == n || ofs_str_char_at(extra, i) == 58) {
                    forge lib = ofs_str_substr(extra, st, i - st)
                    if (ofs_str_len(lib) > 0 && !ffi_open_lib(lib)) {
                        ffi_stderr("ofs run: aviso: nao foi possivel abrir '" + lib + "' (OFS_FFI_LIBS)\n")
                    }
                    st = i + 1
                }
                i++
            }
        }
        _ffi_disp = dlsym(ffi_rtld_default(), "__ofs_ffi_dispatch")
        _ffi_exports = dlsym(ffi_rtld_default(), "ofs_alloc") != 0
    }

    vein ffi_type_class(t: obsidian) -> stone {
        if (ofs_str_len(t) == 0) { return TC_VOID }
        if (ofs_str_char_at(t, 0) == 42) { return TC_PTR }
        if (ofs_str_eq(t, "stone") || ofs_str_eq(t, "i64") || ofs_str_eq(t, "u64") || ofs_str_eq(t, "variant")) { return TC_INT }
        if (ofs_str_eq(t, "obsidian")) { return TC_STR }
        if (ofs_str_eq(t, "crystal") || ofs_str_eq(t, "f64")) { return TC_F64 }
        if (ofs_str_eq(t, "bool") || ofs_str_eq(t, "bool1")) { return TC_BOOL }
        if (ofs_str_eq(t, "void")) { return TC_VOID }
        if (ofs_str_eq(t, "i32")) { return TC_I32 }
        if (ofs_str_eq(t, "u32")) { return TC_U32 }
        if (ofs_str_eq(t, "i16")) { return TC_I16 }
        if (ofs_str_eq(t, "u16")) { return TC_U16 }
        if (ofs_str_eq(t, "i8")) { return TC_I8 }
        if (ofs_str_eq(t, "u8")) { return TC_U8 }
        if (ofs_str_eq(t, "ptr")) { return TC_PTR }
        if (ofs_str_eq(t, "f32")) { return TC_F32 }
        return TC_AGG
    }

    // sym vazio: o do `bind` (type_str do no) ou o proprio nome
    vein register_extern(name: obsidian, node_id: stone, sym_in: obsidian) -> void {
        forge sym: obsidian = sym_in
        if (ofs_str_len(sym) == 0) { sym = ntype(node_id) }
        if (ofs_str_len(sym) == 0) { sym = name }
        forge pcls: Array<stone> = []
        forge params = nc0(node_id)
        forge np = nx_len(params)
        forge j = 0
        while (j < np) {
            forge pid = nx_at(params, j)
            forge pt = ""
            if (nc0(pid) >= 0) { pt = nval(nc0(pid)) }
            ofs_array_push(pcls, ffi_type_class(pt))
            j++
        }
        forge rt = "void"
        if (nc1(node_id) >= 0) { rt = nval(nc1(node_id)) }
        ofs_array_push(_ext_names, name)
        ofs_array_push(_ext_syms, sym)
        ofs_array_push(_ext_nodes, node_id)
        ofs_array_push(_ext_addr, 0)
        ofs_array_push(_ext_vfix, llvmgen.variadic_fixed_count(sym))
        ofs_array_push(_ext_pcls, pcls)
        ofs_array_push(_ext_rcls, ffi_type_class(rt))
        ofs_array_push(_ext_rtype, rt)
    }

    // Vein definida em stdlib/runtime/*.ofs cujo simbolo o ofscc exporta (o
    // runtime linkado nele): roda nativa, como um builtin, em vez de
    // interpretar o codigo de memoria crua do runtime. OFS_RUN_RUNTIME=interp
    // desliga (interpreta tudo). Assinaturas fora do FFI continuam
    // interpretadas.
    vein ffi_runtime_native(node_id: stone, sym: obsidian) -> bool {
        if (!ast_line_is_runtime(node_line_of(node_id))) { return false }
        forge mode: obsidian = getenv("OFS_RUN_RUNTIME")
        if (mode != null && ofs_str_eq(mode, "interp")) { return false }
        forge params = nc0(node_id)
        forge np = nx_len(params)
        if (np > FFI_MAX_ARGS) { return false }
        forge fmask = 0
        forge j = 0
        while (j < np) {
            forge pid = nx_at(params, j)
            forge pt = ""
            if (nc0(pid) >= 0) { pt = nval(nc0(pid)) }
            forge c = ffi_type_class(pt)
            if (c == TC_AGG || c == TC_F32) { return false }
            if (c == TC_F64) {
                if (j >= 6) { return false }
                fmask = fmask | (1 << j)
            }
            j++
        }
        forge rt = "void"
        if (nc1(node_id) >= 0) { rt = nval(nc1(node_id)) }
        forge rc = ffi_type_class(rt)
        if (rc == TC_AGG || rc == TC_F32) { return false }
        forge retf = 0
        if (rc == TC_F64) { retf = 1 }
        if (!llvmgen.ffi_sig_supported(np, fmask, retf, 0)) { return false }
        ffi_init()
        if (_ffi_disp == 0 && (fmask != 0 || retf != 0)) { return false }
        return dlsym(ffi_rtld_default(), sym) != 0
    }

    vein find_extern(name: obsidian) -> stone {
        forge i = ofs_array_len(_ext_names) - 1
        while (i >= 0) {
            forge en: obsidian = ofs_array_get(_ext_names, i)
            if (ofs_str_eq(en, name)) { return i }
            i--
        }
        return -1
    }

    vein ext_sym(ei: stone) -> obsidian {
        forge s: obsidian = ofs_array_get(_ext_syms, ei)
        return s
    }

    // endereco da extern ei (0 = simbolo ausente)
    vein ffi_resolve(ei: stone) -> stone {
        forge a: stone = ofs_array_get(_ext_addr, ei)
        if (a != 0) { return a }
        ffi_init()
        a = dlsym(ffi_rtld_default(), ext_sym(ei))
        if (a == 0 && !_ffi_ui_libs) {
            // o wrapper `ofs build` tambem liga -lX11 -lXft quando existem:
            // abre so se algum simbolo nao for achado no processo/libm
            _ffi_ui_libs = true
            ffi_open_lib("libX11.so.6")
            ffi_open_lib("libXft.so.2")
            a = dlsym(ffi_rtld_default(), ext_sym(ei))
        }
        ofs_array_set(_ext_addr, ei, a)
        return a
    }

    // mesma ideia do erro do linker no build nativo
    vein ffi_undefined_msg(sym: obsidian) -> obsidian {
        forge m = "ofs run: erro: undefined reference to `" + sym + "' (extern vein sem simbolo no processo"
        if (ofs_str_len(_ffi_libs) > 0) { m = m + " nem em " + _ffi_libs }
        m = m + "; outras bibliotecas: OFS_FFI_LIBS=libx.so"
        if (!_ffi_exports) {
            m = m + "; este ofscc nao exporta o runtime: linke-o com -rdynamic"
        }
        return m + ")\n"
    }

    // Toda chamada a extern (e todo fault_addr de extern) presente no
    // programa precisa do simbolo, como no link nativo.
    vein ffi_check_symbols() -> void {
        forge missing = 0
        forge seen: Array<stone> = []
        forge i = 0
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_CALL) {
                forge ck: stone = ofs_array_get(_nop, i)
                forge ei = -1
                if (ck == CALL_EXTERN) {
                    ei = ofs_array_get(_naux, i)
                } else if (ck == CALL_BUILTIN) {
                    forge aux: stone = ofs_array_get(_naux, i)
                    if (aux == BI_FAULT_ADDR && nx_len(i) == 1) {
                        forge an = nx_at(i, 0)
                        if (find_function(nval(an)) < 0) { ei = find_extern(nval(an)) }
                    }
                }
                if (ei >= 0) {
                    if (ffi_resolve(ei) == 0) {
                        forge dup = false
                        forge si = 0
                        while (si < ofs_array_len(seen)) {
                            forge sv: stone = ofs_array_get(seen, si)
                            if (ofs_str_eq(ext_sym(sv), ext_sym(ei))) { dup = true }
                            si++
                        }
                        if (!dup) {
                            ofs_array_push(seen, ei)
                            ffi_stderr(ffi_undefined_msg(ext_sym(ei)))
                            missing++
                        }
                    }
                }
            }
            i++
        }
        if (missing > 0) { exit(1) }
    }

    // ajusta v a largura/sinal da classe (o que o C espera no registrador)
    vein ffi_narrow(v: stone, cls: stone) -> stone {
        if (cls == TC_I32) { return ((v & 4294967295) ^ 2147483648) - 2147483648 }
        if (cls == TC_U32) { return v & 4294967295 }
        if (cls == TC_I16) { return ((v & 65535) ^ 32768) - 32768 }
        if (cls == TC_U16) { return v & 65535 }
        if (cls == TC_I8) { return ((v & 255) ^ 128) - 128 }
        if (cls == TC_U8) { return v & 255 }
        if (cls == TC_BOOL) {
            if ((v & 4294967295) != 0) { return 1 }
            return 0
        }
        return v
    }

    // argumento na posicao pos como i64 para o C (classe inteira/ponteiro)
    vein ffi_arg_int(pos: stone, cls: stone, what: obsidian) -> stone {
        forge k = arg_kind(pos)
        forge v = 0
        if (k == VAL_INT) { v = arg_i(pos) }
        else if (k == VAL_BOOL) {
            if (arg_b(pos)) { v = 1 }
        }
        else if (k == VAL_FLOAT) { v = arg_f(pos) as stone }
        else if (k == VAL_STRING) { v = arg_s(pos) as stone }
        else if (k == VAL_NULL || k == VAL_VOID) { v = 0 }
        else if (k == VAL_VARIANT) { v = variant_index(arg_t(pos)) }
        else if (k == VAL_OBJECT) { v = arg_ref(pos) }
        else if (k == VAL_ARRAY) {
            // o ofs_array nativo do array; o comprimento volta na sincronia
            forge h = arg_ref(pos)
            v = arr_native_ptr(h)
            ofs_array_push(_ffi_sync_h, h)
            ofs_array_push(_ffi_sync_c, _arr_last_col)
        }
        return ffi_narrow(v, cls)
    }

    vein ffi_slot(i: stone) -> stone {
        return _ffi_buf + 8 * i
    }

    vein ffi_put_i(i: stone, v: stone) -> void {
        forge p: *stone = ffi_slot(i) as *stone
        fracture { *p = v }
    }

    vein ffi_put_f(i: stone, v: crystal) -> void {
        forge p: *crystal = ffi_slot(i) as *crystal
        fracture { *p = v }
    }

    vein ffi_get_i(i: stone) -> stone {
        forge p: *stone = ffi_slot(i) as *stone
        forge v: stone = 0
        fracture { v = *p }
        return v
    }

    vein ffi_get_f(i: stone) -> crystal {
        forge p: *crystal = ffi_slot(i) as *crystal
        forge v: crystal = 0.0
        fracture { v = *p }
        return v
    }

    // Chama addr com os slots ja preenchidos; resultado inteiro bruto (o
    // double fica em _ffi_ret_f).
    forge _ffi_ret_f: crystal = 0.0

    vein ffi_invoke(addr: stone, nargs: stone, fmask: stone, retf: stone, vfixed: stone, what: obsidian) -> stone {
        if (!llvmgen.ffi_sig_supported(nargs, fmask, retf, vfixed)) {
            fault_runtime_error(what + ": assinatura FFI sem trampolim (" + ofs_stone_to_obsidian(nargs) + " args; ate 4 com crystal, 12 so inteiros, variadica ate 4 extras)")
            return 0
        }
        if (_ffi_disp == 0) {
            // ofscc sem trampolins (gerado por compilador antigo ou sem
            // -rdynamic): so inteiros/ponteiros, todos como i64
            if (fmask != 0 || retf != 0) {
                fault_runtime_error(what + ": crystal no FFI precisa dos trampolins (__ofs_ffi_dispatch) e de um ofscc linkado com -rdynamic")
                return 0
            }
            return fault_call(addr, ffi_get_i(0), ffi_get_i(1), ffi_get_i(2), ffi_get_i(3), ffi_get_i(4), ffi_get_i(5), ffi_get_i(6), ffi_get_i(7), ffi_get_i(8), ffi_get_i(9), ffi_get_i(10), ffi_get_i(11))
        }
        ffi_put_i(FFI_SLOT_ST, 0)
        forge r = fault_call(_ffi_disp, addr, llvmgen.ffi_sig(nargs, fmask, retf, vfixed), _ffi_buf)
        if (ffi_get_i(FFI_SLOT_ST) != 0) {
            fault_runtime_error(what + ": assinatura FFI sem trampolim")
            return 0
        }
        if (retf != 0) { _ffi_ret_f = ffi_get_f(FFI_SLOT_RET) }
        return r
    }

    // resultado -> registradores
    vein call_extern(ei: stone, num_args: stone, arg_base: stone) -> void {
        forge addr = ffi_resolve(ei)
        forge sym = ext_sym(ei)
        if (addr == 0) {
            ffi_stderr(ffi_undefined_msg(sym))
            exit(1)
            return
        }
        forge pcls: Array<stone> = ofs_array_get(_ext_pcls, ei)
        forge np = ofs_array_len(pcls)
        forge vfixed: stone = ofs_array_get(_ext_vfix, ei)
        if (vfixed > np) { vfixed = -1 }
        if (vfixed < 0) { vfixed = 0 }
        forge rcls: stone = ofs_array_get(_ext_rcls, ei)
        forge what = "extern '" + sym + "'"
        forge sync_base = ofs_array_len(_ffi_sync_h)
        if (num_args > FFI_MAX_ARGS) {
            fault_runtime_error(what + ": mais de 12 argumentos no FFI do interpretador")
            return
        }
        forge fmask = 0
        forge j = 0
        while (j < num_args) {
            forge cls = TC_INT
            if (j < np) {
                cls = ofs_array_get(pcls, j)
            } else if (arg_kind(arg_base + j) == VAL_FLOAT) {
                cls = TC_F64
            }
            if (cls == TC_F64) {
                if (j >= 6) {
                    fault_runtime_error(what + ": crystal depois do 6o argumento no FFI do interpretador")
                    return
                }
                fmask = fmask | (1 << j)
                ffi_put_f(FFI_SLOT_F + j, arg_num(arg_base + j))
            } else if (cls == TC_F32) {
                fault_runtime_error(what + ": f32 no FFI do interpretador ainda nao e suportado")
                return
            } else if (cls == TC_AGG) {
                // monolith/Array: o nativo passa ponteiro
                ffi_put_i(j, ffi_arg_int(arg_base + j, TC_PTR, what))
            } else {
                ffi_put_i(j, ffi_arg_int(arg_base + j, cls, what))
            }
            j++
        }
        if (rcls == TC_F32) {
            fault_runtime_error(what + ": retorno f32 no FFI do interpretador ainda nao e suportado")
            return
        }
        forge retf = 0
        if (rcls == TC_F64) { retf = 1 }
        forge r = ffi_invoke(addr, num_args, fmask, retf, vfixed, what)
        forge rtype: obsidian = ofs_array_get(_ext_rtype, ei)
        if (rcls == TC_AGG) {
            ffi_set_agg_result(r, rtype, sync_base)
        } else {
            ffi_set_result(r, rcls, rtype)
        }
        ffi_sync_arrays(sync_base)
    }

    // arrays passados ao C desde sync_base: comprimento de volta (o C pode ter
    // feito push/pop); registradores intactos
    vein ffi_sync_arrays(sync_base: stone) -> void {
        while (ofs_array_len(_ffi_sync_h) > sync_base) {
            forge n = ofs_array_len(_ffi_sync_h) - 1
            forge h: stone = ofs_array_get(_ffi_sync_h, n)
            forge c: stone = ofs_array_get(_ffi_sync_c, n)
            arr_sync(h, c)
            ofs_array_pop(_ffi_sync_h)
            ofs_array_pop(_ffi_sync_c)
        }
    }

    // retorno monolith/Array do C (ponteiro): monolith = o bloco; Array = o
    // array que foi passado nesta chamada (mesmo ofs_array) ou um novo que
    // usa o bloco nativo
    vein ffi_set_agg_result(r: stone, rtype: obsidian, sync_base: stone) -> void {
        if (r == 0) { r_null(); return }
        forge c = mem_class(rtype)
        if (c == MC_ARRAY) {
            forge i = sync_base
            while (i < ofs_array_len(_ffi_sync_h)) {
                forge h: stone = ofs_array_get(_ffi_sync_h, i)
                forge col: stone = ofs_array_get(_ffi_sync_c, i)
                if (arr_col_array(h, col) == r) { r_array(h); return }
                i++
            }
        }
        regs_from_raw(r, c, rtype)
    }

    // retorno bruto do C -> registradores, pelo tipo declarado
    vein ffi_set_result(r: stone, rcls: stone, rtype: obsidian) -> void {
        if (rcls == TC_VOID) { r_void(); return }
        if (rcls == TC_F64) { r_float(_ffi_ret_f); return }
        if (rcls == TC_BOOL) { r_bool(ffi_narrow(r, TC_BOOL) != 0); return }
        if (rcls == TC_STR) {
            // char* do C vira obsidian sem copia: no nativo obsidian E o
            // ponteiro (FILE* em `-> obsidian`, buffer de ofs_alloc que o C
            // preenche depois); copiar quebraria esses usos.
            if (r == 0) { r_null(); return }
            r_string(r as obsidian)
            return
        }
        if (rcls == TC_PTR) {
            if (r == 0) { r_null(); return }
            r_int(r)
            _rt = rtype
            return
        }
        r_int(ffi_narrow(r, rcls))
    }

    // fault_addr(vein): endereco C (extern/rift); vein OFS e callback (F2)
    vein ffi_fault_addr(id: stone) -> void {
        forge an = nx_at(id, 0)
        forge name: obsidian = nval(an)
        forge fid = find_function(name)
        if (fid >= 0) {
            r_int(cb_slot_for(fid, name))
            return
        }
        forge ei = find_extern(name)
        if (ei < 0) {
            fault_runtime_error("fault_addr espera o nome de uma vein")
            return
        }
        forge a = ffi_resolve(ei)
        if (a == 0) {
            ffi_stderr(ffi_undefined_msg(ext_sym(ei)))
            exit(1)
        }
        r_int(a)
    }

    // fault_call(endereco, args...): como no nativo, cada argumento vai no
    // tipo do valor (crystal = double, resto i64) e o retorno e i64.
    vein ffi_fault_call(num_args: stone, arg_base: stone) -> void {
        if (num_args < 1) { r_int(0); return }
        forge ak = arg_kind(arg_base)
        if (ak != VAL_INT) {
            fault_runtime_error("fault_call: o primeiro argumento precisa ser um endereco (fault_addr)")
            return
        }
        ffi_init()
        forge addr = arg_i(arg_base)
        forge sync_base = ofs_array_len(_ffi_sync_h)
        forge n = num_args - 1
        if (n > FFI_MAX_ARGS) {
            fault_runtime_error("fault_call: mais de 12 argumentos no interpretador")
            return
        }
        forge fmask = 0
        forge j = 0
        while (j < n) {
            forge pos = arg_base + 1 + j
            if (arg_kind(pos) == VAL_FLOAT) {
                if (j >= 6) {
                    fault_runtime_error("fault_call: crystal depois do 6o argumento")
                    return
                }
                fmask = fmask | (1 << j)
                ffi_put_f(FFI_SLOT_F + j, arg_f(pos))
            } else if (arg_kind(pos) == VAL_BOOL) {
                ffi_put_i(j, ffi_arg_int(pos, TC_BOOL, "fault_call"))
            } else {
                ffi_put_i(j, ffi_arg_int(pos, TC_INT, "fault_call"))
            }
            j++
        }
        forge fr = ffi_invoke(addr, n, fmask, 0, 0, "fault_call")
        ffi_sync_arrays(sync_base)
        r_int(fr)
    }

    // fault_step(p, i): p + i * sizeof(*p) (getelementptr do llvmgen, com o
    // tipo estatico de p; sem ele, o tipo do valor)
    vein ffi_fault_step(num_args: stone, arg_base: stone) -> void {
        if (num_args < 2) { r_null(); return }
        forge t: obsidian = ""
        if (_cur_call_id >= 0) { t = ntype(nx_at(_cur_call_id, 0)) }
        if (!(ofs_str_len(t) > 1 && ofs_str_char_at(t, 0) == 42)) { t = arg_t(arg_base) }
        load_arg(arg_base)
        forge base = reg_as_int()
        forge pointee = pointee_of(t)
        r_int(base + arg_i(arg_base + 1) * llvmgen.type_storage_size(pointee))
        if (ofs_str_len(t) > 1 && ofs_str_char_at(t, 0) == 42) { _rt = t }
    }

    // ── Callbacks C -> OFS (fault_addr de vein interpretada) ─────────────
    // Cada vein recebe um slot fixo da tabela de trampolins nativos
    // (llvmgen.emit_cb_trampolines, FFI_CB_SLOTS); o trampolim chama
    // __ofs_cb_enter(slot, a0..a5), que reentra no interpretador (inclusive
    // dentro de uma chamada C feita pelo proprio interpretador, como qsort).
    // So inteiros/ponteiros/obsidian/bool/monolith (por ponteiro) nos
    // parametros e no retorno; crystal/f32 = erro claro.

    vein cb_slot_for(fid: stone, name: obsidian) -> stone {
        ffi_init()
        if (_cb_table == 0) {
            _cb_table = dlsym(ffi_rtld_default(), "__ofs_cb_table")
            if (_cb_table == 0) {
                fault_runtime_error("fault_addr(" + name + "): callback para o C precisa dos trampolins __ofs_cb_table (ofscc compilado por um ofscc com F2 e linkado com -rdynamic)")
                return 0
            }
        }
        forge slot = 0
        forge n = ofs_array_len(_cb_fn)
        while (slot < n) {
            forge f: stone = ofs_array_get(_cb_fn, slot)
            if (f == fid) { return fault_call(_cb_table, slot) }
            slot++
        }
        if (n >= FFI_CB_SLOTS) {
            fault_runtime_error("fault_addr(" + name + "): trampolins de callback esgotados (" + ofs_stone_to_obsidian(FFI_CB_SLOTS) + " veins diferentes por execucao)")
            return 0
        }
        forge pcls: Array<stone> = []
        forge ptypes: Array<obsidian> = []
        forge params = nc0(fid)
        forge np = nx_len(params)
        if (np > FFI_CB_ARGS) {
            fault_runtime_error("fault_addr(" + name + "): callback com mais de " + ofs_stone_to_obsidian(FFI_CB_ARGS) + " parametros")
            return 0
        }
        forge j = 0
        while (j < np) {
            forge pid = nx_at(params, j)
            forge pt = ""
            if (nc0(pid) >= 0) { pt = type_node_str(nc0(pid)) }
            forge c = mem_class(pt)
            if (c == MC_F64 || c == MC_F32) {
                fault_runtime_error("fault_addr(" + name + "): callback com parametro crystal/f32 ainda nao e suportado no interpretador (so inteiros/ponteiros)")
                return 0
            }
            ofs_array_push(pcls, c)
            ofs_array_push(ptypes, pt)
            j++
        }
        forge rt = "void"
        if (nc1(fid) >= 0) { rt = type_node_str(nc1(fid)) }
        forge rc = mem_class(rt)
        if (rc == MC_F64 || rc == MC_F32) {
            fault_runtime_error("fault_addr(" + name + "): callback com retorno crystal/f32 ainda nao e suportado no interpretador (so inteiros/ponteiros)")
            return 0
        }
        ofs_array_push(_cb_fn, fid)
        ofs_array_push(_cb_pcls, pcls)
        ofs_array_push(_cb_ptypes, ptypes)
        ofs_array_push(_cb_rcls, rc)
        return fault_call(_cb_table, n)
    }

    vein cb_raw_arg(j: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone) -> stone {
        if (j == 0) { return a0 }
        if (j == 1) { return a1 }
        if (j == 2) { return a2 }
        if (j == 3) { return a3 }
        if (j == 4) { return a4 }
        return a5
    }

    // entrada de um trampolim: roda a vein do slot com os argumentos brutos
    vein cb_enter(slot: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone) -> stone {
        if (slot < 0 || slot >= ofs_array_len(_cb_fn)) { return 0 }
        forge sk = _rk
        forge st: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        forge scall = _cur_call_id
        forge fid: stone = ofs_array_get(_cb_fn, slot)
        forge pcls: Array<stone> = ofs_array_get(_cb_pcls, slot)
        forge ptypes: Array<obsidian> = ofs_array_get(_cb_ptypes, slot)
        forge np = ofs_array_len(pcls)
        forge base = ofs_array_len(_arg_kinds)
        forge j = 0
        while (j < np) {
            forge c: stone = ofs_array_get(pcls, j)
            forge t: obsidian = ofs_array_get(ptypes, j)
            regs_from_raw(cb_raw_arg(j, a0, a1, a2, a3, a4, a5), c, t)
            arg_push_regs()
            j++
        }
        call_function_by_id(fid, np, base)
        forge r = reg_as_int()
        args_pop_to(base)
        r_set(sk, st, si, sf, sb, ss, sr)
        _cur_call_id = scall
        return r
    }

    // ── LValue Evaluation ─────────────────────────────────────────────────

    vein set_lvalue(k: stone, var_idx: stone, h: stone, idx: stone, field: obsidian) -> void {
        _lk = k
        _lvar = var_idx
        _lh = h
        _lidx = idx
        _lfield = field
    }

    // resultado -> registradores de lvalue (_lk.. )
    vein eval_lvalue(id: stone) -> void {
        if (id < 0) { set_lvalue(LOC_INVALID, -1, -1, -1, ""); return }
        forge kind = nk(id)

        if (kind == NK_IDENT) {
            forge idx = find_var(node_sym(id))
            if (idx >= 0) {
                set_lvalue(LOC_VAR, idx, -1, -1, nval(id))
                return
            }
        }

        if (kind == NK_INDEX) {
            eval_expr(nc0(id))
            forge ak = _rk
            forge ar = _rr
            eval_expr(nc1(id))
            if (ak == VAL_ARRAY) {
                set_lvalue(LOC_ARRAY, -1, ar, _ri, "")
                return
            }
        }

        if (kind == NK_FIELD) {
            eval_expr(nc0(id))
            if (_rk == VAL_OBJECT && _rr > 0) {
                set_lvalue(LOC_FIELD, -1, _rr, field_cached(id, _rt), "")
                return
            }
        }

        if (kind == NK_UNARY_OP) {
            if (nop(id) == OP_DEREF) {
                // `*p = v`: memoria crua no endereco p, na largura do tipo
                // apontado (null = endereco 0: falha como no nativo)
                eval_expr(nc0(id))
                deref_type(id)
                set_lvalue(LOC_MEM, -1, reg_as_int(), _dt_c, _dt_t)
                return
            }
        }

        set_lvalue(LOC_INVALID, -1, -1, -1, "")
    }

    // compara o valor a* com os registradores
    vein val_equals_regs(ak: stone, at: obsidian, ai: stone, af: crystal, ab: bool, astr: obsidian, ar: stone) -> bool {
        if (ak == VAL_VARIANT && _rk == VAL_VARIANT) {
            return ofs_str_eq(at, _rt)
        }
        if (ak == VAL_STRING && _rk == VAL_STRING) {
            return ofs_str_eq(astr, _rs)
        }
        if (ak == VAL_FLOAT || _rk == VAL_FLOAT) {
            forge lf: crystal = 0.0
            if (ak == VAL_FLOAT) { lf = af } else { lf = ai as crystal }
            forge rf: crystal = 0.0
            if (_rk == VAL_FLOAT) { rf = _rf } else { rf = _ri as crystal }
            return lf == rf
        }
        if (ak == VAL_BOOL && _rk == VAL_BOOL) {
            return ab == _rb
        }
        if (ak == VAL_NULL && _rk == VAL_NULL) {
            return true
        }
        // ponteiro do C/memoria crua comparado com null
        if (ak == VAL_NULL && _rk == VAL_INT) { return _ri == 0 }
        if (ak == VAL_INT && _rk == VAL_NULL) { return ai == 0 }
        if (ak == VAL_NULL || _rk == VAL_NULL) {
            return false
        }
        if (ak == VAL_ARRAY && _rk == VAL_ARRAY) {
            return ar == _rr
        }
        if (ak == VAL_OBJECT && _rk == VAL_OBJECT) {
            return ar == _rr
        }
        return ai == _ri
    }

    // left = a*, right = registradores; resultado -> registradores
    vein eval_bin_calc(op: stone, ak: stone, at: obsidian, ai: stone, af: crystal, ab: bool, astr: obsidian) -> void {
        forge lf: crystal = 0.0
        forge rf: crystal = 0.0
        forge is_f: bool = ak == VAL_FLOAT || _rk == VAL_FLOAT
        if (is_f) {
            if (ak == VAL_FLOAT) { lf = af } else { lf = ai as crystal }
            if (_rk == VAL_FLOAT) { rf = _rf } else { rf = _ri as crystal }
        }
        if (op == OP_ADD) {
            if (ak == VAL_STRING || _rk == VAL_STRING) {
                forge ls: obsidian = val_str(ak, at, ai, af, ab, astr)
                forge rs: obsidian = r_to_string()
                r_string(ls + rs)
                return
            }
            if (is_f) { r_float(lf + rf); return }
            r_int(ai + _ri)
            return
        }
        if (op == OP_SUB) {
            if (is_f) { r_float(lf - rf); return }
            r_int(ai - _ri)
            return
        }
        if (op == OP_MUL) {
            if (is_f) { r_float(lf * rf); return }
            r_int(ai * _ri)
            return
        }
        if (op == OP_DIV) {
            if (is_f) {
                if (rf == 0.0) { r_float(0.0); return }
                r_float(lf / rf)
                return
            }
            if (_ri == 0) { r_int(0); return }
            r_int(ai / _ri)
            return
        }
        if (op == OP_MOD) {
            if (_ri == 0) { r_int(0); return }
            r_int(ai % _ri)
            return
        }
        if (op == OP_BAND) { r_int(ai & _ri); return }
        if (op == OP_BOR) { r_int(ai | _ri); return }
        if (op == OP_BXOR) { r_int(ai ^ _ri); return }
        if (op == OP_SHL) { r_int(ai << _ri); return }
        if (op == OP_SHR) { r_int(ai >> _ri); return }
        r_int(0)
    }

    // left = a*, right = registradores; ordem (<, <=, >, >=) -> bool
    vein eval_compare(op: stone, ak: stone, ai: stone, af: crystal) -> bool {
        if (ak == VAL_FLOAT || _rk == VAL_FLOAT) {
            forge lf: crystal = 0.0
            if (ak == VAL_FLOAT) { lf = af } else { lf = ai as crystal }
            forge rf: crystal = 0.0
            if (_rk == VAL_FLOAT) { rf = _rf } else { rf = _ri as crystal }
            if (op == OP_LT) { return lf < rf }
            if (op == OP_LE) { return lf <= rf }
            if (op == OP_GT) { return lf > rf }
            return lf >= rf
        }
        if (op == OP_LT) { return ai < _ri }
        if (op == OP_LE) { return ai <= _ri }
        if (op == OP_GT) { return ai > _ri }
        return ai >= _ri
    }

    vein calc_op_of_assign(op: stone) -> stone {
        if (op == OP_ADD_ASSIGN) { return OP_ADD }
        if (op == OP_SUB_ASSIGN) { return OP_SUB }
        if (op == OP_MUL_ASSIGN) { return OP_MUL }
        if (op == OP_DIV_ASSIGN) { return OP_DIV }
        return OP_MOD
    }

    // ── Expression Evaluation ─────────────────────────────────────────────
    //
    // Cada tipo de no tem a sua vein, com os locais declarados logo no
    // inicio (allocas estaticas e pequenas): a recursao do programa
    // interpretado passa por estas veins, e o tamanho de cada quadro nativo
    // limita a profundidade de recursao suportada.

    // resultado -> registradores
    vein eval_expr(id: stone) -> void {
        forge kind = nk(id)
        if (id < 0) { r_void(); return }
        if (kind == NK_BIN_OP) { eval_bin_op(id); return }
        if (kind == NK_IDENT) { eval_ident(id); return }
        if (kind == NK_LIT_INT) { r_int(naux(id)); return }
        if (kind == NK_CALL) { eval_call(id); return }
        if (kind == NK_INDEX) { eval_index(id); return }
        if (kind == NK_LIT_STRING) { r_string(nval(id)); return }
        if (kind == NK_LIT_FLOAT) { eval_lit_float(id); return }
        if (kind == NK_LIT_BOOL) { r_bool(naux(id) != 0); return }
        if (kind == NK_LIT_NULL) { r_null(); return }
        if (kind == NK_FIELD) { eval_field(id); return }
        if (kind == NK_UNARY_OP) { eval_unary_op(id); return }
        if (kind == NK_POST_OP) { eval_post_op(id); return }
        if (kind == NK_CAST) { eval_cast(id); return }
        if (kind == NK_ARRAY_LIT) { eval_array_lit(id); return }
        r_null()
    }

    vein eval_lit_float(id: stone) -> void {
        forge fv: crystal = ofs_array_get(_nf, id) as crystal
        r_float(fv)
    }

    vein eval_array_lit(id: stone) -> void {
        forge h = interp_new_array()
        forge elems: Array<stone> = nextra(id)
        forge count = ofs_array_len(elems)
        forge i = 0
        forge elem_id = 0
        while (i < count) {
            elem_id = ofs_array_get(elems, i)
            eval_expr(elem_id)
            interp_array_push(h)
            i++
        }
        r_array(h)
    }

    vein eval_ident(id: stone) -> void {
        forge vidx = 0
        if (nop(id) != 0) {
            r_null()
            r_variant(nval(id))
            return
        }
        vidx = find_var(node_sym(id))
        if (vidx >= 0) {
            env_load(vidx)
            return
        }
        r_null()
    }

    vein eval_index(id: stone) -> void {
        forge ak = 0
        forge ar = 0
        eval_expr(nc0(id))
        ak = _rk
        ar = _rr
        eval_expr(nc1(id))
        if (ak == VAL_ARRAY) {
            arr_check_index(ar, _ri)
            interp_array_get(ar, _ri)
            return
        }
        r_null()
    }

    vein eval_field(id: stone) -> void {
        eval_expr(nc0(id))
        if (_rk == VAL_OBJECT && _rr > 0) {
            forge fi = field_cached(id, _rt)
            if (fi < 0) { r_null(); return }
            obj_load_field(_rr, fi)
            return
        }
        r_null()
    }

    // etiqueta numerica da variante: posicao global em ordem de declaracao
    // (a mesma do llvmgen, onde variantes sao globais i64)
    vein variant_index(name: obsidian) -> stone {
        forge i = 0
        forge n = ofs_array_len(_variant_names)
        while (i < n) {
            forge vn: obsidian = ofs_array_get(_variant_names, i)
            if (ofs_str_eq(vn, name)) { return i }
            i++
        }
        return -1
    }

    vein is_strata_name(name: obsidian) -> bool {
        if (ofs_str_len(name) == 0) { return false }
        forge i = 0
        while (i < _n_count) {
            if (nk(i) == NK_STRATA && ofs_str_eq(nval(i), name)) { return true }
            i++
        }
        return false
    }

    // `x?` sobre variante (mesma semantica do nativo, ver llvmgen.emit_try):
    //   Solid(v)? / Ore(v)? -> v
    //   Crack(e)? / Barren? -> sai da vein atual (anchors rodam) devolvendo a
    //     variante se o retorno declarado for um tipo `strata`; senao a
    //     etiqueta numerica (stone; crystal/obsidian convertidos; void: nada)
    vein eval_try(id: stone) -> void {
        eval_expr(nc0(id))
        if (_rk != VAL_VARIANT) { return }
        forge bt: obsidian = _rt
        forge bi = _ri
        forge bs: obsidian = _rs
        if (ofs_str_eq(bt, "Crack") || ofs_str_eq(bt, "Barren")) {
            forge rt: obsidian = ""
            if (_cur_fn_id >= 0 && nk(_cur_fn_id) == NK_FN_DECL && nc1(_cur_fn_id) >= 0) {
                rt = nval(nc1(_cur_fn_id))
            }
            if (!is_strata_name(rt)) {
                forge tag = variant_index(bt)
                if (ofs_str_eq(rt, "void")) { r_void() }
                else if (ofs_str_eq(rt, "crystal")) { r_float(tag as crystal) }
                else if (ofs_str_eq(rt, "obsidian")) { r_string(ofs_stone_to_obsidian(tag)) }
                else { r_int(tag) }
            }
            set_return_from_regs()
            _try_unwind = true
            r_null()
            return
        }
        if (!ofs_str_eq(bs, bt)) {
            r_string(bs)
            return
        }
        r_int(bi)
    }

    vein eval_post_op(id: stone) -> void {
        forge pcode = nop(id)
        if (pcode == OP_TRY) { eval_try(id); return }
        eval_lvalue(nc0(id))
        forge plk = _lk
        forge plv = _lvar
        forge plh = _lh
        forge pli = _lidx
        forge plf: obsidian = _lfield
        load_location(plk, plv, plh, pli, plf)
        forge ok = _rk
        forge ot: obsidian = _rt
        forge oi = _ri
        forge of: crystal = _rf
        forge ob = _rb
        forge os: obsidian = _rs
        forge orr = _rr
        if (pcode == OP_INC) {
            r_int(oi + 1)
        } else {
            r_int(oi - 1)
        }
        store_location(plk, plv, plh, pli, plf)
        r_set(ok, ot, oi, of, ob, os, orr)
    }

    vein eval_unary_op(id: stone) -> void {
        forge uop = nop(id)
        forge ival = 0
        if (uop == OP_ADDR) {
            eval_addr(id)
            return
        }
        eval_expr(nc0(id))
        if (uop == OP_DEREF) {
            // `*p`: le a memoria crua em p pela largura do tipo apontado
            deref_type(id)
            mem_load(reg_as_int(), _dt_c, _dt_t)
            return
        }
        if (uop == OP_NEG) {
            if (_rk == VAL_FLOAT) {
                r_float(0.0 - _rf)
                return
            }
            r_int(0 - _ri)
            return
        }
        if (uop == OP_NOT) {
            if (r_truthy()) {
                r_bool(false)
                return
            }
            r_bool(true)
            return
        }
        if (uop == OP_BNOT) {
            ival = _ri
            r_int(~ival)
            return
        }
    }

    // `&x` (endereco real): variavel -> slot de memoria crua (box_var);
    // monolith -> o proprio bloco. Como no
    // llvmgen, o tipo e "*" + tipo do operando (typeck).
    vein eval_addr(id: stone) -> void {
        forge c = nc0(id)
        forge ck = nk(c)
        if (ck == NK_IDENT) {
            forge idx = find_var(node_sym(c))
            if (idx < 0) {
                fault_runtime_error("&" + nval(c) + ": variavel desconhecida")
                return
            }
            forge k: stone = ofs_array_get(_env_kind, idx)
            forge a = 0
            if (k == VAL_OBJECT) {
                a = ofs_array_get(_env_ref, idx)
            } else {
                a = box_var(idx, ntype(c))
            }
            r_int(a)
            _rt = ntype(id)
            return
        }
        // `&s.campo`, `&a[i]`: o llvmgen so tem endereco de variavel (para o
        // resto devolve o valor, nao o endereco); aqui, erro claro
        fault_runtime_error("&expr: so existe endereco de variavel (&x); para um campo use (&s) as stone + offset")
    }

    // `x as T` com a regra do llvmgen (NK_CAST): mesmo tipo LLVM = so muda o
    // tipo; ptrtoint/inttoptr; fptosi/sitofp (da largura de origem);
    // fpext/fptrunc; trunc se a origem e mais larga, senao zext.
    // _naux = classe do destino; _nop = classe estatica da origem + 1.
    vein eval_cast(id: stone) -> void {
        forge dt: obsidian = nval(id)
        forge dc = naux(id)
        forge sstat = nop(id) - 1
        eval_expr(nc0(id))
        forge k = _rk
        if (dc == MC_STR) {
            if (k == VAL_STRING || k == VAL_NULL) { return }
            if (k == VAL_INT || k == VAL_OBJECT || k == VAL_ARRAY) {
                // inttoptr / ptr -> ptr: o endereco vira char*
                forge pa = reg_as_int()
                if (pa == 0) { r_null(); return }
                r_string(pa as obsidian)
                return
            }
            // bool/crystal/variante: o nativo nao compila; vira texto
            r_string(r_to_string())
            return
        }
        if (dc == MC_PTR || dc == MC_OBJ || dc == MC_ARRAY) {
            if (k == VAL_NULL) { return }
            if (k == VAL_OBJECT && dc == MC_OBJ) { _rt = dt; return }
            if (k == VAL_ARRAY && dc == MC_ARRAY) { return }
            forge pv = 0
            if (k == VAL_FLOAT) { pv = _rf as stone } else { pv = reg_as_int() }
            if (dc == MC_OBJ) {
                if (pv == 0) { r_null(); return }
                r_object(dt, pv)
                return
            }
            if (dc == MC_ARRAY) {
                if (pv == 0) { r_null(); return }
                r_array(arr_adopt(pv, dt))
                return
            }
            r_int(pv)
            _rt = dt
            return
        }
        if (dc == MC_F64 || dc == MC_F32) {
            forge f: crystal = 0.0
            if (k == VAL_FLOAT) { f = _rf }
            else if (k == VAL_INT) {
                // iN com sinal, uN sem sinal (sitofp/uitofp do llvmgen)
                forge sc = cast_src_class(sstat)
                f = mc_canon(sc, _ri) as crystal
            }
            else if (k == VAL_BOOL) {
                if (_rb) { f = 1.0 }
            }
            else if (k == VAL_STRING) { f = parse_float(_rs) }
            else { f = reg_as_int() as crystal }
            if (dc == MC_F32) {
                r_float(f32_round(f))
                _rt = "f32"
                return
            }
            r_float(f)
            return
        }
        if (dc == MC_BOOL) {
            if (k == VAL_BOOL) { return }
            forge bv = 0
            if (k == VAL_FLOAT) { bv = _rf as stone } else { bv = reg_as_int() }
            r_bool((bv & 4294967295) != 0)
            return
        }
        // destino inteiro
        forge v = 0
        if (k == VAL_FLOAT) { v = _rf as stone }
        else if (k == VAL_INT) {
            forge sc2 = cast_src_class(sstat)
            v = _ri
            if (mc_bits(sc2) < mc_bits(dc)) {
                // estende da largura de origem: sext para iN, zext para uN
                v = mc_canon(sc2, v)
            }
        } else { v = reg_as_int() }
        r_int(mc_canon(dc, v))
        if (mc_is_narrow(dc)) { _rt = mc_name(dc) }
    }

    // classe da origem de um cast de VAL_INT: a estatica (typeck) se for
    // inteira; senao a do tipo do valor
    vein cast_src_class(sstat: stone) -> stone {
        if (sstat >= 0 && (sstat <= MC_BOOL || sstat == MC_PTR || sstat == MC_STR || sstat == MC_VARIANT)) { return sstat }
        if (ofs_str_eq(_rt, "stone")) { return MC_I64 }
        return mem_class(_rt)
    }

    // `=` e `op=`; o resultado (valor atribuido) fica nos registradores
    vein eval_assign(id: stone, op: stone) -> void {
        eval_lvalue(nc0(id))
        forge alk = _lk
        forge alv = _lvar
        forge alh = _lh
        forge ali = _lidx
        forge alf: obsidian = _lfield
        eval_expr(nc1(id))
        forge ac: stone = ofs_array_get(_naux, id)
        if (op == OP_ASSIGN) {
            if (ac != 0) { coerce_regs(ac) }
            store_location(alk, alv, alh, ali, alf)
            return
        }
        forge rk = _rk
        forge rt: obsidian = _rt
        forge ri = _ri
        forge rfv: crystal = _rf
        forge rb = _rb
        forge rs: obsidian = _rs
        forge rr = _rr
        load_location(alk, alv, alh, ali, alf)
        forge ok2 = _rk
        forge ot2: obsidian = _rt
        forge oi2 = _ri
        forge of2: crystal = _rf
        forge ob2 = _rb
        forge os2: obsidian = _rs
        r_set(rk, rt, ri, rfv, rb, rs, rr)
        eval_bin_calc(calc_op_of_assign(op), ok2, ot2, oi2, of2, ob2, os2)
        if (ac != 0) { coerce_regs(ac) }
        store_location(alk, alv, alh, ali, alf)
    }

    vein eval_logic(id: stone, op: stone) -> void {
        eval_expr(nc0(id))
        if (op == OP_LAND) {
            if (!r_truthy()) { r_bool(false); return }
        } else {
            if (r_truthy()) { r_bool(true); return }
        }
        eval_expr(nc1(id))
        if (r_truthy()) { r_bool(true); return }
        r_bool(false)
    }

    vein eval_bin_op(id: stone) -> void {
        forge op = nop(id)
        forge lk = 0
        forge lt: obsidian = ""
        forge li = 0
        forge lfv: crystal = 0.0
        forge lb = false
        forge ls: obsidian = ""
        forge lr = 0
        if (op >= OP_ASSIGN && op <= OP_MOD_ASSIGN) { eval_assign(id, op); return }
        if (op == OP_LAND || op == OP_LOR) { eval_logic(id, op); return }

        eval_expr(nc0(id))
        lk = _rk
        lt = _rt
        li = _ri
        lfv = _rf
        lb = _rb
        ls = _rs
        lr = _rr
        eval_expr(nc1(id))

        if (op >= OP_LT && op <= OP_GE) {
            r_bool(eval_compare(op, lk, li, lfv))
            return
        }
        if (op == OP_EQ) {
            r_bool(val_equals_regs(lk, lt, li, lfv, lb, ls, lr))
            return
        }
        if (op == OP_NE) {
            r_bool(!val_equals_regs(lk, lt, li, lfv, lb, ls, lr))
            return
        }
        eval_bin_calc(op, lk, lt, li, lfv, lb, ls)
    }

    vein eval_call(id: stone) -> void {
        forge args: Array<stone> = nextra(id)
        forge num_args = ofs_array_len(args)
        forge arg_base = ofs_array_len(_arg_kinds)
        forge ck: stone = ofs_array_get(_nop, id)
        forge aux: stone = ofs_array_get(_naux, id)
        forge ai = 0
        forge arg_id = 0
        if (ck == CALL_BUILTIN && aux == BI_FAULT_ADDR) {
            // o argumento e um nome de vein, nao uma expressao
            ffi_fault_addr(id)
            return
        }
        while (ai < num_args) {
            arg_id = ofs_array_get(args, ai)
            eval_expr(arg_id)
            arg_push_regs()
            ai++
        }
        if (ck == CALL_FN) {
            call_function_by_id(aux, num_args, arg_base)
        } else {
            _cur_call_id = id
            call_classified(ck, aux, nval(id), num_args, arg_base)
        }
        // Pop arguments from stack (o resultado esta nos registradores)
        args_pop_to(arg_base)
    }

    // ── Function Execution ────────────────────────────────────────────────

    // primeira ocorrencia de "__" (ou, sem ela, de "."): devolve a posicao e
    // o tamanho do separador em _sep_len
    forge _sep_len: stone = 0

    vein find_method_sep(name: obsidian) -> stone {
        forge len = ofs_str_len(name)
        forge i = 0
        while (i + 1 < len) {
            if (ofs_str_char_at(name, i) == 95 && ofs_str_char_at(name, i + 1) == 95) {
                _sep_len = 2
                return i
            }
            i++
        }
        i = 0
        while (i < len) {
            if (ofs_str_char_at(name, i) == 46) {
                _sep_len = 1
                return i
            }
            i++
        }
        _sep_len = 0
        return -1
    }

    // Classifica uma chamada pelo nome (mesma ordem de antes: builtin,
    // construtor de variante, vein registrada, metodo dinamico).
    forge _cls_aux: stone = 0

    vein classify_call(name: obsidian) -> stone {
        forge bi = builtin_code(name)
        if (bi != BI_NONE) {
            _cls_aux = bi
            return CALL_BUILTIN
        }
        forge fid = find_function(name)
        if (fid >= 0) {
            _cls_aux = fid
            return CALL_FN
        }
        // extern/rift: o simbolo (bind) pode ser uma vein do proprio programa
        // (o llvmgen tambem nao declara o que o modulo define) ou um builtin
        forge ei = find_extern(name)
        if (ei >= 0) {
            forge esym = ext_sym(ei)
            if (!ofs_str_eq(esym, name)) {
                forge bfid = find_function(esym)
                if (bfid >= 0) {
                    _cls_aux = bfid
                    return CALL_FN
                }
                forge bbi = builtin_code(esym)
                if (bbi != BI_NONE) {
                    _cls_aux = bbi
                    return CALL_BUILTIN
                }
            }
            _cls_aux = ei
            return CALL_EXTERN
        }
        // Nome com inicial maiuscula e construtor de variante, exceto se for
        // uma vein registrada (metodo de impl ja reescrito: `Rect__area`).
        if (starts_upper(name)) {
            _cls_aux = 0
            return CALL_VARIANT
        }
        _cls_aux = new_dyn_call(name)
        return CALL_DYN
    }

    vein new_dyn_call(name: obsidian) -> stone {
        forge sep_pos = find_method_sep(name)
        forge sl = _sep_len
        ofs_array_push(_dyn_name, name)
        if (sep_pos >= 0) {
            forge var_part = ofs_str_substr(name, 0, sep_pos)
            forge method_part = ofs_str_substr(name, sep_pos + sl, ofs_str_len(name) - sep_pos - sl)
            ofs_array_push(_dyn_has_sep, true)
            ofs_array_push(_dyn_var_sym, sym_intern(var_part))
            ofs_array_push(_dyn_method, method_part)
        } else {
            ofs_array_push(_dyn_has_sep, false)
            ofs_array_push(_dyn_var_sym, -1)
            ofs_array_push(_dyn_method, "")
        }
        ofs_array_push(_dyn_cache_type, "")
        ofs_array_push(_dyn_cache_fn, -1)
        ofs_array_push(_dyn_cache_ok, false)
        ofs_array_push(_dyn_errmsg, "")
        return ofs_array_len(_dyn_name) - 1
    }

    // Resolve todas as chamadas da AST (depois de collect_declarations)
    vein resolve_calls() -> void {
        forge i = 0
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_CALL) {
                forge name: obsidian = ofs_array_get(_nval, i)
                forge ck = classify_call(name)
                ofs_array_set(_nop, i, ck)
                ofs_array_set(_naux, i, _cls_aux)
            }
            i++
        }
    }

    vein call_classified(ck: stone, aux: stone, name: obsidian, num_args: stone, arg_base: stone) -> void {
        if (ck == CALL_FN) {
            call_function_by_id(aux, num_args, arg_base)
            return
        }
        if (ck == CALL_BUILTIN) {
            call_builtin(aux, num_args, arg_base)
            return
        }
        if (ck == CALL_EXTERN) {
            call_extern(aux, num_args, arg_base)
            return
        }
        if (ck == CALL_VARIANT) {
            if (num_args > 0) {
                load_arg(arg_base)
            } else {
                r_null()
            }
            r_variant(name)
            return
        }
        call_dynamic(aux, num_args, arg_base)
    }

    vein call_function(name: obsidian, num_args: stone, arg_base: stone) -> void {
        forge ck = classify_call(name)
        call_classified(ck, _cls_aux, name, num_args, arg_base)
    }

    // Check method call (e.g. obj__method or obj.method)
    vein call_dynamic(di: stone, num_args: stone, arg_base: stone) -> void {
        forge name: obsidian = ofs_array_get(_dyn_name, di)
        forge has_sep: bool = ofs_array_get(_dyn_has_sep, di)
        if (has_sep) {
            forge vsym: stone = ofs_array_get(_dyn_var_sym, di)
            forge vidx = find_var(vsym)
            if (vidx >= 0) {
                forge vk: stone = ofs_array_get(_env_kind, vidx)
                if (vk == VAL_OBJECT) {
                    forge vtype: obsidian = ofs_array_get(_env_type, vidx)
                    forge m_fn_id = -1
                    forge cache_ok: bool = ofs_array_get(_dyn_cache_ok, di)
                    forge ctype: obsidian = ofs_array_get(_dyn_cache_type, di)
                    if (cache_ok && ofs_str_eq(ctype, vtype)) {
                        m_fn_id = ofs_array_get(_dyn_cache_fn, di)
                    } else {
                        forge method_part: obsidian = ofs_array_get(_dyn_method, di)
                        forge mangled_name = vtype + "__" + method_part
                        m_fn_id = find_function(mangled_name)
                        if (m_fn_id < 0) {
                            m_fn_id = find_function(method_part)
                        }
                        ofs_array_set(_dyn_cache_type, di, vtype)
                        ofs_array_set(_dyn_cache_fn, di, m_fn_id)
                        ofs_array_set(_dyn_cache_ok, di, true)
                    }
                    if (m_fn_id >= 0) {
                        // Push self as first argument onto _arg_* stack before method args
                        forge self_base = ofs_array_len(_arg_kinds)
                        env_load(vidx)
                        arg_push_regs()
                        forge ai = 0
                        while (ai < num_args) {
                            load_arg(arg_base + ai)
                            arg_push_regs()
                            ai++
                        }
                        call_function_by_id(m_fn_id, num_args + 1, self_base)
                        args_pop_to(self_base)
                        return
                    }
                }
            }
        }
        // mensagem montada uma vez por chamada (um laco que repete o erro
        // nao aloca a cada volta)
        forge msg: obsidian = ofs_array_get(_dyn_errmsg, di)
        if (ofs_str_len(msg) == 0) {
            msg = "Interpreter runtime error: undefined function '" + name + "'"
            ofs_array_set(_dyn_errmsg, di, msg)
        }
        echo(msg)
        // erro de runtime do interpretador: termina com 1, como o runtime nativo
        exit(1)
        r_null()
    }

    // resultado -> registradores
    vein call_function_by_id(fn_id: stone, num_args: stone, arg_base: stone) -> void {
        forge params_node_id = nc0(fn_id)
        forge body_id = nc2(fn_id)
        forge saved_frame_base = _current_frame_base
        forge saved_scope_depth = _scope_depth
        forge saved_fn_id = _cur_fn_id
        forge st = EXEC_OK
        _cur_fn_id = fn_id

        _current_frame_base = ofs_array_len(_env_sym)
        push_scope()
        if (params_node_id >= 0) {
            bind_params(params_node_id, num_args, arg_base)
        }
        if (body_id >= 0) {
            if (nk(body_id) == NK_BLOCK) {
                st = exec_stmt_list(body_id)
            } else {
                st = execute_stmt(body_id)
            }
        }

        run_anchors_from_depth(saved_scope_depth + 1)

        // Clean up all local variables allocated in this frame
        while (ofs_array_len(_env_sym) > _current_frame_base) {
            env_pop_one()
        }
        _scope_depth = saved_scope_depth
        _current_frame_base = saved_frame_base
        _cur_fn_id = saved_fn_id
        _try_unwind = false

        if (st == EXEC_RETURN) {
            regs_from_return()
            return
        }
        r_void()
    }

    vein bind_params(params_node_id: stone, num_args: stone, arg_base: stone) -> void {
        forge params: Array<stone> = nextra(params_node_id)
        forge num_params = ofs_array_len(params)
        forge pi = 0
        forge param_id = 0
        while (pi < num_params) {
            param_id = ofs_array_get(params, pi)
            if (pi < num_args) {
                load_arg(arg_base + pi)
            } else {
                r_void()
            }
            forge pc: stone = ofs_array_get(_nop, param_id)
            if (pc != 0) { coerce_regs(pc) }
            // monolith por referencia, como o ponteiro do nativo
            declare_var_noclone(node_sym(param_id))
            pi++
        }
    }

    // executa os statements de um bloco (sem abrir escopo); para no primeiro
    // status diferente de EXEC_OK
    vein exec_stmt_list(block_id: stone) -> stone {
        forge stmts: Array<stone> = nextra(block_id)
        forge b_len = ofs_array_len(stmts)
        forge bi = 0
        forge st = EXEC_OK
        forge s_id = 0
        while (bi < b_len) {
            s_id = ofs_array_get(stmts, bi)
            st = execute_stmt(s_id)
            if (st != EXEC_OK) {
                return st
            }
            if (_try_unwind) { return EXEC_RETURN }
            bi++
        }
        return EXEC_OK
    }

    // ── Statement Execution ───────────────────────────────────────────────

    vein execute_stmt(id: stone) -> stone {
        forge kind = nk(id)
        if (id < 0) { return EXEC_OK }
        if (kind == NK_RETURN) { return exec_return(id) }
        if (kind == NK_IF) { return exec_if(id) }
        if (kind == NK_BLOCK) { return exec_block(id) }
        if (kind == NK_VAR_DECL || kind == NK_CONST_DECL) { return exec_var_decl(id) }
        if (kind == NK_WHILE) { return exec_while(id) }
        if (kind == NK_CYCLE_C) { return exec_cycle_c(id) }
        if (kind == NK_CYCLE_RANGE) { return exec_cycle_range(id) }
        if (kind == NK_BREAK) { return EXEC_BREAK }
        if (kind == NK_CONTINUE) { return EXEC_CONTINUE }
        if (kind == NK_ASSIGN) { return exec_assign_stmt(id) }
        if (kind == NK_ANCHOR) { return exec_anchor(id) }
        if (kind == NK_MATCH) { return exec_match(id) }
        if (kind == NK_CASE) {
            if (nc1(id) >= 0) { return execute_stmt(nc1(id)) }
            return EXEC_OK
        }
        if (kind == NK_DEFAULT) {
            if (nc0(id) >= 0) { return execute_stmt(nc0(id)) }
            return EXEC_OK
        }
        if (kind == NK_THROW) { return exec_throw(id) }

        // Expression as statement
        eval_expr(id)
        return EXEC_OK
    }

    vein exec_return(id: stone) -> stone {
        forge rexpr = nc0(id)
        if (rexpr >= 0) {
            eval_expr(rexpr)
            // `return x?` com falha: o valor de retorno ja foi gravado
            if (_try_unwind) { return EXEC_RETURN }
        } else {
            r_void()
        }
        set_return_from_regs()
        return EXEC_RETURN
    }

    vein exec_if(id: stone) -> stone {
        eval_expr(nc0(id))
        if (_try_unwind) { return EXEC_RETURN }
        if (r_truthy()) {
            return execute_stmt(nc1(id))
        } else if (nc2(id) >= 0) {
            return execute_stmt(nc2(id))
        }
        return EXEC_OK
    }

    vein exec_block(id: stone) -> stone {
        forge st = EXEC_OK
        push_scope()
        st = exec_stmt_list(id)
        pop_scope()
        return st
    }

    vein exec_var_decl(id: stone) -> stone {
        forge init_id = nc1(id)
        if (init_id >= 0) {
            eval_expr(init_id)
            forge dc: stone = ofs_array_get(_nop, id)
            if (dc != 0) { coerce_regs(dc) }
            declare_var(node_sym(id))
        } else {
            default_value_for_type(ntype(id))
            declare_var_noclone(node_sym(id))
        }
        return EXEC_OK
    }

    vein exec_assign_stmt(id: stone) -> stone {
        eval_lvalue(nc0(id))
        forge alk = _lk
        forge alv = _lvar
        forge alh = _lh
        forge ali = _lidx
        forge alf: obsidian = _lfield
        eval_expr(nc1(id))
        forge ac: stone = ofs_array_get(_naux, id)
        if (ac != 0) { coerce_regs(ac) }
        store_location(alk, alv, alh, ali, alf)
        return EXEC_OK
    }

    vein exec_while(id: stone) -> stone {
        forge wc = nc0(id)
        forge wb = nc1(id)
        forge st = EXEC_OK
        while (true) {
            eval_expr(wc)
            if (_try_unwind) { return EXEC_RETURN }
            if (!r_truthy()) { break }
            st = execute_stmt(wb)
            if (st == EXEC_RETURN || st == EXEC_THROW) { return st }
            if (st == EXEC_BREAK) { break }
        }
        return EXEC_OK
    }

    vein exec_cycle_c(id: stone) -> stone {
        forge c_init = nc0(id)
        forge c_cond = nc1(id)
        forge c_step = nc2(id)
        forge c_body = nc3(id)
        forge st = EXEC_OK
        push_scope()
        if (c_init >= 0) { execute_stmt(c_init) }
        while (true) {
            if (c_cond >= 0) {
                eval_expr(c_cond)
                if (!r_truthy()) { break }
            }
            st = execute_stmt(c_body)
            if (st == EXEC_RETURN || st == EXEC_THROW) { pop_scope(); return st }
            if (st == EXEC_BREAK) { break }
            if (c_step >= 0) { execute_stmt(c_step) }
        }
        pop_scope()
        return EXEC_OK
    }

    vein exec_cycle_range(id: stone) -> stone {
        forge arr_h = 0
        forge alen = 0
        forge vsym = 0
        forge k = 0
        forge vi = 0
        forge st = EXEC_OK
        push_scope()
        eval_expr(nc0(id))
        if (_rk == VAL_ARRAY) {
            arr_h = _rr
            alen = interp_array_len(arr_h)
            vsym = node_sym(id)
            r_int(0)
            declare_var(vsym)
            while (k < alen) {
                interp_array_get(arr_h, k)
                vi = find_var(vsym)
                if (vi >= 0) { env_assign(vi) }
                st = execute_stmt(nc1(id))
                if (st == EXEC_RETURN || st == EXEC_THROW) { pop_scope(); return st }
                if (st == EXEC_BREAK) { break }
                k++
            }
        }
        pop_scope()
        return EXEC_OK
    }

    vein exec_anchor(id: stone) -> stone {
        forge action = nc0(id)
        if (action >= 0) {
            ofs_array_push(_anchor_nodes, action)
            ofs_array_push(_anchor_depths, _scope_depth)
        }
        return EXEC_OK
    }

    vein exec_match(id: stone) -> stone {
        eval_expr(nc0(id))
        forge sk = _rk
        forge stt: obsidian = _rt
        forge si = _ri
        forge sf: crystal = _rf
        forge sb = _rb
        forge ss: obsidian = _rs
        forge sr = _rr
        forge i = 0
        forge case_id = 0
        forge ck = 0
        while (i < nx_len(id)) {
            case_id = nx_at(id, i)
            ck = nk(case_id)
            if (ck == NK_DEFAULT) {
                return execute_stmt(nc0(case_id))
            }
            if (ck == NK_CASE) {
                eval_expr(nc0(case_id))
                if (val_equals_regs(sk, stt, si, sf, sb, ss, sr)) {
                    return execute_stmt(nc1(case_id))
                }
            }
            i++
        }
        return EXEC_OK
    }

    vein exec_throw(id: stone) -> stone {
        forge texpr = nc0(id)
        if (texpr >= 0) {
            eval_expr(texpr)
            set_return_from_regs()
            echo("Runtime throw: " + r_to_string())
        } else {
            r_void()
            set_return_from_regs()
            echo("Runtime throw")
        }
        exit(1)
        return EXEC_THROW
    }

    // ── Declarations Collection ───────────────────────────────────────────

    vein collect_declarations(root_id: stone) -> void {
        forge len = nx_len(root_id)
        forge i = 0
        while (i < len) {
            forge child_id = nx_at(root_id, i)
            forge ck = nk(child_id)
            forge cval: obsidian = nval(child_id)

            if (ck == NK_FN_DECL || ck == NK_CORE_DECL) {
                if (ck == NK_FN_DECL && ffi_runtime_native(child_id, cval)) {
                    register_extern(cval, child_id, cval)
                } else {
                    register_function(cval, child_id)
                }
            }

            if (ck == NK_EXTERN_VN || ck == NK_RIFT_VN) {
                register_extern(cval, child_id, "")
            }

            if (ck == NK_MONOLITH && register_monolith(cval)) {
                forge num_fields = nx_len(child_id)
                forge fi = 0
                while (fi < num_fields) {
                    forge f_id = nx_at(child_id, fi)
                    forge ft_str = "stone"
                    if (nc0(f_id) >= 0) {
                        ft_str = type_node_str(nc0(f_id))
                    }
                    register_monolith_field(cval, nval(f_id), ft_str)
                    fi++
                }
            }

            if (ck == NK_IMPL) {
                forge mono_name = cval
                forge num_methods = nx_len(child_id)
                forge mi = 0
                while (mi < num_methods) {
                    forge m_id = nx_at(child_id, mi)
                    forge mname: obsidian = nval(m_id)
                    register_function(mname, m_id)
                    register_function(mono_name + "__" + mname, m_id)
                    mi++
                }
            }

            if (ck == NK_NAMESPACE) {
                forge ns_name = cval
                forge num_ns_children = nx_len(child_id)
                forge nsi = 0
                while (nsi < num_ns_children) {
                    forge nc_id = nx_at(child_id, nsi)
                    forge nck = nk(nc_id)
                    if (nck == NK_FN_DECL || nck == NK_CORE_DECL) {
                        forge ncname: obsidian = nval(nc_id)
                        // o parser ja da o nome `ns__f` as veins do namespace
                        forge ncmangled = ns_name + "__" + ncname
                        forge nspre = ns_name + "__"
                        if (ofs_str_eq(ofs_str_substr(ncname, 0, ofs_str_len(nspre)), nspre)) { ncmangled = ncname }
                        if (nck == NK_FN_DECL && ffi_runtime_native(nc_id, ncmangled)) {
                            register_extern(ncname, nc_id, ncmangled)
                            register_extern(ncmangled, nc_id, ncmangled)
                        } else {
                            register_function(ncname, nc_id)
                            register_function(ncmangled, nc_id)
                        }
                    }
                    if (nck == NK_EXTERN_VN || nck == NK_RIFT_VN) {
                        forge nename: obsidian = nval(nc_id)
                        register_extern(nename, nc_id, "")
                        register_extern(ns_name + "__" + nename, nc_id, "")
                    }
                    nsi++
                }
            }

            i++
        }
    }

    // variantes e tipos strata em ordem de declaracao
    vein collect_strata() -> void {
        forge i = 0
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_VARIANT) {
                forge vn: obsidian = ofs_array_get(_nval, i)
                ofs_array_push(_variant_names, vn)
            } else if (k == NK_STRATA) {
                forge sn: obsidian = ofs_array_get(_nval, i)
                ofs_array_push(_strata_names, sn)
            }
            i++
        }
    }

    vein variant_name_at(v: stone) -> obsidian {
        if (v < 0 || v >= ofs_array_len(_variant_names)) { return "" }
        forge nm: obsidian = ofs_array_get(_variant_names, v)
        return nm
    }

    // tipo estatico concreto (o typeck deu um tipo)?
    vein static_known(t: obsidian) -> bool {
        if (ofs_str_len(t) == 0) { return false }
        return !(ofs_str_eq(t, "unknown") || ofs_str_eq(t, "null") || ofs_str_eq(t, "void"))
    }

    // Decisoes de tipo pre-calculadas por no (a partir dos tipos do typeck,
    // os mesmos que o llvmgen usa):
    //   `*p`        _naux = classe do tipo apontado + 1 (0 = usar o valor)
    //   NK_CAST     _naux = classe do destino; _nop = classe da origem + 1
    //   forge/param _nop  = classe estreita (iN/uN/f32) para coerce_regs
    //   `x = v`     _naux = idem, para o tipo de x
    vein annotate_nodes() -> void {
        forge i = 0
        while (i < _n_count) {
            forge k: stone = ofs_array_get(_nk, i)
            if (k == NK_UNARY_OP) {
                forge uop: stone = ofs_array_get(_nop, i)
                if (uop == OP_DEREF) {
                    forge ot = ntype(nc0(i))
                    if (ofs_str_len(ot) > 1 && ofs_str_char_at(ot, 0) == 42) {
                        ofs_array_set(_naux, i, mem_class(ntype(i)) + 1)
                    }
                }
            } else if (k == NK_CAST) {
                ofs_array_set(_naux, i, mem_class(nval(i)))
                forge st = ntype(nc0(i))
                forge sc = 0
                if (static_known(st)) { sc = mem_class(st) + 1 }
                ofs_array_set(_nop, i, sc)
            } else if (k == NK_VAR_DECL || k == NK_CONST_DECL) {
                ofs_array_set(_nop, i, coerce_code(ntype(i)))
            } else if (k == NK_PARAM) {
                forge pt = ""
                if (nc0(i) >= 0) { pt = type_node_str(nc0(i)) }
                ofs_array_set(_nop, i, coerce_code(pt))
            } else if (k == NK_ASSIGN || k == NK_BIN_OP) {
                forge aop: stone = ofs_array_get(_nop, i)
                if ((k == NK_ASSIGN || (aop >= OP_ASSIGN && aop <= OP_MOD_ASSIGN)) && nk(nc0(i)) == NK_IDENT) {
                    ofs_array_set(_naux, i, coerce_code(ntype(nc0(i))))
                }
            }
            i++
        }
    }

    // ── Driver Entry Point ────────────────────────────────────────────────

    vein run(root_id: stone) -> stone {
        _rk = VAL_VOID
        _rt = "void"
        _ri = 0
        _rf = 0.0
        _rb = false
        _rs = ""
        _rr = -1

        _nk = []
        _nval = []
        _ntype = []
        _nc0 = []
        _nc1 = []
        _nc2 = []
        _nc3 = []
        _nx = []
        _nop = []
        _naux = []
        _nf = []
        _nsym = []
        _n_count = 0

        _dyn_name = []
        _dyn_has_sep = []
        _dyn_var_sym = []
        _dyn_method = []
        _dyn_cache_type = []
        _dyn_cache_fn = []
        _dyn_cache_ok = []
        _dyn_errmsg = []

        _sym_names = []

        _env_sym = []
        _env_kind = []
        _env_type = []
        _env_i = []
        _env_f = []
        _env_b = []
        _env_s = []
        _env_ref = []
        _env_depth = []
        _scope_depth = 0
        _globals_count = 0
        _current_frame_base = 0
        _anchor_nodes = []
        _anchor_depths = []

        _arr_len = []
        _arr_mask = []
        _arr_ck = []
        _arr_ct = []
        _arr_ci = []
        _arr_cf = []
        _arr_cb = []
        _arr_cs = []
        _arr_cr = []

        _boxed_live = 0
        _ffi_sync_h = []
        _ffi_sync_c = []
        _cb_fn = []
        _cb_pcls = []
        _cb_ptypes = []
        _cb_rcls = []
        _cur_call_id = -1

        _func_names = []
        _func_node_ids = []

        _ext_names = []
        _ext_syms = []
        _ext_nodes = []
        _ext_addr = []
        _ext_vfix = []
        _ext_pcls = []
        _ext_rcls = []
        _ext_rtype = []

        _mono_names = []
        _mono_ffirst = []
        _mono_fcount = []
        _mono_size = []
        _mono_last_idx = -1
        _mono_field_owners = []
        _mono_field_names = []
        _mono_field_types = []
        _mono_field_offs = []
        _mono_field_cls = []
        _variant_names = []
        _strata_names = []

        _arg_kinds = []
        _arg_types = []
        _arg_i = []
        _arg_f = []
        _arg_b = []
        _arg_s = []
        _arg_refs = []

        _ret_kind = 0
        _ret_type = "void"
        _ret_i = 0
        _ret_f = 0.0
        _ret_b = false
        _ret_s = ""
        _ret_ref = -1

        build_node_tables()
        collect_declarations(root_id)
        collect_strata()
        compute_layouts()
        annotate_nodes()
        resolve_calls()
        ffi_check_symbols()

        // Initialize global variables at file scope
        forge i = 0
        while (i < nx_len(root_id)) {
            forge decl_id = nx_at(root_id, i)
            forge dk = nk(decl_id)
            if (dk == NK_VAR_DECL || dk == NK_CONST_DECL) {
                execute_stmt(decl_id)
            } else if (dk == NK_NAMESPACE) {
                // globais declarados dentro de namespace (nomes ja mangled
                // pelo parser como ns__nome) tambem precisam existir
                forge nsj = 0
                while (nsj < nx_len(decl_id)) {
                    forge ns_decl = nx_at(decl_id, nsj)
                    forge nsk = nk(ns_decl)
                    if (nsk == NK_VAR_DECL || nsk == NK_CONST_DECL) {
                        execute_stmt(ns_decl)
                    }
                    nsj++
                }
            }
            i++
        }
        _globals_count = ofs_array_len(_env_sym)
        _current_frame_base = _globals_count

        // Locate main entry point
        forge main_node_id = find_function("main")
        if (main_node_id < 0) {
            forge k = 0
            while (k < nx_len(root_id)) {
                forge top_id = nx_at(root_id, k)
                if (nk(top_id) == NK_CORE_DECL) {
                    main_node_id = top_id
                    break
                }
                k++
            }
        }

        if (main_node_id < 0) {
            echo("Interpreter error: entry point 'core main()' or 'vein main()' not found")
            return 1
        }

        call_function(nval(main_node_id), 0, 0)

        if (_rk == VAL_INT) {
            return _ri
        }
        return 0
    }
}

// Entrada dos trampolins de callback (__ofs_cb_K, gerados pelo llvmgen no
// modulo que declara __ofs_cb_table): reentra no interpretador.
vein __ofs_cb_enter(slot: stone, a0: stone, a1: stone, a2: stone, a3: stone, a4: stone, a5: stone) -> stone {
    return interpreter.cb_enter(slot, a0, a1, a2, a3, a4, a5)
}
