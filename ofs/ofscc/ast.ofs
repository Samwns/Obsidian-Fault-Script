// OFS Compiler — Abstract Syntax Tree
// Pool of AST nodes and helper functions

attach {F:nodes.ofs}

// ── AST Node Structure ──────────────────────────────────────────────────

monolith Node {
    kind:     stone      // NodeKind (NK_*)
    val:      obsidian   // literal value or name
    type_str: obsidian   // type string (after type checking)
    line:     stone      // source line
    col:      stone      // source column
    
    // Up to 4 child node IDs (or -1 if unused)
    c0: stone
    c1: stone
    c2: stone
    c3: stone
    
    // For nodes with many children (blocks, calls, etc)
    extra: Array<stone>
}

// ── Global Node Pool ───────────────────────────────────────────────────

forge _node_pool: Array<Node> = []

// ── Node Pool Operations ────────────────────────────────────────────────

vein node_new(kind: stone, val: obsidian, line: stone, col: stone) -> stone {
    forge n: Node
    n.kind = kind
    n.val = val
    n.type_str = ""
    n.line = line
    n.col = col
    n.c0 = -1
    n.c1 = -1
    n.c2 = -1
    n.c3 = -1
    n.extra = []
    ofs_array_push(_node_pool, n)
    return ofs_array_len(_node_pool) - 1
}

vein node_get(id: stone) -> Node {
    if (id < 0 || id >= ofs_array_len(_node_pool)) {
        forge dummy: Node
        dummy.kind = -1
        dummy.val = ""
        dummy.type_str = ""
        dummy.line = 0
        dummy.col = 0
        dummy.c0 = -1
        dummy.c1 = -1
        dummy.c2 = -1
        dummy.c3 = -1
        dummy.extra = []
        return dummy
    }
    return ofs_array_get(_node_pool, id)
}

vein node_set(id: stone, n: Node) -> void {
    if (id < 0 || id >= ofs_array_len(_node_pool)) {
        return
    }
    ofs_array_set(_node_pool, id, n)
}

vein node_set_child(parent_id: stone, slot: stone, child_id: stone) -> void {
    if (parent_id < 0) { return }
    
    forge n: Node = node_get(parent_id)
    
    if (slot == 0) { n.c0 = child_id }
    else if (slot == 1) { n.c1 = child_id }
    else if (slot == 2) { n.c2 = child_id }
    else if (slot == 3) { n.c3 = child_id }
    
    node_set(parent_id, n)
}

vein node_add_extra(parent_id: stone, child_id: stone) -> void {
    if (parent_id < 0) { return }
    
    forge n: Node = node_get(parent_id)
    ofs_array_push(n.extra, child_id)
    node_set(parent_id, n)
}

vein node_get_extra(parent_id: stone, index: stone) -> stone {
    forge n: Node = node_get(parent_id)
    if (index < 0 || index >= ofs_array_len(n.extra)) {
        return -1
    }
    return ofs_array_get(n.extra, index)
}

// Field accessors that avoid copying the whole Node struct.
// These read fields in-place by indexing the pool once and are
// the preferred way in hot loops (typeck/llvmgen traverse 20k+ nodes).

vein node_kind_of(id: stone) -> stone {
    if (id < 0 || id >= ofs_array_len(_node_pool)) { return -1 }
    forge n: Node = ofs_array_get(_node_pool, id)
    return n.kind
}

vein node_val_of(id: stone) -> obsidian {
    if (id < 0 || id >= ofs_array_len(_node_pool)) { return "" }
    forge n: Node = ofs_array_get(_node_pool, id)
    return n.val
}

vein node_type_of(id: stone) -> obsidian {
    if (id < 0 || id >= ofs_array_len(_node_pool)) { return "" }
    forge n: Node = ofs_array_get(_node_pool, id)
    return n.type_str
}

vein node_child(id: stone, slot: stone) -> stone {
    if (id < 0 || id >= ofs_array_len(_node_pool)) { return -1 }
    forge n: Node = ofs_array_get(_node_pool, id)
    if (slot == 0) { return n.c0 }
    if (slot == 1) { return n.c1 }
    if (slot == 2) { return n.c2 }
    if (slot == 3) { return n.c3 }
    return -1
}

vein node_extra_len(parent_id: stone) -> stone {
    if (parent_id < 0 || parent_id >= ofs_array_len(_node_pool)) { return 0 }
    forge n: Node = ofs_array_get(_node_pool, parent_id)
    return ofs_array_len(n.extra)
}

vein node_extra_at(parent_id: stone, index: stone) -> stone {
    if (parent_id < 0 || parent_id >= ofs_array_len(_node_pool)) { return -1 }
    forge n: Node = ofs_array_get(_node_pool, parent_id)
    if (index < 0 || index >= ofs_array_len(n.extra)) { return -1 }
    return ofs_array_get(n.extra, index)
}

vein node_set_type(id: stone, type_str: obsidian) -> void {
    if (id < 0 || id >= ofs_array_len(_node_pool)) { return }
    forge n: Node = ofs_array_get(_node_pool, id)
    n.type_str = type_str
    ofs_array_set(_node_pool, id, n)
}

vein node_pool_len() -> stone {
    return ofs_array_len(_node_pool)
}

vein node_line_of(id: stone) -> stone {
    if (id < 0 || id >= ofs_array_len(_node_pool)) { return 0 }
    forge n: Node = ofs_array_get(_node_pool, id)
    return n.line
}

// ── Tipo de funcao (F6): `vein(T1, T2) -> R` ───────────────────────────
// No texto canonico do tipo (o `val` do NK_TYPE_FN e o `type_str` de toda
// expressao desse tipo) nao ha espacos: "vein(stone,crystal)->stone". Os
// parametros podem ser outros tipos de funcao, entao a lista e separada
// por virgulas fora de parenteses. Sem `-> R` o retorno e "void".

vein vein_type_is(t: obsidian) -> bool {
    if (t == null) { return false }
    if (ofs_str_len(t) < 9) { return false }
    return ofs_str_eq(ofs_str_substr(t, 0, 5), "vein(")
}

// posicao do ')' que fecha o '(' de "vein(" (-1 se malformado)
vein vein_type_close(t: obsidian) -> stone {
    forge depth = 0
    forge i = 4
    forge len = ofs_str_len(t)
    while (i < len) {
        forge c = ofs_str_char_at(t, i)
        if (c == 40) { depth++ }
        if (c == 41) {
            depth--
            if (depth == 0) { return i }
        }
        i++
    }
    return -1
}

// "T1,T2" de "vein(T1,T2)->R"
vein vein_type_params(t: obsidian) -> obsidian {
    if (!vein_type_is(t)) { return "" }
    forge close = vein_type_close(t)
    if (close < 0) { return "" }
    return ofs_str_substr(t, 5, close - 5)
}

// "R" de "vein(T1,T2)->R"
vein vein_type_ret(t: obsidian) -> obsidian {
    if (!vein_type_is(t)) { return "unknown" }
    forge close = vein_type_close(t)
    if (close < 0) { return "unknown" }
    forge rest = ofs_str_len(t) - close - 3
    if (rest <= 0) { return "void" }
    return ofs_str_substr(t, close + 3, rest)
}

vein vein_type_make(params: obsidian, ret: obsidian) -> obsidian {
    forge r = ret
    if (r == null || ofs_str_eq(r, "") || ofs_str_eq(r, "unknown")) { r = "void" }
    return "vein(" + params + ")->" + r
}

// quantos tipos tem uma lista "a,b,c" (virgulas fora de parenteses)
vein type_list_len(list: obsidian) -> stone {
    forge len = ofs_str_len(list)
    if (len == 0) { return 0 }
    forge n = 1
    forge depth = 0
    forge i = 0
    while (i < len) {
        forge c = ofs_str_char_at(list, i)
        if (c == 40) { depth++ }
        if (c == 41) { depth-- }
        if (c == 44 && depth == 0) { n++ }
        i++
    }
    return n
}

// i-esimo tipo de uma lista "a,b,c" ("" se nao existir)
vein type_list_at(list: obsidian, idx: stone) -> obsidian {
    forge len = ofs_str_len(list)
    if (len == 0) { return "" }
    forge start = 0
    forge k = 0
    forge depth = 0
    forge i = 0
    while (i <= len) {
        forge c = 44
        if (i < len) { c = ofs_str_char_at(list, i) }
        if (c == 40) { depth++ }
        if (c == 41) { depth-- }
        if (c == 44 && depth == 0) {
            if (k == idx) { return ofs_str_substr(list, start, i - start) }
            k++
            start = i + 1
        }
        i++
    }
    return ""
}

// nome de vein para mostrar (echo de valor de vein): o simbolo mangled de
// namespace/impl `ns__f` sai como o usuario escreve, `ns.f`
vein vein_display_name(name: obsidian) -> obsidian {
    forge len = ofs_str_len(name)
    forge k = 1
    while (k + 2 < len) {
        if (ofs_str_char_at(name, k) == 95 && ofs_str_char_at(name, k + 1) == 95 && ofs_str_char_at(name, k - 1) != 95) {
            return ofs_str_substr(name, 0, k) + "." + ofs_str_substr(name, k + 2, len - k - 2)
        }
        k++
    }
    return name
}

// Funcoes C variadicas conhecidas: quantos parametros fixos tem (-1 = nao
// e variadica). Usada pelo llvmgen (declaracao com `...`), pelo
// interpretador (FFI) e pelo typeck (variadica nao vira valor de vein).
vein variadic_c_fixed(name: obsidian) -> stone {
    if (ofs_str_eq(name, "printf") || ofs_str_eq(name, "scanf")) { return 1 }
    if (ofs_str_eq(name, "fprintf") || ofs_str_eq(name, "sprintf") || ofs_str_eq(name, "dprintf")) { return 2 }
    if (ofs_str_eq(name, "sscanf") || ofs_str_eq(name, "fscanf") || ofs_str_eq(name, "open")) { return 2 }
    if (ofs_str_eq(name, "fcntl") || ofs_str_eq(name, "ioctl") || ofs_str_eq(name, "syslog")) { return 2 }
    if (ofs_str_eq(name, "snprintf") || ofs_str_eq(name, "openat")) { return 3 }
    return -1
}

// nome canonico de um no de tipo (o mesmo de typeck/llvmgen.type_node_name)
vein type_node_text(id: stone) -> obsidian {
    if (id < 0) { return "void" }
    forge t: Node = node_get(id)
    if (t.kind == NK_TYPE_ARRAY) {
        forge inner = "stone"
        if (t.c0 >= 0) {
            forge tn: Node = node_get(t.c0)
            inner = tn.val
        }
        return "Array<" + inner + ">"
    }
    return t.val
}

// ── Linhas do runtime no fonte expandido ───────────────────────────────
// O driver junta os `attach` num fonte so; ele marca aqui as faixas de
// linhas que vieram de stdlib/runtime/*.ofs. O interpretador (`ofs run`)
// usa a versao nativa dessas veins (a mesma linkada no ofscc), como faz com
// os builtins, em vez de interpretar o codigo de memoria crua do runtime.

forge _runtime_line_lo: Array<stone> = []
forge _runtime_line_hi: Array<stone> = []

vein ast_mark_runtime_lines(lo: stone, hi: stone) -> void {
    if (hi < lo) { return }
    ofs_array_push(_runtime_line_lo, lo)
    ofs_array_push(_runtime_line_hi, hi)
}

vein ast_line_is_runtime(line: stone) -> bool {
    forge i = 0
    while (i < ofs_array_len(_runtime_line_lo)) {
        forge lo: stone = ofs_array_get(_runtime_line_lo, i)
        forge hi: stone = ofs_array_get(_runtime_line_hi, i)
        if (line >= lo && line <= hi) { return true }
        i++
    }
    return false
}

// ── Mapa de linhas: fonte expandido -> arquivo:linha ──────────────────
// O driver junta os `attach` num fonte so; as mensagens do typeck usam este
// mapa para dizer o arquivo e a linha de verdade. Cada entrada e uma faixa
// continua: a linha expandida `exp` corresponde a `file:line`, e as
// seguintes avancam juntas ate a proxima entrada.

forge _srcmap_exp: Array<stone> = []
forge _srcmap_file: Array<obsidian> = []
forge _srcmap_line: Array<stone> = []

vein ast_srcmap_add(exp_line: stone, file: obsidian, file_line: stone) -> void {
    forge n = ofs_array_len(_srcmap_exp)
    if (n > 0) {
        forge le: stone = ofs_array_get(_srcmap_exp, n - 1)
        forge ll: stone = ofs_array_get(_srcmap_line, n - 1)
        forge lf: obsidian = ofs_array_get(_srcmap_file, n - 1)
        if (ofs_str_eq(lf, file) && exp_line - le == file_line - ll) { return }
    }
    ofs_array_push(_srcmap_exp, exp_line)
    ofs_array_push(_srcmap_file, file)
    ofs_array_push(_srcmap_line, file_line)
}

// "arquivo:linha:coluna" da linha expandida (ou "linha:coluna" sem mapa)
vein ast_src_loc(exp_line: stone, col: stone) -> obsidian {
    forge lo = 0
    forge hi = ofs_array_len(_srcmap_exp) - 1
    forge best = -1
    while (lo <= hi) {
        forge mid = (lo + hi) / 2
        forge e: stone = ofs_array_get(_srcmap_exp, mid)
        if (e <= exp_line) {
            best = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    if (best < 0) { return ofs_stone_to_obsidian(exp_line) + ":" + ofs_stone_to_obsidian(col) }
    forge be: stone = ofs_array_get(_srcmap_exp, best)
    forge bl: stone = ofs_array_get(_srcmap_line, best)
    forge bf: obsidian = ofs_array_get(_srcmap_file, best)
    return bf + ":" + ofs_stone_to_obsidian(bl + exp_line - be) + ":" + ofs_stone_to_obsidian(col)
}

// ── Debug/Display ──────────────────────────────────────────────────────

vein node_kind_name(kind: stone) -> obsidian {
    if (kind == NK_PROGRAM)    { return "PROGRAM" }
    if (kind == NK_FN_DECL)    { return "FN_DECL" }
    if (kind == NK_CORE_DECL)  { return "CORE_DECL" }
    if (kind == NK_VAR_DECL)   { return "VAR_DECL" }
    if (kind == NK_CONST_DECL) { return "CONST_DECL" }
    if (kind == NK_MONOLITH)   { return "MONOLITH" }
    if (kind == NK_FIELD_DECL) { return "FIELD_DECL" }
    if (kind == NK_IMPL)       { return "IMPL" }
    if (kind == NK_IF)         { return "IF" }
    if (kind == NK_WHILE)      { return "WHILE" }
    if (kind == NK_MATCH)      { return "MATCH" }
    if (kind == NK_RETURN)     { return "RETURN" }
    if (kind == NK_CALL)       { return "CALL" }
    if (kind == NK_BIN_OP)     { return "BIN_OP" }
    if (kind == NK_UNARY_OP)   { return "UNARY_OP" }
    if (kind == NK_ASSIGN)     { return "ASSIGN" }
    if (kind == NK_IDENT)      { return "IDENT" }
    if (kind == NK_LIT_INT)    { return "LIT_INT" }
    if (kind == NK_LIT_FLOAT)  { return "LIT_FLOAT" }
    if (kind == NK_LIT_STRING) { return "LIT_STRING" }
    if (kind == NK_LIT_BOOL)   { return "LIT_BOOL" }
    if (kind == NK_TYPE)       { return "TYPE" }
    if (kind == NK_TYPE_FN)    { return "TYPE_FN" }
    if (kind == NK_BLOCK)      { return "BLOCK" }
    if (kind == NK_NAMESPACE)  { return "NAMESPACE" }
    if (kind == NK_STRATA)     { return "STRATA" }
    if (kind == NK_ATTACH)     { return "ATTACH" }
    if (kind == NK_EXTERN_VN)  { return "EXTERN_VN" }
    if (kind == NK_RIFT_VN)    { return "RIFT_VN" }
    if (kind == NK_TREMOR)     { return "TREMOR" }
    if (kind == NK_THROW)      { return "THROW" }
    if (kind == NK_BREAK)      { return "BREAK" }
    if (kind == NK_CONTINUE)   { return "CONTINUE" }
    if (kind == NK_FIELD)      { return "FIELD" }
    if (kind == NK_INDEX)      { return "INDEX" }
    return "?"
}

vein node_print_simple(id: stone) -> void {
    forge n: Node = node_get(id)
    forge line_str = ofs_stone_to_obsidian(n.line)
    forge col_str = ofs_stone_to_obsidian(n.col)
    echo("[" + line_str + ":" + col_str + "] " + node_kind_name(n.kind) + " (val=\"" + n.val + "\")")
}
