// OFS Compiler - LLVM IR backend

attach {F:fileio.ofs}
attach {F:ast.ofs}

// Layout do buffer dos trampolins FFI (ver emit_ffi_dispatch); o
// interpretador usa as mesmas constantes.
forge FFI_MAX_ARGS: stone = 12
forge FFI_SLOT_F: stone = 12
forge FFI_SLOT_RET: stone = 18
forge FFI_SLOT_ST: stone = 19
forge FFI_BUF_BYTES: stone = 160
// Trampolins de callback (F2): `fault_addr` de uma vein interpretada vira o
// endereco de um destes; cada um repassa ate FFI_CB_ARGS inteiros/ponteiros
// para __ofs_cb_enter (ver emit_cb_trampolines).
forge FFI_CB_SLOTS: stone = 16
forge FFI_CB_ARGS: stone = 6

namespace llvmgen {
    forge _tmp_counter: stone = 0
    forge _label_counter: stone = 0
    forge _str_counter: stone = 0
    forge _string_vals: Array<obsidian> = []
    forge _string_names: Array<obsidian> = []
    forge _var_names: Array<obsidian> = []
    forge _var_types: Array<obsidian> = []
    forge _var_ptrs: Array<obsidian> = []
    forge _var_depths: Array<stone> = []
    forge _global_names: Array<obsidian> = []
    forge _global_types: Array<obsidian> = []
    forge _global_inits: Array<stone> = []
    forge _break_labels: Array<obsidian> = []
    forge _continue_labels: Array<obsidian> = []
    // Token llvm.stacksave por loop: stackrestore garante que allocas de
    // variaveis criadas dentro do corpo nao acumulem stack entre iteracoes
    // (sem isso, loops grandes estouram a pilha em builds -O0/llc).
    forge _loop_saves: Array<obsidian> = []
    forge _loop_anchor_depths: Array<stone> = []
    forge _anchor_nodes: Array<stone> = []
    forge _anchor_depths: Array<stone> = []
    forge _visited_nodes: Array<stone> = []
    forge _mono_names: Array<obsidian> = []
    forge _variant_names: Array<obsidian> = []
    forge _variant_tags: Array<stone> = []
    // tipos `strata` (valor = etiqueta i64, como as variantes)
    forge _strata_names: Array<obsidian> = []
    forge _field_owners: Array<obsidian> = []
    forge _field_names: Array<obsidian> = []
    forge _field_types: Array<obsidian> = []
    forge _field_indices: Array<stone> = []
    forge _extern_names: Array<obsidian> = []
    forge _bind_names: Array<obsidian> = []
    forge _bind_targets: Array<obsidian> = []
    forge _scope_depth: stone = 0
    forge _expr_val: obsidian = ""
    forge _expr_type: obsidian = "void"
    forge _current_ret_type: obsidian = "void"
    forge _terminated: bool = false
    // Triple LLVM do alvo (OFSCC_TARGET). Vazio = sem linha `target triple`
    // (llc/clang usam o host, comportamento historico x86-64).
    forge _target_triple: obsidian = ""
    // Raiz do modulo usada por emit_extern_decls para nao declarar um
    // `extern vein` que o proprio modulo define (ex.: magma define ofs_alloc
    // e net.ofs o declara como extern -> "invalid redefinition" no LLVM).
    forge _decl_root: stone = -1

    // Normaliza o alvo pedido: apelidos curtos ou um triple completo.
    vein set_target(target: obsidian) -> void {
        if (target == null) {
            _target_triple = ""
            return
        }
        if (ofs_str_eq(target, "") || ofs_str_eq(target, "host")) {
            _target_triple = ""
            return
        }
        if (ofs_str_eq(target, "android") || ofs_str_eq(target, "android-arm64") || ofs_str_eq(target, "aarch64-android")) {
            _target_triple = "aarch64-unknown-linux-android26"
            return
        }
        _target_triple = target
    }

    vein next_tmp(prefix: obsidian) -> obsidian {
        forge name = "%" + prefix + ofs_stone_to_obsidian(_tmp_counter)
        _tmp_counter++
        return name
    }

    vein next_label(prefix: obsidian) -> obsidian {
        forge name = prefix + ofs_stone_to_obsidian(_label_counter)
        _label_counter++
        return name
    }

    vein is_named_type(type_str: obsidian) -> bool {
        if (ofs_str_char_at(type_str, 0) == 42) { return false }
        forge i = 0
        while (i < ofs_array_len(_mono_names)) {
            forge name: obsidian = ofs_array_get(_mono_names, i)
            if (ofs_str_eq(name, type_str)) { return true }
            i++
        }
        return false
    }

    vein is_strata_type(type_str: obsidian) -> bool {
        forge i = 0
        while (i < ofs_array_len(_strata_names)) {
            forge name: obsidian = ofs_array_get(_strata_names, i)
            if (ofs_str_eq(name, type_str)) { return true }
            i++
        }
        return false
    }

    vein llvm_type(type_str: obsidian) -> obsidian {
        if (ofs_str_char_at(type_str, 0) == 42) { return "ptr" }
        if (ofs_str_eq(type_str, "variant")) { return "i64" }
        if (is_named_type(type_str)) { return "ptr" }
        // antes caia no "ptr" final: `forge c: Cor = Verde` gerava IR invalido
        if (is_strata_type(type_str)) { return "i64" }
        if (ofs_str_eq(type_str, "stone")) { return "i64" }
        if (ofs_str_eq(type_str, "crystal")) { return "double" }
        if (ofs_str_eq(type_str, "obsidian")) { return "ptr" }
        if (ofs_str_eq(type_str, "bool") || ofs_str_eq(type_str, "bool1")) { return "i32" }
        if (ofs_str_eq(type_str, "void")) { return "void" }
        if (ofs_str_eq(type_str, "Array")) { return "ptr" }
        if (ofs_str_eq(type_str, "u8") || ofs_str_eq(type_str, "i8")) { return "i8" }
        if (ofs_str_eq(type_str, "u16") || ofs_str_eq(type_str, "i16")) { return "i16" }
        if (ofs_str_eq(type_str, "u32") || ofs_str_eq(type_str, "i32")) { return "i32" }
        if (ofs_str_eq(type_str, "u64") || ofs_str_eq(type_str, "i64")) { return "i64" }
        if (ofs_str_eq(type_str, "f32")) { return "float" }
        if (ofs_str_eq(type_str, "f64")) { return "double" }
        if (ofs_str_eq(type_str, "ptr")) { return "ptr" }
        return "ptr"
    }

    vein storage_type(type_str: obsidian) -> obsidian {
        if (ofs_str_char_at(type_str, 0) == 42) { return "ptr" }
        if (is_named_type(type_str)) { return "%" + type_str }
        return llvm_type(type_str)
    }

    // Monoliths live behind pointers in generated code.  They used to receive a
    // fixed 4096-byte allocation, which made normal compiler temporaries consume
    // several GiB during a self-hosted build.  Keep the LLVM layout calculation
    // here so every allocation is only as large as its actual fields require.
    vein type_storage_size(type_str: obsidian) -> stone {
        if (ofs_str_char_at(type_str, 0) == 42) { return 8 }
        if (is_named_type(type_str)) { return 8 }
        if (ofs_str_eq(type_str, "u8") || ofs_str_eq(type_str, "i8")) { return 1 }
        if (ofs_str_eq(type_str, "u16") || ofs_str_eq(type_str, "i16")) { return 2 }
        if (ofs_str_eq(type_str, "u32") || ofs_str_eq(type_str, "i32") ||
            ofs_str_eq(type_str, "bool") || ofs_str_eq(type_str, "bool1") ||
            ofs_str_eq(type_str, "f32")) { return 4 }
        return 8
    }

    vein type_storage_align(type_str: obsidian) -> stone {
        forge size = type_storage_size(type_str)
        if (size > 8) { return 8 }
        return size
    }

    vein align_storage(offset: stone, align: stone) -> stone {
        forge remainder = offset % align
        if (remainder == 0) { return offset }
        return offset + align - remainder
    }

    // Layout C de um monolith: FONTE UNICA para o codigo nativo (tamanho do
    // ofs_alloc; o `%T = type {...}` do LLVM da os mesmos offsets) e para o
    // interpretador, que guarda monoliths em memoria crua com este layout
    // (passar `&s` ou `s` ao C funciona igual nos dois modos). Campos na
    // ordem declarada, cada um alinhado ao proprio tamanho (maximo 8); o
    // tamanho final e arredondado ao maior alinhamento. `offsets` recebe o
    // offset de cada campo; devolve o tamanho (struct vazia ocupa 1 byte).
    vein struct_layout(field_types: Array<obsidian>, offsets: Array<stone>) -> stone {
        forge offset = 0
        forge max_align = 1
        forge i = 0
        while (i < ofs_array_len(field_types)) {
            forge field_t: obsidian = ofs_array_get(field_types, i)
            forge field_align = type_storage_align(field_t)
            offset = align_storage(offset, field_align)
            ofs_array_push(offsets, offset)
            offset = offset + type_storage_size(field_t)
            if (field_align > max_align) { max_align = field_align }
            i++
        }
        offset = align_storage(offset, max_align)
        // LLVM represents an empty struct with a non-zero addressable object.
        if (offset < 1) { return 1 }
        return offset
    }

    vein monolith_alloc_size(owner: obsidian) -> stone {
        forge types: Array<obsidian> = []
        forge offsets: Array<stone> = []
        forge i = 0
        while (i < ofs_array_len(_field_names)) {
            forge field_owner: obsidian = ofs_array_get(_field_owners, i)
            if (ofs_str_eq(field_owner, owner)) {
                forge field_t: obsidian = ofs_array_get(_field_types, i)
                ofs_array_push(types, field_t)
            }
            i++
        }
        return struct_layout(types, offsets)
    }

    // Campos monolith de um objeto novo (sem inicializador) recebem um
    // sub-objeto zerado, ate 8 niveis: a mesma regra do interpretador
    // (interpreter.obj_new). O campo ocupa 8 bytes (ponteiro).
    vein emit_init_nested(obj: obsidian, t: obsidian, depth: stone) -> void {
        if (depth >= 8) { return }
        forge i = 0
        while (i < ofs_array_len(_field_names)) {
            forge owner: obsidian = ofs_array_get(_field_owners, i)
            if (ofs_str_eq(owner, t)) {
                forge ft: obsidian = ofs_array_get(_field_types, i)
                if (is_named_type(ft)) {
                    forge fname: obsidian = ofs_array_get(_field_names, i)
                    forge fptr = next_tmp("nest_ptr")
                    forge sub = next_tmp("nest_obj")
                    cg_emit("  " + sub + " = call ptr @ofs_alloc(i64 " + ofs_stone_to_obsidian(monolith_alloc_size(ft)) + ")")
                    emit_init_nested(sub, ft, depth + 1)
                    cg_emit("  " + fptr + " = getelementptr inbounds %" + t + ", ptr " + obj + ", i32 0, i32 " + ofs_stone_to_obsidian(field_index(t, fname)))
                    cg_emit("  store ptr " + sub + ", ptr " + fptr)
                }
            }
            i++
        }
    }

    // inteiro estreito com sinal: estende com sext (os outros com zext)
    vein is_signed_narrow(t: obsidian) -> bool {
        return ofs_str_eq(t, "i8") || ofs_str_eq(t, "i16") || ofs_str_eq(t, "i32")
    }

    vein is_unsigned_narrow(t: obsidian) -> bool {
        return ofs_str_eq(t, "u8") || ofs_str_eq(t, "u16") || ofs_str_eq(t, "u32") || ofs_str_eq(t, "bool")
    }

    vein int_bitwidth(t: obsidian) -> stone {
        if (ofs_str_eq(t, "u8") || ofs_str_eq(t, "i8")) { return 8 }
        if (ofs_str_eq(t, "u16") || ofs_str_eq(t, "i16")) { return 16 }
        if (ofs_str_eq(t, "u32") || ofs_str_eq(t, "i32") || ofs_str_eq(t, "bool")) { return 32 }
        if (ofs_str_eq(t, "u64") || ofs_str_eq(t, "i64") || ofs_str_eq(t, "stone")) { return 64 }
        return 0
    }

    vein field_index(owner: obsidian, name: obsidian) -> stone {
        forge i = 0
        while (i < ofs_array_len(_field_names)) {
            forge o: obsidian = ofs_array_get(_field_owners, i)
            forge n: obsidian = ofs_array_get(_field_names, i)
            if (ofs_str_eq(o, owner) && ofs_str_eq(n, name)) {
                return ofs_array_get(_field_indices, i)
            }
            i++
        }
        return 0
    }

    vein field_type(owner: obsidian, name: obsidian) -> obsidian {
        forge i = 0
        while (i < ofs_array_len(_field_names)) {
            forge o: obsidian = ofs_array_get(_field_owners, i)
            forge n: obsidian = ofs_array_get(_field_names, i)
            if (ofs_str_eq(o, owner) && ofs_str_eq(n, name)) {
                return ofs_array_get(_field_types, i)
            }
            i++
        }
        return "stone"
    }

    vein type_node_name(id: stone) -> obsidian {
        if (id < 0) { return "void" }
        forge n: Node = node_get(id)
        if (n.kind == NK_TYPE_ARRAY) {
            forge inner = "stone"
            if (n.c0 >= 0) {
                forge tn: Node = node_get(n.c0)
                inner = tn.val
            }
            return "Array<" + inner + ">"
        }
        return n.val
    }

    vein collect_types(id: stone) -> void {
        if (id < 0) { return }
        forge n: Node = node_get(id)
        if (n.kind == NK_STRATA) {
            ofs_array_push(_strata_names, n.val)
            // register variants as stone (i64 tag) globals with unique tags
            forge vi = 0
            while (vi < node_extra_len(id)) {
                forge var_id = node_get_extra(id, vi)
                forge vn: Node = node_get(var_id)
                if (vn.kind == NK_VARIANT) {
                    ofs_array_push(_global_names, vn.val)
                    ofs_array_push(_global_types, "stone")
                    ofs_array_push(_global_inits, -1)
                    ofs_array_push(_variant_names, vn.val)
                    ofs_array_push(_variant_tags, ofs_array_len(_variant_names) - 1)
                }
                vi++
            }
        }
        if (n.kind == NK_MONOLITH) {
            ofs_array_push(_mono_names, n.val)
            forge i = 0
            while (i < node_extra_len(id)) {
                forge field_id = node_get_extra(id, i)
                forge f: Node = node_get(field_id)
                ofs_array_push(_field_owners, n.val)
                ofs_array_push(_field_names, f.val)
                ofs_array_push(_field_types, type_node_name(f.c0))
                ofs_array_push(_field_indices, i)
                i++
            }
        }
        forge j = 0
        while (j < node_extra_len(id)) {
            collect_types(node_get_extra(id, j))
            j++
        }
    }

    vein collect_globals(root_id: stone) -> void {
        forge i = 0
        while (i < node_extra_len(root_id)) {
            forge id = node_get_extra(root_id, i)
            forge n: Node = node_get(id)
            if (n.kind == NK_VAR_DECL || n.kind == NK_CONST_DECL) {
                forge t = n.type_str
                if (n.c0 >= 0) { t = type_node_name(n.c0) }
                if (ofs_str_eq(t, "") || ofs_str_eq(t, "unknown")) { t = "stone" }
                ofs_array_push(_global_names, n.val)
                ofs_array_push(_global_types, t)
                ofs_array_push(_global_inits, n.c1)
            } else if (n.kind == NK_NAMESPACE || n.kind == NK_IMPL) {
                collect_globals(id)
            }
            i++
        }
    }

    vein seen_node(id: stone) -> bool {
        forge i = 0
        while (i < ofs_array_len(_visited_nodes)) {
            forge v = ofs_array_get(_visited_nodes, i)
            if (v == id) { return true }
            i++
        }
        return false
    }

    vein mark_node(id: stone) -> void {
        ofs_array_push(_visited_nodes, id)
    }

    vein const_init_value(id: stone, type_str: obsidian) -> obsidian {
        if (id < 0) {
            if (ofs_str_eq(type_str, "obsidian") || ofs_str_eq(type_str, "Array") || is_named_type(type_str)) { return "null" }
            if (ofs_str_eq(type_str, "crystal")) { return "0.0" }
            return "0"
        }
        forge n: Node = node_get(id)
        if (n.kind == NK_LIT_INT) {
            // Zero literal assigned to a pointer-typed global must be `null`,
            // not `0`, otherwise llc rejects the constant.
            if (ofs_str_eq(n.val, "0")) {
                if (ofs_str_eq(llvm_type(type_str), "ptr")) { return "null" }
            }
            return n.val
        }
        if (n.kind == NK_LIT_FLOAT) { return n.val }
        if (n.kind == NK_LIT_BOOL) {
            if (ofs_str_eq(n.val, "true")) { return "1" }
            return "0"
        }
        if (n.kind == NK_LIT_STRING) { return string_name_for(n.val) }
        // Literal numerico negativo (`forge x: stone = -1`): antes caia no
        // "return 0" final e o global nascia com 0 em vez do valor.
        if (n.kind == NK_UNARY_OP && ofs_str_eq(n.val, "-") && n.c0 >= 0) {
            forge inner: Node = node_get(n.c0)
            if (inner.kind == NK_LIT_INT || inner.kind == NK_LIT_FLOAT) {
                return "-" + inner.val
            }
        }
        if (ofs_str_eq(type_str, "obsidian") || ofs_str_eq(type_str, "Array") || is_named_type(type_str)) { return "null" }
        // Any other constant initialiser assigned to a pointer-typed global
        // (e.g. `forge x: Array<T> = []`) must be `null`, not integer `0`,
        // otherwise llc rejects the module with
        // "integer constant must have integer type".
        if (ofs_str_eq(llvm_type(type_str), "ptr")) { return "null" }
        return "0"
    }

    vein push_scope() -> void {
        _scope_depth++
    }

    vein emit_anchors_from_depth(min_depth: stone) -> void {
        // LIFO (defer semantics): most recently registered anchors run first
        forge i = ofs_array_len(_anchor_nodes)
        while (i > 0) {
            i--
            forge depth: stone = ofs_array_get(_anchor_depths, i)
            if (depth >= min_depth) {
                forge aid: stone = ofs_array_get(_anchor_nodes, i)
                if (aid <= -2) {
                    if (!_terminated) { emit_scope_free(-2 - aid) }
                } else {
                    emit_stmt(aid)
                }
            }
        }
    }

    vein discard_anchors_from_depth(min_depth: stone) -> void {
        forge len = ofs_array_len(_anchor_nodes)
        while (len > 0) {
            forge depth: stone = ofs_array_get(_anchor_depths, len - 1)
            if (depth < min_depth) { break }
            ofs_array_pop(_anchor_nodes)
            ofs_array_pop(_anchor_depths)
            len--
        }
    }

    vein pop_scope() -> void {
        if (!_terminated) {
            emit_anchors_from_depth(_scope_depth)
        }
        discard_anchors_from_depth(_scope_depth)
        forge len = ofs_array_len(_var_names)
        while (len > 0) {
            forge depth = ofs_array_get(_var_depths, len - 1)
            if (depth < _scope_depth) { break }
            ofs_array_pop(_var_names)
            ofs_array_pop(_var_types)
            ofs_array_pop(_var_ptrs)
            ofs_array_pop(_var_depths)
            len = ofs_array_len(_var_names)
        }
        if (_scope_depth > 0) { _scope_depth-- }
    }

    vein declare_var(name: obsidian, type_str: obsidian, ptr_name: obsidian) -> void {
        ofs_array_push(_var_names, name)
        ofs_array_push(_var_types, type_str)
        ofs_array_push(_var_ptrs, ptr_name)
        ofs_array_push(_var_depths, _scope_depth)
    }

    vein push_loop(break_label: obsidian, continue_label: obsidian) -> void {
        ofs_array_push(_break_labels, break_label)
        ofs_array_push(_continue_labels, continue_label)
        ofs_array_push(_loop_anchor_depths, _scope_depth)
        ofs_array_push(_loop_saves, "")
    }

    // Marca cada corpo de loop com um asm vazio que so toca memoria
    // inacessivel: nao gera instrucao e a analise de alias o ignora (LICM/GVN
    // seguem iguais), mas faz a LoopAccessAnalysis desistir do loop. Sem isso o
    // LLVM 14 com -opaque-pointers da segfault em RuntimePointerChecking::insert
    // (LoopLoadElimination no -O1, LoopVectorize no -O2) em qualquer loop sem
    // chamadas que precise de checagem de alias em tempo de execucao, p.ex.
    // `*(b.data + pos) = ...` relendo `b.data` a cada volta (strbuf.append_int).
    vein emit_loop_laa_guard() -> void {
        cg_emit("  call void asm sideeffect \"\", \"\"() inaccessiblememonly nounwind")
    }

    vein pop_loop() -> void {
        ofs_array_pop(_break_labels)
        ofs_array_pop(_continue_labels)
        ofs_array_pop(_loop_saves)
        ofs_array_pop(_loop_anchor_depths)
    }

    vein current_break_label() -> obsidian {
        return ofs_array_get(_break_labels, ofs_array_len(_break_labels) - 1)
    }

    vein current_continue_label() -> obsidian {
        return ofs_array_get(_continue_labels, ofs_array_len(_continue_labels) - 1)
    }

    vein current_loop_anchor_depth() -> stone {
        return ofs_array_get(_loop_anchor_depths, ofs_array_len(_loop_anchor_depths) - 1)
    }

    vein set_loop_save(tok: obsidian) -> void {
        ofs_array_set(_loop_saves, ofs_array_len(_loop_saves) - 1, tok)
    }

    vein current_loop_save() -> obsidian {
        return ofs_array_get(_loop_saves, ofs_array_len(_loop_saves) - 1)
    }

    vein var_index(name: obsidian) -> stone {
        forge i = ofs_array_len(_var_names) - 1
        while (i >= 0) {
            forge n: obsidian = ofs_array_get(_var_names, i)
            if (ofs_str_eq(n, name)) { return i }
            i--
        }
        return -1
    }

    // `Crack`/`Barren` sao as variantes de falha (mesma regra do interpretador)
    vein is_fail_variant(name: obsidian) -> bool {
        return ofs_str_eq(name, "Crack") || ofs_str_eq(name, "Barren")
    }

    // `?` falhou: roda os anchors e sai da vein devolvendo a etiqueta (i64)
    // da variante de falha, convertida para o tipo de retorno.
    vein emit_try_return(tag: obsidian) -> void {
        if (ofs_str_eq(_current_ret_type, "void")) {
            emit_anchors_from_depth(0)
            cg_emit("  ret void")
            return
        }
        if (ofs_str_eq(_current_ret_type, "main")) {
            forge tr32 = next_tmp("try_rc")
            cg_emit("  " + tr32 + " = trunc i64 " + tag + " to i32")
            emit_anchors_from_depth(0)
            cg_emit("  ret i32 " + tr32)
            return
        }
        forge tv = coerce_for_store(tag, "stone", _current_ret_type)
        emit_anchors_from_depth(0)
        cg_emit("  ret " + llvm_type(_current_ret_type) + " " + tv)
    }

    // `expr?`. Variantes no nativo sao etiquetas i64 sem payload, entao:
    //   Solid(v)? / Ore(v)?   (construtor direto) -> v
    //   Crack(e)? / Barren?   (construtor direto) -> retorna a etiqueta
    //   outra expressao       -> se a etiqueta for de falha, retorna-a;
    //                            senao o valor e a propria etiqueta
    vein emit_try(op_id: stone) -> void {
        forge op: Node = node_get(op_id)
        forge otag = -1
        if (op.kind == NK_CALL || op.kind == NK_IDENT) { otag = variant_tag(op.val) }
        if (otag >= 0) {
            forge has_payload = op.kind == NK_CALL && node_extra_len(op_id) > 0
            if (is_fail_variant(op.val)) {
                if (has_payload) { emit_expr(node_get_extra(op_id, 0)) }
                emit_try_return(ofs_stone_to_obsidian(otag))
                cg_emit(next_label("try_dead") + ":")
                _expr_val = "0"
                _expr_type = "stone"
                return
            }
            if (has_payload) {
                emit_expr(node_get_extra(op_id, 0))
                return
            }
            _expr_val = ofs_stone_to_obsidian(otag)
            _expr_type = "stone"
            return
        }
        emit_expr(op_id)
        forge tval = coerce_for_store(_expr_val, _expr_type, "stone")
        forge tcond = ""
        forge vi = 0
        while (vi < ofs_array_len(_variant_names)) {
            forge vn: obsidian = ofs_array_get(_variant_names, vi)
            if (is_fail_variant(vn)) {
                forge vt: stone = ofs_array_get(_variant_tags, vi)
                forge tc = next_tmp("try_is_fail")
                cg_emit("  " + tc + " = icmp eq i64 " + tval + ", " + ofs_stone_to_obsidian(vt))
                if (ofs_str_len(tcond) > 0) {
                    forge tor = next_tmp("try_or")
                    cg_emit("  " + tor + " = or i1 " + tcond + ", " + tc)
                    tc = tor
                }
                tcond = tc
            }
            vi++
        }
        if (ofs_str_len(tcond) > 0) {
            forge lfail = next_label("try_fail")
            forge lok = next_label("try_ok")
            cg_emit("  br i1 " + tcond + ", label %" + lfail + ", label %" + lok)
            cg_emit(lfail + ":")
            emit_try_return(tval)
            cg_emit(lok + ":")
        }
        _expr_val = tval
        _expr_type = "stone"
    }

    vein variant_tag(name: obsidian) -> stone {
        forge i = 0
        while (i < ofs_array_len(_variant_names)) {
            forge vn: obsidian = ofs_array_get(_variant_names, i)
            if (ofs_str_eq(vn, name)) {
                return ofs_array_get(_variant_tags, i)
            }
            i++
        }
        return -1
    }

    vein global_index(name: obsidian) -> stone {
        forge i = ofs_array_len(_global_names) - 1
        while (i >= 0) {
            forge n: obsidian = ofs_array_get(_global_names, i)
            if (ofs_str_eq(n, name)) { return i }
            i--
        }
        return -1
    }

    vein var_type(name: obsidian) -> obsidian {
        forge i = var_index(name)
        if (i < 0) {
            forge gi = global_index(name)
            if (gi >= 0) { return ofs_array_get(_global_types, gi) }
            return "unknown"
        }
        return ofs_array_get(_var_types, i)
    }

    vein var_ptr(name: obsidian) -> obsidian {
        forge i = var_index(name)
        if (i < 0) {
            forge gi = global_index(name)
            if (gi >= 0) { return "@" + name }
            return "%" + name
        }
        return ofs_array_get(_var_ptrs, i)
    }

    vein expr_as_i1() -> obsidian {
        if (ofs_str_eq(_expr_type, "bool1")) { return _expr_val }
        forge tmp = next_tmp("cond")
        if (ofs_str_eq(llvm_type(_expr_type), "ptr")) {
            cg_emit("  " + tmp + " = icmp ne ptr " + _expr_val + ", null")
        } else {
            cg_emit("  " + tmp + " = icmp ne " + llvm_type(_expr_type) + " " + _expr_val + ", 0")
        }
        return tmp
    }

    vein coerce_for_store(value: obsidian, from_type: obsidian, to_type: obsidian) -> obsidian {
        if (ofs_str_eq(from_type, "bool1") && ofs_str_eq(to_type, "bool")) {
            forge z = next_tmp("zext")
            cg_emit("  " + z + " = zext i1 " + value + " to i32")
            return z
        }
        if (ofs_str_eq(from_type, "stone") && ofs_str_eq(to_type, "obsidian")) {
            forge s = next_tmp("stone_str")
            cg_emit("  " + s + " = call ptr @ofs_stone_to_obsidian(i64 " + value + ")")
            return s
        }
        if (ofs_str_eq(from_type, "null") && (ofs_str_eq(to_type, "obsidian") || ofs_str_eq(to_type, "Array") || is_named_type(to_type) || ofs_str_char_at(to_type, 0) == 42 || ofs_str_eq(to_type, "ptr"))) {
            return "null"
        }
        forge from_llvm = llvm_type(from_type)
        forge to_llvm = llvm_type(to_type)
        if (!ofs_str_eq(from_llvm, to_llvm)) {
            if (ofs_str_eq(from_llvm, "ptr") && !ofs_str_eq(to_llvm, "ptr")) {
                forge cast_p2i = next_tmp("cast")
                cg_emit("  " + cast_p2i + " = ptrtoint ptr " + value + " to " + to_llvm)
                return cast_p2i
            }
            if (!ofs_str_eq(from_llvm, "ptr") && ofs_str_eq(to_llvm, "ptr")) {
                forge cast_i2p = next_tmp("cast")
                cg_emit("  " + cast_i2p + " = inttoptr " + from_llvm + " " + value + " to ptr")
                return cast_i2p
            }
            if (ofs_str_eq(from_llvm, "i64") && ofs_str_eq(to_llvm, "double")) {
                forge cast_i2f = next_tmp("cast")
                cg_emit("  " + cast_i2f + " = sitofp i64 " + value + " to double")
                return cast_i2f
            }
            if (ofs_str_eq(from_llvm, "double") && ofs_str_eq(to_llvm, "i64")) {
                forge cast_f2i = next_tmp("cast")
                cg_emit("  " + cast_f2i + " = fptosi double " + value + " to i64")
                return cast_f2i
            }
            forge src_b = int_bitwidth(from_type)
            forge dst_b = int_bitwidth(to_type)
            if (src_b > 0 && dst_b > 0) {
                forge cast_int = next_tmp("cast")
                if (src_b > dst_b) {
                    cg_emit("  " + cast_int + " = trunc " + from_llvm + " " + value + " to " + to_llvm)
                } else if (is_signed_narrow(from_type)) {
                    cg_emit("  " + cast_int + " = sext " + from_llvm + " " + value + " to " + to_llvm)
                } else {
                    cg_emit("  " + cast_int + " = zext " + from_llvm + " " + value + " to " + to_llvm)
                }
                return cast_int
            }
        }
        return value
    }

    vein is_call_name(id: stone, name: obsidian) -> bool {
        if (id < 0) { return false }
        forge n: Node = node_get(id)
        if (n.kind != NK_CALL) { return false }
        return ofs_str_eq(n.val, name)
    }

    vein is_array_get(id: stone) -> bool {
        if (id < 0) { return false }
        forge n: Node = node_get(id)
        if (n.kind == NK_INDEX) { return true }
        if (n.kind == NK_CALL && ofs_str_eq(n.val, "ofs_array_get")) { return true }
        return false
    }

    // Tipo do elemento de `ofs_array_get(a, i)` / `a[i]` quando `a` e uma
    // variavel com tipo `Array<T>` declarado e T e um tipo conhecido; "" se
    // nao der para saber (ai o `as T` continua servindo de dica de leitura).
    vein array_get_elem_type(id: stone) -> obsidian {
        forge n: Node = node_get(id)
        forge arr_id = node_get_extra(id, 0)
        if (n.kind == NK_INDEX) { arr_id = n.c0 }
        if (arr_id < 0) { return "" }
        forge arr_node: Node = node_get(arr_id)
        if (arr_node.kind != NK_IDENT) { return "" }
        forge at = var_type(arr_node.val)
        forge alen = ofs_str_len(at)
        if (alen < 8) { return "" }
        if (!ofs_str_eq(ofs_str_substr(at, 0, 6), "Array<")) { return "" }
        if (ofs_str_char_at(at, alen - 1) != 62) { return "" }
        forge et = ofs_str_substr(at, 6, alen - 7)
        if (is_named_type(et)) { return et }
        if (ofs_str_eq(et, "stone") || ofs_str_eq(et, "crystal") || ofs_str_eq(et, "bool") ||
            ofs_str_eq(et, "obsidian") || ofs_str_eq(et, "u8") || ofs_str_eq(et, "i8") ||
            ofs_str_eq(et, "u16") || ofs_str_eq(et, "i16") || ofs_str_eq(et, "u32") ||
            ofs_str_eq(et, "i32") || ofs_str_eq(et, "u64") || ofs_str_eq(et, "i64") ||
            ofs_str_eq(et, "f32") || ofs_str_eq(et, "f64")) {
            return et
        }
        return ""
    }

    // `Array<T>` -> T quando T e lido de forma diferente de stone (ponteiro,
    // double ou bool); "" caso contrario.
    vein elem_of_array_type(at: obsidian) -> obsidian {
        forge alen = ofs_str_len(at)
        if (alen < 8) { return "" }
        if (!ofs_str_eq(ofs_str_substr(at, 0, 6), "Array<")) { return "" }
        if (ofs_str_char_at(at, alen - 1) != 62) { return "" }
        forge et = ofs_str_substr(at, 6, alen - 7)
        if (ofs_str_eq(et, "obsidian") || ofs_str_eq(et, "crystal") || ofs_str_eq(et, "bool")) { return et }
        if (is_named_type(et)) { return et }
        return ""
    }

    // ── Arrays: caminho rapido inline ─────────────────────────────────────
    // Cabecalho do array no runtime (matrix.ofs): [data, len, cap, elem_size],
    // 4 x i64. O `ofs build` compila com `llc` (sem passes de IR) e o runtime
    // e -O0, entao cada `a[i]` como chamada custava ~10 chamadas. Aqui o
    // acesso valido com elem_size 8 vira load/store direto; o resto (null,
    // fora dos limites, outro elem_size, crescimento) cai no runtime, que
    // mantem a mesma semantica (exit(1) fora dos limites).
    vein arr_hdr_load(arr: obsidian, word: stone, ty: obsidian) -> obsidian {
        forge v = next_tmp("ah")
        if (word == 0) {
            cg_emit("  " + v + " = load " + ty + ", ptr " + arr)
            return v
        }
        forge hp = next_tmp("ahp")
        cg_emit("  " + hp + " = getelementptr i64, ptr " + arr + ", i64 " + ofs_stone_to_obsidian(word))
        cg_emit("  " + v + " = load " + ty + ", ptr " + hp)
        return v
    }

    // Emite o teste "arr != null && idx < len (sem sinal) && elem_size == 8"
    // e desvia para fast/slow. `bound_word` 1 = len (get/set), 2 = cap (push,
    // com idx = len).
    vein arr_emit_guard(arr: obsidian, idx: obsidian, bound_word: stone, fast: obsidian, slow: obsidian) -> void {
        forge chk = next_label("arr_chk")
        forge isnull = next_tmp("arr_isnull")
        cg_emit("  " + isnull + " = icmp eq ptr " + arr + ", null")
        cg_emit("  br i1 " + isnull + ", label %" + slow + ", label %" + chk)
        cg_emit("")
        cg_emit(chk + ":")
        forge bound = arr_hdr_load(arr, bound_word, "i64")
        forge esz = arr_hdr_load(arr, 3, "i64")
        forge inb = next_tmp("arr_inb")
        forge e8 = next_tmp("arr_e8")
        forge ok = next_tmp("arr_ok")
        cg_emit("  " + inb + " = icmp ult i64 " + idx + ", " + bound)
        cg_emit("  " + e8 + " = icmp eq i64 " + esz + ", 8")
        cg_emit("  " + ok + " = and i1 " + inb + ", " + e8)
        cg_emit("  br i1 " + ok + ", label %" + fast + ", label %" + slow)
        cg_emit("")
    }

    // Endereco do elemento idx (como ofs_array_get).
    vein emit_arr_elem_ptr(arr: obsidian, idx: obsidian) -> obsidian {
        forge fast = next_label("arr_fast")
        forge slow = next_label("arr_slow")
        forge done = next_label("arr_end")
        arr_emit_guard(arr, idx, 1, fast, slow)
        cg_emit(fast + ":")
        forge data = arr_hdr_load(arr, 0, "ptr")
        forge fp = next_tmp("arr_fp")
        cg_emit("  " + fp + " = getelementptr i64, ptr " + data + ", i64 " + idx)
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(slow + ":")
        forge sp = next_tmp("arr_sp")
        cg_emit("  " + sp + " = call ptr @ofs_array_get(ptr " + arr + ", i64 " + idx + ")")
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(done + ":")
        forge p = next_tmp("arr_ptr")
        cg_emit("  " + p + " = phi ptr [ " + fp + ", %" + fast + " ], [ " + sp + ", %" + slow + " ]")
        return p
    }

    // a[idx] = v (como ofs_array_set com um slot de `lt`).
    vein emit_arr_store(arr: obsidian, idx: obsidian, lt: obsidian, v: obsidian) -> void {
        forge fast = next_label("arr_fast")
        forge slow = next_label("arr_slow")
        forge done = next_label("arr_end")
        arr_emit_guard(arr, idx, 1, fast, slow)
        cg_emit(fast + ":")
        forge data = arr_hdr_load(arr, 0, "ptr")
        forge fp = next_tmp("arr_fp")
        cg_emit("  " + fp + " = getelementptr i64, ptr " + data + ", i64 " + idx)
        cg_emit("  store " + lt + " " + v + ", ptr " + fp)
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(slow + ":")
        forge slot = next_tmp("idx_set")
        cg_emit("  " + slot + " = alloca " + lt + ", align 8")
        cg_emit("  store " + lt + " " + v + ", ptr " + slot)
        cg_emit("  call void @ofs_array_set(ptr " + arr + ", i64 " + idx + ", ptr " + slot + ")")
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(done + ":")
    }

    // ofs_array_push(arr, v): com len < cap e elem_size 8 grava direto.
    vein emit_arr_push(arr: obsidian, lt: obsidian, v: obsidian) -> void {
        forge fast = next_label("arr_fast")
        forge slow = next_label("arr_slow")
        forge done = next_label("arr_end")
        forge isnull = next_tmp("arr_isnull")
        forge chk = next_label("arr_chk")
        cg_emit("  " + isnull + " = icmp eq ptr " + arr + ", null")
        cg_emit("  br i1 " + isnull + ", label %" + slow + ", label %" + chk)
        cg_emit("")
        cg_emit(chk + ":")
        forge len = arr_hdr_load(arr, 1, "i64")
        forge cap = arr_hdr_load(arr, 2, "i64")
        forge esz = arr_hdr_load(arr, 3, "i64")
        forge room = next_tmp("arr_room")
        forge e8 = next_tmp("arr_e8")
        forge ok = next_tmp("arr_ok")
        cg_emit("  " + room + " = icmp slt i64 " + len + ", " + cap)
        cg_emit("  " + e8 + " = icmp eq i64 " + esz + ", 8")
        cg_emit("  " + ok + " = and i1 " + room + ", " + e8)
        cg_emit("  br i1 " + ok + ", label %" + fast + ", label %" + slow)
        cg_emit("")
        cg_emit(fast + ":")
        forge data = arr_hdr_load(arr, 0, "ptr")
        forge fp = next_tmp("arr_fp")
        forge nlen = next_tmp("arr_nlen")
        forge lenp = next_tmp("arr_lenp")
        cg_emit("  " + fp + " = getelementptr i64, ptr " + data + ", i64 " + len)
        cg_emit("  store " + lt + " " + v + ", ptr " + fp)
        cg_emit("  " + nlen + " = add i64 " + len + ", 1")
        cg_emit("  " + lenp + " = getelementptr i64, ptr " + arr + ", i64 1")
        cg_emit("  store i64 " + nlen + ", ptr " + lenp)
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(slow + ":")
        forge slot = next_tmp("arr_push")
        cg_emit("  " + slot + " = alloca " + lt + ", align 8")
        cg_emit("  store " + lt + " " + v + ", ptr " + slot)
        cg_emit("  call void @ofs_array_push(ptr " + arr + ", ptr " + slot + ")")
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(done + ":")
    }

    // ofs_array_len(arr): null -> 0.
    vein emit_arr_len(arr: obsidian) -> obsidian {
        forge chk = next_label("arr_chk")
        forge done = next_label("arr_end")
        forge entry_lbl = next_label("arr_nul")
        forge isnull = next_tmp("arr_isnull")
        cg_emit("  " + isnull + " = icmp eq ptr " + arr + ", null")
        cg_emit("  br i1 " + isnull + ", label %" + entry_lbl + ", label %" + chk)
        cg_emit("")
        cg_emit(entry_lbl + ":")
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(chk + ":")
        forge len = arr_hdr_load(arr, 1, "i64")
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(done + ":")
        forge r = next_tmp("arr_len")
        cg_emit("  " + r + " = phi i64 [ 0, %" + entry_lbl + " ], [ " + len + ", %" + chk + " ]")
        return r
    }

    // `[...]` local: o mesmo bloco que ofs_array_new monta (cabecalho +
    // dados iniciais em arr + 32), sem passar pelo runtime -O0.
    vein emit_arr_new_inline(arr: obsidian, count: stone) -> void {
        forge cap = count
        if (cap <= 0) { cap = 4 }
        cg_emit("  " + arr + " = call ptr @ofs_alloc(i64 " + ofs_stone_to_obsidian(32 + cap * 8) + ")")
        forge d = next_tmp("arr_data")
        cg_emit("  " + d + " = getelementptr i8, ptr " + arr + ", i64 32")
        cg_emit("  store ptr " + d + ", ptr " + arr)
        forge cp = next_tmp("ahp")
        cg_emit("  " + cp + " = getelementptr i64, ptr " + arr + ", i64 2")
        cg_emit("  store i64 " + ofs_stone_to_obsidian(cap) + ", ptr " + cp)
        forge ep = next_tmp("ahp")
        cg_emit("  " + ep + " = getelementptr i64, ptr " + arr + ", i64 3")
        cg_emit("  store i64 8, ptr " + ep)
    }

    // ofs_array_free inline: libera os dados (se nao estao no bloco do
    // cabecalho) e o cabecalho.
    vein emit_arr_free_inline(v: obsidian) -> void {
        forge chk = next_label("afree_chk")
        forge ldata = next_label("afree_data")
        forge lhdr = next_label("afree_hdr")
        forge done = next_label("afree_end")
        forge isn = next_tmp("afree_null")
        cg_emit("  " + isn + " = icmp eq ptr " + v + ", null")
        cg_emit("  br i1 " + isn + ", label %" + done + ", label %" + chk)
        cg_emit("")
        cg_emit(chk + ":")
        forge d = arr_hdr_load(v, 0, "ptr")
        forge inl = next_tmp("afree_inl")
        forge same = next_tmp("afree_same")
        cg_emit("  " + inl + " = getelementptr i8, ptr " + v + ", i64 32")
        cg_emit("  " + same + " = icmp eq ptr " + d + ", " + inl)
        cg_emit("  br i1 " + same + ", label %" + lhdr + ", label %" + ldata)
        cg_emit("")
        cg_emit(ldata + ":")
        cg_emit("  call void @ofs_free(ptr " + d + ")")
        cg_emit("  br label %" + lhdr)
        cg_emit("")
        cg_emit(lhdr + ":")
        cg_emit("  call void @ofs_free(ptr " + v + ")")
        cg_emit("  br label %" + done)
        cg_emit("")
        cg_emit(done + ":")
    }

    // `a[i] = v` / `a[i] op= v` -> ofs_array_set. Antes o alvo NK_INDEX nao
    // tinha caso no codegen e a atribuicao sumia do binario nativo.
    vein emit_index_assign(target_id: stone, op: obsidian, value_id: stone) -> void {
        forge target: Node = node_get(target_id)
        emit_expr(target.c0)
        forge arr = _expr_val
        forge et = elem_of_array_type(_expr_type)
        if (ofs_str_eq(et, "")) { et = "stone" }
        emit_expr(target.c1)
        forge idx = _expr_val
        if (is_array_get(value_id)) {
            emit_array_get(value_id, et)
        } else {
            emit_expr(value_id)
        }
        forge v = coerce_for_store(_expr_val, _expr_type, et)
        forge lt = llvm_type(et)
        if (!ofs_str_eq(op, "=")) {
            forge oldv = next_tmp("idx_old")
            forge newv = next_tmp("idx_new")
            forge old_raw = emit_arr_elem_ptr(arr, idx)
            cg_emit("  " + oldv + " = load " + lt + ", ptr " + old_raw)
            if (ofs_str_eq(et, "obsidian") && ofs_str_eq(op, "+=")) {
                cg_emit("  " + newv + " = call ptr @ofs_str_concat(ptr " + oldv + ", ptr " + v + ")")
            } else if (ofs_str_eq(et, "crystal")) {
                forge fop = "fadd"
                if (ofs_str_eq(op, "-=")) { fop = "fsub" }
                if (ofs_str_eq(op, "*=")) { fop = "fmul" }
                if (ofs_str_eq(op, "/=")) { fop = "fdiv" }
                cg_emit("  " + newv + " = " + fop + " double " + oldv + ", " + v)
            } else {
                forge iop = "add"
                if (ofs_str_eq(op, "-=")) { iop = "sub" }
                if (ofs_str_eq(op, "*=")) { iop = "mul" }
                if (ofs_str_eq(op, "/=")) { iop = "sdiv" }
                if (ofs_str_eq(op, "%=")) { iop = "srem" }
                if (ofs_str_eq(op, "&=")) { iop = "and" }
                if (ofs_str_eq(op, "|=")) { iop = "or" }
                if (ofs_str_eq(op, "^=")) { iop = "xor" }
                if (ofs_str_eq(op, "<<=")) { iop = "shl" }
                if (ofs_str_eq(op, ">>=")) { iop = "ashr" }
                cg_emit("  " + newv + " = " + iop + " " + lt + " " + oldv + ", " + v)
            }
            v = newv
        }
        emit_arr_store(arr, idx, lt, v)
        _expr_val = v
        _expr_type = et
    }

    vein emit_array_get(id: stone, expected_type: obsidian) -> void {
        forge n: Node = node_get(id)
        forge arr_id = node_get_extra(id, 0)
        forge idx_id = node_get_extra(id, 1)
        if (n.kind == NK_INDEX) {
            arr_id = n.c0
            idx_id = n.c1
        }
        emit_expr(arr_id)
        forge arr = _expr_val
        // Tipo do elemento a partir do tipo da expressao do array (variavel,
        // parametro, campo `x.itens`...). Antes so olhava variaveis, e
        // `p[i]` com `p: Array<obsidian>` parametro ou campo virava stone.
        if (ofs_str_eq(expected_type, "stone")) {
            forge inferred = elem_of_array_type(_expr_type)
            if (!ofs_str_eq(inferred, "")) { expected_type = inferred }
        }
        emit_expr(idx_id)
        forge idx = _expr_val
        forge raw = emit_arr_elem_ptr(arr, idx)
        if (is_named_type(expected_type) || ofs_str_eq(expected_type, "obsidian") || ofs_str_eq(expected_type, "Array")) {
            forge loaded_ptr = next_tmp("arr_item")
            cg_emit("  " + loaded_ptr + " = load ptr, ptr " + raw)
            _expr_val = loaded_ptr
            _expr_type = expected_type
        } else {
            forge loaded = next_tmp("arr_item")
            cg_emit("  " + loaded + " = load " + llvm_type(expected_type) + ", ptr " + raw)
            _expr_val = loaded
            _expr_type = expected_type
        }
    }

    vein llvm_escape_byte(c: stone) -> obsidian {
        if (c == 10) { return "\\0A" }
        if (c == 9) { return "\\09" }
        if (c == 13) { return "\\0D" }
        if (c == 34) { return "\\22" }
        if (c == 92) { return "\\5C" }
        if (c == 0) { return "\\00" }
        return ofs_str_substr(ofs_stone_to_obsidian(c), 0, 0)
    }

    vein llvm_escape_string(s: obsidian) -> obsidian {
        forge out = ""
        forge i = 0
        forge len = ofs_str_len(s)
        while (i < len) {
            forge c = ofs_str_char_at(s, i)
            if (c == 10 || c == 9 || c == 13 || c == 34 || c == 92 || c == 0) {
                out = out + llvm_escape_byte(c)
            } else {
                out = out + ofs_str_substr(s, i, 1)
            }
            i++
        }
        return out + "\\00"
    }

    vein string_name_for(value: obsidian) -> obsidian {
        forge i = 0
        while (i < ofs_array_len(_string_vals)) {
            forge v: obsidian = ofs_array_get(_string_vals, i)
            if (ofs_str_eq(v, value)) {
                return ofs_array_get(_string_names, i)
            }
            i++
        }

        forge name = "@str." + ofs_stone_to_obsidian(_str_counter)
        _str_counter++
        ofs_array_push(_string_vals, value)
        ofs_array_push(_string_names, name)
        return name
    }

    vein collect_strings(id: stone) -> void {
        if (id < 0) { return }
        if (seen_node(id)) { return }
        mark_node(id)
        forge n: Node = node_get(id)
        if (n.kind == NK_LIT_STRING) {
            string_name_for(n.val)
        }
        collect_strings(n.c0)
        collect_strings(n.c1)
        collect_strings(n.c2)
        collect_strings(n.c3)
        forge i = 0
        while (i < node_extra_len(id)) {
            collect_strings(node_get_extra(id, i))
            i++
        }
    }

    vein collect_all_strings() -> void {
        forge i = 0
        while (i < node_pool_len()) {
            forge n: Node = node_get(i)
            if (n.kind == NK_LIT_STRING) {
                string_name_for(n.val)
            }
            i++
        }
    }

    vein is_known_extern(name: obsidian) -> bool {
        forge i = 0
        while (i < ofs_array_len(_extern_names)) {
            forge n: obsidian = ofs_array_get(_extern_names, i)
            if (ofs_str_eq(n, name)) { return true }
            i++
        }
        return false
    }

    // Funcoes C variadicas conhecidas: quantos parametros fixos tem. Uma
    // `extern`/`rift` com esse simbolo e declarada com `...` e chamada com o
    // tipo da funcao (`call i64 (ptr, i64, ptr, ...) @snprintf(...)`); sem
    // isso a ABI x86-64 nao define %al e um double variadico sai como lixo.
    forge _va_names: Array<obsidian> = []
    forge _va_sigs: Array<obsidian> = []

    vein variadic_fixed_count(name: obsidian) -> stone {
        if (ofs_str_eq(name, "printf") || ofs_str_eq(name, "scanf")) { return 1 }
        if (ofs_str_eq(name, "fprintf") || ofs_str_eq(name, "sprintf") || ofs_str_eq(name, "dprintf")) { return 2 }
        if (ofs_str_eq(name, "sscanf") || ofs_str_eq(name, "fscanf") || ofs_str_eq(name, "open")) { return 2 }
        if (ofs_str_eq(name, "fcntl") || ofs_str_eq(name, "ioctl") || ofs_str_eq(name, "syslog")) { return 2 }
        if (ofs_str_eq(name, "snprintf") || ofs_str_eq(name, "openat")) { return 3 }
        return -1
    }

    vein variadic_sig(name: obsidian) -> obsidian {
        forge i = 0
        while (i < ofs_array_len(_va_names)) {
            forge vn: obsidian = ofs_array_get(_va_names, i)
            if (ofs_str_eq(vn, name)) { return ofs_array_get(_va_sigs, i) }
            i++
        }
        return ""
    }

    // ── Trampolins FFI do interpretador (F1 de INTERPRETADOR_PARIDADE) ──
    // `ofs run` chama funcoes C por endereco (dlsym). Inteiros e ponteiros
    // poderiam ir todos como i64, mas `crystal` precisa ir em registrador FP
    // e o retorno double vem em xmm0/d0, e uma variadica precisa do tipo
    // `(fixos, ...)` (no x86-64 o LLVM poe em %al o numero de args FP).
    // Por isso o modulo que declara `extern vein __ofs_ffi_dispatch` (o
    // interpretador) recebe aqui a DEFINICAO dessa funcao: um `switch` sobre
    // a classe da assinatura com uma chamada de tipo LLVM exato por classe
    // (o LLVM cuida da ABI de cada alvo). Um compilador antigo so declara o
    // simbolo (sem uso direto: o interpretador o acha por dlsym).
    //
    // sig = nargs | fmask << 4 | retf << 10 | vfixed << 11
    //   nargs  : 0..12 argumentos
    //   fmask  : bit j = argumento j e double (so nos 6 primeiros)
    //   retf   : 1 = retorno double (gravado no buffer), 0 = i64/void
    //   vfixed : 0 = nao variadica; 1..3 = variadica com k fixos (inteiros)
    // buffer (i64 x 20): [0..11] args inteiros, [12..17] args double (pela
    // posicao do argumento), [18] retorno double, [19] status (1 = classe
    // sem trampolim).
    // Classes geradas (ffi_sig_supported): ate 4 args com qualquer mistura
    // i64/f64 e retorno i64|f64 (62); so inteiros ate 12 args (X11/Win32);
    // variadicas com 1..3 fixos inteiros + ate 4 extras i64|f64, retorno i64
    // (printf/snprintf/open...). 143 casos no total.

    vein ffi_sig(nargs: stone, fmask: stone, retf: stone, vfixed: stone) -> stone {
        return nargs | (fmask << 4) | (retf << 10) | (vfixed << 11)
    }

    vein ffi_sig_supported(nargs: stone, fmask: stone, retf: stone, vfixed: stone) -> bool {
        if (nargs < 0 || nargs > 12 || retf < 0 || retf > 1) { return false }
        if (fmask < 0 || fmask >= 64) { return false }
        if (nargs < 6 && (fmask >> nargs) != 0) { return false }
        if (vfixed == 0) {
            if (nargs <= 4) { return true }
            return fmask == 0
        }
        if (vfixed > 3 || retf != 0 || nargs < vfixed) { return false }
        if ((fmask & ((1 << vfixed) - 1)) != 0) { return false }
        if (nargs > 6 || nargs - vfixed > 4) { return false }
        return true
    }

    vein ffi_call_args(nargs: stone, fmask: stone) -> obsidian {
        forge s = ""
        forge j = 0
        while (j < nargs) {
            if (j > 0) { s = s + ", " }
            if (((fmask >> j) & 1) != 0) {
                s = s + "double %d" + ofs_stone_to_obsidian(j)
            } else {
                s = s + "i64 %a" + ofs_stone_to_obsidian(j)
            }
            j++
        }
        return s
    }

    vein emit_ffi_dispatch() -> void {
        cg_emit("define i64 @__ofs_ffi_dispatch(i64 %fn, i64 %sig, ptr %buf) {")
        cg_emit("entry:")
        cg_emit("  %f = inttoptr i64 %fn to ptr")
        forge j = 0
        while (j < FFI_MAX_ARGS) {
            forge js = ofs_stone_to_obsidian(j)
            cg_emit("  %ap" + js + " = getelementptr inbounds i64, ptr %buf, i64 " + js)
            cg_emit("  %a" + js + " = load i64, ptr %ap" + js)
            j++
        }
        j = 0
        while (j < 6) {
            forge ds = ofs_stone_to_obsidian(j)
            cg_emit("  %dp" + ds + " = getelementptr inbounds i64, ptr %buf, i64 " + ofs_stone_to_obsidian(FFI_SLOT_F + j))
            cg_emit("  %d" + ds + " = load double, ptr %dp" + ds)
            j++
        }
        cg_emit("  %rp = getelementptr inbounds i64, ptr %buf, i64 " + ofs_stone_to_obsidian(FFI_SLOT_RET))
        cg_emit("  %sp = getelementptr inbounds i64, ptr %buf, i64 " + ofs_stone_to_obsidian(FFI_SLOT_ST))
        cg_emit("  store i64 0, ptr %sp")
        cg_emit("  switch i64 %sig, label %bad [")
        forge cases: Array<stone> = []
        forge vf = 0
        while (vf <= 3) {
            forge na = 0
            while (na <= FFI_MAX_ARGS) {
                forge fm = 0
                while (fm < 64) {
                    forge rf = 0
                    while (rf <= 1) {
                        if (ffi_sig_supported(na, fm, rf, vf)) {
                            forge sg = ffi_sig(na, fm, rf, vf)
                            ofs_array_push(cases, sg)
                            cg_emit("    i64 " + ofs_stone_to_obsidian(sg) + ", label %s" + ofs_stone_to_obsidian(sg))
                        }
                        rf++
                    }
                    fm++
                }
                na++
            }
            vf++
        }
        cg_emit("  ]")
        forge ci = 0
        while (ci < ofs_array_len(cases)) {
            forge sig: stone = ofs_array_get(cases, ci)
            forge ss = ofs_stone_to_obsidian(sig)
            forge nargs = sig & 15
            forge fmask = (sig >> 4) & 63
            forge retf = (sig >> 10) & 1
            forge vfixed = (sig >> 11) & 3
            forge args = ffi_call_args(nargs, fmask)
            forge fty = ""
            if (vfixed > 0) {
                forge fixs = ""
                forge k = 0
                while (k < vfixed) {
                    fixs = fixs + "i64, "
                    k++
                }
                fty = " (" + fixs + "...)"
            }
            cg_emit("s" + ss + ":")
            if (retf == 1) {
                cg_emit("  %r" + ss + " = call double" + fty + " %f(" + args + ")")
                cg_emit("  store double %r" + ss + ", ptr %rp")
                cg_emit("  ret i64 0")
            } else {
                cg_emit("  %r" + ss + " = call i64" + fty + " %f(" + args + ")")
                cg_emit("  ret i64 %r" + ss)
            }
            ci++
        }
        cg_emit("bad:")
        cg_emit("  store i64 1, ptr %sp")
        cg_emit("  ret i64 0")
        cg_emit("}")
    }

    // ── Trampolins de callback do interpretador (F2) ──
    // `fault_addr(f)` de uma vein INTERPRETADA precisa de um endereco que o
    // C possa chamar (qsort, bsearch, atexit...). O modulo que declara
    // `extern vein __ofs_cb_table` (o interpretador) recebe aqui a definicao
    // de FFI_CB_SLOTS funcoes nativas `__ofs_cb_K(i64 x FFI_CB_ARGS) -> i64`;
    // cada uma chama `__ofs_cb_enter(K, a0..a5)` (definida pelo interpretador),
    // que reentra no interpretador e roda a vein ligada ao slot K. Argumentos
    // a mais que o C nao passou chegam como lixo e sao ignorados (a vein so
    // le os seus). `__ofs_cb_table(K)` devolve o endereco do slot K (0 fora
    // da tabela); o interpretador a acha por dlsym, como __ofs_ffi_dispatch.
    vein emit_cb_trampolines() -> void {
        forge params = ""
        forge args = ""
        forge j = 0
        while (j < FFI_CB_ARGS) {
            if (j > 0) { params = params + ", " }
            params = params + "i64 %a" + ofs_stone_to_obsidian(j)
            args = args + ", i64 %a" + ofs_stone_to_obsidian(j)
            j++
        }
        forge k = 0
        while (k < FFI_CB_SLOTS) {
            forge ks = ofs_stone_to_obsidian(k)
            cg_emit("define i64 @__ofs_cb_" + ks + "(" + params + ") {")
            cg_emit("entry:")
            cg_emit("  %r = call i64 @__ofs_cb_enter(i64 " + ks + args + ")")
            cg_emit("  ret i64 %r")
            cg_emit("}")
            k++
        }
        cg_emit("define i64 @__ofs_cb_table(i64 %slot) {")
        cg_emit("entry:")
        cg_emit("  switch i64 %slot, label %bad [")
        k = 0
        while (k < FFI_CB_SLOTS) {
            forge ks2 = ofs_stone_to_obsidian(k)
            cg_emit("    i64 " + ks2 + ", label %t" + ks2)
            k++
        }
        cg_emit("  ]")
        k = 0
        while (k < FFI_CB_SLOTS) {
            forge ks3 = ofs_stone_to_obsidian(k)
            cg_emit("t" + ks3 + ":")
            cg_emit("  %p" + ks3 + " = ptrtoint ptr @__ofs_cb_" + ks3 + " to i64")
            cg_emit("  ret i64 %p" + ks3)
            k++
        }
        cg_emit("bad:")
        cg_emit("  ret i64 0")
        cg_emit("}")
    }

    vein emit_extern_decls(id: stone) -> void {
        if (id < 0) { return }
        forge n: Node = node_get(id)
        if (n.kind == NK_EXTERN_VN || n.kind == NK_RIFT_VN) {
            forge sym_name = n.type_str
            if (ofs_str_eq(sym_name, "")) { sym_name = n.val }
            ofs_array_push(_bind_names, n.val)
            ofs_array_push(_bind_targets, sym_name)
            if (ofs_str_eq(sym_name, "__ofs_ffi_dispatch") && !is_known_extern(sym_name)) {
                ofs_array_push(_extern_names, sym_name)
                emit_ffi_dispatch()
            }
            if (ofs_str_eq(sym_name, "__ofs_cb_table") && !is_known_extern(sym_name)) {
                ofs_array_push(_extern_names, sym_name)
                emit_cb_trampolines()
            }
            forge defined_here = false
            if (_decl_root >= 0) { defined_here = is_defined_fn(_decl_root, sym_name) }
            if (!is_known_extern(sym_name) && !defined_here) {
                ofs_array_push(_extern_names, sym_name)
                forge ret_t = "void"
                if (n.c1 >= 0) {
                    ret_t = llvm_type(type_node_name(n.c1))
                }
                forge params_str = ""
                forge params_id = n.c0
                forge count = 0
                if (params_id >= 0) {
                    count = node_extra_len(params_id)
                }
                forge fixed = variadic_fixed_count(sym_name)
                if (fixed > count) { fixed = -1 }
                forge pcount = count
                if (fixed >= 0) { pcount = fixed }
                forge j = 0
                while (j < pcount) {
                    forge pid = node_get_extra(params_id, j)
                    forge p: Node = node_get(pid)
                    if (j > 0) { params_str = params_str + ", " }
                    params_str = params_str + llvm_type(type_node_name(p.c0))
                    j++
                }
                if (fixed >= 0) {
                    if (fixed > 0) { params_str = params_str + ", " }
                    params_str = params_str + "..."
                    ofs_array_push(_va_names, sym_name)
                    ofs_array_push(_va_sigs, ret_t + " (" + params_str + ")")
                }
                cg_emit("declare " + ret_t + " @" + sym_name + "(" + params_str + ")")
            }
        }
        forge k = 0
        while (k < node_extra_len(id)) {
            emit_extern_decls(node_get_extra(id, k))
            k++
        }
    }

    vein is_defined_fn(root_id: stone, name: obsidian) -> bool {
        forge i = 0
        while (i < node_extra_len(root_id)) {
            forge decl_id = node_get_extra(root_id, i)
            forge n: Node = node_get(decl_id)
            if (n.kind == NK_CORE_DECL || n.kind == NK_FN_DECL) {
                if (ofs_str_eq(n.val, name)) { return true }
            } else if (n.kind == NK_NAMESPACE || n.kind == NK_IMPL) {
                forge j = 0
                while (j < node_extra_len(decl_id)) {
                    forge mid = node_get_extra(decl_id, j)
                    forge m: Node = node_get(mid)
                    if (m.kind == NK_CORE_DECL || m.kind == NK_FN_DECL) {
                        if (ofs_str_eq(m.val, name)) { return true }
                    }
                    j++
                }
            }
            i++
        }
        return false
    }

    vein emit_decl_if_missing(root_id: stone, name: obsidian, decl_llvm: obsidian) -> void {
        if (!is_defined_fn(root_id, name)) {
            cg_emit(decl_llvm)
            ofs_array_push(_extern_names, name)
        }
    }

    vein emit_header(root_id: stone) -> void {
        cg_emit("; Generated by ofscc - native LLVM IR backend")
        cg_emit("source_filename = \"ofs_module\"")
        if (!ofs_str_eq(_target_triple, "")) {
            cg_emit("target triple = \"" + _target_triple + "\"")
        }
        cg_emit("")

        forge mi = 0
        while (mi < ofs_array_len(_mono_names)) {
            forge mono: obsidian = ofs_array_get(_mono_names, mi)
            cg_emit_raw("%" + mono + " = type { ")
            forge first = true
            forge fi = 0
            while (fi < ofs_array_len(_field_names)) {
                forge owner: obsidian = ofs_array_get(_field_owners, fi)
                if (ofs_str_eq(owner, mono)) {
                    if (!first) { cg_emit_raw(", ") }
                    forge ft: obsidian = ofs_array_get(_field_types, fi)
                    cg_emit_raw(llvm_type(ft))
                    first = false
                }
                fi++
            }
            cg_emit_raw(" }")
            cg_emit("")
            mi++
        }

        if (ofs_array_len(_mono_names) > 0) { cg_emit("") }

        forge i = 0
        while (i < ofs_array_len(_string_vals)) {
            forge value: obsidian = ofs_array_get(_string_vals, i)
            forge name: obsidian = ofs_array_get(_string_names, i)
            forge nbytes = ofs_str_len(value) + 1
            cg_emit(name + " = private unnamed_addr constant [" + ofs_stone_to_obsidian(nbytes) + " x i8] c\"" + llvm_escape_string(value) + "\", align 1")
            i++
        }

        forge gi = 0
        while (gi < ofs_array_len(_global_names)) {
            forge gname: obsidian = ofs_array_get(_global_names, gi)
            forge gt: obsidian = ofs_array_get(_global_types, gi)
            forge gid: stone = ofs_array_get(_global_inits, gi)
            forge vtag = variant_tag(gname)
            if (vtag >= 0) {
                cg_emit("@" + gname + " = global i64 " + ofs_stone_to_obsidian(vtag))
            } else {
                cg_emit("@" + gname + " = global " + llvm_type(gt) + " " + const_init_value(gid, gt))
            }
            gi++
        }

        cg_emit("")
        emit_decl_if_missing(root_id, "echo_stone", "declare void @echo_stone(i64)")
        emit_decl_if_missing(root_id, "echo_crystal", "declare void @echo_crystal(double)")
        emit_decl_if_missing(root_id, "echo_obsidian", "declare void @echo_obsidian(ptr)")
        emit_decl_if_missing(root_id, "echo_bool", "declare void @echo_bool(i32)")
        emit_decl_if_missing(root_id, "ofs_str_concat", "declare ptr @ofs_str_concat(ptr, ptr)")
        emit_decl_if_missing(root_id, "ofs_str_concat_ex", "declare ptr @ofs_str_concat_ex(ptr, ptr, i64)")
        emit_decl_if_missing(root_id, "ofs_str_release", "declare void @ofs_str_release(ptr, i64)")
        emit_decl_if_missing(root_id, "ofs_array_free", "declare void @ofs_array_free(ptr)")
        emit_decl_if_missing(root_id, "ofs_free", "declare void @ofs_free(ptr)")
        emit_decl_if_missing(root_id, "ofs_str_eq", "declare i32 @ofs_str_eq(ptr, ptr)")
        emit_decl_if_missing(root_id, "ofs_str_contains", "declare i32 @ofs_str_contains(ptr, ptr)")
        emit_decl_if_missing(root_id, "ofs_str_len", "declare i64 @ofs_str_len(ptr)")
        emit_decl_if_missing(root_id, "ofs_str_char_at", "declare i64 @ofs_str_char_at(ptr, i64)")
        emit_decl_if_missing(root_id, "ofs_str_char_at_known", "declare i64 @ofs_str_char_at_known(ptr, i64)")
        emit_decl_if_missing(root_id, "ofs_str_substr", "declare ptr @ofs_str_substr(ptr, i64, i64)")
        emit_decl_if_missing(root_id, "ofs_stone_to_obsidian", "declare ptr @ofs_stone_to_obsidian(i64)")
        emit_decl_if_missing(root_id, "ofs_crystal_to_obsidian", "declare ptr @ofs_crystal_to_obsidian(double)")
        emit_decl_if_missing(root_id, "ofs_alloc", "declare ptr @ofs_alloc(i64)")
        emit_decl_if_missing(root_id, "ofs_array_new", "declare ptr @ofs_array_new(i64, i64)")
        emit_decl_if_missing(root_id, "ofs_array_push", "declare void @ofs_array_push(ptr, ptr)")
        emit_decl_if_missing(root_id, "ofs_array_get", "declare ptr @ofs_array_get(ptr, i64)")
        emit_decl_if_missing(root_id, "ofs_array_len", "declare i64 @ofs_array_len(ptr)")
        emit_decl_if_missing(root_id, "ofs_array_set", "declare void @ofs_array_set(ptr, i64, ptr)")
        emit_decl_if_missing(root_id, "ofs_array_pop", "declare ptr @ofs_array_pop(ptr)")
        emit_decl_if_missing(root_id, "ofs_pow", "declare double @ofs_pow(double, double)")
        emit_decl_if_missing(root_id, "ofs_sqrt", "declare double @ofs_sqrt(double)")
        emit_decl_if_missing(root_id, "fopen", "declare ptr @fopen(ptr, ptr)")
        emit_decl_if_missing(root_id, "fclose", "declare i64 @fclose(ptr)")
        emit_decl_if_missing(root_id, "fread", "declare i64 @fread(ptr, i64, i64, ptr)")
        emit_decl_if_missing(root_id, "fwrite", "declare i64 @fwrite(ptr, i64, i64, ptr)")
        emit_decl_if_missing(root_id, "fputs", "declare i64 @fputs(ptr, ptr)")
        emit_decl_if_missing(root_id, "fseek", "declare i64 @fseek(ptr, i64, i64)")
        emit_decl_if_missing(root_id, "ftell", "declare i64 @ftell(ptr)")
        emit_decl_if_missing(root_id, "system", "declare i64 @system(ptr)")
        emit_decl_if_missing(root_id, "exit", "declare void @exit(i64)")
        emit_decl_if_missing(root_id, "getenv", "declare ptr @getenv(ptr)")
        cg_emit("declare void @llvm.prefetch.p0(ptr, i32, i32, i32)")
        cg_emit("declare ptr @llvm.stacksave()")
        cg_emit("declare void @llvm.stackrestore(ptr)")
        cg_emit("declare i64 @llvm.bswap.i64(i64)")
        cg_emit("declare void @llvm.trap()")
        cg_emit("declare i64 @llvm.ctpop.i64(i64)")
        cg_emit("declare i64 @llvm.ctlz.i64(i64, i1)")
        cg_emit("declare i64 @llvm.cttz.i64(i64, i1)")
        cg_emit("declare i64 @llvm.fshl.i64(i64, i64, i64)")
        cg_emit("declare i64 @llvm.fshr.i64(i64, i64, i64)")
        cg_emit("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
        cg_emit("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
        ofs_array_push(_extern_names, "llvm.prefetch.p0")
        ofs_array_push(_extern_names, "llvm.stacksave")
        ofs_array_push(_extern_names, "llvm.stackrestore")
        ofs_array_push(_extern_names, "llvm.bswap.i64")
        ofs_array_push(_extern_names, "llvm.trap")
        ofs_array_push(_extern_names, "llvm.ctpop.i64")
        ofs_array_push(_extern_names, "llvm.ctlz.i64")
        ofs_array_push(_extern_names, "llvm.cttz.i64")
        ofs_array_push(_extern_names, "llvm.fshl.i64")
        ofs_array_push(_extern_names, "llvm.fshr.i64")
        ofs_array_push(_extern_names, "llvm.memcpy.p0.p0.i64")
        ofs_array_push(_extern_names, "llvm.memset.p0.i64")
        _decl_root = root_id
        emit_extern_decls(root_id)
        cg_emit("")
        emit_text_helpers()
    }

    // Conversoes para texto que o typeck insere na arvore (F3): o nome de
    // uma variante pela etiqueta (tabela de nomes; etiqueta fora da tabela
    // sai como numero) e bool como "true"/"false", iguais ao interpretador.
    vein emit_text_helpers() -> void {
        forge nv = ofs_array_len(_variant_names)
        forge vi = 0
        while (vi < nv) {
            forge vname: obsidian = ofs_array_get(_variant_names, vi)
            cg_emit("@.ofs_vn" + ofs_stone_to_obsidian(vi) + " = private unnamed_addr constant [" +
                ofs_stone_to_obsidian(ofs_str_len(vname) + 1) + " x i8] c\"" + llvm_escape_string(vname) + "\", align 1")
            vi++
        }
        forge ns = ofs_stone_to_obsidian(nv)
        if (nv > 0) {
            cg_emit_raw("@.ofs_variant_names = private constant [" + ns + " x ptr] [")
            vi = 0
            while (vi < nv) {
                if (vi > 0) { cg_emit_raw(", ") }
                cg_emit_raw("ptr @.ofs_vn" + ofs_stone_to_obsidian(vi))
                vi++
            }
            cg_emit("]")
        }
        cg_emit("define internal ptr @__ofs_variant_name(i64 %v) {")
        cg_emit("entry:")
        if (nv > 0) {
            cg_emit("  %ok = icmp ult i64 %v, " + ns)
            cg_emit("  br i1 %ok, label %named, label %number")
            cg_emit("named:")
            cg_emit("  %slot = getelementptr inbounds [" + ns + " x ptr], ptr @.ofs_variant_names, i64 0, i64 %v")
            cg_emit("  %name = load ptr, ptr %slot")
            cg_emit("  ret ptr %name")
            cg_emit("number:")
        }
        cg_emit("  %num = call ptr @ofs_stone_to_obsidian(i64 %v)")
        cg_emit("  ret ptr %num")
        cg_emit("}")
        cg_emit("@.ofs_true = private unnamed_addr constant [5 x i8] c\"true\\00\", align 1")
        cg_emit("@.ofs_false = private unnamed_addr constant [6 x i8] c\"false\\00\", align 1")
        cg_emit("define internal ptr @__ofs_bool_text(i32 %b) {")
        cg_emit("entry:")
        cg_emit("  %t = icmp ne i32 %b, 0")
        cg_emit("  %s = select i1 %t, ptr @.ofs_true, ptr @.ofs_false")
        cg_emit("  ret ptr %s")
        cg_emit("}")
        cg_emit("")
        ofs_array_push(_extern_names, "__ofs_variant_name")
        ofs_array_push(_extern_names, "__ofs_bool_text")
    }

    // O runtime (modulo que define ofs_alloc, ex.: magma.ofs) tambem tem um
    // __ofs_init_globals; exportado, ele colidia com o de todo programa (o
    // link exigia --allow-multiple-definition e o do runtime nunca rodava).
    // No runtime sem main ele e `internal` e roda como construtor
    // (llvm.global_ctors). Programas continuam exportando o simbolo (o
    // `ofs build --target android` usa -Wl,-init,__ofs_init_globals).
    forge _init_internal: bool = false

    vein module_has_main(root_id: stone) -> bool {
        forge i = 0
        while (i < node_extra_len(root_id)) {
            forge did = node_get_extra(root_id, i)
            forge k = node_kind_of(did)
            if (k == NK_CORE_DECL) { return true }
            if (k == NK_FN_DECL && ofs_str_eq(node_val_of(did), "main")) { return true }
            i++
        }
        return false
    }

    vein emit_global_init() -> void {
        if (_init_internal) {
            cg_emit("@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @__ofs_init_globals, ptr null }]")
            cg_emit("")
            cg_emit("define internal void @__ofs_init_globals() {")
        } else {
            cg_emit("define void @__ofs_init_globals() {")
        }
        cg_emit("entry:")
        forge gi = 0
        while (gi < ofs_array_len(_global_names)) {
            forge gname: obsidian = ofs_array_get(_global_names, gi)
            forge gt: obsidian = ofs_array_get(_global_types, gi)
            forge gid: stone = ofs_array_get(_global_inits, gi)
            forge init: Node = node_get(gid)
            // Global arrays may carry generic annotations (Array<Node> etc.),
            // so match the "Array<" prefix, not just the bare "Array" name,
            // otherwise the backing buffer is never allocated and every push
            // on the global array becomes a no-op (parser/lexer state lost).
            forge is_arr = ofs_str_eq(gt, "Array")
            if (!is_arr && ofs_str_len(gt) > 6) {
                if (ofs_str_eq(ofs_str_substr(gt, 0, 6), "Array<")) { is_arr = true }
            }
            if (is_arr && gid >= 0 && init.kind == NK_ARRAY_LIT) {
                forge arr = next_tmp("garr")
                forge cnt = node_extra_len(gid)
                cg_emit("  " + arr + " = call ptr @ofs_array_new(i64 " + ofs_stone_to_obsidian(cnt) + ", i64 8)")
                forge ai = 0
                while (ai < cnt) {
                    forge elem_id = node_get_extra(gid, ai)
                    emit_expr(elem_id)
                    forge slot = next_tmp("garr_elem")
                    cg_emit("  " + slot + " = alloca " + llvm_type(_expr_type) + ", align 8")
                    cg_emit("  store " + llvm_type(_expr_type) + " " + _expr_val + ", ptr " + slot)
                    cg_emit("  call void @ofs_array_push(ptr " + arr + ", ptr " + slot + ")")
                    ai++
                }
                cg_emit("  store ptr " + arr + ", ptr @" + gname)
            } else if (is_named_type(gt)) {
                forge obj = next_tmp("gobj")
                cg_emit("  " + obj + " = call ptr @ofs_alloc(i64 " + ofs_stone_to_obsidian(monolith_alloc_size(gt)) + ")")
                emit_init_nested(obj, gt, 0)
                cg_emit("  store ptr " + obj + ", ptr @" + gname)
            }
            gi++
        }
        cg_emit("  ret void")
        cg_emit("}")
        cg_emit("")
    }

    // Acesso a global de namespace a partir de fora dele: `ns.nome` (NK_FIELD
    // sobre um identificador que nao e variavel) vira o global `ns__nome`.
    // Antes isso gerava um GEP sobre o tipo %unknown e o llc rejeitava o IR.
    vein lower_ns_global(id: stone) -> bool {
        if (id < 0) { return false }
        forge n: Node = node_get(id)
        if (n.kind != NK_FIELD || n.c0 < 0) { return false }
        forge b: Node = node_get(n.c0)
        if (b.kind != NK_IDENT) { return false }
        if (var_index(b.val) >= 0 || global_index(b.val) >= 0) { return false }
        forge gname = b.val + "__" + n.val
        if (global_index(gname) < 0) { return false }
        n.kind = NK_IDENT
        n.val = gname
        node_set(id, n)
        return true
    }

    // Inteiros pequenos (u8..u32, i8..i32) sao estendidos para i64 antes de
    // operacoes binarias: antes saia "shl i64 %x" com %x do tipo i32 e o llc
    // rejeitava o IR (ex.: (r as u32 << 16) | ...).
    forge _widened_type: obsidian = ""

    vein widen_int(v: obsidian, t: obsidian) -> obsidian {
        _widened_type = t
        forge lt = llvm_type(t)
        if (ofs_str_eq(t, "bool") || ofs_str_eq(t, "bool1")) { return v }
        if (!(ofs_str_eq(lt, "i8") || ofs_str_eq(lt, "i16") || ofs_str_eq(lt, "i32"))) { return v }
        forge ext = "sext"
        if (ofs_str_eq(t, "u8") || ofs_str_eq(t, "u16") || ofs_str_eq(t, "u32")) { ext = "zext" }
        forge w = next_tmp("widen")
        cg_emit("  " + w + " = " + ext + " " + lt + " " + v + " to i64")
        _widened_type = "stone"
        return w
    }

    // `old op= v` no tipo t (os dois ja no tipo t): devolve o novo valor
    vein emit_compound_value(op: obsidian, t: obsidian, old: obsidian, v: obsidian) -> obsidian {
        forge nv = next_tmp("compound")
        if (ofs_str_eq(t, "obsidian") && ofs_str_eq(op, "+=")) {
            cg_emit("  " + nv + " = call ptr @ofs_str_concat(ptr " + old + ", ptr " + v + ")")
            return nv
        }
        forge lt = llvm_type(t)
        forge cop = "add"
        if (ofs_str_eq(lt, "double") || ofs_str_eq(lt, "float")) {
            cop = "fadd"
            if (ofs_str_eq(op, "-=")) { cop = "fsub" }
            if (ofs_str_eq(op, "*=")) { cop = "fmul" }
            if (ofs_str_eq(op, "/=")) { cop = "fdiv" }
        } else {
            if (ofs_str_eq(op, "-=")) { cop = "sub" }
            if (ofs_str_eq(op, "*=")) { cop = "mul" }
            if (ofs_str_eq(op, "/=")) { cop = "sdiv" }
            if (ofs_str_eq(op, "%=")) { cop = "srem" }
            if (ofs_str_eq(op, "&=")) { cop = "and" }
            if (ofs_str_eq(op, "|=")) { cop = "or" }
            if (ofs_str_eq(op, "^=")) { cop = "xor" }
            if (ofs_str_eq(op, "<<=")) { cop = "shl" }
            if (ofs_str_eq(op, ">>=")) { cop = "ashr" }
        }
        cg_emit("  " + nv + " = " + cop + " " + lt + " " + old + ", " + v)
        return nv
    }

    // Resultado logico (i1, tipo "bool1") vira bool i32 antes de ir para
    // um slot de memoria (ofs_array_push/ofs_array_set).
    vein normalize_bool1() -> void {
        if (ofs_str_eq(_expr_type, "bool1")) {
            forge z = next_tmp("b32")
            cg_emit("  " + z + " = zext i1 " + _expr_val + " to i32")
            _expr_val = z
            _expr_type = "bool"
        }
    }

    vein emit_expr(id: stone) -> void {
        lower_ns_global(id)
        forge n: Node = node_get(id)

        if (n.kind == NK_LIT_INT) {
            _expr_val = n.val
            _expr_type = "stone"
            return
        }

        if (n.kind == NK_LIT_FLOAT) {
            _expr_val = n.val
            _expr_type = "crystal"
            return
        }

        if (n.kind == NK_LIT_STRING) {
            _expr_val = string_name_for(n.val)
            _expr_type = "obsidian"
            return
        }

        if (n.kind == NK_LIT_BOOL) {
            if (ofs_str_eq(n.val, "true")) {
                _expr_val = "1"
            } else {
                _expr_val = "0"
            }
            _expr_type = "bool"
            return
        }

        if (n.kind == NK_LIT_NULL) {
            _expr_val = "null"
            _expr_type = "null"
            return
        }

        if (n.kind == NK_ARRAY_LIT) {
            forge arr = next_tmp("arr")
            forge count = node_extra_len(id)
            emit_arr_new_inline(arr, count)
            forge ai = 0
            while (ai < count) {
                forge elem_id = node_get_extra(id, ai)
                emit_expr(elem_id)
                emit_arr_push(arr, llvm_type(_expr_type), _expr_val)
                ai++
            }
            _expr_val = arr
            _expr_type = "Array"
            return
        }

        if (n.kind == NK_IDENT) {
            forge t = var_type(n.val)
            forge p = var_ptr(n.val)
            if (is_named_type(t)) {
                if (var_index(n.val) < 0 && global_index(n.val) >= 0) {
                    forge gp = next_tmp("gobj_val")
                    cg_emit("  " + gp + " = load ptr, ptr " + p)
                    _expr_val = gp
                } else {
                    _expr_val = p
                }
                _expr_type = t
                return
            }
            forge tmp = next_tmp(n.val + "_val")
            cg_emit("  " + tmp + " = load " + llvm_type(t) + ", ptr " + p)
            _expr_val = tmp
            _expr_type = t
            return
        }

        if (n.kind == NK_INDEX) {
            // tipo do elemento decidido pelo typeck (Array<T> -> T); inteiros
            // estreitos seguem lidos como stone (slot de 8 bytes)
            forge ix_t = n.type_str
            if (ofs_str_eq(ix_t, "") || ofs_str_eq(ix_t, "unknown") || int_bitwidth(ix_t) > 0) { ix_t = "stone" }
            emit_array_get(id, ix_t)
            return
        }

        if (n.kind == NK_BIN_OP) {
            if (ofs_str_eq(n.val, "=") || ofs_str_eq(n.val, "+=") || ofs_str_eq(n.val, "-=") || ofs_str_eq(n.val, "*=") || ofs_str_eq(n.val, "/=") || ofs_str_eq(n.val, "%=") || ofs_str_eq(n.val, "&=") || ofs_str_eq(n.val, "|=") || ofs_str_eq(n.val, "^=") || ofs_str_eq(n.val, "<<=") || ofs_str_eq(n.val, ">>=")) {
                lower_ns_global(n.c0)
                forge assign_target: Node = node_get(n.c0)
                if (assign_target.kind == NK_INDEX) {
                    emit_index_assign(n.c0, n.val, n.c1)
                    return
                }
                if (assign_target.kind == NK_UNARY_OP && ofs_str_eq(assign_target.val, "*")) {
                    emit_expr(assign_target.c0)
                    forge dest_ptr = _expr_val
                    forge ptr_t = _expr_type
                    forge pointee = "stone"
                    if (ofs_str_char_at(ptr_t, 0) == 42) {
                        pointee = ofs_str_substr(ptr_t, 1, ofs_str_len(ptr_t) - 1)
                    }
                    if (is_array_get(n.c1)) {
                        emit_array_get(n.c1, pointee)
                    } else {
                        emit_expr(n.c1)
                    }
                    forge v = coerce_for_store(_expr_val, _expr_type, pointee)
                    cg_emit("  store " + llvm_type(pointee) + " " + v + ", ptr " + dest_ptr)
                    _expr_val = v
                    _expr_type = pointee
                    return
                }
                if (assign_target.kind == NK_IDENT) {
                    forge at = var_type(assign_target.val)
                    forge ap = var_ptr(assign_target.val)
                    if (ofs_str_eq(at, "obsidian")) {
                        forge aown = own_ptr_of(assign_target.val)
                        if (!ofs_str_eq(aown, "")) {
                            emit_owned_assign(assign_target.val, ap, aown, n.val, n.c1)
                            return
                        }
                    }
                    forge afree = false
                    if (ofs_str_eq(n.val, "=") && var_index(assign_target.val) >= 0) {
                        if (esc_list_has(_free_arr_ptrs, ap)) { afree = true }
                    }
                    if (is_array_get(n.c1)) {
                        emit_array_get(n.c1, at)
                    } else {
                        emit_expr(n.c1)
                    }
                    forge av = coerce_for_store(_expr_val, _expr_type, at)
                    if (afree) {
                        forge afold = next_tmp("arr_old")
                        cg_emit("  " + afold + " = load ptr, ptr " + ap)
                        emit_arr_free_inline(afold)
                    }
                    if (!ofs_str_eq(n.val, "=")) {
                        forge olda = next_tmp("assign_old")
                        forge newa = next_tmp("assign_new")
                        cg_emit("  " + olda + " = load " + llvm_type(at) + ", ptr " + ap)
                        if (ofs_str_eq(at, "obsidian") && ofs_str_eq(n.val, "+=")) {
                            cg_emit("  " + newa + " = call ptr @ofs_str_concat(ptr " + olda + ", ptr " + av + ")")
                        } else {
                            forge aop = "add"
                            if (ofs_str_eq(n.val, "-=")) { aop = "sub" }
                            if (ofs_str_eq(n.val, "*=")) { aop = "mul" }
                            if (ofs_str_eq(n.val, "/=")) { aop = "sdiv" }
                            if (ofs_str_eq(n.val, "%=")) { aop = "srem" }
                            if (ofs_str_eq(n.val, "&=")) { aop = "and" }
                            if (ofs_str_eq(n.val, "|=")) { aop = "or" }
                            if (ofs_str_eq(n.val, "^=")) { aop = "xor" }
                            if (ofs_str_eq(n.val, "<<=")) { aop = "shl" }
                            if (ofs_str_eq(n.val, ">>=")) { aop = "ashr" }
                            // crystal: fadd/fsub/fmul/fdiv (antes `add double`, IR invalido)
                            if (ofs_str_eq(llvm_type(at), "double")) {
                                aop = "fadd"
                                if (ofs_str_eq(n.val, "-=")) { aop = "fsub" }
                                if (ofs_str_eq(n.val, "*=")) { aop = "fmul" }
                                if (ofs_str_eq(n.val, "/=")) { aop = "fdiv" }
                            }
                            cg_emit("  " + newa + " = " + aop + " " + llvm_type(at) + " " + olda + ", " + av)
                        }
                        av = newa
                    }
                    if (is_named_type(at)) {
                        forge loaded_named = next_tmp("named_val")
                        cg_emit("  " + loaded_named + " = load %" + at + ", ptr " + av)
                        cg_emit("  store %" + at + " " + loaded_named + ", ptr " + ap)
                    } else {
                        cg_emit("  store " + llvm_type(at) + " " + av + ", ptr " + ap)
                    }
                    _expr_val = av
                    _expr_type = at
                    return
                }
                if (assign_target.kind == NK_FIELD) {
                    emit_expr(assign_target.c0)
                    forge bp = _expr_val
                    forge bt = _expr_type
                    forge ft_assign = field_type(bt, assign_target.val)
                    forge idx_assign = field_index(bt, assign_target.val)
                    forge fp_assign = next_tmp("field_ptr")
                    cg_emit("  " + fp_assign + " = getelementptr inbounds %" + bt + ", ptr " + bp + ", i32 0, i32 " + ofs_stone_to_obsidian(idx_assign))
                    if (is_array_get(n.c1)) {
                        emit_array_get(n.c1, ft_assign)
                    } else {
                        emit_expr(n.c1)
                    }
                    forge fv_assign = coerce_for_store(_expr_val, _expr_type, ft_assign)
                    if (!ofs_str_eq(n.val, "=") && !is_named_type(ft_assign)) {
                        // `p.x op= v` (antes o op era ignorado e virava `p.x = v`)
                        forge fold = next_tmp("field_old")
                        cg_emit("  " + fold + " = load " + llvm_type(ft_assign) + ", ptr " + fp_assign)
                        fv_assign = emit_compound_value(n.val, ft_assign, fold, fv_assign)
                    }
                    if (is_named_type(ft_assign)) {
                        // campo monolith guarda o ponteiro do sub-objeto (8
                        // bytes, struct_layout): `a.b = v` aponta para v,
                        // como no interpretador (antes copiava a struct
                        // inteira por cima do campo de 8 bytes)
                        cg_emit("  store ptr " + fv_assign + ", ptr " + fp_assign)
                    } else {
                        cg_emit("  store " + llvm_type(ft_assign) + " " + fv_assign + ", ptr " + fp_assign)
                    }
                    _expr_val = fv_assign
                    _expr_type = ft_assign
                    return
                }
            }

            // && e || com curto-circuito: o lado direito so e avaliado quando
            // necessario (antes os dois lados sempre rodavam no codigo nativo,
            // e `i >= 0 && arr[i]` lia fora do array).
            if (ofs_str_eq(n.val, "&&") || ofs_str_eq(n.val, "||")) {
                forge sc_slot = next_tmp("sc_slot")
                forge sc_rhs = next_label("sc_rhs")
                forge sc_end = next_label("sc_end")
                cg_emit("  " + sc_slot + " = alloca i1, align 1")
                emit_expr(n.c0)
                forge sc_l = _expr_val
                if (!ofs_str_eq(_expr_type, "bool1")) { sc_l = expr_as_i1() }
                cg_emit("  store i1 " + sc_l + ", ptr " + sc_slot)
                if (ofs_str_eq(n.val, "&&")) {
                    cg_emit("  br i1 " + sc_l + ", label %" + sc_rhs + ", label %" + sc_end)
                } else {
                    cg_emit("  br i1 " + sc_l + ", label %" + sc_end + ", label %" + sc_rhs)
                }
                cg_emit("")
                cg_emit(sc_rhs + ":")
                emit_expr(n.c1)
                forge sc_r = _expr_val
                if (!ofs_str_eq(_expr_type, "bool1")) { sc_r = expr_as_i1() }
                cg_emit("  store i1 " + sc_r + ", ptr " + sc_slot)
                cg_emit("  br label %" + sc_end)
                cg_emit("")
                cg_emit(sc_end + ":")
                forge sc_res = next_tmp("sc")
                cg_emit("  " + sc_res + " = load i1, ptr " + sc_slot)
                _expr_val = sc_res
                _expr_type = "bool1"
                return
            }

            emit_expr(n.c0)
            forge left_fresh = expr_is_fresh(n.c0)
            forge left_own = ""
            if (!ofs_str_eq(_selfapp_name, "") && node_kind_of(n.c0) == NK_IDENT) {
                if (ofs_str_eq(node_val_of(n.c0), _selfapp_name)) {
                    left_own = _selfapp_own
                    _selfapp_name = ""
                }
            }
            forge left = widen_int(_expr_val, _expr_type)
            forge left_type = _widened_type
            emit_expr(n.c1)
            forge right_fresh = expr_is_fresh(n.c1)
            forge right = widen_int(_expr_val, _expr_type)
            forge right_type = _widened_type

            if (ofs_str_eq(n.val, "+") && (ofs_str_eq(left_type, "obsidian") || ofs_str_eq(right_type, "obsidian"))) {
                if (!ofs_str_eq(left_type, "obsidian")) {
                    left = coerce_for_store(left, left_type, "obsidian")
                }
                if (!ofs_str_eq(right_type, "obsidian")) {
                    right = coerce_for_store(right, right_type, "obsidian")
                }
                forge tmp = next_tmp("concat")
                if (!ofs_str_eq(left_own, "")) {
                    // `s = s + ...`: o buffer de s e dele (ver emit_owned_assign)
                    forge lo = next_tmp("own_flag")
                    cg_emit("  " + lo + " = load i64, ptr " + left_own)
                    forge lf = lo
                    if (right_fresh) {
                        lf = next_tmp("cat_flags")
                        cg_emit("  " + lf + " = or i64 " + lo + ", 2")
                    }
                    cg_emit("  " + tmp + " = call ptr @ofs_str_concat_ex(ptr " + left + ", ptr " + right + ", i64 " + lf + ")")
                    _selfapp_done = true
                } else if (left_fresh || right_fresh) {
                    // temporarios da propria expressao (`a + b + c`): o da
                    // esquerda cresce no lugar, o da direita e liberado
                    forge cf = 0
                    if (left_fresh) { cf = cf + 1 }
                    if (right_fresh) { cf = cf + 2 }
                    cg_emit("  " + tmp + " = call ptr @ofs_str_concat_ex(ptr " + left + ", ptr " + right + ", i64 " + ofs_stone_to_obsidian(cf) + ")")
                } else {
                    cg_emit("  " + tmp + " = call ptr @ofs_str_concat(ptr " + left + ", ptr " + right + ")")
                }
                _fresh_val = tmp
                _expr_val = tmp
                _expr_type = "obsidian"
                return
            }

            if (ofs_str_eq(n.val, "+") || ofs_str_eq(n.val, "-") || ofs_str_eq(n.val, "*") || ofs_str_eq(n.val, "/") || ofs_str_eq(n.val, "%")) {
                if (ofs_str_eq(left_type, "crystal") || ofs_str_eq(right_type, "crystal")) {
                    forge fop = "fadd"
                    if (ofs_str_eq(n.val, "-")) { fop = "fsub" }
                    if (ofs_str_eq(n.val, "*")) { fop = "fmul" }
                    if (ofs_str_eq(n.val, "/")) { fop = "fdiv" }
                    forge ftmp = next_tmp("fop")
                    cg_emit("  " + ftmp + " = " + fop + " double " + left + ", " + right)
                    _expr_val = ftmp
                    _expr_type = "crystal"
                    return
                }
                forge op = "add"
                if (ofs_str_eq(n.val, "-")) { op = "sub" }
                if (ofs_str_eq(n.val, "*")) { op = "mul" }
                if (ofs_str_eq(n.val, "/")) { op = "sdiv" }
                if (ofs_str_eq(n.val, "%")) { op = "srem" }
                forge arith_tmp = next_tmp("op")
                cg_emit("  " + arith_tmp + " = " + op + " i64 " + left + ", " + right)
                _expr_val = arith_tmp
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "&") || ofs_str_eq(n.val, "|") || ofs_str_eq(n.val, "^") || ofs_str_eq(n.val, "<<") || ofs_str_eq(n.val, ">>")) {
                forge bop = "and"
                if (ofs_str_eq(n.val, "|")) { bop = "or" }
                if (ofs_str_eq(n.val, "^")) { bop = "xor" }
                if (ofs_str_eq(n.val, "<<")) { bop = "shl" }
                if (ofs_str_eq(n.val, ">>")) { bop = "ashr" }
                forge btmp = next_tmp("bit")
                cg_emit("  " + btmp + " = " + bop + " i64 " + left + ", " + right)
                _expr_val = btmp
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "==") || ofs_str_eq(n.val, "!=") || ofs_str_eq(n.val, "<") || ofs_str_eq(n.val, "<=") || ofs_str_eq(n.val, ">") || ofs_str_eq(n.val, ">=")) {
                forge pred = "eq"
                if (ofs_str_eq(n.val, "!=")) { pred = "ne" }
                if (ofs_str_eq(n.val, "<")) { pred = "slt" }
                if (ofs_str_eq(n.val, "<=")) { pred = "sle" }
                if (ofs_str_eq(n.val, ">")) { pred = "sgt" }
                if (ofs_str_eq(n.val, ">=")) { pred = "sge" }
                forge cmp_tmp = next_tmp("cmp")
                if (ofs_str_eq(left_type, "null") || ofs_str_eq(right_type, "null")) {
                    forge ptr_val = left
                    if (ofs_str_eq(left_type, "null")) { ptr_val = right }
                    if (ofs_str_eq(n.val, "!=")) {
                        cg_emit("  " + cmp_tmp + " = icmp ne ptr " + ptr_val + ", null")
                    } else {
                        cg_emit("  " + cmp_tmp + " = icmp eq ptr " + ptr_val + ", null")
                    }
                    _expr_val = cmp_tmp
                    _expr_type = "bool1"
                } else if (ofs_str_eq(left_type, "obsidian") || ofs_str_eq(right_type, "obsidian")) {
                    cg_emit("  " + cmp_tmp + " = call i32 @ofs_str_eq(ptr " + left + ", ptr " + right + ")")
                    forge bool_tmp = next_tmp("str_cmp")
                    if (ofs_str_eq(n.val, "!=")) {
                        cg_emit("  " + bool_tmp + " = icmp eq i32 " + cmp_tmp + ", 0")
                    } else {
                        cg_emit("  " + bool_tmp + " = icmp ne i32 " + cmp_tmp + ", 0")
                    }
                    _expr_val = bool_tmp
                    _expr_type = "bool1"
                } else {
                    if (ofs_str_eq(left_type, "crystal") || ofs_str_eq(right_type, "crystal")) {
                        forge fpred = "oeq"
                        if (ofs_str_eq(n.val, "!=")) { fpred = "one" }
                        if (ofs_str_eq(n.val, "<")) { fpred = "olt" }
                        if (ofs_str_eq(n.val, "<=")) { fpred = "ole" }
                        if (ofs_str_eq(n.val, ">")) { fpred = "ogt" }
                        if (ofs_str_eq(n.val, ">=")) { fpred = "oge" }
                        cg_emit("  " + cmp_tmp + " = fcmp " + fpred + " double " + left + ", " + right)
                    } else if (ofs_str_eq(left_type, "bool") || ofs_str_eq(right_type, "bool")) {
                        cg_emit("  " + cmp_tmp + " = icmp " + pred + " i32 " + left + ", " + right)
                    } else {
                        cg_emit("  " + cmp_tmp + " = icmp " + pred + " i64 " + left + ", " + right)
                    }
                    _expr_val = cmp_tmp
                    _expr_type = "bool1"
                }
                return
            }

            if (ofs_str_eq(n.val, "&&") || ofs_str_eq(n.val, "||")) {
                forge left_bool = left
                if (!ofs_str_eq(left_type, "bool1")) {
                    _expr_val = left
                    _expr_type = left_type
                    left_bool = expr_as_i1()
                }
                forge right_bool = right
                if (!ofs_str_eq(right_type, "bool1")) {
                    _expr_val = right
                    _expr_type = right_type
                    right_bool = expr_as_i1()
                }
                forge logic_tmp = next_tmp("logic")
                if (ofs_str_eq(n.val, "&&")) {
                    cg_emit("  " + logic_tmp + " = and i1 " + left_bool + ", " + right_bool)
                } else {
                    cg_emit("  " + logic_tmp + " = or i1 " + left_bool + ", " + right_bool)
                }
                _expr_val = logic_tmp
                _expr_type = "bool1"
                return
            }
        }

        if (n.kind == NK_UNARY_OP) {
            if (ofs_str_eq(n.val, "&")) {
                forge target: Node = node_get(n.c0)
                if (target.kind == NK_IDENT) {
                    forge p = var_ptr(target.val)
                    _expr_val = p
                    _expr_type = "*" + var_type(target.val)
                    return
                }
            }
            emit_expr(n.c0)
            if (ofs_str_eq(n.val, "!")) {
                forge b = expr_as_i1()
                forge tmp = next_tmp("not")
                cg_emit("  " + tmp + " = xor i1 " + b + ", true")
                _expr_val = tmp
                _expr_type = "bool1"
                return
            }
            if (ofs_str_eq(n.val, "-")) {
                forge tmp = next_tmp("neg")
                // `-x` com crystal: fneg (antes saia `sub i64 0, 7.0`, IR invalido)
                if (ofs_str_eq(_expr_type, "crystal") || ofs_str_eq(_expr_type, "f64")) {
                    cg_emit("  " + tmp + " = fneg double " + _expr_val)
                    _expr_val = tmp
                    _expr_type = "crystal"
                    return
                }
                cg_emit("  " + tmp + " = sub i64 0, " + _expr_val)
                _expr_val = tmp
                _expr_type = "stone"
                return
            }
            if (ofs_str_eq(n.val, "~")) {
                forge tmp_bnot = next_tmp("bit_not")
                cg_emit("  " + tmp_bnot + " = xor i64 " + _expr_val + ", -1")
                _expr_val = tmp_bnot
                _expr_type = "stone"
                return
            }
            if (ofs_str_eq(n.val, "*")) {
                forge pointee = "stone"
                if (ofs_str_char_at(_expr_type, 0) == 42) {
                    pointee = ofs_str_substr(_expr_type, 1, ofs_str_len(_expr_type) - 1)
                }
                forge deref = next_tmp("deref")
                cg_emit("  " + deref + " = load " + llvm_type(pointee) + ", ptr " + _expr_val)
                _expr_val = deref
                _expr_type = pointee
                return
            }
        }

        if (n.kind == NK_CAST) {
            forge dst_type = n.val
            if (is_array_get(n.c0)) {
                // Le o elemento no tipo real do array e depois converte
                // (`ofs_array_get(a_stone, i) as crystal` == sitofp, como
                // `(x: stone) as crystal`). Sem tipo conhecido, `as` e a dica.
                forge elem_t = array_get_elem_type(n.c0)
                if (ofs_str_len(elem_t) > 0) {
                    emit_array_get(n.c0, elem_t)
                } else {
                    emit_array_get(n.c0, dst_type)
                }
            } else {
                emit_expr(n.c0)
            }
            // comparacao/logico e i1 ("bool1"): vira bool i32 antes do `as`
            // (antes `(a == b) as stone` emitia `zext i32 %cmp` com %cmp i1,
            // IR invalido; COMPILER_ISSUES.md do Moon, item 2)
            normalize_bool1()
            forge src_val = _expr_val
            forge src_type = _expr_type
            if (ofs_str_eq(src_type, dst_type)) {
                return
            }
            forge src_llvm = llvm_type(src_type)
            forge dst_llvm = llvm_type(dst_type)
            if (ofs_str_eq(src_llvm, dst_llvm)) {
                _expr_type = dst_type
                return
            }
            forge cast_tmp = next_tmp("cast")
            if (ofs_str_eq(src_llvm, "ptr") && !ofs_str_eq(dst_llvm, "ptr")) {
                cg_emit("  " + cast_tmp + " = ptrtoint ptr " + src_val + " to " + dst_llvm)
            } else if (!ofs_str_eq(src_llvm, "ptr") && ofs_str_eq(dst_llvm, "ptr")) {
                cg_emit("  " + cast_tmp + " = inttoptr " + src_llvm + " " + src_val + " to ptr")
            } else if ((ofs_str_eq(src_llvm, "float") || ofs_str_eq(src_llvm, "double")) && (!ofs_str_eq(dst_llvm, "float") && !ofs_str_eq(dst_llvm, "double"))) {
                cg_emit("  " + cast_tmp + " = fptosi " + src_llvm + " " + src_val + " to " + dst_llvm)
            } else if ((!ofs_str_eq(src_llvm, "float") && !ofs_str_eq(src_llvm, "double")) && (ofs_str_eq(dst_llvm, "float") || ofs_str_eq(dst_llvm, "double"))) {
                // uN -> crystal sem sinal (antes sitofp: `(255 as u8) as crystal` dava -1.0)
                forge i2f = "sitofp"
                if (is_unsigned_narrow(src_type)) { i2f = "uitofp" }
                cg_emit("  " + cast_tmp + " = " + i2f + " " + src_llvm + " " + src_val + " to " + dst_llvm)
            } else if (ofs_str_eq(src_llvm, "float") && ofs_str_eq(dst_llvm, "double")) {
                cg_emit("  " + cast_tmp + " = fpext float " + src_val + " to double")
            } else if (ofs_str_eq(src_llvm, "double") && ofs_str_eq(dst_llvm, "float")) {
                cg_emit("  " + cast_tmp + " = fptrunc double " + src_val + " to float")
            } else {
                forge src_b = int_bitwidth(src_type)
                forge dst_b = int_bitwidth(dst_type)
                if (src_b > dst_b) {
                    cg_emit("  " + cast_tmp + " = trunc " + src_llvm + " " + src_val + " to " + dst_llvm)
                } else if (is_signed_narrow(src_type)) {
                    // iN estende com sinal (`(-3 as i8) as stone` == -3)
                    cg_emit("  " + cast_tmp + " = sext " + src_llvm + " " + src_val + " to " + dst_llvm)
                } else {
                    cg_emit("  " + cast_tmp + " = zext " + src_llvm + " " + src_val + " to " + dst_llvm)
                }
            }
            _expr_val = cast_tmp
            _expr_type = dst_type
            return
        }

        if (n.kind == NK_ASSIGN) {
            lower_ns_global(n.c0)
            forge target: Node = node_get(n.c0)
            if (target.kind == NK_INDEX) {
                emit_index_assign(n.c0, n.val, n.c1)
                return
            }
            if (target.kind == NK_UNARY_OP && ofs_str_eq(target.val, "*")) {
                emit_expr(target.c0)
                forge dest_ptr = _expr_val
                forge ptr_t = _expr_type
                forge pointee = "stone"
                if (ofs_str_char_at(ptr_t, 0) == 42) {
                    pointee = ofs_str_substr(ptr_t, 1, ofs_str_len(ptr_t) - 1)
                }
                if (is_array_get(n.c1)) {
                    emit_array_get(n.c1, pointee)
                } else {
                    emit_expr(n.c1)
                }
                forge v = coerce_for_store(_expr_val, _expr_type, pointee)
                cg_emit("  store " + llvm_type(pointee) + " " + v + ", ptr " + dest_ptr)
                _expr_val = v
                _expr_type = pointee
                return
            }
            if (target.kind == NK_IDENT) {
                forge t = var_type(target.val)
                forge p = var_ptr(target.val)
                if (ofs_str_eq(t, "obsidian")) {
                    forge nown = own_ptr_of(target.val)
                    if (!ofs_str_eq(nown, "")) {
                        emit_owned_assign(target.val, p, nown, n.val, n.c1)
                        return
                    }
                }
                if (is_array_get(n.c1)) {
                    emit_array_get(n.c1, t)
                } else {
                    emit_expr(n.c1)
                }
                forge v = coerce_for_store(_expr_val, _expr_type, t)
                if (!ofs_str_eq(n.val, "=")) {
                    forge oldv = next_tmp("assign_old")
                    forge newv = next_tmp("assign_new")
                    cg_emit("  " + oldv + " = load " + llvm_type(t) + ", ptr " + p)
                    if (ofs_str_eq(t, "obsidian") && ofs_str_eq(n.val, "+=")) {
                        cg_emit("  " + newv + " = call ptr @ofs_str_concat(ptr " + oldv + ", ptr " + v + ")")
                    } else {
                        forge op = "add"
                        if (ofs_str_eq(n.val, "-=")) { op = "sub" }
                        if (ofs_str_eq(n.val, "*=")) { op = "mul" }
                        if (ofs_str_eq(n.val, "/=")) { op = "sdiv" }
                        if (ofs_str_eq(n.val, "%=")) { op = "srem" }
                        if (ofs_str_eq(llvm_type(t), "double")) {
                            op = "fadd"
                            if (ofs_str_eq(n.val, "-=")) { op = "fsub" }
                            if (ofs_str_eq(n.val, "*=")) { op = "fmul" }
                            if (ofs_str_eq(n.val, "/=")) { op = "fdiv" }
                        }
                        cg_emit("  " + newv + " = " + op + " " + llvm_type(t) + " " + oldv + ", " + v)
                    }
                    v = newv
                }
                if (is_named_type(t)) {
                    forge loaded_named = next_tmp("named_val")
                    cg_emit("  " + loaded_named + " = load %" + t + ", ptr " + v)
                    cg_emit("  store %" + t + " " + loaded_named + ", ptr " + p)
                } else {
                    cg_emit("  store " + llvm_type(t) + " " + v + ", ptr " + p)
                }
                _expr_val = v
                _expr_type = t
                return
            }
            if (target.kind == NK_FIELD) {
                forge base: Node = node_get(target.c0)
                emit_expr(target.c0)
                forge base_ptr = _expr_val
                forge base_type = _expr_type
                forge ft = field_type(base_type, target.val)
                forge idx = field_index(base_type, target.val)
                forge gep = next_tmp("field_ptr")
                cg_emit("  " + gep + " = getelementptr inbounds %" + base_type + ", ptr " + base_ptr + ", i32 0, i32 " + ofs_stone_to_obsidian(idx))
                if (is_array_get(n.c1)) {
                    emit_array_get(n.c1, ft)
                } else {
                    emit_expr(n.c1)
                }
                forge fv = coerce_for_store(_expr_val, _expr_type, ft)
                if (is_named_type(ft)) {
                    // ponteiro do sub-objeto (ver o caso de BIN_OP "=")
                    cg_emit("  store ptr " + fv + ", ptr " + gep)
                } else {
                    cg_emit("  store " + llvm_type(ft) + " " + fv + ", ptr " + gep)
                }
                _expr_val = fv
                _expr_type = ft
                return
            }
        }

        if (n.kind == NK_FIELD) {
            emit_expr(n.c0)
            forge base_ptr2 = _expr_val
            forge base_type2 = _expr_type
            forge ft2 = field_type(base_type2, n.val)
            forge idx2 = field_index(base_type2, n.val)
            forge gep2 = next_tmp("field_ptr")
            cg_emit("  " + gep2 + " = getelementptr inbounds %" + base_type2 + ", ptr " + base_ptr2 + ", i32 0, i32 " + ofs_stone_to_obsidian(idx2))
            if (is_named_type(ft2)) {
                // o campo guarda o ponteiro do sub-objeto: carrega-o (antes o
                // endereco do proprio campo era usado como se a struct
                // inteira morasse ali, e structs > 8 bytes pisavam os
                // campos seguintes)
                forge sub = next_tmp("sub_obj")
                cg_emit("  " + sub + " = load ptr, ptr " + gep2)
                _expr_val = sub
                _expr_type = ft2
            } else {
                forge lv = next_tmp("field")
                cg_emit("  " + lv + " = load " + llvm_type(ft2) + ", ptr " + gep2)
                _expr_val = lv
                _expr_type = ft2
            }
            return
        }

        if (n.kind == NK_POST_OP) {
            if (ofs_str_eq(n.val, "?")) {
                emit_try(n.c0)
                return
            }
            lower_ns_global(n.c0)
            forge target: Node = node_get(n.c0)
            if (target.kind == NK_IDENT) {
                forge p = var_ptr(target.val)
                forge old = next_tmp("post_old")
                forge nv = next_tmp("post_new")
                cg_emit("  " + old + " = load i64, ptr " + p)
                if (ofs_str_eq(n.val, "++")) {
                    cg_emit("  " + nv + " = add i64 " + old + ", 1")
                } else {
                    cg_emit("  " + nv + " = sub i64 " + old + ", 1")
                }
                cg_emit("  store i64 " + nv + ", ptr " + p)
                _expr_val = old
                _expr_type = "stone"
                return
            }
        }

        if (n.kind == NK_CALL) {
            // variant constructor with payload: Tag(payload) -> i64 tag (payload ignored for now)
            forge ctor_tag = variant_tag(n.val)
            if (ctor_tag >= 0) {
                _expr_val = ofs_stone_to_obsidian(ctor_tag)
                _expr_type = "stone"
                return
            }
            if (ofs_str_eq(n.val, "fault_addr")) {
                // endereco da vein (o typeck ja trocou o argumento pelo simbolo
                // mangled); `bind "x"` de extern/rift aponta para o simbolo C.
                forge fa_arg: Node = node_get(node_get_extra(id, 0))
                forge fa_sym = fa_arg.val
                forge fa_i = 0
                while (fa_i < ofs_array_len(_bind_names)) {
                    forge fa_bn: obsidian = ofs_array_get(_bind_names, fa_i)
                    if (ofs_str_eq(fa_bn, fa_sym)) {
                        fa_sym = ofs_array_get(_bind_targets, fa_i)
                        break
                    }
                    fa_i++
                }
                forge fa_tmp = next_tmp("fn_addr")
                cg_emit("  " + fa_tmp + " = ptrtoint ptr @" + fa_sym + " to i64")
                _expr_val = fa_tmp
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "fault_call")) {
                // fault_call(endereco, args...): chamada indireta com ABI C.
                // Argumentos inteiros/ponteiros; o retorno e lido como i64.
                emit_expr(node_get_extra(id, 0))
                forge fcl_addr = _expr_val
                forge fcl_args = ""
                forge fcl_i = 1
                while (fcl_i < node_extra_len(id)) {
                    if (fcl_i > 1) { fcl_args = fcl_args + ", " }
                    emit_expr(node_get_extra(id, fcl_i))
                    if (ofs_str_eq(_expr_type, "bool1")) {
                        forge fcl_b = next_tmp("bool_ext")
                        cg_emit("  " + fcl_b + " = zext i1 " + _expr_val + " to i32")
                        _expr_val = fcl_b
                        _expr_type = "bool"
                    }
                    fcl_args = fcl_args + llvm_type(_expr_type) + " " + _expr_val
                    fcl_i++
                }
                forge fcl_p = next_tmp("fn_ptr")
                cg_emit("  " + fcl_p + " = inttoptr i64 " + fcl_addr + " to ptr")
                forge fcl_r = next_tmp("icall")
                cg_emit("  " + fcl_r + " = call i64 " + fcl_p + "(" + fcl_args + ")")
                _expr_val = fcl_r
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "fault_cut")) {
                forge fc_arg0 = node_get_extra(id, 0)
                forge fc_arg1 = node_get_extra(id, 1)
                forge fc_arg2 = node_get_extra(id, 2)
                emit_expr(fc_arg0)
                forge fc_v = _expr_val
                emit_expr(fc_arg1)
                forge fc_s = _expr_val
                emit_expr(fc_arg2)
                forge fc_w = _expr_val
                forge tmp_sh = next_tmp("fc_sh")
                cg_emit("  " + tmp_sh + " = ashr i64 " + fc_v + ", " + fc_s)
                forge tmp_one = next_tmp("fc_one")
                cg_emit("  " + tmp_one + " = shl i64 1, " + fc_w)
                forge tmp_mask = next_tmp("fc_mask")
                cg_emit("  " + tmp_mask + " = sub i64 " + tmp_one + ", 1")
                forge tmp_res = next_tmp("fc_res")
                cg_emit("  " + tmp_res + " = and i64 " + tmp_sh + ", " + tmp_mask)
                _expr_val = tmp_res
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "fault_patch")) {
                forge fp_arg0 = node_get_extra(id, 0)
                forge fp_arg1 = node_get_extra(id, 1)
                forge fp_arg2 = node_get_extra(id, 2)
                forge fp_arg3 = node_get_extra(id, 3)
                emit_expr(fp_arg0)
                forge fp_b = _expr_val
                emit_expr(fp_arg1)
                forge fp_s = _expr_val
                emit_expr(fp_arg2)
                forge fp_w = _expr_val
                emit_expr(fp_arg3)
                forge fp_ins = _expr_val
                forge fp_one = next_tmp("fp_one")
                cg_emit("  " + fp_one + " = shl i64 1, " + fp_w)
                forge fp_m1 = next_tmp("fp_m1")
                cg_emit("  " + fp_m1 + " = sub i64 " + fp_one + ", 1")
                forge fp_fmask = next_tmp("fp_fmask")
                cg_emit("  " + fp_fmask + " = shl i64 " + fp_m1 + ", " + fp_s)
                forge fp_imask = next_tmp("fp_imask")
                cg_emit("  " + fp_imask + " = xor i64 " + fp_fmask + ", -1")
                forge fp_clear = next_tmp("fp_clear")
                cg_emit("  " + fp_clear + " = and i64 " + fp_b + ", " + fp_imask)
                forge fp_in_m = next_tmp("fp_in_m")
                cg_emit("  " + fp_in_m + " = and i64 " + fp_ins + ", " + fp_m1)
                forge fp_in_sh = next_tmp("fp_in_sh")
                cg_emit("  " + fp_in_sh + " = shl i64 " + fp_in_m + ", " + fp_s)
                forge fp_res = next_tmp("fp_res")
                cg_emit("  " + fp_res + " = or i64 " + fp_clear + ", " + fp_in_sh)
                _expr_val = fp_res
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "fault_fence")) {
                cg_emit("  fence seq_cst")
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            if (ofs_str_eq(n.val, "fault_step")) {
                forge fs_arg0 = node_get_extra(id, 0)
                forge fs_arg1 = node_get_extra(id, 1)
                emit_expr(fs_arg0)
                forge fs_ptr = _expr_val
                forge fs_t = _expr_type
                forge pointee = "stone"
                if (ofs_str_char_at(fs_t, 0) == 42) {
                    pointee = ofs_str_substr(fs_t, 1, ofs_str_len(fs_t) - 1)
                }
                emit_expr(fs_arg1)
                forge fs_idx = _expr_val
                forge fs_tmp = next_tmp("fault_step")
                cg_emit("  " + fs_tmp + " = getelementptr inbounds " + llvm_type(pointee) + ", ptr " + fs_ptr + ", i64 " + fs_idx)
                _expr_val = fs_tmp
                _expr_type = fs_t
                return
            }

            if (ofs_str_eq(n.val, "fault_prefetch")) {
                forge fp_arg = node_get_extra(id, 0)
                emit_expr(fp_arg)
                cg_emit("  call void @llvm.prefetch.p0(ptr " + _expr_val + ", i32 0, i32 3, i32 1)")
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            if (ofs_str_eq(n.val, "fault_swap")) {
                forge fsw_arg = node_get_extra(id, 0)
                emit_expr(fsw_arg)
                forge fsw_tmp = next_tmp("fault_swap")
                cg_emit("  " + fsw_tmp + " = call i64 @llvm.bswap.i64(i64 " + _expr_val + ")")
                _expr_val = fsw_tmp
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "fault_trap")) {
                cg_emit("  call void @llvm.trap()")
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            // fault_count/fault_lead/fault_trail: popcount e zeros a esquerda/
            // direita em 64 bits (0 -> 64 zeros; negativos em complemento de 2)
            if (ofs_str_eq(n.val, "fault_count") || ofs_str_eq(n.val, "fault_lead") || ofs_str_eq(n.val, "fault_trail")) {
                emit_expr(node_get_extra(id, 0))
                forge fb_v = coerce_for_store(_expr_val, _expr_type, "stone")
                forge fb_tmp = next_tmp("fault_bits")
                if (ofs_str_eq(n.val, "fault_count")) {
                    cg_emit("  " + fb_tmp + " = call i64 @llvm.ctpop.i64(i64 " + fb_v + ")")
                } else if (ofs_str_eq(n.val, "fault_lead")) {
                    cg_emit("  " + fb_tmp + " = call i64 @llvm.ctlz.i64(i64 " + fb_v + ", i1 false)")
                } else {
                    cg_emit("  " + fb_tmp + " = call i64 @llvm.cttz.i64(i64 " + fb_v + ", i1 false)")
                }
                _expr_val = fb_tmp
                _expr_type = "stone"
                return
            }

            // fault_spin_left/right(v, n): rotacao de 64 bits; n e tomado modulo 64
            if (ofs_str_eq(n.val, "fault_spin_left") || ofs_str_eq(n.val, "fault_spin_right")) {
                emit_expr(node_get_extra(id, 0))
                forge fr_v = coerce_for_store(_expr_val, _expr_type, "stone")
                emit_expr(node_get_extra(id, 1))
                forge fr_n = coerce_for_store(_expr_val, _expr_type, "stone")
                forge fr_tmp = next_tmp("fault_spin")
                forge fr_fn = "fshl"
                if (ofs_str_eq(n.val, "fault_spin_right")) { fr_fn = "fshr" }
                cg_emit("  " + fr_tmp + " = call i64 @llvm." + fr_fn + ".i64(i64 " + fr_v + ", i64 " + fr_v + ", i64 " + fr_n + ")")
                _expr_val = fr_tmp
                _expr_type = "stone"
                return
            }

            // fault_weave(mask, left, right): bit de `left` onde mask=1 e de
            // `right` onde mask=0  ==  (left & mask) | (right & ~mask)
            if (ofs_str_eq(n.val, "fault_weave")) {
                emit_expr(node_get_extra(id, 0))
                forge fw_m = coerce_for_store(_expr_val, _expr_type, "stone")
                emit_expr(node_get_extra(id, 1))
                forge fw_l = coerce_for_store(_expr_val, _expr_type, "stone")
                emit_expr(node_get_extra(id, 2))
                forge fw_r = coerce_for_store(_expr_val, _expr_type, "stone")
                forge fw_a = next_tmp("fw_l")
                cg_emit("  " + fw_a + " = and i64 " + fw_l + ", " + fw_m)
                forge fw_nm = next_tmp("fw_nm")
                cg_emit("  " + fw_nm + " = xor i64 " + fw_m + ", -1")
                forge fw_b = next_tmp("fw_r")
                cg_emit("  " + fw_b + " = and i64 " + fw_r + ", " + fw_nm)
                forge fw_res = next_tmp("fault_weave")
                cg_emit("  " + fw_res + " = or i64 " + fw_a + ", " + fw_b)
                _expr_val = fw_res
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "fault_unreachable")) {
                cg_emit("  call void @llvm.trap()")
                cg_emit("  unreachable")
                // o resto da expressao/bloco continua num bloco sem predecessor
                cg_emit(next_label("fault_dead") + ":")
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            // fault_memcpy(dst, src, len) / fault_memset(dst, byte, len)
            if (ofs_str_eq(n.val, "fault_memcpy") || ofs_str_eq(n.val, "fault_memset")) {
                emit_expr(node_get_extra(id, 0))
                forge fm_d = coerce_for_store(_expr_val, _expr_type, "ptr")
                emit_expr(node_get_extra(id, 1))
                forge fm_s = _expr_val
                forge fm_st = _expr_type
                emit_expr(node_get_extra(id, 2))
                forge fm_n = coerce_for_store(_expr_val, _expr_type, "stone")
                if (ofs_str_eq(n.val, "fault_memcpy")) {
                    forge fm_sp = coerce_for_store(fm_s, fm_st, "ptr")
                    cg_emit("  call void @llvm.memcpy.p0.p0.i64(ptr " + fm_d + ", ptr " + fm_sp + ", i64 " + fm_n + ", i1 false)")
                } else {
                    forge fm_b = next_tmp("fm_byte")
                    cg_emit("  " + fm_b + " = trunc i64 " + coerce_for_store(fm_s, fm_st, "stone") + " to i8")
                    cg_emit("  call void @llvm.memset.p0.i64(ptr " + fm_d + ", i8 " + fm_b + ", i64 " + fm_n + ", i1 false)")
                }
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            if (ofs_str_eq(n.val, "ofs_stone_to_obsidian")) {
                forge arg_id0 = node_get_extra(id, 0)
                emit_expr(arg_id0)
                forge tmp0 = next_tmp("stone_to_str")
                cg_emit("  " + tmp0 + " = call ptr @ofs_stone_to_obsidian(i64 " + _expr_val + ")")
                _expr_val = tmp0
                _expr_type = "obsidian"
                return
            }

            if (ofs_str_eq(n.val, "ofs_str_len")) {
                forge arg_id1 = node_get_extra(id, 0)
                emit_expr(arg_id1)
                forge tmp1 = next_tmp("strlen")
                cg_emit("  " + tmp1 + " = call i64 @ofs_str_len(ptr " + _expr_val + ")")
                _expr_val = tmp1
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "ofs_str_eq")) {
                forge a_id = node_get_extra(id, 0)
                emit_expr(a_id)
                forge a = _expr_val
                forge b_id = node_get_extra(id, 1)
                emit_expr(b_id)
                forge b = _expr_val
                forge tmp2 = next_tmp("streq")
                cg_emit("  " + tmp2 + " = call i32 @ofs_str_eq(ptr " + a + ", ptr " + b + ")")
                _expr_val = tmp2
                _expr_type = "bool"
                return
            }

            if (ofs_str_eq(n.val, "ofs_str_contains")) {
                forge a_id2 = node_get_extra(id, 0)
                emit_expr(a_id2)
                forge a2 = _expr_val
                forge b_id2 = node_get_extra(id, 1)
                emit_expr(b_id2)
                forge b2 = _expr_val
                forge tmp_sc = next_tmp("strcontains")
                cg_emit("  " + tmp_sc + " = call i32 @ofs_str_contains(ptr " + a2 + ", ptr " + b2 + ")")
                _expr_val = tmp_sc
                _expr_type = "bool"
                return
            }

            if (ofs_str_eq(n.val, "ofs_pow") || ofs_str_eq(n.val, "ofs_sqrt")) {
                forge args2 = ""
                forge ai = 0
                while (ai < node_extra_len(id)) {
                    if (ai > 0) { args2 = args2 + ", " }
                    forge aid = node_get_extra(id, ai)
                    emit_expr(aid)
                    args2 = args2 + "double " + _expr_val
                    ai++
                }
                forge dt = next_tmp("math")
                cg_emit("  " + dt + " = call double @" + n.val + "(" + args2 + ")")
                _expr_val = dt
                _expr_type = "crystal"
                return
            }

            if (ofs_str_eq(n.val, "__ofs_variant_name") || ofs_str_eq(n.val, "__ofs_bool_text")) {
                // conversoes para texto inseridas pelo typeck (emit_text_helpers)
                emit_expr(node_get_extra(id, 0))
                normalize_bool1()
                forge tx_tmp = next_tmp("text")
                if (ofs_str_eq(n.val, "__ofs_bool_text")) {
                    forge tb = coerce_for_store(_expr_val, _expr_type, "bool")
                    cg_emit("  " + tx_tmp + " = call ptr @__ofs_bool_text(i32 " + tb + ")")
                } else {
                    forge tv = widen_int(_expr_val, _expr_type)
                    cg_emit("  " + tx_tmp + " = call ptr @__ofs_variant_name(i64 " + tv + ")")
                }
                _expr_val = tx_tmp
                _expr_type = "obsidian"
                return
            }

            if (ofs_str_eq(n.val, "echo")) {
                forge arg_id = node_get_extra(id, 0)
                emit_expr(arg_id)
                forge echo_fresh = expr_is_fresh(arg_id)
                // inteiros pequenos (u8, u32...) imprimem como numero, nao ponteiro
                _expr_val = widen_int(_expr_val, _expr_type)
                _expr_type = _widened_type
                if (ofs_str_eq(_expr_type, "stone") || ofs_str_eq(_expr_type, "u64") || ofs_str_eq(_expr_type, "i64")) {
                    cg_emit("  call void @echo_stone(i64 " + _expr_val + ")")
                } else if (ofs_str_eq(_expr_type, "crystal")) {
                    cg_emit("  call void @echo_crystal(double " + _expr_val + ")")
                } else if (ofs_str_eq(_expr_type, "bool1")) {
                    forge eb = next_tmp("echo_bool")
                    cg_emit("  " + eb + " = zext i1 " + _expr_val + " to i32")
                    cg_emit("  call void @echo_bool(i32 " + eb + ")")
                } else if (ofs_str_eq(_expr_type, "bool")) {
                    cg_emit("  call void @echo_bool(i32 " + _expr_val + ")")
                } else {
                    cg_emit("  call void @echo_obsidian(ptr " + _expr_val + ")")
                    if (echo_fresh) { cg_emit("  call void @ofs_str_release(ptr " + _expr_val + ", i64 1)") }
                }
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            if (ofs_str_eq(n.val, "ofs_array_len")) {
                forge arr_id = node_get_extra(id, 0)
                emit_expr(arr_id)
                _expr_val = emit_arr_len(_expr_val)
                _expr_type = "stone"
                return
            }

            if (ofs_str_eq(n.val, "ofs_array_get")) {
                // infer element type from the array argument's declared type
                forge ag_arr = node_get_extra(id, 0)
                forge ag_type = "stone"
                if (ag_arr >= 0) {
                    forge ag_node: Node = node_get(ag_arr)
                    if (ag_node.kind == NK_IDENT) {
                        forge ag_at = var_type(ag_node.val)
                        if (ofs_str_eq(ag_at, "Array<obsidian>")) { ag_type = "obsidian" }
                        if (ofs_str_eq(ag_at, "Array<crystal>")) { ag_type = "crystal" }
                        if (ofs_str_eq(ag_at, "Array<bool>")) { ag_type = "bool" }
                    }
                }
                emit_array_get(id, ag_type)
                return
            }

            if (ofs_str_eq(n.val, "ofs_array_push")) {
                forge arr_id2 = node_get_extra(id, 0)
                emit_expr(arr_id2)
                forge arr2 = _expr_val
                forge val_id2 = node_get_extra(id, 1)
                emit_expr(val_id2)
                normalize_bool1()
                emit_arr_push(arr2, llvm_type(_expr_type), _expr_val)
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            if (ofs_str_eq(n.val, "ofs_array_set")) {
                forge arr_id3 = node_get_extra(id, 0)
                emit_expr(arr_id3)
                forge arr3 = _expr_val
                forge idx_id3 = node_get_extra(id, 1)
                emit_expr(idx_id3)
                forge idx3 = _expr_val
                forge val_id3 = node_get_extra(id, 2)
                emit_expr(val_id3)
                normalize_bool1()
                emit_arr_store(arr3, idx3, llvm_type(_expr_type), _expr_val)
                _expr_val = "0"
                _expr_type = "void"
                return
            }

            if (ofs_str_eq(n.val, "ofs_array_pop")) {
                forge arr_id4 = node_get_extra(id, 0)
                emit_expr(arr_id4)
                forge pop_raw = next_tmp("arr_pop")
                cg_emit("  " + pop_raw + " = call ptr @ofs_array_pop(ptr " + _expr_val + ")")
                _expr_val = pop_raw
                _expr_type = "ptr"
                // O runtime devolve o endereco do elemento retirado (a memoria
                // continua valida ate o proximo push). Para Array<T> o typeck
                // ja diz que o valor e o elemento: carrega como no array_get.
                forge pop_t = "ptr"
                if (arr_id4 >= 0) {
                    forge pop_node: Node = node_get(arr_id4)
                    if (pop_node.kind == NK_IDENT) {
                        forge pop_at = var_type(pop_node.val)
                        forge pal = ofs_str_len(pop_at)
                        if (pal > 7 && ofs_str_eq(ofs_str_substr(pop_at, 0, 6), "Array<")) {
                            pop_t = ofs_str_substr(pop_at, 6, pal - 7)
                        }
                    }
                }
                if (!ofs_str_eq(pop_t, "ptr")) {
                    forge pop_item = next_tmp("arr_pop_item")
                    if (is_named_type(pop_t) || ofs_str_eq(pop_t, "obsidian") || ofs_str_eq(pop_t, "Array")) {
                        cg_emit("  " + pop_item + " = load ptr, ptr " + pop_raw)
                    } else {
                        cg_emit("  " + pop_item + " = load " + llvm_type(pop_t) + ", ptr " + pop_raw)
                    }
                    _expr_val = pop_item
                    _expr_type = pop_t
                }
                return
            }

            forge args = ""
            // temporarios (`f(a + b)`) passados a parametros que nao escapam
            // sao liberados depois da chamada
            forge free_after: Array<obsidian> = []
            forge cmask = esc_call_mask(id, n.val)
            forge i = 0
            while (i < node_extra_len(id)) {
                if (i > 0) { args = args + ", " }
                forge arg_id = node_get_extra(id, i)
                emit_expr(arg_id)
                if (i < 62 && expr_is_fresh(arg_id)) {
                    if (((cmask >> i) & 1) != 0) { ofs_array_push(free_after, _expr_val) }
                }
                if (ofs_str_eq(_expr_type, "bool1")) {
                    forge b_ext = next_tmp("bool_ext")
                    cg_emit("  " + b_ext + " = zext i1 " + _expr_val + " to i32")
                    _expr_val = b_ext
                    _expr_type = "bool"
                }
                args = args + llvm_type(_expr_type) + " " + _expr_val
                i++
            }
            forge callee = n.val
            forge bi = 0
            while (bi < ofs_array_len(_bind_names)) {
                forge bname: obsidian = ofs_array_get(_bind_names, bi)
                if (ofs_str_eq(bname, callee)) {
                    forge btarget: obsidian = ofs_array_get(_bind_targets, bi)
                    callee = btarget
                    break
                }
                bi++
            }
            forge ret_type = n.type_str
            if (ofs_str_eq(ret_type, "")) { ret_type = "stone" }
            forge ret_llvm = llvm_type(ret_type)
            forge va_sig = variadic_sig(callee)
            if (ofs_str_eq(ret_llvm, "void")) {
                if (!ofs_str_eq(va_sig, "")) {
                    cg_emit("  call " + va_sig + " @" + callee + "(" + args + ")")
                } else {
                    cg_emit("  call void @" + callee + "(" + args + ")")
                }
                _expr_val = "0"
                _expr_type = "void"
            } else {
                forge call_tmp = next_tmp("call")
                forge call_ty = ret_llvm
                if (!ofs_str_eq(va_sig, "")) { call_ty = va_sig }
                cg_emit("  " + call_tmp + " = call " + call_ty + " @" + callee + "(" + args + ")")
                _expr_val = call_tmp
                _expr_type = ret_type
            }
            forge fi2 = 0
            while (fi2 < ofs_array_len(free_after)) {
                forge fv: obsidian = ofs_array_get(free_after, fi2)
                cg_emit("  call void @ofs_str_release(ptr " + fv + ", i64 1)")
                fi2++
            }
            return
        }

        _expr_val = "0"
        _expr_type = "stone"
    }

    vein emit_stmt(id: stone) -> void {
        if (id < 0) { return }
        if (_terminated) { return }
        forge n: Node = node_get(id)

        // strata declarations are handled in collect_types (variants become i64 tags)
        if (n.kind == NK_STRATA) { return }
        if (n.kind == NK_ATTACH) { return }

        if (n.kind == NK_VAR_DECL || n.kind == NK_CONST_DECL) {
            forge t = n.type_str
            if (n.c0 >= 0) {
                forge ann = type_node_name(n.c0)
                if (!ofs_str_eq(ann, "")) { t = ann }
            }
            if (ofs_str_eq(t, "")) { t = "stone" }
            forge p = next_tmp(n.val)
            forge stack_obj = false
            if (is_named_type(t)) {
                if (esc_struct_ok(n.val)) {
                    // monolith local que nao escapa: pilha em vez de heap
                    forge sobj = next_tmp("sobj")
                    cg_emit("  " + sobj + " = alloca %" + t + ", align 8")
                    p = sobj
                    stack_obj = true
                    ofs_array_push(_stack_obj_ptrs, sobj)
                    ofs_array_push(_stack_obj_types, t)
                } else {
                    forge mem = next_tmp("obj")
                    cg_emit("  " + mem + " = call ptr @ofs_alloc(i64 " + ofs_stone_to_obsidian(monolith_alloc_size(t)) + ")")
                    p = mem
                }
            } else {
                cg_emit("  " + p + " = alloca " + storage_type(t) + ", align 8")
            }
            declare_var(n.val, t, p)
            forge own = ""
            if (ofs_str_eq(t, "obsidian") && esc_str_ok(n.val)) {
                own = p + "_own"
                cg_emit("  " + own + " = alloca i64, align 8")
                cg_emit("  store i64 0, ptr " + own)
                ofs_array_push(_own_ptrs, p)
            }
            if (n.c1 >= 0) {
                if (is_array_get(n.c1)) {
                    emit_array_get(n.c1, t)
                } else {
                    emit_expr(n.c1)
                }
                if (is_named_type(t)) {
                    forge named_val = next_tmp("named_val")
                    cg_emit("  " + named_val + " = load %" + t + ", ptr " + _expr_val)
                    cg_emit("  store %" + t + " " + named_val + ", ptr " + p)
                } else {
                    forge init_fresh = expr_is_fresh(n.c1)
                    forge v = coerce_for_store(_expr_val, _expr_type, t)
                    cg_emit("  store " + llvm_type(t) + " " + v + ", ptr " + p)
                    if (!ofs_str_eq(own, "") && init_fresh) {
                        cg_emit("  store i64 1, ptr " + own)
                    }
                }
            } else if (is_named_type(t)) {
                if (stack_obj) { cg_emit("  store %" + t + " zeroinitializer, ptr " + p) }
                emit_init_nested(p, t, 0)
                return
            } else if (ofs_str_eq(t, "obsidian") || ofs_str_eq(t, "Array")) {
                cg_emit("  store ptr null, ptr " + p)
            } else if (ofs_str_eq(t, "crystal")) {
                cg_emit("  store double 0.0, ptr " + p)
            } else {
                cg_emit("  store " + llvm_type(t) + " 0, ptr " + p)
            }
            if (!ofs_str_eq(own, "")) {
                if ((esc_bits_of(n.val) & 2) == 0) { register_scope_free(p, 1) }
            }
            if (esc_is_arr_type(t) && esc_arr_ok(n.val)) {
                ofs_array_push(_free_arr_ptrs, p)
                register_scope_free(p, 2)
            }
            _fresh_val = ""
            return
        }

        if (n.kind == NK_CALL || n.kind == NK_BIN_OP || n.kind == NK_UNARY_OP || n.kind == NK_ASSIGN || n.kind == NK_POST_OP || n.kind == NK_LIT_STRING || n.kind == NK_LIT_INT) {
            emit_expr(id)
            return
        }

        if (n.kind == NK_RETURN) {
            if (ofs_str_eq(_current_ret_type, "void")) {
                emit_anchors_from_depth(0)
                cg_emit("  ret void")
            } else if (ofs_str_eq(_current_ret_type, "main")) {
                emit_anchors_from_depth(0)
                cg_emit("  ret i32 0")
            } else {
                if (is_array_get(n.c0)) {
                    emit_array_get(n.c0, _current_ret_type)
                } else {
                    emit_expr(n.c0)
                }
                forge v = coerce_for_store(_expr_val, _expr_type, _current_ret_type)
                // monolith local na pilha: devolve uma copia no heap
                forge si = ofs_array_len(_stack_obj_ptrs) - 1
                while (si >= 0) {
                    forge sp: obsidian = ofs_array_get(_stack_obj_ptrs, si)
                    if (ofs_str_eq(sp, v)) {
                        forge st: obsidian = ofs_array_get(_stack_obj_types, si)
                        forge hc = next_tmp("ret_obj")
                        forge hv = next_tmp("ret_copy")
                        cg_emit("  " + hc + " = call ptr @ofs_alloc(i64 " + ofs_stone_to_obsidian(monolith_alloc_size(st)) + ")")
                        cg_emit("  " + hv + " = load %" + st + ", ptr " + v)
                        cg_emit("  store %" + st + " " + hv + ", ptr " + hc)
                        v = hc
                        break
                    }
                    si--
                }
                emit_anchors_from_depth(0)
                cg_emit("  ret " + llvm_type(_current_ret_type) + " " + v)
            }
            _terminated = true
            return
        }

        if (n.kind == NK_BREAK) {
            emit_anchors_from_depth(current_loop_anchor_depth() + 1)
            cg_emit("  br label %" + current_break_label())
            _terminated = true
            return
        }

        if (n.kind == NK_CONTINUE) {
            emit_anchors_from_depth(current_loop_anchor_depth() + 1)
            forge cstk = current_loop_save()
            if (ofs_str_len(cstk) > 0) {
                cg_emit("  call void @llvm.stackrestore(ptr " + cstk + ")")
            }
            cg_emit("  br label %" + current_continue_label())
            _terminated = true
            return
        }

        if (n.kind == NK_THROW) {
            emit_expr(n.c0)
            forge str_v = coerce_for_store(_expr_val, _expr_type, "obsidian")
            cg_emit("  call void @echo_obsidian(ptr " + str_v + ")")
            cg_emit("  call void @exit(i64 1)")
            cg_emit("  unreachable")
            _terminated = true
            return
        }

        if (n.kind == NK_BLOCK) {
            push_scope()
            forge bi = 0
            while (bi < node_extra_len(id)) {
                emit_stmt(node_get_extra(id, bi))
                bi++
            }
            pop_scope()
            return
        }

        if (n.kind == NK_ANCHOR) {
            if (n.c0 >= 0) {
                ofs_array_push(_anchor_nodes, n.c0)
                ofs_array_push(_anchor_depths, _scope_depth)
            }
            return
        }

        if (n.kind == NK_MATCH) {
            forge discr_id = n.c0
            forge default_id = -1
            forge i = 0
            while (i < node_extra_len(id)) {
                forge case_id = node_get_extra(id, i)
                forge cnode: Node = node_get(case_id)
                if (cnode.kind == NK_DEFAULT) {
                    default_id = cnode.c0
                    break
                }
                i++
            }

            if (discr_id >= 0) {
                emit_expr(discr_id)
            }
            forge discr_val = _expr_val
            forge discr_type = _expr_type
            forge end_label = next_label("match_end")
            forge current = end_label
            forge done_default = false

            i = 0
            while (i < node_extra_len(id)) {
                forge case_id = node_get_extra(id, i)
                forge cnode: Node = node_get(case_id)
                if (cnode.kind == NK_DEFAULT) {
                    if (default_id >= 0) {
                        emit_stmt(default_id)
                    }
                    done_default = true
                    break
                }
                if (cnode.kind == NK_CASE) {
                    emit_expr(cnode.c0)
                    forge cmp = next_tmp("match_cmp")
                    cg_emit("  " + cmp + " = icmp eq " + llvm_type(discr_type) + " " + discr_val + ", " + _expr_val)
                    forge case_true = next_label("match_case")
                    forge case_next = next_label("match_next")
                    cg_emit("  br i1 " + cmp + ", label %" + case_true + ", label %" + case_next)
                    cg_emit("")
                    cg_emit(case_true + ":")
                    _terminated = false
                    if (cnode.c1 >= 0) { emit_stmt(cnode.c1) }
                    if (!_terminated) { cg_emit("  br label %" + end_label) }
                    cg_emit("")
                    cg_emit(case_next + ":")
                    _terminated = false
                    current = case_next
                }
                i++
            }

            if (!done_default && default_id >= 0) {
                emit_stmt(default_id)
            }
            cg_emit("")
            cg_emit(end_label + ":")
            _terminated = false
            return
        }

        if (n.kind == NK_CASE || n.kind == NK_DEFAULT) {
            if (n.kind == NK_CASE && n.c1 >= 0) { emit_stmt(n.c1) }
            if (n.kind == NK_DEFAULT && n.c0 >= 0) { emit_stmt(n.c0) }
            return
        }

        if (n.kind == NK_IF) {
            emit_expr(n.c0)
            forge cond = expr_as_i1()
            forge then_label = next_label("if_then")
            forge else_label = next_label("if_else")
            forge end_label = next_label("if_end")
            cg_emit("  br i1 " + cond + ", label %" + then_label + ", label %" + else_label)
            cg_emit("")
            cg_emit(then_label + ":")
            _terminated = false
            emit_stmt(n.c1)
            forge then_term = _terminated
            if (!then_term) { cg_emit("  br label %" + end_label) }
            cg_emit("")
            cg_emit(else_label + ":")
            _terminated = false
            if (n.c2 >= 0) { emit_stmt(n.c2) }
            forge else_term = _terminated
            if (!else_term) { cg_emit("  br label %" + end_label) }
            cg_emit("")
            cg_emit(end_label + ":")
            if (then_term && else_term) {
                cg_emit("  unreachable")
            }
            _terminated = then_term && else_term
            return
        }

        if (n.kind == NK_WHILE) {
            forge cond_label = next_label("while_cond")
            forge body_label = next_label("while_body")
            forge end_label2 = next_label("while_end")
            push_loop(end_label2, cond_label)
            cg_emit("  br label %" + cond_label)
            cg_emit("")
            cg_emit(cond_label + ":")
            emit_expr(n.c0)
            forge cond2 = expr_as_i1()
            cg_emit("  br i1 " + cond2 + ", label %" + body_label + ", label %" + end_label2)
            cg_emit("")
            cg_emit(body_label + ":")
            // Loop-body allocas must be reclaimed every iteration, otherwise
            // long loops blow the stack in unoptimized (-O0) codegen.
            forge wstk = next_tmp("loop_stk")
            cg_emit("  " + wstk + " = call ptr @llvm.stacksave()")
            set_loop_save(wstk)
            emit_loop_laa_guard()
            _terminated = false
            emit_stmt(n.c1)
            if (!_terminated) {
                cg_emit("  call void @llvm.stackrestore(ptr " + wstk + ")")
                cg_emit("  br label %" + cond_label)
            }
            cg_emit("")
            cg_emit(end_label2 + ":")
            _terminated = false
            pop_loop()
            return
        }

        if (n.kind == NK_CYCLE_C) {
            push_scope()
            if (n.c0 >= 0) { emit_stmt(n.c0) }
            forge cond_label2 = next_label("cycle_cond")
            forge body_label2 = next_label("cycle_body")
            forge step_label2 = next_label("cycle_step")
            forge end_label3 = next_label("cycle_end")
            push_loop(end_label3, step_label2)
            cg_emit("  br label %" + cond_label2)
            cg_emit("")
            cg_emit(cond_label2 + ":")
            if (n.c1 >= 0) {
                emit_expr(n.c1)
                forge c = expr_as_i1()
                cg_emit("  br i1 " + c + ", label %" + body_label2 + ", label %" + end_label3)
            } else {
                cg_emit("  br label %" + body_label2)
            }
            cg_emit("")
            cg_emit(body_label2 + ":")
            forge cstk2 = next_tmp("loop_stk")
            cg_emit("  " + cstk2 + " = call ptr @llvm.stacksave()")
            set_loop_save(cstk2)
            emit_loop_laa_guard()
            _terminated = false
            if (n.c3 >= 0) { emit_stmt(n.c3) }
            if (!_terminated) {
                cg_emit("  call void @llvm.stackrestore(ptr " + cstk2 + ")")
                cg_emit("  br label %" + step_label2)
            }
            cg_emit("")
            cg_emit(step_label2 + ":")
            _terminated = false
            if (n.c2 >= 0) { emit_expr(n.c2) }
            if (!_terminated) { cg_emit("  br label %" + cond_label2) }
            cg_emit("")
            cg_emit(end_label3 + ":")
            _terminated = false
            pop_loop()
            pop_scope()
            return
        }

        if (n.kind == NK_CYCLE_RANGE) {
            push_scope()
            emit_expr(n.c0)
            forge arr_val = _expr_val
            forge arr_ptr = next_tmp("loop_arr")
            cg_emit("  " + arr_ptr + " = alloca ptr, align 8")
            cg_emit("  store ptr " + arr_val + ", ptr " + arr_ptr)

            forge idx_ptr = next_tmp("loop_idx")
            cg_emit("  " + idx_ptr + " = alloca i64, align 8")
            cg_emit("  store i64 0, ptr " + idx_ptr)

            forge elem_t = n.type_str
            if (ofs_str_eq(elem_t, "")) { elem_t = "stone" }
            forge item_ptr = next_tmp(n.val + "_ptr")
            cg_emit("  " + item_ptr + " = alloca " + llvm_type(elem_t) + ", align 8")
            declare_var(n.val, elem_t, item_ptr)

            forge cond_lbl = next_label("range_cond")
            forge body_lbl = next_label("range_body")
            forge step_lbl = next_label("range_step")
            forge end_lbl = next_label("range_end")
            push_loop(end_lbl, step_lbl)

            cg_emit("  br label %" + cond_lbl)
            cg_emit("")
            cg_emit(cond_lbl + ":")
            forge cur_i = next_tmp("cur_i")
            cg_emit("  " + cur_i + " = load i64, ptr " + idx_ptr)
            forge cur_arr = next_tmp("cur_arr")
            cg_emit("  " + cur_arr + " = load ptr, ptr " + arr_ptr)
            forge arr_len = emit_arr_len(cur_arr)
            forge cond_cmp = next_tmp("cond_cmp")
            cg_emit("  " + cond_cmp + " = icmp slt i64 " + cur_i + ", " + arr_len)
            cg_emit("  br i1 " + cond_cmp + ", label %" + body_lbl + ", label %" + end_lbl)

            cg_emit("")
            cg_emit(body_lbl + ":")
            forge cur_i2 = next_tmp("cur_i")
            cg_emit("  " + cur_i2 + " = load i64, ptr " + idx_ptr)
            forge cur_arr2 = next_tmp("cur_arr")
            cg_emit("  " + cur_arr2 + " = load ptr, ptr " + arr_ptr)
            forge elem_slot = emit_arr_elem_ptr(cur_arr2, cur_i2)
            forge elem_val = next_tmp("elem_val")
            cg_emit("  " + elem_val + " = load " + llvm_type(elem_t) + ", ptr " + elem_slot)
            cg_emit("  store " + llvm_type(elem_t) + " " + elem_val + ", ptr " + item_ptr)
            forge rstk = next_tmp("loop_stk")
            cg_emit("  " + rstk + " = call ptr @llvm.stacksave()")
            set_loop_save(rstk)
            emit_loop_laa_guard()
            _terminated = false
            if (n.c1 >= 0) { emit_stmt(n.c1) }
            if (!_terminated) {
                cg_emit("  call void @llvm.stackrestore(ptr " + rstk + ")")
                cg_emit("  br label %" + step_lbl)
            }

            cg_emit("")
            cg_emit(step_lbl + ":")
            _terminated = false
            forge cur_step_i = next_tmp("step_i")
            cg_emit("  " + cur_step_i + " = load i64, ptr " + idx_ptr)
            forge inc_i = next_tmp("inc_i")
            cg_emit("  " + inc_i + " = add i64 " + cur_step_i + ", 1")
            cg_emit("  store i64 " + inc_i + ", ptr " + idx_ptr)
            cg_emit("  br label %" + cond_lbl)

            cg_emit("")
            cg_emit(end_lbl + ":")
            _terminated = false
            pop_loop()
            pop_scope()
            return
        }
    }

    // ── Analise de escape por funcao (A6: memoria) ───────────────────────
    // Strings, arrays e monoliths sao ponteiros sem GC nem contagem de
    // referencia: `t = s` faz t e s dividirem o mesmo buffer. O codegen so
    // reaproveita/libera memoria quando prova, por NOME dentro da funcao e de
    // forma conservadora, que o valor de uma variavel local nunca e copiado
    // para outro lugar ("nao escapa"). Usos que NAO escapam:
    //   - operando de `+`, comparacao, condicao, indice;
    //   - base de `a[i]`, `a[i] = v`, de ofs_array_push/set/len/get/pop;
    //   - base de campo `n.f` (quando o campo nao e monolith);
    //   - copia por valor de monolith (`forge m: T = n`);
    //   - argumento de builtin que so le (ofs_str_len, echo, ...) ou de vein
    //     do modulo cujo parametro, por esta mesma analise, nao escapa;
    //   - `return s` (so para strings: a variavel morre ali).
    // Qualquer outro uso (atribuir a outra variavel/campo/array, cast, `&`,
    // chamada desconhecida, variavel de `cycle ... in`/`tremor`) escapa.
    // O que o codegen faz com isso:
    //   - obsidian que nao escapa ganha um "dono" em tempo de execucao
    //     (`<ptr>_own`): 1 quando o valor veio de uma concatenacao (buffer
    //     novo e exclusivo). Com dono, `s = s + x` / `s += x` crescem o
    //     buffer no lugar (realloc) e o valor antigo e liberado quando a
    //     variavel recebe outro valor ou sai do escopo;
    //   - Array local que nao escapa e so recebe literais `[...]` e liberado
    //     ao sair do escopo (e antes de receber outro literal);
    //   - monolith local que nao escapa vai para a pilha (alloca) em vez do
    //     heap.
    // Bits por nome: 1 escapa, 2 retornado, 4 array recebeu valor que nao e
    // literal, 8 parametro.
    forge _esc_names: Array<obsidian> = []
    forge _esc_types: Array<obsidian> = []
    forge _esc_bits: Array<stone> = []
    forge _esc_has_anchor: bool = false
    forge _esc_disabled: bool = true
    // mascara de parametros que nao escapam, por vein do modulo
    forge _fn_names: Array<obsidian> = []
    forge _fn_masks: Array<stone> = []
    forge _call_fn_cache: Array<stone> = []
    // por funcao: variaveis obsidian com dono (ptr da variavel) e arrays
    // liberados no fim do escopo; acoes de fim de escopo (anchors sinteticos)
    forge _own_ptrs: Array<obsidian> = []
    forge _free_arr_ptrs: Array<obsidian> = []
    forge _stack_obj_ptrs: Array<obsidian> = []
    forge _stack_obj_types: Array<obsidian> = []
    forge _sf_ptrs: Array<obsidian> = []
    forge _sf_kinds: Array<stone> = []
    // auto-concatenacao em curso (`s = s + ...`): nome e ptr do dono
    forge _selfapp_name: obsidian = ""
    forge _selfapp_own: obsidian = ""
    forge _selfapp_done: bool = false
    // ultimo resultado de concatenacao (temporario exclusivo)
    forge _fresh_val: obsidian = ""

    vein esc_index(name: obsidian) -> stone {
        forge i = ofs_array_len(_esc_names) - 1
        while (i >= 0) {
            forge nm: obsidian = ofs_array_get(_esc_names, i)
            if (ofs_str_eq(nm, name)) { return i }
            i--
        }
        return -1
    }

    vein esc_mark(name: obsidian, bits: stone) -> void {
        forge i = esc_index(name)
        if (i < 0) {
            ofs_array_push(_esc_names, name)
            ofs_array_push(_esc_types, "")
            ofs_array_push(_esc_bits, bits)
            return
        }
        forge old: stone = ofs_array_get(_esc_bits, i)
        ofs_array_set(_esc_bits, i, old | bits)
    }

    vein esc_declare(name: obsidian, t: obsidian, bits: stone) -> void {
        forge i = esc_index(name)
        if (i < 0) {
            ofs_array_push(_esc_names, name)
            ofs_array_push(_esc_types, t)
            ofs_array_push(_esc_bits, bits)
            return
        }
        forge old_t: obsidian = ofs_array_get(_esc_types, i)
        if (ofs_str_eq(old_t, "")) {
            ofs_array_set(_esc_types, i, t)
        } else if (!ofs_str_eq(old_t, t)) {
            bits = bits | 1
        }
        forge old: stone = ofs_array_get(_esc_bits, i)
        ofs_array_set(_esc_bits, i, old | bits)
    }

    vein esc_type_of(name: obsidian) -> obsidian {
        forge i = esc_index(name)
        if (i < 0) { return "" }
        return ofs_array_get(_esc_types, i)
    }

    vein esc_is_arr_type(t: obsidian) -> bool {
        if (ofs_str_eq(t, "Array")) { return true }
        if (ofs_str_len(t) > 6) {
            if (ofs_str_eq(ofs_str_substr(t, 0, 6), "Array<")) { return true }
        }
        return false
    }

    vein esc_is_assign_op(op: obsidian) -> bool {
        if (ofs_str_eq(op, "=") || ofs_str_eq(op, "+=") || ofs_str_eq(op, "-=") || ofs_str_eq(op, "*=") || ofs_str_eq(op, "/=")) { return true }
        if (ofs_str_eq(op, "%=") || ofs_str_eq(op, "&=") || ofs_str_eq(op, "|=") || ofs_str_eq(op, "^=") || ofs_str_eq(op, "<<=") || ofs_str_eq(op, ">>=")) { return true }
        return false
    }

    // Builtins (sem corpo no modulo) que so leem os argumentos e nunca os
    // devolvem nem guardam.
    vein esc_pure_builtin(nm: obsidian) -> bool {
        if (ofs_str_eq(nm, "echo") || ofs_str_eq(nm, "ofs_str_len") || ofs_str_eq(nm, "ofs_str_char_at") || ofs_str_eq(nm, "ofs_str_char_at_known")) { return true }
        if (ofs_str_eq(nm, "ofs_str_eq") || ofs_str_eq(nm, "ofs_str_concat") || ofs_str_eq(nm, "ofs_str_substr") || ofs_str_eq(nm, "ofs_str_contains")) { return true }
        if (ofs_str_eq(nm, "ofs_str_upper") || ofs_str_eq(nm, "ofs_str_lower") || ofs_str_eq(nm, "ofs_obsidian_to_stone") || ofs_str_eq(nm, "ofs_obsidian_to_crystal")) { return true }
        if (ofs_str_eq(nm, "ofs_stone_to_obsidian") || ofs_str_eq(nm, "ofs_crystal_to_obsidian") || ofs_str_eq(nm, "ofs_array_len") || ofs_str_eq(nm, "ofs_array_get")) { return true }
        if (ofs_str_eq(nm, "ofs_array_pop") || ofs_str_eq(nm, "strlen") || ofs_str_eq(nm, "strcmp") || ofs_str_eq(nm, "strncmp")) { return true }
        if (ofs_str_eq(nm, "fputs") || ofs_str_eq(nm, "puts")) { return true }
        return false
    }

    vein esc_fn_index(call_id: stone, nm: obsidian) -> stone {
        if (call_id >= 0 && call_id < ofs_array_len(_call_fn_cache)) {
            forge c: stone = ofs_array_get(_call_fn_cache, call_id)
            if (c != -2) { return c }
        }
        forge r = -1
        forge i = 0
        while (i < ofs_array_len(_fn_names)) {
            forge fnm: obsidian = ofs_array_get(_fn_names, i)
            if (ofs_str_eq(fnm, nm)) {
                r = i
                break
            }
            i++
        }
        if (call_id >= 0 && call_id < ofs_array_len(_call_fn_cache)) {
            ofs_array_set(_call_fn_cache, call_id, r)
        }
        return r
    }

    // bit i = o argumento i nao escapa
    vein esc_call_mask(call_id: stone, nm: obsidian) -> stone {
        forge fi = esc_fn_index(call_id, nm)
        if (fi >= 0) { return ofs_array_get(_fn_masks, fi) }
        if (esc_pure_builtin(nm)) { return -1 }
        if (ofs_str_eq(nm, "ofs_array_push")) { return 1 }
        if (ofs_str_eq(nm, "ofs_array_set")) { return 3 }
        return 0
    }

    vein esc_walk_kids(id: stone, ctx: stone) -> void {
        esc_walk(node_child(id, 0), ctx)
        esc_walk(node_child(id, 1), ctx)
        esc_walk(node_child(id, 2), ctx)
        esc_walk(node_child(id, 3), ctx)
        forge i = 0
        forge cnt = node_extra_len(id)
        while (i < cnt) {
            esc_walk(node_get_extra(id, i), ctx)
            i++
        }
    }

    // ctx: 0 comando, 1 escapa, 2 so leitura, 3 base de campo, 4 retorno
    vein esc_walk(id: stone, ctx: stone) -> void {
        if (id < 0) { return }
        forge k = node_kind_of(id)
        if (k == NK_IDENT) {
            if (ctx == 1) { esc_mark(node_val_of(id), 1) }
            if (ctx == 4) { esc_mark(node_val_of(id), 2) }
            return
        }
        if (k == NK_LIT_INT || k == NK_LIT_FLOAT || k == NK_LIT_STRING || k == NK_LIT_BOOL || k == NK_LIT_NULL) { return }
        if (k == NK_BREAK || k == NK_CONTINUE || k == NK_STRATA || k == NK_ATTACH) { return }
        if (k == NK_BLOCK) {
            forge bi = 0
            forge bcnt = node_extra_len(id)
            while (bi < bcnt) {
                esc_walk(node_get_extra(id, bi), 0)
                bi++
            }
            return
        }
        if (k == NK_VAR_DECL || k == NK_CONST_DECL) {
            forge dn: Node = node_get(id)
            forge t = dn.type_str
            if (dn.c0 >= 0) {
                forge ann = type_node_name(dn.c0)
                if (!ofs_str_eq(ann, "")) { t = ann }
            }
            if (ofs_str_eq(t, "")) { t = "stone" }
            esc_declare(dn.val, t, 0)
            if (dn.c1 >= 0) {
                if (is_named_type(t)) {
                    esc_walk(dn.c1, 2)
                } else {
                    esc_walk(dn.c1, 1)
                }
                if (esc_is_arr_type(t) && node_kind_of(dn.c1) != NK_ARRAY_LIT) { esc_mark(dn.val, 4) }
            }
            return
        }
        if (k == NK_BIN_OP || k == NK_ASSIGN) {
            forge bn: Node = node_get(id)
            if (k == NK_ASSIGN || esc_is_assign_op(bn.val)) {
                esc_walk_assign(bn.c0, bn.val, bn.c1, ctx)
                return
            }
            esc_walk(bn.c0, 2)
            esc_walk(bn.c1, 2)
            return
        }
        if (k == NK_UNARY_OP) {
            if (ofs_str_eq(node_val_of(id), "&")) {
                esc_walk(node_child(id, 0), 1)
            } else {
                esc_walk(node_child(id, 0), 2)
            }
            return
        }
        if (k == NK_POST_OP) {
            if (ofs_str_eq(node_val_of(id), "?")) {
                esc_walk(node_child(id, 0), ctx)
            } else {
                esc_walk(node_child(id, 0), 1)
            }
            return
        }
        if (k == NK_CAST) {
            esc_walk(node_child(id, 0), 1)
            return
        }
        if (k == NK_INDEX) {
            esc_walk(node_child(id, 0), 2)
            esc_walk(node_child(id, 1), 2)
            return
        }
        if (k == NK_FIELD) {
            esc_walk_field(id, ctx)
            return
        }
        if (k == NK_CALL) {
            forge cnm = node_val_of(id)
            forge mask = esc_call_mask(id, cnm)
            forge ci = 0
            forge ccnt = node_extra_len(id)
            while (ci < ccnt) {
                forge arg = node_get_extra(id, ci)
                forge keep = false
                if (ci < 62) {
                    if (((mask >> ci) & 1) != 0) { keep = true }
                }
                if (keep) {
                    esc_walk(arg, 2)
                } else {
                    esc_walk(arg, 1)
                }
                ci++
            }
            return
        }
        if (k == NK_RETURN) {
            esc_walk(node_child(id, 0), 4)
            return
        }
        if (k == NK_IF) {
            esc_walk(node_child(id, 0), 2)
            esc_walk(node_child(id, 1), 0)
            esc_walk(node_child(id, 2), 0)
            return
        }
        if (k == NK_WHILE) {
            esc_walk(node_child(id, 0), 2)
            esc_walk(node_child(id, 1), 0)
            return
        }
        if (k == NK_CYCLE_C) {
            esc_walk(node_child(id, 0), 0)
            esc_walk(node_child(id, 1), 2)
            esc_walk(node_child(id, 2), 0)
            esc_walk(node_child(id, 3), 0)
            return
        }
        if (k == NK_CYCLE_RANGE) {
            esc_mark(node_val_of(id), 1)
            esc_walk(node_child(id, 0), 2)
            esc_walk(node_child(id, 1), 0)
            return
        }
        if (k == NK_TREMOR) {
            esc_walk(node_child(id, 0), 0)
            forge cv = node_child(id, 1)
            if (cv >= 0) {
                esc_mark(node_val_of(cv), 1)
                esc_walk(cv, 1)
            }
            esc_walk(node_child(id, 2), 0)
            return
        }
        if (k == NK_ANCHOR) {
            _esc_has_anchor = true
            esc_walk(node_child(id, 0), 0)
            return
        }
        if (k == NK_THROW) {
            esc_walk(node_child(id, 0), 2)
            return
        }
        if (k == NK_LAMBDA) {
            _esc_disabled = true
            return
        }
        if (k == NK_MATCH) {
            esc_walk(node_child(id, 0), 2)
            forge mi = 0
            forge mcnt = node_extra_len(id)
            while (mi < mcnt) {
                forge cid = node_get_extra(id, mi)
                forge ck = node_kind_of(cid)
                if (ck == NK_CASE) {
                    esc_walk(node_child(cid, 0), 2)
                    esc_walk(node_child(cid, 1), 0)
                } else if (ck == NK_DEFAULT) {
                    esc_walk(node_child(cid, 0), 0)
                } else {
                    esc_walk(cid, 1)
                }
                mi++
            }
            return
        }
        // no desconhecido: tudo o que aparece embaixo escapa
        esc_walk_kids(id, 1)
    }

    vein esc_walk_assign(target: stone, op: obsidian, value: stone, ctx: stone) -> void {
        forge tk = node_kind_of(target)
        if (tk == NK_IDENT) {
            forge nm = node_val_of(target)
            // valor da atribuicao usado como expressao: aliasa a variavel
            if (ctx != 0) { esc_mark(nm, 1) }
            forge tt = esc_type_of(nm)
            if (ofs_str_eq(op, "=")) {
                if (is_named_type(tt)) {
                    esc_walk(value, 2)
                } else {
                    esc_walk(value, 1)
                }
                if (node_kind_of(value) != NK_ARRAY_LIT) { esc_mark(nm, 4) }
            } else {
                if (!ofs_str_eq(op, "+=")) { esc_mark(nm, 1) }
                esc_walk(value, 2)
            }
            return
        }
        if (tk == NK_INDEX) {
            esc_walk(node_child(target, 0), 2)
            esc_walk(node_child(target, 1), 2)
            esc_walk(value, 1)
            return
        }
        if (tk == NK_FIELD) {
            esc_walk(node_child(target, 0), 3)
            esc_walk(value, 1)
            return
        }
        if (tk == NK_UNARY_OP) {
            esc_walk(node_child(target, 0), 2)
            esc_walk(value, 1)
            return
        }
        esc_walk(target, 1)
        esc_walk(value, 1)
    }

    vein esc_walk_field(id: stone, ctx: stone) -> void {
        forge b = node_child(id, 0)
        if (ctx == 1 || ctx == 4) {
            // o valor lido vai ser guardado: campo monolith = ponteiro para
            // dentro do objeto base
            if (node_kind_of(b) != NK_IDENT) {
                esc_walk(b, 1)
                return
            }
            forge bt = esc_type_of(node_val_of(b))
            if (is_named_type(bt)) {
                if (is_named_type(field_type(bt, node_val_of(id)))) {
                    esc_walk(b, 1)
                    return
                }
            }
        }
        esc_walk(b, 3)
    }

    vein esc_param_type(param_id: stone) -> obsidian {
        forge pc0 = node_child(param_id, 0)
        if (pc0 < 0) { return "stone" }
        if (node_kind_of(pc0) == NK_TYPE_ARRAY) { return type_node_name(pc0) }
        return node_val_of(pc0)
    }

    // Preenche as tabelas para a funcao `fn_id` (FN_DECL ou CORE_DECL).
    vein esc_analyze(fn_id: stone) -> void {
        _esc_names = []
        _esc_types = []
        _esc_bits = []
        _esc_has_anchor = false
        _esc_disabled = false
        forge k = node_kind_of(fn_id)
        if (k == NK_FN_DECL) {
            forge params_id = node_child(fn_id, 0)
            forge pi = 0
            forge pcnt = node_extra_len(params_id)
            while (pi < pcnt) {
                forge pid = node_get_extra(params_id, pi)
                esc_declare(node_val_of(pid), esc_param_type(pid), 8)
                pi++
            }
        }
        forge body = node_child(fn_id, 2)
        if (body < 0) {
            _esc_disabled = true
            return
        }
        forge si = 0
        forge scnt = node_extra_len(body)
        while (si < scnt) {
            esc_walk(node_get_extra(body, si), 0)
            si++
        }
    }

    vein esc_bits_of(name: obsidian) -> stone {
        forge i = esc_index(name)
        if (i < 0) { return 1 }
        return ofs_array_get(_esc_bits, i)
    }

    vein esc_str_ok(name: obsidian) -> bool {
        if (_esc_disabled) { return false }
        if (!ofs_str_eq(esc_type_of(name), "obsidian")) { return false }
        forge b = esc_bits_of(name)
        if ((b & 1) != 0) { return false }
        if (_esc_has_anchor && (b & 2) != 0) { return false }
        return true
    }

    vein esc_arr_ok(name: obsidian) -> bool {
        if (_esc_disabled) { return false }
        if (!esc_is_arr_type(esc_type_of(name))) { return false }
        return (esc_bits_of(name) & 15) == 0
    }

    // `return n` e permitido: o retorno copia o objeto da pilha para um
    // bloco novo no heap (ver NK_RETURN), entao o laco que so procura
    // (`forge s: Sym = lista[i]; if (...) { return s }`) aloca uma vez, nao
    // uma vez por volta.
    vein esc_struct_ok(name: obsidian) -> bool {
        if (_esc_disabled) { return false }
        if (!is_named_type(esc_type_of(name))) { return false }
        return (esc_bits_of(name) & 9) == 0
    }

    vein esc_list_has(list: Array<obsidian>, v: obsidian) -> bool {
        forge i = ofs_array_len(list) - 1
        while (i >= 0) {
            forge x: obsidian = ofs_array_get(list, i)
            if (ofs_str_eq(x, v)) { return true }
            i--
        }
        return false
    }

    // Mascara de parametros que nao escapam (nem sao retornados).
    vein esc_param_mask(fn_id: stone) -> stone {
        esc_analyze(fn_id)
        if (_esc_disabled) { return 0 }
        if (node_kind_of(fn_id) != NK_FN_DECL) { return 0 }
        forge params_id = node_child(fn_id, 0)
        forge mask = 0
        forge pi = 0
        forge pcnt = node_extra_len(params_id)
        while (pi < pcnt && pi < 62) {
            forge pid = node_get_extra(params_id, pi)
            if ((esc_bits_of(node_val_of(pid)) & 3) == 0) { mask = mask | (1 << pi) }
            pi++
        }
        return mask
    }

    vein esc_collect_fns(root_id: stone, ids: Array<stone>) -> void {
        forge i = 0
        while (i < node_extra_len(root_id)) {
            forge decl_id = node_get_extra(root_id, i)
            forge k = node_kind_of(decl_id)
            if (k == NK_CORE_DECL || k == NK_FN_DECL) {
                ofs_array_push(ids, decl_id)
            } else if (k == NK_NAMESPACE || k == NK_IMPL) {
                forge j = 0
                while (j < node_extra_len(decl_id)) {
                    forge member_id = node_get_extra(decl_id, j)
                    forge mk = node_kind_of(member_id)
                    if (mk == NK_CORE_DECL || mk == NK_FN_DECL) {
                        ofs_array_push(ids, member_id)
                    }
                    j++
                }
            }
            i++
        }
    }

    // Ponto fixo pessimista: comeca com "todo parametro escapa" e cada
    // passada so usa fatos ja provados (seguro com recursao).
    vein esc_compute_masks(root_id: stone) -> void {
        forge ids: Array<stone> = []
        esc_collect_fns(root_id, ids)
        _fn_names = []
        _fn_masks = []
        _call_fn_cache = []
        forge pool = node_pool_len()
        forge ci = 0
        while (ci < pool) {
            ofs_array_push(_call_fn_cache, -2)
            ci++
        }
        forge i = 0
        while (i < ofs_array_len(ids)) {
            forge fid: stone = ofs_array_get(ids, i)
            ofs_array_push(_fn_names, node_val_of(fid))
            ofs_array_push(_fn_masks, 0)
            i++
        }
        forge pass = 0
        while (pass < 3) {
            i = 0
            while (i < ofs_array_len(ids)) {
                forge fid2: stone = ofs_array_get(ids, i)
                ofs_array_set(_fn_masks, i, esc_param_mask(fid2))
                i++
            }
            pass++
        }
        _esc_names = []
        _esc_types = []
        _esc_bits = []
        _esc_disabled = true
    }

    // Variavel obsidian com dono: ptr do contador `_own`, ou "" se nao tem.
    vein own_ptr_of(name: obsidian) -> obsidian {
        if (var_index(name) < 0) { return "" }
        forge p = var_ptr(name)
        if (esc_list_has(_own_ptrs, p)) { return p + "_own" }
        return ""
    }

    // O no `id` acabou de ser emitido e o valor e um temporario exclusivo
    // (resultado de concatenacao que ninguem mais viu)?
    vein expr_is_fresh(id: stone) -> bool {
        if (ofs_str_eq(_fresh_val, "")) { return false }
        if (!ofs_str_eq(_fresh_val, _expr_val)) { return false }
        if (node_kind_of(id) != NK_BIN_OP) { return false }
        return ofs_str_eq(node_val_of(id), "+")
    }

    // Quantas vezes o identificador `name` aparece na subarvore `id`.
    vein count_ident(id: stone, name: obsidian) -> stone {
        if (id < 0) { return 0 }
        forge k = node_kind_of(id)
        if (k == NK_IDENT) {
            if (ofs_str_eq(node_val_of(id), name)) { return 1 }
            return 0
        }
        forge c = count_ident(node_child(id, 0), name) + count_ident(node_child(id, 1), name)
        c = c + count_ident(node_child(id, 2), name) + count_ident(node_child(id, 3), name)
        forge i = 0
        forge cnt = node_extra_len(id)
        while (i < cnt) {
            c = c + count_ident(node_get_extra(id, i), name)
            i++
        }
        return c
    }

    // Folha mais a esquerda de uma cadeia `a + b + c` e o identificador name?
    vein concat_leftmost_is(id: stone, name: obsidian) -> bool {
        forge cur = id
        while (node_kind_of(cur) == NK_BIN_OP && ofs_str_eq(node_val_of(cur), "+")) {
            cur = node_child(cur, 0)
        }
        if (node_kind_of(cur) != NK_IDENT) { return false }
        return ofs_str_eq(node_val_of(cur), name)
    }

    // Registra uma acao de fim de escopo (como um `anchor`): 1 = liberar a
    // string com dono em `p`, 2 = liberar o array em `p`.
    vein register_scope_free(p: obsidian, kind: stone) -> void {
        ofs_array_push(_sf_ptrs, p)
        ofs_array_push(_sf_kinds, kind)
        ofs_array_push(_anchor_nodes, 0 - 1 - ofs_array_len(_sf_ptrs))
        ofs_array_push(_anchor_depths, _scope_depth)
    }

    vein emit_scope_free(idx: stone) -> void {
        forge p: obsidian = ofs_array_get(_sf_ptrs, idx)
        forge kind: stone = ofs_array_get(_sf_kinds, idx)
        forge v = next_tmp("sf_val")
        cg_emit("  " + v + " = load ptr, ptr " + p)
        if (kind == 1) {
            forge o = next_tmp("sf_own")
            cg_emit("  " + o + " = load i64, ptr " + p + "_own")
            cg_emit("  call void @ofs_str_release(ptr " + v + ", i64 " + o + ")")
        } else {
            emit_arr_free_inline(v)
        }
    }

    // Grava `v` numa variavel obsidian com dono `own`: libera o valor antigo
    // (se era dela) e marca o novo como dela quando `fresh`.
    vein emit_owned_store(p: obsidian, own: obsidian, v: obsidian, fresh: bool) -> void {
        forge oldv = next_tmp("own_old")
        forge oldo = next_tmp("own_flag")
        cg_emit("  " + oldv + " = load ptr, ptr " + p)
        cg_emit("  " + oldo + " = load i64, ptr " + own)
        cg_emit("  call void @ofs_str_release(ptr " + oldv + ", i64 " + oldo + ")")
        cg_emit("  store ptr " + v + ", ptr " + p)
        if (fresh) {
            cg_emit("  store i64 1, ptr " + own)
        } else {
            cg_emit("  store i64 0, ptr " + own)
        }
    }

    // Atribuicao a uma variavel obsidian com dono (ver analise de escape).
    vein emit_owned_assign(name: obsidian, p: obsidian, own: obsidian, op: obsidian, value_id: stone) -> void {
        if (ofs_str_eq(op, "+=")) {
            if (is_array_get(value_id)) {
                emit_array_get(value_id, "obsidian")
            } else {
                emit_expr(value_id)
            }
            forge vf = expr_is_fresh(value_id)
            forge v = coerce_for_store(_expr_val, _expr_type, "obsidian")
            forge oldv = next_tmp("own_old")
            forge oldo = next_tmp("own_flag")
            cg_emit("  " + oldv + " = load ptr, ptr " + p)
            cg_emit("  " + oldo + " = load i64, ptr " + own)
            forge fl = oldo
            if (vf) {
                fl = next_tmp("cat_flags")
                cg_emit("  " + fl + " = or i64 " + oldo + ", 2")
            }
            forge nv = next_tmp("concat")
            cg_emit("  " + nv + " = call ptr @ofs_str_concat_ex(ptr " + oldv + ", ptr " + v + ", i64 " + fl + ")")
            cg_emit("  store ptr " + nv + ", ptr " + p)
            cg_emit("  store i64 1, ptr " + own)
            _fresh_val = ""
            _expr_val = nv
            _expr_type = "obsidian"
            return
        }
        // `s = s + ...` (s so aparece como primeira parcela): cresce no lugar
        if (node_kind_of(value_id) == NK_BIN_OP && ofs_str_eq(node_val_of(value_id), "+")) {
            if (concat_leftmost_is(value_id, name) && count_ident(value_id, name) == 1) {
                _selfapp_name = name
                _selfapp_own = own
                _selfapp_done = false
                emit_expr(value_id)
                _selfapp_name = ""
                if (_selfapp_done) {
                    _selfapp_done = false
                    forge sv = coerce_for_store(_expr_val, _expr_type, "obsidian")
                    cg_emit("  store ptr " + sv + ", ptr " + p)
                    cg_emit("  store i64 1, ptr " + own)
                    _fresh_val = ""
                    _expr_val = sv
                    _expr_type = "obsidian"
                    return
                }
                forge f2 = expr_is_fresh(value_id)
                forge v2 = coerce_for_store(_expr_val, _expr_type, "obsidian")
                emit_owned_store(p, own, v2, f2)
                _fresh_val = ""
                _expr_val = v2
                _expr_type = "obsidian"
                return
            }
        }
        if (is_array_get(value_id)) {
            emit_array_get(value_id, "obsidian")
        } else {
            emit_expr(value_id)
        }
        forge f3 = expr_is_fresh(value_id)
        forge v3 = coerce_for_store(_expr_val, _expr_type, "obsidian")
        emit_owned_store(p, own, v3, f3)
        _fresh_val = ""
        _expr_val = v3
        _expr_type = "obsidian"
    }

    vein emit_function(id: stone) -> void {
        forge n: Node = node_get(id)
        if (n.kind == NK_CORE_DECL || (n.kind == NK_FN_DECL && ofs_str_eq(n.val, "main"))) {
            _var_names = []
            _var_types = []
            _var_ptrs = []
            _var_depths = []
            _scope_depth = 0
            _current_ret_type = "main"
            _terminated = false
            esc_analyze(id)
            _own_ptrs = []
            _free_arr_ptrs = []
            _stack_obj_ptrs = []
            _stack_obj_types = []
            _sf_ptrs = []
            _sf_kinds = []
            _selfapp_name = ""
            _fresh_val = ""
            cg_emit("define i32 @main() {")
            cg_emit("entry:")
            cg_emit("  call void @__ofs_init_globals()")
            push_scope()
            forge body_id = n.c2
            forge i = 0
            while (i < node_extra_len(body_id)) {
                emit_stmt(node_get_extra(body_id, i))
                i++
            }
            pop_scope()
            if (!_terminated) { cg_emit("  ret i32 0") }
            cg_emit("}")
            cg_emit("")
            _esc_disabled = true
            return
        }

        if (n.kind == NK_FN_DECL) {
            _var_names = []
            _var_types = []
            _var_ptrs = []
            _var_depths = []
            _scope_depth = 0
            _terminated = false
            _current_ret_type = "void"
            esc_analyze(id)
            _own_ptrs = []
            _free_arr_ptrs = []
            _stack_obj_ptrs = []
            _stack_obj_types = []
            _sf_ptrs = []
            _sf_kinds = []
            _selfapp_name = ""
            _fresh_val = ""
            if (n.c1 >= 0) {
                forge ret_node: Node = node_get(n.c1)
                _current_ret_type = ret_node.val
                if (ret_node.kind == NK_TYPE_ARRAY) { _current_ret_type = "Array" }
            }

            cg_emit_raw("define " + llvm_type(_current_ret_type) + " @" + n.val + "(")
            forge params_id = n.c0
            forge pi = 0
            while (pi < node_extra_len(params_id)) {
                if (pi > 0) { cg_emit_raw(", ") }
                forge param_id = node_get_extra(params_id, pi)
                forge param: Node = node_get(param_id)
                forge pt = "stone"
                if (param.c0 >= 0) {
                    forge ptn: Node = node_get(param.c0)
                    pt = ptn.val
                    if (ptn.kind == NK_TYPE_ARRAY) { pt = "Array" }
                }
                cg_emit_raw(llvm_type(pt) + " %" + param.val)
                pi++
            }
            cg_emit_raw(") {")
            cg_emit("")
            cg_emit("entry:")
            push_scope()

            pi = 0
            while (pi < node_extra_len(params_id)) {
                forge param_id2 = node_get_extra(params_id, pi)
                forge param2: Node = node_get(param_id2)
                forge pt2 = "stone"
                if (param2.c0 >= 0) {
                    forge ptn2: Node = node_get(param2.c0)
                    pt2 = ptn2.val
                    // `Array<T>` completo (como nas variaveis locais), para
                    // `p[i]` saber o tipo do elemento.
                    if (ptn2.kind == NK_TYPE_ARRAY) { pt2 = type_node_name(param2.c0) }
                }
                if (is_named_type(pt2)) {
                    declare_var(param2.val, pt2, "%" + param2.val)
                } else {
                    forge pp = "%" + param2.val + ".addr"
                    cg_emit("  " + pp + " = alloca " + llvm_type(pt2) + ", align 8")
                    cg_emit("  store " + llvm_type(pt2) + " %" + param2.val + ", ptr " + pp)
                    declare_var(param2.val, pt2, pp)
                    if (ofs_str_eq(pt2, "obsidian") && esc_str_ok(param2.val)) {
                        cg_emit("  " + pp + "_own = alloca i64, align 8")
                        cg_emit("  store i64 0, ptr " + pp + "_own")
                        ofs_array_push(_own_ptrs, pp)
                        if ((esc_bits_of(param2.val) & 2) == 0) { register_scope_free(pp, 1) }
                    }
                }
                pi++
            }

            forge fbody = n.c2
            forge si = 0
            while (si < node_extra_len(fbody)) {
                emit_stmt(node_get_extra(fbody, si))
                si++
            }
            pop_scope()
            if (!_terminated) {
                if (ofs_str_eq(_current_ret_type, "void")) {
                    cg_emit("  ret void")
                } else {
                    cg_emit("  ret " + llvm_type(_current_ret_type) + " 0")
                }
            }
            cg_emit("}")
            cg_emit("")
            _esc_disabled = true
        }
    }

    vein generate(root_id: stone) -> void {
        _tmp_counter = 0
        _label_counter = 0
        _str_counter = 0
        _mono_names = []
        _field_owners = []
        _field_names = []
        _field_types = []
        _field_indices = []
        _variant_names = []
        _variant_tags = []
        _strata_names = []
        _global_names = []
        _global_types = []
        _global_inits = []
        _break_labels = []
        _continue_labels = []
        _loop_saves = []
        _visited_nodes = []
        _string_vals = []
        _string_names = []
        _extern_names = []
        _va_names = []
        _va_sigs = []
        _bind_names = []
        _bind_targets = []
        collect_types(root_id)
        collect_all_strings()
        collect_globals(root_id)
        emit_header(root_id)
        _init_internal = false
        if (is_defined_fn(root_id, "ofs_alloc") && !module_has_main(root_id)) { _init_internal = true }
        emit_global_init()
        esc_compute_masks(root_id)

        forge i = 0
        while (i < node_extra_len(root_id)) {
            forge decl_id = node_get_extra(root_id, i)
            forge n: Node = node_get(decl_id)
            if (n.kind == NK_CORE_DECL || n.kind == NK_FN_DECL) {
                emit_function(decl_id)
            } else if (n.kind == NK_NAMESPACE || n.kind == NK_IMPL) {
                forge j = 0
                while (j < node_extra_len(decl_id)) {
                    forge member_id = node_get_extra(decl_id, j)
                    forge m: Node = node_get(member_id)
                    if (m.kind == NK_CORE_DECL || m.kind == NK_FN_DECL) {
                        emit_function(member_id)
                    }
                    j++
                }
            }
            i++
        }
    }
}
