// OFS Compiler — Type Checker
// Symbol table, scope management, and type validation

attach {F:symbols.ofs}
attach {F:ast.ofs}

namespace typeck {
    // ── Scope Stack ──────────────────────────────────────────────────
    
    forge _symbols: Array<Symbol> = []
    forge _symbol_depths: Array<stone> = []
    forge _scope_depth: stone = 0
    forge _field_owners: Array<obsidian> = []
    forge _field_names: Array<obsidian> = []
    forge _field_types: Array<obsidian> = []
    forge _anchor_depth: stone = 0
    forge _semantic_errors: stone = 0
    forge _check_visits: stone = 0
    
    vein push_scope() -> void {
        _scope_depth++
    }
    
    vein pop_scope() -> void {
        forge len = ofs_array_len(_symbols)
        while (len > 0) {
            forge depth = ofs_array_get(_symbol_depths, len - 1)
            if (depth < _scope_depth) {
                break
            }
            ofs_array_pop(_symbols)
            ofs_array_pop(_symbol_depths)
            len = ofs_array_len(_symbols)
        }
        if (_scope_depth > 0) {
            _scope_depth--
        }
    }
    
    vein declare(sym: Symbol) -> void {
        ofs_array_push(_symbols, sym)
        ofs_array_push(_symbol_depths, _scope_depth)
    }
    
    vein resolve(name: obsidian) -> Symbol {
        forge i = ofs_array_len(_symbols) - 1

        while (i >= 0) {
            forge sym: Symbol = ofs_array_get(_symbols, i)
            if (ofs_str_eq(sym.name, name)) {
                return sym
            }
            i--
        }
        
        forge dummy: Symbol
        dummy.name = ""
        dummy.type_str = "unknown"
        dummy.kind = SYM_UNKNOWN
        return dummy
    }

    vein type_node_name(id: stone) -> obsidian {
        if (id < 0) { return "void" }
        forge t: Node = node_get(id)
        if (t.kind == NK_TYPE_ARRAY) {
            forge inner = "stone"
            if (t.c0 >= 0) {
                forge tn: Node = node_get(t.c0)
                inner = tn.val
            }
            return "Array<" + inner + ">"
        }
        return t.val
    }

    vein register_field(owner: obsidian, name: obsidian, type_str: obsidian) -> void {
        ofs_array_push(_field_owners, owner)
        ofs_array_push(_field_names, name)
        ofs_array_push(_field_types, type_str)
    }

    vein field_type(owner: obsidian, name: obsidian) -> obsidian {
        forge i = ofs_array_len(_field_names) - 1
        while (i >= 0) {
            forge f_owner: obsidian = ofs_array_get(_field_owners, i)
            forge f_name: obsidian = ofs_array_get(_field_names, i)
            if (ofs_str_eq(f_owner, owner) && ofs_str_eq(f_name, name)) {
                return ofs_array_get(_field_types, i)
            }
            i--
        }
        return "unknown"
    }
    
    // ── Type Checking Core ───────────────────────────────────────────
    
    vein check_type_string(type_str: obsidian) -> bool {
        if (ofs_str_len(type_str) > 0 && ofs_str_char_at(type_str, 0) == 42) { return true }
        if (ofs_str_eq(type_str, "stone")) { return true }
        if (ofs_str_eq(type_str, "crystal")) { return true }
        if (ofs_str_eq(type_str, "obsidian")) { return true }
        if (ofs_str_eq(type_str, "bool")) { return true }
        if (ofs_str_eq(type_str, "void")) { return true }
        if (ofs_str_eq(type_str, "Array")) { return true }
        if (ofs_str_eq(type_str, "u8")) { return true }
        if (ofs_str_eq(type_str, "u16")) { return true }
        if (ofs_str_eq(type_str, "u32")) { return true }
        if (ofs_str_eq(type_str, "u64")) { return true }
        if (ofs_str_eq(type_str, "i8")) { return true }
        if (ofs_str_eq(type_str, "i32")) { return true }
        return false
    }

    vein is_int_type(t: obsidian) -> bool {
        if (ofs_str_eq(t, "stone") || ofs_str_eq(t, "u8") || ofs_str_eq(t, "u16") ||
            ofs_str_eq(t, "u32") || ofs_str_eq(t, "u64") || ofs_str_eq(t, "i8") || ofs_str_eq(t, "i32")) {
            return true
        }
        return false
    }

    vein is_variant_name(name: obsidian) -> bool {
        // variant names are PascalCase (UpperCamel): start uppercase, contain a
        // lowercase letter, and have no underscores (excludes CONST_STYLE idents)
        if (ofs_str_len(name) < 2) { return false }
        forge c0 = ofs_str_char_at(name, 0)
        if (c0 < 65 || c0 > 90) { return false }
        forge has_lower = false
        forge i = 1
        while (i < ofs_str_len(name)) {
            forge c = ofs_str_char_at(name, i)
            if (c == 95) { return false }
            if (c >= 97 && c <= 122) { has_lower = true }
            i++
        }
        return has_lower
    }

    vein check_type_compat(from: obsidian, to: obsidian) -> bool {
        if (ofs_str_eq(from, to)) { return true }
        if (is_int_type(from) && is_int_type(to)) { return true }
        if (ofs_str_len(from) > 0 && ofs_str_char_at(from, 0) == 42 &&
            ofs_str_len(to) > 0 && ofs_str_char_at(to, 0) == 42) {
            return true
        }
        return false
    }

    vein report_anchor_control(n: Node, control: obsidian) -> void {
        _semantic_errors++
        echo("[fault E0042] " + ofs_stone_to_obsidian(n.line) + ":" + ofs_stone_to_obsidian(n.col) +
            ": '" + control + "' is not allowed inside anchor")
    }
    
    vein check_node(id: stone) -> obsidian {
        if (id < 0) { return "void" }

        _check_visits++
        if (_check_visits > node_pool_len() * 4 + 256) {
            _semantic_errors++
            echo("[fault E9001] typechecker traversal limit exceeded at node " + ofs_stone_to_obsidian(id))
            return "unknown"
        }
        if (_check_visits % 5000 == 0) {
            echo("[typeck trace] visited " + ofs_stone_to_obsidian(_check_visits) + " nodes")
        }
        
        forge n: Node = node_get(id)
        
        if (n.kind == NK_LIT_INT) {
            node_set_type(id, "stone")
            return "stone"
        }
        
        if (n.kind == NK_LIT_FLOAT) {
            node_set_type(id, "crystal")
            return "crystal"
        }
        
        if (n.kind == NK_LIT_STRING) {
            node_set_type(id, "obsidian")
            return "obsidian"
        }
        
        if (n.kind == NK_LIT_BOOL) {
            node_set_type(id, "bool")
            return "bool"
        }
        
        if (n.kind == NK_LIT_NULL) {
            node_set_type(id, "null")
            return "null"
        }
        
        if (n.kind == NK_IDENT) {
            if (is_variant_name(n.val)) {
                node_set_type(id, "variant")
                return "variant"
            }
            forge sym: Symbol = resolve(n.val)
            if (ofs_str_eq(sym.name, "")) {
                echo("[AVISO SEMANTICO " + ofs_stone_to_obsidian(n.line) + ":" + ofs_stone_to_obsidian(n.col) + "]: identificador desconhecido '" + n.val + "'")
                echo("  dica: declare a variavel com 'forge' ou importe o modulo com 'attach'.")
                return "unknown"
            }
            node_set_type(id, sym.type_str)
            return sym.type_str
        }
        
        if (n.kind == NK_BIN_OP) {
            forge left_type = check_node(n.c0)
            forge right_type = check_node(n.c1)
            
            if (ofs_str_eq(n.val, "+") || ofs_str_eq(n.val, "-") ||
                ofs_str_eq(n.val, "*") || ofs_str_eq(n.val, "/") ||
                ofs_str_eq(n.val, "%") || ofs_str_eq(n.val, "&") ||
                ofs_str_eq(n.val, "|") || ofs_str_eq(n.val, "^") ||
                ofs_str_eq(n.val, "<<") || ofs_str_eq(n.val, ">>")) {
                if (ofs_str_eq(n.val, "+") && (ofs_str_eq(left_type, "obsidian") || ofs_str_eq(right_type, "obsidian"))) {
                    node_set_type(id, "obsidian")
                    return "obsidian"
                }
                if (!check_type_compat(left_type, right_type)) {
                    echo("[AVISO DE TIPO " + ofs_stone_to_obsidian(n.line) + ":" + ofs_stone_to_obsidian(n.col) + "]: tipos incompativeis na operacao '" + n.val + "' (" + left_type + " vs " + right_type + ")")
                }
                node_set_type(id, left_type)
                return left_type
            }
            
            if (ofs_str_eq(n.val, "==") || ofs_str_eq(n.val, "!=") ||
                ofs_str_eq(n.val, "<") || ofs_str_eq(n.val, "<=") ||
                ofs_str_eq(n.val, ">") || ofs_str_eq(n.val, ">=")) {
                node_set_type(id, "bool")
                return "bool"
            }
            
            if (ofs_str_eq(n.val, "&&") || ofs_str_eq(n.val, "||")) {
                node_set_type(id, "bool")
                return "bool"
            }
            
            node_set_type(id, left_type)
            return left_type
        }

        if (n.kind == NK_FIELD) {
            forge base_type = check_node(n.c0)
            forge ft = field_type(base_type, n.val)
            node_set_type(id, ft)
            return ft
        }

        if (n.kind == NK_INDEX) {
            check_node(n.c0)
            check_node(n.c1)
            node_set_type(id, "stone")
            return "stone"
        }

        if (n.kind == NK_ASSIGN) {
            forge target_type = check_node(n.c0)
            check_node(n.c1)
            node_set_type(id, target_type)
            return target_type
        }

        if (n.kind == NK_POST_OP) {
            forge operand_type = check_node(n.c0)
            if (ofs_str_eq(n.val, "?")) {
                node_set_type(id, operand_type)
                return operand_type
            }
            node_set_type(id, operand_type)
            return operand_type
        }
        
        if (n.kind == NK_CAST) {
            check_node(n.c0)
            forge target_type = n.val
            node_set_type(id, target_type)
            return target_type
        }

        if (n.kind == NK_UNARY_OP) {
            forge operand_type = check_node(n.c0)
            if (ofs_str_eq(n.val, "&")) {
                forge ptr_t = "*" + operand_type
                node_set_type(id, ptr_t)
                return ptr_t
            }
            if (ofs_str_eq(n.val, "*")) {
                forge deref_t = "stone"
                if (ofs_str_len(operand_type) > 1 && ofs_str_char_at(operand_type, 0) == 42) {
                    deref_t = ofs_str_substr(operand_type, 1, ofs_str_len(operand_type) - 1)
                }
                node_set_type(id, deref_t)
                return deref_t
            }
            node_set_type(id, operand_type)
            return operand_type
        }
        
        if (n.kind == NK_CALL) {
            forge i = 0
            forge argc = node_extra_len(id)
            while (i < argc) {
                forge arg_id = node_extra_at(id, i)
                check_node(arg_id)
                i++
            }
            if (ofs_str_eq(n.val, "fault_cut") || ofs_str_eq(n.val, "fault_patch") || ofs_str_eq(n.val, "fault_swap") || ofs_str_eq(n.val, "fault_count") || ofs_str_eq(n.val, "fault_lead") || ofs_str_eq(n.val, "fault_trail")) {
                node_set_type(id, "stone")
                return "stone"
            }
            if (ofs_str_eq(n.val, "fault_fence") || ofs_str_eq(n.val, "fault_prefetch") || ofs_str_eq(n.val, "fault_trap")) {
                node_set_type(id, "void")
                return "void"
            }
            if (ofs_str_eq(n.val, "fault_step")) {
                forge st_t = check_node(node_get_extra(id, 0))
                node_set_type(id, st_t)
                return st_t
            }
            forge fn_sym: Symbol = resolve(n.val)
            if (!ofs_str_eq(fn_sym.name, "")) {
                node_set_type(id, fn_sym.type_str)
                return fn_sym.type_str
            }
            node_set_type(id, "unknown")
            return "unknown"
        }
        
        if (n.kind == NK_VAR_DECL || n.kind == NK_CONST_DECL) {
            // Get type from annotation
            forge type_node_id = n.c0
            forge init_id = n.c1
            forge type_str = "unknown"
            
            if (type_node_id >= 0) {
                type_str = type_node_name(type_node_id)
                if (init_id >= 0) {
                    check_node(init_id)
                }
            } else if (init_id >= 0) {
                // Infer from initializer
                type_str = check_node(init_id)
            }
            
            // Declare symbol
            forge sym: Symbol
            sym.name = n.val
            sym.type_str = type_str
            sym.kind = SYM_VAR
            if (n.kind == NK_CONST_DECL) {
                sym.kind = SYM_CONST
            }
            declare(sym)
            
            node_set_type(id, type_str)
            return type_str
        }
        
        if (n.kind == NK_RETURN) {
            if (_anchor_depth > 0) { report_anchor_control(n, "return") }
            if (n.c0 >= 0) {
                return check_node(n.c0)
            }
            return "void"
        }

        if (n.kind == NK_BREAK || n.kind == NK_CONTINUE) {
            if (_anchor_depth > 0) {
                if (n.kind == NK_BREAK) { report_anchor_control(n, "shatter") }
                else { report_anchor_control(n, "erode") }
            }
            return "void"
        }

        if (n.kind == NK_THROW) {
            if (_anchor_depth > 0) { report_anchor_control(n, "throw") }
            if (n.c0 >= 0) { check_node(n.c0) }
            return "void"
        }

        if (n.kind == NK_ANCHOR) {
            _anchor_depth++
            if (n.c0 >= 0) { check_node(n.c0) }
            _anchor_depth--
            return "void"
        }

        if (n.kind == NK_MATCH) {
            if (n.c0 >= 0) { check_node(n.c0) }
            forge i = 0
            forge casec = node_extra_len(id)
            while (i < casec) {
                forge case_id = node_extra_at(id, i)
                check_node(case_id)
                i++
            }
            return "void"
        }

        if (n.kind == NK_CASE) {
            if (n.c0 >= 0) { check_node(n.c0) }
            if (n.c1 >= 0) { check_node(n.c1) }
            return "void"
        }

        if (n.kind == NK_DEFAULT) {
            if (n.c0 >= 0) { check_node(n.c0) }
            return "void"
        }
        
        if (n.kind == NK_IF) {
            check_node(n.c0)  // condition
            push_scope()
            check_node(n.c1)  // then block
            pop_scope()
            if (n.c2 >= 0) {
                push_scope()
                check_node(n.c2)  // else block
                pop_scope()
            }
            return "void"
        }
        
        if (n.kind == NK_WHILE) {
            check_node(n.c0)  // condition
            push_scope()
            check_node(n.c1)  // body
            pop_scope()
            return "void"
        }

        if (n.kind == NK_CYCLE_C) {
            push_scope()
            if (n.c0 >= 0) { check_node(n.c0) }
            if (n.c1 >= 0) { check_node(n.c1) }
            if (n.c3 >= 0) { check_node(n.c3) }
            if (n.c2 >= 0) { check_node(n.c2) }
            pop_scope()
            return "void"
        }

        if (n.kind == NK_CYCLE_RANGE) {
            forge arr_t = check_node(n.c0)
            push_scope()
            forge rsym: Symbol
            rsym.name = n.val
            rsym.type_str = "stone"
            if (ofs_str_eq(arr_t, "Array<obsidian>") || ofs_str_eq(arr_t, "obsidian")) {
                rsym.type_str = "obsidian"
            }
            rsym.kind = SYM_VAR
            declare(rsym)
            node_set_type(id, rsym.type_str)
            check_node(n.c1)
            pop_scope()
            return "void"
        }
        
        if (n.kind == NK_BLOCK) {
            forge i = 0
            forge stmtc = node_extra_len(id)
            while (i < stmtc) {
                forge stmt_id = node_extra_at(id, i)
                check_node(stmt_id)
                i++
            }
            return "void"
        }

        if (n.kind == NK_TREMOR) {
            push_scope()
            if (n.c0 >= 0) { check_node(n.c0) }
            pop_scope()

            if (n.c2 >= 0) {
                push_scope()
                if (n.c1 >= 0) {
                    forge cident: Node = node_get(n.c1)
                    forge csym: Symbol
                    csym.name = cident.val
                    csym.type_str = "obsidian"
                    csym.kind = SYM_VAR
                    declare(csym)
                }
                check_node(n.c2)
                pop_scope()
            }
            return "void"
        }
        
        if (n.kind == NK_FN_DECL || n.kind == NK_CORE_DECL) {
            push_scope()
            
            // Check parameters
            forge params_id = n.c0
            if (params_id >= 0) {
                forge i = 0
                forge paramc = node_extra_len(params_id)
                while (i < paramc) {
                    forge param_id = node_extra_at(params_id, i)
                    forge param_type_id = node_child(param_id, 0)
                    forge param_type_str = "unknown"
                    if (param_type_id >= 0) {
                        param_type_str = type_node_name(param_type_id)
                    }
                    forge sym: Symbol
                    sym.name = node_val_of(param_id)
                    sym.type_str = param_type_str
                    sym.kind = SYM_PARAM
                    declare(sym)
                    i++
                }
            }
            
            // Check body
            forge body_id = n.c2
            if (body_id >= 0) {
                check_node(body_id)
            }
            
            pop_scope()
            return "void"
        }

        if (n.kind == NK_MONOLITH) {
            forge type_sym: Symbol
            type_sym.name = n.val
            type_sym.type_str = n.val
            type_sym.kind = SYM_MONOLITH
            declare(type_sym)

            forge i = 0
            forge fieldc = node_extra_len(id)
            while (i < fieldc) {
                forge field_id = node_extra_at(id, i)
                forge field_type_id = node_child(field_id, 0)
                if (field_type_id >= 0) {
                    forge field_type_str = type_node_name(field_type_id)
                    register_field(n.val, node_val_of(field_id), field_type_str)
                    if (!check_type_string(field_type_str)) {
                        echo("[typeck warn] unknown field type '" + field_type_str + "' in monolith " + n.val)
                    }
                }
                i++
            }
            return "void"
        }

        if (n.kind == NK_IMPL) {
            forge i = 0
            forge mc = node_extra_len(id)
            while (i < mc) {
                forge method_id = node_extra_at(id, i)
                check_node(method_id)
                i++
            }
            return "void"
        }

        if (n.kind == NK_NAMESPACE) {
            push_scope()
            forge i = 0
            forge mc = node_extra_len(id)
            while (i < mc) {
                forge member_id = node_extra_at(id, i)
                check_node(member_id)
                i++
            }
            pop_scope()
            return "void"
        }

        if (n.kind == NK_STRATA) {
            forge type_sym: Symbol
            type_sym.name = n.val
            type_sym.type_str = n.val
            type_sym.kind = SYM_MONOLITH
            declare(type_sym)
            return "void"
        }

        if (n.kind == NK_ATTACH) {
            return "void"
        }
        
        if (n.kind == NK_PROGRAM) {
            // predeclare top-level functions for call resolution
            forge d = 0
            forge dcount = node_extra_len(id)
            while (d < dcount) {
                forge decl_id = node_extra_at(id, d)
                forge decl_kind = node_kind_of(decl_id)
                if (decl_kind == NK_FN_DECL || decl_kind == NK_CORE_DECL) {
                    forge fn_sym: Symbol
                    fn_sym.name = node_val_of(decl_id)
                    fn_sym.type_str = "unknown"
                    forge decl_c1 = node_child(decl_id, 1)
                    if (decl_c1 >= 0) {
                        fn_sym.type_str = type_node_name(decl_c1)
                    }
                    fn_sym.kind = SYM_FN
                    declare(fn_sym)
                } else if (decl_kind == NK_EXTERN_VN || decl_kind == NK_RIFT_VN) {
                    forge ext_sym: Symbol
                    ext_sym.name = node_val_of(decl_id)
                    ext_sym.type_str = "unknown"
                    forge decl_c1e = node_child(decl_id, 1)
                    if (decl_c1e >= 0) {
                        ext_sym.type_str = type_node_name(decl_c1e)
                    }
                    ext_sym.kind = SYM_FN
                    declare(ext_sym)
                } else if (decl_kind == NK_NAMESPACE || decl_kind == NK_IMPL) {
                    forge j = 0
                    forge mcount = node_extra_len(decl_id)
                    while (j < mcount) {
                        forge member_id = node_extra_at(decl_id, j)
                        forge member_kind = node_kind_of(member_id)
                        if (member_kind == NK_FN_DECL || member_kind == NK_CORE_DECL || member_kind == NK_EXTERN_VN || member_kind == NK_RIFT_VN) {
                            forge member_sym: Symbol
                            member_sym.name = node_val_of(member_id)
                            member_sym.type_str = "unknown"
                            forge mc1 = node_child(member_id, 1)
                            if (mc1 >= 0) {
                                member_sym.type_str = type_node_name(mc1)
                            }
                            member_sym.kind = SYM_FN
                            declare(member_sym)
                        }
                        j++
                    }
                }
                d++
            }

            forge i = 0
            forge body_c = node_extra_len(id)
            while (i < body_c) {
                forge decl_id = node_extra_at(id, i)
                check_node(decl_id)
                i++
            }
            return "void"
        }
        
        return "unknown"
    }
    
    vein check(root_id: stone) -> void {
        _anchor_depth = 0
        _semantic_errors = 0
        _check_visits = 0
        push_scope()
        check_node(root_id)
        pop_scope()
    }

    vein has_errors() -> bool {
        return _semantic_errors > 0
    }
}
