// OFS Compiler — Parser
// Recursive descent parser with error recovery

attach {F:tokens.ofs}
attach {F:nodes.ofs}
attach {F:ast.ofs}

namespace parser {
    // ── Parser State ────────────────────────────────────────────────────
    
    forge _tokens: Array<Token> = []
    forge _pos: stone = 0
    forge _len: stone = 0
    forge _error_count: stone = 0
    
    // ── Token Navigation ────────────────────────────────────────────────
    
    vein _cur() -> Token {
        if (_pos >= _len) {
            forge dummy: Token
            dummy.kind = TOK_EOF
            dummy.val = ""
            dummy.line = 0
            dummy.col = 0
            return dummy
        }
        return ofs_array_get(_tokens, _pos)
    }
    
    vein _cur_kind() -> stone {
        forge t: Token = _cur()
        return t.kind
    }
    
    vein _cur_val() -> obsidian {
        forge t: Token = _cur()
        return t.val
    }
    
    vein _advance() -> Token {
        forge t = _cur()
        _pos++
        return t
    }
    
    vein _peek_kind() -> stone {
        if (_pos + 1 >= _len) { return TOK_EOF }
        forge t: Token = ofs_array_get(_tokens, _pos + 1)
        return t.kind
    }

    vein _peek2_kind() -> stone {
        if (_pos + 2 >= _len) { return TOK_EOF }
        forge t: Token = ofs_array_get(_tokens, _pos + 2)
        return t.kind
    }
    
    // ── Blocos de baixo nivel (F4) ─────────────────────────────────────
    // `fracture`/`bedrock`/`abyss`/`tectonic [X]` antes de `{` ou de `vein`.
    // O bloco vira um NK_BLOCK com o nome do bloco no `val` ("" = bloco
    // comum); o llvmgen e o interpretador executam igual a um bloco comum,
    // o typeck usa o nome para liberar as operacoes de baixo nivel.

    vein _is_fault_kw(k: stone) -> bool {
        return k == TOK_FRACTURE || k == TOK_BEDROCK || k == TOK_ABYSS || k == TOK_TECTONIC
    }

    vein _fault_kw_name(k: stone) -> obsidian {
        if (k == TOK_FRACTURE) { return "fracture" }
        if (k == TOK_BEDROCK) { return "bedrock" }
        if (k == TOK_ABYSS) { return "abyss" }
        return "tectonic"
    }

    // consome `X` ou `tectonic X`/`X Y` e devolve o nome que vale: `abyss`
    // se aparecer, senao o primeiro que nao for `tectonic`
    vein _parse_fault_prefix() -> obsidian {
        forge first = _fault_kw_name(_cur_kind())
        _advance()
        forge name = first
        if (_cur_kind() == TOK_FRACTURE || _cur_kind() == TOK_BEDROCK || _cur_kind() == TOK_ABYSS) {
            forge second = _fault_kw_name(_cur_kind())
            _advance()
            if (ofs_str_eq(second, "abyss") || ofs_str_eq(first, "tectonic")) { name = second }
        }
        return name
    }

    vein _mark_fault_block(block_id: stone, fk: obsidian) -> void {
        if (block_id < 0) { return }
        forge b: Node = node_get(block_id)
        if (b.kind != NK_BLOCK) { return }
        b.val = fk
        node_set(block_id, b)
    }

    // `fracture vein f(...)` / `abyss vein f(...)` (ou `tectonic abyss vein`)
    vein _is_fault_vein_start() -> bool {
        if (!_is_fault_kw(_cur_kind())) { return false }
        forge k1 = _peek_kind()
        if (k1 == TOK_VEIN || k1 == TOK_CORE) { return true }
        if (_is_fault_kw(k1)) {
            forge k2 = _peek2_kind()
            return k2 == TOK_VEIN || k2 == TOK_CORE
        }
        return false
    }

    vein _expect(kind: stone) -> bool {
        if (_cur_kind() != kind) { return false }
        _advance()
        return true
    }
    
    // ── Error Handling ──────────────────────────────────────────────────
    
    vein error_count() -> stone {
        return _error_count
    }

    vein _error(msg: obsidian) -> void {
        _error_count = _error_count + 1
        forge t = _cur()
        // arquivo:linha:coluna de verdade (tambem dentro de um `attach`),
        // pelo mapa de linhas do fonte expandido
        echo("[ERRO SINTATICO " + ast_src_loc(t.line, t.col) + "]: " + msg)
        echo("  --> token encontrado: '" + t.val + "'")
        echo("  dica: confira delimitadores ({}, (), []), pontuacao ou palavras reservadas.")
    }
    
    // Erro de "esperava um nome": se o token e palavra reservada (ex.:
    // `forge anchor = 1`), diz isso em vez de so "expected identifier".
    vein _error_name(msg: obsidian) -> void {
        forge t = _cur()
        forge kw = keyword_to_kind(t.val)
        if (kw != TOK_IDENT) {
            _error("`" + t.val + "` e palavra reservada e nao pode ser usada como nome (" + msg + "); renomeie")
            return
        }
        _error(msg)
    }

    vein _sync() -> void {
        // advance to next statement boundary
        while (_cur_kind() != TOK_SEMI &&
               _cur_kind() != TOK_RBRACE &&
               _cur_kind() != TOK_EOF) {
            _advance()
        }
        if (_cur_kind() == TOK_SEMI) { _advance() }
    }
    
    // ── Operator Precedence ────────────────────────────────────────────
    
    vein _get_prec(kind: stone) -> stone {
        // lowest to highest
        if (kind == TOK_EQ)  { return 10 }   // assignment
        if (kind == TOK_PLUS_ASSIGN || kind == TOK_MINUS_ASSIGN ||
            kind == TOK_STAR_ASSIGN || kind == TOK_SLASH_ASSIGN) { return 10 }
        if (kind == TOK_OROR)   { return 20 }
        if (kind == TOK_ANDAND) { return 30 }
        if (kind == TOK_EQEQ || kind == TOK_NEQ) { return 40 }
        if (kind == TOK_LT || kind == TOK_LTE ||
            kind == TOK_GT || kind == TOK_GTE) { return 50 }
        if (kind == TOK_PIPE)  { return 60 }
        if (kind == TOK_CARET) { return 70 }
        if (kind == TOK_AMP)   { return 80 }
        if (kind == TOK_LSHIFT || kind == TOK_RSHIFT) { return 90 }
        if (kind == TOK_PLUS || kind == TOK_MINUS) { return 100 }
        if (kind == TOK_STAR || kind == TOK_SLASH || kind == TOK_PERCENT) { return 110 }
        return 0
    }
    
    // ── Expression Parsing (Pratt) ──────────────────────────────────────
    
    
    vein parse_primary() -> stone {
        forge t = _cur()
        
        // Literals
        if (t.kind == TOK_INT) {
            _advance()
            return node_new(NK_LIT_INT, t.val, t.line, t.col)
        }
        if (t.kind == TOK_FLOAT) {
            _advance()
            return node_new(NK_LIT_FLOAT, t.val, t.line, t.col)
        }
        if (t.kind == TOK_STRING) {
            _advance()
            return node_new(NK_LIT_STRING, t.val, t.line, t.col)
        }
        if (t.kind == TOK_TRUE) {
            _advance()
            return node_new(NK_LIT_BOOL, "true", t.line, t.col)
        }
        if (t.kind == TOK_FALSE) {
            _advance()
            return node_new(NK_LIT_BOOL, "false", t.line, t.col)
        }
        if (t.kind == TOK_NULL) {
            _advance()
            return node_new(NK_LIT_NULL, "", t.line, t.col)
        }
        
        // Unary prefix operators
        if (t.kind == TOK_MINUS || t.kind == TOK_BANG ||
            t.kind == TOK_TILDE || t.kind == TOK_AMP ||
            t.kind == TOK_STAR) {
            _advance()
            forge op = t.val
            // O operando inclui os pos-fixos (chamada, campo, indice, cast):
            // `!ns.fn(x)` e `!(ns.fn(x))`, nao `(!ns).fn(x)`.
            forge operand = parse_postfix(parse_primary())
            forge n = node_new(NK_UNARY_OP, op, t.line, t.col)
            node_set_child(n, 0, operand)
            return n
        }
        
        // Parenthesized expression
        if (t.kind == TOK_LPAREN) {
            _advance()
            forge expr = parse_expr(0)
            if (!_expect(TOK_RPAREN)) {
                _error("expected ')'")
            }
            return expr
        }

        
        // Array literal [...]
        if (t.kind == TOK_LBRACKET) {
            _advance()
            forge n = node_new(NK_ARRAY_LIT, "", t.line, t.col)
            while (_cur_kind() != TOK_RBRACKET && _cur_kind() != TOK_EOF) {
                forge elem = parse_expr(0)
                node_add_extra(n, elem)
                if (_cur_kind() == TOK_COMMA) {
                    _advance()
                }
            }
            if (!_expect(TOK_RBRACKET)) {
                _error("expected ']'")
            }
            return n
        }

        // echo(...) is tokenized as a keyword, but lowers like a regular call.
        if (t.kind == TOK_ECHO) {
            _advance()
            if (_cur_kind() == TOK_LPAREN) {
                _advance()
                forge call = node_new(NK_CALL, "echo", t.line, t.col)
                while (_cur_kind() != TOK_RPAREN && _cur_kind() != TOK_EOF) {
                    forge arg = parse_expr(0)
                    node_add_extra(call, arg)
                    if (_cur_kind() == TOK_COMMA) {
                        _advance()
                    }
                }
                if (!_expect(TOK_RPAREN)) {
                    _error("expected ')'")
                }
                return call
            }
            _error("expected '(' after echo")
            return node_new(NK_IDENT, "echo", t.line, t.col)
        }
        
        // geode (closure): `geode (x: T, ...) -> R { corpo }`
        if (t.kind == TOK_IDENT && ofs_str_eq(t.val, "geode") && _is_geode_start()) {
            return parse_geode()
        }

        // Identifier (might be function call)
        if (t.kind == TOK_IDENT) {
            _advance()
            forge ident = node_new(NK_IDENT, t.val, t.line, t.col)
            
            // Function call?
            if (_cur_kind() == TOK_LPAREN) {
                _advance()
                forge call = node_new(NK_CALL, t.val, t.line, t.col)
                while (_cur_kind() != TOK_RPAREN && _cur_kind() != TOK_EOF) {
                    forge arg = parse_expr(0)
                    node_add_extra(call, arg)
                    if (_cur_kind() == TOK_COMMA) {
                        _advance()
                    }
                }
                if (!_expect(TOK_RPAREN)) {
                    _error("expected ')'")
                }
                return call
            }
            
            return ident
        }
        
        if (t.kind == TOK_CORE) {
            _error("`core` e palavra reservada (marca o ponto de entrada `core main()`) e nao pode ser usada como nome")
        } else if (t.kind == TOK_QUARTZ) {
            _error("quartz e um comando (assembly inline), nao um valor: escreva 'quartz { ... } -> variavel' numa linha propria")
        } else {
            _error("expected expression")
        }
        if (t.kind != TOK_EOF) {
            _advance()
        }
        return node_new(NK_LIT_INT, "0", t.line, t.col)
    }
    
    // `geode` e palavra de contexto: so abre um geode quando vem `(`, a
    // lista fecha e depois vem `->` ou `{` (uma chamada `geode(x)` de uma
    // vein chamada geode segue valendo)
    vein _is_geode_start() -> bool {
        if (_peek_kind() != TOK_LPAREN) { return false }
        forge depth = 0
        forge i = _pos + 1
        while (i < _len) {
            forge tk: Token = ofs_array_get(_tokens, i)
            if (tk.kind == TOK_LPAREN) { depth++ }
            if (tk.kind == TOK_RPAREN) {
                depth--
                if (depth == 0) {
                    if (i + 1 >= _len) { return false }
                    forge nx: Token = ofs_array_get(_tokens, i + 1)
                    return nx.kind == TOK_ARROW || nx.kind == TOK_LBRACE
                }
            }
            if (tk.kind == TOK_EOF) { return false }
            i++
        }
        return false
    }

    // NK_LAMBDA: c0 = parametros (NK_BLOCK de NK_PARAM), c1 = tipo de
    // retorno (-1 = void), c2 = corpo. O typeck acha as capturas e tira o
    // corpo para uma vein `__geode_<vein>_<k>` (ver typeck, geode).
    vein parse_geode() -> stone {
        forge t = _advance()
        forge n = node_new(NK_LAMBDA, "", t.line, t.col)
        forge params = parse_fn_params()
        forge ret_type: stone = -1
        if (_cur_kind() == TOK_ARROW) {
            _advance()
            ret_type = parse_type()
        }
        if (_cur_kind() != TOK_LBRACE) {
            _error("expected '{' (corpo do geode)")
            return n
        }
        forge body = parse_block()
        node_set_child(n, 0, params)
        node_set_child(n, 1, ret_type)
        node_set_child(n, 2, body)
        return n
    }

    vein parse_postfix(left: stone) -> stone {
        forge t = _cur()

        // Call after any postfix expression. For namespace-style calls,
        // lower ns.fn(...) to a flat symbol ns__fn(...).
        if (t.kind == TOK_LPAREN) {
            _advance()
            forge call_name = ""
            forge callee: Node = node_get(left)
            if (callee.kind == NK_IDENT) {
                call_name = callee.val
            } else if (callee.kind == NK_FIELD) {
                forge base: Node = node_get(callee.c0)
                if (base.kind == NK_IDENT) {
                    call_name = base.val + "__" + callee.val
                } else {
                    call_name = callee.val
                }
            } else {
                call_name = callee.val
            }

            forge call = node_new(NK_CALL, call_name, t.line, t.col)
            // F6: chamada de um valor que nao e nome (`a[i](x)`, `f(1)(2)`,
            // `s.a.b(x)`): a expressao vai em c0 e o typeck decide (valor de
            // vein ou, como antes, a vein/metodo pelo nome).
            if (callee.kind != NK_IDENT) {
                forge simple_field = false
                if (callee.kind == NK_FIELD) {
                    forge fbase: Node = node_get(callee.c0)
                    simple_field = fbase.kind == NK_IDENT
                }
                if (!simple_field) { node_set_child(call, 0, left) }
            }
            while (_cur_kind() != TOK_RPAREN && _cur_kind() != TOK_EOF) {
                forge arg = parse_expr(0)
                node_add_extra(call, arg)
                if (_cur_kind() == TOK_COMMA) {
                    _advance()
                }
            }
            if (!_expect(TOK_RPAREN)) {
                _error("expected ')'")
            }
            return parse_postfix(call)
        }
        
        // Array indexing
        if (t.kind == TOK_LBRACKET) {
            _advance()
            forge index = parse_expr(0)
            if (!_expect(TOK_RBRACKET)) {
                _error("expected ']'")
            }
            forge n = node_new(NK_INDEX, "", t.line, t.col)
            node_set_child(n, 0, left)
            node_set_child(n, 1, index)
            return parse_postfix(n)
        }
        
        // Field access
        if (t.kind == TOK_DOT) {
            _advance()
            if (_cur_kind() != TOK_IDENT) {
                _error_name("expected field name")
                return left
            }
            forge field_name = _cur_val()
            forge field_line = _cur().line
            forge field_col = _cur().col
            _advance()
            
            forge n = node_new(NK_FIELD, field_name, field_line, field_col)
            node_set_child(n, 0, left)
            return parse_postfix(n)
        }
        
        if (t.kind == TOK_PLUSPLUS || t.kind == TOK_MINUSMINUS || t.kind == TOK_QUESTION) {
            _advance()
            forge n = node_new(NK_POST_OP, t.val, t.line, t.col)
            node_set_child(n, 0, left)
            return parse_postfix(n)
        }

        if (t.kind == TOK_AS) {
            _advance()
            forge target_type_node = parse_type()
            forge type_n: Node = node_get(target_type_node)
            forge n = node_new(NK_CAST, type_n.val, t.line, t.col)
            node_set_child(n, 0, left)
            return parse_postfix(n)
        }
        
        return left
    }
    
    vein parse_expr(min_prec: stone) -> stone {
        forge left = parse_postfix(parse_primary())
        
        while (!(_cur_kind() == TOK_EOF ||
                 _cur_kind() == TOK_SEMI ||
                 _cur_kind() == TOK_RPAREN ||
                 _cur_kind() == TOK_RBRACKET ||
                 _cur_kind() == TOK_RBRACE ||
                 _cur_kind() == TOK_COMMA)) {
            
            forge prec = _get_prec(_cur_kind())
            if (prec == 0 || prec < min_prec) { break }

            // Operadores que tambem sao prefixos (*p, -x, &v) no inicio de uma
            // nova linha iniciam um novo comando, nao continuam a expressao:
            //   v = *p
            //   *p = 0      <- antes virava "v = *p * p = 0"
            forge opk = _cur_kind()
            if ((opk == TOK_STAR || opk == TOK_MINUS || opk == TOK_AMP) && _pos > 0) {
                forge prev_tok: Token = ofs_array_get(_tokens, _pos - 1)
                if (_cur().line > prev_tok.line) { break }
            }

            forge op = _advance()
            forge right = parse_expr(prec + 1)
            
            forge n = node_new(NK_BIN_OP, op.val, op.line, op.col)
            node_set_child(n, 0, left)
            node_set_child(n, 1, right)
            left = n
        }
        
        return left
    }
    
    vein parse_type() -> stone {
        forge t = _cur()
        if (t.kind == TOK_STAR) {
            _advance()
            forge inner = parse_type()
            forge inner_node: Node = node_get(inner)
            forge ptr_type_name = "*" + inner_node.val
            return node_new(NK_TYPE, ptr_type_name, t.line, t.col)
        }
        // F6: tipo de funcao `vein(T1, T2) -> R` (sem `-> R`: void). O
        // texto canonico, sem espacos, vai no `val` (e o type_str de toda
        // expressao desse tipo): "vein(T1,T2)->R".
        if (t.kind == TOK_VEIN) {
            _advance()
            forge fnt = node_new(NK_TYPE_FN, "", t.line, t.col)
            if (!_expect(TOK_LPAREN)) {
                _error("expected '(' after 'vein' in function type")
                return fnt
            }
            forge plist = ""
            forge pcount = 0
            while (_cur_kind() != TOK_RPAREN && _cur_kind() != TOK_EOF) {
                forge pt = parse_type()
                if (pt < 0) { break }
                node_add_extra(fnt, pt)
                if (pcount > 0) { plist = plist + "," }
                plist = plist + type_node_text(pt)
                pcount++
                if (_cur_kind() == TOK_COMMA) {
                    _advance()
                } else if (_cur_kind() != TOK_RPAREN) {
                    _error("expected ',' or ')' in function type")
                    break
                }
            }
            if (!_expect(TOK_RPAREN)) {
                _error("expected ')'")
            }
            forge fret = "void"
            if (_cur_kind() == TOK_ARROW && ofs_str_eq(_cur_val(), "->")) {
                _advance()
                forge rt = parse_type()
                node_set_child(fnt, 1, rt)
                if (rt >= 0) { fret = type_node_text(rt) }
            }
            forge fn_node: Node = node_get(fnt)
            fn_node.val = vein_type_make(plist, fret)
            node_set(fnt, fn_node)
            return fnt
        }
        if (t.kind != TOK_IDENT) {
            _error("expected type")
            return -1
        }
        
        forge type_name = t.val
        forge line = t.line
        forge col = t.col
        _advance()
        
        // Check for Array<T>
        if (ofs_str_eq(type_name, "Array") && _cur_kind() == TOK_LT) {
            _advance()
            forge elem_type = parse_type()
            if (!_expect(TOK_GT)) {
                _error("expected '>'")
            }
            forge n = node_new(NK_TYPE_ARRAY, "Array", line, col)
            node_set_child(n, 0, elem_type)
            return n
        }
        
        return node_new(NK_TYPE, type_name, line, col)
    }
    
    // ── Statement Parsing ──────────────────────────────────────────────
    
    
    // ── quartz: assembly inline (F5) ────────────────────────────────
    // quartz [intel] {
    //     "instrucao" "instrucao" ...    (cada texto vira uma linha)
    //     in "restricao" expressao       (entradas, em ordem)
    //     melt "registrador" "memory"    (o que o trecho destroi)
    // } [-> variavel ["restricao da saida", padrao "=r"]]
    // Operandos no texto: $0 = destino (se houver), depois as entradas;
    // um '$' literal e '$$' (regra do LLVM; AT&T: 'shlq $$32, %rdx').
    vein _quartz_opt(val: obsidian, line: stone, col: stone) -> stone {
        return node_new(NK_QUARTZ_OPT, val, line, col)
    }

    vein parse_quartz() -> stone {
        forge t = _advance()
        forge dialect = ""
        if (_cur_kind() == TOK_IDENT && (ofs_str_eq(_cur_val(), "intel") || ofs_str_eq(_cur_val(), "att"))) {
            if (ofs_str_eq(_cur_val(), "intel")) { dialect = "intel" }
            _advance()
        }
        if (_cur_kind() != TOK_LBRACE) {
            _error("esperava '{' depois de quartz (assembly inline: quartz { \"nop\" }); `quartz` e palavra reservada e nao pode ser usada como nome")
            return -1
        }
        _advance()
        forge n = node_new(NK_QUARTZ, "", t.line, t.col)
        forge text = ""
        forge lines = 0
        forge melts = ""
        while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
            forge k = _cur_kind()
            if (k == TOK_STRING) {
                if (lines > 0) { text = text + "\n" }
                text = text + _cur_val()
                lines++
                _advance()
            } else if (k == TOK_IN) {
                forge it = _advance()
                if (_cur_kind() != TOK_STRING) {
                    _error("'in' dentro de quartz espera a restricao entre aspas e o valor (ex.: in \"r\" x)")
                    return -1
                }
                forge cons = _cur_val()
                _advance()
                forge inp = node_new(NK_QUARTZ_IN, cons, it.line, it.col)
                node_set_child(inp, 0, parse_expr(0))
                node_add_extra(n, inp)
            } else if (k == TOK_IDENT && ofs_str_eq(_cur_val(), "melt")) {
                _advance()
                if (_cur_kind() != TOK_STRING) {
                    _error("'melt' dentro de quartz espera registradores entre aspas (ex.: melt \"rdx\" \"memory\")")
                    return -1
                }
                while (_cur_kind() == TOK_STRING) {
                    if (ofs_str_len(melts) > 0) { melts = melts + "," }
                    melts = melts + _cur_val()
                    _advance()
                    if (_cur_kind() == TOK_COMMA) { _advance() }
                }
            } else if (k == TOK_COMMA || k == TOK_SEMI) {
                _advance()
            } else {
                _error("dentro de quartz { } valem so instrucoes entre aspas, 'in \"restricao\" valor' e 'melt \"registrador\"'")
                return -1
            }
        }
        if (!_expect(TOK_RBRACE)) {
            _error("esperava '}' fechando o quartz")
            return -1
        }
        if (lines == 0) {
            _error("quartz sem instrucao: escreva ao menos um texto entre aspas (ex.: quartz { \"nop\" })")
            return -1
        }
        if (_cur_kind() == TOK_ARROW) {
            _advance()
            forge dt = _cur()
            if (dt.kind != TOK_IDENT) {
                _error("'->' depois de quartz espera o nome de uma variavel (ex.: quartz { \"rdtsc\" } -> t \"=A\")")
                return -1
            }
            _advance()
            node_set_child(n, 0, node_new(NK_IDENT, dt.val, dt.line, dt.col))
            forge out_cons = "=r"
            forge ct = _cur()
            if (ct.kind == TOK_STRING && ct.line == dt.line) {
                out_cons = ct.val
                _advance()
            }
            node_set_child(n, 1, _quartz_opt(out_cons, dt.line, dt.col))
        }
        node_set_child(n, 2, _quartz_opt(melts, t.line, t.col))
        node_set_child(n, 3, _quartz_opt(dialect, t.line, t.col))
        forge qn: Node = node_get(n)
        qn.val = text
        node_set(n, qn)
        if (_cur_kind() == TOK_SEMI) { _advance() }
        return n
    }

    vein parse_block() -> stone {
        forge line = _cur().line
        forge col = _cur().col
        
        if (!_expect(TOK_LBRACE)) {
            _error("expected '{'")
            return -1
        }
        
        forge block = node_new(NK_BLOCK, "", line, col)
        
        while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
            forge stmt = parse_stmt()
            if (stmt >= 0) {
                node_add_extra(block, stmt)
            }
        }
        
        if (!_expect(TOK_RBRACE)) {
            _error("expected '}'")
        }
        
        return block
    }
    
    vein parse_stmt() -> stone {
        forge t = _cur()
        forge line = t.line
        forge col = t.col
        
        if (_is_fault_kw(t.kind)) {
            // F4: bloco de baixo nivel = NK_BLOCK com o nome do bloco no val
            forge fk = _parse_fault_prefix()
            forge fblock = parse_block()
            _mark_fault_block(fblock, fk)
            return fblock
        }

        if (t.kind == TOK_IF) {
            _advance()
            if (!_expect(TOK_LPAREN)) { _error("expected '('")  return -1 }
            forge cond = parse_expr(0)
            if (!_expect(TOK_RPAREN)) { _error("expected ')'") return -1 }
            forge then_block = parse_block()
            forge else_block: stone = -1
            if (_cur_kind() == TOK_ELSE) {
                _advance()
                if (_cur_kind() == TOK_IF) {
                    else_block = parse_stmt()
                } else {
                    else_block = parse_block()
                }
            }
            forge n = node_new(NK_IF, "", line, col)
            node_set_child(n, 0, cond)
            node_set_child(n, 1, then_block)
            node_set_child(n, 2, else_block)
            return n
        }
        
        // while statement
        if (t.kind == TOK_WHILE) {
            _advance()
            if (!_expect(TOK_LPAREN)) { _error("expected '('") return -1 }
            forge cond = parse_expr(0)
            if (!_expect(TOK_RPAREN)) { _error("expected ')'") return -1 }
            forge body = parse_block()
            forge n = node_new(NK_WHILE, "", line, col)
            node_set_child(n, 0, cond)
            node_set_child(n, 1, body)
            return n
        }

        if (t.kind == TOK_CYCLE || t.kind == TOK_MINE) {
            _advance()
            if (!_expect(TOK_LPAREN)) { _error("expected '('") return -1 }
            if (_cur_kind() == TOK_FORGE && _peek_kind() == TOK_IDENT && _peek2_kind() == TOK_IN) {
                _advance()
            }
            if (_cur_kind() == TOK_IDENT && _peek_kind() == TOK_IN) {
                forge var_name = _cur_val()
                _advance()
                _advance()
                forge iter = parse_expr(0)
                if (!_expect(TOK_RPAREN)) { _error("expected ')'") return -1 }
                forge body = parse_block()
                forge n = node_new(NK_CYCLE_RANGE, var_name, line, col)
                node_set_child(n, 0, iter)
                node_set_child(n, 1, body)
                return n
            }
            if (t.kind == TOK_MINE) {
                _error("expected 'item in iterable' in mine")
                return -1
            }
            forge init: stone = -1
            if (_cur_kind() != TOK_SEMI) {
                init = parse_stmt()
            } else {
                _advance()
            }
            forge cond: stone = -1
            if (_cur_kind() != TOK_SEMI) {
                cond = parse_expr(0)
            }
            if (!_expect(TOK_SEMI)) { _error("expected ';' in cycle") }
            forge step: stone = -1
            if (_cur_kind() != TOK_RPAREN) {
                step = parse_expr(0)
            }
            if (!_expect(TOK_RPAREN)) { _error("expected ')'") return -1 }
            forge body = parse_block()
            forge n = node_new(NK_CYCLE_C, "", line, col)
            node_set_child(n, 0, init)
            node_set_child(n, 1, cond)
            node_set_child(n, 2, step)
            node_set_child(n, 3, body)
            return n
        }
        
        // return statement
        if (t.kind == TOK_RETURN) {
            _advance()
            forge expr: stone = -1
            if (_cur_kind() != TOK_SEMI && _cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
                expr = parse_expr(0)
            }
            if (_cur_kind() == TOK_SEMI) { _advance() }
            forge n = node_new(NK_RETURN, "", line, col)
            node_set_child(n, 0, expr)
            return n
        }
        
        if (t.kind == TOK_MATCH) {
            _advance()
            if (!_expect(TOK_LPAREN)) { _error("expected '(' after match") return -1 }
            forge expr = parse_expr(0)
            if (!_expect(TOK_RPAREN)) { _error("expected ')' after match") return -1 }
            if (!_expect(TOK_LBRACE)) { _error("expected '{' after match") return -1 }

            forge default_body: stone = -1
            forge case_count = 0
            forge condition_list: Array<stone> = []
            forge body_list: Array<stone> = []

            while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
                forge pattern_is_default = false
                forge case_value: stone = -1
                if (_cur_kind() == TOK_IDENT && ofs_str_eq(_cur_val(), "_")) {
                    pattern_is_default = true
                    _advance()
                } else {
                    case_value = parse_expr(0)
                }

                if (!_expect(TOK_ARROW)) { _error("expected '=>' in match arm") }

                forge arm_body: stone = -1
                if (_cur_kind() == TOK_LBRACE) {
                    arm_body = parse_block()
                } else {
                    arm_body = parse_stmt()
                }

                if (pattern_is_default) {
                    default_body = arm_body
                } else {
                    ofs_array_push(condition_list, node_new(NK_BIN_OP, "==", _cur().line, _cur().col))
                    forge cmp = ofs_array_get(condition_list, ofs_array_len(condition_list) - 1)
                    node_set_child(cmp, 0, expr)
                    node_set_child(cmp, 1, case_value)
                    ofs_array_push(body_list, arm_body)
                    case_count++
                }
            }

            if (!_expect(TOK_RBRACE)) { _error("expected '}' after match") }

            forge result: stone = -1
            forge i = case_count - 1
            while (i >= 0) {
                forge cmp = ofs_array_get(condition_list, i)
                forge body = ofs_array_get(body_list, i)
                forge then_block = body
                forge else_block: stone = -1
                if (i == case_count - 1 && default_body >= 0) {
                    else_block = default_body
                } else if (i + 1 < case_count) {
                    else_block = result
                }

                forge n = node_new(NK_IF, "", t.line, t.col)
                node_set_child(n, 0, cmp)
                node_set_child(n, 1, then_block)
                node_set_child(n, 2, else_block)
                result = n
                i--
            }

            if (default_body >= 0 && case_count == 0) {
                return default_body
            }
            if (case_count == 0) {
                return node_new(NK_BLOCK, "", t.line, t.col)
            }
            return result
        }

        // break
        if (t.kind == TOK_BREAK || t.kind == TOK_SHATTER) {
            _advance()
            if (_cur_kind() == TOK_SEMI) { _advance() }
            return node_new(NK_BREAK, "", line, col)
        }
        
        // continue
        if (t.kind == TOK_CONTINUE || t.kind == TOK_ERODE) {
            _advance()
            if (_cur_kind() == TOK_SEMI) { _advance() }
            return node_new(NK_CONTINUE, "", line, col)
        }

        if (t.kind == TOK_QUARTZ) {
            return parse_quartz()
        }

        if (t.kind == TOK_ANCHOR) {
            _advance()
            forge action = parse_stmt()
            forge n = node_new(NK_ANCHOR, "", line, col)
            node_set_child(n, 0, action)
            return n
        }
        
        // throw
        if (t.kind == TOK_THROW) {
            _advance()
            forge expr = parse_expr(0)
            if (_cur_kind() == TOK_SEMI) { _advance() }
            forge n = node_new(NK_THROW, "", line, col)
            node_set_child(n, 0, expr)
            return n
        }

        // tremor { ... } catch (e: obsidian) { ... }
        if (t.kind == TOK_TREMOR) {
            _advance()
            forge body = parse_block()

            forge catch_ident: stone = -1
            forge catch_body: stone = -1
            if (_cur_kind() == TOK_CATCH) {
                _advance()
                if (!_expect(TOK_LPAREN)) { _error("expected '(' after catch") }

                if (_cur_kind() == TOK_IDENT) {
                    forge catch_name = _cur_val()
                    forge c_line = _cur().line
                    forge c_col = _cur().col
                    _advance()
                    catch_ident = node_new(NK_IDENT, catch_name, c_line, c_col)
                } else {
                    _error("expected catch variable")
                }

                if (_cur_kind() == TOK_COLON) {
                    _advance()
                    parse_type()
                }
                if (!_expect(TOK_RPAREN)) { _error("expected ')' after catch variable") }
                catch_body = parse_block()
            }

            forge tr = node_new(NK_TREMOR, "", line, col)
            node_set_child(tr, 0, body)
            node_set_child(tr, 1, catch_ident)
            node_set_child(tr, 2, catch_body)
            return tr
        }
        
        // block
        if (t.kind == TOK_LBRACE) {
            return parse_block()
        }
        
        if (t.kind == TOK_FORGE || t.kind == TOK_CONST || t.kind == TOK_SHARD) {
            forge is_const = (t.kind == TOK_CONST)
            _advance()
            
            if (_cur_kind() != TOK_IDENT) {
                _error_name("expected identifier")
                _sync()
                return -1
            }
            
            forge var_name = _cur_val()
            forge var_line = _cur().line
            forge var_tok = _cur()
            forge var_col = var_tok.col
            _advance()
            
            forge type_node: stone = -1
            if (_cur_kind() == TOK_COLON) {
                _advance()
                type_node = parse_type()
            }
            
            forge init: stone = -1
            if (_cur_kind() == TOK_EQ) {
                _advance()
                init = parse_expr(0)
            }
            
            if (_cur_kind() == TOK_SEMI) { _advance() }
            
            if (is_const) {
                forge n = node_new(NK_CONST_DECL, var_name, var_line, var_col)
                node_set_child(n, 0, type_node)
                node_set_child(n, 1, init)
                return n
            } else {
                forge n = node_new(NK_VAR_DECL, var_name, var_line, var_col)
                node_set_child(n, 0, type_node)
                node_set_child(n, 1, init)
                return n
            }
        }
        
        // Expression statement
        forge expr = parse_expr(0)
        if (_cur_kind() == TOK_SEMI) { _advance() }
        return expr
    }
    
    // ── Top-level Parsing ──────────────────────────────────────────────
    
    vein parse_fn_params() -> stone {
        forge params = node_new(NK_BLOCK, "", 0, 0)  // reuse block for param list
        
        if (_cur_kind() == TOK_LPAREN) {
            _advance()
            while (_cur_kind() != TOK_RPAREN && _cur_kind() != TOK_EOF) {
                if (_cur_kind() != TOK_IDENT) {
                    _error_name("expected parameter name")
                    break
                }
                forge param_name = _cur_val()
                forge param_line = _cur().line
                _advance()
                
                if (!_expect(TOK_COLON)) {
                    _error("expected ':' in parameter")
                    break
                }
                
                forge param_type = parse_type()
                forge param = node_new(NK_PARAM, param_name, param_line, 0)
                node_set_child(param, 0, param_type)
                // valor padrao (onda 4): `vein f(a: stone, b: stone = 3)`;
                // o typeck exige um literal e completa as chamadas
                if (_cur_kind() == TOK_EQ) {
                    _advance()
                    node_set_child(param, 1, parse_expr(0))
                }
                node_add_extra(params, param)
                
                if (_cur_kind() == TOK_COMMA) {
                    _advance()
                }
            }
            if (!_expect(TOK_RPAREN)) {
                _error("expected ')'")
            }
        }
        
        return params
    }
    
    vein parse_fn_decl() -> stone {
        // F4: `fracture vein`/`abyss vein` marca o corpo inteiro
        forge fault_kind = ""
        if (_is_fault_kw(_cur_kind())) { fault_kind = _parse_fault_prefix() }
        forge t = _cur()
        forge line = t.line
        
        _advance()  // skip 'vein' or 'core'
        
        if (_cur_kind() == TOK_CORE) {
            // `core` declara o ponto de entrada (`core main()`); como nome de
            // funcao o corpo era descartado. Erro claro e segue o parse com o
            // nome para nao gerar uma cascata de erros.
            _error("`core` e palavra reservada (marca o ponto de entrada `core main()`) e nao pode ser nome de funcao; renomeie a funcao")
        } else {
            if (_cur_kind() != TOK_IDENT) {
                _error_name("expected function name")
                return -1
            }
        }
        
        forge fn_name = _cur_val()
        _advance()
        
        forge params = parse_fn_params()
        
        forge ret_type: stone = -1
        if (_cur_kind() == TOK_ARROW) {
            _advance()
            ret_type = parse_type()
        }

        // A5.1: `bearing regra` (pre-condicao) e `settle regra` (pos-condicao),
        // quantos quiser, antes do corpo; palavras de contexto (seguem nomes
        // validos fora daqui)
        forge contracts_blk: stone = -1
        while (_cur_kind() == TOK_IDENT && (ofs_str_eq(_cur_val(), "bearing") || ofs_str_eq(_cur_val(), "settle"))) {
            forge ct = _advance()
            if (contracts_blk < 0) { contracts_blk = node_new(NK_BLOCK, "", ct.line, ct.col) }
            forge rule = parse_expr(0)
            forge cn = node_new(NK_CONTRACT, ct.val, ct.line, ct.col)
            node_set_child(cn, 0, rule)
            node_add_extra(contracts_blk, cn)
        }
        
        forge body = parse_block()
        if (!ofs_str_eq(fault_kind, "")) { _mark_fault_block(body, fault_kind) }
        
        forge kind = NK_FN_DECL
        if (t.kind == TOK_CORE) {
            kind = NK_CORE_DECL
        }
        forge n = node_new(kind, fn_name, line, t.col)
        node_set_child(n, 0, params)
        node_set_child(n, 1, ret_type)
        node_set_child(n, 2, body)
        node_set_child(n, 3, contracts_blk)
        return n
    }

    // A5.1: `mineral Nome = T grain regra [grain regra ...]` (tipo com regra;
    // `value` e o valor conferido). `mineral` so e palavra aqui, no comeco
    // de uma declaracao do nivel de cima seguida de nome e '='.
    vein _is_mineral_start() -> bool {
        if (_cur_kind() != TOK_IDENT || !ofs_str_eq(_cur_val(), "mineral")) { return false }
        return _peek_kind() == TOK_IDENT && _peek2_kind() == TOK_EQ
    }

    vein parse_mineral_decl() -> stone {
        forge t = _advance()
        forge nt = _advance()
        _advance()
        forge base = parse_type()
        forge n = node_new(NK_MINERAL, nt.val, nt.line, nt.col)
        node_set_child(n, 0, base)
        while (_cur_kind() == TOK_IDENT && ofs_str_eq(_cur_val(), "grain")) {
            forge gt = _advance()
            forge rule = parse_expr(0)
            forge gn = node_new(NK_CONTRACT, "grain", gt.line, gt.col)
            node_set_child(gn, 0, rule)
            node_add_extra(n, gn)
        }
        if (_cur_kind() == TOK_SEMI) { _advance() }
        return n
    }

    vein parse_extern_decl() -> stone {
        forge t = _cur()
        _advance()

        if (!_expect(TOK_VEIN)) {
            _error("expected 'vein' after extern")
            return -1
        }

        if (_cur_kind() != TOK_IDENT) {
            _error_name("expected extern function name")
            return -1
        }

        forge fn_name = _cur_val()
        forge fn_line = _cur().line
        forge fn_col = _cur().col
        _advance()

        forge params = parse_fn_params()

        forge ret_type: stone = -1
        if (_cur_kind() == TOK_ARROW) {
            _advance()
            ret_type = parse_type()
        }

        forge bind_sym = fn_name
        if (ofs_str_eq(_cur_val(), "bind")) {
            _advance()
            if (_cur_kind() == TOK_STRING) {
                bind_sym = _cur_val()
                _advance()
            }
        }
        if (ofs_str_eq(_cur_val(), "abi")) {
            _advance()
            if (_cur_kind() == TOK_IDENT) {
                _advance()
            }
        }

        forge node_kind = NK_EXTERN_VN
        if (t.kind == TOK_RIFT) {
            node_kind = NK_RIFT_VN
        }
        forge n = node_new(node_kind, fn_name, fn_line, fn_col)
        node_set_type(n, bind_sym)
        node_set_child(n, 0, params)
        node_set_child(n, 1, ret_type)
        return n
    }

    vein parse_monolith_decl() -> stone {
        forge t = _cur()
        _advance()

        if (_cur_kind() != TOK_IDENT) {
            _error_name("expected monolith name")
            return -1
        }

        forge type_name = _cur_val()
        forge type_line = _cur().line
        forge type_col = _cur().col
        _advance()

        if (!_expect(TOK_LBRACE)) {
            _error("expected '{' after monolith name")
            return -1
        }

        forge mono = node_new(NK_MONOLITH, type_name, type_line, type_col)
        while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
            if (_cur_kind() != TOK_IDENT) {
                _error_name("expected field name")
                _advance()
                continue
            }

            forge field_name = _cur_val()
            forge field_line = _cur().line
            forge field_col = _cur().col
            _advance()

            if (!_expect(TOK_COLON)) {
                _error("expected ':' in field declaration")
                continue
            }

            forge field_type = parse_type()
            forge field = node_new(NK_FIELD_DECL, field_name, field_line, field_col)
            node_set_child(field, 0, field_type)
            node_add_extra(mono, field)

            if (_cur_kind() == TOK_SEMI || _cur_kind() == TOK_COMMA) {
                _advance()
            }
        }

        if (!_expect(TOK_RBRACE)) {
            _error("expected '}' in monolith")
        }

        return mono
    }

    vein parse_impl_decl() -> stone {
        forge t = _cur()
        _advance()

        if (_cur_kind() != TOK_IDENT) {
            _error("expected impl target type")
            return -1
        }

        forge type_name = _cur_val()
        forge type_line = _cur().line
        forge type_col = _cur().col
        _advance()

        if (!_expect(TOK_LBRACE)) {
            _error("expected '{' after impl type")
            return -1
        }

        forge imp = node_new(NK_IMPL, type_name, type_line, type_col)
        while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
            if (_cur_kind() == TOK_VEIN || _cur_kind() == TOK_CORE || _is_fault_vein_start()) {
                forge method_id = parse_fn_decl()
                if (method_id >= 0) {
                    // flatten method names in Phase B: Type__method
                    forge m: Node = node_get(method_id)
                    m.val = type_name + "__" + m.val
                    node_set(method_id, m)
                    node_add_extra(imp, method_id)
                }
            } else {
                _error("expected method declaration in impl")
                _advance()
            }
        }

        if (!_expect(TOK_RBRACE)) {
            _error("expected '}' in impl")
        }

        return imp
    }

    vein _name_in_list(name: obsidian, names: Array<obsidian>) -> bool {
        forge i = 0
        while (i < ofs_array_len(names)) {
            forge item: obsidian = ofs_array_get(names, i)
            if (ofs_str_eq(item, name)) { return true }
            i++
        }
        return false
    }

    // Nomes declarados localmente numa funcao (parametros, forge, const).
    vein _collect_locals(id: stone, out: Array<obsidian>) -> void {
        if (id < 0) { return }
        forge n: Node = node_get(id)
        if (n.kind == NK_PARAM || n.kind == NK_VAR_DECL || n.kind == NK_CONST_DECL) {
            ofs_array_push(out, n.val)
        }
        _collect_locals(n.c0, out)
        _collect_locals(n.c1, out)
        _collect_locals(n.c2, out)
        _collect_locals(n.c3, out)
        forge i = 0
        while (i < node_extra_len(id)) {
            _collect_locals(node_get_extra(id, i), out)
            i++
        }
    }

    vein _prefix_namespace_refs(id: stone, ns_name: obsidian, names: Array<obsidian>) -> void {
        if (id < 0) { return }
        forge n: Node = node_get(id)

        if (n.kind == NK_CALL) {
            if (_name_in_list(n.val, names)) {
                n.val = ns_name + "__" + n.val
                node_set(id, n)
            }
        }

        if (n.kind == NK_IDENT) {
            if (_name_in_list(n.val, names)) {
                n.val = ns_name + "__" + n.val
                node_set(id, n)
            }
        }

        _prefix_namespace_refs(n.c0, ns_name, names)
        _prefix_namespace_refs(n.c1, ns_name, names)
        _prefix_namespace_refs(n.c2, ns_name, names)
        _prefix_namespace_refs(n.c3, ns_name, names)

        forge i = 0
        while (i < node_extra_len(id)) {
            _prefix_namespace_refs(node_get_extra(id, i), ns_name, names)
            i++
        }
    }

    vein parse_namespace_decl() -> stone {
        forge t = _cur()
        _advance()

        if (_cur_kind() != TOK_IDENT) {
            _error_name("expected namespace name")
            return -1
        }

        forge ns_name = _cur_val()
        forge ns_line = _cur().line
        forge ns_col = _cur().col
        _advance()

        if (!_expect(TOK_LBRACE)) {
            _error("expected '{' after namespace name")
            return -1
        }

        forge ns = node_new(NK_NAMESPACE, ns_name, ns_line, ns_col)
        forge local_names: Array<obsidian> = []
        while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
            forge member: stone = -1
            if (_cur_kind() == TOK_VEIN || _cur_kind() == TOK_CORE || _is_fault_vein_start()) {
                member = parse_fn_decl()
                if (member >= 0) {
                    forge m: Node = node_get(member)
                    ofs_array_push(local_names, m.val)
                    m.val = ns_name + "__" + m.val
                    node_set(member, m)
                }
            } else if (_cur_kind() == TOK_FORGE || _cur_kind() == TOK_CONST) {
                member = parse_stmt()
                if (member >= 0) {
                    forge vm: Node = node_get(member)
                    ofs_array_push(local_names, vm.val)
                    vm.val = ns_name + "__" + vm.val
                    node_set(member, vm)
                }
            } else if (_cur_kind() == TOK_MONOLITH) {
                member = parse_monolith_decl()
            } else if (_cur_kind() == TOK_EXTERN) {
                member = parse_extern_decl()
            } else if (_cur_kind() == TOK_IMPL) {
                member = parse_impl_decl()
            } else if (_cur_kind() == TOK_STRATA) {
                member = parse_strata_decl()
            } else {
                _error("unexpected token inside namespace")
                _advance()
            }

            if (member >= 0) {
                node_add_extra(ns, member)
            }
        }

        if (!_expect(TOK_RBRACE)) {
            _error("expected '}' in namespace")
        }

        forge i = 0
        while (i < node_extra_len(ns)) {
            forge mid = node_get_extra(ns, i)
            forge mk = node_kind_of(mid)
            if (mk == NK_FN_DECL || mk == NK_CORE_DECL) {
                // Parametros e variaveis locais sombreiam globais do namespace:
                // antes `forge bg = ...` dentro de uma funcao virava o global
                // ns__bg (lia e sobrescrevia o global).
                forge locals: Array<obsidian> = []
                _collect_locals(mid, locals)
                forge visible: Array<obsidian> = []
                forge j = 0
                while (j < ofs_array_len(local_names)) {
                    forge nm: obsidian = ofs_array_get(local_names, j)
                    if (!_name_in_list(nm, locals)) { ofs_array_push(visible, nm) }
                    j++
                }
                _prefix_namespace_refs(mid, ns_name, visible)
            } else {
                _prefix_namespace_refs(mid, ns_name, local_names)
            }
            i++
        }

        return ns
    }

    vein parse_strata_decl() -> stone {
        forge t = _cur()
        _advance()

        if (_cur_kind() != TOK_IDENT) {
            _error_name("expected strata name")
            return -1
        }

        forge strata_name = _cur_val()
        forge s_line = _cur().line
        forge s_col = _cur().col
        _advance()

        if (!_expect(TOK_LBRACE)) {
            _error("expected '{' after strata name")
            return -1
        }

        forge st = node_new(NK_STRATA, strata_name, s_line, s_col)
        while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
            if (_cur_kind() != TOK_IDENT) {
                _error_name("expected variant name")
                _advance()
                continue
            }

            forge v_name = _cur_val()
            forge v_line = _cur().line
            forge v_col = _cur().col
            _advance()

            forge variant = node_new(NK_VARIANT, v_name, v_line, v_col)
            if (_cur_kind() == TOK_LPAREN) {
                _advance()
                forge v_type = parse_type()
                node_set_child(variant, 0, v_type)
                if (!_expect(TOK_RPAREN)) {
                    _error("expected ')' in variant")
                }
            }

            node_add_extra(st, variant)
            if (_cur_kind() == TOK_COMMA || _cur_kind() == TOK_SEMI) {
                _advance()
            }
        }

        if (!_expect(TOK_RBRACE)) {
            _error("expected '}' in strata")
        }

        return st
    }
    
    vein parse_program() -> stone {
        forge program = node_new(NK_PROGRAM, "", 1, 1)
        
        while (_cur_kind() != TOK_EOF) {
            forge t = _cur()
            
            if (t.kind == TOK_VEIN || t.kind == TOK_CORE || _is_fault_vein_start()) {
                forge decl = parse_fn_decl()
                if (decl >= 0) {
                    node_add_extra(program, decl)
                }
            } else if (t.kind == TOK_MONOLITH) {
                forge decl = parse_monolith_decl()
                if (decl >= 0) {
                    node_add_extra(program, decl)
                }
            } else if (t.kind == TOK_IMPL) {
                forge decl = parse_impl_decl()
                if (decl >= 0) {
                    node_add_extra(program, decl)
                }
            } else if (t.kind == TOK_NAMESPACE) {
                forge decl = parse_namespace_decl()
                if (decl >= 0) {
                    node_add_extra(program, decl)
                }
            } else if (t.kind == TOK_STRATA) {
                forge decl = parse_strata_decl()
                if (decl >= 0) {
                    node_add_extra(program, decl)
                }
            } else if (t.kind == TOK_EXTERN || t.kind == TOK_RIFT) {
                forge decl = parse_extern_decl()
                if (decl >= 0) {
                    node_add_extra(program, decl)
                }
            } else if (t.kind == TOK_FORGE || t.kind == TOK_CONST || t.kind == TOK_SHARD) {
                forge stmt = parse_stmt()
                if (stmt >= 0) {
                    node_add_extra(program, stmt)
                }
            } else if (_is_mineral_start()) {
                node_add_extra(program, parse_mineral_decl())
            } else if (t.kind == TOK_ATTACH) {
                _advance()
                if (!_expect(TOK_LBRACE)) { _error("expected '{'") }
                forge path_val: obsidian = ""
                while (_cur_kind() != TOK_RBRACE && _cur_kind() != TOK_EOF) {
                    path_val = path_val + _cur_val()
                    _advance()
                }
                if (!_expect(TOK_RBRACE)) { _error("expected '}'") }
                forge attach_node = node_new(NK_ATTACH, path_val, t.line, t.col)
                node_add_extra(program, attach_node)
            } else if (t.kind == TOK_EOF) {
                break
            } else {
                _error("unexpected token at top-level")
                _advance()
            }
        }
        
        return program
    }
    
    // ── Public Parse Function ──────────────────────────────────────────
    
    vein parse(tokens: Array<Token>) -> stone {
        _tokens = tokens
        _pos = 0
        _len = ofs_array_len(tokens)
        _error_count = 0
        
        return parse_program()
    }
}
