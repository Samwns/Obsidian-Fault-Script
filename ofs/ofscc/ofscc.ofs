// OFS Compiler — Main Driver
// Complete compilation pipeline and bootstrap

attach {F:fileio.ofs}
attach {F:tokens.ofs}
attach {F:nodes.ofs}
attach {F:ast.ofs}
attach {F:symbols.ofs}
attach {F:lexer.ofs}
attach {F:parser.ofs}
attach {F:typeck.ofs}
attach {F:codegen.ofs}
attach {F:llvmgen.ofs}

extern vein getenv(name: obsidian) -> obsidian

forge _expanded_paths: Array<obsidian> = []

vein path_seen(path: obsidian) -> bool {
    forge i = 0
    while (i < ofs_array_len(_expanded_paths)) {
        forge p: obsidian = ofs_array_get(_expanded_paths, i)
        if (ofs_str_eq(p, path)) { return true }
        i++
    }
    return false
}

vein remember_path(path: obsidian) -> void {
    if (!path_seen(path)) {
        ofs_array_push(_expanded_paths, path)
    }
}

vein dirname(path: obsidian) -> obsidian {
    forge i = 0
    forge last = -1
    forge len = ofs_str_len(path)
    while (i < len) {
        if (ofs_str_char_at(path, i) == 47) {
            last = i
        }
        i++
    }
    if (last < 0) { return "" }
    return ofs_str_substr(path, 0, last + 1)
}

vein is_attach_line(line: obsidian) -> bool {
    if (ofs_str_len(line) < 9) { return false }
    return ofs_str_eq(ofs_str_substr(line, 0, 8), "attach {")
}

vein attach_path_from_line(line: obsidian) -> obsidian {
    forge i = 8
    forge len = ofs_str_len(line)
    while (i < len) {
        if (ofs_str_char_at(line, i) == 125) {
            return ofs_str_substr(line, 8, i - 8)
        }
        i++
    }
    return ""
}

vein package_file_name(name: obsidian) -> obsidian {
    if (ofs_str_eq(name, "terminal-colors")) { return "terminal_colors" }
    if (ofs_str_eq(name, "memory-modes")) { return "memory_modes" }
    if (ofs_str_eq(name, "bedrock-packet")) { return "bedrock_packet" }
    if (ofs_str_eq(name, "test-lib")) { return "test_lib" }
    return name
}

vein stdlib_path(file_name: obsidian) -> obsidian {
    forge root = getenv("OFS_STDLIB")
    if (!ofs_str_eq(root, "")) {
        return root + "/" + file_name + ".ofs"
    }
    return "ofs/stdlib/" + file_name + ".ofs"
}

vein resolve_attach_path(base: obsidian, spec: obsidian) -> obsidian {
    if (ofs_str_len(spec) > 2 && ofs_str_eq(ofs_str_substr(spec, 0, 2), "F:")) {
        forge rel = ofs_str_substr(spec, 2, ofs_str_len(spec) - 2)
        if (ofs_str_len(rel) > 0 && ofs_str_eq(ofs_str_substr(rel, 0, 1), "/")) {
            return rel
        }
        return base + rel
    }

    forge file_name = package_file_name(spec)
    if (ofs_str_eq(spec, "bedrock") || ofs_str_eq(spec, "bedrock-packet") ||
        ofs_str_eq(spec, "canvas") || ofs_str_eq(spec, "core") ||
        ofs_str_eq(spec, "io") || ofs_str_eq(spec, "math") ||
        ofs_str_eq(spec, "memory-modes") || ofs_str_eq(spec, "rift") ||
        ofs_str_eq(spec, "string") || ofs_str_eq(spec, "terminal-colors") ||
        ofs_str_eq(spec, "test-lib") || ofs_str_eq(spec, "webserver") ||
        ofs_str_eq(spec, "window")) {
        return stdlib_path(file_name)
    }

    return "packages/src/" + spec + "/libs/" + file_name + ".ofs"
}

vein expand_attaches(path: obsidian, src: obsidian) -> obsidian {
    if (path_seen(path)) { return "" }
    remember_path(path)

    forge base = dirname(path)
    forge out = ""
    forge start = 0
    forge i = 0
    forge len = ofs_str_len(src)

    while (i <= len) {
        if (i == len || ofs_str_char_at(src, i) == 10) {
            forge line = ofs_str_substr(src, start, i - start)
            if (is_attach_line(line)) {
                forge spec = attach_path_from_line(line)
                forge child_path = resolve_attach_path(base, spec)
                forge child_src = read_file(child_path)
                out = out + expand_attaches(child_path, child_src)
            } else {
                out = out + line + "\n"
            }
            start = i + 1
        }
        i++
    }

    return out
}

vein usage() -> void {
    echo("Usage: ofscc [options] <input.ofs>")
    echo("Options:")
    echo("  -o <output>      Output executable (default: a.out)")
    echo("  -O0/-O2/-O3      LLVM optimization level (default: -O2)")
    echo("  --emit-ir <file> LLVM IR output path (default: output.ll)")
    echo("  --check          Type-check only (no codegen)")
    echo("  --tokens         Print tokens and exit")
    echo("  --ast            Print AST and exit")
    echo("  --help           Show this message")
    echo("")
    echo("Env fallback:")
    echo("  OFSCC_INPUT, OFSCC_OUTPUT, OFSCC_C_OUT, OFSCC_MODE, OFSCC_OPT")
}

vein apply_env_overrides(
    input_file: obsidian,
    output_file: obsidian,
    c_output: obsidian,
    check_only: bool,
    print_tokens: bool,
    print_ast: bool,
    c_opt: obsidian
) -> obsidian {
    forge e_in = getenv("OFSCC_INPUT")
    if (!ofs_str_eq(e_in, "")) { input_file = e_in }

    forge e_out = getenv("OFSCC_OUTPUT")
    if (!ofs_str_eq(e_out, "")) { output_file = e_out }

    forge e_c = getenv("OFSCC_C_OUT")
    if (!ofs_str_eq(e_c, "")) { c_output = e_c }

    forge e_mode = getenv("OFSCC_MODE")
    if (ofs_str_eq(e_mode, "check")) { check_only = true }
    if (ofs_str_eq(e_mode, "tokens")) { print_tokens = true }
    if (ofs_str_eq(e_mode, "ast")) { print_ast = true }
    if (ofs_str_eq(e_mode, "ir")) { c_opt = c_opt }

    forge e_opt = getenv("OFSCC_OPT")
    if (ofs_str_eq(e_opt, "-O0") || ofs_str_eq(e_opt, "-O2") || ofs_str_eq(e_opt, "-O3")) {
        c_opt = e_opt
    }

    forge check_flag = "0"
    forge tokens_flag = "0"
    forge ast_flag = "0"
    if (check_only) { check_flag = "1" }
    if (print_tokens) { tokens_flag = "1" }
    if (print_ast) { ast_flag = "1" }

    return input_file + "|" + output_file + "|" + c_output + "|" +
        check_flag + "|" + tokens_flag + "|" + ast_flag + "|" + c_opt
}

vein parse_state_field(state: obsidian, field_idx: stone) -> obsidian {
    forge i = 0
    forge start = 0
    forge cur = 0
    forge len = ofs_str_len(state)

    while (i < len) {
        if (ofs_str_char_at(state, i) == 124) {
            if (cur == field_idx) {
                return ofs_str_substr(state, start, i - start)
            }
            cur++
            start = i + 1
        }
        i++
    }

    if (cur == field_idx) {
        return ofs_str_substr(state, start, len - start)
    }
    return ""
}

core main() {
    echo("ofscc — OFS self-hosted compiler v0.1")
    echo("")
    
    forge input_file = "input.ofs"
    forge output_file = "a.out"
    forge c_output = "output.ll"
    forge check_only = false
    forge print_tokens = false
    forge print_ast = false
    forge c_opt = "-O2"

    // Phase B: environment-based CLI bridge until argv runtime lands
    forge state = apply_env_overrides(input_file, output_file, c_output, check_only, print_tokens, print_ast, c_opt)
    input_file = parse_state_field(state, 0)
    output_file = parse_state_field(state, 1)
    c_output = parse_state_field(state, 2)
    check_only = ofs_str_eq(parse_state_field(state, 3), "1")
    print_tokens = ofs_str_eq(parse_state_field(state, 4), "1")
    print_ast = ofs_str_eq(parse_state_field(state, 5), "1")
    c_opt = parse_state_field(state, 6)
    forge compile_mode = getenv("OFSCC_MODE")
    if (ofs_str_eq(compile_mode, "")) {
        compile_mode = "build-ir"
    }

    if (ofs_str_eq(input_file, "") || ofs_str_eq(input_file, "--help")) {
        usage()
        return
    }
    
    // Phase 1: Read source
    echo("[1/6] Reading source...")
    forge src: obsidian = ""
    src = read_file(input_file)
    src = expand_attaches(input_file, src)
    echo("  OK — " + ofs_stone_to_obsidian(ofs_str_len(src)) + " bytes")
    
    // Phase 2: Lexical analysis
    echo("[2/6] Lexical analysis...")
    forge tokens: Array<Token> = lexer.lex(src)
    forge token_count = ofs_array_len(tokens)
    echo("  OK — " + ofs_stone_to_obsidian(token_count) + " tokens")

    if (print_tokens) {
        forge ti = 0
        while (ti < token_count) {
            forge tk: Token = ofs_array_get(tokens, ti)
            echo("tok(" + ofs_stone_to_obsidian(tk.kind) + ") '" + tk.val + "'")
            ti++
        }
        return
    }
    
    // Phase 3: Parsing
    echo("[3/6] Parsing...")
    forge root_id = parser.parse(tokens)
    forge node_count = node_pool_len()
    echo("  OK — " + ofs_stone_to_obsidian(node_count) + " AST nodes")

    if (print_ast) {
        forge root_node: Node = node_get(root_id)
        echo("AST root kind: " + node_kind_name(root_node.kind))
        return
    }
    
    // Phase 4: Type checking
    echo("[4/6] Type checking...")
    typeck.check(root_id)
    echo("  OK")

    if (check_only) {
        echo("")
        echo("CHECK OK: semantic validation complete")
        return
    }
    
    // Phase 5: Code generation
    echo("[5/6] Code generation...")
    cg_open(c_output)
    if (ofs_str_eq(compile_mode, "c")) {
        codegen.generate(root_id)
    } else {
        llvmgen.generate(root_id)
    }
    cg_close()
    echo("  OK — " + c_output + " generated")

    if (ofs_str_eq(compile_mode, "ir")) {
        return
    }
    
    // Phase 6: Native link from LLVM IR. The C backend is kept only behind OFSCC_MODE=c.
    echo("[6/6] Native link...")
    forge compile_cmd = ""
    if (ofs_str_eq(compile_mode, "c")) {
        compile_cmd = "gcc " + c_opt + " -o " + output_file + " " + c_output + " 2>&1"
    } else {
        compile_cmd = "clang -Wno-override-module " + c_opt + " " + c_output + " /usr/local/lib/libofs_runtime.a -lm -o " + output_file + " 2>&1"
    }
    forge compile_result = system(compile_cmd)
    
    if (compile_result == 0) {
        echo("  OK")
        echo("")
        echo("SUCCESS: " + output_file + " ready")
    } else {
        echo("  FAILED — check " + c_output)
        echo("")
        echo("COMPILATION ERROR: native linker returned " + ofs_stone_to_obsidian(compile_result))
        exit(1)
    }
}
